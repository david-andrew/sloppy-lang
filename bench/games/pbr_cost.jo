# The software renderer's cost of PBR materials against the simple lighting: one scene, a
# ground, boxes and spheres filling the frame, drawn with materials (SLOPPY_BENCH_PBR=1,
# the default) or without (SLOPPY_BENCH_PBR=0). Shadows, fog and a point light are on.
# bench/games/profile.py runs it as pbr_cost (and pbr_cost_simple: SLOPPY_BENCH_PBR=0).
window("pbr cost", 640, 360)
pbr = (env("SLOPPY_BENCH_PBR") ?? "1") != "0"
ground = plane_mesh(60)
box = cube_mesh()
ball = sphere_mesh(0.6, 24, 16)
t = 0.0
update = (dt: f64):
    global t
    t += dt
draw = ():
    camera3d(vec3(f32(sin(t * 0.3)) * 2.0, 3.0, 9.0), vec3(0, 0.5, 0), 60)
    sun(vec3(-0.5, 1.0, 0.6))
    sky(vec3(0.2, 0.42, 0.8), vec3(0.75, 0.82, 0.9))
    fog(vec3(0.75, 0.82, 0.9), 0.01)
    point_light(vec3(0, 1.5, 2), vec3(1, 0.6, 0.3), 6)
    if pbr: draw_mesh(ground, color = rgb(0.4, 0.45, 0.35), material = Material(roughness = 0.9, metallic = 0))
    else: draw_mesh(ground, color = rgb(0.4, 0.45, 0.35))
    loop i in 0..12:
        x = f32(i % 4) * 2.2 - 3.3
        z = f32(i / 4) * -2.5
        pos = vec3(x, 0.6, z)
        c = rgb(0.3 + 0.05 * f32(i), 0.4, 0.6 - 0.04 * f32(i))
        m = if i % 2 == 0: box else: ball
        if pbr: draw_mesh(m, transform(pos), color = c, material = Material(roughness = 0.2 + 0.06 * f32(i), metallic = f32(i % 3) * 0.5))
        else: draw_mesh(m, transform(pos), color = c)
