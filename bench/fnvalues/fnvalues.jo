# Compare function values with hand-written loops, by retired instructions (no timing).
# Usage: fnvalues <reduce|count|each|any|all|map|named_map|filter|map_sum|sort_by|parallel_range> <hof|loop>
# Separate functions keep closure capture cells and register pressure out of plain loops.
@noinline
reduce_hof = (xs: int[]) -> int:
    return xs.reduce(0, (a, x): a + x)

@noinline
reduce_loop = (xs: int[]) -> int:
    s = 0
    loop x in xs: s += x
    return s

@noinline
count_hof = (xs: int[]) -> int:
    return xs.count((x): x > 3)

@noinline
count_loop = (xs: int[]) -> int:
    s = 0
    loop x in xs:
        if x > 3: s += 1
    return s

@noinline
each_hof = (xs: int[]) -> int:
    s = 0
    xs.each((x): s += x)
    return s

@noinline
each_loop = (xs: int[]) -> int:
    s = 0
    loop x in xs: s += x
    return s

@noinline
any_hof = (xs: int[]) -> int:
    return int(xs.any((x): x < 0))

@noinline
any_loop = (xs: int[]) -> int:
    loop x in xs:
        if x < 0: return 1
    return 0

@noinline
all_hof = (xs: int[]) -> int:
    return int(xs.all((x): x >= 0))

@noinline
all_loop = (xs: int[]) -> int:
    loop x in xs:
        if x < 0: return 0
    return 1

@noinline
map_hof = (xs: int[]) -> int:
    ys = xs.map((x): x * 2)
    return ys[ys.len() - 1]

named_double = (x: int) -> int: x * 2
@noinline
named_map_hof = (xs: int[]) -> int:
    ys = xs.map(named_double)
    return ys[ys.len() - 1]

@noinline
map_loop = (xs: int[]) -> int:
    ys: int[]
    ys.reserve(xs.len())
    loop x in xs: ys.push(x * 2)
    return ys[ys.len() - 1]

@noinline
filter_hof = (xs: int[]) -> int:
    ys = xs.filter((x): x > 3)
    return ys.len()

@noinline
filter_loop = (xs: int[]) -> int:
    ys: int[]
    loop x in xs:
        if x > 3: ys.push(x)
    return ys.len()

@noinline
map_sum_hof = (xs: int[]) -> int:
    return xs.map((x): x * 2).sum()

@noinline
map_sum_loop = (xs: int[]) -> int:
    ys: int[]
    ys.reserve(xs.len())
    loop x in xs: ys.push(x * 2)
    return ys.sum()

@noinline
sort_by_hof = (xs: int[]) -> int:
    ys = xs
    ys.sort((x): -x)
    return ys[0]

@noinline
sort_by_loop = (xs: int[]) -> int:
    # Same key/index/reorder algorithm, with the key computed in a loop.
    ys = xs
    ks: int[]
    loop x in ys: ks.push(-x)
    idx = fill(0, ys.len())
    loop i in [0..ys.len()): idx[i] = i
    __merge_sort(idx, (a: int, b: int): ks[a] < ks[b])
    old = ys
    loop i in [0..ys.len()): ys[i] = old[idx[i]]
    return ys[0]

@noinline
parallel_range_hof = (xs: int[]) -> int:
    ys = parallel_range(xs.len(), (i): i * 2)
    return ys[ys.len() - 1]

@noinline
parallel_range_loop = (xs: int[]) -> int:
    ys: int[]
    ys.resize(xs.len())
    loop i in [0..xs.len()): ys[i] = i * 2
    return ys[ys.len() - 1]

@noinline
work = (xs: int[], mode: str, hof: bool) -> int:
    if mode == "reduce":
        if hof: return reduce_hof(xs)
        return reduce_loop(xs)
    if mode == "count":
        if hof: return count_hof(xs)
        return count_loop(xs)
    if mode == "each":
        if hof: return each_hof(xs)
        return each_loop(xs)
    if mode == "any":
        if hof: return any_hof(xs)
        return any_loop(xs)
    if mode == "all":
        if hof: return all_hof(xs)
        return all_loop(xs)
    if mode == "map":
        if hof: return map_hof(xs)
        return map_loop(xs)
    if mode == "named_map":
        if hof: return named_map_hof(xs)
        return map_loop(xs)
    if mode == "filter":
        if hof: return filter_hof(xs)
        return filter_loop(xs)
    if mode == "map_sum":
        if hof: return map_sum_hof(xs)
        return map_sum_loop(xs)
    if mode == "sort_by":
        if hof: return sort_by_hof(xs)
        return sort_by_loop(xs)
    if mode == "parallel_range":
        if hof: return parallel_range_hof(xs)
        return parallel_range_loop(xs)
    panic("unknown mode")

main = ():
    mode = args()[1]
    hof = args()[2] == "hof"
    xs: int[]
    loop i in [0..8192): xs.push(i % 17)
    s = 0
    loop _ in [0..200): s += work(xs, mode, hof)
    print(s)
