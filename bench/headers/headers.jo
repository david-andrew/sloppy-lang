# Array-header load benchmarks. See README.md for instruction-count commands.

matrix_param = (a: f64[], b: f64[], c: mut f64[], n: int):
    loop r in [0..8):
        loop i in [0..n):
            loop j in [0..n):
                loop k in [0..n):
                    c[i * n + j] += a[i * n + k] * b[k * n + j]

stencil_param = (c: mut f64[], n: int):
    loop r in [0..32):
        loop i in [1..n - 1):
            c[i] = (c[i - 1] + c[i] + c[i + 1]) * 0.25

histogram_param = (x: int[], h: mut int[], n: int):
    loop r in [0..8):
        loop i in [0..n):
            h[x[i]] += 1

matrix_local = (n: int) -> f64:
    a = fill(1.0, n * n)
    b = fill(0.5, n * n)
    c = fill(0.0, n * n)
    loop r in [0..8):
        loop i in [0..n):
            loop j in [0..n):
                loop k in [0..n):
                    c[i * n + j] += a[i * n + k] * b[k * n + j]
    c[n * n - 1]

stencil_local = (n: int) -> f64:
    c = fill(1.0, n)
    loop r in [0..32):
        loop i in [1..n - 1):
            c[i] = (c[i - 1] + c[i] + c[i + 1]) * 0.25
    c[n / 2]

histogram_local = (n: int) -> int:
    x = [loop i in [0..n): i % 256]
    h = fill(0, 256)
    loop r in [0..8):
        loop i in [0..n):
            h[x[i]] += 1
    h[17]

ga: f64[]
gb: f64[]
gc: f64[]
gx: int[]
gh: int[]

matrix_global = (n: int):
    loop r in [0..8):
        loop i in [0..n):
            loop j in [0..n):
                loop k in [0..n):
                    gc[i * n + j] += ga[i * n + k] * gb[k * n + j]

stencil_global = (n: int):
    loop r in [0..32):
        loop i in [1..n - 1):
            gc[i] = (gc[i - 1] + gc[i] + gc[i + 1]) * 0.25

histogram_global = (n: int):
    loop r in [0..8):
        loop i in [0..n):
            gh[gx[i]] += 1

main = ():
    global ga, gb, gc, gx, gh
    mode = args()[1]
    n = 64 + args().len() - 2
    if starts_with(mode, "matrix"):
        if mode == "matrix_local": print(matrix_local(n))
        else:
            ga = fill(1.0, n * n)
            gb = fill(0.5, n * n)
            gc = fill(0.0, n * n)
            if mode == "matrix_param": matrix_param(ga, gb, gc, n)
            else: matrix_global(n)
            print(gc[n * n - 1])
    else if starts_with(mode, "stencil"):
        n *= 1024
        if mode == "stencil_local": print(stencil_local(n))
        else:
            gc = fill(1.0, n)
            if mode == "stencil_param": stencil_param(gc, n)
            else: stencil_global(n)
            print(gc[n / 2])
    else:
        n *= 4096
        if mode == "histogram_local": print(histogram_local(n))
        else:
            gx = [loop i in [0..n): i % 256]
            gh = fill(0, 256)
            if mode == "histogram_param": histogram_param(gx, gh, n)
            else: histogram_global(n)
            print(gh[17])

main()
