# Instruction-count kernels; cc -O2 counterpart: vmath.c. See README.md.
const N = 1024
const R = 256

@noinline
add = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = a[i] + b[i]

@noinline
mul = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = a[i] * b[i]

@noinline
dot = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = vec4(dot(a[i], b[i]))

@noinline
lerp = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = lerp(a[i], b[i], f32(0.375))

@noinline
norm4 = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = normalize(a[i])

@noinline
mv = (a: vec4[], b: vec4[], out: mut vec4[], m: mat4):
    loop i in [0..out.len()): out[i] = m * a[i]

@noinline
mm = (a: mat4[], b: mat4[], out: mut mat4[]):
    loop i in [0..out.len()): out[i] = a[i] * b[i]

@noinline
cross = (a: vec3[], b: vec3[], out: mut vec3[], m: mat4):
    loop i in [0..out.len()): out[i] = cross(a[i], b[i])

@noinline
norm3 = (a: vec3[], b: vec3[], out: mut vec3[], m: mat4):
    loop i in [0..out.len()): out[i] = normalize(a[i])

@noinline
particle = (pos: mut vec4[], vel: mut vec4[], acc: vec4[]):
    loop i in [0..pos.len()):
        vel[i] += acc[i] * f32(0.0001)
        pos[i] += vel[i] * f32(0.0001)

# The cube example's CPU vertex shader, with the actual software projection stage.
struct Vertex:
    pos: vec3
    normal: vec3
    color: vec3
struct Params:
    mvp: mat4
    model: mat4
struct Varying:
    pos: vec4
    normal: vec3
    color: vec3
@noinline
cube_vs = (v: Vertex, u: Params) -> Varying:
    n = (u.model * vec4(v.normal, 0)).xyz
    Varying(u.mvp * vec4(v.pos, 1), n, v.color)
@noinline
vertex = (a: Vertex[], out: mut f32[], u: Params):
    flat = fill(false, 10)
    loop i in [0..a.len()):
        q = cube_vs(a[i], u)
        __sw_project((&q) as *f32, data(out) + i * 14, 10, 0, 0, 640, 480, data(flat))

main = ():
    mode = args()[1]
    m = mat4(vec4(1, 2, 3, 0), vec4(2, 1, 0, 0), vec4(0, 0, 1, 0), vec4(3, 2, 1, 1))
    if mode == "mm":
        a = fill(m, N)
        b = fill(m, N)
        out = fill(mat4(), N)
        loop _ in [0..R): mm(a, b, out)
        print(out[73][2].z)
    else if mode == "cross" or mode == "norm3":
        a = [loop i in [0..N): vec3(f32(i) * 0.001 + 1, 2, 3)]
        b = fill(vec3(3, 1, 2), N)
        out = fill(vec3(), N)
        loop _ in [0..R):
            if mode == "cross": cross(a, b, out, m)
            else: norm3(a, b, out, m)
        print(out[73])
    else if mode == "vertex":
        a = [loop i in [0..N): Vertex(vec3(f32(i) * 0.001, 0.2, 0.3), vec3(0, 1, 0), vec3(0.3, 0.4, 0.5))]
        out = fill(f32(0), N * 14)
        loop _ in [0..R): vertex(a, out, Params(m, m))
        print(out[73 * 14])
    else:
        a = [loop i in [0..N): vec4(f32(i) * 0.001 + 1, 2, 3, 4)]
        b = fill(vec4(3, 1, 2, 0.5), N)
        out = fill(vec4(), N)
        loop _ in [0..R):
            match mode:
                "add": add(a, b, out, m)
                "mul": mul(a, b, out, m)
                "dot": dot(a, b, out, m)
                "lerp": lerp(a, b, out, m)
                "norm4": norm4(a, b, out, m)
                "mv": mv(a, b, out, m)
                "particle": particle(a, b, out)
        if mode == "particle": print(a[73])
        else: print(out[73])

main()
