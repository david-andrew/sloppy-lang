# Shader translation: Sloppy functions -> GLSL ES 3.00 (WebGL2 / OpenGL ES 3).
#
#   fn vs(v: Vertex, u: Params) -> Varying     # Varying's first field is the clip position
#   fn fs(i: Varying, u: Params) -> vec4
#   sh := shader(vs, fs)
#
# Vertex fields become vertex attributes (in declaration order), Params fields become
# uniforms, Varying fields (after the first) are interpolated between the stages. A GpuBuffer
# among the uniforms is an integer texture (RGBA32I) holding its bytes (four words to a texel, 1024 texels to
# a row; see lib/game/gpubuffer.jo) and its length; shaders read its elements from there.
#
# No sampler is ever a member of a GLSL struct: some drivers (Adreno 650 under ANGLE) then
# misresolve renamed identifiers, depending on their hashes. A GpuBuffer is two names, `X_t`
# (the texture) and `X_n` (the length), as uniforms and as parameters; a struct holding a
# Texture or a GpuBuffer is passed to a function as its leaves, one parameter each.

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'

gl_out: str[]
gl_done_fns: {str: str} = {}
gl_done_structs: {int: bool} = {}
gl_done: {str: bool} = {}   # helper declarations already made (by name)
gl_decls: str[]          # struct and function definitions, in dependency order

# Bind only read-only aggregate parameters to a path in the program's uniform layout.
# A helper can have several specializations (u.left, u.right, and an ordinary value).
# Leaf declarations are collected during expression emission, separately for each stage.
gl_uniform_bindings: {int: str} = {}
gl_uniforms: str[]
gl_specializations = 0
gl_uniform_rows = 0
gl_uniform_samplers = 0

gl_stage = ""            # "vertex" or "fragment": the stage being translated
gl_depth_used = false    # the fragment stage writes its depth (set_depth): gl_FragDepth
# A stage never reads its input through a struct holding a copy of it: Adreno 650 under ANGLE read
# such copies wrong (gl_FragCoord.w for log depth; the world position, scrambling terrain noise).
# The input is a binding, as the uniforms are (gl_function): "sl_in" the fragment function's input,
# "sl_va" the vertex function's vertex, "sl_vi" its instance. A read of a field of it is the varying
# or attribute itself (v_world, a_pos, i_model; the fragment position gl_FragCoord), in the
# function given it, in helpers given it (specialized, the input no parameter) at any depth, and
# through a variable given it and never changed. Only where a value is needed whole (stored,
# returned, changed, a `mut` argument) is a struct made, there (gl_in_value). A stage that reads
# none of its input is translated again as before (the same text).
gl_in_types: {str: int} = {}   # "in", "va", "vi": the input's type
gl_in_read = false             # (the stage being translated read its input)
# Values of the fragment input's type that the stage makes: their position is gl_FragCoord when
# each takes it from one it has (`O(i.pos, i.world * 2.0)`), and is read as that (gl_fc_mode 2,
# the struct holding vec4(0.0)); when one has another, or one is written (mode 3), the struct holds
# a flag, true for a copy of the input, whose position is then gl_FragCoord:
# (x.fc_ ? gl_FragCoord : x.pos_). gl_FragCoord is never copied into a struct.
gl_fc_type = 0           # (the fragment stage) the input's type, 0 for none
gl_fc_field = ""         # its position field's name
gl_fc_mode = 0
gl_fc_read = false       # a read became gl_FragCoord
gl_fc_changed = false    # (unused: kept for the passes' bookkeeping)
gl_fc_written = false    # a value of that type is made with another position, or written (mode 3)
gl_fc_target_now = false # (emitting an assignment's target: never rewritten)
# The vertex function writes its outputs where they go (gl_Position, v_world), not into a struct
# main then copies from: it is void, a `return O(a, b, ...)` a write of each field, and the
# variable it builds its output in (`r = O(...)`, `r.f = x`, then `r` returned) those outputs
# themselves. A helper whose result is the output (`return h(v, u)`, `r = h(v, u)` then changed
# and returned) is translated so too, a void one of its own (at any depth). Anything else done
# with such a value (passed on, copied) translates the stage as before (gl_vo_failed).
gl_vo_next = false       # (the function gl_function translates next writes the outputs)
gl_vo_call = false       # (the call gl_expr translates next is one whose result is the output)
gl_vo_on = false         # (translating the body of one that writes the outputs now)
gl_vo_type = 0           # the vertex function's output type (0: not translating it so)
gl_vo_local = -1         # the variable standing for the output, -1 for none yet
gl_vo_failed = false

# (whether n calls a function of the program returning the output type: its result can be the
# output, written by a void one of its own)
gl_vo_helper = (n: int) -> bool: n != 0 and nodes[n].kind == .call and int(nodes[n].aux) == 0 and prune(ntype(n)) == gl_vo_type and nodes[int(fns[int(nodes[n].sym)].decl)].kind == .fn_

# a call whose result is the output: that function's own, writing it
gl_vo_through = (n: int, pre: str):
    global gl_vo_call
    gl_vo_call = true
    gl_out.push("{pre}{gl_expr(n)};\n")

# the output field i's name in the vertex stage: gl_Position or its varying
gl_vo_name = (i: int) -> str:
    if i == 0: return "gl_Position"
    "v_{gl_struct_fields(gl_vo_type)[i].0}"

# (whether n is a constructor of the vertex function's output type)
gl_vo_ctor = (n: int) -> bool: n != 0 and nodes[n].kind == .call and int(nodes[n].aux) == 2 and prune(ntype(n)) == gl_vo_type

# the outputs written from a constructor of them, each field from its value (or its default)
gl_vo_write = (n: int, pre: str):
    si = int(types[gl_vo_type].st)
    loop i in [0..int(structs[si].nfields)):
        a = kid(n, i)
        x = if a == 0: gl_zero(int(fields[int(structs[si].fields) + i].type), nodes[n].pos) else: gl_expr(a)
        gl_out.push("{pre}{gl_vo_name(i)} = {x};\n")

# a return of x from the vertex function written so
gl_vo_return = (x: int, pre: str):
    global gl_vo_failed
    if gl_vo_ctor(x): gl_vo_write(x, pre)
    else if gl_vo_helper(x): gl_vo_through(x, pre)
    else if not (nodes[x].kind == .ident and int(nodes[x].sym) == gl_vo_local and gl_vo_local >= 0):
        gl_vo_failed = true
        # (what it reads counts, for the translation again, gl_in_read; this one is not kept)
        gl_out.push("{pre}{gl_expr(x)};\n")
    gl_out.push("{pre}return;\n")

# (whether n is a field of the variable standing for the outputs: its index, else -1)
gl_vo_field = (n: int) -> int:
    if not gl_vo_on or gl_vo_local < 0 or nodes[n].kind != .field or nodes[n].aux < 0: return -1
    b = int(nodes[n].a)
    if nodes[b].kind != .ident or int(nodes[b].sym) != gl_vo_local: return -1
    int(nodes[n].aux)

# Generated names come from the shader's own code, never from the program's global numbering
# (function, local and type indexes), so a shader's text is the same from build to build while
# its code is (browsers key their program caches by the source text). Types (S_, SA_, gbr_) are
# numbered per program, both stages sharing the names (their varyings may be structs); functions
# per stage, locals and temporaries per function, each in the order the translation reaches them.
gl_type_names: {int: str} = {}
gl_type_count = 0
gl_fn_ids: {int: int} = {}
gl_fn_count = 0
gl_local_ids: {int: int} = {}
gl_local_count = 0

gl_err = (pos: int, msg: str): fatal(pos, "in shader code: {msg}")

# true the first time a helper is asked for (its declarations are then made by the caller)
gl_first = (name: str) -> bool:
    if gl_done.get(name) != none: return false
    gl_done[name] = true
    true

# GLSL ES has no arrays of arrays: an array that is an element of an array is kept in a struct
# (SA_n { T v[k]; }), so `a[i]` there is a[i].v
gl_wrapped = (t: int) -> bool: types[prune(t)].kind == .fixed and types[prune(int(types[prune(t)].elem))].kind == .fixed

# the name of type key k (3 * struct index, 3 * type + 1 or + 2: see gl_type_names), made from
# base and the program's next number the first time it is asked for
gl_type_name = (k: int, base: str) -> str:
    global gl_type_count
    if let nm = gl_type_names.get(k): return nm
    nm = "{base}_{gl_type_count}"
    gl_type_count += 1
    gl_type_names[k] = nm
    nm

gl_elem_type = (t: int, pos: int) -> str:
    if types[prune(t)].kind != .fixed: return gl_type(t, pos)
    nm = gl_type_name(3 * prune(t) + 1, "SA")
    if gl_first(nm):
        inner = gl_type(t, pos)
        gl_decls.push("struct {nm} \{\n    {inner} v;\n};\n")
    nm

# a value of array type t (an element of an array of arrays) wrapped as gl_elem_type has it
gl_wrap = (x: str, t: int, pos: int) -> str:
    if types[prune(t)].kind != .fixed: return x
    "{gl_elem_type(t, pos)}({x})"

gl_type = (t0: int, pos: int) -> str:
    t = prune(t0)
    k = types[t].kind
    if k == .float_: return "float"
    if k == .int_: return "int"
    if k == .bool_: return "bool"
    if k == .vec:
        if t == T_MAT4: return "mat4"
        if types[t].sign: return "ivec{types[t].bits}"
        return "vec{types[t].bits}"
    if k == .struct_:
        si = int(types[t].st)
        if is_lib_texture(si): return "sampler2D"
        if is_gpu_buffer(t): gl_err(pos, "a GpuBuffer can only be read where it is in shaders (u.particles[i], len(u.particles)) or passed to a function")
        gl_struct(t, pos)
        return gl_struct_name(si)
    if k == .void_: return "void"
    if k == .fixed: return "{gl_elem_type(int(types[t].elem), pos)}[{fixed_len(t)}]"
    gl_err(pos, "type {type_str(t)} cannot be used in shaders (use numbers, bools, vectors, matrices, structs and Texture)")
    ""

gl_struct_name = (si: int) -> str:
    nm = gl_type_name(3 * si, "S_{gl_name(structs[si].name)}")
    # (the fragment input's type with its flag, mode 3: a type of its own, the vertex stage's apart)
    if gl_fc_mode == 3 and si == int(types[gl_fc_type].st): return nm + "F"
    nm

gl_struct = (t: int, pos: int):
    si = int(types[t].st)
    if gl_done_structs.get(si) != none: return
    gl_done_structs[si] = true
    check_struct_fields(si)
    if gl_opaque(t): gl_err(pos, "a {structs[si].name} holds a Texture or a GpuBuffer, so shaders can only read it where it is: a field of the uniforms, a parameter, or a variable given it once (it cannot be changed, returned, put in an array or chosen with `if`)")
    s = "struct {gl_struct_name(si)} \{\n"
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        s += "    {gl_type(int(fields[f].type), pos)} {name_of(int(fields[f].name))}_;\n"
    if gl_fc_mode == 3 and t == gl_fc_type: s += "    bool fc_;\n"
    gl_decls.push(s + "};\n")

# a name GLSL accepts as part of an identifier: no "__" anywhere (reserved in GLSL ES), and none
# at the ends (the generated names put "_" around it)
gl_name = (s: str) -> str:
    b: u8[]
    loop c in sanitize(s):
        if c == '_' and (b.len() == 0 or b[b.len() - 1] == '_'): continue
        b.push(c)
    if b.len() > 0 and b[b.len() - 1] == '_': b.pop()
    if b.len() == 0: return "a"
    str_from_bytes(b)

# local l's number in the function being translated
gl_local_id = (l: int) -> int:
    global gl_local_count
    if let n = gl_local_ids.get(l): return n
    n = gl_local_count
    gl_local_count += 1
    gl_local_ids[l] = n
    n

gl_local = (l: int) -> str: "l_{gl_name(name_of(int(locals[l].name)))}_{gl_local_id(l)}"

gl_float = (x: f64) -> str:
    s = "{x}"
    if (index_of(s, ".") ?? -1) < 0 and (index_of(s, "e") ?? -1) < 0 and (index_of(s, "n") ?? -1) < 0: s += ".0"
    s

builtin_map: {str: str} = {
    "sin": "sin", "cos": "cos", "tan": "tan", "asin": "asin", "acos": "acos", "atan": "atan", "atan2": "atan",
    "exp": "exp", "log": "log", "pow": "pow", "sqrt": "sqrt", "abs": "abs", "floor": "floor", "ceil": "ceil",
    "fract": "fract", "mod": "mod", "min": "min", "max": "max", "clamp": "clamp", "mix": "mix", "lerp": "mix",
    "step": "step", "smoothstep": "smoothstep", "length": "length", "distance": "distance", "dot": "dot",
    "cross": "cross", "normalize": "normalize", "reflect": "reflect", "transpose": "transpose", "inverse": "inverse",
    "sign": "sign", "sample": "texture", "sample_lod": "textureLod",
    "exp2": "exp2", "log2": "log2", "fwidth": "fwidth",
}

gl_fn_name = (f: int) -> str:
    global gl_fn_count
    n = gl_fn_ids.get(f) ?? -1
    if n < 0:
        n = gl_fn_count
        gl_fn_count += 1
        gl_fn_ids[f] = n
    "f_{gl_name(name_of(int(nodes[int(fns[f].decl)].name)))}_{n}"

gl_uniform_struct = (t: int) -> bool:
    types[prune(t)].kind == .struct_ and not is_lib_texture(int(types[prune(t)].st)) and not is_gpu_buffer(t)

# does a value of type t hold a sampler (a Texture or a GpuBuffer, maybe in a struct or an array)?
gl_opaque = (t0: int) -> bool:
    t = prune(t0)
    k = types[t].kind
    if k == .fixed: return gl_opaque(int(types[t].elem))
    if k != .struct_: return false
    if is_lib_texture(int(types[t].st)) or is_gpu_buffer(t): return true
    si = int(types[t].st)
    check_struct_fields(si)
    loop i in [0..int(structs[si].nfields)):
        if gl_opaque(int(fields[int(structs[si].fields) + i].type)): return true
    false

# the leaves of a value of type t named path: (name, type), a struct's by its field indexes
gl_leaves = (t: int, path: str, out: mut (str, int)[]):
    if not gl_uniform_struct(t):
        out.push((path, t))
        return
    loop i in 0.. and f in gl_struct_fields(t): gl_leaves(f.1, "{path}_{i}", out)

# a parameter (a GpuBuffer's two)
gl_param_decl = (t: int, name: str, pos: int) -> str:
    if is_gpu_buffer(t): return "highp isampler2D {name}_t, int {name}_n"
    "{gl_type(t, pos)} {name}"

# a GpuBuffer as the base of its two names (base_t, base_n): a field of the uniforms, a parameter
# or a variable bound to one of them
gl_gbuf = (e: int) -> str:
    path = gl_uniform_path(e)
    if path != "": return gl_uniform_value(ntype(e), path, nodes[e].pos)
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if int(locals[l].flags) & LF_ALIAS != 0: return gl_gbuf(int(locals[l].alias))
        if int(locals[l].flags) & LF_PARAM != 0: return gl_local(l)
    gl_err(nodes[e].pos, "a GpuBuffer in a shader must be a field of the uniforms or a parameter (u.particles), not made or chosen here")
    ""

# a struct holding a Texture or a GpuBuffer, as the arguments of its leaves (see gl_function)
gl_leaf_args = (e: int, out: mut str[]):
    t = prune(ntype(e))
    pos = nodes[e].pos
    if is_gpu_buffer(t):
        b = gl_gbuf(e)
        out.push("{b}_t")
        out.push("{b}_n")
        return
    if not gl_uniform_struct(t):
        out.push(gl_expr(e))
        return
    path = gl_uniform_path(e)
    if path != "":
        leaves: (str, int)[]
        gl_leaves(t, path, leaves)
        loop lf in leaves:
            v = gl_uniform_value(lf.1, lf.0, pos)
            if is_gpu_buffer(lf.1):
                out.push("{v}_t")
                out.push("{v}_n")
            else: out.push(v)
        return
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)) and int(locals[int(nodes[e].sym)].flags) & LF_ALIAS != 0:
        gl_leaf_args(int(locals[int(nodes[e].sym)].alias), out)
        return
    if nodes[e].kind == .call and nodes[e].aux == 2:
        # (a struct built in the call: each field's leaves)
        loop i in 0.. and f in gl_struct_fields(t):
            a = kid(e, i)
            if a != 0:
                gl_leaf_args(a, out)
                continue
            if gl_opaque(f.1): gl_err(pos, "give the field {f.0} here: a Texture or a GpuBuffer has no default in shaders")
            leaves: (str, int)[]
            gl_leaves(f.1, "", leaves)
            loop lf in leaves: out.push(gl_zero(lf.1, pos))
        return
    if not gl_opaque(t):
        # (an ordinary struct value inside one: its fields one by one)
        x = gl_expr(e)
        loop f in gl_struct_fields(t): gl_value_leaves("{x}.{f.0}_", f.1, out)
        return
    gl_err(pos, "a struct holding a Texture or a GpuBuffer is passed in shaders as it is: a field of the uniforms, a parameter, or one built in the call")

gl_value_leaves = (x: str, t: int, out: mut str[]):
    if not gl_uniform_struct(t):
        out.push(x)
        return
    loop f in gl_struct_fields(t): gl_value_leaves("{x}.{f.0}_", f.1, out)

# A path is made of field indexes, so nested names cannot collide, and it agrees with gl_udesc.
# (whether a binding path names the stage's input or a part of it)
gl_is_in = (path: str) -> bool: starts_with(path, "sl_in") or starts_with(path, "sl_va") or starts_with(path, "sl_vi")

# the stage input's part at path (sl_in_2_0: field 0 of the input's field 2) read where it is: its
# varying or attribute (a nested part: its field). The whole input, needed as a value: made here
gl_in_value = (t: int, path: str, pos: int) -> str:
    global gl_in_read, gl_fc_read
    gl_in_read = true
    parts = split(path, "_")
    kind = parts[1]
    it = gl_in_types.get(kind) ?? 0
    fs = gl_struct_fields(it)
    if parts.len() == 2:
        vals: str[]
        loop i in 0.. and f in fs: vals.push(if kind == "in" and i == 0: "vec4(0.0)" else: gl_in_value(f.1, "{path}_{i}", pos))
        if kind == "in" and gl_fc_mode == 3: vals.push("true")
        return "{gl_type(it, pos)}({join(vals, ", ")})"
    k = to_int(parts[2]) ?? 0
    pre = if kind == "in": "v_" else: if kind == "va": "a_" else: "i_"
    x = "{pre}{fs[k].0}"
    if kind == "in" and k == 0:
        gl_fc_read = true
        x = "gl_FragCoord"
    ft = fs[k].1
    loop j in [3..parts.len()):
        sub = gl_struct_fields(ft)[to_int(parts[j]) ?? 0]
        x += ".{sub.0}_"
        ft = sub.1
    x

gl_uniform_path = (e: int) -> str:
    if nodes[e].kind == .ident and nodes[e].aux == i32(int(SK.local)):
        l = int(nodes[e].sym)
        if int(locals[l].flags) & LF_ALIAS != 0: return gl_uniform_path(int(locals[l].alias))
        return gl_uniform_bindings.get(l) ?? ""
    if nodes[e].kind == .field and nodes[e].aux >= 0 and gl_uniform_struct(ntype(int(nodes[e].a))):
        root = gl_uniform_path(int(nodes[e].a))
        if root != "": return "{root}_{nodes[e].aux}"
    ""

# Conservative Appendix A bound: no scalar sharing, all array elements, matrix columns.
gl_resource_cost = (t0: int) -> (int, int):
    t = prune(t0)
    if types[t].kind == .fixed:
        c = gl_resource_cost(int(types[t].elem))
        return (c.0 * fixed_len(t), c.1 * fixed_len(t))
    if is_gpu_buffer(t): return (2, 1)
    if types[t].kind == .struct_:
        if is_lib_texture(int(types[t].st)): return (1, 1)
        rows = 0
        samplers = 0
        loop f in gl_struct_fields(t):
            c = gl_resource_cost(f.1)
            rows += c.0
            samplers += c.1
        return (rows, samplers)
    if t == T_MAT4: return (4, 0)
    (1, 0)

# A whole-value read remains a value copy. Only this case needs all its leaves; field reads
# and read-only helper arguments never construct the containing uniform struct.
gl_uniform_value = (t: int, path: str, pos: int) -> str:
    global gl_uniform_rows, gl_uniform_samplers
    if gl_is_in(path): return gl_in_value(t, path, pos)
    if gl_uniform_struct(t):
        parts: str[]
        loop i in 0.. and f in gl_struct_fields(t): parts.push(gl_uniform_value(f.1, "{path}_{i}", pos))
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    # (a path from a parameter's leaves, lp..., names that parameter: no uniform)
    if starts_with(path, "sl_u") and gl_first("uniform_{path}"):
        if is_gpu_buffer(t): gl_uniforms.push("uniform highp isampler2D {path}_t;\nuniform int {path}_n;\n")
        else: gl_uniforms.push("uniform {gl_type(t, pos)} {path};\n")
        c = gl_resource_cost(t)
        gl_uniform_rows += c.0
        gl_uniform_samplers += c.1
    path

# Translate a function in a uniform-binding context, and everything it calls. Omitted
# read-only struct arguments become global leaf references; other calls keep value semantics.
gl_function = (f: int, bindings: str[] = []) -> str:
    global gl_out, gl_uniform_bindings, gl_specializations, gl_local_ids, gl_local_count, gl_temps, gl_vo_on, gl_vo_next, gl_vo_local
    vo = gl_vo_next
    gl_vo_next = false
    key = "{f}|{join(bindings, "|")}"
    if vo: key += "|vo"
    if let done = gl_done_fns.get(key): return done
    saved_ids = gl_local_ids
    saved_count = gl_local_count
    saved_temps = gl_temps
    gl_local_ids = {}
    gl_local_count = 0
    gl_temps = 0
    nm = gl_fn_name(f)
    if bindings.len() > 0 or vo:
        gl_specializations += 1
        nm += "_u{gl_specializations}"
    gl_done_fns[key] = nm
    saved_bindings = gl_uniform_bindings
    gl_uniform_bindings = {}
    decl = int(fns[f].decl)
    if decl == 0 or (nodes[decl].kind != .fn_ and nodes[decl].kind != .lambda): gl_err(0, "only named functions can be used in shaders")
    if fns[f].caps.len() > 0: gl_err(nodes[decl].pos, "a function that captures variables cannot run on the GPU")
    ret = gl_type(int(fns[f].ret), nodes[decl].pos)
    # (the vertex function writing its outputs itself: void; a helper translated meanwhile is not)
    vo_saved = gl_vo_on
    vl_saved = gl_vo_local
    gl_vo_on = vo
    gl_vo_local = -1
    if vo: ret = "void"
    params: str[]
    loop i in 0.. and l in fns[f].params:
        if i < bindings.len() and bindings[i] != "":
            gl_uniform_bindings[l] = bindings[i]
            continue
        lt = int(locals[l].type)
        q = ""
        if int(locals[l].flags) & LF_MUTPARAM != 0:
            if gl_opaque(lt): gl_err(locals[l].pos, "a parameter holding a Texture or a GpuBuffer cannot be `mut` in shaders")
            q = "inout "
        if gl_opaque(lt) and gl_uniform_struct(lt):
            # (a struct holding a sampler: a parameter for each leaf, lp<local>_<name>_<field>...)
            root = "lp{gl_local_id(l)}_{gl_name(name_of(int(locals[l].name)))}"
            gl_uniform_bindings[l] = root
            leaves: (str, int)[]
            gl_leaves(lt, root, leaves)
            loop lf in leaves: params.push(gl_param_decl(lf.1, lf.0, locals[l].pos))
            continue
        params.push("{q}{gl_param_decl(lt, gl_local(l), locals[l].pos)}")
    sig = "{ret} {nm}({join(params, ", ")})"
    saved = gl_out
    gl_out = []
    body = int(fns[f].body)
    want = tkind(int(fns[f].ret)) != .void_
    gl_block(body, 1, want)
    gl_vo_on = vo_saved
    gl_vo_local = vl_saved
    lines_ = gl_out
    gl_out = saved
    gl_uniform_bindings = saved_bindings
    gl_local_ids = saved_ids
    gl_local_count = saved_count
    gl_temps = saved_temps
    gl_decls.push("{sig} \{\n{join(lines_, "")}}\n")
    nm

ind = (n: int) -> str: repeat("    ", n)

gl_block = (b: int, depth: int, ret_value: bool):
    n = nkids(b)
    loop i in [0..n):
        s = kid(b, i)
        if i == n - 1 and ret_value and nodes[b].aux != 0:
            if gl_vo_on: gl_vo_return(int(nodes[s].a), ind(depth))
            else: gl_out.push("{ind(depth)}return {gl_expr(int(nodes[s].a))};\n")
            continue
        gl_stmt(s, depth)

gl_assign_op = (op: int) -> str:
    match op as Tok:
        assign: "="
        pluseq: "+="
        minuseq: "-="
        stareq: "*="
        slasheq: "/="
        _: "="

gl_compound_op = (op: Tok) -> Tok:
    match op:
        minuseq: .minus
        stareq: .star
        slasheq: .slash
        percenteq: .percent
        ampeq: .amp
        pipeeq: .pipe
        careteq: .caret
        shleq: .shl
        shreq: .shr
        _: .plus

# an assignment's target as GLSL, its indexes computed once beforehand (into temporaries
# declared at pre) when they are more than a name or a number
gl_temps = 0
# (an assignment to target n: whether it changes a value of the fragment input's type, or its
# position, see gl_fc_mode; the position's field node, or 0)
gl_fc_target = (n0: int) -> int:
    global gl_fc_changed, gl_fc_written
    n = n0
    at = 0
    loop gl_fc_type != 0 and (nodes[n].kind == .field or nodes[n].kind == .index):
        if nodes[n].kind == .field and prune(ntype(int(nodes[n].a))) == gl_fc_type:
            gl_fc_changed = true
            if name_of(int(nodes[n].name)) == gl_fc_field:
                gl_fc_written = true
                at = n
        n = int(nodes[n].a)
    at

# (whether n reads the position of a value of the fragment input's type)
gl_fc_pos_read = (n: int) -> bool: n != 0 and nodes[n].kind == .field and nodes[n].aux >= 0 and prune(ntype(int(nodes[n].a))) == gl_fc_type and name_of(int(nodes[n].name)) == gl_fc_field

gl_target = (n: int, pre: str) -> str:
    k = nodes[n].kind
    if k == .index:
        base = gl_target(int(nodes[n].a), pre)
        ix = int(nodes[n].b)
        v = ""
        if gl_wrapped(ntype(int(nodes[n].a))): v = ".v"
        if nodes[ix].kind == .int_lit: return "{base}[{gl_expr(ix)}]{v}"
        # (a variable too: the right side may change it)
        x = gl_expr(ix)
        gl_temps += 1
        t = gl_temps
        gl_out.push("{pre}int sl_t{t} = {x};\n")
        return "{base}[sl_t{t}]{v}"
    if k == .field and nodes[n].aux == -4: return "{gl_target(int(nodes[n].a), pre)}.{name_of(int(nodes[n].name))}"
    if k == .field and nodes[n].aux >= 0:
        vf = gl_vo_field(n)
        if vf >= 0: return gl_vo_name(vf)
        return "{gl_target(int(nodes[n].a), pre)}.{name_of(int(nodes[n].name))}_"
    gl_expr(n)

gl_stmt = (s: int, depth: int):
    global gl_fc_target_now, gl_vo_local, gl_vo_failed
    k = nodes[s].kind
    pre = ind(depth)
    if k == .vardecl:
        if nodes[s].nlist > 0: gl_err(nodes[s].pos, "tuple destructuring is not supported in shaders")
        l = int(nodes[s].sym)
        if gl_opaque(int(locals[l].type)):
            # (a Texture, a GpuBuffer or a struct holding one, given once: a name for its place)
            path = ""
            init = int(nodes[s].b)
            if init != 0 and int(locals[l].flags) & (LF_ASSIGNED | LF_MUTARG | LF_ADDR) == 0:
                path = gl_uniform_path(init)
                # (a Texture or GpuBuffer parameter itself: its name)
                if path == "" and nodes[init].kind == .ident and nodes[init].aux == i32(int(SK.local)) and int(locals[int(nodes[init].sym)].flags) & LF_PARAM != 0 and not gl_uniform_struct(ntype(init)): path = gl_local(int(nodes[init].sym))
            if path == "": gl_err(nodes[s].pos, "a variable holding a Texture or a GpuBuffer in shaders must be given a field of the uniforms (or of a parameter holding one) once, and not changed")
            gl_uniform_bindings[l] = path
            return
        # (the vertex function's output built in a variable: the outputs themselves)
        if gl_vo_on and gl_vo_local < 0 and prune(int(locals[l].type)) == gl_vo_type and int(locals[l].flags) & (LF_MUTARG | LF_ADDR) == 0 and (nodes[s].b == 0 or gl_vo_ctor(int(nodes[s].b)) or gl_vo_helper(int(nodes[s].b))):
            gl_vo_local = l
            if gl_vo_helper(int(nodes[s].b)): gl_vo_through(int(nodes[s].b), pre)
            else if nodes[s].b != 0: gl_vo_write(int(nodes[s].b), pre)
            else:
                loop i in 0.. and f in gl_struct_fields(gl_vo_type): gl_out.push("{pre}{gl_vo_name(i)} = {gl_zero(f.1, nodes[s].pos)};\n")
            return
        # (a variable given the input, or a part of it, and never changed: that part itself)
        if nodes[s].b != 0 and int(locals[l].flags) & (LF_ASSIGNED | LF_MUTARG | LF_ADDR) == 0 and gl_uniform_struct(int(locals[l].type)):
            ip = gl_uniform_path(int(nodes[s].b))
            if gl_is_in(ip):
                gl_uniform_bindings[l] = ip
                return
        t = gl_type(int(locals[l].type), nodes[s].pos)
        if nodes[s].b != 0: gl_out.push("{pre}{t} {gl_local(l)} = {gl_expr(int(nodes[s].b))};\n")
        else: gl_out.push("{pre}{t} {gl_local(l)} = {gl_zero(int(locals[l].type), nodes[s].pos)};\n")
    else if k == .assign:
        if nodes[s].aux != 0: gl_err(nodes[s].pos, "unsupported assignment in shader")
        a = int(nodes[s].a)
        if gl_vo_on and gl_vo_local >= 0 and nodes[a].kind == .ident and int(nodes[a].sym) == gl_vo_local:
            if int(nodes[s].op) == int(Tok.assign) and gl_vo_ctor(int(nodes[s].b)): gl_vo_write(int(nodes[s].b), pre)
            else if int(nodes[s].op) == int(Tok.assign) and gl_vo_helper(int(nodes[s].b)): gl_vo_through(int(nodes[s].b), pre)
            else: gl_vo_failed = true
            return
        pt = gl_fc_target(a)
        op = int(nodes[s].op)
        # (mode 3: a value whose position is written is no longer the input; one written in part
        # keeps the rest of gl_FragCoord, a value of the stage's own from then on)
        if gl_fc_mode == 3 and pt != 0:
            gl_fc_target_now = true
            b = gl_target(int(nodes[pt].a), pre)
            gl_fc_target_now = false
            if pt == a and op == int(Tok.assign): gl_out.push("{pre}{b}.fc_ = false;\n")
            else: gl_out.push("{pre}if ({b}.fc_) \{ {b}.{gl_fc_field}_ = gl_FragCoord; {b}.fc_ = false; }\n")
        ta = prune(ntype(a))
        bop = gl_compound_op(op as Tok)
        # (integers through gl_arith: their + - * wrap through unsigned numbers)
        native = (bop == .plus or bop == .minus or bop == .star or bop == .slash) and (types[ta].kind == .float_ or (is_vec(ta) and not types[ta].sign))
        if op != int(Tok.assign) and not native:
            # (x op= y as x = x op y, x's indexes computed once: the operators the CPU's way)
            x = gl_target(a, pre)
            gl_out.push("{pre}{x} = {gl_arith(bop, x, gl_expr(int(nodes[s].b)), ta, ta, ntype(int(nodes[s].b)))};\n")
        else:
            gl_fc_target_now = true
            x = gl_expr(a)
            gl_fc_target_now = false
            gl_out.push("{pre}{x} {gl_assign_op(op)} {gl_expr(int(nodes[s].b))};\n")
    else if k == .exprstmt:
        e = int(nodes[s].a)
        if nodes[e].kind == .if_ or nodes[e].kind == .match_:
            gl_stmt_if(e, depth)
            return
        gl_out.push("{pre}{gl_expr(e)};\n")
    else if k == .if_: gl_stmt_if(s, depth)
    else if k == .return_:
        if gl_vo_on and nodes[s].a != 0: gl_vo_return(int(nodes[s].a), pre)
        else if nodes[s].a != 0: gl_out.push("{pre}return {gl_expr(int(nodes[s].a))};\n")
        else: gl_out.push("{pre}return;\n")
    else if k == .while_:
        gl_out.push("{pre}while ({gl_expr(int(nodes[s].a))}) \{\n")
        gl_block(int(nodes[s].b), depth + 1, false)
        gl_out.push("{pre}}\n")
    else if k == .for_ and (nodes[s].aux == 1 or nodes[s].aux == 2) and tkind(ntype(int(nodes[s].a))) == .fixed:
        # loop [mut] x in xs (a fixed-size array): an index loop; without `mut`, over a copy
        ct = prune(ntype(int(nodes[s].a)))
        iv = gl_local(int(nodes[s].c))
        el = int(nodes[s].sym)
        arr = ""
        if nodes[s].aux == 1:
            arr = gl_local(int(nodes[s].d))
            gl_out.push("{pre}{gl_type(ct, nodes[s].pos)} {arr} = {gl_expr(int(nodes[s].a))};\n")
        gl_out.push("{pre}for (int {iv} = 0; {iv} < {fixed_len(ct)}; {iv}++) \{\n")
        v = ""
        if gl_wrapped(ct): v = ".v"
        if nodes[s].aux == 1: gl_out.push("{pre}    {gl_type(int(types[ct].elem), nodes[s].pos)} {gl_local(el)} = {arr}[{iv}]{v};\n")
        gl_block(int(nodes[s].b), depth + 1, false)
        gl_out.push("{pre}}\n")
    else if k == .for_:
        if nodes[s].aux != 0: gl_err(nodes[s].pos, "only `loop i in a..b` loops and loops over fixed-size arrays are supported in shaders")
        l = int(nodes[s].sym)
        it = int(nodes[s].a)
        v = gl_local(l)
        cmp = "<"
        if has_flag(it, NF_INCLUSIVE): cmp = "<="
        gl_out.push("{pre}for (int {v} = {gl_expr(int(nodes[it].a))}; {v} {cmp} {gl_expr(int(nodes[it].b))}; {v}++) \{\n")
        gl_block(int(nodes[s].b), depth + 1, false)
        gl_out.push("{pre}}\n")
    else if k == .break_: gl_out.push("{pre}break;\n")
    else if k == .continue_: gl_out.push("{pre}continue;\n")
    else if k == .block:
        loop i in [0..nkids(s)): gl_stmt(kid(s, i), depth)
    else if k == .const_: pass
    else: gl_err(nodes[s].pos, "unsupported statement in shader")

gl_stmt_if = (e: int, depth: int):
    if nodes[e].kind != .if_: gl_err(nodes[e].pos, "match is not supported in shaders")
    pre = ind(depth)
    gl_out.push("{pre}if ({gl_expr(int(nodes[e].a))}) \{\n")
    gl_block(int(nodes[e].b), depth + 1, false)
    if nodes[e].c != 0:
        gl_out.push("{pre}} else \{\n")
        gl_block(int(nodes[e].c), depth + 1, false)
    gl_out.push("{pre}}\n")

gl_zero = (t0: int, pos: int) -> str:
    global gl_fc_changed, gl_fc_written
    t = prune(t0)
    if gl_fc_type != 0 and t == gl_fc_type:
        gl_fc_changed = true
        gl_fc_written = true
    k = types[t].kind
    if k == .float_: return "0.0"
    if k == .int_: return "0"
    if k == .bool_: return "false"
    if k == .vec:
        if t == T_MAT4: return "mat4(0.0)"
        return "{gl_type(t, pos)}(0)"
    if k == .struct_:
        si = int(types[t].st)
        parts: str[]
        loop i in [0..int(structs[si].nfields)): parts.push(gl_zero(int(fields[int(structs[si].fields) + i].type), pos))
        if gl_fc_mode == 3 and t == gl_fc_type: parts.push("false")
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    if k == .fixed:
        z = gl_wrap(gl_zero(int(types[t].elem), pos), int(types[t].elem), pos)
        parts: str[]
        loop i in [0..fixed_len(t)): parts.push(z)
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    gl_err(pos, "cannot zero-initialize {type_str(t)} in a shader")
    ""

gl_binop = (op: Tok) -> str:
    match op:
        plus: "+"
        minus: "-"
        star: "*"
        slash: "/"
        percent: "%"
        eq: "=="
        ne: "!="
        lt: "<"
        le: "<="
        gt: ">"
        ge: ">="
        amp: "&"
        pipe: "|"
        caret: "^"
        shl: "<<"
        shr: ">>"
        _: "?"

gl_expr = (e: int) -> str:
    global gl_depth_used, gl_fc_read, gl_fc_changed, gl_fc_written, gl_vo_failed, gl_vo_call, gl_vo_next
    k = nodes[e].kind
    t = prune(ntype(e))
    path = gl_uniform_path(e)
    if path != "": return gl_uniform_value(t, path, nodes[e].pos)
    if is_gpu_buffer(t): return gl_gbuf(e)
    if k == .int_lit:
        if types[t].kind == .float_: return gl_float(f64(nodes[e].ival))
        if nodes[e].ival < -2147483648 or nodes[e].ival > 4294967295: gl_err(nodes[e].pos, "shader integers are 32 bits, and this number does not fit in one (a hash written for 64 bits gives other values here)")
        return "{nodes[e].ival}"
    if k == .float_lit: return gl_float(nodes[e].fval)
    if k == .bool_lit:
        if nodes[e].ival != 0: return "true"
        return "false"
    if k == .ident:
        if nodes[e].aux != i32(int(SK.local)): gl_err(nodes[e].pos, "shaders can only use local variables, parameters and constants (a value of the program's: `const SPEED = 2.0` at the top, or a field of the uniforms struct, given at each draw)")
        l = int(nodes[e].sym)
        if int(locals[l].flags) & LF_ALIAS != 0: return gl_expr(int(locals[l].alias))
        if gl_vo_on and l == gl_vo_local: gl_vo_failed = true
        return gl_local(l)
    if k == .field:
        a = int(nodes[e].a)
        if nodes[e].aux == -4: return "{gl_expr(a)}.{name_of(int(nodes[e].name))}"
        if nodes[e].aux < 0: gl_err(nodes[e].pos, "unsupported field access in shader")
        vf = gl_vo_field(e)
        if vf >= 0: return gl_vo_name(vf)
        fname = name_of(int(nodes[e].name))
        if gl_fc_mode != 0 and not gl_fc_target_now and prune(ntype(a)) == gl_fc_type:
            if fname == gl_fc_field:
                gl_fc_read = true
                if gl_fc_mode == 3:
                    b = gl_expr(a)
                    return "({b}.fc_ ? gl_FragCoord : {b}.{fname}_)"
                return "gl_FragCoord"
        return "{gl_expr(a)}.{fname}_"
    if k == .index:
        bt = prune(ntype(int(nodes[e].a)))
        if types[bt].kind != .vec and types[bt].kind != .fixed: gl_err(nodes[e].pos, "only vectors, matrices and fixed-size arrays (T[N]) can be indexed in shaders")
        if gl_wrapped(bt): return "{gl_expr(int(nodes[e].a))}[{gl_expr(int(nodes[e].b))}].v"
        return "{gl_expr(int(nodes[e].a))}[{gl_expr(int(nodes[e].b))}]"
    if k == .binary:
        a = int(nodes[e].a)
        b = int(nodes[e].b)
        op = nodes[e].op as Tok
        # (% keeps the dividend's sign, as on the CPU: GLSL's mod() takes the divisor's, and its %
        # is undefined for negative numbers)
        if op == .percent and (is_float(ntype(a)) or is_vec(ntype(a))):
            x = gl_expr(a)
            y = gl_expr(b)
            return "({x} - {y} * trunc({x} / {y}))"
        return gl_arith(op, gl_expr(a), gl_expr(b), ntype(a), t, ntype(b))
    if k == .unary:
        # (a space: `- -1.5`, not the decrement `--1.5`)
        if nodes[e].op == i32(int(Tok.minus)):
            # (integers through unsigned ones, which wrap: see gl_arith)
            if types[t].kind == .int_: return gl_narrow("int(-uint({gl_expr(int(nodes[e].a))}))", t)
            if is_vec(t) and types[t].sign: return "ivec{types[t].bits}(-uvec{types[t].bits}({gl_expr(int(nodes[e].a))}))"
            return gl_narrow("(- {gl_expr(int(nodes[e].a))})", t)
        return gl_narrow("(~{gl_expr(int(nodes[e].a))})", t)
    if k == .not_: return "(!{gl_expr(int(nodes[e].a))})"
    if k == .and_: return "({gl_expr(int(nodes[e].a))} && {gl_expr(int(nodes[e].b))})"
    if k == .or_: return "({gl_expr(int(nodes[e].a))} || {gl_expr(int(nodes[e].b))})"
    if k == .conv:
        cv = nodes[e].aux as CV
        a = gl_expr(int(nodes[e].a))
        from_ = prune(ntype(int(nodes[e].a)))
        if cv == .int2float:
            if gl_unsigned(from_): return "float(uint({a}))"
            return "float({a})"
        if cv == .float2int:
            if types[t].kind != .int_: return "int({a})"
            return gl_float_to_int(a, t)
        if cv == .int_ and types[t].kind == .int_:
            if types[from_].kind == .bool_: return "int({a})"
            return gl_narrow(a, t)
        if cv == .float_ or cv == .none_: return a
        gl_err(nodes[e].pos, "unsupported conversion in shader")
    if k == .if_:
        b = int(nodes[e].b)
        c = int(nodes[e].c)
        if nkids(b) != 1 or nkids(c) != 1 or nodes[b].aux == 0 or nodes[c].aux == 0: gl_err(nodes[e].pos, "if expressions in shaders must be single expressions: `if c: a else: b`")
        return "({gl_expr(int(nodes[e].a))} ? {gl_expr(block_value(b))} : {gl_expr(block_value(c))})"
    if k == .intrinsic:
        id = nodes[e].aux as IN
        if id == .vec_ctor:
            parts: str[]
            loop i in [0..nkids(e)):
                a = kid(e, i)
                at = prune(ntype(a))
                if is_vec(at) and at != T_MAT4 and t != T_MAT4 and types[at].sign != types[t].sign:
                    # (a vector of the other kind: each component converted as a scalar is)
                    m = int(types[at].bits)
                    if types[t].sign: parts.push("sl_f2iv{m}({gl_expr(a)})")
                    else: parts.push("vec{m}({gl_expr(a)})")
                    if types[t].sign and gl_first("f2iv{m}"):
                        gl_float_to_int("0.0", T_I32)
                        sw = ["x", "y", "z", "w"]
                        cs: str[]
                        loop j in [0..m): cs.push(gl_float_to_int("v.{sw[j]}", T_I32))
                        gl_decls.push("ivec{m} sl_f2iv{m}(vec{m} v) \{\n    return ivec{m}({join(cs, ", ")});\n}\n")
                else: parts.push(gl_expr(a))
            if t == T_MAT4 and nkids(e) == 0: return "mat4(1.0)"
            return "{gl_type(t, nodes[e].pos)}({join(parts, ", ")})"
        if id == .sqrt: return "sqrt({gl_expr(kid(e, 0))})"
        gl_err(nodes[e].pos, "this operation is not available in shaders")
    if k == .call:
        aux = int(nodes[e].aux)
        if aux == 2:
            if gl_fc_type != 0 and t == gl_fc_type:
                gl_fc_changed = true
                if not gl_fc_pos_read(kid(e, 0)): gl_fc_written = true
            si = int(types[t].st)
            parts: str[]
            loop i in [0..int(structs[si].nfields)):
                a = kid(e, i)
                if a == 0: parts.push(gl_zero(int(fields[int(structs[si].fields) + i].type), nodes[e].pos))
                else: parts.push(gl_expr(a))
            # (mode 2: its position, gl_FragCoord, is never read from it: not copied in)
            if gl_fc_mode == 2 and t == gl_fc_type: parts[0] = "vec4(0.0)"
            if gl_fc_mode == 3 and t == gl_fc_type: parts.push("false")
            return "{gl_type(t, nodes[e].pos)}({join(parts, ", ")})"
        if aux != 0: gl_err(nodes[e].pos, "function values cannot be called in shaders")
        vo_call = gl_vo_call
        gl_vo_call = false
        f = int(nodes[e].sym)
        decl = int(fns[f].decl)
        nm = name_of(int(nodes[decl].name))
        args: str[]
        if modules[int(nodes[decl].mod)].is_prelude:
            if builtin_map.get(nm) != none or nm == "texel" or nm == "texture_size" or nm == "set_depth" or (nkids(e) > 0 and is_gpu_buffer(ntype(kid(e, 0)))):
                loop i in [0..nkids(e)): args.push(gl_expr(kid(e, i)))
            if let g = builtin_map.get(nm):
                # (abs of the smallest integer is itself, as on the CPU: GLSL's is undefined)
                if nm == "abs" and (types[t].kind == .int_ or (is_vec(t) and types[t].sign)):
                    tn = gl_type(t, nodes[e].pos)
                    un = "uint"
                    if is_vec(t): un = "uvec{types[t].bits}"
                    if gl_first("abs_{tn}"): gl_decls.push("{tn} sl_abs_{tn}({tn} x) \{\n    return {tn}({sl_abs_body(t, un)});\n}\n")
                    return gl_narrow("sl_abs_{tn}({args[0]})", t)
                # (unsigned numbers compared as such; abs(i8(-128)) is -128, as on the CPU)
                if gl_unsigned(t) and (nm == "min" or nm == "max" or nm == "clamp"):
                    us: str[]
                    loop x in args: us.push("uint({x})")
                    return "int({g}({join(us, ", ")}))"
                return gl_narrow("{g}({join(args, ", ")})", t)
            # (lib/game/gpu.jo: what these do on the CPU, for the software renderer)
            if nm == "discard":
                if gl_stage != "fragment": gl_err(nodes[e].pos, "discard() can only be used in the fragment shader")
                return "discard"
            if nm == "set_depth":
                if gl_stage != "fragment": gl_err(nodes[e].pos, "set_depth() can only be used in the fragment shader")
                gl_depth_used = true
                return "(gl_FragDepth = {args[0]})"
            if nm == "instance_id" or nm == "vertex_id":
                if gl_stage != "vertex": gl_err(nodes[e].pos, "{nm}() can only be used in the vertex shader")
                # (sl_ibase: the first instance of an indirect draw, as Vulkan counts them)
                if nm == "instance_id": return "(gl_InstanceID + sl_ibase)"
                return "gl_VertexID"
            if starts_with(nm, "subgroup_"): gl_err(nodes[e].pos, "{nm}() can be used in compute functions only")
            if nm == "texel": return "texelFetch({args[0]}, {args[1]}, 0)"
            if nm == "texture_size": return "textureSize({args[0]}, 0)"
            if nkids(e) > 0 and is_gpu_buffer(ntype(kid(e, 0))):
                if nm == "len": return "{args[0]}_n"
                if nm == "[]": return "{gl_gbuf_reader(gpu_buffer_elem(ntype(kid(e, 0))), nodes[e].pos)}({args[0]}_t, {args[0]}_n, {args[1]})"
                if nm == "[]=" or starts_with(nm, "atomic_"): gl_err(nodes[e].pos, "GPU buffers are written by compute programs only")
            # prelude helpers written in Sloppy (e.g. vector math) are translated like user code
        args = []
        bindings: str[]
        specialized = false
        loop i in [0..nkids(e)):
            a = kid(e, i)
            path = gl_uniform_path(a)
            l = fns[f].params[i]
            if (starts_with(path, "sl_u") or gl_is_in(path)) and gl_uniform_struct(ntype(a)) and int(locals[l].flags) & LF_MUTPARAM == 0:
                bindings.push(path)
                specialized = true
            else:
                bindings.push("")
                if gl_opaque(ntype(a)) and types[prune(ntype(a))].kind == .struct_:
                    leaves: str[]
                    gl_leaf_args(a, leaves)
                    args.push(join(leaves, ", "))
                else: args.push(gl_expr(a))
        if not specialized: bindings = []
        gl_vo_next = vo_call
        called = gl_function(f, bindings)
        return "{called}({join(args, ", ")})"
    if k == .array and types[t].kind == .fixed:
        # [a, b, c], [] or fill(v, N): an array constructor
        parts: str[]
        et = int(types[t].elem)
        if nodes[e].b != 0:
            v = gl_wrap(gl_expr(kid(e, 0)), et, nodes[e].pos)
            loop i in [0..fixed_len(t)): parts.push(v)
        else if nkids(e) == 0: return gl_zero(t, nodes[e].pos)
        else:
            loop i in [0..nkids(e)): parts.push(gl_wrap(gl_expr(kid(e, i)), et, nodes[e].pos))
        return "{gl_type(t, nodes[e].pos)}({join(parts, ", ")})"
    if k == .array: gl_err(nodes[e].pos, "growable arrays (T[]) cannot be used in shaders; use a fixed-size array T[N]")
    gl_err(nodes[e].pos, "unsupported expression in shader")
    ""

# x op y for operands of type ta, giving type t: unsigned integers divide, take remainders,
# shift and compare as unsigned numbers; narrow ones wrap to their range, as on the CPU
# (Integer + - * go through unsigned numbers, whose overflow wraps by definition: NVIDIA's GLSL
# compiler assumes signed results do not overflow, and then abs(a * a) - abs(a * a) / 1 need not
# be 0. tb: the right operand's type, where it may be a scalar beside a vector.)
gl_arith = (op: Tok, x: str, y: str, ta: int, t: int, tb: int = 0) -> str:
    if op == .plus or op == .minus or op == .star:
        if types[prune(ta)].kind == .int_ and types[prune(t)].kind == .int_: return gl_narrow("int(uint({x}) {gl_binop(op)} uint({y}))", t)
        if is_vec(t) and types[prune(t)].sign:
            n = int(types[prune(t)].bits)
            ux = "uint({x})"
            if is_vec(ta): ux = "uvec{n}({x})"
            uy = "uint({y})"
            if tb == 0 or is_vec(tb): uy = "uvec{n}({y})"
            return "ivec{n}({ux} {gl_binop(op)} {uy})"

    if types[prune(ta)].kind == .bool_:
        # (both sides, as and= and or= compute them: not && and ||, which may skip the right)
        if op == .amp: return "bool(int({x}) & int({y}))"
        if op == .pipe: return "bool(int({x}) | int({y}))"
        if op == .caret: return "({x} != {y})"
    if (op == .shl or op == .shr) and types[prune(ta)].kind == .int_:
        # (as on the CPU: by the count's low 6 bits, and by 32 or more nothing is left)
        gl_shift_decls()
        if op == .shl: return gl_narrow("sl_shl({x}, {y})", t)
        if gl_unsigned(ta): return "sl_shru({x}, {y})"
        return "sl_shr({x}, {y})"
    # (% keeps the dividend's sign, as on the CPU: GLSL's mod() takes the divisor's, and its %
    # is undefined for negative numbers)
    if op == .percent and (is_float(ta) or is_vec(ta)): return "({x} - {y} * trunc({x} / {y}))"
    if gl_unsigned(ta):
        if op == .slash or op == .percent or op == .shr: return gl_narrow("int(uint({x}) {gl_binop(op)} uint({y}))", t)
        if op == .lt or op == .le or op == .gt or op == .ge: return "(uint({x}) {gl_binop(op)} uint({y}))"
    if (op == .slash or op == .percent) and (types[prune(ta)].kind == .int_ or (is_vec(ta) and types[prune(ta)].sign)):
        # (the smallest integer / -1 wraps, as on the CPU; GLSL leaves it undefined)
        d = gl_sdiv(prune(ta), tb)
        if op == .slash: return gl_narrow("{d}({x}, {y})", t)
        return gl_narrow("int(uint({x}) - uint({d}({x}, {y})) * uint({y}))", t)
    if op == .plus or op == .minus or op == .star or op == .slash or op == .shl: return gl_narrow("({x} {gl_binop(op)} {y})", t)
    "({x} {gl_binop(op)} {y})"

# the name of a helper dividing signed integers (or integer vectors, by a vector or a number)
# that by -1 divides by 1 and negates: the smallest integer / -1 is itself, as on the CPU
gl_sdiv = (ta: int, tb: int) -> str:
    if gl_first("sdiv"): gl_decls.push("int sl_sdiv(int a, int b) \{\n    int q = a / (b == -1 ? 1 : b);\n    return b == -1 ? int(-uint(a)) : q;\n}\n")
    if types[ta].kind == .int_: return "sl_sdiv"
    n = int(types[ta].bits)
    sc = tb != 0 and not is_vec(tb)
    nm = "sl_sdiv{n}"
    bty = "ivec{n}"
    if sc:
        nm = "sl_sdiv{n}s"
        bty = "int"
    if gl_first(nm):
        sw = ["x", "y", "z", "w"]
        cs: str[]
        loop j in [0..n):
            if sc: cs.push("sl_sdiv(a.{sw[j]}, b)")
            else: cs.push("sl_sdiv(a.{sw[j]}, b.{sw[j]})")
        gl_decls.push("ivec{n} {nm}(ivec{n} a, {bty} b) \{\n    return ivec{n}({join(cs, ", ")});\n}\n")
    nm

# (the body of sl_abs: x below 0 negated through unsigned numbers, which wrap; by component)
sl_abs_body = (t: int, un: str) -> str:
    if not is_vec(t): return "x < 0 ? -uint(x) : uint(x)"
    sw = ["x", "y", "z", "w"]
    cs: str[]
    loop j in [0..int(types[t].bits)): cs.push("x.{sw[j]} < 0 ? -uint(x.{sw[j]}) : uint(x.{sw[j]})")
    "{un}({join(cs, ", ")})"

gl_unsigned = (t0: int) -> bool:
    t = prune(t0)
    types[t].kind == .int_ and not types[t].sign

gl_shift_decls = ():
    if not gl_first("shift"): return
    gl_decls.push("int sl_shl(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? 0 : x << c;\n}\n")
    gl_decls.push("int sl_shr(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? x >> 31 : x >> c;\n}\n")
    gl_decls.push("int sl_shru(int x, int c) \{\n    c &= 63;\n    return c >= 32 ? 0 : int(uint(x) >> uint(c));\n}\n")

# x (32 bits) wrapped to the range of a narrower integer type t
gl_narrow = (x: str, t0: int) -> str:
    t = prune(t0)
    if types[t].kind != .int_: return x
    bits = int(types[t].bits)
    if bits >= 32: return x
    if not types[t].sign: return "({x} & {(1 << bits) - 1})"
    "(({x} << {32 - bits}) >> {32 - bits})"

# float x to integer type t, as on the CPU: toward zero, saturating at t's range (32 bits at
# most), NaN to 0
gl_float_to_int = (x: str, t0: int) -> str:
    t = prune(t0)
    bits = int(types[t].bits)
    if bits > 32: bits = 32
    sg = types[t].sign
    lo = 0
    hi = (1 << bits) - 1
    if sg:
        lo = -(1 << (bits - 1))
        hi = (1 << (bits - 1)) - 1
    if gl_first("f2i"):
        # (2^31 - 1 and 2^32 - 1 are not floats: clamped to the largest float below, the top tested apart)
        gl_decls.push("int sl_f2i(float x, float lo, float top, float hi1, int him) \{\n    if (isnan(x)) return 0;\n    if (x >= hi1) return him;\n    return int(clamp(x, lo, top));\n}\n")
        gl_decls.push("int sl_f2u(float x, float top) \{\n    if (isnan(x)) return 0;\n    if (x >= 4294967296.0) return -1;\n    return int(uint(clamp(x, 0.0, top)));\n}\n")
    if bits == 32 and not sg: return "sl_f2u({x}, 4294967040.0)"
    top = f64(hi)
    if bits == 32: top = 2147483520.0
    "sl_f2i({x}, {gl_float(f64(lo))}, {gl_float(top)}, {gl_float(f64(hi) + 1.0)}, {hi})"

# ---------------- GPU buffers ----------------
gl_gbuf_decls = ():
    if not gl_first("gbuf"): return
    gl_decls.push("uint gb_w(highp isampler2D t, int i) \{\n    return uint(texelFetch(t, ivec2((i >> 2) & 1023, i >> 12), 0)[i & 3]);\n}\n")
    # (bits of the word holding byte a, from bit 8 * (a & 3); sign-extended if sgn)
    gl_decls.push("int gb_sub(highp isampler2D t, int a, int bits, bool sgn) \{\n    uint w = gb_w(t, a >> 2) >> uint((a & 3) * 8);\n    int sh = 32 - bits;\n    if (sgn) return int(w << uint(sh)) >> sh;\n    return int((w << uint(sh)) >> uint(sh));\n}\n")
    # (an f64 from its two words, rounded to an f32 as compiler/spirv.jo does)
    gl_decls.push("float gb_f64(uint lo, uint hi) \{\n    uint e = (hi >> 20) & 0x7FFu;\n    uint m = ((hi & 0xFFFFFu) << 3) | (lo >> 29);\n    uint bits = (((e - 896u) << 23) | m) + ((lo >> 28) & 1u);\n    if (e >= 1151u || bits >= 0x7F800000u) bits = 0x7F800000u;\n    if (e <= 896u) bits = 0u;\n    if (e == 0x7FFu && (m | lo) != 0u) bits = 0x7FC00000u;\n    return uintBitsToFloat(bits | (hi & 0x80000000u));\n}\n")

# the name of a function reading element i of a buffer of t (made once per type and stage); past
# either end it reads the nearest element, as with Vulkan
gl_gbuf_reader = (t: int, pos: int) -> str:
    nm = gl_type_name(3 * prune(t) + 2, "gbr")
    if not gl_first(nm): return nm
    gl_gbuf_decls()
    layout(t)
    ty = gl_type(t, pos)
    gl_decls.push("{ty} {nm}(highp isampler2D b_t, int b_n, int i) \{\n    int o = clamp(i, 0, max(b_n - 1, 0)) * {tsize(t)};\n    return {gl_read(t, "o", 0, pos)};\n}\n")
    nm

# a value of type t at byte o + c of buffer b (laid out as the CPU lays it out)
gl_read = (t0: int, o: str, c: int, pos: int) -> str:
    t = prune(t0)
    k = types[t].kind
    a = "{o} + {c}"
    w = "gb_w(b_t, ({a}) >> 2)"
    if k == .float_:
        if int(types[t].bits) == 64: return "gb_f64({w}, gb_w(b_t, ({o} + {c + 4}) >> 2))"
        return "uintBitsToFloat({w})"
    if k == .int_:
        bits = int(types[t].bits)
        if bits >= 32: return "int({w})"
        sg = "false"
        if types[t].sign: sg = "true"
        return "gb_sub(b_t, {a}, {bits}, {sg})"
    if k == .bool_: return "(gb_sub(b_t, {a}, 8, false) != 0)"
    parts: str[]
    if k == .vec:
        if t == T_MAT4:
            loop col in [0..4): parts.push(gl_read(T_VEC4, o, c + 16 * col, pos))
        else:
            loop i in [0..int(types[t].bits)):
                wi = "gb_w(b_t, ({o} + {c + 4 * i}) >> 2)"
                if types[t].sign: parts.push("int({wi})")
                else: parts.push("uintBitsToFloat({wi})")
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    if k == .struct_:
        si = int(types[t].st)
        if is_lib_texture(si) or is_gpu_buffer(t): gl_err(pos, "a {structs[si].name} cannot be read from a GPU buffer")
        layout(t)
        loop i in [0..int(structs[si].nfields)):
            f = int(structs[si].fields) + i
            parts.push(gl_read(int(fields[f].type), o, c + int(fields[f].offset), pos))
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    if k == .fixed:
        el = int(types[t].elem)
        layout(el)
        loop i in [0..fixed_len(t)): parts.push(gl_wrap(gl_read(el, o, c + i * tsize(el), pos), el, pos))
        return "{gl_type(t, pos)}({join(parts, ", ")})"
    gl_err(pos, "type {type_str(t)} cannot be read from a GPU buffer")
    ""

# ---------------- stage wrappers ----------------
gl_struct_fields = (t: int) -> (str, int)[]:
    si = int(types[prune(t)].st)
    check_struct_fields(si)
    out: (str, int)[]
    loop i in [0..int(structs[si].nfields)):
        f = int(structs[si].fields) + i
        out.push((name_of(int(fields[f].name)), int(fields[f].type)))
    out

gl_attrib_comps = (t: int, pos: int) -> int:
    tt = prune(t)
    if types[tt].kind == .float_ and int(types[tt].bits) == 32: return 1
    if types[tt].kind == .vec and tt != T_MAT4 and not types[tt].sign: return int(types[tt].bits)
    gl_err(pos, "vertex attributes must be f32, vec2, vec3 or vec4 (found {type_str(tt)})")
    0

uniform_kind = (t0: int, pos: int) -> str:
    t = prune(t0)
    k = types[t].kind
    if k == .float_:
        if int(types[t].bits) == 32: return "f"
        return "d"
    if k == .int_: return "i"
    if k == .bool_: return "b"
    if k == .vec:
        if t == T_MAT4: return "m"
        if types[t].sign: return "I"
        return "v{types[t].bits}"
    if k == .struct_ and is_lib_texture(int(types[t].st)): return "t"
    if is_gpu_buffer(t): return "B"
    gl_err(pos, "uniform fields must be numbers, vectors, mat4 or Texture, or fixed-size arrays of them (found {type_str(t)})")
    ""

# the uniforms' layout entries for struct type t at byte offset base: ";name,kind,offset" (an
# array: ",count,stride" more). Independent GLSL leaf names use field-index paths.
gl_udesc = (t: int, prefix: str, base: int, pos: int) -> str:
    out = ""
    si = int(types[prune(t)].st)
    layout(t)
    loop i in 0.. and f in gl_struct_fields(t):
        fo = base + int(fields[int(structs[si].fields) + i].offset)
        ft = prune(f.1)
        if types[ft].kind == .fixed:
            # an array: its element kind, then the count and the bytes per element
            et = int(types[ft].elem)
            if is_gpu_buffer(et): gl_err(pos, "uniforms cannot hold arrays of GPU buffers")
            out += ";{prefix}_{i},{uniform_kind(et, pos)},{fo},{fixed_len(ft)},{tsize(et)}"
        else if types[ft].kind == .struct_ and not is_lib_texture(int(types[ft].st)) and not is_gpu_buffer(ft):
            out += gl_udesc(ft, "{prefix}_{i}", fo, pos)
        else: out += ";{prefix}_{i},{uniform_kind(f.1, pos)},{fo}"
    out

# the translation's state, for a stage (and for a new program: its type names too)
gl_reset = (stage: str, program: bool):
    global gl_decls, gl_done, gl_done_fns, gl_done_structs, gl_stage, gl_uniform_bindings, gl_uniforms, gl_specializations, gl_uniform_rows, gl_uniform_samplers
    global gl_type_names, gl_type_count, gl_fn_ids, gl_fn_count, gl_local_ids, gl_local_count, gl_temps, gl_depth_used
    gl_decls = []
    gl_depth_used = false
    gl_done_fns = {}
    gl_done_structs = {}
    gl_done = {}
    gl_uniform_bindings = {}
    gl_uniforms = []
    gl_uniform_rows = 0
    gl_uniform_samplers = 0
    gl_specializations = 0
    gl_stage = stage
    gl_fn_ids = {}
    gl_fn_count = 0
    gl_local_ids = {}
    gl_local_count = 0
    gl_temps = 0
    if program:
        gl_type_names = {}
        gl_type_count = 0

# a function's name in Sloppy and where it is, for error reports (never in the GLSL text: a
# shader's text stays the same when code before it moves)
gl_where = (f: int) -> str: "{name_of(int(nodes[int(fns[f].decl)].name))} at {pos_str(nodes[int(fns[f].decl)].pos)}"

# returns (vertex source, fragment source, layout description, where the stages are in the
# Sloppy source). With SLOPPY_GLSL_DUMP=dir, the stages are also written to dir/<n>.vert and
# dir/<n>.frag (tools/shaderstable.py)
glsl_build = (vsf: int, fsf: int) -> (str, str, str, str):
    global gl_fc_type, gl_fc_field, gl_fc_mode, gl_fc_read, gl_fc_changed, gl_fc_written, gl_in_types, gl_in_read, gl_vo_type, gl_vo_next, gl_vo_local, gl_vo_failed
    gl_reset("vertex", true)
    vpos = nodes[int(fns[vsf].decl)].pos
    vtype_ = int(fns[vsf].ptypes[0])
    np = fns[vsf].ptypes.len()
    itype = 0
    if np == 3: itype = int(fns[vsf].ptypes[1])
    utype = int(fns[vsf].ptypes[np - 1])
    otype = int(fns[vsf].ret)
    vb = fill("", np)
    vmut = int(locals[fns[vsf].params[np - 1]].flags) & LF_MUTPARAM != 0
    if not vmut: vb[np - 1] = "sl_u"
    # (the vertex and the instance bound: read from their attributes; see gl_in_types)
    gl_in_types = {"va": prune(vtype_), "vi": prune(itype)}
    vbind = vb
    if int(locals[fns[vsf].params[0]].flags) & LF_MUTPARAM == 0: vbind[0] = "sl_va"
    if np == 3 and int(locals[fns[vsf].params[1]].flags) & LF_MUTPARAM == 0: vbind[1] = "sl_vi"
    # (and its outputs written where they go, gl_vo_next; a vertex function reading none of its
    # input, or doing what that cannot take, translated again)
    gl_vo_type = prune(otype)
    gl_vo_local = -1
    gl_vo_failed = false
    gl_in_read = false
    gl_vo_next = true
    vname = gl_function(vsf, vbind)
    vo = gl_in_read and not gl_vo_failed
    if gl_in_read: vb = vbind
    if not vo:
        gl_vo_type = 0
        gl_reset("vertex", true)
        vname = gl_function(vsf, vb)
    gl_vo_type = 0
    vinit = ""
    if vmut: vinit = "    {gl_type(utype, vpos)} u = {gl_uniform_value(utype, "sl_u", vpos)};\n"
    vuniforms = join(gl_uniforms, "")
    vrows = gl_uniform_rows + 1
    vsamplers = gl_uniform_samplers
    vdecls = gl_decls
    vout = gl_type(otype, vpos)      # (its name in the vertex stage: see gl_struct_name)
    gl_reset("fragment", false)
    fmut = int(locals[fns[fsf].params[1]].flags) & LF_MUTPARAM != 0
    fb = ["", if fmut: "" else: "sl_u"]
    gl_fc_type = prune(int(fns[fsf].ptypes[0]))
    gl_fc_field = gl_struct_fields(otype)[0].0
    gl_in_types["in"] = gl_fc_type
    # (the input bound, read from its varyings; mode 2, or 3 translated again; a stage reading
    # none of its input translated again unbound, as before)
    fbind = fb
    if int(locals[fns[fsf].params[0]].flags) & LF_MUTPARAM == 0: fbind[0] = "sl_in"
    gl_fc_mode = 2
    gl_fc_read = false
    gl_fc_written = false
    gl_in_read = false
    fname = gl_function(fsf, fbind)
    if gl_fc_written:
        gl_fc_mode = 3
        gl_reset("fragment", false)
        gl_fc_read = false
        gl_in_read = false
        fname = gl_function(fsf, fbind)
    if gl_in_read: fb = fbind
    else:
        gl_reset("fragment", false)
        gl_fc_read = false
        fname = gl_function(fsf, fb)
    finit = ""
    farg = ""
    if fmut:
        finit = "    {gl_type(utype, vpos)} u = {gl_uniform_value(utype, "sl_u", vpos)};\n"
        farg = ", u"
    funiforms = join(gl_uniforms, "")
    frows = gl_uniform_rows
    fsamplers = gl_uniform_samplers
    fdecls = gl_decls
    head = "#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;\n"
    # uniforms
    gl_struct_fields(utype)
    layout(utype)
    udesc = "U{tsize(utype)}"
    udesc += gl_udesc(utype, "sl_u", 0, vpos)
    # vertex attributes
    vfields = gl_struct_fields(vtype_)
    vsi = int(types[prune(vtype_)].st)
    layout(vtype_)
    adesc = "A{tsize(vtype_)}"
    vs = head + "// sloppy shader: {name_of(int(nodes[int(fns[vsf].decl)].name))}\n"
    attribs = vfields.len()
    loop i in 0.. and f in vfields:
        c = gl_attrib_comps(f.1, vpos)
        ty = "float"
        if c > 1: ty = "vec{c}"
        vs += "layout(location={i}) in {ty} a_{f.0};\n"
        adesc += ";{f.0},{c},{int(fields[int(structs[vsi].fields) + i].offset)}"
    idesc = ""
    ifields: (str, int)[]
    if itype != 0:
        ifields = gl_struct_fields(itype)
        isi = int(types[prune(itype)].st)
        layout(itype)
        idesc = "|I{tsize(itype)}"
        loc = vfields.len()
        loop i in 0.. and f in ifields:
            off = int(fields[int(structs[isi].fields) + i].offset)
            if prune(f.1) == T_MAT4:
                vs += "layout(location={loc}) in mat4 i_{f.0};\n"
                loop col in [0..4): idesc += ";{f.0},4,{off + 16 * col}"
                loc += 4
            else:
                c = gl_attrib_comps(f.1, vpos)
                ty = "float"
                if c > 1: ty = "vec{c}"
                vs += "layout(location={loc}) in {ty} i_{f.0};\n"
                idesc += ";{f.0},{c},{off}"
                loc += 1
        attribs = loc
    ofields = gl_struct_fields(otype)
    if ofields.len() == 0 or prune(ofields[0].1) != T_VEC4: gl_err(vpos, "the vertex shader must return a struct whose first field is the clip position (vec4)")
    varying_rows = 0
    loop i in 0.. and f in ofields:
        if i > 0: varying_rows += gl_resource_cost(f.1).0
    vs += "// sloppy resources: uniforms={vrows} samplers={vsamplers} varyings={varying_rows} attributes={attribs}\n"
    vs += vuniforms + "uniform int sl_ibase;\n"
    loop i in 0.. and f in ofields:
        if i == 0: continue
        q = ""
        if types[prune(f.1)].kind == .int_ or (types[prune(f.1)].kind == .vec and types[prune(f.1)].sign): q = "flat "
        vs += "{q}out {gl_type(f.1, vpos)} v_{f.0};\n"
    vs += join(vdecls, "")
    vin: str[]
    loop f in vfields: vin.push("a_{f.0}")
    # (a bound input is no argument: its function reads the attributes)
    vargs: str[]
    vs += "void main() \{\n"
    if vb[0] == "":
        vs += "    {gl_type(vtype_, vpos)} vin = {gl_type(vtype_, vpos)}({join(vin, ", ")});\n"
        vargs.push("vin")
    vs += vinit
    if itype != 0 and vb[1] == "":
        iin: str[]
        loop f in ifields: iin.push("i_{f.0}")
        vs += "    {gl_type(itype, vpos)} iin = {gl_type(itype, vpos)}({join(iin, ", ")});\n"
        vargs.push("iin")
    if vmut: vargs.push("u")
    # (written by the vertex function itself, or copied from what it returns)
    if vo: vs += "    {vname}({join(vargs, ", ")});\n"
    else:
        vs += "    {vout} o = {vname}({join(vargs, ", ")});\n    gl_Position = o.{ofields[0].0}_;\n"
        loop i in 0.. and f in ofields:
            if i > 0: vs += "    v_{f.0} = o.{f.0}_;\n"
    vs += "}\n"
    fs = head + "// sloppy shader: {name_of(int(nodes[int(fns[fsf].decl)].name))}\n// sloppy resources: uniforms={frows} samplers={fsamplers} varyings={varying_rows} attributes=0\n" + funiforms
    loop i in 0.. and f in ofields:
        if i == 0: continue
        q = ""
        if types[prune(f.1)].kind == .int_ or (types[prune(f.1)].kind == .vec and types[prune(f.1)].sign): q = "flat "
        fs += "{q}in {gl_type(f.1, vpos)} v_{f.0};\n"
    # (a struct of vec4s: one output per field, at locations 0, 1...: the render target's colors)
    nout = frag_outputs(fsf)
    ofs: (str, int)[] = []
    if nout == 0: fs += "out vec4 frag_color;\n"
    else:
        ofs = gl_struct_fields(int(fns[fsf].ret))
        loop k in [0..nout): fs += "layout(location = {k}) out vec4 frag_color_{k};\n"
    fs += join(fdecls, "")
    fin: str[] = [if gl_fc_read or gl_fc_mode == 3: "vec4(0.0)" else: "gl_FragCoord"]
    loop i in 0.. and f in ofields:
        if i > 0: fin.push("v_{f.0}")
    if gl_fc_mode == 3: fin.push("true")                 # (the input: its position gl_FragCoord)
    # (a shader that writes its depth starts from the interpolated one, so a path that does not
    # write it keeps it; only such a shader mentions gl_FragDepth, which turns early depth tests off)
    if gl_depth_used: finit = "    gl_FragDepth = gl_FragCoord.z;\n" + finit
    # (a bound input is no argument: its function reads the varyings)
    fmain = "    {gl_type(otype, vpos)} i = {gl_type(otype, vpos)}({join(fin, ", ")});\n"
    fcall = "i{farg}"
    if fb[0] != "":
        fmain = ""
        fcall = if fmut: "u" else: ""
    if nout == 0: fs += "void main() \{\n{finit}{fmain}    frag_color = {fname}({fcall});\n}\n"
    else:
        fs += "void main() \{\n{finit}{fmain}    {gl_type(int(fns[fsf].ret), vpos)} o = {fname}({fcall});\n"
        loop k in [0..nout): fs += "    frag_color_{k} = o.{ofs[k].0}_;\n"
        fs += "}\n"
    # Struct-valued leaves (GPU buffers) and stage interfaces precede global declarations.
    vs = __hoist_struct(vs)
    fs = __hoist_struct(fs)
    if let dir = env("SLOPPY_GLSL_DUMP"):
        write_file("{dir}/{gl_dumped}.vert", vs)
        write_file("{dir}/{gl_dumped}.frag", fs)
        gl_dumped += 1
    gl_fc_type = 0
    gl_fc_mode = 0
    (vs, fs, "{adesc}|{udesc}{idesc}", "vertex: {gl_where(vsf)}\nfragment: {gl_where(fsf)}\n")

gl_dumped = 0

# the fragment program of a dotted expression on GPU arrays (see check_dotted): kernel f takes the
# current element of each array (texture uniforms t0, t1...) and each number (uniforms s0, s1...),
# in the order desc lists them ('t' or 's'); the result goes to the red channel. Each fragment is
# one element of the result: its index in the result's shape (od, padded to 4 dimensions) picks
# each array's element through that array's steps (st0, st1...; 0 where it is stretched).
# (see __gpu_run in lib/game/gpuarray.jo)
glsl_kernel = (f: int, desc: str) -> str:
    gl_reset("kernel", true)
    kname = gl_function(f)
    pos = nodes[int(fns[f].decl)].pos
    src = "#version 300 es\nprecision highp float;\nprecision highp int;\nprecision highp sampler2D;\nuniform ivec4 od;\nuniform int ow;\n"
    # desc: one letter per operand: t a float texture, i an integer one, s a float number, n an
    # integer number. Textures hold 4 values per texel; a fragment computes 4 results.
    args: str[]
    fetch = ""
    fdecl = ""
    idecl = ""
    nt = 0
    nf = 0
    ni = 0
    loop c in desc:
        if c == 't' or c == 'i':
            sampler = "sampler2D"
            if c == 'i': sampler = "isampler2D"
            src += "uniform highp {sampler} t{nt};\nuniform ivec4 st{nt};\nuniform int w{nt};\n"
            fetch += "        int o{nt} = i0 * st{nt}.x + i1 * st{nt}.y + i2 * st{nt}.z + i3 * st{nt}.w;\n"
            args.push("texelFetch(t{nt}, ivec2((o{nt} >> 2) % w{nt}, (o{nt} >> 2) / w{nt}), 0)[o{nt} & 3]")
            nt += 1
        else if c == 's':
            fdecl += "uniform float sf{nf};\n"
            args.push("sf{nf}")
            nf += 1
        else:
            idecl += "uniform int si{ni};\n"
            args.push("si{ni}")
            ni += 1
    rt = gl_type(int(fns[f].ret), pos)
    int_out = rt == "int"
    src += fdecl + idecl
    if int_out: src += "out highp ivec4 o_;\n"
    else: src += "out vec4 o_;\n"
    src += join(gl_decls, "")
    val = "{kname}({join(args, ", ")})"
    if not int_out and rt != "float": val = "float({val})"
    zero = "vec4(0.0)"
    if int_out: zero = "ivec4(0)"
    src += "void main() \{\n    int base = (int(gl_FragCoord.y) * ow + int(gl_FragCoord.x)) * 4;\n"
    src += "    int total = od.x * od.y * od.z * od.w;\n"
    if int_out: src += "    ivec4 r = {zero};\n"
    else: src += "    vec4 r = {zero};\n"
    src += "    for (int c = 0; c < 4; c++) \{\n        int lin = base + c;\n        if (lin >= total) break;\n"
    src += "        int i3 = lin % od.w;\n        int q = lin / od.w;\n        int i2 = q % od.z;\n        q /= od.z;\n        int i1 = q % od.y;\n        int i0 = q / od.y;\n"
    src + fetch + "        r[c] = {val};\n    }\n    o_ = r;\n}\n"

# move every struct definition above the first `uniform` declaration
__hoist_struct = (src: str) -> str:
    parts = split(src, "\n")
    structs_: str[]
    rest: str[]
    in_struct = false
    loop p in parts:
        if starts_with(p, "struct "): in_struct = true
        if in_struct: structs_.push(p)
        else: rest.push(p)
        if in_struct and p == "};": in_struct = false
    out: str[]
    placed = false
    loop p in rest:
        if not placed and (starts_with(p, "uniform ") or starts_with(p, "layout(") or starts_with(p, "out ") or starts_with(p, "in ") or starts_with(p, "flat ")):
            loop s in structs_: out.push(s)
            placed = true
        out.push(p)
    if not placed:
        loop s in structs_: out.push(s)
    join(out, "\n")
