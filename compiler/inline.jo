# Inlining for release builds. All functions are lowered and optimized first; then calls to
# small non-recursive functions are replaced by a copy of the callee's body (with renamed
# vregs and frame slots, and `ret` turned into a branch out of a wrapping block), and the
# caller is optimized again.

use 'ir.jo'
use 'opt.jo'

const INLINE_MAX = 24       # callee size limit, in IR instructions
const INLINE_LOOP_MAX = 96  # ... for a call in a loop to a leaf (a function that calls nothing)
const INLINE_WRAPPER_MAX = 64   # ... for a leaf called once by a function at most this size
const INLINE_FORCED_MAX = 4000      # ... for @inline (beyond it, a call costs nothing next to the body)
const INLINE_LOOPY_CALLER_MAX = 400     # (a leaf with a loop: only into callers this small)
inl_calls = 0               # calls (that return, not on rare paths) in the function being inlined into

rel_fns: IrFn[]             # lowered functions, in lowering order
rel_by_index: int[]         # lfunc index -> position in rel_fns (-1: not collected)

rel_collect = ():
    loop rel_by_index.len() <= ir.fn_index: rel_by_index.push(-1)
    rel_by_index[ir.fn_index] = rel_fns.len()
    rel_fns.push(ir)

# 0: not inlined, 1: small (inlined anywhere), 2: a leaf inlined into loops, 3: the same with a
# loop of its own (into callers that are not large: in a large one, what its loop keeps in
# registers may not get them, and a call costs little next to a loop)
inlinable = (f: IrFn) -> int:
    if f.cabi or f.noinline or len(f.export_name) > 0: return 0
    # (@inline: anywhere, unless it calls itself)
    if f.always_inline and f.code.len() <= INLINE_FORCED_MAX:
        loop ins in f.code:
            if ins.op == .call and ins.imm == f.fn_index: return 0
            if ins.op == .intr and ins.imm >= 2: return 0
        return 1
    if f.code.len() > INLINE_LOOP_MAX: return 0
    leaf = true
    has_loop = false
    loop ins in f.code:
        if ins.op == .loop: has_loop = true
        if ins.op == .call and ins.imm == f.fn_index: return 0         # recursive
        if ins.op == .intr and ins.imm >= 2: return 0                 # setjmp-like intrinsics
        # (calls on rarely taken paths, like the out-of-line refcounting during a parallel job,
        # do not count)
        if (ins.op == .call and ins.c == 0) or ins.op == .calli or ins.op == .callc or ins.op == .syscall: leaf = false
    if f.code.len() <= INLINE_MAX: return 1
    if leaf and has_loop: return 3
    if leaf: return 2
    0

defines_value = (op: Op) -> bool:
    match op:
        nop, block, loop, end, else_, br, brif, brtable, if_, ret, trap, store, copy, zero, memcpy, memset, zeroslots, assume, vop: false
        _: true

# copy an argument list (vregs renamed) into the caller's args; returns its start
remap_args = (callee: IrFn, start: int, n: int, vm: int[]) -> int:
    s = ir.args.len()
    loop k in [0..n): ir.args.push(i32(vm[int(callee.args[start + k])]))
    s

# rename the vregs and slots used by a callee instruction
remap = (c0: Ins, callee: IrFn, vm: int[], sm: int[]) -> Ins:
    c = c0
    a = int(c.a)
    bb = int(c.b)
    match c.op:
        nop, block, loop, end, else_, br, trap, iconst, fconst, gaddr, daddr, faddr: pass
        slot: c.a = i32(sm[a])
        intr, call, syscall: c.a = i32(remap_args(callee, a, bb, vm))
        calli, callc:
            c.a = i32(remap_args(callee, a, bb, vm))
            c.c = i32(vm[int(c.c)])
            ci = ccall_of(c0)
            if ci >= 0:
                cc = callee.ccalls[ci]
                if cc.slot >= 0: cc.slot = sm[cc.slot]
                ir.ccalls.push(cc)
                c.imm = cvariadic_of(c0) | (ir.ccalls.len() << 16)
        if_, brif, zero, assume: c.a = i32(vm[a])
        brtable:
            c.a = i32(vm[a])
            s = ir.args.len()
            loop k in [0..bb): ir.args.push(callee.args[int(c.c) + k])
            c.c = i32(s)
        ret:
            if a >= 0: c.a = i32(vm[a])
        store, copy:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
            if c.op == .store and int(c.c) & M_INDEX != 0: c.dst = i32(vm[int(c.dst)])
        memcpy, memset, select, vop:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
            c.c = i32(vm[int(c.c)])
        zeroslots:
            s = ir.args.len()
            loop k in [0..bb):
                item = int(callee.args[a + k])
                if item & 1 == 1: ir.args.push(i32((vm[item >> 1] << 1) | 1))
                else: ir.args.push(i32(sm[item >> 1] << 1))
            c.a = i32(s)
        load:
            c.a = i32(vm[a])
            if int(c.c) & M_INDEX != 0: c.b = i32(vm[bb])
        mov, neg, not_, fneg, fsqrt, fabs, ffloor, fceil, ftrunc, sext8, sext16, sext32, zext8, zext16, zext32, i2f, u2f, f2i, f2f, bits2f, f2bits:
            c.a = i32(vm[a])
        _:
            c.a = i32(vm[a])
            c.b = i32(vm[bb])
    if defines_value(c.op) and c.dst >= 0 and c.op != .store: c.dst = i32(vm[int(c.dst)])
    c

# splice callee's body in place of `call` (appending to out)
inline_call = (call: Ins, callee: IrFn, out: mut Ins[]):
    vm = fill(0, callee.vtypes.len())
    loop v in [0..callee.vtypes.len()):
        if int(callee.vtypes[v]) == VK: vm[v] = k_vreg(callee.kval[v])
        else: vm[v] = vreg(int(callee.vtypes[v]))
    sm = fill(0, callee.slot_size.len())
    loop s in [0..callee.slot_size.len()): sm[s] = new_slot(int(callee.slot_size[s]), int(callee.slot_align[s]))
    loop k in [0..int(call.b)):
        p = vm[k]
        out.push(Ins(.mov, i32(vtype(p)), i32(p), ir.args[int(call.a) + k], 0, 0, 0))
    if callee.raw_mem: ir.raw_mem = true
    # A single tail return needs no exit block. Besides avoiding dead branches, this lets
    # loop passes see a callback's arithmetic directly in the loop body.
    tail = callee.code.len() > 0 and callee.code[callee.code.len() - 1].op == .ret
    loop k in [0..callee.code.len() - 1):
        if callee.code[k].op == .ret: tail = false
    if not tail: out.push(Ins(.block, 0, 0, 0, 0, 0, 0))
    depth = 0
    loop ci in callee.code:
        op = ci.op
        if op == .ret:
            if ci.a >= 0 and call.dst >= 0:
                out.push(Ins(.mov, i32(vtype(int(call.dst))), call.dst, i32(vm[int(ci.a)]), 0, 0, 0))
            if not tail: out.push(Ins(.br, 0, 0, 0, 0, 0, depth))
            continue
        ni = remap(ci, callee, vm, sm)
        # (the calls of a callee inlined on a rarely taken path are on it too)
        if call.c == 2 and op == .call and ni.c == 0: ni.c = 2
        # (in a backtrace the inlined code is the call's line of the function it is in now)
        ni.pos = call.pos
        out.push(ni)
        if op == .block or op == .loop or op == .if_: depth += 1
        else if op == .end: depth -= 1
    if not tail: out.push(Ins(.end, 0, 0, 0, 0, 0, 0))

# the callee to inline for a call in a loop nest `depth` deep (-1: none)
inline_target = (ins: Ins, depth: int, self_pos: int, snap: IrFn[], can: int[]) -> int:
    j = inline_callee(ins, self_pos, snap)
    if j < 0: return -1
    if can[j] == 1 or (can[j] == 2 and depth > 0): return j
    if can[j] == 3 and depth > 0 and ir.code.len() <= INLINE_LOOPY_CALLER_MAX: return j
    # a leaf into a caller that is little more than the call (a wrapper, like a map's get around
    # its lookup): the caller becomes a leaf itself, which loops can then take in
    if can[j] >= 2 and ir.code.len() <= INLINE_WRAPPER_MAX and inl_calls == 1: return j
    -1

# the function a direct call (that returns) calls, if it was collected (-1: none)
inline_callee = (ins: Ins, self_pos: int, snap: IrFn[]) -> int:
    if ins.op != .call or ins.c == 1 or ins.imm >= rel_by_index.len(): return -1
    j = rel_by_index[int(ins.imm)]
    if j < 0 or j == self_pos or int(ins.b) != snap[j].nparams: return -1
    j

# inline small callees into the current function (ir); returns true if anything changed
inline_small_into = (self_pos: int, snap: IrFn[], can: int[]) -> bool:
    global inl_calls
    # (the calls that stay: not inlined by size, not on a rarely taken path)
    inl_calls = 0
    loop ins in ir.code:
        if ins.op == .calli or ins.op == .callc: inl_calls += 1
        else if ins.op == .call and ins.c == 0:
            j = inline_callee(ins, self_pos, snap)
            if j < 0 or can[j] != 1: inl_calls += 1
    any = false
    depth = 0
    kinds: Op[]
    loop ins in ir.code:
        if inline_target(ins, depth, self_pos, snap, can) >= 0:
            any = true
            break
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(ins.op)
            if ins.op == .loop: depth += 1
        else if ins.op == .end:
            if kinds.pop() == .loop: depth -= 1
    if not any: return false
    out: Ins[]
    out.reserve(ir.code.len() * 2)
    old = ir.code
    depth = 0
    kinds.clear()
    loop ins in old:
        j = inline_target(ins, depth, self_pos, snap, can)
        if j >= 0:
            inline_call(ins, snap[j], out)
            continue
        out.push(ins)
        if ins.op == .block or ins.op == .loop or ins.op == .if_:
            kinds.push(ins.op)
            if ins.op == .loop: depth += 1
        else if ins.op == .end:
            if kinds.pop() == .loop: depth -= 1
    ir.code = out
    true

# Function values passed to small higher-order helpers. Keep this separate from the ordinary
# inliner: most functions have no known function value, and pay only the initial scan.
const INLINE_VALUE_MAX = 200
const INLINE_VALUE_BUDGET = 800
const INLINE_VALUE_ROUNDS = 3

# A parameter's address may only be read, or forwarded to another read-only parameter.
# No copies, stores, returns or unknown calls: in particular a mut function parameter and a
# closure saved by a helper fail this test. Bound forwarding (and recursive call graphs).
inl_read_param = (f: IrFn, p: int, snap: IrFn[], fuel: int) -> bool:
    if fuel == 0: return false
    saved = ir.args
    loop ins in f.code:
        if ins.op == .load and int(ins.a) == p and int(ins.c) & M_INDEX == 0:
            if int(ins.c) != 8 or (ins.imm != 0 and ins.imm != 8): return false
            continue
        if ins.op == .call:
            loop k in [0..int(ins.b)):
                if int(f.args[int(ins.a) + k]) != p: continue
                if ins.imm < 0 or ins.imm >= rel_by_index.len(): return false
                j = rel_by_index[int(ins.imm)]
                if j < 0 or not inl_read_param(snap[j], k, snap, fuel - 1): return false
            continue
        # o_operands uses the current function's argument table.
        ir.args = f.args
        o_operands(ins)
        ir.args = saved
        loop u in o_buf:
            if u == p: return false
    true

# Conditional temporary initialization also defines registers (before their branch runs).
inl_value_defs = () -> int[]:
    defs = fill(0, ir.vtypes.len())
    loop p in [0..ir.nparams): defs[p] = 1
    loop ins in ir.code:
        if ins.dst >= 0 and defines_value(ins.op): defs[int(ins.dst)] += 1
        if ins.op == .zeroslots:
            loop k in [0..int(ins.b)):
                item = int(ir.args[int(ins.a) + k])
                if item & 1 == 1: defs[item >> 1] += 1
    defs

# The address of a closure is a single-definition slot address; both words have exactly one
# store. All uses stay in the initialization's structured scope, and no address escapes.
# Values in the environment are deliberately NOT treated as constants: shared captured cells
# still go through their original loads and stores, even when the callback is inlined.
inl_values = (self_pos: int, snap: IrFn[]) -> bool:
    nv = ir.vtypes.len()
    ns = ir.slot_size.len()
    if ns == 0: return false
    defs = inl_value_defs()
    sl = fill(-1, nv)
    fp = fill(-1, nv)
    loop ins in ir.code:
        d = int(ins.dst)
        if d < 0 or defs[d] != 1: continue
        if ins.op == .slot and ir.slot_size[int(ins.a)] == 16: sl[d] = int(ins.a)
        else if ins.op == .mov and sl[int(ins.a)] >= 0: sl[d] = sl[int(ins.a)]
        else if ins.op == .faddr: fp[d] = int(ins.imm)
    fun = fill(-1, ns)
    envv = fill(-1, ns)
    level = fill(-1, ns)
    ok = fill(true, ns)
    # C aggregate results write their slot through ABI metadata, not ordinary operands.
    loop cc in ir.ccalls:
        if cc.slot >= 0: ok[cc.slot] = false
    depth = 0
    loop ins in ir.code:
        if ins.op == .end or ins.op == .else_:
            loop s in [0..ns):
                if level[s] >= depth: level[s] = -1
        if ins.op == .end: depth -= 1
        a = int(ins.a)
        b = int(ins.b)
        if ins.op == .store and a >= 0 and sl[a] >= 0:
            s = sl[a]
            if int(ins.c) != 8: ok[s] = false
            else if ins.imm == 0 and fun[s] == -1 and fp[b] >= 0:
                fun[s] = fp[b]
                level[s] = depth
            else if ins.imm == 8 and envv[s] == -1 and fun[s] >= 0 and level[s] == depth and (defs[b] == 1 or is_kv(b)):
                envv[s] = b
            else: ok[s] = false
            if sl[b] >= 0: ok[sl[b]] = false
        else if ins.op == .load and a >= 0 and sl[a] >= 0:
            s = sl[a]
            if int(ins.c) != 8 or (ins.imm != 0 and ins.imm != 8) or level[s] < 0 or fun[s] < 0 or envv[s] < 0: ok[s] = false
        else if ins.op == .call:
            loop k in [0..b):
                u = int(ir.args[a + k])
                s = sl[u]
                if s < 0: continue
                j = inline_callee(ins, self_pos, snap)
                if level[s] < 0 or fun[s] < 0 or envv[s] < 0 or j < 0:
                    ok[s] = false
                else if snap[j].noinline or snap[j].cabi or snap[j].code.len() > INLINE_VALUE_MAX or not inl_read_param(snap[j], k, snap, 3): ok[s] = false
        else if ins.op == .zeroslots:
            loop k in [0..b):
                item = int(ir.args[a + k])
                if item & 1 == 0: ok[item >> 1] = false
                else if sl[item >> 1] >= 0: ok[sl[item >> 1]] = false
        else if ins.op == .mov and ins.dst >= 0 and sl[int(ins.dst)] >= 0: pass
        else if ins.op != .slot:
            o_operands(ins)
            loop u in o_buf:
                if sl[u] >= 0: ok[sl[u]] = false
        if ins.op == .block or ins.op == .loop or ins.op == .if_: depth += 1
    any = false
    loop s in [0..ns):
        if ok[s] and fun[s] >= 0 and envv[s] >= 0: any = true
    if not any: return false
    # Limit expansion per caller (no persistent clones, so also no unbounded clone cache).
    budget = INLINE_VALUE_BUDGET
    expand = fill(false, ns)
    loop ins in ir.code:
        if ins.op != .call: continue
        j = inline_callee(ins, self_pos, snap)
        take = false
        loop k in [0..int(ins.b)):
            s = sl[int(ir.args[int(ins.a) + k])]
            if s >= 0 and ok[s]:
                expand[s] = true
                take = true
        if take and j >= 0: budget -= snap[j].code.len()
    if budget < 0: return false
    out: Ins[]
    loop ins in ir.code:
        a = int(ins.a)
        if ins.op == .load and sl[a] >= 0 and ok[sl[a]]:
            s = sl[a]
            ni = ins
            if ins.imm == 0:
                ni.op = .faddr
                ni.a = 0
                ni.imm = fun[s]
            else:
                ni.op = .mov
                ni.a = i32(envv[s])
                ni.imm = 0
            ni.b = 0
            ni.c = 0
            out.push(ni)
        else if ins.op == .store and sl[a] >= 0 and ok[sl[a]]:
            if expand[sl[a]]: out.push(ins)
        else if ins.op == .call:
            take = false
            loop k in [0..int(ins.b)):
                s = sl[int(ir.args[a + k])]
                if s >= 0 and ok[s]: take = true
            if take: inline_call(ins, snap[inline_callee(ins, self_pos, snap)], out)
            else: out.push(ins)
        else: out.push(ins)
    ir.code = out
    loop s in [0..ns):
        if ok[s] and fun[s] >= 0 and envv[s] >= 0 and not expand[s]:
            # All reads and stores were removed; unused address instructions die in optimize.
            ir.slot_size[s] = 0
    true

# After a helper has been expanded, propagation exposes its callback's faddr. Resolve only
# single-definition registers; a variable assigned different function values stays indirect.
inl_direct_values = () -> bool:
    nv = ir.vtypes.len()
    defs = inl_value_defs()
    fp = fill(-1, nv)
    loop ins in ir.code:
        if ins.op == .faddr and defs[int(ins.dst)] == 1: fp[int(ins.dst)] = int(ins.imm)
    any = false
    loop i in [0..ir.code.len()):
        ins = ir.code[i]
        if ins.op == .calli and fp[int(ins.c)] >= 0:
            ins.op = .call
            ins.imm = fp[int(ins.c)]
            ins.c = 0
            any = true
        else if (ins.op == .eq or ins.op == .ne) and fp[int(ins.a)] >= 0 and is_kv(int(ins.b)) and kv_of(int(ins.b)) == 0:
            ins.op = .iconst
            ins.imm = if ir.code[i].op == .ne: 1 else: 0
            ins.a = 0
            ins.b = 0
            any = true
        ir.code[i] = ins
    any

inline_into = (self_pos: int, snap: IrFn[], can: int[]) -> bool:
    changed = inline_small_into(self_pos, snap, can)
    has_value = false
    loop ins in ir.code:
        if ins.op == .faddr:
            has_value = true
            break
    if not has_value: return changed
    loop _ in [0..INLINE_VALUE_ROUNDS):
        if not inl_values(self_pos, snap): break
        # Expand first, then replace loads from the now local closure slots. In the next round
        # those slots have no calls using them, and their two words disappear altogether.
        changed = true
        optimize()
        inl_values(self_pos, snap)
        optimize()
        if inl_direct_values():
            inline_small_into(self_pos, snap, can)
            optimize()
            # A named function's thunk may not have been visited in callee order yet (faddr
            # is not a call-graph edge). Inline its now exposed direct call as well.
            if inline_small_into(self_pos, snap, can): optimize()
    changed
