# Mach-O executable writer (macOS on arm64).
#
# macOS runs no static executables: dyld loads the program, binds the C functions it uses
# (lower.jo's mac_imports: slots in the data), and calls its entry point as main(argc, argv, envp).
# The file, in 16 KB pages (Apple's arm64 page size):
#   __PAGEZERO     4 GB of nothing below the program
#   __TEXT         the header and load commands, the code (from MACHO_TEXT_OFF), then rodata
#   __DATA         the data, all zeros at the start (zero-fill: no bytes in the file)
#   __LINKEDIT     the binds (dyld's opcodes), symbols, and the code signature
# The code signature is "ad hoc" (no certificate: a hash of each 4 KB page), which arm64 macOS
# requires of every program it runs.

use 'util.jo'
use 'elf.jo'
use 'lower.jo'

const MACHO_BASE = 0x100000000
const MACHO_PAGE = 0x4000
const MACHO_TEXT_OFF = 0x4000

macho_page_up = (x: int) -> int: (x + MACHO_PAGE - 1) & ~(MACHO_PAGE - 1)

# (rodata's offset in the file: after the code, 16-aligned; then the functions and lines for
# backtraces, __sloppy: x64.jo's pe_backtrace_info)
macho_layout = (text_len: int, ro_len: int, info_len: int) -> (int, int, int, int):
    ro_off = (MACHO_TEXT_OFF + text_len + 15) & ~15
    info_off = (ro_off + ro_len + 15) & ~15
    text_size = macho_page_up(info_off + info_len)
    (MACHO_TEXT_OFF, ro_off, info_off, text_size)

# little-endian and big-endian puts
mp32 = (b: mut u8[], v: int):
    loop k in [0..4): b.push(u8((v >> (8 * k)) & 255))
mp64 = (b: mut u8[], v: int):
    mp32(b, v)
    mp32(b, v >> 32)
mpbe32 = (b: mut u8[], v: int):
    loop k in [0..4): b.push(u8((v >> (24 - 8 * k)) & 255))
mpbe64 = (b: mut u8[], v: int):
    mpbe32(b, v >> 32)
    mpbe32(b, v)
mpname = (b: mut u8[], s: str, n: int):
    loop i in [0..n):
        if i < len(s): b.push(s[i])
        else: b.push(0)
muleb = (b: mut u8[], v0: int):
    v = v0
    loop true:
        c = v & 127
        v = v >> 7
        if v != 0: b.push(u8(c | 128))
        else:
            b.push(u8(c))
            return

# a segment load command (with nsect sections to follow)
mseg = (b: mut u8[], name: str, vmaddr: int, vmsize: int, fileoff: int, filesize: int, prot: int, nsect: int):
    mp32(b, 0x19)                               # LC_SEGMENT_64
    mp32(b, 72 + 80 * nsect)
    mpname(b, name, 16)
    mp64(b, vmaddr)
    mp64(b, vmsize)
    mp64(b, fileoff)
    mp64(b, filesize)
    mp32(b, prot)                               # maxprot
    mp32(b, prot)                               # initprot
    mp32(b, nsect)
    mp32(b, 0)

msect = (b: mut u8[], name: str, seg: str, addr: int, size: int, off: int, align: int, flags: int):
    mpname(b, name, 16)
    mpname(b, seg, 16)
    mp64(b, addr)
    mp64(b, size)
    mp32(b, off)
    mp32(b, align)
    mp32(b, 0)
    mp32(b, 0)
    mp32(b, flags)
    mp32(b, 0)
    mp32(b, 0)
    mp32(b, 0)

# a load command with a string after a fixed part of `fixed` bytes (padded to 8)
mstrcmd = (b: mut u8[], cmd: int, fixed: int, s: str, extra: int[]):
    size = (fixed + len(s) + 1 + 7) & ~7
    mp32(b, cmd)
    mp32(b, size)
    mp32(b, fixed)
    loop x in extra: mp32(b, x)
    loop c in s: b.push(c)
    loop k in [0..size - fixed - len(s)): b.push(0)

write_macho = (path: str, text: u8[], entry_off: int, ro: u8[], info: u8[], data_size: int, name: str) -> bool:
    ident = name
    if len(ident) == 0: ident = strip_ext(path[rfind(path, "/") + 1..])
    text_off, ro_off, info_off, text_size = macho_layout(text.len(), ro.len(), info.len())
    data_addr = MACHO_BASE + text_size
    data_vm = macho_page_up(max(data_size, 16))
    link_addr = data_addr + data_vm
    # the libraries (dylib ordinals from 1) and the binds into the data segment (index 2)
    libs: str[] = ["/usr/lib/libSystem.B.dylib"]
    binds: u8[]
    loop imp in mac_imports:
        lib = imp.1
        k = index_of(libs, lib)
        if k < 0:
            libs.push(lib)
            k = libs.len() - 1
        binds.push(u8(0x10 | (k + 1)))           # BIND_OPCODE_SET_DYLIB_ORDINAL_IMM
        binds.push(u8(0x40 | 1))                 # BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM (weak import)
        binds.push(u8('_'))
        loop c in imp.2: binds.push(c)
        binds.push(0)
        binds.push(u8(0x50 | 1))                 # BIND_OPCODE_SET_TYPE_IMM (pointer)
        binds.push(u8(0x70 | 2))                 # BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB: __DATA
        muleb(binds, imp.0)
        binds.push(u8(0x90))                     # BIND_OPCODE_DO_BIND
    binds.push(0)                                # BIND_OPCODE_DONE
    loop binds.len() % 8 != 0: binds.push(0)
    # symbols: the functions (local), for debuggers and crash reports
    strtab: u8[] = [u8(' '), 0]
    symtab: u8[]
    loop sym in elf_syms:
        mp32(symtab, strtab.len())
        strtab.push(u8('_'))
        loop c in sym.0: strtab.push(c)
        strtab.push(0)
        symtab.push(0x0E)                        # N_SECT
        symtab.push(1)                           # section 1: __text
        symtab.push(0)
        symtab.push(0)
        mp64(symtab, MACHO_BASE + text_off + sym.1)
    loop strtab.len() % 8 != 0: strtab.push(0)
    nsyms = elf_syms.len()
    bind_off = text_size
    sym_off = bind_off + binds.len()
    strs_off = sym_off + symtab.len()
    sig_off = (strs_off + strtab.len() + 15) & ~15
    # the code signature's size: a SuperBlob holding one CodeDirectory with a hash per 4 KB page
    nslots = (sig_off + 4095) / 4096
    id_len = len(ident) + 1
    cd_len = 88 + id_len + 32 * nslots
    sig_len = 20 + cd_len
    sig_len = (sig_len + 15) & ~15
    link_size = sig_off + sig_len - text_size
    # ---- header and load commands ----
    cmds: u8[]
    ncmds = 0
    mseg(cmds, "__PAGEZERO", 0, MACHO_BASE, 0, 0, 0, 0)
    ncmds += 1
    mseg(cmds, "__TEXT", MACHO_BASE, text_size, 0, text_size, 5, 3)
    msect(cmds, "__text", "__TEXT", MACHO_BASE + text_off, text.len(), text_off, 4, 0x80000400)
    msect(cmds, "__const", "__TEXT", MACHO_BASE + ro_off, ro.len(), ro_off, 4, 0)
    msect(cmds, "__sloppy", "__TEXT", MACHO_BASE + info_off, info.len(), info_off, 4, 0)
    ncmds += 1
    mseg(cmds, "__DATA", data_addr, data_vm, text_size, 0, 3, 1)
    msect(cmds, "__bss", "__DATA", data_addr, data_size, 0, 4, 1)       # S_ZEROFILL
    ncmds += 1
    mseg(cmds, "__LINKEDIT", link_addr, macho_page_up(link_size), text_size, link_size, 1, 0)
    ncmds += 1
    mp32(cmds, 0x80000022)                       # LC_DYLD_INFO_ONLY
    mp32(cmds, 48)
    mp32(cmds, 0)
    mp32(cmds, 0)                                # rebase: none (the code is position independent)
    mp32(cmds, bind_off)
    mp32(cmds, binds.len())
    loop k in [0..6): mp32(cmds, 0)              # weak bind, lazy bind, export
    ncmds += 1
    mp32(cmds, 0x2)                              # LC_SYMTAB
    mp32(cmds, 24)
    mp32(cmds, sym_off)
    mp32(cmds, nsyms)
    mp32(cmds, strs_off)
    mp32(cmds, strtab.len())
    ncmds += 1
    mp32(cmds, 0xB)                              # LC_DYSYMTAB
    mp32(cmds, 80)
    mp32(cmds, 0)
    mp32(cmds, nsyms)                            # all local
    loop k in [0..16): mp32(cmds, 0)
    ncmds += 1
    mstrcmd(cmds, 0xE, 12, "/usr/lib/dyld", [])  # LC_LOAD_DYLINKER
    ncmds += 1
    # LC_UUID: from a hash of the code
    h = sha256(text, 0, text.len())
    mp32(cmds, 0x1B)
    mp32(cmds, 24)
    loop k in [0..16): cmds.push(h[k])
    ncmds += 1
    mp32(cmds, 0x32)                             # LC_BUILD_VERSION: macOS 11.0 or later
    mp32(cmds, 24)
    mp32(cmds, 1)
    mp32(cmds, 0xB0000)
    mp32(cmds, 0xE0000)
    mp32(cmds, 0)
    ncmds += 1
    mp32(cmds, 0x80000028)                       # LC_MAIN
    mp32(cmds, 24)
    mp64(cmds, text_off + entry_off)
    mp64(cmds, 0)
    ncmds += 1
    loop lib in libs:
        # (LC_LOAD_DYLIB; LC_LOAD_WEAK_DYLIB for a library not the system's, which may be missing)
        cmd = 0xC
        if not starts_with(lib, "/usr/lib/") and not starts_with(lib, "/System/"): cmd = 0x80000018
        mstrcmd(cmds, cmd, 24, lib, [2, 0x10000, 0x10000])
        ncmds += 1
    mp32(cmds, 0x1D)                             # LC_CODE_SIGNATURE
    mp32(cmds, 16)
    mp32(cmds, sig_off)
    mp32(cmds, sig_len)
    ncmds += 1
    out: u8[]
    mp32(out, 0xFEEDFACF)                        # MH_MAGIC_64
    mp32(out, 0x0100000C)                        # CPU_TYPE_ARM64
    mp32(out, 0)
    mp32(out, 2)                                 # MH_EXECUTE
    mp32(out, ncmds)
    mp32(out, cmds.len())
    mp32(out, 0x200085)                          # MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    mp32(out, 0)
    append_bytes(out, cmds)
    if out.len() > text_off: ice("Mach-O load commands do not fit before the code")
    out.resize(text_off)
    append_bytes(out, text)
    out.resize(ro_off)
    append_bytes(out, ro)
    out.resize(info_off)
    append_bytes(out, info)
    out.resize(text_size)
    append_bytes(out, binds)
    append_bytes(out, symtab)
    append_bytes(out, strtab)
    out.resize(sig_off)
    # ---- the code signature (big-endian) ----
    sig: u8[]
    mpbe32(sig, 0xFADE0CC0)                      # CSMAGIC_EMBEDDED_SIGNATURE
    mpbe32(sig, sig_len)
    mpbe32(sig, 1)
    mpbe32(sig, 0)                               # CSSLOT_CODEDIRECTORY
    mpbe32(sig, 20)
    mpbe32(sig, 0xFADE0C02)                      # CSMAGIC_CODEDIRECTORY
    mpbe32(sig, cd_len)
    mpbe32(sig, 0x20400)                         # version
    mpbe32(sig, 0x20002)                         # CS_ADHOC | CS_LINKER_SIGNED
    mpbe32(sig, 88 + id_len)                     # hashOffset
    mpbe32(sig, 88)                              # identOffset
    mpbe32(sig, 0)                               # nSpecialSlots
    mpbe32(sig, nslots)
    mpbe32(sig, sig_off)                         # codeLimit
    sig.push(32)                                 # hashSize
    sig.push(2)                                  # CS_HASHTYPE_SHA256
    sig.push(0)                                  # platform
    sig.push(12)                                 # log2(page size)
    mpbe32(sig, 0)                               # spare2
    mpbe32(sig, 0)                               # scatterOffset
    mpbe32(sig, 0)                               # teamOffset
    mpbe32(sig, 0)                               # spare3
    mpbe64(sig, 0)                               # codeLimit64
    mpbe64(sig, 0)                               # execSegBase
    mpbe64(sig, text_size)                       # execSegLimit
    mpbe64(sig, 1)                               # CS_EXECSEG_MAIN_BINARY
    loop c in ident: sig.push(c)
    sig.push(0)
    loop k in [0..nslots):
        e = min((k + 1) * 4096, sig_off)
        d = sha256(out, k * 4096, e - k * 4096)
        loop c in d: sig.push(c)
    loop sig.len() < sig_len: sig.push(0)
    append_bytes(out, sig)
    delete_file(path)
    if not write_bytes(path, out): return false
    chmod(path, 0x1ED)
    true

# ---------------- SHA-256 ----------------
SHA_K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

sha_rotr = (x: int, n: int) -> int: ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF

# the SHA-256 of b[off..off + n)
sha256 = (b: u8[], off: int, n: int) -> u8[]:
    hs = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    # the message's last block(s): its tail, 0x80, zeros, then its length in bits
    full = n / 64
    tail: u8[]
    loop i in [full * 64..n): tail.push(b[off + i])
    tail.push(0x80)
    loop tail.len() % 64 != 56: tail.push(0)
    bits = n * 8
    loop k in [0..8): tail.push(u8((bits >> (56 - 8 * k)) & 255))
    w = fill(0, 64)
    nblocks = full + tail.len() / 64
    loop bi in [0..nblocks):
        loop t in [0..16):
            p = bi * 64 + t * 4
            if bi < full:
                q = off + p
                w[t] = (int(b[q]) << 24) | (int(b[q + 1]) << 16) | (int(b[q + 2]) << 8) | int(b[q + 3])
            else:
                q = p - full * 64
                w[t] = (int(tail[q]) << 24) | (int(tail[q + 1]) << 16) | (int(tail[q + 2]) << 8) | int(tail[q + 3])
        loop t in [16..64):
            s0 = sha_rotr(w[t - 15], 7) xor sha_rotr(w[t - 15], 18) xor (w[t - 15] >> 3)
            s1 = sha_rotr(w[t - 2], 17) xor sha_rotr(w[t - 2], 19) xor (w[t - 2] >> 10)
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 0xFFFFFFFF
        a = hs[0]
        bb = hs[1]
        c = hs[2]
        d = hs[3]
        e = hs[4]
        f = hs[5]
        g = hs[6]
        h = hs[7]
        loop t in [0..64):
            S1 = sha_rotr(e, 6) xor sha_rotr(e, 11) xor sha_rotr(e, 25)
            ch = (e & f) xor ((e xor 0xFFFFFFFF) & g)
            t1 = (h + S1 + ch + SHA_K[t] + w[t]) & 0xFFFFFFFF
            S0 = sha_rotr(a, 2) xor sha_rotr(a, 13) xor sha_rotr(a, 22)
            mj = (a & bb) xor (a & c) xor (bb & c)
            t2 = (S0 + mj) & 0xFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + t1) & 0xFFFFFFFF
            d = c
            c = bb
            bb = a
            a = (t1 + t2) & 0xFFFFFFFF
        hs[0] = (hs[0] + a) & 0xFFFFFFFF
        hs[1] = (hs[1] + bb) & 0xFFFFFFFF
        hs[2] = (hs[2] + c) & 0xFFFFFFFF
        hs[3] = (hs[3] + d) & 0xFFFFFFFF
        hs[4] = (hs[4] + e) & 0xFFFFFFFF
        hs[5] = (hs[5] + f) & 0xFFFFFFFF
        hs[6] = (hs[6] + g) & 0xFFFFFFFF
        hs[7] = (hs[7] + h) & 0xFFFFFFFF
    out: u8[]
    loop x in hs:
        loop k in [0..4): out.push(u8((x >> (24 - 8 * k)) & 255))
    out
