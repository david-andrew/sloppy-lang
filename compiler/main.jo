# The Sloppy compiler.
#   sloppy file.jo [args]     compile and run
#   sloppy build file.jo [-o out] [--target wasm] [--release]
#   sloppy watch file.jo [args]     run it, and reload it while its files change (watch.jo)

build:
    opt = release

use 'util.jo'
use 'lex.jo'
use 'ast.jo'
use 'parse.jo'
use 'types.jo'
use 'check.jo'
use 'expr.jo'
use 'ir.jo'
use 'lower.jo'
use 'opt.jo'
use 'inline.jo'
use 'loops.jo'
use 'x64.jo'
use 'arm64.jo'
use 'macho.jo'
use 'dwarf.jo'
use 'elf.jo'
use 'pe.jo'
use 'pdb.jo'
use 'wasm.jo'
use 'zip.jo'
use 'ide.jo'
use 'lsp.jo'
use 'repl.jo'
use 'watch.jo'
use 'new.jo'
use 'fmt.jo'
use 'par.jo'
use 'pkg.jo'

# (a release is tagged v<SLOPPY_VERSION>: .github/workflows/release.yml checks)
const SLOPPY_VERSION = "0.28.0"
const SLOPPY_INSTALL_URL = "https://sloppy-lang.org/install"

usage = ():
    eprint("usage: sloppy   (an interactive prompt)\n       sloppy [run] [--web] [--release] file.jo [args...]   (--web: build for the browser and open it there)\n       sloppy watch file.jo [args...]   (run it, and reload it while its files change)\n       sloppy test [file.jo or directory] [words] [--release]   (only the tests whose names have one of the words; a directory, . if none is given: the tests of its .jo files)\n       sloppy check file.jo [--target ...]\n       sloppy fmt [--check] file.jo or directory...   (lay out the code one way; -: standard input)\n       sloppy add <git URL or directory> [tag, branch or commit] [as name] [file.jo]   (a package, pinned in sloppy.lock)\n       sloppy update [package] [file.jo]   (the packages' branches pinned to their newest commits)\n       sloppy new <directory> [game|arcade|platformer|3d|story|online|program]   (a project to start from)\n       sloppy lsp   (a language server for editors, on standard input and output)\n       sloppy --version\n       sloppy upgrade   (install the latest release of Sloppy, if this is not it)\n       sloppy build file.jo [-o output] [--target native|linux|linux-arm64|windows|macos|wasm] [--release] [-g: variables for debuggers] [--ir]")
    exit(2)

find_lib_dir = () -> str:
    if let e = env("SLOPPY_LIB"):
        if len(e) > 0: return os_path(e)
    exe = os_path(exe_path())
    d = exe
    s = rfind(d, "/")
    if s >= 0: d = d[..s)
    s = rfind(d, "/")
    if s >= 0: d = d[..s)
    if not file_exists("{d}/lib/core/rt.jo"):
        eprint("sloppy: cannot find the standard library next to {exe} (expected {d}/lib); set SLOPPY_LIB to its location")
        exit(2)
    "{d}/lib"

# sloppy upgrade [version]: install the latest release (or that one) over this installation, with
# the install script as new users get it; it does nothing when this is already the latest
self_update = (version: str):
    exe = os_path(exe_path())
    d = exe
    loop _ in [0..2):
        s = rfind(d, "/")
        if s >= 0: d = d[..s)
    if file_exists("{d}/compiler/main.jo"):
        eprint("sloppy: {exe} was built from the source in {d}; to upgrade it: cd {d} && git pull && tools/bootstrap.sh")
        exit(1)
    when TARGET == "windows":
        if not file_exists("{d}/lib/core/rt.jo"):
            eprint("sloppy: {exe} is not in an installation (bin\\sloppy.exe with lib\\ beside it); to install the latest release, in PowerShell: irm {SLOPPY_INSTALL_URL}.ps1 | iex")
            exit(1)
        # (the install script, with what it is to do in environment variables: iex takes no arguments)
        ps = "$env:SLOPPY_INSTALL='{d}'; $env:SLOPPY_CURRENT='{SLOPPY_VERSION}'; $env:SLOPPY_WANT='{version}'; irm {SLOPPY_INSTALL_URL}.ps1 | iex"
        exec("C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", ps])
        eprint("sloppy: could not run PowerShell")
        exit(1)
    if not file_exists("{d}/lib/core/rt.jo"):
        eprint("sloppy: {exe} is not in an installation (bin/sloppy with lib/ beside it); to install the latest release: curl -fsSL {SLOPPY_INSTALL_URL} | bash")
        exit(1)
    cmd = "s=$(curl -fsSL --connect-timeout 15 {SLOPPY_INSTALL_URL}) || \{ echo 'sloppy: could not download {SLOPPY_INSTALL_URL}' >&2; exit 1; }; printf '%s\\n' \"$s\" | SLOPPY_INSTALL='{d}' SLOPPY_CURRENT={SLOPPY_VERSION} bash -s '{version}'"
    exec("/bin/sh", ["sh", "-c", cmd])
    eprint("sloppy: could not run /bin/sh")
    exit(1)

dump = false
debug_info = false            # DWARF line tables (sloppy build)
debug_vars = false            # and where variables are, with their types (sloppy build -g)
cli_release = false
timing = false

# build options written in the program itself:
#   build:
#       target = wasm
#       output = "game"
build_target = ""
build_output = ""
cli_target = ""
made_pdb = ""           # (the PDB a Windows build wrote beside the program, for debuggers)

# the target, from the command line or else the build block: for building, checking and the
# language server alike
# the machine field of an ELF file's header (0 if unreadable): 20 bytes, not the whole file
elf_machine_of = (path: str) -> int:
    when TARGET == "windows":
        return 0
    else:
        fd = syscall(2, data(__zstr(path)), 0, 0)
        if fd < 0: return 0
        hdr = fill(u8(0), 20)
        n = syscall(17, fd, data(hdr), 20, 0)
        syscall(3, fd)
        if n < 20: return 0
        # (a Mach-O file: macOS's; its CPU type, 0x100000C for arm64)
        if hdr[0] == 0xCF and hdr[1] == 0xFA and hdr[2] == 0xED and hdr[3] == 0xFE: return int(hdr[4]) | (int(hdr[5]) << 8) | (int(hdr[6]) << 16) | (int(hdr[7]) << 24)
        return int(hdr[18]) | (int(hdr[19]) << 8)

setup_target = ():
    global ptr_size, target_arm64, target_macos, target_wasm, target_windows
    tgt = build_target
    # (one the build block names wrongly: the checker says where)
    if tgt != "linux" and tgt != "linux-arm64" and tgt != "macos" and tgt != "windows" and tgt != "wasm": tgt = ""
    if len(cli_target) > 0: tgt = cli_target
    if tgt == "" or tgt == "native":
        # (the system this compiler runs on)
        tgt = "linux"
        when TARGET == "windows":
            tgt = "windows"
        # (the compiler's own processor: its executable's ELF machine, 183 for arm64)
        when TARGET != "windows":
            m = elf_machine_of(exe_path())
            if m == 183: tgt = "linux-arm64"
            else if m == 0x100000C: tgt = "macos"
    if tgt == "web": tgt = "wasm"            # (as --web says it)
    # (linux-arm64: Linux on 64-bit ARM, TARGET "linux" and ARCH "arm64")
    if tgt == "linux-arm64":
        target_arm64 = true
        tgt = "linux"
    # (macos: macOS on Apple's arm64 processors)
    if tgt == "macos": target_macos = true
    if target_macos: target_arm64 = true
    if tgt != "linux" and tgt != "windows" and tgt != "wasm" and tgt != "macos":
        eprint("sloppy: unknown target '{tgt}' (native, linux, linux-arm64, macos, windows or wasm)")
        exit(2)
    target_wasm = tgt == "wasm"
    target_windows = tgt == "windows"
    if target_wasm: ptr_size = 4

# (a quick read of the main file's build block before anything is checked; check_build_block
# reports its mistakes)
scan_build_block = (path: str):
    global build_output, build_target, opt_release, program_name
    src = read_source(path) ?? ""
    # find a top-level `build:` line, then read its indented lines
    at = pkg_block_at(src)
    # (the packages it names: where they are, fetched if need be)
    pkg_load(path, src, at)
    if at < 0: return
    i = find_byte(src, '\n', at)
    loop i >= 0 and i < len(src):
        j = find_byte(src, '\n', i + 1)
        if j < 0: j = len(src)
        line = src[i + 1..j)
        i = j
        t = trim(line)
        if len(t) == 0 or t[0] == '#': continue
        if line[0] != ' ' and line[0] != '\t': break
        eq = find(t, "=")
        if eq < 0: continue
        key = trim(t[..eq))
        val = trim(t[eq + 1..])
        h = find(val, "#")
        if h >= 0: val = trim(val[..h))
        if len(val) >= 2 and val[0] == '"': val = val[1..len(val) - 1)
        if key == "target": build_target = val
        else if key == "output": build_output = val
        else if key == "name": program_name = val
        else if key == "opt": opt_release = val == "release"

lower_only = false      # (the language server: what lowering finds wrong, without code)
# the interactive prompt (repl.jo): the program's main is the session's server, and there is
# room after its globals for those later inputs declare
repl_image = false
bss_reserve = 0
img_text_addr = 0
img_ro_addr = 0
img_data_addr = 0

# (functions lowered, waiting for their machine code: emit_queued, after all are lowered, so
# that the code can be made on several processors)
emit_queue: IrFn[]
emit_queue_rel: bool[]          # (a release function still to version and LICM: rel_finish)
queue_emit = false

emit_function = ():
    if lower_only: return
    if queue_emit:
        emit_queue.push(ir)
        emit_queue_rel.push(false)
        return
    emit_now(false)

# a release build's last passes over a function, before its code is made
rel_finish = ():
    kc_fn += 1
    loop_versioning()
    ir.code = o_ret_sink(ir.code)
    ir.code = o_selects(ir.code)
    ir.code = o_licm(ir.code)

emit_now = (finish: bool):
    if finish: rel_finish()
    if dump: dump_ir()
    if target_wasm: wasm_collect()
    else if target_arm64: arm64_function()
    else: x64_function()

# release builds: optimize everything, inline small functions, optimize callers again, emit
release_pipeline = ():
    global ir, rel_fns
    rt0 = time()
    loop k in [0..rel_fns.len()):
        ir = rel_fns[k]
        kc_fn += 1
        optimize()
        rel_fns[k] = ir
    rt1 = time()
    snap = rel_fns
    can = fill(0, snap.len())
    loop k in 0.. and f in snap: can[k] = inlinable(f)
    # callees before callers: a function is inlined with what it inlined itself (so whether it
    # is small enough is judged by what it finally is)
    loop k in callee_order(snap):
        ir = snap[k]
        kc_fn += 1
        if inline_into(k, snap, can):
            optimize()
            snap[k] = ir
            can[k] = inlinable(ir)
    rt2 = time()
    loop k in [0..snap.len()):
        ir = snap[k]
        if queue_emit:
            # (versioned and LICM'd with its code: where code is made in parallel, there too)
            emit_queue.push(ir)
            emit_queue_rel.push(true)
            continue
        rel_finish()
        emit_function()
    rel_fns = []
    if env("SLOPPY_PAR_TIME") != none: eprint("release: optimize {(rt1 - rt0) * 1000.0:.1} ms, inline {(rt2 - rt1) * 1000.0:.1} ms, versioning and licm {(time() - rt2) * 1000.0:.1} ms")

# the machine code of the queued functions, in order
emit_queued = ():
    global emit_queue, emit_queue_rel, ir, queue_emit
    q = emit_queue
    fin = emit_queue_rel
    emit_queue = []
    emit_queue_rel = []
    queue_emit = false
    if emit_parallel(q, fin): return
    t0 = time()
    loop k in 0.. and f in q:
        ir = f
        emit_now(fin[k])
    if env("SLOPPY_PAR_TIME") != none: eprint("emit: here, {(time() - t0) * 1000.0:.1} ms")

# the functions in an order where each comes after the ones it calls (but in cycles)
callee_order = (fs: IrFn[]) -> int[]:
    n = fs.len()
    state = fill(0, n)              # 0 not seen, 1 on the path, 2 placed
    order: int[]
    stack: int[]
    next_ins: int[]                 # per stack entry: where to continue scanning its code
    loop r in [0..n):
        if state[r] != 0: continue
        stack.push(r)
        next_ins.push(0)
        state[r] = 1
        loop stack.len() > 0:
            top = stack.len() - 1
            k = stack[top]
            fc = fs[k].code
            i = next_ins[top]
            child = -1
            loop i < fc.len() and child < 0:
                ins = fc[i]
                i += 1
                if ins.op == .call and ins.c != 1 and ins.imm < rel_by_index.len():
                    j = rel_by_index[int(ins.imm)]
                    if j >= 0 and state[j] == 0: child = j
            next_ins[top] = i
            if child >= 0:
                state[child] = 1
                stack.push(child)
                next_ins.push(0)
            else:
                state[k] = 2
                order.push(k)
                stack.pop()
                next_ins.pop()
    order

compile = (path: str, out0: str) -> str:
    global __file_err, __file_errno, dbg_on, dw_data_addr, elf_extra, elf_machine, elf_page, elf_syms, entry_end_lf, entry_stack_lf, img_data_addr, img_ro_addr, img_text_addr, late_binding, lx_vec_on, macho_dwarf, made_pdb, main_code, main_end_lf, main_exit_lf, mulh_ok, opt_release, pe_stack_reserve, queue_emit, ra_dump, ra_only, ra_prio, ra_stat, ra_verbose, want_cpu_flag, want_loop_watch
    if watch_build and not watch_first: late_binding = true
    t0 = time()
    ra_stat = env("SLOPPY_RASTAT") != none
    ra_verbose = (env("SLOPPY_RASTAT") ?? "") == "v"
    if env("SLOPPY_RA_LINEAR") != none: ra_prio = false
    ra_dump = env("SLOPPY_RADUMP") ?? ""
    ra_only = env("SLOPPY_RA_ONLY") ?? ""
    scan_build_block(path)
    if cli_release: opt_release = true
    if lower_only: opt_release = false
    setup_target()
    # (debug information for variables: x86-64 and arm64 Linux, macOS, Windows)
    dbg_on = debug_vars and debug_info and not watch_build and not lower_only and not target_wasm
    out = out0
    fail_path = ""              # (what could not be written, when it is not out)
    if target_wasm and not ends_with(out, ".html") and not ends_with(out, ".zip"): out = out + ".html"
    # (-o game.zip, a Windows program: game.exe in a zip, made in a directory of its own first)
    zip_out = ""
    if ends_with(lower(out), ".zip") and not target_wasm and not lower_only:
        if not target_windows:
            tn = "Linux"
            if target_macos: tn = "macOS"
            eprint("error: -o {out}: a zip is made of a web page (--target wasm) or of a Windows program (--target windows); a {tn} program is written as it is (-o {out[..len(out) - 4)})")
            exit(2)
        zip_out = out
        zn = out[..len(out) - 4)
        zs = max(rfind(zn, "/"), rfind(zn, "\\"))
        if zs >= 0: zn = zn[zs + 1..]
        zdir = "{os_path(temp_dir())}/sloppy-zip-{time_ns()}"
        out = "{zdir}/{zn}.exe"
    if target_windows:
        if ends_with(out, ".bin"): out = out[..len(out) - 4)
        if not ends_with(lower(out), ".exe"): out = out + ".exe"
    init_types()
    want_cpu_flag = opt_release and not target_wasm and not target_arm64 and not lower_only
    want_loop_watch = target_wasm and not opt_release and not lower_only
    mulh_ok = not target_wasm
    # (code made after lowering everything, except where code is patched in place as it is made)
    queue_emit = not watch_build and not repl_image and not lower_only
    check_program(path)
    # (a run for the errors after the first: no more to find, and nothing is built)
    if errors_only: exit(1)
    if target_wasm and not program_named: web_save_name_check()
    # (functions left unchecked after errors in them cannot be lowered)
    if lower_only and ide_skip.len() > 0: return ""
    if repl_image: repl_set_main()
    t1 = time()
    roots: int[]
    loop f in init_fns: roots.push(lf_of_inst(f))
    # exports from user code are always kept; library exports only when their module is used
    exp_done = fill(false, export_fns.len())
    used_mods: {int: bool} = {}
    loop k in 0.. and f in export_fns:
        if not modules[int(fns[f].mod)].is_prelude:
            lf_of_inst(f)
            exp_done[k] = true
    main_lf = -1
    if main_fn != 0: main_lf = lf_of_inst(main_fn)
    # (main = () -> int: its value is the exit code)
    main_code = main_fn != 0 and is_int(prune(int(fns[main_fn].ret)))
    main_exit_lf = -1
    if main_code and target_wasm: main_exit_lf = lf_of_inst(runtime_fn("exit"))
    # (a web page with tasks: main's end waits for them, as a native program's __end_flush does)
    main_end_lf = -1
    if target_wasm and not lower_only and prelude.get(intern("__task_main_end")) != none: main_end_lf = lf_of_inst(runtime_fn("__task_main_end"))
    # (after main: what print has collected, written out)
    entry_end_lf = -1
    if not target_wasm and not lower_only and not repl_image: entry_end_lf = lf_of_inst(runtime_fn("__end_flush"))
    # (first: the main thread's own big stack, where there is one)
    entry_stack_lf = -1
    if not target_wasm and not target_windows and not lower_only and not repl_image: entry_stack_lf = lf_of_inst(runtime_fn("__main_stack"))
    if repl_image: pe_stack_reserve = 0x800000
    pinit = init_fns[0]
    pinit_lf = roots[0]
    # (vectorized loops ask whether the processor has AVX2: the runtime finds out at start)
    lx_vec_on = opt_release and not target_wasm and not target_arm64 and not lower_only
    if lx_vec_on:
        cs = prelude.get(intern("__cpu_avx2")) ?? 0
        if cs != 0 and syms[cs].kind == .global: global_addr_off(int(syms[cs].ref))
        else: lx_vec_on = false
    i = 0
    loop true:
        loop i < lfuncs.len():
            if i == pinit_lf:
                i += 1
                continue
            if lfuncs[i].kind == LK_INST:
                fd = int(fns[lfuncs[i].inst].decl)
                if fd != 0 and nodes[fd].mod != 0 or fd != 0:
                    fm = int(nodes[fd].mod)
                    if used_mods.get(fm) == none:
                        used_mods[fm] = true
                        loop k in 0.. and f in export_fns:
                            if not exp_done[k] and nodes[int(fns[f].decl)].mod == i32(fm):
                                exp_done[k] = true
                                lf_of_inst(f)
            if lfuncs[i].kind == LK_INST and fns[lfuncs[i].inst].decl != 0 and has_flag(int(fns[lfuncs[i].inst].decl), NF_EXTERN):
                fi = lfuncs[i].inst
                if target_wasm or lower_only:
                    i += 1
                    continue
                if len(fns[fi].clib) == 0: fatal(nodes[int(fns[fi].decl)].pos, "extern functions need @lib(\"library.so\") on native targets")
                extern_lib_check(fi)
                lower_extern_thunk(i, fi)
                emit_function()
                i += 1
                continue
            lower_function(i)
            if opt_release: rel_collect()
            else: emit_function()
            i += 1

        # library globals: initialize only the ones compiled code refers to (fixed point)
        nglob = global_off.len()
        decls: int[]
        loop g in global_ids:
            if not modules[int(globals[g].mod)].is_prelude or global_off.get(g) == none: continue
            d = int(globals[g].decl)
            if not decls.contains(d): decls.push(d)
        set_list(int(fns[pinit].body), decls)
        nl = lfuncs.len()
        lower_function(pinit_lf)
        if lfuncs.len() > nl or global_off.len() > nglob: continue
        if opt_release: rel_collect()
        else: emit_function()
        break
    if lower_only: return ""
    if watch_build and not watch_first:
        watch_lower_inits()
        watch_lower_migrate()
    if opt_release: release_pipeline()
    if queue_emit: emit_queued()
    t2 = time()
    ok = false
    size = 0
    # (why writing failed, if it does: not an earlier file's)
    __file_err = ""
    __file_errno = 0
    if target_wasm:
        mod = wasm_module(roots, main_lf, -1)
        size = mod.len()
        ok = write_html(out, mod, program_name, program_icon)
    else if target_windows:
        x64_stubs()
        entry = x64_entry_win(roots, main_lf)
        text_rva, ro_rva, data_rva, idata_size = pe_layout(code.len(), rodata.len())
        img_text_addr = PE_BASE + text_rva
        img_ro_addr = PE_BASE + ro_rva
        img_data_addr = PE_BASE + data_rva + idata_size
        x64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            # (debuggers get a PDB beside what `sloppy build` writes)
            # (not for a zip to share: a debugger reads it beside the program it built)
            pdb = ""
            guid: u8[]
            if debug_info and not watch_build and len(zip_out) == 0:
                pdb = strip_ext(out) + ".pdb"
                guid = pdb_guid(code)
            if len(zip_out) > 0: make_dirs(out[..max(rfind(out, "/"), rfind(out, "\\"))))
            ok = write_pe(out, code, entry, rodata, data_size + 8 + bss_reserve, (update_fn != 0 or draw_fn != 0) and not test_mode, pe_backtrace_info(), program_icon, pdb_name(pdb), guid)
            if ok and len(pdb) > 0:
                ok = write_pdb(pdb, guid, code.len(), pe_section_headers, path, "sloppy {SLOPPY_VERSION}")
                if ok: made_pdb = pdb
                else: fail_path = pdb
            if ok and watch_build: watch_record_image()
            if len(zip_out) > 0:
                exe = read_bytes(out) ?? []
                zname = out[max(rfind(out, "/"), rfind(out, "\\")) + 1..]
                delete_file(out)
                delete_dir(out[..max(rfind(out, "/"), rfind(out, "\\"))))
                if ok:
                    fail_path = zip_out
                    ok = exe.len() > 0 and write_zip(zip_out, [(zname, exe)])
                out = zip_out
        size = code.len()
    else if target_macos:
        arm64_stubs()
        entry = arm64_entry_mac(roots, main_lf)
        info = pe_backtrace_info()
        if watch_build and (update_fn != 0 or draw_present()):
            # (sloppy watch, a game: the code and read-only data run from a region of their own,
            # copied there by a loader, macho.jo; after the first build, a patch for the game)
            ro_at = (code.len() + 15) & ~15
            blob_len = (ro_at + rodata.len() + 7) & ~7
            loader_len = macho_watch_loader(0, 0, 0, 0).len()
            text_off, ro_off, info_off, text_size = macho_layout(loader_len, blob_len, info.len())
            img_text_addr = MACHO_WATCH_CODE
            img_ro_addr = MACHO_WATCH_CODE + ro_at
            img_data_addr = MACHO_BASE + text_size
            arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
            if not watch_first: ok = watch_make_patch()
            else:
                blob = code
                loop blob.len() < ro_at: blob.push(0)
                loop b in rodata: blob.push(b)
                loop blob.len() < blob_len: blob.push(0)
                loader = macho_watch_loader(img_data_addr, MACHO_BASE + ro_off, blob_len, entry)
                elf_syms = []
                ok = write_macho(out, loader, 0, blob, info, data_size + 8 + bss_reserve, program_name, true)
                if ok: watch_record_image()
        else:
            text_off, ro_off, info_off, text_size = macho_layout(code.len(), rodata.len(), info.len())
            img_text_addr = MACHO_BASE + text_off
            img_ro_addr = MACHO_BASE + ro_off
            img_data_addr = MACHO_BASE + text_size
            arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
            macho_dwarf = []
            # (with -g only: the same compiler, built on Linux and on a Mac, is the same bytes, with
            # no paths of either in it)
            dw_data_addr = img_data_addr
            if debug_vars and not watch_build: macho_dwarf = dwarf_sections(img_text_addr, code.len(), path, SLOPPY_VERSION)
            mac_out = out
            if ends_with(out, ".app") and not watch_build:
                mac_out = macos_bundle(out, program_name, program_icon)
                if len(mac_out) == 0: fatal(0, "cannot make the app bundle {out}")
            ok = write_macho(mac_out, code, entry, rodata, info, data_size + 8 + bss_reserve, program_name, false)
            if ok and watch_build: watch_record_image()
        size = code.len()
    else if target_arm64:
        elf_machine = 183
        elf_page = 0x10000
        arm64_stubs()
        entry = arm64_entry(roots, main_lf)
        text_off, ro_off, data_off = elf_layout(code.len(), rodata.len())
        img_text_addr = ELF_BASE + text_off
        img_ro_addr = ELF_BASE + ro_off
        img_data_addr = ELF_BASE + data_off
        arm64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            elf_extra = [(".sloppy_lines", x64_line_table())]
            # (with -g only, as on macOS)
            dw_data_addr = img_data_addr
            if debug_vars: elf_extra = elf_extra + dwarf_sections(img_text_addr, code.len(), path, SLOPPY_VERSION)
            ok = write_elf(out, code, entry, rodata, data_size + 8 + bss_reserve)
            if ok and watch_build: watch_record_image()
        size = code.len()
    else:
        x64_stubs()
        entry = x64_entry(roots, main_lf)
        text_off, ro_off, data_off = elf_layout(code.len(), rodata.len())
        img_text_addr = ELF_BASE + text_off
        img_ro_addr = ELF_BASE + ro_off
        img_data_addr = ELF_BASE + data_off
        x64_resolve(img_text_addr, img_ro_addr, img_data_addr)
        # (sloppy watch: after the first build, a patch for the program running)
        if watch_build and not watch_first: ok = watch_make_patch()
        else:
            # (backtraces always; debuggers and profilers get DWARF in what `sloppy build` writes)
            elf_extra = [(".sloppy_lines", x64_line_table())]
            dw_data_addr = img_data_addr
            if debug_info: elf_extra = elf_extra + dwarf_sections(img_text_addr, code.len(), path, SLOPPY_VERSION)
            ok = write_elf(out, code, entry, rodata, data_size + 8 + bss_reserve)
            if ok and watch_build: watch_record_image()
        size = code.len()
    t3 = time()
    if ra_stat: eprint("regalloc: spill cost {ra_spill_cost}, save cost {ra_save_cost} (int) {ra_save_x} (float), of {ra_total} weighted accesses\n")
    if timing:
        eprint("check {(t1 - t0) * 1000.0:.1} ms, lower+codegen {(t2 - t1) * 1000.0:.1} ms, write {(t3 - t2) * 1000.0:.1} ms; {lfuncs.len()} functions, {nodes.len()} nodes, {size} bytes of code")
    if not ok:
        # (a patch for sloppy watch tells its own trouble)
        if not watch_build or watch_first:
            fp = out
            if len(fail_path) > 0: fp = fail_path
            # (a program that is running cannot be written over: Windows says it is in use, or
            # that access is denied; Linux that it is running)
            e = __file_errno
            when TARGET == "windows":
                if e == 13 and file_exists(fp) and not is_dir(fp): e = 16
            if e == 16 or e == 26: eprint("error: {fp} is in use: is the program still running? (close it, then build again)")
            else if len(file_error()) > 0 and e != 13: eprint("error: cannot write {fp}: {file_error()}")
            else: eprint("error: cannot write {fp} (a directory there, or no permission?)")
        return ""
    out

open_in_browser = (path: str) -> bool:
    when TARGET == "windows":
        return spawn_detached("C:\\Windows\\System32\\cmd.exe", ["cmd", "/c", "start", "", path])
    else:
        return spawn_detached("/usr/bin/xdg-open", ["xdg-open", path])

# an option of the compiler's at a[i] (--release, --web, --time, --target t), taken: how many
# words it is (0: none of them)
cli_option = (a: str[], i: int) -> int:
    global cli_release, cli_target, timing
    x = a[i]
    if x == "--web": cli_target = "wasm"
    else if x == "--release": cli_release = true
    else if x == "--time": timing = true
    else if x == "--target" and i + 1 < a.len():
        cli_target = a[i + 1]
        return 2
    else: return 0
    1

# the options from a[i] on: where they end (another word starting with -- is not one: usage)
cli_options = (a: str[], i0: int) -> int:
    i = i0
    loop i < a.len() and starts_with(a[i], "--"):
        k = cli_option(a, i)
        if k == 0: usage()
        i += k
    i

main = ():
    global __copies_min, check_all, cli_release, cli_target, debug_info, debug_vars, dump, errors_only, lib_dir, lib_root, lower_only, more_errors, pkg_fetch, stop_after, test_mode, timing
    __copies_min = 0       # (SLOPPY_COPIES is for the program it runs, not the compiler's own copies)
    a = args()
    if a.len() >= 2 and (a[1] == "--version" or a[1] == "version"):
        print("sloppy {SLOPPY_VERSION}")
        return
    if a.len() >= 2 and (a[1] == "--help" or a[1] == "help" or a[1] == "-h"): usage()
    # (sloppy build --help: the commands' options, not a file named --help; a program's own
    # arguments, as in `sloppy game.jo --help`, stay its)
    if a.len() >= 3 and (a[1] == "build" or a[1] == "check" or a[1] == "test" or a[1] == "fmt" or a[1] == "new" or a[1] == "watch"):
        hi = 2
        loop hi < a.len():
            if a[hi] == "--help" or a[hi] == "-h": usage()
            hi += 1
    if a.len() >= 2 and a[1] == "upgrade":
        version = ""
        if a.len() >= 3: version = a[2]
        self_update(version)
    # (the next errors after one in a function: next_error_run, ide.jo)
    if a.len() > 3 and a[1] == "--skip-fns":
        loop s in split(a[2], ","):
            c = find(s, ":")
            # (w and a warning's place and length: shown by the run before)
            if len(s) > 0 and s[0] == 'w': shown_warnings.push(s)
            else if c > 0:
                err_skips.push(s)
                ide_skip[mkpos(to_int(s[..c)) ?? 0, to_int(s[c + 1..]) ?? 0)] = true
        errors_only = true
        rest = [a[0]]
        loop i in [3..a.len()): rest.push(a[i])
        a = rest
    if a.len() >= 2 and (a[1] == "build" or a[1] == "check" or a[1] == "test" or a[1] == "run" or ends_with(a[1], ".jo")): more_errors = true
    lib_dir = find_lib_dir()
    lib_root = lib_dir
    # (sloppy watch on Windows: each build in a process of its own: watch.jo, w32_compile)
    when TARGET == "windows":
        if a.len() >= 8 and a[1] == "watch" and a[2] == "--build":
            watch_build_child(a[3], a[4], a[5], a[6] == "1", a[7])
            return
    # no file: the interactive prompt
    if a.len() < 2 or a[1] == "repl":
        repl_main()
        return
    if a[1] == "build":
        if a.len() < 3: usage()
        debug_info = true
        path = ""
        out = ""
        i = 2
        loop i < a.len():
            x = a[i]
            if x == "-o" and i + 1 < a.len():
                out = a[i + 1]
                i += 1
            else if x == "--target" and i + 1 < a.len():
                cli_target = a[i + 1]
                i += 1
            else if x == "--ir": dump = true
            else if x == "-g": debug_vars = true
            else if x == "--release": cli_release = true
            else if x == "--time": timing = true
            else: path = os_path(x)
            i += 1
        if len(path) == 0: usage()
        scan_build_block(path)
        if len(out) == 0 and len(build_output) > 0:
            # (the build block's output: beside the program, unless it is a full path)
            out = os_path(build_output)
            s = rfind(path, "/")
            if not is_abs_path(out) and s >= 0: out = path[..s + 1) + out
        if len(out) == 0:
            out = path
            out = strip_ext(out)
            if out == path: out = path + ".bin"     # (no extension: not over the source)
        # (-o game.zip, -o game.html, -o game.exe: what is asked for, without --target too)
        # (-o game.zip on Windows: the program in a zip, unless the build block names a target;
        # elsewhere the web page in one, for itch.io)
        lo = lower(out)
        if len(cli_target) == 0:
            if ends_with(lo, ".html"): cli_target = "wasm"
            else if ends_with(lo, ".exe"): cli_target = "windows"
            else if ends_with(lo, ".zip") and len(build_target) == 0:
                cli_target = "wasm"
                when TARGET == "windows":
                    cli_target = "windows"
        # (-o dist/game.zip: the directory made if it is not there)
        sl = max(rfind(out, "/"), rfind(out, "\\"))
        if sl > 0: make_dirs(out[..sl))
        made = compile(path, out)
        if len(made) == 0: exit(1)
        # (where it is, said at a terminal: a script that builds gets no line it did not ask for)
        if is_terminal():
            if len(made_pdb) > 0: print("made {made} (and {made_pdb}, which only debuggers use)")
            else: print("made {made}")
        return
    if a[1] == "lsp":
        lsp_main()
        return
    if a[1] == "new":
        new_project(lib_dir, a)
        return
    if a[1] == "fmt":
        fmt_main(a)
        return
    if a[1] == "add":
        pkg_add_main(a)
        return
    if a[1] == "update":
        pkg_update_main(a)
        return
    # (building and running fetch the packages a program names; the language server does not)
    pkg_fetch = true
    if a[1] == "check":
        # type check only
        if a.len() < 3: usage()
        if let s = env("SLOPPY_STOP"): stop_after = s
        # (options before or after the file)
        path = ""
        i = 2
        loop i < a.len():
            k = cli_option(a, i)
            if k == 0:
                if len(path) > 0: usage()
                path = os_path(a[i])
                k = 1
            i += k
        if len(path) == 0: usage()
        # (the test blocks are checked too, as sloppy test would)
        test_mode = true
        check_all = true
        if len(stop_after) > 0:
            scan_build_block(path)
            setup_target()
            init_types()
            check_program(path)
            if errors_only: exit(1)
            return
        # (and lowered without making code: some errors are found there, as a `loop mut` that
        # resizes its array, a data race, a shader's)
        lower_only = true
        compile(path, "")
        if errors_only: exit(1)
        return
    first = 1
    if a[1] == "run": first = 2          # (sloppy run game.jo is sloppy game.jo)
    # options for running come before the file (what follows it goes to the program)
    first = cli_options(a, first)
    if first < a.len() and a[first] == "run" and first > 1: first = cli_options(a, first + 1)     # (sloppy --release run f.jo)
    if first >= a.len(): usage()
    if a[first] == "watch":
        # (sloppy watch --release game.jo, as sloppy --release watch game.jo)
        first = cli_options(a, first + 1) - 1
        if a.len() < first + 2: usage()
        if cli_target == "wasm": fatal(0, "sloppy watch runs programs natively (for the web, use sloppy build --target wasm)")
        cli_target = "native"
        wargs: str[]
        wfrom = first + 2
        if wfrom < a.len() and a[wfrom] == "--": wfrom += 1
        loop i in [wfrom..a.len()): wargs.push(a[i])
        watch_main(os_path(a[first + 1]), wargs)
        return
    test_words: str[]
    if a[first] == "test":
        # (options before or after the file: sloppy test --release f.jo, sloppy test f.jo --release;
        # the other words after it pick tests by name)
        first = cli_options(a, first + 1)
        # (a directory, . when none is named: the tests of each .jo file in it)
        if first >= a.len() or is_dir(os_path(a[first])): test_dir(a, first)
        i = first + 1
        loop i < a.len():
            k = cli_option(a, i)
            if k == 0:
                test_words.push(a[i])
                k = 1
            i += k
        test_mode = true
        cli_target = "native"         # tests run natively even for web games
    path = os_path(a[first])
    if not file_exists(path) and not ends_with(path, ".jo") and find(path, "/") < 0:
        near = ""
        loop c in ["run", "build", "watch", "test", "check", "fmt", "add", "update", "upgrade", "new", "lsp", "help", "version", "repl"]:
            lim = 2
            if len(c) <= 3: lim = 1
            if edit_distance(a[first], c, lim) <= lim and len(near) == 0: near = " (did you mean 'sloppy {c}'?)"
        if len(near) == 0: near = " (sloppy help lists them; a program runs with sloppy game.jo)"
        if file_exists(path + ".jo"): near = " (did you mean 'sloppy {a[first]}.jo'?)"
        eprint("sloppy: unknown command '{a[first]}'{near}")
        exit(1)
    cache = os_path(temp_dir()) + "/sloppy-cache"
    mkdir(cache)
    base = path
    s = rfind(base, "/")
    if s >= 0: base = base[s + 1..]
    base = strip_ext(base)
    if test_mode: base = base + ".test"
    # (one program per path: two main.jo in two directories, run at once, are two programs)
    full = path
    if len(full) == 0 or (full[0] != '/' and find(full, ":") < 0): full = os_path(cwd()) + "/" + path
    base = "{base}-{path_hash(full)}"
    if (time_ns() / 1000) % 64 == 0: clean_cache(cache)
    out = "{cache}/{base}.bin"
    # (made beside it, then put in its place, with the extension the target gave it: .exe, .html;
    # a copy of the program still running is not written over. Windows cannot replace a program
    # that is running: then the new one runs from where it was made, and clean_cache removes it)
    tmp = out
    if cli_target != "wasm" and cli_target != "web": tmp = "{cache}/{base}.{time_ns()}.new"
    built = compile(path, tmp)
    if len(built) == 0: exit(1)
    if tmp != out and starts_with(built, tmp):
        ext = built[len(tmp)..]
        if len(ext) == 0: ext = ".bin"
        if rename_file(built, "{cache}/{base}{ext}"): built = "{cache}/{base}{ext}"
    if target_wasm:
        # open the page in the default browser, detached (the browser's output does not
        # reach this terminal, and sloppy returns at once)
        if open_in_browser(built): eprint("sloppy: opened {built} in the browser")
        else: eprint("sloppy: built {built}; open it in a browser")
        exit(0)
    # (args()[0] is the program as it was named: the source file)
    run_args = [path]
    if test_mode: run_args = run_args + test_words
    else:
        # (sloppy tool.jo -- add x: the `--` ends sloppy's options, and is not the program's)
        from = first + 1
        sep = from < a.len() and a[from] == "--"
        if sep: from += 1
        loop i in [from..a.len()): run_args.push(a[i])
        # (sloppy bench.jo --release: the program's argument, so a debug build ran)
        if not sep and run_args.contains("--release") and not cli_release: eprint("sloppy: --release after the file is the program's argument, and this is a debug build: `sloppy --release {path}` builds for speed (`sloppy {path} -- --release` gives it to the program, quietly)")
    exec(built, run_args)
    eprint("sloppy: failed to run {built}")
    exit(1)

# sloppy test <directory> [words]: each .jo file under it with tests (its test blocks: a module's
# are its own, run as it is tested) tested as sloppy test file.jo would, one after the other, and
# the counts of all of them (a[first]: the directory, if one is named)
test_dir = (a: str[], first: int):
    dir = "."
    if first < a.len(): dir = os_path(a[first])
    loop len(dir) > 1 and ends_with(dir, "/"): dir = dir[..len(dir) - 1)
    opts: str[]
    loop k in [1..min(first, a.len())):
        if a[k] != "test" and a[k] != "run": opts.push(a[k])
    rest: str[]
    words: str[]
    loop k in [first + 1..a.len()):
        rest.push(a[k])
        if not starts_with(a[k], "--") and a[k - 1] != "--target": words.push(a[k])
    passed = 0
    failed = 0
    files_run = 0
    bad: str[]
    loop f in walk_dir(dir):
        # (not in hidden directories, as .git)
        if not ends_with(f, ".jo") or starts_with(f, ".") or find(f, "/.") >= 0: continue
        path = f
        if dir != ".": path = "{dir}/{f}"
        src = read_file(path) ?? ""
        tests = test_names(src)
        if tests.len() == 0: continue
        if words.len() > 0:
            any = false
            loop t in tests:
                loop w in words:
                    if find(t, w) >= 0: any = true
            if not any: continue
        files_run += 1
        print("{path}:")
        rc, out = run_program(exe_path(), ["test"] + opts + [path] + rest)
        write(out)
        # (its last line: "3 tests passed", "2 passed, 1 failed")
        last = ""
        loop line in split(trim(out), "\n"): last = trim(line)
        np = to_int(last[..max(find(last, " "), 0))) ?? -1
        if rc == 0 and np >= 0 and find(last, " passed") >= 0: passed += np
        else if np >= 0 and find(last, " failed") >= 0:
            passed += np
            comma = find(last, ",")
            fw = find(last, " failed")
            failed += to_int(trim(last[comma + 1..fw))) ?? 1
            bad.push(path)
        else:
            # (it did not build, or stopped before its tests ended)
            failed += 1
            bad.push(path)
    if files_run == 0:
        if words.len() > 0: eprint("no test's name in the .jo files under {dir} has {join(words, ", ")} in it")
        else: eprint("no tests in the .jo files under {dir}: a test is written `test \"adds\":` with its lines below it, as `assert(add(1, 2) == 3)`")
        exit(1)
    in_files = "in {files_run} files"
    if files_run == 1: in_files = "in 1 file"
    if failed > 0:
        print("{passed} passed, {failed} failed {in_files} (failed: {join(bad, ", ")})")
        exit(1)
    tests_word = "tests"
    if passed == 1: tests_word = "test"
    print("{passed} {tests_word} passed {in_files}")
    exit(0)

# the names of the test blocks in a file's text
test_names = (src: str) -> str[]:
    out: str[]
    at = 0
    loop true:
        k = find(src, "test \"", at)
        if k < 0: break
        at = k + 6
        if k > 0 and src[k - 1] != '\n': continue
        e = find(src, "\"", at)
        if e < 0: break
        out.push(src[at..e))
    out

# (@lib("libc.so.6") in a Windows build: the program fails when it calls the function)
extern_lib_check = (fi: int):
    d = int(fns[fi].decl)
    if pos_in_lib(nodes[d].pos): return
    cl = fns[fi].clib
    lc = lower(cl)
    other = ""
    if target_windows and (find(lc, ".so") >= 0 or ends_with(lc, ".dylib")): other = "a Windows program loads DLLs (msvcrt.dll has the C library)"
    else if not target_windows and ends_with(lc, ".dll"): other = "a Linux or macOS program loads .so or .dylib libraries"
    else if target_macos and find(lc, ".so") >= 0: other = "a macOS program loads .dylib libraries (/usr/lib/libSystem.B.dylib has the C library)"
    else if not target_macos and not target_windows and ends_with(lc, ".dylib"): other = "a Linux program loads .so libraries (libc.so.6 has the C library)"
    if len(other) > 0: warn(nodes[d].pos, "@lib(\"{cl}\") is another system's library: {other}; `when TARGET == \"windows\":` gives each system its own @lib (as it is, the program stops when it calls {name_of(int(nodes[d].name))})")

# (an FNV-1a hash of a path, as 8 hex digits)
path_hash = (p: str) -> str:
    h = 2166136261
    loop c in p: h = ((h xor int(c)) * 16777619) & 0xFFFFFFFF
    d = "0123456789abcdef"
    out = ""
    loop k in [0..8): out = out + byte_str(int(d[(h >> (k * 4)) & 15]))
    out

# programs left in the run cache: those not run for a week go (and half-made ones of crashed
# builds); past 500 MB, the oldest go until it is half that
clean_cache = (cache: str):
    # (now, as the file system tells time: a file just written)
    write_file(cache + "/.now", "")
    now = file_time(cache + "/.now") ?? 0.0
    if now == 0.0: return
    kept: (f64, str, int)[]
    total = 0
    loop f in list_dir(cache):
        p = cache + "/" + f
        if let t = file_time(p):
            half_made = ends_with(f, ".new") or ends_with(f, ".new.exe") or ends_with(f, ".new.html")
            if now - t > 7.0 * 86400.0 or (half_made and now - t > 3600.0): delete_file(p)
            else if f != ".now":
                n = file_size(p) ?? 0
                kept.push((t, p, n))
                total += n
    if total <= 500 << 20: return
    kept.sort_by((k): k.0)
    loop k in kept:
        if total <= 250 << 20: break
        if delete_file(k.1): total -= k.2

# (a web page that saves, with no name in its build block: pages on one site, as itch.io's,
# share their browser's storage, and every game.jo would read and write the others' saves)
web_save_name_check = ():
    loop fi in [1..fns.len()):
        d = int(fns[fi].decl)
        if fns[fi].state != 2 or d == 0 or not pos_in_lib(nodes[d].pos): continue
        nm = name_of(int(nodes[d].name))
        if nm == "save_data" or nm == "save_value":
            at = -1
            loop m in modules:
                if m.is_main: at = mkpos(int(m.file), 0)
            warn(at, "this web page saves under the name '{program_name}' (its file's): pages on one site, as itch.io's, share their storage, so give it a name of its own: `build:` and `name = \"Drone Arena\"` below it")
            return
