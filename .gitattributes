# GitHub has no grammar for Sloppy yet: show .jo files with GDScript's (Godot's language, the
# closest it has), and leave them out of the repository's language statistics
*.jo linguist-language=GDScript linguist-detectable=false

# Sources and expected outputs keep \n line endings everywhere (tests compare output exactly)
*.jo text eol=lf
*.out text eol=lf
*.in text eol=lf
*.sh text eol=lf
# (read_input.in has a line ending in \r\n on purpose)
tests/t/read_input.in -text
