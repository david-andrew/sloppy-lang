# (temporary: what GPU a GitHub macOS runner has)
@lib("/System/Library/Frameworks/Metal.framework/Metal")
extern MTLCreateSystemDefaultDevice = () -> *u8
@lib("/usr/lib/libobjc.A.dylib")
extern sel_registerName = (name: *u8) -> *u8
@lib("/usr/lib/libobjc.A.dylib")
@symbol("objc_msgSend")
extern msg = (o: *u8, s: *u8) -> *u8

main = ():
    d = MTLCreateSystemDefaultDevice()
    if d == null:
        print("no Metal device")
        return
    nm = msg(msg(d, sel_registerName(data("name\0"))), sel_registerName(data("UTF8String\0")))
    print("Metal device: {__cstr(nm)}")
