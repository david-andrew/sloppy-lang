# (temporary: what GPU a GitHub macOS runner has)
@lib("/System/Library/Frameworks/Metal.framework/Metal")
extern MTLCreateSystemDefaultDevice = () -> *u8
@lib("/usr/lib/libobjc.A.dylib")
extern sel_registerName = (name: *u8) -> *u8
@lib("/usr/lib/libobjc.A.dylib")
@symbol("objc_msgSend")
extern msg = (o: *u8, s: *u8) -> *u8

main = ():
    d = MTLCreateSystemDefaultDevice()
    if d == null:
        print("no Metal device")
        return
    nm = msg(msg(d, sel_registerName(data("name\0"))), sel_registerName(data("UTF8String\0")))
    print("Metal device: {__cstr(nm)}")
    probe_gl()

@lib("/usr/lib/libobjc.A.dylib")
extern objc_getClass = (name: *u8) -> *u8
@lib("/usr/lib/libobjc.A.dylib")
@symbol("objc_msgSend")
extern msg_p = (o: *u8, s: *u8, a: *u8) -> *u8
@lib("/System/Library/Frameworks/OpenGL.framework/OpenGL")
extern CGLChoosePixelFormat = (attrs: *i32, pf: **u8, n: *i32) -> i32

probe_gl = ():
    dl_open("/System/Library/Frameworks/AppKit.framework/AppKit")
    tries: (str, u32[])[] = [
        ("4.1 core accelerated", [99, 0x4100, 5, 73, 0]),
        ("4.1 core generic", [99, 0x4100, 5, 70, 0x00020400, 0]),
        ("3.2 core generic", [99, 0x3200, 5, 70, 0x00020400, 0]),
        ("legacy generic", [5, 70, 0x00020400, 0]),
        ("legacy any", [0]),
        ("4.1 core any", [99, 0x4100, 0]),
        ("4.1 core offscreen-ok", [99, 0x4100, 96, 0])]
    loop t in tries:
        a = t.1
        pf = msg_p(msg(objc_getClass(data("NSOpenGLPixelFormat\0")), sel_registerName(data("alloc\0"))), sel_registerName(data("initWithAttributes:\0")), data(a) as *u8)
        print("NSOpenGLPixelFormat {t.0}: {pf != null}")
    c: i32[] = [99, 0x4100, 0]
    pfo: *u8 = null
    n: i32 = 0
    r = CGLChoosePixelFormat(data(c), &pfo, &n)
    print("CGLChoosePixelFormat 4.1: error {r}, {n} formats")
