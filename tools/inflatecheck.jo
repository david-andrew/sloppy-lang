# (tools/inflatecheck.py's program) each file named on the command line inflated twice: at once,
# and by an Inflater stepped with no time (its progress never going back); the bytes written to
# <file>.out, and a line: none or ok, and whether the two agree. A file ending in .zlib starts
# after zlib's 2-byte header.
main = ():
    loop path in args()[1..]:
        src = read_bytes(path).unwrap()
        start = if path.ends_with(".zlib"): 2 else: 0
        whole = inflate(src, start)
        s = inflater(src, start)
        steps = 0
        last = 0.0
        ok = true
        loop not s.step(0.0):
            ok = ok and s.progress() >= last and s.progress() <= 1.0
            last = s.progress()
            steps += 1
        stepped = s.result()
        if let out = whole: write_bytes(path + ".out", out)
        same = ok and whole == stepped
        print("{path}: {if whole == none: "none" else: "ok"} {steps} {if same: "same" else: "STEPPED DIFFERS"}")
