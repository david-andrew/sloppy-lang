# (tools/deflatecheck.py's program) each file named on the command line deflated three ways:
# at once into <file>.z, a little at a time (a Deflater stepped with no time) into <file>.zs, and
# read back by inflate, which must give the file again
main = ():
    loop path in args()[1..]:
        src = read_bytes(path).unwrap()
        z = deflate(src)
        d = deflater(src)
        steps = 0
        loop not d.step(0.0): steps += 1
        zs = d.result()
        back = inflate(z) ?? [u8(1), u8(2), u8(3)]
        write_bytes(path + ".z", z)
        write_bytes(path + ".zs", zs)
        print("{path}: {src.len()} -> {z.len()} bytes, {steps} steps, inflate {if back == src: "same" else: "DIFFERENT"}")
