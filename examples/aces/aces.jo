# ACES - a dogfight over farmland, Red's triplanes against Blue's biplanes: two sides of 1 to 6
# planes each, flown by players over the network and the computer. The first side to shoot down
# 5 planes for each of its own wins (15 for 3 a side). Each player has a name and an insignia on
# their plane (Settings), besides their side's crosses or roundels.
#
# Make a room opens a room with a short code (and a link with it) on the matchmaking server
# (lib/invite.jo, tools/rendezvous.jo): friends type the code into Join a room, or open the link,
# the game in a web browser. Play with anybody puts players in a shared public room, whose fight
# starts by itself after a short wait. Without the server, Invite a friend gives a link to send
# and a code comes back. Either way the games connect straight to each other. The lobby shows the
# two sides, the same on every player's screen: each player picks their own (Switch side), and
# the one whose room it is starts the fight and passes on what goes between the others. Each game
# runs the whole fight (rollback netplay, lib/netplay.jo): only the players' controls travel; the
# computer's planes fill the sides, flown the same in every game. One who leaves has the computer
# fly their plane. Practice: the same, with the computer alone.
#
# The mouse flies: the plane turns toward where it points, and its left button fires. Keys win
# over it: S or Down climbs, W or Up dives, A and D (or Left and Right) roll, Q and E the rudder,
# Shift and Ctrl the throttle, Space fires, C looks at the target (and C again back ahead), Tab
# picks the next one, Escape is the menu. A gamepad: the left stick flies, LB and RB the rudder,
# the d-pad the throttle, A or RT fires, LT looks (and back), X the next target.
# Settings changes any of them. On a phone, either way up: a finger dragged anywhere aims, as the
# mouse does, and buttons fire and look at the target; a slider is the throttle.
#
# The twin guns jam when they get too hot, until they cool. Below about 95 km/h the wings stall
# and the nose drops until there is speed again. Turning hard costs speed; diving gains it.
# BOT=1 lets the computer fly this plane (online too); LAG=100 adds 100 ms to what this game
# sends. ACES_TEST="<ticks> <skill> <skill> <planes a side>" flies the computer against itself
# without a window and says how it went.

build:
    name = "Aces"
    icon = "icon.png"

import net
import netplay
import invite

const WEB_PAGE = "https://sloppy-lang.org/examples/aces/"
# the matchmaking server (tools/rendezvous.jo; docs/MATCHMAKING.md): friends join with a short
# code, or its link. "" for none: invite codes only. SLOPPY_SERVER (a page's ?server=) sets another
const MATCH_SERVER = "wss://matchmaking.sloppy-lang.org"
const DT = 1.0 / 60.0           # a tick
const WIN = 5                   # (shot down or crashed, for each plane a side)
const MOST = 6                  # planes a side
const STALL = 26.0              # m/s: slower, the wings lose their grip
const CRUISE = 48.0
const THRUST = 13.0             # m/s² at full throttle
const DRAG = 0.0042             # (top speed, level: about 55 m/s)
const GRIP = 2.4                # how fast the way the plane goes follows its nose (per second)
const PITCH_RATE = 1.15         # radians a second, at full stick and speed
const ROLL_RATE = 2.6
const YAW_RATE = 0.45
const BULLET_SPEED = 380.0
const BULLET_LIFE = 75          # ticks (about 470 m)
const FIRE_GAP = 4              # ticks between shots (the two guns take turns)
const HEAT_SHOT = 9             # (and it cools 1 a tick)
const JAM_HEAT = 300            # jammed until it is down to 120
const DAMAGE = 7
const HIT_RADIUS = 4.0
const FIELD = 2200.0            # past this far from the middle, a plane turns back
const CEILING = 1600.0          # (the engine fades above it)
const RESPAWN = 240             # ticks from a crash to flying again
const MAP = 6400.0              # the ground: 6.4 km square,
const CELLS = 128               # in cells of 50 m
const CELL = MAP / f64(CELLS)

# ---------------- the ground ----------------
# rolling hills, a river, lakes, and mountains all round the field
height = (x: f64, z: f64) -> f64:
    h = 55.0 + 45.0 * sin(x * 0.0021 + 1.3) * cos(z * 0.0017 - 0.4) + 22.0 * sin(x * 0.0047 - z * 0.0031 + 2.0) + 9.0 * sin(x * 0.0113 + z * 0.0087) * sin(z * 0.0131 - 1.0)
    d = abs(x - river_x(z))
    h = -6.0 + (h + 6.0) * smoothstep(25.0, 230.0, d)
    m = smoothstep(2000.0, 3000.0, max(abs(x), abs(z)))
    h + m * m * (420.0 + 120.0 * sin(x * 0.004) * sin(z * 0.0037))

river_x = (z: f64) -> f64: 260.0 * sin(z * 0.0011 + 0.6) + 150.0

# the heights at the cells' corners (the mesh's, and what is hit: the same everywhere)
heights: f64[]
loop zi in 0..CELLS + 1:
    loop xi in 0..CELLS + 1: heights.push(height(f64(xi) * CELL - MAP / 2.0, f64(zi) * CELL - MAP / 2.0))

corner = (xi: int, zi: int) -> f64: heights[clamp(zi, 0, CELLS) * (CELLS + 1) + clamp(xi, 0, CELLS)]

# the ground's height at (x, z), on the mesh's triangles; water is at 0
ground = (x: f64, z: f64) -> f64:
    fx = (x + MAP / 2.0) / CELL
    fz = (z + MAP / 2.0) / CELL
    cx = floor(fx)
    cz = floor(fz)
    u = fx - cx
    v = fz - cz
    xi = int(cx)
    zi = int(cz)
    h00 = corner(xi, zi)
    h10 = corner(xi + 1, zi)
    h01 = corner(xi, zi + 1)
    h11 = corner(xi + 1, zi + 1)
    h = 0.0
    if u + v <= 1.0: h = h00 + (h10 - h00) * u + (h01 - h00) * v
    else: h = h11 + (h01 - h11) * (1.0 - u) + (h10 - h11) * (1.0 - v)
    max(h, 0.0)

# ---------------- the game: everything a tick depends on ----------------
struct Pad:
    pitch = 0                   # -100 (dive) .. 100 (climb)
    roll = 0                    # -100 (left) .. 100 (right)
    yaw = 0                     # -100 (left) .. 100 (right)
    throttle = 0                # -1, 0, 1
    fire = false
    computer = false            # (the computer flies it: a player who left)

struct Plane:
    pos: vec3
    vel: vec3
    rot: vec4                   # (a quaternion: the nose is -z, the right wing +x, up +y)
    team = 0                    # 0 Red, 1 Blue
    throttle = 0.8
    health = 100
    heat = 0
    jammed = false
    cooldown = 0
    shots = 0                   # fired so far (the guns take turns)
    down = 0                    # ticks since it was shot down (0: flying)
    gone = 0                    # ticks until it flies again, after it came down
    safe = 0                    # ticks it cannot be hit (just back)
    kills = 0
    hits = 0                    # hits it has taken
    target = -1                 # (the computer's: the plane it goes after)

struct Bullet:
    pos: vec3
    vel: vec3
    owner: int
    life: int

# what happened, to show and hear: 0 a hit on a plane, 1 a bullet into the ground, 2 a plane
# exploding, 3 a plane shot down (by `by`), 4 a plane flown into the ground
struct Boom:
    pos: vec3
    kind: int
    tick: int
    who: int
    by = -1

# plane i is on side i % 2 (Red the even ones), the (i / 2 + 1)th of it
struct Game:
    planes: Plane[]
    bullets: Bullet[]
    booms: Boom[]               # (the last 2 s of them)
    pilots: int[]               # each plane's player (-1: the computer flies it)
    skill = 0.65                # the computer's: 0 to 1
    scores: int[] = [0, 0]      # each side's
    win = WIN
    tick = 0
    winner = -1                 # (the side)

# plane i where it starts, and comes back: its side in a row, at its end of the field
spawn = (i: int, n: int) -> Plane:
    team = i % 2
    k = i / 2
    side = if team == 0: 1.0 else: -1.0
    dir = vec3(f32(side), 0, 0)
    x = (-1300.0 - f64(k % 2) * 70.0) * side
    z = (f64(k) - f64(n - 1) / 2.0) * 150.0 - 40.0 * side
    Plane(vec3(f32(x), f32(430.0 + f64(k % 3) * 35.0), f32(z)), dir * f32(CRUISE), quat_facing(dir), team = team)

# a fight: pilots says who flies each plane (two for each plane a side)
new_game = (pilots: int[], skill: f64) -> Game:
    n = pilots.len() / 2
    ps: Plane[]
    loop i in 0..2 * n: ps.push(spawn(i, n))
    Game(ps, pilots = pilots, skill = skill, win = WIN * n)

# who flies which plane, n a side: each player on the side they chose (sides: each one's, by
# number), in their order, and the computer the rest
seats = (sides: int[], n: int) -> int[]:
    p = fill(-1, 2 * n)
    had = [0, 0]
    loop k in 0.. and t in sides:
        if had[t] < n: p[2 * had[t] + t] = k
        had[t] += 1
    p

# how many players are on each side
counts = (sides: int[]) -> int[]:
    n = [0, 0]
    loop t in sides: n[t] += 1
    n

TEAMS = ["Red", "Blue"]
name = (i: int) -> str: "{TEAMS[i % 2]} {i / 2 + 1}"

fwd_of = (p: Plane) -> vec3: quat_rotate(p.rot, vec3(0, 0, -1))
right_of = (p: Plane) -> vec3: quat_rotate(p.rot, vec3(1, 0, 0))
flying = (p: Plane) -> bool: p.gone == 0 and p.down == 0

# one tick (1/60 s): the same game and pads give the same game on every machine
# (pads: each player's)
tick = (g: Game, pads: Pad[]) -> Game:
    let g = g
    g.tick += 1
    choose_targets(g)
    cs: Pad[]
    loop i in 0..g.planes.len():
        k = g.pilots[i]
        if k >= 0 and k < pads.len() and not pads[k].computer: cs.push(pads[k])
        else: cs.push(bot_pad(g, i, g.skill))
    loop i in 0..g.planes.len(): fly(g, i, cs[i])
    shoot(g)
    kept: Boom[]
    loop b in g.booms:
        if g.tick - b.tick < 120: kept.push(b)
    g.booms = kept
    g

score = (g: mut Game, team: int):
    if g.winner >= 0: return
    g.scores[team] += 1
    if g.scores[team] >= g.win: g.winner = team

fly = (g: mut Game, i: int, pad: Pad):
    p = g.planes[i]
    if p.gone > 0:
        p.gone -= 1
        if p.gone == 0:
            kills = p.kills
            p = spawn(i, g.planes.len() / 2)
            p.kills = kills
            p.safe = 120
        g.planes[i] = p
        return
    if p.safe > 0: p.safe -= 1
    c = pad
    if p.down > 0:
        # shot down: the engine dead, the controls gone, rolling over and down
        p.down += 1
        c = Pad(-40, if i % 2 == 0: 100 else: -100, 0, -1, false)
    else if length(vec2(p.pos.x, p.pos.z)) > FIELD:
        # (past the field's edge: back toward the middle)
        home = normalize(vec3(-p.pos.x, 0, -p.pos.z) + vec3(0, f32(clamp((500.0 - f64(p.pos.y)) / 800.0, -0.3, 0.3)), 0))
        t = steer(p, home)
        c.pitch = t.pitch
        c.roll = t.roll
        c.yaw = t.yaw
    speed = f64(length(p.vel))
    auth = clamp(speed / 38.0, 0.25, 1.0)
    q = p.rot
    q = quat_mul(q, quat_axis_angle(vec3(1, 0, 0), f64(c.pitch) / 100.0 * PITCH_RATE * auth * DT))
    q = quat_mul(q, quat_axis_angle(vec3(0, 0, 1), -f64(c.roll) / 100.0 * ROLL_RATE * auth * DT))
    q = quat_mul(q, quat_axis_angle(vec3(0, 1, 0), -f64(c.yaw) / 100.0 * YAW_RATE * auth * DT))
    fwd = quat_rotate(q, vec3(0, 0, -1))
    vdir = fwd
    if speed > 0.1: vdir = p.vel * f32(1.0 / speed)
    # (stalled: the nose falls toward the way the plane is going, and down)
    lift = smoothstep(STALL * 0.75, STALL * 1.15, speed)
    if lift < 1.0:
        axis = cross(fwd, normalize(vdir + vec3(0, -0.7, 0)))
        if length(axis) > 0.001: q = quat_mul(quat_axis_angle(axis, (1.0 - lift) * 1.6 * DT), q)
    p.rot = normalize(q)
    fwd = quat_rotate(p.rot, vec3(0, 0, -1))
    up = quat_rotate(p.rot, vec3(0, 1, 0))
    p.throttle = clamp(p.throttle + f64(c.throttle) * 0.6 * DT, 0.0, 1.0)
    # speed along the way it goes: the engine (fading up high), drag (more pulling hard), and
    # gravity (diving gains speed, climbing costs it)
    thin = clamp((CEILING + 300.0 - f64(p.pos.y)) / 600.0, 0.0, 1.0)
    pull = abs(f64(c.pitch)) / 100.0 * auth
    acc = THRUST * p.throttle * thin - DRAG * speed * speed * (1.0 + 0.9 * pull) - 9.8 * f64(vdir.y)
    speed = max(speed + acc * DT, 0.0)
    # the way it goes turns toward the nose: hardly at all when stalled
    k = min(GRIP * lift * DT, 1.0)
    vdir = normalize(vdir + (fwd - vdir) * f32(k))
    p.vel = vdir * f32(speed)
    # what the wings do not hold up falls: all of it stalled, a little banked over
    sag = 9.8 * (1.0 - lift) + 3.0 * lift * (1.0 - max(f64(up.y), 0.0))
    p.vel.y -= f32(sag * DT)
    p.pos += p.vel * f32(DT)
    # the ground
    if f64(p.pos.y) < ground(f64(p.pos.x), f64(p.pos.z)) + 1.2 or p.down > 900:
        g.booms.push(Boom(p.pos, 2, g.tick, i))
        if p.down == 0:
            g.booms.push(Boom(p.pos, 4, g.tick, i))
            score(g, 1 - p.team)
        p.down = 0
        p.gone = RESPAWN
        p.vel = vec3(0, 0, 0)
    # the guns
    if p.cooldown > 0: p.cooldown -= 1
    if p.heat > 0: p.heat -= 1
    if p.jammed and p.heat < 120: p.jammed = false
    if c.fire and p.gone == 0 and p.down == 0 and not p.jammed and p.cooldown == 0:
        right = quat_rotate(p.rot, vec3(1, 0, 0))
        side = if p.shots % 2 == 0: 0.35 else: -0.35
        # (a little scatter, from the tick: the same on every machine)
        h = hash(g.tick * 4 + i)
        sx = (f64(h & 1023) / 1023.0 - 0.5) * 0.008
        sy = (f64((h >> 10) & 1023) / 1023.0 - 0.5) * 0.008
        dir = normalize(fwd + right * f32(sx) + up * f32(sy))
        g.bullets.push(Bullet(p.pos + fwd * 3.2 + right * f32(side) + up * 0.6, p.vel + dir * f32(BULLET_SPEED), i, BULLET_LIFE))
        p.shots += 1
        p.cooldown = FIRE_GAP
        p.heat += HEAT_SHOT
        if p.heat >= JAM_HEAT: p.jammed = true
    g.planes[i] = p

# the bullets: on, down a little, into a plane or the ground (through those on the shooter's side)
shoot = (g: mut Game):
    kept: Bullet[]
    loop b in g.bullets:
        let b = b
        a = b.pos
        b.vel.y -= f32(9.8 * DT)
        b.pos += b.vel * f32(DT)
        b.life -= 1
        hit = false
        loop j in 0..g.planes.len():
            t = g.planes[j]
            if t.team == b.owner % 2 or t.gone > 0 or t.safe > 0: continue
            # (the bullet's way past the plane, as the plane sees it: it moved too)
            if seg_near(a - (t.pos - t.vel * f32(DT)), b.pos - t.pos, HIT_RADIUS):
                hit = true
                g.booms.push(Boom(b.pos, 0, g.tick, j, b.owner))
                g.planes[j].hits += 1
                if t.down == 0:
                    g.planes[j].health -= DAMAGE
                    if g.planes[j].health <= 0:
                        g.planes[j].health = 0
                        g.planes[j].down = 1
                        g.booms.push(Boom(t.pos, 3, g.tick, j, b.owner))
                        if g.winner < 0: g.planes[b.owner].kills += 1
                        score(g, b.owner % 2)
                break
        if hit: continue
        if f64(b.pos.y) < 450.0 and f64(b.pos.y) < ground(f64(b.pos.x), f64(b.pos.z)):
            g.booms.push(Boom(b.pos, 1, g.tick, -1))
            continue
        if b.life > 0: kept.push(b)
    g.bullets = kept

# whether the segment a-b passes within r of the origin
seg_near = (a: vec3, b: vec3, r: f64) -> bool:
    d = b - a
    l2 = f64(dot(d, d))
    t = 0.0
    if l2 > 0.0: t = clamp(-f64(dot(a, d)) / l2, 0.0, 1.0)
    q = a + d * f32(t)
    f64(dot(q, q)) < r * r

# ---------------- flying toward something (the computer's pilot; the field's edge) ----------------
# the stick and rudder that turn plane p toward the direction want: far off, roll it overhead and
# pull; nearly there, small corrections with the wings level (between, some of each: no
# twitching from one to the other)
steer = (p: Plane, want: vec3) -> Pad:
    l = quat_rotate(quat_inverse(p.rot), normalize(want))     # (-z ahead, +x right, +y up)
    ahead = f64(-l.z)
    a = max(ahead, 0.1)
    right = right_of(p)
    near_pitch = clamp(f64(l.y) / a * 14.0, -1.0, 1.0)
    near_yaw = clamp(f64(l.x) / a * 14.0, -1.0, 1.0)
    near_roll = clamp(f64(right.y) * 2.0 + f64(l.x) / a * 6.0, -1.0, 1.0)
    err = atan2(f64(l.x), f64(l.y))
    off = acos(clamp(ahead, -1.0, 1.0))
    far_roll = clamp(err * 2.0, -1.0, 1.0)
    far_pitch = if abs(err) < 1.2: clamp(off * 3.0, 0.0, 1.0) else: 0.2
    k = smoothstep(0.94, 0.995, ahead)
    c = Pad()
    c.pitch = int((far_pitch + (near_pitch - far_pitch) * k) * 100.0)
    c.roll = int((far_roll + (near_roll - far_roll) * k) * 100.0)
    c.yaw = int(near_yaw * k * 100.0)
    c

# the way to aim to hit e from p: where e will be when the bullets get there (they keep p's
# speed, and drop a little)
lead = (p: Plane, e: Plane) -> vec3:
    rel = e.pos - p.pos
    rv = e.vel - p.vel
    t = f64(length(rel)) / BULLET_SPEED
    loop k in 0..2: t = f64(length(rel + rv * f32(t))) / BULLET_SPEED
    rel + rv * f32(t) + vec3(0, f32(4.9 * t * t), 0)

# the plane each of the computer's goes after: the nearest of the other side's, the nearer the
# more ahead; looked at again every 1.5 s (sticking with the one it has unless another is a good
# deal better), and when that one is down
choose_targets = (g: mut Game):
    loop i in 0..g.planes.len():
        p = g.planes[i]
        cur = p.target
        ok = cur >= 0 and flying(g.planes[cur]) and g.planes[cur].safe == 0
        if ok and (g.tick + i * 7) % 90 != 0: continue
        f = fwd_of(p)
        best = -1
        least = 1e18
        loop j in 0..g.planes.len():
            e = g.planes[j]
            if e.team == p.team or not flying(e) or e.safe > 0: continue
            d = e.pos - p.pos
            l = max(f64(length(d)), 1.0)
            v = l * (2.0 - f64(dot(f, d)) / l)
            if j == cur: v *= 0.7
            if v < least:
                least = v
                best = j
        g.planes[i].target = best

# the computer's controls for plane i: skill 0 (wobbly, slow to turn, fires early) to 1
bot_pad = (g: Game, i: int, skill: f64) -> Pad:
    p = g.planes[i]
    if not flying(p): return Pad()
    has = p.target >= 0 and p.target < g.planes.len()
    e = if has: g.planes[p.target] else: p
    fwd = fwd_of(p)
    speed = f64(length(p.vel))
    alt = f64(p.pos.y) - ground(f64(p.pos.x), f64(p.pos.z))
    ahead = p.pos + p.vel * 4.0
    low = alt < 130.0 or f64(ahead.y) < ground(f64(ahead.x), f64(ahead.z)) + 100.0
    aim = vec3(0, 0, 0)
    fight = has and flying(e) and e.safe == 0 and not low
    want = vec3(0, 0, 0)
    if low:
        flat = vec3(fwd.x, 0, fwd.z)
        if length(flat) < 0.1: flat = vec3(1, 0, 0)
        want = normalize(flat) + vec3(0, 0.9, 0)
    else if fight:
        aim = lead(p, e)
        # (less skill: aims round about, as if it misjudged)
        w = (1.0 - skill) * 14.0
        t = f64(g.tick)
        want = aim + vec3(f32(sin(t * 0.013 + f64(i)) * w), f32(cos(t * 0.011) * w), f32(sin(t * 0.017 + 2.0) * w))
    else: want = vec3(-p.pos.x, f32(500.0 - f64(p.pos.y)), -p.pos.z)
    c = steer(p, want)
    c.pitch = int(f64(c.pitch) * (0.55 + 0.45 * skill))
    # (slow: no hard pulling, which would stall it)
    if speed < 34.0: c.pitch = min(c.pitch, 15)
    c.throttle = 1
    if fight:
        d = f64(length(aim))
        within = 0.9995 - (1.0 - skill) * 0.003
        c.fire = d < 480.0 and f64(dot(fwd, normalize(aim))) > within and p.heat < JAM_HEAT - 30
        # (close behind it: slow down, not to fly past)
        if d < 140.0 and f64(dot(e.pos - p.pos, fwd)) > 0.0 and f64(dot(p.vel - e.vel, fwd)) > 6.0: c.throttle = -1
    c

# ---------------- a test without a window: the computer against itself ----------------
# ACES_TEST="ticks skill skill n": Red's skill, Blue's, n planes a side; each game starts a little
# differently
when TARGET != "wasm":
    if let spec = env("ACES_TEST"):
        w = split(spec, " ")
        ticks = to_int(w[0]) ?? 36000
        sk = [if w.len() > 1: to_float(w[1]) ?? 1.0 else: 1.0, if w.len() > 2: to_float(w[2]) ?? 0.6 else: 0.6]
        n = if w.len() > 3: clamp(to_int(w[3]) ?? 1, 1, MOST) else: 1
        games = 0
        # (each plane a player, flown by the computer with its side's skill)
        each: int[]
        loop i in 0..2 * n: each.push(i)
        fresh = (k: int) -> Game:
            let g = new_game(each, 1.0)
            loop i in 0..2 * n:
                g.planes[i].pos += vec3(0, f32(f64(hash(k * 2 + i) % 200) - 100.0), f32(f64(hash(k * 2 + i + 9) % 600) - 300.0))
                g.planes[i].rot = quat_mul(quat_axis_angle(vec3(0, 1, 0), f64(hash(k * 2 + i + 5) % 100) / 100.0 - 0.5), g.planes[i].rot)
            g
        g = fresh(0)
        crashes = 0
        kills = 0
        slow = 0
        flown = 0
        low = 1e9
        took: int[]
        loop k in 0..ticks:
            pads: Pad[]
            loop i in 0..2 * n: pads.push(bot_pad(g, i, sk[i % 2]))
            g = tick(g, pads)
            loop b in g.booms:
                if b.tick == g.tick and b.kind == 4: crashes += 1
                if b.tick == g.tick and b.kind == 3: kills += 1
            loop p in g.planes:
                if not flying(p): continue
                flown += 1
                if length(p.vel) < STALL * 1.15: slow += 1
                low = min(low, f64(p.pos.y) - ground(f64(p.pos.x), f64(p.pos.z)))
            if g.winner >= 0:
                print("game {games}: {g.tick / 60} s, {g.scores[0]}-{g.scores[1]}")
                took.push(g.tick)
                games += 1
                g = fresh(games)
        print("{ticks / 60} s: shot down {kills}, crashed {crashes}, slow {100 * slow / max(flown, 1)}% of the time, lowest {int(low)} m, {games} games")
        print("hash {hash(g)}")
        exit(0)

# ---------------- playing: with a friend, or against the computer ----------------
enum Mode: menu, online, practice

window("Aces", 1280, 720)
# (a phone held upright gets a layout of its own: lay_out)
sideways_hint(false)
action("Climb", [.key(.s), .key(.down), .stick(1, 1)])
action("Dive", [.key(.w), .key(.up), .stick(1, -1)])
action("Roll left", [.key(.a), .key(.left), .stick(0, -1)])
action("Roll right", [.key(.d), .key(.right), .stick(0, 1)])
action("Rudder left", [.key(.q), .button(.lb)])
action("Rudder right", [.key(.e), .button(.rb)])
action("Throttle up", [.key(.shift), .key(.r), .button(.up)])
action("Throttle down", [.key(.ctrl), .key(.f), .button(.down)])
action("Fire", [.key(.space), .button(.a), .stick(5, 1)])
action("Look at the target", [.key(.c), .stick(4, 1)])
action("Next target", [.key(.tab), .button(.x)])

struct Settings:
    invert = false              # (pitch: W climbs, S dives)
    sound = 0.8
    skill = 0                   # the computer: 0 easy, 1 fair, 2 hard
    mouse = true                # the mouse steers
    sides = 3                   # planes a side (more if a side has more players)
    side = 0                    # the side this one flies on (0 Red, 1 Blue): the lobby's Switch side
    name = ""                   # (as typed: clean_name makes it the one shown)
    badge = -1                  # (the insignia on this one's plane: BADGES)
    level = false               # the camera's roll locked: the horizon level, whatever the bank

# the insignias a player can have on their plane, besides their side's (Settings)
BADGES = ["none", "white bands", "yellow nose", "chevron", "star", "skull", "lightning", "yellow tail", "hat in the ring", "shark mouth", "Nungesser's heart", "Voss's face", "stork", "ace of spades"]

# a player's name as shown and sent: up to 12 characters, no commas, one space between words
# (it travels as an underscore, so a message's words stay words)
const NAME_MOST = 12
clean_name = (s: str) -> str:
    out = ""
    space = false
    loop ch in chars(s):
        if ch == 32 or ch == 95: space = len(out) > 0
        else if ch > 32 and ch != 44 and char_count(out) + (if space: 1 else: 0) < NAME_MOST:
            if space: out += " "
            space = false
            out += chr(ch)
    out
wire = (name: str) -> str: name.replace(" ", "_")
my_name = () -> str:
    n = clean_name(settings.name)
    if len(n) == 0: "Pilot" else: n

settings = Settings()
if let saved = load_data("settings"):
    w = split(saved, " ")
    if w.len() >= 4:
        settings.invert = w[0] == "1"
        settings.sound = to_float(w[1]) ?? 0.8
        settings.skill = clamp(to_int(w[2]) ?? 0, 0, 2)
        settings.mouse = w[3] == "1"
    if w.len() >= 6:
        settings.sides = clamp(to_int(w[4]) ?? 3, 1, MOST)
        settings.side = clamp(to_int(w[5]) ?? 0, 0, 1)
    if w.len() >= 7: settings.name = clean_name(w[6])
    if w.len() >= 8: settings.badge = to_int(w[7]) ?? -1
    if w.len() >= 9: settings.level = w[8] == "1"
save_settings = ():
    settings.name = my_name()
    save_data("settings", "{if settings.invert: 1 else: 0} {settings.sound} {settings.skill} {if settings.mouse: 1 else: 0} {settings.sides} {settings.side} {wire(settings.name)} {settings.badge} {if settings.level: 1 else: 0}")
# (the first time: a name and an insignia, to change in Settings)
if len(settings.name) == 0 or settings.badge < 0 or settings.badge >= BADGES.len():
    if len(settings.name) == 0: settings.name = "Pilot {random_int(100, 1000)}"
    if settings.badge < 0 or settings.badge >= BADGES.len(): settings.badge = random_int(1, BADGES.len())
    save_settings()
SKILLS = [0.3, 0.65, 1.0]

mode = Mode.menu
# (the menu's pages)
const MAIN = 0
const SETTINGS = 1
const LOBBY = 2                 # practice, or this one's room: the sides, Start
const JOINED = 3                # in another's room: the sides, waiting for them to start
page = MAIN
const PUBLIC_WAIT = 30.0        # (s) a public room's fight starts by itself this long after its lobby opens
demo = () -> Game: new_game(fill(-1, 6), 0.75)
s = netplay.session(demo(), tick, players = 2, me = 0)
local = demo()                  # practice, and the menu's fight in the background
mine = 0                        # (this machine's plane)
spare = 0.0
status = ""
bot = env("BOT") != none
invite.server(MATCH_SERVER)
invite.from_link()

# a friend who came to this one's room (or invite): their peer (-1 once gone), and their name,
# insignia and side, as they said ("" until then)
struct Friend:
    peer: int
    name = ""
    badge = 0
    side = 0

# with friends: the host (whose room it is) has each one, player k + 1 being friends[k]; each of
# them the host's peer
friends: Friend[]
host = -1
fights = 0                      # (fights started with these friends: their numbers)
public = false                  # (this one's room is a public one, Play with anybody's: its fight starts by itself)
starts_at = 0.0                 # (and when, in its lobby)
lobby_me = 0                    # (joined: this one's player, and the sides, as the host says)
lobby_pilots: int[]
lobby_names: str[]
lobby_badges: int[]
lobby_starts = -1.0             # (when the fight starts by itself: -1, when the host starts it)
want_side = -1                  # (joined: the side asked for with Switch side; -1 none)
told_at = 0.0
crew_until = 0.0                # (the host, in a fight: until when everyone is told the names and insignias again)
away: int[]                     # (the players who left this fight: the computer flies their planes)
results: Game? = none           # (the last fight, over: its tally shown with the sides, till the next)
results_me = 0
# the players' names and insignias in this fight, by number (only shown: nothing a tick does
# depends on them)
crew_names: str[]
crew_badges: int[]

# (an insignia as sent: one of BADGES)
to_badge = (t: str) -> int: clamp(to_int(t) ?? 0, 0, BADGES.len() - 1)

# the insignia on plane j: its player's (the menu's plane: this one's, to see it), or none
badge_of = (g: Game, j: int) -> int:
    if mode == .menu: return if j == mine: settings.badge else: 0
    k = g.pilots[j]
    if k >= 0 and k < crew_badges.len(): crew_badges[k] else: 0

# what plane j is called: its player's name, or the computer's "Red 2"
call = (g: Game, j: int) -> str:
    k = g.pilots[j]
    if k >= 0 and k < crew_names.len() and len(crew_names[k]) > 0: return crew_names[k]
    name(j)

# player k, as the fight's names say
player_name = (k: int) -> str: if k >= 0 and k < crew_names.len() and len(crew_names[k]) > 0: crew_names[k] else: "player {k + 1}"

# the players' names, insignias and sides as they are now (the host's): this one's, then each
# friend's
names_now = () -> str[]:
    n = [my_name()]
    n.extend(friends.map((f): f.name))
    n
badges_now = () -> int[]:
    b = [settings.badge]
    b.extend(friends.map((f): f.badge))
    b
sides_now = () -> int[]:
    t = [settings.side]
    t.extend(friends.map((f): f.side))
    t

# (the friends still there)
drop_gone = ():
    global friends
    friends = friends.filter((f): f.peer >= 0)

# the friend with that peer (-1: none)
friend_of = (peer: int) -> int:
    loop k in 0.. and f in friends:
        if f.peer == peer: return k
    -1

# a friend who came: on the side with fewer players (Red when even); in a public room, a few
# seconds at least to choose
came = (peer: int):
    global starts_at, told_at
    n = counts(sides_now())
    friends.push(Friend(peer, side = if n[1] < n[0]: 1 else: 0))
    told_at = 0.0
    if public: starts_at = max(starts_at, elapsed() + 10.0)

# planes a side: as chosen, and as many as the side with more players
planes_a_side = () -> int:
    n = counts(sides_now())
    clamp(max(settings.sides, max(n[0], n[1])), 1, MOST)

# the sides as they would be now (the host's)
lobby_seats = () -> int[]: seats(sides_now(), planes_a_side())

# (the players on side t, in the sides as the host says)
players_on = (pilots: int[], t: int) -> int:
    n = 0
    loop i in 0.. and k in pilots:
        if i % 2 == t and k >= 0: n += 1
    n

# Switch side (the lobby's button, Tab, a gamepad's X): to the other side, if it has room for
# another player. The host's own at once; a friend asks the host, and the sides show it once it has
switch_side = ():
    global told_at, want_side
    told_at = 0.0
    if page == LOBBY:
        if counts(sides_now())[1 - settings.side] < MOST: settings.side = 1 - settings.side
        return
    i = lobby_pilots.index_of(lobby_me)
    if i >= 0 and players_on(lobby_pilots, 1 - i % 2) < MOST: want_side = 1 - i % 2

# Make a room: this one's room opens (the lobby shows its code), and friends come by it
make_room = ():
    global page
    invite.open_room(reliable = false)
    page = LOBBY

# start the fight: practice (alone), or with the friends (each told its number and the sides,
# and told again a few times in its first seconds, in case it was lost)
start_fight = ():
    global crew_badges, crew_names, local, mine, mode, results
    pilots = lobby_seats()
    skill = SKILLS[settings.skill]
    save_settings()
    results = none
    crew_names = names_now()
    crew_badges = badges_now()
    if friends.len() == 0:
        local = new_game(pilots, skill)
        mine = max(pilots.index_of(0), 0)
        mode = .practice
        start_view()
        log_start("practice")
        return
    fights += 1
    peers = [-1]
    peers.extend(friends.map((f): f.peer))
    begin(0, pilots, skill, peers)
    tell_start()

start_text = (k: int) -> str: "start {fights} {k} {settings.skill} {join(game().pilots.map((p): "{p}"), ",")} {join(crew_names.map(wire), ",")} {join(crew_badges.map((b): "{b}"), ",")}"
tell_start = ():
    loop k in 0.. and f in friends:
        if f.peer >= 0: net.send(f.peer, start_text(k + 1))

# ---------------- a log of how the game runs, to see what went wrong ----------------
# Each second of a fight (practice or online), a line in aces-log.txt in the game's save folder
# (on Linux ~/.local/share/Aces/, on Windows %APPDATA%\Aces\, on macOS ~/Library/Application
# Support/Aces/): the frames, their average and slowest time and the long ones; the time taken by
# each part of a frame (update, draw, the 3D scene, its shadows...); what there is to draw; online,
# the ticks played and the frames spent waiting for the others, rollbacks, each other player's
# ping, how they are reached and what waits to go to them; and the memory in use. Each fight
# starts with a line saying what it is, and on what (the GPU, the browser). Past 2 MB the file
# starts again (the one before kept as aces-log-old.txt). In a web page it is kept in the
# browser's storage, the last half hour of it, in pieces of a minute (each second's line saves
# its piece, which stays small), and Settings' "Save the log" downloads it.
log_at = 0.0
const LOG_PIECE = 60            # (lines in a piece of the web's log)
const LOG_PIECES = 30
web_log: str[] = []             # (the lines of the piece being written)
web_piece = -1                  # (its number: a page starts a new one, after the last it saved)
log_said = ""                   # (what Save the log did, shown under it)
log_line = (line: str):
    global web_log, web_piece
    when TARGET != "wasm":
        _ = append_file(log_path(), line + "\n")
    else:
        if web_piece < 0:
            web_piece = load_value("log-at", -1) + 1
            _ = save_value("log-at", web_piece)
            _ = delete_data("log-{web_piece - LOG_PIECES}")
        web_log.push(line)
        _ = save_data("log-{web_piece}", join(web_log, "\n") + "\n")
        if web_log.len() >= LOG_PIECE:
            web_log = []
            web_piece += 1
            _ = save_value("log-at", web_piece)
            _ = delete_data("log-{web_piece - LOG_PIECES}")

# (natively: the file, started again past 2 MB)
log_path = () -> str:
    dir = save_dir()
    make_dirs(dir)
    path = "{dir}/aces-log.txt"
    if (file_size(path) ?? 0) > 2000000: _ = rename_file(path, "{dir}/aces-log-old.txt")
    path

# (web: the pieces kept, oldest first, as one text; "" when there are none)
web_log_text = () -> str:
    last = load_value("log-at", -1)
    out = ""
    loop k in [last - LOG_PIECES + 1..last]:
        if let t = load_data("log-{k}"): out += t
    out

# Settings' Save the log: in a web page, downloaded; elsewhere, where it is
save_log = ():
    global log_said
    when TARGET == "wasm":
        t = web_log_text()
        if len(t) == 0: log_said = "Nothing logged yet: a fight is logged as it goes"
        else if write_file("aces-log.txt", t) and download_file("aces-log.txt"): log_said = "Downloaded aces-log.txt ({split(t, "\n").len() - 1} lines)"
        else: log_said = "The browser would not save it"
    else:
        path = "{save_dir()}/aces-log.txt"
        log_said = if file_exists(path): "It is {path}" else: "Nothing logged yet: a fight is logged as it goes"

# (a panic, the game ending with it: in the log too, so that it can be saved after; in a web
# page, reloaded, Settings' Save the log has it)
on_panic((m: str): log_line("panic: {m}"))

# (the first of a fight: what it is, and on what)
log_start = (what: str):
    global log_at
    record_stats()
    _ = frame_stats_line()
    d = now()
    size = pixel_size()
    log_line("{d.year}-{d.month:02}-{d.day:02} {d.hour:02}:{d.minute:02}: {what}, {game().planes.len()} planes ({TARGET}, {int(size.x)}x{int(size.y)}, {graphics_info()})")
    log_at = elapsed()

log_frame = ():
    global log_at
    if mode == .menu or elapsed() - log_at < 1.0: return
    log_at = elapsed()
    d = now()
    g = game()
    size = pixel_size()
    net_part = if mode == .online: " | {s.stats_line()}" else: ""
    log_line("{d.hour:02}:{d.minute:02}:{d.second:02} {frame_stats_line()} | {int(size.x)}x{int(size.y)} bullets {g.bullets.len()} particles {smoke.items.len() + fire.items.len() + sparks.items.len()}{net_part} | memory {memory_in_use() / 1000000}MB objects {alloc_count()}")

begin = (who: int, pilots: int[], skill: f64, peers: int[]):
    global away, mine, mode, results, s, status
    s = netplay.session(new_game(pilots, skill), tick, players = peers.len(), me = who)
    # (others fly on a third of a second while one machine stops, a browser's tab busy: its
    # inputs come later, and the ticks since are played again, which costs little)
    s.max_ahead = 20
    s.over(peers)
    log_start("online, {peers.len()} players, this one player {who}")
    if let lag = env("LAG"): s.lag(to_float(lag) ?? 0, 10, 0.02)
    mine = max(pilots.index_of(who), 0)
    away = []
    results = none
    status = ""
    mode = .online
    save_settings()
    start_view()

# back to the menu, the friends let go (and the room closed)
leave = ():
    global friends, host, public, results, status, want_side
    loop f in friends:
        if f.peer >= 0: net.close(f.peer)
    friends = []
    if host >= 0: net.close(host)
    host = -1
    public = false
    want_side = -1
    status = ""
    invite.close_room()
    to_menu(MAIN)
    results = none

to_menu = (to: int):
    global local, mine, mode, page, results, results_me
    if mode != .menu and game().winner >= 0:
        results = game()
        results_me = mine
    mode = .menu
    local = demo()
    mine = 0
    start_view()
    page = to

# what the others say, and their coming and going
on_net = (e: net.NetEvent):
    global crew_badges, crew_names, fights, lobby_badges, lobby_me, lobby_names, lobby_pilots, lobby_starts
    if e.kind == .left: gone(e.peer)
    if e.kind != .message: return
    w = split(e.text, " ")
    # (the host: a friend's name, insignia and side)
    if e.peer != host:
        k = friend_of(e.peer)
        if k >= 0 and w.len() >= 3 and w[0] == "me": heard_me(k, w)
        return
    if w.len() >= 2 and w[0] == "gone" and mode == .online:
        loop t in split(w[1], ","):
            k = to_int(t) ?? -1
            if k > 0 and k < s.players and k != s.me: left_fight(k)
    else if w.len() >= 4 and w[0] == "crew" and mode == .online and (to_int(w[1]) ?? 0) == fights:
        crew_names = split(w[2], ",").map(clean_name)
        crew_badges = split(w[3], ",").map(to_badge)
    else if w.len() >= 4 and w[0] == "lobby":
        # (the host back at the sides after this fight: it is over, here too; one from before
        # it started, late, is not)
        if mode == .online and (to_int(w[1]) ?? 0) >= fights: to_menu(JOINED)
        lobby_me = to_int(w[2]) ?? 0
        lobby_pilots = split(w[3], ",").map((t): to_int(t) ?? -1)
        lobby_names = if w.len() >= 5: split(w[4], ",").map(clean_name) else: []
        lobby_badges = if w.len() >= 6: split(w[5], ",").map(to_badge) else: []
        secs = if w.len() >= 7: to_float(w[6]) ?? -1.0 else: -1.0
        lobby_starts = if secs >= 0.0: elapsed() + secs else: -1.0
    else if w.len() >= 5 and w[0] == "start":
        r = to_int(w[1]) ?? 0
        if r <= fights: return
        fights = r
        who = to_int(w[2]) ?? 1
        pilots = split(w[4], ",").map((t): to_int(t) ?? -1)
        players = 1
        loop p in pilots: players = max(players, p + 1)
        if who <= 0 or who >= players: return
        peers = fill(-1, players)
        peers[0] = host
        crew_names = if w.len() >= 6: split(w[5], ",").map(clean_name) else: []
        crew_badges = if w.len() >= 7: split(w[6], ",").map(to_badge) else: []
        begin(who, pilots, SKILLS[clamp(to_int(w[3]) ?? 1, 0, 2)], peers)

# a friend's name and insignia (changed in a fight: everyone is told), and the side they ask for,
# in the lobby, if it has room
heard_me = (k: int, w: str[]):
    global crew_until
    f = friends[k]
    f.name = clean_name(w[1])
    f.badge = to_badge(w[2])
    t = if w.len() >= 4: to_int(w[3]) ?? -1 else: -1
    if mode == .menu and t >= 0 and t <= 1 and t != f.side and counts(sides_now())[t] < MOST: f.side = t
    friends[k] = f
    if mode == .online and k + 1 < crew_badges.len() and (crew_names[k + 1] != f.name or crew_badges[k + 1] != f.badge):
        crew_names[k + 1] = f.name
        crew_badges[k + 1] = f.badge
        crew_until = elapsed() + 3.0

# a friend's game has gone (closed, or not heard from)
gone = (peer: int):
    global host, status
    if peer == host:
        host = -1
        # (two: this game has all the other one did, and plays on for them; more: only the host
        # had the others)
        if mode == .online and s.players == 2 and game().winner < 0:
            s.stand_in(0, Pad(computer = true))
            left_fight(0)
        else:
            leave()
            status = "your friend left"
        return
    k = friend_of(peer)
    if k < 0: return
    friends[k].peer = -1
    if mode == .online:
        s.stand_in(k + 1, Pad(computer = true))
        left_fight(k + 1)
    else: drop_gone()

# a player not heard from for 8 s has gone (a page closed may not say so for longer; after the
# fight, one is only reading the results, or has gone back to the sides)
gone_quiet = ():
    if mode != .online or game().winner >= 0: return
    loop q in 0..s.players:
        if q == s.me or s.stands_in(q) or s.silent(q) < 8.0: continue
        peer = if s.me == 0: friends[q - 1].peer else: if q == 0: host else: -1
        if peer < 0: continue
        net.close(peer)
        gone(peer)

# this one's name and insignia, changed in Settings during a fight, on its plane: at once in
# practice; the host's told to everyone (a friend's go to the host: tell)
own_crew = ():
    global crew_until
    if crew_badges.len() == 0 or not (mode == .practice or (mode == .online and s.me == 0)): return
    if crew_names[0] != my_name() or crew_badges[0] != settings.badge:
        crew_names[0] = my_name()
        crew_badges[0] = settings.badge
        crew_until = elapsed() + 3.0

# (the host: the sides as they are, and who is who, to each friend twice a second while
# choosing; in a fight, the start again early in it, the names and insignias after a change, and
# who has left. A friend: its name, insignia and the side it asks for, till the sides show them;
# in a fight, its name and insignia till the host has them)
tell = ():
    global told_at, want_side
    own_crew()
    if elapsed() - told_at < 0.5: return
    if host >= 0 and mode == .menu and page == JOINED:
        told_at = elapsed()
        i = lobby_pilots.index_of(lobby_me)
        shown = if i >= 0: i % 2 else: -1
        # (the side asked for, full since: asked for no more)
        if want_side >= 0 and want_side != shown and players_on(lobby_pilots, want_side) >= MOST: want_side = -1
        known = lobby_me > 0 and lobby_me < lobby_badges.len() and lobby_me < lobby_names.len() and lobby_names[lobby_me] == my_name() and lobby_badges[lobby_me] == settings.badge
        if not known or (want_side >= 0 and want_side != shown): net.send(host, "me {wire(my_name())} {settings.badge} {want_side}")
    else if host >= 0 and mode == .online:
        told_at = elapsed()
        if s.me >= crew_badges.len() or s.me >= crew_names.len() or crew_names[s.me] != my_name() or crew_badges[s.me] != settings.badge: net.send(host, "me {wire(my_name())} {settings.badge} -1")
    if friends.len() == 0: return
    if mode == .menu and page == LOBBY:
        told_at = elapsed()
        p = join(lobby_seats().map((x): "{x}"), ",")
        n = join(names_now().map(wire), ",")
        b = join(badges_now().map((x): "{x}"), ",")
        secs = if public: "{max(starts_at - elapsed(), 0.0):.1}" else: "-1"
        loop k in 0.. and f in friends:
            if f.peer >= 0: net.send(f.peer, "lobby {fights} {k + 1} {p} {n} {b} {secs}")
    else if mode == .online and s.me == 0:
        told_at = elapsed()
        if s.tick < 300: tell_start()
        if elapsed() < crew_until:
            c = "crew {fights} {join(crew_names.map(wire), ",")} {join(crew_badges.map((x): "{x}"), ",")}"
            loop f in friends:
                if f.peer >= 0: net.send(f.peer, c)
        # (and who has left, for the others to say)
        if away.len() > 0:
            w = "gone {join(away.map((k): "{k}"), ",")}"
            loop f in friends:
                if f.peer >= 0: net.send(f.peer, w)

left_fight = (k: int):
    if k in away: return
    away.push(k)
    say("{player_name(k)} left: the computer flies their plane", gray(0.85))

# the fight is over, and its results have been up long enough to be read (3 s: a gamepad's A
# fires too, and one still firing would pass them by)
over = () -> bool: mode != .menu and game().winner >= 0 and game().tick - won_at > 180

# this one's room is open (made, or Play with anybody's): friends may come to its lobby
in_room = () -> bool: public or len(invite.room_code()) > 0

# on from the results: again (practice); with friends, or in a room, the host to the sides, the
# others to wait for the next fight (both with the results still up)
after_fight = ():
    global local, starts_at
    if mode == .practice and not in_room():
        local = new_game(local.pilots, local.skill)
        start_view()
        log_start("practice again")
    else if mode == .practice or s.me == 0:
        drop_gone()
        to_menu(if friends.len() > 0 or in_room(): LOBBY else: MAIN)
        starts_at = elapsed() + PUBLIC_WAIT
    else if host >= 0: to_menu(JOINED)
    else: leave()

game = () -> Game: if mode == .online: s.state else: local
before: Plane[]                 # (the planes a tick ago: drawn between then and now, smoothly)

# the game as drawn: its planes part of the way from the tick before to the latest
view = () -> Game:
    let g = game()
    a = f32(clamp(spare / DT, 0.0, 1.0))
    if before.len() != g.planes.len(): return g
    loop i in 0..g.planes.len():
        b = before[i]
        p = g.planes[i]
        if b.gone != p.gone or length(p.pos - b.pos) > 20.0: continue
        g.planes[i].pos = lerp(b.pos, p.pos, a)
        g.planes[i].rot = slerp(b.rot, p.rot, a)
    g
me = () -> int: mine

news: (str, f64, vec4, f64)[]   # what to say, how long it has shown, its color, its size

# the in-fight menu (Escape): practice waits; a fight with a friend goes on
paused = false
paused_at = -1.0
had_lock = false

resume = ():
    global paused, paused_at
    paused = false
    paused_at = -1.0
    if settings.mouse: mouse_lock(true)

# where the mouse points (flying with it): a way, turned by the mouse as a first-person view is
aim_yaw = 0.0
aim_pitch = 0.0
aim_fresh = true                # (start from the plane's nose, when it flies again)

aim_dir = () -> vec3: vec3(f32(-sin(aim_yaw) * cos(aim_pitch)), f32(sin(aim_pitch)), f32(-cos(aim_yaw) * cos(aim_pitch)))

aim_from = (p: Plane, later: bool):
    global aim_fresh, aim_pitch, aim_yaw
    aim_fresh = later
    if later: return
    f = fwd_of(p)
    aim_yaw = atan2(-f64(f.x), -f64(f.z))
    aim_pitch = asin(clamp(f64(f.y), -1.0, 1.0))

mouse_flying = () -> bool: settings.mouse and mode != .menu and not paused and is_mouse_locked() and not touch_input()
# (a phone: a finger dragged anywhere but on a button turns the aim, as the mouse does)
touch_flying = () -> bool: mode != .menu and not paused and touch_input()
steering = true                 # (the mouse or a finger steers, until keys or a stick do)
aim_steering = () -> bool: (mouse_flying() or touch_flying()) and steering

# this machine's controls for a tick (keys ease in, so a tap turns a little)
stick = vec3(0, 0, 0)           # pitch, roll, yaw

# the screen's layout: 1280 x 720 units on a screen wider than tall; a phone held upright (any
# screen taller than wide) 720 across and as tall as it is, 1280 at least. In update, before
# anything is drawn
upright = false
lay_out = ():
    global upright
    p = pixel_size()
    upright = p.y > p.x
    if upright: design_size(720, max(1280, int(720.0 * f64(p.y) / f64(max(p.x, 1.0)))))
    else: design_size(1280, 720)

# a place on the screen from its edges: x from the left (negative: from the right), y from the top
# (negative: from the bottom), whatever the screen's shape (clear of a phone's notch)
at_edge = (x: f64, y: f64) -> vec2:
    r = safe_rect()
    vec2(f32(if x >= 0.0: f64(r.x) + x else: f64(r.x + r.w) + x), f32(if y >= 0.0: f64(r.y) + y else: f64(r.y + r.h) + y))
# the middle of the screen
mid = () -> vec2:
    r = visible_rect()
    vec2(r.x + r.w / 2, r.y + r.h / 2)
# (the menus' column: on the left, the plane beside it; upright, across the middle)
column = () -> f64: if upright: f64(mid().x) else: 280.0

# (where STALL and the like show: below the gunsight; upright, where the plane is, above it)
alert_at = () -> vec2: mid() + vec2(0, if upright: -220.0 else: 110.0)

# a phone's buttons, for the right thumb (upright: the throttle's for the left one); the rest of
# the screen is for dragging the aim
fire_at = () -> vec2: at_edge(-150, -160)
look_button = () -> vec2: at_edge(-110, -330)
# (the throttle's slider: full at the top)
throttle_track = () -> Rect:
    a = at_edge(if upright: 80.0 else: -350.0, -400)
    Rect(a.x, a.y, 60, 290)
leave_box = () -> Rect:
    l = at_edge(-130, 20)
    Rect(l.x, l.y, 110, 40)
# (what a finger landing at t is on: 1 Fire, 2 the throttle, 4 Look, 5 Leave, 0 none)
button_at = (t: vec2) -> int:
    if length(t - fire_at()) < 90.0: return 1
    r = throttle_track()
    if contains(Rect(r.x - 30, r.y - 30, r.w + 60, r.h + 60), t): return 2
    if length(t - look_button()) < 55.0: return 4
    if contains(leave_box(), t): return 5
    0

# the fingers down (touch_ids), what each landed on (button_at) and where each was the frame
# before; what the buttons held say (throttle_want: where the finger on the throttle is, 0 to 1;
# -1 with none on it)
finger_ids: int[]
finger_on: int[]
finger_at: vec2[]
touch_fire = false
throttle_want = -1.0

my_pad = () -> Pad:
    global stick
    if bot: return Pad(computer = true)
    # (the in-fight menu open: its keys are the menu's)
    if paused: return Pad()
    pitch = action_axis("Dive", "Climb")
    if settings.invert: pitch = -pitch
    want = vec3(f32(pitch), f32(action_axis("Roll left", "Roll right")), f32(action_axis("Rudder left", "Rudder right")))
    c = Pad()
    c.fire = action_down("Fire")
    p = game().planes[me()]
    if aim_steering() and flying(p):
        # (the mouse or a finger: toward where it points, as the computer's pilot flies; keys
        # still win)
        t = steer(p, aim_dir())
        if abs(want.x) < 0.05: want.x = f32(f64(t.pitch) / 100.0)
        if abs(want.y) < 0.05: want.y = f32(f64(t.roll) / 100.0)
        if abs(want.z) < 0.05: want.z = f32(f64(t.yaw) / 100.0)
    if mouse_flying() and steering and flying(p): c.fire = c.fire or mouse_down(.left)
    if action_down("Throttle up"): c.throttle = 1
    if action_down("Throttle down"): c.throttle = -1
    if touch_fire: c.fire = true
    # (the throttle goes toward where the slider is held, a step a tick)
    if throttle_want >= 0.0:
        if throttle_want > p.throttle + 0.01: c.throttle = 1
        else if throttle_want < p.throttle - 0.01: c.throttle = -1
    stick = approach(stick, want, if aim_steering(): 30.0 else: 9.0, DT)
    c.pitch = int(round(clamp(f64(stick.x), -1.0, 1.0) * 100.0))
    c.roll = int(round(clamp(f64(stick.y), -1.0, 1.0) * 100.0))
    c.yaw = int(round(clamp(f64(stick.z), -1.0, 1.0) * 100.0))
    c

# the target: the other side's plane the HUD marks, and the camera looks at (C, or a phone's Look
# button, on and off)
target = -1
tracking = false

looking = () -> bool: tracking and aimable(game(), target)

# a plane to aim at: on the other side, there (and just shot down: still watched as it falls)
aimable = (g: Game, j: int) -> bool:
    if j < 0 or j >= g.planes.len(): return false
    o = g.planes[j]
    o.team != g.planes[me()].team and o.gone == 0 and o.down < 90

# the best target: the nearest of the other side's, the nearer the more ahead (after: the next
# one after it, in that order)
pick_target = (g: Game, after: int) -> int:
    p = g.planes[me()]
    f = normalize(cam_at - cam_pos)
    order: (f64, int)[]
    loop j in 0.. and o in g.planes:
        if o.team == p.team or not flying(o): continue
        d = o.pos - p.pos
        l = max(f64(length(d)), 1.0)
        order.push((l * (2.2 - f64(dot(f, d)) / l), j))
    if order.len() == 0: return -1
    order.sort_with((a, b): a.0 < b.0)
    loop k in 0.. and o in order:
        if o.1 == after: return order[(k + 1) % order.len()].1
    order[0].1

aim_at_target = ():
    global target, tracking
    g = game()
    if action_pressed("Next target"): target = pick_target(g, target)
    else if not aimable(g, target): target = pick_target(g, -1)
    if action_pressed("Look at the target"): tracking = not tracking

# (each frame: the buttons held, Look tapped, and how far the fingers on no button moved, in
# points)
read_fingers = () -> vec2:
    global finger_at, finger_ids, finger_on, throttle_want, touch_fire, tracking
    ids = touch_ids()
    ts = touches()
    on: int[]
    moved = vec2(0, 0)
    touch_fire = false
    throttle_want = -1.0
    loop k in 0.. and id in ids:
        j = finger_ids.index_of(id)
        b = if j >= 0: finger_on[j] else: if touch_flying(): button_at(ts[k]) else: -1
        if j < 0 and b == 4: tracking = not tracking
        if j >= 0 and b == 0: moved += ts[k] - finger_at[j]
        if b == 1: touch_fire = true
        else if b == 2:
            r = throttle_track()
            throttle_want = clamp(f64(r.y + r.h - ts[k].y) / f64(r.h), 0.0, 1.0)
        on.push(b)
    finger_ids = ids
    finger_on = on
    finger_at = ts
    moved / f32(css_pixel())

update = (dt: f64):
    global aim_pitch, before, had_lock, local, mine, paused, paused_at, spare, steering
    lay_out()
    dragged = read_fingers()
    loop e in net.receive(): on_net(e)
    log_frame()
    # (the menu's plane: one of this one's side, in the lobby)
    if mode == .menu: mine = if page == LOBBY: settings.side else: if page == JOINED: max(lobby_pilots.index_of(lobby_me), 0) % 2 else: 0
    # (friends who come by the room's code: let in while the sides are chosen, made to wait in a
    # fight; a public room's fight starts by itself)
    invite.room_busy(mode != .menu or friends.len() >= 2 * MOST - 1)
    if mode == .menu and page == LOBBY:
        loop c in invite.arrivals(): came(c.peer)
        if public and elapsed() >= starts_at and not invite.active(): start_fight()
    gone_quiet()
    tell()
    if mode != .menu:
        if key_pressed(.escape) or gamepad_pressed(.start):
            if not paused:
                paused = true
                mouse_lock(false)
            else if elapsed() - paused_at > 0.3: resume()
            if paused_at < 0.0: paused_at = elapsed()
        # (a browser lets go of the mouse on Escape: the in-fight menu)
        if is_mouse_locked(): had_lock = true
        else if had_lock and not paused:
            paused = true
            paused_at = elapsed()
        if not paused: paused_at = -1.0
        if paused: had_lock = false
        if paused and mode == .practice:
            sounds()
            return
        # (the keys or a stick take over from the mouse, the camera behind the plane again;
        # moving the mouse or dragging a finger gives it back, from where the nose points then)
        if abs(action_axis("Dive", "Climb")) + abs(action_axis("Roll left", "Roll right")) + abs(action_axis("Rudder left", "Rudder right")) > 0.05: steering = false
        if mouse_flying():
            d = mouse_delta()
            if length(d) > 2.0: steering = true
            k = 0.0025
            if steering:
                aim_yaw -= f64(d.x) * k
                aim_pitch = clamp(aim_pitch - f64(d.y) * k * (if settings.invert: -1.0 else: 1.0), -1.45, 1.45)
        if touch_flying():
            # (a drag across a phone's width, about 400 points: over a third of a turn)
            if length(dragged) > 1.0: steering = true
            k = 0.006
            if steering:
                aim_yaw -= f64(dragged.x) * k
                aim_pitch = clamp(aim_pitch - f64(dragged.y) * k * (if settings.invert: -1.0 else: 1.0), -1.45, 1.45)
        p = game().planes[me()]
        if not flying(p): aim_from(game().planes[me()], true)
        else if aim_fresh or not aim_steering(): aim_from(p, false)
    # (a public room's host: back to the sides by itself, 15 s after the end)
    if over() and (key_pressed(.enter) or gamepad_pressed(.a) or (public and game().tick - won_at > 900)):
        after_fight()
        return
    if mode != .menu: aim_at_target()
    # (ticks at 60 a second, whatever the frame rate)
    # (online, a machine that stopped a moment plays the ticks it missed, a quarter of a second at
    # most: given up, the others would wait for it)
    spare = min(spare + dt, if mode == .online: 0.25 else: 0.1)
    # (zones: timed for the log, see log_line)
    zone("ticks")
    loop spare >= DT:
        spare -= DT
        before = game().planes
        if mode == .online: s.play(my_pad())
        else if mode == .practice: local = tick(local, [my_pad()])
        else:
            local = tick(local, [])
            if local.winner >= 0: local = demo()
    zone_end()
    zone("effects", (): effects(dt))
    sounds()

# ---------------- what is seen ----------------
# the camera: behind the plane, banking with it (smoothly), or looking past it at the target
cam_q = vec4(0, 0, 0, 1)
cam_pos = vec3(0, 400, 0)
cam_at = vec3(0, 400, -10)
cam_up = vec3(0, 1, 0)
look_amount = 0.0
look_at_pos = vec3(0, 0, 0)
mouse_view = 0.0
cam_aim = vec3(0, 0, -1)
level_right = vec3(1, 0, 0)     # (the camera's roll locked: its right, kept while the plane points straight up or down)
won_at = 0

start_view = ():
    global before, cam_aim, cam_pos, cam_q, had_lock, look_amount, news, page, paused, target
    before = []
    p = game().planes[me()]
    cam_q = p.rot
    cam_pos = p.pos + quat_rotate(cam_q, vec3(0, 4.2, 15))
    aim_from(p, false)
    cam_aim = fwd_of(p)
    news = []
    paused = false
    had_lock = false
    page = MAIN
    target = -1
    look_amount = 0.0
    mouse_lock(settings.mouse and mode != .menu and not touch_input())

# the camera's field of view, up and down: 65 degrees on a screen wider than tall; on one taller
# than wide more, so that about as much shows across as up and down
view_fov = () -> f64:
    a = aspect_ratio()
    if a >= 1.0: return 65.0
    degrees(2.0 * atan(tan(radians(32.5)) / sqrt(a)))

place_camera = (g: Game, dt: f64):
    global cam_aim, cam_at, cam_pos, cam_q, cam_up, level_right, look_amount, look_at_pos, mouse_view
    p = g.planes[me()]
    look = looking()
    e = if look: g.planes[target] else: p
    if p.gone > 0:
        # (down: watching where it fell, from above)
        cam_at = approach(cam_at, p.pos, 3.0, dt)
        cam_pos = approach(cam_pos, p.pos + vec3(30, 40, 30), 0.6, dt)
        cam_up = approach(cam_up, vec3(0, 1, 0), 3.0, dt)
        camera3d(cam_pos, cam_at, view_fov(), 1.0, 7000.0, cam_up)
        return
    cam_q = slerp(cam_q, p.rot, f32(1.0 - exp(-6.0 * dt)))
    look_amount = approach(look_amount, if look: 1.0 else: 0.0, 8.0, dt)
    if look: look_at_pos = e.pos
    up = quat_rotate(cam_q, vec3(0, 1, 0))
    # (the menu: the plane on the right, beside it; upright, above it)
    side = if mode == .menu and not upright: f32(-7.0) else: f32(0.0)
    low = if mode == .menu and upright: f32(-24.0) else: f32(2.6)
    behind = p.pos + quat_rotate(cam_q, vec3(side, 4.2, 15))
    ahead = p.pos + quat_rotate(cam_q, vec3(side, low, -30))
    # (the roll locked: the same place behind, but square to the plane's heading and the sky)
    if settings.level:
        fwd = quat_rotate(cam_q, vec3(0, 0, -1))
        r = cross(fwd, vec3(0, 1, 0))
        if length(r) > 0.05: level_right = normalize(r)
        right = normalize(level_right - fwd * dot(level_right, fwd))
        up = cross(right, fwd)
        behind = p.pos + right * side + up * 4.2 - fwd * 15.0
        ahead = p.pos + right * side + up * low + fwd * 30.0
    # (flying with the mouse: the camera looks where it points, the horizon level)
    mouse_view = approach(mouse_view, if aim_steering(): 1.0 else: 0.0, 5.0, dt)
    # (a mouse's motion comes in uneven steps, frame to frame: the camera follows it smoothly)
    cam_aim = normalize(approach(cam_aim, aim_dir(), 25.0, dt))
    if mouse_view > 0.001:
        d = cam_aim
        k = f32(mouse_view)
        behind = lerp(behind, p.pos - d * 15.0 + vec3(0, 4.0, 0), k)
        ahead = lerp(ahead, p.pos + d * 40.0 + vec3(0, 2.5, 0), k)
        up = normalize(lerp(up, vec3(0, 1, 0), k))
    # (looking at the target: from behind this plane, along the line between them; on from where
    # it was when it went)
    to_e = normalize(look_at_pos - p.pos)
    past = p.pos - to_e * 15.0 + up * 4.0
    cam_pos = lerp(behind, past, f32(look_amount))
    cam_at = lerp(ahead, look_at_pos, f32(look_amount))
    cam_up = up
    gy = f32(ground(f64(cam_pos.x), f64(cam_pos.z)) + 2.0)
    if cam_pos.y < gy: cam_pos.y = gy
    camera3d(cam_pos, cam_at, view_fov(), 1.0, 7000.0, cam_up)

# ---------------- the models ----------------
# a body through rectangles across it, nose to tail: each (z, y of its middle, half width,
# half height); flat sides, as the planes of the time
loft = (vs: mut Vertex3D[], rings: vec4[], color: vec4):
    corners = (r: vec4) -> vec3[]: [vec3(-r.z, r.y + r.w, r.x), vec3(r.z, r.y + r.w, r.x), vec3(r.z, r.y - r.w, r.x), vec3(-r.z, r.y - r.w, r.x)]
    loop i in 0..rings.len() - 1:
        a = corners(rings[i])
        b = corners(rings[i + 1])
        mid = vec3(0, (rings[i].y + rings[i + 1].y) * 0.5, (rings[i].x + rings[i + 1].x) * 0.5)
        loop k in 0..4: quad(vs, a[k], a[(k + 1) % 4], b[(k + 1) % 4], b[k], color, mid)
    # (and its two ends)
    loop r in [rings[0], rings[rings.len() - 1]]:
        c = corners(r)
        quad(vs, c[0], c[1], c[2], c[3], color, vec3(0, r.y, (rings[0].x + rings[rings.len() - 1].x) * 0.5))

# a flat four-cornered face, facing away from `inside`
quad = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, d: vec3, color: vec4, inside: vec3):
    n = normalize(cross(b - a, c - a))
    if f64(dot(n, (a + c) * 0.5 - inside)) < 0.0: n = n * -1.0
    loop p in [a, b, c, a, c, d]: vs.push(Vertex3D(p, n, vec2(0, 0), color))

# the body's cross-section at z (between two of loft's rectangles), and how fast its half width
# changes there (a mark on its side lies on the slant)
ring_at = (rings: vec4[], z: f64) -> (vec4, f64):
    loop i in 0..rings.len() - 1:
        a = rings[i]
        b = rings[i + 1]
        if z <= f64(b.x) or i == rings.len() - 2:
            t = f32((z - f64(a.x)) / f64(b.x - a.x))
            return (lerp(a, b, t), f64(b.z - a.z) / f64(b.x - a.x))
    (rings[0], 0.0)

# a flat piece through pts (in order round it, in one plane, each seen from their middle), thick
# along n: a tailplane, a rudder
plate = (vs: mut Vertex3D[], pts: vec3[], n: vec3, thick: f64, color: vec4):
    mid = vec3(0, 0, 0)
    loop p in pts: mid += p
    mid = mid * f32(1.0 / f64(pts.len()))
    h = n * f32(thick / 2.0)
    loop i in 0..pts.len():
        a = pts[i]
        b = pts[(i + 1) % pts.len()]
        loop s in [1.0, -1.0]:
            o = h * f32(s)
            loop p in [mid + o, a + o, b + o]: vs.push(Vertex3D(p, n * f32(s), vec2(0, 0), color))
        quad(vs, a + h, b + h, b - h, a - h, color, mid)

# ---------------- markings: flat shapes (triangles, about 1 across) laid on a surface ----------------
quad2 = (a: vec2, b: vec2, c: vec2, d: vec2) -> vec2[]: [a, b, c, a, c, d]
box2 = (c: vec2, w: f64, h: f64) -> vec2[]:
    x = f32(w / 2.0)
    y = f32(h / 2.0)
    quad2(c + vec2(-x, -y), c + vec2(x, -y), c + vec2(x, y), c + vec2(-x, y))

disc2 = (c: vec2, r: f64, n: int = 18) -> vec2[]:
    t: vec2[]
    loop i in 0..n:
        a = TAU * f64(i) / f64(n)
        b = TAU * f64(i + 1) / f64(n)
        t.extend([c, c + vec2(f32(cos(a) * r), f32(sin(a) * r)), c + vec2(f32(cos(b) * r), f32(sin(b) * r))])
    t

star2 = (r: f64) -> vec2[]:
    t: vec2[]
    at = (k: int) -> vec2:
        a = PI / 2.0 + PI * f64(k) / 5.0
        l = if k % 2 == 0: r else: r * 0.42
        vec2(f32(cos(a) * l), f32(sin(a) * l))
    loop k in 0..10: t.extend([vec2(0, 0), at(k), at(k + 1)])
    t

# (a shape turned a quarter: its top toward +x)
turned = (t: vec2[]) -> vec2[]: t.map((p): vec2(p.y, -p.x))

WHITE_PAINT = rgb(0.95, 0.93, 0.86)
BLACK_PAINT = rgb(0.08, 0.08, 0.08)
YELLOW_PAINT = rgb(0.95, 0.75, 0.15)
NAVY = rgb(0.1, 0.14, 0.38)
ROUNDEL_RED = rgb(0.75, 0.1, 0.1)

# each side's own: Red's black cross edged in white, Blue's roundel (layers, the first underneath)
CROSS = [(box2(vec2(0, 0), 2.0, 0.64) + box2(vec2(0, 0), 0.64, 2.0), WHITE_PAINT), (box2(vec2(0, 0), 1.76, 0.4) + box2(vec2(0, 0), 0.4, 1.76), BLACK_PAINT)]
ROUNDEL = [(disc2(vec2(0, 0), 1.0, 24), NAVY), (disc2(vec2(0, 0), 0.66, 24), WHITE_PAINT), (disc2(vec2(0, 0), 0.33, 18), ROUNDEL_RED)]

# a player's own insignia (BADGES; the computer's planes have none)
const NOSE = 2
const TAIL = 7
const MAW_BADGE = 9
const FACE_BADGE = 11
CHEVRON = quad2(vec2(-1.0, -0.6), vec2(0.0, 0.4), vec2(0.0, 0.85), vec2(-1.0, -0.15)) + quad2(vec2(1.0, -0.6), vec2(0.0, 0.4), vec2(0.0, 0.85), vec2(1.0, -0.15))
SKULL = [(disc2(vec2(0, 0.15), 0.62, 16) + box2(vec2(0, -0.45), 0.7, 0.5), WHITE_PAINT),
         (disc2(vec2(-0.24, 0.12), 0.17, 8) + disc2(vec2(0.24, 0.12), 0.17, 8) + [vec2(0, -0.08), vec2(-0.09, -0.24), vec2(0.09, -0.24)] + box2(vec2(-0.12, -0.56), 0.06, 0.28) + box2(vec2(0.12, -0.56), 0.06, 0.28), BLACK_PAINT)]
# (a shape moved, made larger, and turned by a radians)
placed = (t: vec2[], at: vec2, k: f64, a: f64 = 0.0) -> vec2[]:
    c = f32(cos(a) * k)
    sn = f32(sin(a) * k)
    t.map((p): at + vec2(p.x * c - p.y * sn, p.x * sn + p.y * c))
# (a shape round its middle: pts in order round it, each seen from their middle)
poly2 = (pts: vec2[]) -> vec2[]:
    mid = vec2(0, 0)
    loop p in pts: mid += p
    mid = mid * f32(1.0 / f64(pts.len()))
    t: vec2[]
    loop i in 0..pts.len(): t.extend([mid, pts[i], pts[(i + 1) % pts.len()]])
    t
# (a band from a to b, w wide)
band2 = (a: vec2, b: vec2, w: f64) -> vec2[]:
    d = normalize(b - a)
    n = vec2(-d.y, d.x) * f32(w / 2.0)
    quad2(a - n, b - n, b + n, a + n)
ring2 = (r0: f64, r1: f64, n: int = 24) -> vec2[]:
    t: vec2[]
    at = (i: int, r: f64) -> vec2: vec2(f32(cos(TAU * f64(i) / f64(n)) * r), f32(sin(TAU * f64(i) / f64(n)) * r))
    loop i in 0..n: t.extend(quad2(at(i, r0), at(i, r1), at(i + 1, r1), at(i + 1, r0)))
    t
heart2 = () -> vec2[]: disc2(vec2(-0.27, 0.18), 0.33) + disc2(vec2(0.27, 0.18), 0.33) + [vec2(-0.585, 0.08), vec2(0.585, 0.08), vec2(0, -0.72)]

# the 94th Aero Squadron's (Rickenbacker's): Uncle Sam's hat thrown through a ring
hat = () -> (vec2[], vec4)[]:
    lean = -0.4
    on = (t: vec2[]) -> vec2[]: placed(t, vec2(0.08, 0.05), 1.0, lean)
    stripes: vec2[]
    loop k in 0..3: stripes.extend(box2(vec2(f32(-0.2 + 0.2 * f64(k)), 0.18), 0.1, 0.62))
    [(ring2(0.66, 1.04), WHITE_PAINT), (ring2(0.72, 0.98), ROUNDEL_RED), (on(box2(vec2(0, 0.18), 0.6, 0.62)), WHITE_PAINT), (on(stripes), ROUNDEL_RED),
     (on(box2(vec2(0, -0.08), 0.62, 0.17) + box2(vec2(0, -0.2), 1.05, 0.09)), NAVY), (on(placed(star2(1.0), vec2(0, -0.08), 0.07)), WHITE_PAINT)]
HAT = hat()

# a shark's mouth, open wide, and its eye, along the side toward the nose (+x)
maw = () -> (vec2[], vec4)[]:
    top = [vec2(-1.0, 0), vec2(-0.3, 0.22), vec2(0.4, 0.4), vec2(0.85, 0.48)]
    bottom = [vec2(0.95, -0.44), vec2(0.4, -0.5), vec2(-0.3, -0.27)]
    mouth = top + [vec2(1.0, 0.28), vec2(1.02, -0.08)] + bottom
    # (teeth along each lip, pointing in, larger toward the front)
    teeth: vec2[]
    lip = (a: vec2, b: vec2, n: int, dir: f32):
        loop i in 0..n:
            t0 = f32(f64(i) / f64(n))
            t1 = f32(f64(i + 1) / f64(n))
            p = lerp(a, b, t0)
            q = lerp(a, b, t1)
            teeth.extend([p, q, lerp(p, q, 0.5) + vec2(0, dir * f32(0.07 + 0.14 * f64(t1)))])
    loop i in 0..top.len() - 1: lip(top[i], top[i + 1], 3, -1.0)
    lip(vec2(-1.0, 0), bottom[2], 3, 1.0)
    lip(bottom[2], bottom[1], 3, 1.0)
    lip(bottom[1], bottom[0], 3, 1.0)
    [(poly2(mouth.map((p): (p - vec2(0.1, 0)) * 1.1 + vec2(0.1, 0))), BLACK_PAINT), (poly2(mouth), rgb(0.55, 0.04, 0.06)), (teeth, WHITE_PAINT),
     (disc2(vec2(0.2, 0.56), 0.13, 14), WHITE_PAINT), (disc2(vec2(0.24, 0.56), 0.07, 10), BLACK_PAINT)]
MAW = maw()

# Nungesser's: a black heart edged in white, and in it a skull over a coffin and two candles
nungesser = () -> (vec2[], vec4)[]:
    coffin = poly2([vec2(-0.07, -0.5), vec2(0.07, -0.5), vec2(0.11, -0.24), vec2(0.07, -0.12), vec2(-0.07, -0.12), vec2(-0.11, -0.24)])
    candles = box2(vec2(-0.24, -0.3), 0.05, 0.2) + box2(vec2(0.24, -0.3), 0.05, 0.2)
    [(placed(heart2(), vec2(0, -0.04), 1.12), WHITE_PAINT), (heart2(), BLACK_PAINT), (placed(SKULL[0].0, vec2(0, 0.2), 0.26) + coffin + candles, WHITE_PAINT),
     (placed(SKULL[1].0, vec2(0, 0.2), 0.26), BLACK_PAINT), (disc2(vec2(-0.24, -0.17), 0.04, 8) + disc2(vec2(0.24, -0.17), 0.04, 8), YELLOW_PAINT)]
HEART = nungesser()

# Werner Voss's: a face on the cowling's front, yellow, frowning, with a moustache (x across)
voss = () -> (vec2[], vec4)[]:
    eyes = disc2(vec2(-0.36, 0.3), 0.2, 14) + disc2(vec2(0.36, 0.3), 0.2, 14)
    dark = disc2(vec2(-0.33, 0.27), 0.1, 10) + disc2(vec2(0.33, 0.27), 0.1, 10)
    dark.extend(band2(vec2(-0.12, 0.5), vec2(-0.62, 0.66), 0.09) + band2(vec2(0.12, 0.5), vec2(0.62, 0.66), 0.09))
    loop s in [-1.0, 1.0]:
        x = f32(s)
        dark.extend(band2(vec2(0, -0.2), vec2(0.35 * x, -0.3), 0.14) + band2(vec2(0.33 * x, -0.29), vec2(0.6 * x, -0.2), 0.11) + band2(vec2(0.58 * x, -0.21), vec2(0.66 * x, -0.06), 0.08))
    [(disc2(vec2(0, 0), 1.0, 24), YELLOW_PAINT), (eyes, WHITE_PAINT), (dark, BLACK_PAINT), (box2(vec2(0, -0.5), 0.3, 0.08), ROUNDEL_RED)]
FACE = voss()

# the Escadrille des Cigognes' (Guynemer's): a stork flying, toward the nose (+x)
stork = () -> (vec2[], vec4)[]:
    legs = rgb(0.85, 0.35, 0.12)
    white = poly2([vec2(-0.42, 0), vec2(-0.2, 0.1), vec2(0.25, 0.08), vec2(0.32, 0), vec2(0.2, -0.08), vec2(-0.25, -0.08)])
    white.extend(band2(vec2(0.25, 0.03), vec2(0.66, 0.14), 0.07) + disc2(vec2(0.68, 0.14), 0.07, 10))
    white.extend(poly2([vec2(-0.2, 0.05), vec2(0.18, 0.06), vec2(0.06, 0.62), vec2(-0.32, 0.66)]) + poly2([vec2(-0.2, -0.05), vec2(0.15, -0.05), vec2(0.0, -0.55), vec2(-0.34, -0.5)]))
    tips = poly2([vec2(-0.32, 0.66), vec2(0.06, 0.62), vec2(0.0, 0.9), vec2(-0.45, 0.92)]) + poly2([vec2(-0.34, -0.5), vec2(0.0, -0.55), vec2(-0.08, -0.8), vec2(-0.5, -0.74)])
    beak = [vec2(0.72, 0.17), vec2(0.72, 0.1), vec2(1.0, 0.09)] + band2(vec2(-0.35, -0.02), vec2(-0.98, -0.1), 0.035) + band2(vec2(-0.35, -0.05), vec2(-0.98, -0.17), 0.035)
    [(white, WHITE_PAINT), (tips, BLACK_PAINT), (beak, legs)]
STORK = stork()

# the ace of spades: a playing card
spade = () -> (vec2[], vec4)[]:
    pip = placed(heart2(), vec2(0, 0.1), 0.55, PI) + [vec2(0, 0.0), vec2(-0.13, -0.36), vec2(0.13, -0.36)]
    [(box2(vec2(0, 0), 0.84, 1.16), BLACK_PAINT), (box2(vec2(0, 0), 0.76, 1.08), WHITE_PAINT), (pip, BLACK_PAINT)]
SPADE = spade()

# (a bolt along the side, from the tail to the nose: +x)
bolt = () -> vec2[]:
    t = 0.11
    seg = (a: vec2, b: vec2) -> vec2[]: quad2(a + vec2(0, -t), b + vec2(0, -t), b + vec2(0, t), a + vec2(0, t))
    seg(vec2(-1.0, -0.05), vec2(0.1, 0.22)) + quad2(vec2(0.1 - t, 0.22 + t), vec2(0.1 + t, 0.22 - t), vec2(-0.05 + t, -0.2 - t), vec2(-0.05 - t, -0.2 + t)) + seg(vec2(-0.05, -0.2), vec2(1.0, 0.02))
BOLT = bolt()

# marking layers laid on a surface at `at`, facing n: the shapes' x along u, y along v, size
# across (each layer a little above the one before)
mark = (vs: mut Vertex3D[], layers: (vec2[], vec4)[], at: vec3, u: vec3, v: vec3, n: vec3, size: f64):
    loop k in 0.. and l in layers:
        o = at + n * f32(0.012 + 0.006 * f64(k))
        loop p in l.0: vs.push(Vertex3D(o + u * f32(f64(p.x) * size) + v * f32(f64(p.y) * size), n, vec2(0, 0), l.1))

on_top = (vs: mut Vertex3D[], layers: (vec2[], vec4)[], at: vec3, size: f64): mark(vs, layers, at, vec3(1, 0, 0), vec3(0, 0, -1), vec3(0, 1, 0), size)
underneath = (vs: mut Vertex3D[], layers: (vec2[], vec4)[], at: vec3, size: f64): mark(vs, layers, at, vec3(1, 0, 0), vec3(0, 0, -1), vec3(0, -1, 0), size)

# (triangles cut in four, n times over: a shape laid on a curve bends with it)
finer = (t: vec2[], n: int) -> vec2[]:
    out = t
    loop _ in 0..n:
        cut: vec2[]
        loop i in 0..out.len() / 3:
            a = out[3 * i]
            b = out[3 * i + 1]
            c = out[3 * i + 2]
            ab = (a + b) * 0.5
            bc = (b + c) * 0.5
            ca = (c + a) * 0.5
            cut.extend([a, ab, ca, ab, b, bc, ca, bc, c, ab, bc, ca])
        out = cut
    out

# along both sides, each point on the surface (at(z, y): the side's x there, and the way it faces
# on the right): from the body's tail end to a round cowling (x toward the nose, from z, y)
along_sides = (vs: mut Vertex3D[], layers: (vec2[], vec4)[], at: (f64, f64) -> (f64, vec3), z: f64, y: f64, size: f64):
    loop s in [1.0, -1.0]:
        loop k in 0.. and l in layers:
            lift = f32(0.014 + 0.006 * f64(k))
            loop p in finer(l.0, 2):
                pz = z - f64(p.x) * size
                py = y + f64(p.y) * size
                h = at(pz, py)
                n = vec3(f32(s) * h.1.x, h.1.y, h.1.z)
                vs.push(Vertex3D(vec3(f32(s * h.0), f32(py), f32(pz)) + n * lift, n, vec2(0, 0), l.1))

# a lofted body's flat side at z
flat_side = (rings: vec4[], z: f64) -> (f64, vec3):
    r = ring_at(rings, z)
    (f64(r.0.z), normalize(vec3(1, 0, f32(-r.1))))

# on both sides of the body at z (x toward the nose, y up)
on_sides = (vs: mut Vertex3D[], layers: (vec2[], vec4)[], rings: vec4[], z: f64, size: f64):
    r = ring_at(rings, z)
    loop s in [1.0, -1.0]:
        n = normalize(vec3(f32(s), 0, f32(-r.1)))
        u = normalize(vec3(f32(-s * r.1), 0, -1))
        mark(vs, layers, vec3(f32(s * f64(r.0.z)), r.0.y, f32(z)), u, vec3(0, 1, 0), n, size)

# the pilot's insignia, on the body (at z: the front of the tail part) and the top wing's middle
# (at y, z); bands go round the body
own_mark = (vs: mut Vertex3D[], badge: int, rings: vec4[], z: f64, wing: vec3):
    one = (shape: vec2[]) -> (vec2[], vec4)[]: [(shape, WHITE_PAINT)]
    if badge == 1:
        loop c in [z + 0.55, z + 0.85]:
            a = ring_at(rings, c - 0.07).0
            b = ring_at(rings, c + 0.07).0
            loft(vs, [vec4(a.x, a.y, a.z + 0.012, a.w + 0.012), vec4(b.x, b.y, b.z + 0.012, b.w + 0.012)], WHITE_PAINT)
    else if badge == 3:
        on_sides(vs, one(turned(CHEVRON)), rings, z, 0.26)
        on_top(vs, one(CHEVRON), wing, 0.45)
    else if badge == 4:
        on_sides(vs, one(star2(1.0)), rings, z, 0.3)
        on_top(vs, one(star2(1.0)), wing, 0.45)
    else if badge == 5:
        on_sides(vs, SKULL, rings, z, 0.3)
        on_top(vs, SKULL, wing, 0.4)
    else if badge == 6: on_sides(vs, [(BOLT, YELLOW_PAINT)], rings, z - 0.3, 0.55)
    else if badge == 8:
        on_sides(vs, HAT, rings, z, 0.34)
        on_top(vs, HAT, wing, 0.48)
    else if badge == 10:
        on_sides(vs, HEART, rings, z, 0.36)
        on_top(vs, HEART, wing, 0.5)
    else if badge == 12:
        on_sides(vs, STORK, rings, z - 0.1, 0.42)
        on_top(vs, STORK.map((l): (turned(l.0), l.1)), wing, 0.5)
    else if badge == 13:
        on_sides(vs, SPADE, rings, z, 0.3)
        on_top(vs, SPADE, wing, 0.42)

# what both have: the cockpit and its pilot, the guns, the wheels
common = (vs: mut Vertex3D[], gun_y: f64):
    dark = rgb(0.12, 0.11, 0.1)
    wood = rgb(0.45, 0.32, 0.2)
    loop sx in [-1.0, 1.0]:
        x = f32(sx)
        add_box(vs, vec3(0.17 * x, f32(gun_y), -1.7), vec3(0.08, 0.08, 1.1), dark)
        add_box(vs, vec3(0.7 * x, -0.85, -1.4), vec3(0.07, 0.9, 0.07), dark)
        add_cylinder(vs, vec3(-1.3, f32(-sx * 0.95 - 0.07), -1.4), 0.33, 0.14, dark, 10, transform = rotation_z(PI / 2.0))
    add_box(vs, vec3(0, -1.3, -1.4), vec3(1.5, 0.05, 0.05), dark)
    add_box(vs, vec3(0, 0.58, 0.35), vec3(0.62, 0.1, 0.9), dark)
    add_sphere(vs, vec3(0, 0.8, 0.55), 0.2, wood, 8, 5)
    add_box(vs, vec3(0, 0.75, -0.15), vec3(0.4, 0.22, 0.03), rgb(0.6, 0.7, 0.75))

BI_BODY = [vec4(-2.3, 0.05, 0.5, 0.5), vec4(-0.6, 0.1, 0.48, 0.52), vec4(1.2, 0.15, 0.32, 0.38), vec4(3.9, 0.25, 0.06, 0.1)]
TRI_BODY = [vec4(-2.2, 0.05, 0.47, 0.49), vec4(-0.6, 0.1, 0.45, 0.5), vec4(1.2, 0.15, 0.3, 0.36), vec4(3.75, 0.25, 0.05, 0.08)]

# Blue's biplane, nose toward -z: a metal nose, two long wings, roundels, the rudder striped
make_biplane = (badge: int) -> Mesh:
    vs: Vertex3D[]
    body = rgb(0.15, 0.3, 0.62)
    wings = rgb(0.22, 0.42, 0.76)
    dark = rgb(0.12, 0.11, 0.1)
    wood = rgb(0.45, 0.32, 0.2)
    tail = if badge == TAIL: YELLOW_PAINT else: wings
    loft(vs, [vec4(-2.9, 0.05, 0.42, 0.42), vec4(-2.3, 0.05, 0.5, 0.5)], if badge == NOSE or badge == FACE_BADGE: YELLOW_PAINT else: rgb(0.42, 0.42, 0.4))
    loft(vs, BI_BODY, body)
    add_box(vs, vec3(0, 0.05, -2.92), vec3(0.6, 0.6, 0.04), dark)
    add_box(vs, vec3(0, 1.35, -0.9), vec3(8.8, 0.12, 1.5), wings)
    add_box(vs, vec3(0, -0.45, -0.7), vec3(8.0, 0.12, 1.35), wings)
    loop sx in [-1.0, 1.0]:
        x = f32(sx)
        # struts between the wings, and up to the top one from the body
        add_box(vs, vec3(3.0 * x, 0.45, -1.3), vec3(0.07, 1.75, 0.07), wood)
        add_box(vs, vec3(3.0 * x, 0.45, -0.4), vec3(0.07, 1.75, 0.07), wood)
        add_box(vs, vec3(0.42 * x, 0.92, -1.35), vec3(0.06, 0.8, 0.06), wood)
        add_box(vs, vec3(0.42 * x, 0.92, -0.55), vec3(0.06, 0.8, 0.06), wood)
        on_top(vs, ROUNDEL, vec3(3.1 * x, 1.41, -0.9), 0.6)
        underneath(vs, ROUNDEL, vec3(2.8 * x, -0.51, -0.7), 0.55)
    common(vs, 0.6)
    on_sides(vs, ROUNDEL, BI_BODY, 2.15, 0.24)
    # the tail: the fin, and the rudder in the roundel's colors
    add_box(vs, vec3(0, 0.25, 3.45), vec3(3.0, 0.07, 1.0), tail)
    add_box(vs, vec3(0, 0.75, 3.25), vec3(0.07, 1.1, 0.4), tail)
    loop k in 0.. and c in [NAVY, WHITE_PAINT, ROUNDEL_RED]: add_box(vs, vec3(0, 0.75, f32(3.55 + 0.2 * f64(k))), vec3(0.075, 1.1, 0.2), c)
    add_box(vs, vec3(0, -0.2, 3.6), vec3(0.06, 0.5, 0.06), dark)
    own_mark(vs, badge, BI_BODY, 0.85, vec3(0, 1.41, -0.9))
    nose = [vec4(-2.9, 0.05, 0.42, 0.42)] + BI_BODY
    if badge == MAW_BADGE: along_sides(vs, MAW, (z: f64, y: f64): flat_side(nose, z), -2.9 + 1.02 * 0.66, 0.05, 0.66)
    if badge == FACE_BADGE: mark(vs, FACE, vec3(0, 0.05, -2.94), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, 0, -1), 0.42)
    custom_mesh(vs)

# Red's triplane (as the Fokker Dr.I): a rotary engine's round cowling, three short wings one
# over another, single struts through them, a white comma of a rudder; black crosses
make_triplane = (badge: int) -> Mesh:
    vs: Vertex3D[]
    body = rgb(0.72, 0.1, 0.08)
    wings = rgb(0.78, 0.15, 0.1)
    dark = rgb(0.12, 0.11, 0.1)
    wood = rgb(0.45, 0.32, 0.2)
    nose = if badge == NOSE or badge == FACE_BADGE: YELLOW_PAINT else: body
    # the cowling, open at the front on the engine
    add_cylinder(vs, vec3(0, 0, 0), 0.56, 0.74, nose, 18, 0.5, translation(vec3(0, 0.05, -2.18)) * rotation_x(-PI / 2.0))
    add_cylinder(vs, vec3(0, 0, 0), 0.42, 0.03, dark, 14, -1.0, translation(vec3(0, 0.05, -2.91)) * rotation_x(-PI / 2.0))
    loft(vs, TRI_BODY, body)
    add_box(vs, vec3(0, 1.45, -1.05), vec3(7.6, 0.11, 1.05), wings)
    add_box(vs, vec3(0, 0.55, -0.95), vec3(6.8, 0.11, 1.05), wings)
    add_box(vs, vec3(0, -0.42, -0.85), vec3(6.2, 0.11, 1.05), wings)
    loop sx in [-1.0, 1.0]:
        x = f32(sx)
        add_box(vs, vec3(2.7 * x, 0.52, -0.95), vec3(0.07, 1.9, 0.3), wood)
        add_box(vs, vec3(0.38 * x, 1.0, -1.35), vec3(0.06, 0.9, 0.06), wood)
        add_box(vs, vec3(0.38 * x, 1.0, -0.7), vec3(0.06, 0.9, 0.06), wood)
        on_top(vs, CROSS, vec3(2.85 * x, 1.505, -1.05), 0.45)
        underneath(vs, CROSS, vec3(2.45 * x, -0.475, -0.85), 0.42)
    common(vs, 0.72)
    # (a little wing on the wheels' axle)
    add_box(vs, vec3(0, -1.3, -1.4), vec3(1.7, 0.07, 0.42), wings)
    on_sides(vs, CROSS, TRI_BODY, 2.15, 0.22)
    # the tail: a tailplane swept back from a point, the rudder round, and the skid
    plate(vs, [vec3(0, 0.27, 2.85), vec3(1.55, 0.27, 3.45), vec3(1.45, 0.27, 3.85), vec3(-1.45, 0.27, 3.85), vec3(-1.55, 0.27, 3.45)], vec3(0, 1, 0), 0.06, if badge == TAIL: YELLOW_PAINT else: wings)
    comma = [vec2(-0.25, 3.72), vec2(0.2, 3.62), vec2(0.6, 3.55), vec2(0.95, 3.55), vec2(1.18, 3.68), vec2(1.28, 3.9), vec2(1.22, 4.12), vec2(1.02, 4.28), vec2(0.72, 4.32), vec2(0.35, 4.2), vec2(0.05, 4.0), vec2(-0.15, 3.85)]
    plate(vs, comma.map((p): vec3(0, p.x, p.y)), vec3(1, 0, 0), 0.06, if badge == TAIL: YELLOW_PAINT else: WHITE_PAINT)
    loop s in [1.0, -1.0]: mark(vs, CROSS, vec3(f32(0.03 * s), 0.78, 3.93), vec3(0, 0, -1), vec3(0, 1, 0), vec3(f32(s), 0, 0), 0.3)
    add_box(vs, vec3(0, -0.15, 3.5), vec3(0.06, 0.45, 0.06), dark)
    own_mark(vs, badge, TRI_BODY, 0.85, vec3(0, 1.505, -1.05))
    # (the mouth from the cowling's front edge, round it, back along the body)
    cowl = (z: f64, y: f64) -> (f64, vec3):
        if z > -2.18: return flat_side(TRI_BODY, z)
        r = 0.56 - 0.06 * clamp((-2.18 - z) / 0.74, 0.0, 1.0)
        dy = clamp((y - 0.05) / r, -0.95, 0.95)
        c = sqrt(1.0 - dy * dy)
        (r * c, vec3(f32(c), f32(dy), 0))
    if badge == MAW_BADGE: along_sides(vs, MAW, cowl, -2.9 + 1.02 * 0.66, 0.05, 0.66)
    if badge == FACE_BADGE: mark(vs, FACE, vec3(0, 0.05, -2.94), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, 0, -1), 0.5)
    custom_mesh(vs)

# each side's plane with each insignia, made when first drawn
plane_meshes: {int: Mesh} = {}
plane_mesh = (team: int, badge: int) -> Mesh:
    key = team * 64 + badge
    if let m = plane_meshes.get(key): return m
    m = if team == 0: make_triplane(badge) else: make_biplane(badge)
    plane_meshes[key] = m
    m

make_propeller = () -> Mesh:
    vs: Vertex3D[]
    wood = rgb(0.5, 0.36, 0.22)
    add_box(vs, vec3(0, 0.6, 0), vec3(0.17, 1.2, 0.05), wood, rotation_y(0.3))
    add_box(vs, vec3(0, -0.6, 0), vec3(0.17, 1.2, 0.05), wood, rotation_y(-0.3))
    add_box(vs, vec3(0, 0, 0), vec3(0.2, 0.2, 0.2), rgb(0.3, 0.3, 0.3))
    custom_mesh(vs)

# the ground as flat triangles, each cell colored: fields, woods, the river's banks, rock, snow
woods = (x: f64, z: f64) -> bool: sin(x * 0.006 + 0.5) * sin(z * 0.0071 + 1.0) + 0.5 * sin(x * 0.017 - z * 0.013) > 0.75

field_color = (xi: int, zi: int, h: f64, n: vec3) -> vec4:
    v = f32(0.94 + 0.06 * f64(hash(xi * 7919 + zi * 104729) % 100) / 100.0)
    if h < 1.5: return vec4(rgb(0.6, 0.56, 0.42).xyz * v, 1)
    if h > 380.0 and n.y > 0.7: return vec4(rgb(0.92, 0.93, 0.95).xyz * v, 1)
    if h > 230.0 or n.y < 0.8: return vec4(rgb(0.47, 0.45, 0.4).xyz * v, 1)
    x = f64(xi) * CELL - MAP / 2.0
    z = f64(zi) * CELL - MAP / 2.0
    if woods(x, z): return vec4(rgb(0.19, 0.33, 0.16).xyz * v, 1)
    fields = [rgb(0.38, 0.55, 0.25), rgb(0.46, 0.6, 0.27), rgb(0.74, 0.66, 0.34), rgb(0.5, 0.39, 0.26), rgb(0.55, 0.64, 0.31), rgb(0.42, 0.5, 0.24)]
    f = fields[int(hash((xi / 3) * 31 + (zi / 3) * 1009) % u64(fields.len()))]
    vec4(f.xyz * v, 1)

make_ground = () -> Mesh:
    vs: Vertex3D[]
    pt = (xi: int, zi: int) -> vec3: vec3(f32(f64(xi) * CELL - MAP / 2.0), f32(corner(xi, zi)), f32(f64(zi) * CELL - MAP / 2.0))
    tri = (a: vec3, b: vec3, c: vec3, col: vec4):
        n = normalize(cross(b - a, c - a))
        if n.y < 0.0: n = n * -1.0
        vs.push(Vertex3D(a, n, vec2(0, 0), col))
        vs.push(Vertex3D(b, n, vec2(0, 0), col))
        vs.push(Vertex3D(c, n, vec2(0, 0), col))
    loop zi in 0..CELLS:
        loop xi in 0..CELLS:
            a = pt(xi, zi)
            b = pt(xi, zi + 1)
            c = pt(xi + 1, zi)
            d = pt(xi + 1, zi + 1)
            h = f64(a.y + b.y + c.y + d.y) * 0.25
            n = normalize(cross(b - a, c - a))
            if n.y < 0.0: n = n * -1.0
            col = field_color(xi, zi, h, n)
            # (split as ground() reads it)
            tri(a, b, c, col)
            tri(c, b, d, col)
    custom_mesh(vs)

# villages by the river: white houses with dark red roofs, a church
make_villages = () -> Mesh:
    vs: Vertex3D[]
    loop v in 0..7:
        z = -1700.0 + f64(v) * 560.0 + f64(hash(v * 3) % 200)
        x = river_x(z) + (if v % 2 == 0: 330.0 else: -330.0)
        loop k in 0..12:
            hx = x + f64(hash(v * 100 + k) % 160) - 80.0
            hz = z + f64(hash(v * 100 + k + 50) % 160) - 80.0
            gy = ground(hx, hz)
            if gy < 2.0: continue
            turn = rotation_y(f64(hash(v * 100 + k + 7) % 4) * PI / 2.0)
            at = translation(vec3(f32(hx), f32(gy), f32(hz))) * turn
            add_box(vs, vec3(0, 2.5, 0), vec3(6, 5, 9), rgb(0.9, 0.87, 0.8), at)
            add_box(vs, vec3(0, 5.0, 0), vec3(4.6, 4.6, 9.4), rgb(0.55, 0.2, 0.15), at * translation(vec3(0, 0.4, 0)) * rotation_z(PI / 4.0))
        if v % 3 == 0:
            gy = ground(x, z)
            at = translation(vec3(f32(x), f32(gy), f32(z)))
            add_box(vs, vec3(0, 6, 0), vec3(4, 12, 4), rgb(0.85, 0.83, 0.78), at)
            add_cylinder(vs, vec3(0, 12, 0), 2.9, 7.0, rgb(0.35, 0.37, 0.4), 4, 0.0, at * rotation_y(PI / 4.0))
    custom_mesh(vs)

trees: Instance3D[]
clouds: Instance3D[]

plant = ():
    loop zi in 0..CELLS:
        loop xi in 0..CELLS:
            x = f64(xi) * CELL - MAP / 2.0
            z = f64(zi) * CELL - MAP / 2.0
            if not woods(x, z): continue
            loop k in 0..3:
                h = hash(xi * 131 + zi * 7177 + k * 31)
                tx = x + f64(h % 50)
                tz = z + f64((h >> 8) % 50)
                gy = ground(tx, tz)
                if gy < 2.0 or gy > 230.0: continue
                sz = 0.8 + f64((h >> 16) % 60) / 100.0
                trees.push(instance(translation(vec3(f32(tx), f32(gy - 1.0), f32(tz))) * scaling(vec3(f32(4.0 * sz), f32(11.0 * sz), f32(4.0 * sz))), rgb(0.14, f32(0.3 + f64((h >> 24) % 10) / 100.0), 0.13)))
    loop c in 0..55:
        h = hash(c * 977 + 5)
        cx = f64(h % 5000) - 2500.0
        cz = f64((h >> 16) % 5000) - 2500.0
        cy = 520.0 + f64((h >> 32) % 300)
        loop k in 0..6:
            hk = hash(c * 31 + k)
            r = 25.0 + f64(hk % 25)
            p = vec3(f32(cx + f64((hk >> 8) % 120) - 60.0), f32(cy + f64((hk >> 16) % 20)), f32(cz + f64((hk >> 24) % 90) - 45.0))
            clouds.push(instance(translation(p) * scaling(vec3(f32(r * 1.4), f32(r * 0.7), f32(r))), rgb(1, 1, 1)))

COLORS = [rgb(1.0, 0.38, 0.32), rgb(0.42, 0.68, 1.0)]
prop = Mesh()
ground_mesh = Mesh()
villages = Mesh()
water = Mesh()
cone = Mesh()
puff = Mesh()
tracer = Mesh()
kept_trees = InstanceBuffer[Instance3D]()
kept_clouds = InstanceBuffer[Instance3D]()
made = false

make_world = ():
    global cone, ground_mesh, kept_clouds, kept_trees, made, prop, puff, tracer, villages, water
    if made: return
    made = true
    prop = make_propeller()
    ground_mesh = make_ground()
    villages = make_villages()
    water = plane_mesh(MAP)
    cone = cone_mesh(1.0, 1.0, 6)
    puff = sphere_mesh(1.0, 10, 6)
    tracer = cube_mesh(1.0)
    plant()
    # (on the GPU once: they never move)
    kept_trees = instance_buffer(trees)
    kept_clouds = instance_buffer(clouds)

prop_turn: f64[]

plane_matrix = (p: Plane) -> mat4: translation(p.pos) * quat_to_mat4(p.rot)

draw = ():
    make_world()
    g = view()
    place_camera(g, frame_time())
    clear(BLACK)
    sun(vec3(-0.4, 0.8, 0.45), vec3(1.0, 0.95, 0.85))
    sky(vec3(0.3, 0.5, 0.85), vec3(0.78, 0.84, 0.92), vec3(0.42, 0.45, 0.4))
    fog(vec3(0.74, 0.8, 0.88), 0.00025, 0.0015)
    shadows(true, 0.6, 40.0)
    post_effects(0.4, 0.8, 0.3, 1.05)
    draw_mesh(ground_mesh, specular = 0.02, cast_shadow = false)
    draw_mesh(water, translation(vec3(0, 0.3, 0)), rgb(0.25, 0.42, 0.55), specular = 0.8, cast_shadow = false)
    draw_mesh(villages, specular = 0.05)
    draw_mesh_instanced(cone, kept_trees, specular = 0.02, cast_shadow = false)
    draw_mesh_instanced(puff, kept_clouds, emissive = 0.35, specular = 0.0, cast_shadow = false)
    loop prop_turn.len() < g.planes.len(): prop_turn.push(0.0)
    loop i in 0.. and p in g.planes:
        if p.gone > 0: continue
        m = plane_matrix(p)
        c = vec4(1, 1, 1, 1)
        if p.safe > 0 and p.safe % 10 < 5: c = vec4(1.6, 1.6, 1.6, 1)
        draw_mesh(plane_mesh(p.team, badge_of(g, i)), m, c, specular = 0.25)
        prop_turn[i] += frame_time() * (if p.down > 0: 3.0 else: 25.0 + 30.0 * p.throttle)
        draw_mesh(prop, m * translation(vec3(0, 0.05, -3.02)) * rotation_z(prop_turn[i]), specular = 0.1)
    # the bullets: every one a tracer
    if g.bullets.len() > 0:
        tr: Instance3D[]
        # (each where it was between the last two ticks, as the planes are)
        back = f32(DT * (clamp(spare / DT, 0.0, 1.0) - 1.0))
        loop b in g.bullets:
            d = normalize(b.vel)
            at = if b.life < BULLET_LIFE: b.pos + b.vel * back else: b.pos
            tr.push(instance(translation(at - d * 2.0) * facing(d) * scaling(vec3(0.12, 0.12, 4.0)), if b.owner % 2 == 0: rgb(1.0, 0.75, 0.4) else: rgb(1.0, 0.9, 0.5)))
        draw_mesh_instanced(tracer, tr, emissive = 3.0, cast_shadow = false)
    smoke.draw(glow = false)
    fire.draw()
    sparks.draw()
    if mode == .menu:
        draw_menu()
        return
    zone("hud", (): draw_hud(g))
    if paused: draw_paused()

# ---------------- effects and sounds (from the game as it is: rolled back, it shows again) ----------------
smoke = Particles3D(gravity = vec3(0, 2, 0), drag = 0.6)
fire = Particles3D(gravity = vec3(0, 3, 0), drag = 1.5)
sparks = Particles3D(gravity = vec3(0, -9.8, 0), drag = 0.5)
seen: {int: bool} = {}          # (the booms already shown: tick, kind, who)
last_shots: int[]
hit_mark = 0.0                  # (seconds left: a hit by me, on the gunsight)
hurt = 0.0                      # (seconds left: red at the edges, hit)
puffs = 0.0                     # (time since the trails were last given smoke)

effects = (dt: f64):
    global hit_mark, hurt, news, puffs, seen, won_at
    g = game()
    # (the trails as many a second at any frame rate: 60 times, not once a frame, which on a
    # 120 Hz screen was twice the smoke)
    puffs = min(puffs + dt, 0.1)
    loop puffs >= DT:
        puffs -= DT
        loop p in g.planes:
            if p.gone > 0: continue
            tail = p.pos + fwd_of(p) * 2.0
            # (smoke when hurt, and fire when nearly done for)
            if p.health < 65 or p.down > 0:
                n = if p.down > 0 or p.health < 30: 3 else: 1
                emit(smoke, tail, n, 2.0, rgba(0.25, 0.24, 0.23, 0.7), 3.0, 4.0)
            if p.health < 30 or p.down > 0: emit(fire, tail, 2, 2.0, rgb(1.0, 0.55, 0.15), 0.4, 1.6)
    loop b in g.booms:
        key = b.tick * 256 + b.kind * 16 + b.who + 1
        if seen.has(key) or g.tick - b.tick > 30: continue
        seen[key] = true
        hit_me = b.who == me()
        if b.kind == 0:
            emit(sparks, b.pos, 8, 14.0, rgb(1.0, 0.8, 0.4), 0.4, 0.25)
            emit(smoke, b.pos, 2, 3.0, rgba(0.3, 0.3, 0.3, 0.6), 1.0, 1.5)
            if mode != .menu: play_at(if hit_me: snd_hurt else: snd_hit, b.pos, settings.sound, 900.0)
            if hit_me: hurt = 0.35
            if b.by == me(): hit_mark = 0.2
        else if b.kind == 1: emit(smoke, b.pos, 3, 4.0, rgba(0.45, 0.38, 0.28, 0.7), 1.2, 3.0)
        else if b.kind == 2:
            emit(fire, b.pos, 60, 22.0, rgb(1.0, 0.6, 0.2), 1.0, 5.0)
            emit(sparks, b.pos, 40, 30.0, rgb(1.0, 0.7, 0.3), 1.6, 0.5)
            emit(smoke, b.pos, 30, 10.0, rgba(0.2, 0.19, 0.18, 0.8), 5.0, 10.0)
            if mode != .menu: play_at(snd_boom, b.pos, settings.sound * 0.4, 2000.0)
        if mode == .menu: continue
        # (said large when it is this plane's doing, smaller for the rest of the fight)
        if b.kind == 3:
            if b.by == me(): say("you shot {call(g, b.who)} down", COLORS[b.by % 2])
            else if hit_me: say("shot down by {call(g, b.by)}", COLORS[b.by % 2])
            else: say("{call(g, b.by)} shot {call(g, b.who)} down", with_alpha(COLORS[b.by % 2], 0.75), small = true)
        else if b.kind == 4: say(if hit_me: "you crashed" else: "{call(g, b.who)} crashed", COLORS[1 - b.who % 2], small = not hit_me)
    if seen.len() > 400:
        keep: {int: bool} = {}
        loop k, v in seen:
            if k / 256 > g.tick - 60: keep[k] = v
        seen = keep
    smoke.update(dt)
    fire.update(dt)
    sparks.update(dt)
    hit_mark = max(hit_mark - dt, 0.0)
    hurt = max(hurt - dt, 0.0)
    loop mut n in news: n.1 += dt
    kept: (str, f64, vec4, f64)[]
    loop n in news:
        if n.1 < 4.0: kept.push(n)
    news = kept
    if g.winner >= 0 and won_at == 0: won_at = g.tick
    if g.winner < 0: won_at = 0

say = (what: str, color: vec4, small: bool = false):
    global news
    news.push((what, 0.0, color, if small: 20.0 else: 28.0))
    # (the newest few)
    if news.len() > 5: news = news[news.len() - 5..]

# (noise at MIX_RATE / 16: a new level every sample, a soft hiss; lower ones step, and rumble)
const HISS = f64(MIX_RATE) / 16.0
engine = mix([tone(55.0, 1.0, .saw, 0.35, 0.0, 0.0), tone(110.0, 1.0, .square, 0.12, 0.0, 0.0), tone(HISS, 1.0, .noise, 0.08, 0.0, 0.0)])
wind = tone(HISS, 2.0, .noise, 0.4, 0.0, 0.0)
snd_gun = mix([tone(180.0, 0.07, .noise, 0.5, 0.001, 0.06, 0.5), tone(90.0, 0.05, .square, 0.2, 0.001, 0.04, 0.6)])
snd_hit = tone(1500.0, 0.06, .square, 0.18, 0.001, 0.05, 0.7)
snd_hurt = mix([tone(240.0, 0.12, .noise, 0.5, 0.001, 0.1, 0.5), tone(160.0, 0.1, .square, 0.2, 0.001, 0.08, 0.7)])
snd_boom = mix([tone(60.0, 1.6, .noise, 0.9, 0.002, 1.5, 0.4), tone(45.0, 1.0, .square, 0.3, 0.002, 0.9, 0.5)])
engine_ids: int[]
wind_id = -1

sounds = ():
    global wind_id
    g = game()
    on = mode != .menu and not (paused and mode == .practice)
    if wind_id < 0: wind_id = play(wind, 0.0, looping = true)
    loop engine_ids.len() < g.planes.len(): engine_ids.push(play(engine, 0.0, looping = true))
    loop last_shots.len() < g.planes.len(): last_shots.push(0)
    loop k in g.planes.len()..engine_ids.len(): set_volume(engine_ids[k], 0.0)
    loop i in 0.. and p in g.planes:
        v = 0.0
        if on and p.gone == 0:
            v = settings.sound * (0.25 + 0.35 * p.throttle)
            if p.down > 0: v *= 0.2
        speed = f64(length(p.vel))
        if i == me():
            set_volume(engine_ids[i], v * 0.7)
            set_pan(engine_ids[i], 0.0)
        else: move_sound(engine_ids[i], p.pos, v, 900.0)
        set_pitch(engine_ids[i], 0.75 + 0.45 * p.throttle + speed / 200.0)
        # (each shot fired since the last frame)
        n = min(p.shots - last_shots[i], 3)
        if on and n > 0 and p.gone == 0:
            if i == me(): play(snd_gun, settings.sound * 0.5, pitch = 0.9 + 0.2 * random())
            else: play_at(snd_gun, p.pos, settings.sound * 0.5, 700.0)
        last_shots[i] = p.shots
    p = g.planes[me()]
    w = 0.0
    if on and p.gone == 0: w = settings.sound * clamp((f64(length(p.vel)) - 30.0) / 50.0, 0.0, 1.0) * 0.3
    set_volume(wind_id, w)

# ---------------- the heads-up display ----------------
draw_hud = (g: Game):
    i = me()
    p = g.planes[i]
    if p.gone == 0:
        fwd = fwd_of(p)
        # the gunsight: where the guns point, 300 m out
        if let at = world_to_screen(p.pos + fwd * 300.0):
            ring(at, 16, 2, rgba(1, 1, 1, 0.75))
            circle(at, 2, rgba(1, 1, 1, 0.9))
            if hit_mark > 0.0:
                loop d in [vec2(1, 1), vec2(1, -1), vec2(-1, 1), vec2(-1, -1)]: line(at + d * 9.0, at + d * 17.0, 3, rgb(1, 0.85, 0.4))
        # (flying with the mouse: where it points, which the plane turns toward)
        if aim_steering():
            if let m = world_to_screen(p.pos + aim_dir() * 400.0):
                ring(m, 7, 2, rgba(1, 1, 1, 0.5))
        else if settings.mouse and not bot and not touch_input() and not paused and p.down == 0: text_centered("click to fly with the mouse", mid() + vec2(0, 240), 20, gray(0.8))
        # the others: the target in brackets, with where to aim to hit it; the rest of its side
        # in small ones, this side's marked
        loop j in 0.. and o in g.planes:
            if j == i or o.gone > 0: continue
            at = world_to_screen(o.pos) ?? vec2(-9999, -9999)
            ahead = f64(dot(o.pos - cam_pos, cam_at - cam_pos)) > 0.0
            if j == target and not (ahead and inside(at)): arrow_to(o.pos, COLORS[o.team])
            if not (ahead and inside(at)): continue
            d = f64(length(o.pos - p.pos))
            col = COLORS[o.team]
            who = call(g, j)
            if o.team == p.team:
                triangle(at + vec2(0, -14), at + vec2(-6, -24), at + vec2(6, -24), with_alpha(col, 0.8))
                if d < 1200.0: text_centered(who, at + vec2(0, -36), 14, with_alpha(col, 0.7))
            else if j == target:
                r = f32(clamp(1400.0 / max(d, 1.0), 14.0, 60.0))
                brackets(at, r, col)
                text_centered("{who}  {int(d)} m", at + vec2(0, r + 16), 18, col)
                if d < 700.0 and o.down == 0 and p.down == 0:
                    if let l = world_to_screen(p.pos + lead(p, o)): ring(l, 6, 2, with_alpha(col, 0.9))
            else: brackets(at, f32(clamp(900.0 / max(d, 1.0), 8.0, 30.0)), with_alpha(col, 0.5))
        # speed, height, throttle
        speed = f64(length(p.vel)) * 3.6
        alt = f64(p.pos.y)
        # (bottom left; on a phone top left, out of the thumbs' way)
        o = at_edge(30, if touch_input(): 20.0 else: -110.0)
        text("{int(speed)} km/h", o, 26, if f64(length(p.vel)) < STALL * 1.15: rgb(1, 0.5, 0.35) else: WHITE)
        text("{int(alt)} m", o + vec2(0, 32), 26, WHITE)
        hud_bar(Rect(o.x, o.y + 68, 160, 10), p.throttle, rgba(1, 1, 1, 0.8))
        text("throttle", o + vec2(168, 62), 16, gray(0.75))
        # the plane, and its guns
        b = at_edge(-190, if touch_input(): 80.0 else: -80.0)
        hud_bar(Rect(b.x, b.y, 160, 12), f64(p.health) / 100.0, COLORS[p.team])
        hud_bar(Rect(b.x, b.y + 24, 160, 8), f64(p.heat) / f64(JAM_HEAT), if p.jammed: rgb(1, 0.35, 0.25) else: rgb(1, 0.75, 0.35))
        text(if p.jammed: "guns jammed" else: "guns", b + vec2(0, 38), 16, if p.jammed: rgb(1, 0.4, 0.3) else: gray(0.75))
        if p.down == 0 and g.winner < 0 and f64(length(p.vel)) < STALL * 0.95: text_centered("STALL", alert_at(), 30, rgb(1, 0.45, 0.3))
        if p.down == 0 and g.winner < 0 and length(vec2(p.pos.x, p.pos.z)) > FIELD: text_centered("turning back to the field", alert_at() + vec2(0, 40), 24, gray(0.85))
        if tracking and not touch_input(): text("looking at the target (C)", at_edge(30, if touch_input(): 150.0 else: -140.0), 16, gray(0.7))
    else if g.winner < 0: text_centered("back in {(p.gone + 59) / 60}", alert_at(), 30, WHITE)
    if hurt > 0.0:
        r = visible_rect()
        a = f32(hurt / 0.35 * 0.35)
        loop k in 0..6:
            w = f32(k) * 8.0
            col = rgba(0.8, 0.05, 0.02, a * (1.0 - f32(k) / 6.0))
            rect(f64(r.x + w), f64(r.y + w), 8, f64(r.h - w * 2.0), col)
            rect(f64(r.x + r.w - w - 8.0), f64(r.y + w), 8, f64(r.h - w * 2.0), col)
    # the score, this plane's side underlined
    top = at_edge(0, 0)
    x = f64(mid().x)
    text_centered("{g.scores[0]}", vec2(f32(x - 50.0), top.y + 40), 44, COLORS[0])
    text_centered("{g.scores[1]}", vec2(f32(x + 50.0), top.y + 40), 44, COLORS[1])
    rect(x + (if p.team == 0: -70.0 else: 30.0), f64(top.y) + 66.0, 40, 3, COLORS[p.team])
    text_centered("first to {g.win}", vec2(f32(x), top.y + 86), 16, gray(0.7))
    # (upright: below the speed and the guns)
    news_y = f64(top.y) + (if upright: 200.0 else: 150.0)
    loop k in 0.. and n in news:
        a = f32(clamp(4.0 - n.1, 0.0, 1.0))
        text_centered(n.0, vec2(f32(x), f32(news_y + f64(k) * 32.0)), n.3, with_alpha(n.2, a * n.2.w))
    if g.winner >= 0:
        # (around the middle of the screen)
        y = f64(mid().y) - 360.0
        rect(x - 300.0, y + 230.0, 600, f64(290 + g.planes.len() / 2 * 28), rgba(0.03, 0.04, 0.06, 0.5))
        text_centered(if g.winner == p.team: "your side won" else: "{TEAMS[g.winner]} won", vec2(f32(x), f32(y + 300.0)), 72, COLORS[g.winner])
        if over():
            if touch_input():
                if hud_button(Rect(x - 100.0, y + 345.0, 200, 50), if mode == .practice and not in_room(): "Again" else: "Back"): after_fight()
            else:
                again = if mode == .practice and not in_room(): "Enter: again   Escape: the menu" else: if mode == .practice or (s.me == 0 and friends.len() > 0): "Enter: back to the sides" else: "Enter: back"
                text_centered(again, vec2(f32(x), f32(y + 370.0)), 24, gray(0.8))
        draw_tally(g, i, x, y + 500.0)
    if mode == .online:
        if s.waiting and g.winner < 0:
            loop q in 0..s.players:
                if q != s.me and not s.stands_in(q) and s.silent(q) > 1.0:
                    text_centered("waiting for {player_name(q)}...", mid() + vec2(0, 200), 24, gray(0.8))
                    break
        if s.desync >= 0: text_centered("the games differ since tick {s.desync}", vec2(f32(x), top.y + 110), 22, rgb(1, 0.4, 0.4))
        ping = 0.0
        loop q in 0..s.players:
            if q != s.me and not s.stands_in(q): ping = max(ping, s.ping(q))
        text("ping {int(ping)} ms", at_edge(30, if touch_input(): 120.0 else: 20.0), 16, gray(0.6))
    if touch_input():
        # (brighter while held)
        circle(fire_at(), 80, rgba(1, 1, 1, if touch_fire: 0.3 else: 0.14))
        text_centered("Fire", fire_at(), 26, rgba(1, 1, 1, 0.7))
        circle(look_button(), 42, rgba(1, 1, 1, if tracking: 0.35 else: 0.12))
        text_centered("Look", look_button(), 24, rgba(1, 1, 1, 0.7))
        # (the throttle: filled as far as it is open; the handle where the finger holds it)
        r = throttle_track()
        held = throttle_want >= 0.0
        rect(r, rgba(1, 1, 1, if held: 0.16 else: 0.1))
        f = f32(p.throttle) * r.h
        rect(Rect(r.x, r.y + r.h - f, r.w, f), rgba(1, 1, 1, 0.18))
        hy = r.y + r.h - f32(if held: throttle_want else: p.throttle) * r.h
        rect(Rect(r.x - 8, hy - 4, r.w + 16, 8), rgba(1, 1, 1, if held: 0.8 else: 0.5))
        text_centered("throttle", vec2(r.x + r.w / 2, r.y + r.h + 22), 16, rgba(1, 1, 1, 0.6))
        if hud_button(leave_box(), "Leave"): leave()
    else: text("Escape: menu", at_edge(-130, 20), 16, gray(0.55))

# who shot down how many, each side's in a column (around x), at the end; you: this machine's plane
draw_tally = (g: Game, you: int, x: f64, top: f64):
    loop team in 0..2:
        cx = f32(x + (if team == 0: -160.0 else: 160.0))
        k = 0
        loop j in 0.. and o in g.planes:
            if o.team != team: continue
            who = if j == you: "{call(g, j)} (you)" else: call(g, j)
            text_centered("{who}   {o.kills}", vec2(cx, f32(top + f64(k) * 28.0)), 20, if j == you: WHITE else: with_alpha(COLORS[team], 0.9))
            k += 1

# the last fight's results, beside the sides (until the next starts), from top down
draw_results = (top: f64):
    if let g = results:
        h = 100.0 + f64(g.planes.len() / 2) * 28.0
        x = box_x()
        rect(x - 320.0, top, 640, h, rgba(0.03, 0.04, 0.06, 0.55))
        text_centered("Last fight: {TEAMS[g.winner]} won, {g.scores[g.winner]} to {g.scores[1 - g.winner]}", vec2(f32(x), f32(top + 40.0)), 28, COLORS[g.winner])
        draw_tally(g, results_me, x, top + 90.0)

inside = (p: vec2) -> bool:
    r = visible_rect()
    p.x > r.x + 20 and p.y > r.y + 20 and p.x < r.x + r.w - 20 and p.y < r.y + r.h - 20

brackets = (at: vec2, r: f32, col: vec4):
    k = r * 0.4
    loop sx in [-1.0, 1.0]:
        loop sy in [-1.0, 1.0]:
            c = at + vec2(f32(sx) * r, f32(sy) * r)
            line(c, c - vec2(f32(sx) * k, 0), 2, col)
            line(c, c - vec2(0, f32(sy) * k), 2, col)

# an arrow round the middle of the screen, pointing the way to turn to see pos
arrow_to = (pos: vec3, col: vec4):
    fwd = normalize(cam_at - cam_pos)
    right = normalize(cross(fwd, cam_up))
    up = cross(right, fwd)
    d = pos - cam_pos
    v = vec2(dot(d, right), -dot(d, up))
    if length(v) < 0.001: v = vec2(0, 1)
    v = normalize(v)
    c = mid() + v * f32(min(230.0, f64(visible_rect().w) * 0.35))
    side = perp(v)
    triangle(c + v * 22.0, c + side * 12.0, c - side * 12.0, col)

# ---------------- the menu ----------------
draw_menu = ():
    global host, lobby_badges, lobby_names, lobby_pilots, lobby_starts, page, public, starts_at, want_side
    if invite.active():
        if let c = invite.screen("Aces", WEB_PAGE):
            if c.peer < 0:
                # (Play with anybody: this one hosts the public room, others come by it)
                public = true
                starts_at = elapsed() + PUBLIC_WAIT
                page = LOBBY
            else if c.inviter:
                came(c.peer)
                page = LOBBY
            else:
                host = c.peer
                lobby_pilots = []
                lobby_names = []
                lobby_badges = []
                lobby_starts = -1.0
                want_side = -1
                page = JOINED
        return
    if page == SETTINGS:
        draw_settings()
        return
    r = visible_rect()
    # (the column: on the left, beside the plane; upright, across the bottom of the screen, under
    # it, and the sides across all of it)
    x = f32(column())
    y = if upright: f64(at_edge(0, -790).y) else: 0.0
    # (wider than the menu's items, which are boxes on a touch screen)
    if not upright: rect(Rect(r.x, r.y, (if touch_device(): 640 else: 560) - r.x, r.h), rgba(0.04, 0.05, 0.08, 0.55))
    else if page != LOBBY and page != JOINED: rect(Rect(r.x, f32(y), r.w, r.y + r.h - f32(y)), rgba(0.04, 0.05, 0.08, 0.55))
    if page == LOBBY or page == JOINED:
        draw_lobby()
        return
    text_centered("ACES", vec2(x, f32(y + 130.0)), 96, WHITE)
    ui_begin("menu", vec2(x, f32(y + 240.0)))
    if invite.has_server():
        if ui_button("Make a room"): make_room()
        if ui_button("Join a room"): invite.join()
        if ui_button("Play with anybody"): invite.anybody(reliable = false)
    else:
        if ui_button("Invite a friend"): invite.start(reliable = false, players = 2 * MOST)
        if ui_button("Join a friend"): invite.join()
    if ui_button("Practice"): page = LOBBY
    # (a phone's browser: the bars at the top and bottom away)
    if touch_device() and can_fullscreen() and not is_fullscreen() and ui_button("Fullscreen"): set_fullscreen(true)
    if ui_button("Settings"): page = SETTINGS
    when TARGET != "wasm":
        if ui_button("Quit"): quit()
    ui_end()
    if len(status) > 0: text_centered(status, vec2(x, f32(y + 580.0)), 22, gray(0.85))
    how = "The mouse steers and its button fires. Keys: S climbs, W dives, A and D roll, Q and E the rudder, Shift and Ctrl the throttle, Space fires, C looks at the target and back, Tab picks the next."
    if touch_input() or touch_device(): how = "Drag a finger anywhere to aim: the plane turns toward where it points. Hold Fire to shoot; slide the throttle up and down; Look watches the target, and again looks ahead."
    text_wrapped("Red's triplanes against Blue's biplanes, up to six a side. {how}", vec2(x - 240, f32(y + 610.0)), 480, 18, gray(0.8), align = .center)

# a player's insignia, small, centered at `at` on the screen: its shape, or a mark of the color
# it paints a part of the plane
draw_badge = (badge: int, at: vec2, size: f64):
    layers: (vec2[], vec4)[]
    if badge == 1: layers = [(box2(vec2(-0.35, 0), 0.25, 1.6) + box2(vec2(0.35, 0), 0.25, 1.6), WHITE_PAINT)]
    else if badge == 2: layers = [(disc2(vec2(0, 0), 0.7), YELLOW_PAINT)]
    else if badge == 3: layers = [(CHEVRON, WHITE_PAINT)]
    else if badge == 4: layers = [(star2(1.0), WHITE_PAINT)]
    else if badge == 5: layers = SKULL
    else if badge == 6: layers = [(BOLT, YELLOW_PAINT)]
    else if badge == TAIL: layers = [([vec2(-0.8, -0.7), vec2(0.8, -0.7), vec2(0.4, 0.8)], YELLOW_PAINT)]
    else if badge == 8: layers = HAT
    else if badge == MAW_BADGE: layers = MAW
    else if badge == 10: layers = HEART
    else if badge == FACE_BADGE: layers = FACE
    else if badge == 12: layers = STORK
    else if badge == 13: layers = SPADE
    p = (q: vec2) -> vec2: at + vec2(q.x, -q.y) * f32(size)
    loop l in layers:
        loop k in 0..l.0.len() / 3: triangle(p(l.0[3 * k]), p(l.0[3 * k + 1]), p(l.0[3 * k + 2]), l.1)

# the two sides, a column each (the same on every player's screen): each plane's player, with
# their insignia, or the computer; you: this one's player. Where the next thing goes, below them
draw_sides = (pilots: int[], you: int, names: str[], badges: int[], top: f64) -> f64:
    n = pilots.len() / 2
    loop team in 0..2:
        x = column() + (if team == 0: -250.0 else: 10.0)
        text_centered(TEAMS[team], vec2(f32(x + 120.0), f32(top)), 28, COLORS[team])
        loop k in 0..n:
            y = top + 22.0 + f64(k) * 30.0
            p = pilots[2 * k + team]
            rect(x, y, 240, 26, with_alpha(COLORS[team], if p == you: 0.4 else: 0.14))
            if p < 0:
                text("computer", vec2(f32(x + 34.0), f32(y + 4.0)), 18, gray(0.6))
                continue
            draw_badge(if p < badges.len(): badges[p] else: 0, vec2(f32(x + 16.0), f32(y + 13.0)), 9.0)
            who = if p < names.len() and len(names[p]) > 0: names[p] else: "player {p + 1}"
            text(if p == you: "{who} (you)" else: who, vec2(f32(x + 34.0), f32(y + 3.0)), 20, if p == you: WHITE else: gray(0.9))
    top + 22.0 + f64(n) * 30.0

# the lobby: the sides, Switch side, and for the host Start and the fight's settings (practice:
# the same, alone); the room's code, for friends to join
draw_lobby = ():
    global ui_style
    hosting = page == LOBBY
    pilots = if hosting: lobby_seats() else: lobby_pilots
    players = 0
    loop k in pilots:
        if k >= 0: players += 1
    title = if hosting and public: "Play with anybody" else: if hosting and friends.len() == 0 and len(invite.room_code()) == 0: "Practice" else: if players == 0: "Joined" else: if players == 1: "1 player" else: "{players} players"
    t0 = f64(at_edge(0, 0).y)
    x = f32(column())
    items = if hosting: 8 else: 4
    if upright:
        # (upright: all of it at the bottom of the screen, the plane above it where there is room)
        n = f64(pilots.len() / 2)
        tall = max(234.0 + n * 30.0, 300.0) + f64(items) * 50.0 + (if hosting: room_height() else: 0.0) + results_height()
        t0 = max(t0, f64(at_edge(0, 0).y) + f64(safe_rect().h) - tall - 20.0)
        r = visible_rect()
        rect(Rect(r.x, f32(t0 - 10.0), r.w, r.y + r.h - f32(t0 - 10.0)), rgba(0.04, 0.05, 0.08, 0.7))
    text_centered(title, vec2(x, f32(t0 + 50.0)), 44, WHITE)
    # (when the fight starts, and who starts it)
    starts = if hosting and public: starts_at else: if hosting: -1.0 else: lobby_starts
    what = ""
    if starts >= 0.0: what = "The fight starts in {int(ceil(max(starts - elapsed(), 0.0)))} s"
    else if not hosting: what = "Waiting for {if lobby_names.len() > 0 and len(lobby_names[0]) > 0: lobby_names[0] else: "player 1"} to start the fight"
    else if friends.len() > 0: what = "You pass on what goes between your friends: if you leave, the fight ends for all."
    text_wrapped(what, vec2(x - 240, f32(t0 + 84.0)), 480, 18, gray(0.8), align = .center)
    below = draw_sides(pilots, if hosting: 0 else: lobby_me, if hosting: names_now() else: lobby_names, if hosting: badges_now() else: lobby_badges, t0 + 150.0)
    if not touch_input(): text_centered("Tab, or a gamepad's X: switch side", vec2(x, f32(below + 16.0)), 16, gray(0.6))
    old = ui_style
    # (closer together when there are many: the host's eight fit above the screen's bottom)
    at = max(below + 62.0, t0 + 300.0)
    ui_style.spacing = if upright: 50.0 else: clamp((700.0 - at) / f64(items), 38.0, 50.0)
    ui_style.size = min(34.0, ui_style.spacing * 0.75)
    ui_style.width = 400.0
    ui_begin("lobby", vec2(x, f32(at)))
    if hosting and ui_button("Start"): start_fight()
    if ui_button("Switch side") or (ui_ready() and (key_pressed(.tab) or gamepad_pressed(.x))): switch_side()
    # (this one's name and insignia, as in Settings: the others see them change)
    # (kept as typed until the fight or leaving: saving tidies it, and would take a space just typed)
    settings.name = ui_text_field("Name", settings.name, NAME_MOST)
    badge = ui_choice("Insignia", BADGES, settings.badge)
    if badge != settings.badge:
        settings.badge = badge
        save_settings()
    if hosting:
        settings.sides = ui_choice("Planes a side", ["1", "2", "3", "4", "5", "6"], planes_a_side() - 1) + 1
        settings.skill = ui_choice("The computer", ["easy", "fair", "hard"], settings.skill)
        if invite.has_server():
            if len(invite.room_code()) == 0:
                if ui_button("Make a room"): make_room()
            else if ui_button("Invite with a code"): invite.start_codes(reliable = false)
        else if friends.len() < 2 * MOST - 1 and ui_button(if friends.len() == 0: "Invite a friend" else: "Invite another"): invite.start(reliable = false, players = 2 * MOST)
    if ui_button(if hosting: "Back" else: "Leave") or ui_back():
        save_settings()
        leave()
    ui_end()
    # (upright: the room and the last fight below the menu; else on the right, from the top)
    next = if upright: at + f64(items) * ui_style.spacing else: 30.0
    ui_style = old
    draw_results(if hosting: draw_room(next) else: next)

# (the middle of the room's and the last fight's boxes: right of the menu; upright, under it)
box_x = () -> f64: if upright: f64(mid().x) else: 920.0

# (how tall draw_room's and draw_results' boxes are, with what is between them)
room_height = () -> f64:
    if len(invite.room_code()) > 0: return 270.0
    if len(invite.room_status()) > 0: 130.0 else: 0.0
results_height = () -> f64:
    if let g = results: 100.0 + f64(g.planes.len() / 2) * 28.0 else: 0.0

# this one's room, from `top` down: its code, big, and a link with it, for friends to join; how it
# is going. Where the next thing goes, below it
draw_room = (top: f64) -> f64:
    code = invite.room_code()
    how = invite.room_status()
    if len(code) == 0 and len(how) == 0: return top
    x = box_x()
    if len(code) == 0:
        rect(x - 320.0, top, 640, 110, rgba(0.03, 0.04, 0.06, 0.55))
        text_wrapped(how, vec2(f32(x - 300.0), f32(top + 20.0)), 600, 20, gray(0.85), align = .center)
        return top + 130.0
    rect(x - 320.0, top, 640, 250, rgba(0.03, 0.04, 0.06, 0.55))
    text_centered("Friends join with the code", vec2(f32(x), f32(top + 30.0)), 22, gray(0.85))
    text_centered(code, vec2(f32(x), f32(top + 80.0)), 64, rgb(1.0, 0.85, 0.3), mono = true)
    link = invite.room_link(WEB_PAGE)
    if len(link) > 0:
        text_centered(link, vec2(f32(x), f32(top + 126.0)), min(16.0, 16.0 * 600.0 / text_width(link, 16, mono = true)), gray(0.7), mono = true)
        if can_share():
            if hud_button(Rect(x - 170.0, top + 146.0, 160, 40), "Copy link"): set_clipboard(link)
            if hud_button(Rect(x + 10.0, top + 146.0, 160, 40), "Share"): share(link)
        else if hud_button(Rect(x - 80.0, top + 146.0, 160, 40), "Copy link"): set_clipboard(link)
    text_wrapped(how, vec2(f32(x - 300.0), f32(top + 202.0)), 600, 18, gray(0.8), align = .center)
    top + 270.0

draw_settings = ():
    global log_said, page
    if mode != .menu: rect(visible_rect(), rgba(0.03, 0.04, 0.06, 0.5))
    r = visible_rect()
    x = mid().x
    t0 = at_edge(0, 0).y
    rect(Rect(x - 400, r.y, 800, r.h), rgba(0.04, 0.05, 0.08, 0.8))
    text_centered("Settings", vec2(x, t0 + 70), 48, WHITE)
    ui_begin("settings", vec2(x, t0 + 140))
    settings.mouse = ui_switch("Fly with the mouse", settings.mouse)
    settings.invert = ui_switch("Invert pitch", settings.invert)
    settings.level = ui_switch("Lock camera roll", settings.level)
    if can_fullscreen():
        fs = ui_switch("Fullscreen", is_fullscreen())
        if fs != is_fullscreen(): set_fullscreen(fs)
    # (the log of fights, to send when one went badly: see log_line)
    if ui_button("Save the log"): save_log()
    if len(log_said) > 0: ui_text(log_said)
    settings.sound = ui_slider("Sound", settings.sound)
    # (not first: a phone's keyboard would come up as Settings opens)
    settings.name = ui_text_field("Name", settings.name, NAME_MOST)
    settings.badge = ui_choice("Insignia", BADGES, settings.badge)
    ui_controls()
    if ui_button("Back") or ui_back():
        save_settings()
        log_said = ""
        page = MAIN
    ui_end()

# the in-fight menu (Escape)
draw_paused = ():
    global page
    if page == SETTINGS:
        draw_settings()
        return
    rect(visible_rect(), rgba(0.03, 0.04, 0.06, 0.55))
    text_centered(if mode == .practice: "Paused" else: "The fight goes on", mid() - vec2(0, 160), 48, WHITE)
    ui_begin("paused", mid() - vec2(0, 70))
    if ui_button("Back to the fight"): resume()
    if ui_button("Settings"): page = SETTINGS
    if ui_button("Leave"): leave()
    ui_end()
