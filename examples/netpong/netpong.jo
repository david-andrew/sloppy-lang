# NETPONG - Pong for two, over the network (lib/net.jo).
# Invite a friend (lib/invite.jo's screens): the game gives a link to send them (a chat message),
# they open it (or paste it into Join a friend) and send back the code their game gives them, and
# the two games connect straight to each other, with no server: web pages and computers alike, on
# the same Wi-Fi or across the internet.
# On one network there is also the old way, by address: one hosts (`sloppy run netpong.jo`, Host
# on this network: the screen shows the address), the other types that address. Without Sloppy,
# tools/netpong_relay.py (Python) serves the game to web pages on a network and passes their
# messages. "How to play together" in the game says all this.
#
# The host moves the ball and both paddles and sends what it sees 30 times a second; the one who
# joined sends only its paddle's moves. Through the relay, the relay says who hosts ("host" or
# "guest"), that the other player came ("j") or left ("l"), and passes the rest on.
# Up/down (W/S, a gamepad's stick, or a finger or the mouse held down: the paddle follows it) move
# your paddle; first to 7 wins. Escape (or Back) leaves.

build:
    name = "Netpong"

import net
import invite

window("Netpong", 1280, 720)

const PORT = 47200
const PADDLE_H = 120.0
const PADDLE_SPEED = 620.0
const BALL_SPEED = 520.0
const WIN = 7
# (where the game is on the web: an invite from a computer links there, for a friend with no Sloppy)
const WEB_PAGE = "https://sloppy-lang.org/examples/netpong/"

enum Screen: title, help, friend, by_address, joining, waiting, playing, over

screen = Screen.title
hosting = false
other = -1                      # the other player (a peer)
address = env("JOIN") ?? "localhost"        # (a web page: ?join=address)
left_y = 360.0                  # the host's paddle (left), the other's (right)
right_y = 360.0
right_move = 0.0                # (the host: what the other player last asked for)
ball = vec2(640, 360)
vel = vec2(0, 0)
score_l = 0
score_r = 0
send_wait = 0.0
status = ""
why = ""                        # (why the other player could not be reached)
via_relay = false               # (playing through tools/netpong_relay.py)
my_address = ""                 # (the host: this machine's address on its network)
invited = false                 # (connected by invite codes, not by address)

serve = (dir: f64):
    ball = vec2(640, 360)
    a = random(-0.5, 0.5)
    vel = vec2(f32(cos(a) * dir), f32(sin(a))) * f32(BALL_SPEED)

host = ():
    # (a web page cannot listen: only the game built for a computer hosts by address)
    when TARGET != "wasm":
        if not net.listen(PORT):
            status = "port {PORT} is taken (another game hosting here?)"
            return
        hosting = true
        via_relay = false
        screen = .waiting
        my_address = net.local_address()

join = ():
    invited = false
    other = net.connect(address, PORT)
    hosting = false
    via_relay = false
    screen = .waiting
    status = "connecting to {address}..."

# straight to the other player, by invite codes (the invite screens): who invited hosts the game
friend_screens = ():
    via_relay = false
    invited = true
    status = ""
    why = ""
    screen = .friend

# connected by invite: the inviter starts the game, the other waits for it
friend_joined = (c: invite.Invited):
    other = c.peer
    hosting = c.inviter
    if hosting: start()
    else:
        status = "connected: waiting for the host"
        screen = .waiting

start = ():
    score_l = 0
    score_r = 0
    left_y = 360.0
    right_y = 360.0
    serve(1.0)
    screen = .playing

# the host's view of the game, as a message: "s ball.x ball.y left right score_l score_r screen"
state = () -> str: "s {ball.x:.1} {ball.y:.1} {left_y:.1} {right_y:.1} {score_l} {score_r} {int(screen)}"

read_state = (t: str):
    w = split(t, " ")
    if w.len() < 8: return
    ball = vec2(f32(to_float(w[1]) ?? 0.0), f32(to_float(w[2]) ?? 0.0))
    left_y = to_float(w[3]) ?? left_y
    right_y = to_float(w[4]) ?? right_y
    score_l = to_int(w[5]) ?? score_l
    score_r = to_int(w[6]) ?? score_r
    k = to_int(w[7]) ?? int(Screen.playing)
    if k == int(Screen.over): screen = .over
    else if k == int(Screen.playing): screen = .playing

network = ():
    loop e in net.receive():
        if e.kind == .joined:
            other = e.peer
            if hosting: start()
            else: status = "connected: waiting for the host"
        else if e.kind == .left:
            if e.peer == other:
                was = screen
                status = "the other player left"
                why = ""
                if was == .waiting and not hosting and not invited:
                    status = "could not reach {address}"
                    if not starts_with(address, "ws"): status = "could not reach {address}, port {PORT}"
                    why = net.why(e.peer)
                screen = .title
                other = -1
        # (the relay: who hosts, and the other player coming and going)
        else if e.text == "host":
            hosting = true
            via_relay = true
            status = "waiting for the other player: on their computer or phone, they open the same address"
        else if e.text == "guest":
            via_relay = true
            status = "connected: waiting for the host"
        else if e.text == "j" and hosting: start()
        else if e.text == "l":
            status = "the other player left"
            screen = .title
            if other >= 0: net.close(other)
            other = -1
        else if hosting:
            if starts_with(e.text, "m "): right_move = to_float(e.text[2..]) ?? 0.0
        else if starts_with(e.text, "s "): read_state(e.text)

# (HOST=1: host by address at once; JOIN=address, or ?join=address in a web page: join at once;
# INVITE=code, or ?invite=code: join a friend with that code at once)
if env("HOST") != none: host()
else if env("JOIN") != none: join()
else if invite.from_link(): friend_screens()

# back to the title, leaving the other player (if any)
go_title = ():
    if other >= 0: net.close(other)
    other = -1
    if hosting and not via_relay: net.stop_listening()
    hosting = false
    status = ""
    screen = .title

# a Back button at the top left: for a phone, with no Escape
back_button = () -> bool: hud_button(Rect(30, 24, 120, 44), "Back")

update = (dt: f64):
    network()
    if key_pressed(.escape) and screen != .title and screen != .joining and screen != .help and screen != .friend:
        go_title()
        return
    if screen == .help:
        if key_pressed(.escape) or key_pressed(.enter) or mouse_pressed(.left): screen = .title
        return
    if screen == .joining:
        if key_pressed(.escape): screen = .by_address
        return
    if screen != .playing: return
    move = f64(-input_axis().y)
    # (a finger, or the mouse held down: the paddle goes to it)
    if mouse_down(.left):
        mine = if hosting: left_y else: right_y
        move = clamp((mine - f64(mouse_pos().y)) / 30.0, -1.0, 1.0)
    if hosting:
        left_y = clamp(left_y - move * PADDLE_SPEED * dt, PADDLE_H / 2.0, 720.0 - PADDLE_H / 2.0)
        right_y = clamp(right_y - right_move * PADDLE_SPEED * dt, PADDLE_H / 2.0, 720.0 - PADDLE_H / 2.0)
        ball += vel * f32(dt)
        if ball.y < 10 or ball.y > 710:
            vel.y = -vel.y
            ball.y = clamp(ball.y, 10.0, 710.0)
        if ball.x < 60 and ball.x > 30 and abs(f64(ball.y) - left_y) < PADDLE_H / 2.0 and vel.x < 0:
            vel.x = -vel.x * 1.05
            vel.y += f32((f64(ball.y) - left_y) * 4.0)
        if ball.x > 1220 and ball.x < 1250 and abs(f64(ball.y) - right_y) < PADDLE_H / 2.0 and vel.x > 0:
            vel.x = -vel.x * 1.05
            vel.y += f32((f64(ball.y) - right_y) * 4.0)
        if ball.x < -20:
            score_r += 1
            serve(1.0)
        if ball.x > 1300:
            score_l += 1
            serve(-1.0)
        if score_l >= WIN or score_r >= WIN: screen = .over
        send_wait -= dt
        if send_wait <= 0.0 and other >= 0:
            net.send(other, state())
            send_wait = 1.0 / 30.0
    else if other >= 0: net.send(other, "m {move:.2}")

GOLD = rgb(1.0, 0.85, 0.3)
DIM = rgba(1, 1, 1, 0.55)
BLUE = rgb(0.4, 0.8, 1.0)

draw = ():
    clear(rgb(0.05, 0.06, 0.09))
    if screen == .playing or screen == .over:
        loop y in [0..18): rect(638, f64(y) * 40 + 10, 4, 20, rgba(1, 1, 1, 0.15))
        rect(36, left_y - PADDLE_H / 2.0, 16, PADDLE_H, BLUE)
        rect(1228, right_y - PADDLE_H / 2.0, 16, PADDLE_H, rgb(1.0, 0.6, 0.3))
        circle(ball, 10, WHITE)
        text_centered("{score_l}", vec2(560, 60), 64)
        text_centered("{score_r}", vec2(720, 60), 64)
        you = "you are the right paddle"
        if hosting: you = "you are the left paddle"
        text_centered(you, vec2(640, 690), 20, rgba(1, 1, 1, 0.5))
    if screen == .over:
        won = score_l > score_r
        if not hosting: won = not won
        text_centered(if won: "you won" else: "you lost", vec2(640, 300), 72)
        if hud_button(Rect(540, 360, 200, 48), "Back to the title"): go_title()
    if screen == .title:
        text_centered("NETPONG", vec2(640, 170), 96, BLUE)
        ui_begin("title", vec2(640, 300))
        if ui_button("Invite a friend"):
            invite.start()
            friend_screens()
        if ui_button("Join a friend"):
            invite.join()
            friend_screens()
        if ui_button("Same network, by address"): screen = .by_address
        if ui_button("How to play together"): screen = .help
        when TARGET != "wasm":
            if ui_button("Quit"): quit()
        ui_end()
        if len(status) > 0: text_centered(status, vec2(640, 590), 22, GRAY)
        if len(why) > 0: text_wrapped(why, vec2(240, 620), 800, 18, rgba(1, 1, 1, 0.45), align = .center)
    if screen == .by_address:
        text_centered("Same network, by address", vec2(640, 170), 44, BLUE)
        ui_begin("addr", vec2(640, 300))
        when TARGET != "wasm":
            if ui_button("Host on this network"): host()
        if ui_button("Join an address"): screen = .joining
        if ui_button("Back"): screen = .title
        ui_end()
        when TARGET == "wasm":
            text_wrapped("A web page cannot host by address: Invite a friend works from a web page too.", vec2(240, 480), 800, 20, DIM, align = .center)
    if screen == .friend:
        if let c = invite.screen("Netpong", WEB_PAGE): friend_joined(c)
        else if not invite.active(): screen = .title
    if screen == .help: draw_help()
    if screen == .joining:
        text_centered("Type the address the host's screen shows, then Enter", vec2(640, 250), 30)
        address = hud_text_field(Rect(390, 310, 500, 56), address, "address", 64)
        if hud_button(Rect(560, 385, 160, 44), "Join") or key_pressed(.enter): join()
        text_wrapped("It is four numbers with dots between, as 192.168.1.20. Both players must be on the same network (the same Wi-Fi or router). A game hosted on this same computer: localhost.", vec2(240, 460), 800, 20, DIM, align = .center)
        if back_button(): screen = .by_address
    if screen == .waiting: draw_waiting()
    if screen == .waiting:
        if back_button(): go_title()
    # (playing: between the scores, away from the paddles' fingers)
    if screen == .playing and hud_button(Rect(595, 22, 90, 34), "Leave"): go_title()

draw_waiting = ():
    if not hosting or via_relay:
        text_wrapped(status, vec2(190, 330), 900, 26, WHITE, align = .center)
        return
    text_centered("Waiting for the other player", vec2(640, 200), 36)
    if len(my_address) > 0:
        text_centered("On their computer: Netpong, Same network, Join an address, and this address:", vec2(640, 280), 24, GRAY)
        text_centered(my_address, vec2(640, 350), 64, GOLD)
    else:
        text_centered("This computer seems to be on no network: connect it to the Wi-Fi first", vec2(640, 330), 24, GRAY)
    text_wrapped("Both computers must be on the same network (the same Wi-Fi or router). If a window asks whether Netpong may use the network, allow it. Playing on this same computer: join localhost.", vec2(240, 450), 800, 20, DIM, align = .center)

HELP = [
    "Invite a friend: the game gives a link. Send it to them any way (a chat message). They open it in a web browser (nothing to install), or paste it into Join a friend in their Netpong, and send you back the code their game then shows; paste that in. The two games then connect straight to each other, near or far.",
    "Same network, by address: one hosts, from the game run on a computer (`sloppy run netpong.jo`), and its screen shows an address such as 192.168.1.20; the other chooses Join an address and types it. Alone: run the game twice on one computer and join localhost.",
    "Without Sloppy, on one network: run netpong_relay.py (Python; from the Netpong page of sloppy-lang.org) and open the address it prints in a browser on both devices. The first to open it hosts.",
    "When a code connects nothing: some networks (mobile data, a school's or an office's) let no outside connection in. One of you on another network (a home's Wi-Fi) usually does it.",
]

draw_help = ():
    text_centered("How to play together", vec2(640, 80), 44, BLUE)
    y = 150.0
    loop i in 0.. and h in HELP:
        text_centered("{i + 1}", vec2(150, f32(y + 12.0)), 28, GOLD)
        y += text_wrapped(h, vec2(190, f32(y)), 900, 22, WHITE) + 24.0
    text_centered("A click or a tap: back", vec2(640, 680), 20, GRAY)
