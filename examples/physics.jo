# Physics: a pyramid of boxes, a bridge of planks, a wrecking ball on a rope and a pile of balls,
# with 2D physics (`import physics`: bodies, collisions, pins and ropes). Drag anything with the
# left mouse button. Right click drops a box, middle click or B a ball; R starts over.

import physics

window("Physics", 1280, 720)

w = physics.World()
fills: {int: vec4}              # each body's color, by its id
grab: physics.Joint? = none
rope: physics.Joint? = none
count = 0

paint = (b: physics.Body, c: vec4): fills[b.id] = c

add_box = (at: vec2, size: vec2) -> physics.Body:
    count += 1
    b = w.add_box(at, size, friction = 0.6)
    paint(b, hsv(0.05 + 0.08 * f64(count % 7), 0.55, 0.9))
    b

add_ball = (at: vec2, r: f64) -> physics.Body:
    count += 1
    b = w.add_circle(at, r, friction = 0.4, bounce = 0.3)
    paint(b, hsv(0.55 + 0.06 * f64(count % 5), 0.5, 0.95))
    b

setup = ():
    global grab, rope, w
    w = physics.World()
    fills.clear()
    grab = none
    stone = rgb(0.32, 0.34, 0.4)
    paint(w.add_box(vec2(640, 710), vec2(1280, 40), kind = .fixed), stone)
    paint(w.add_box(vec2(-10, 360), vec2(20, 720), kind = .fixed), stone)
    paint(w.add_box(vec2(1290, 360), vec2(20, 720), kind = .fixed), stone)
    # a pyramid
    loop r in 0..8:
        loop c in 0..8 - r: add_box(vec2(880 + 42 * f64(c) + 21 * f64(r), 670 - 40 * f64(r)), vec2(40, 40))
    # a bridge of planks between two pillars, each pinned to the next
    paint(w.add_box(vec2(130, 600), vec2(60, 180), kind = .fixed), stone)
    paint(w.add_box(vec2(610, 600), vec2(60, 180), kind = .fixed), stone)
    prev = physics.ground
    loop i in 0..10:
        p = w.add_box(vec2(181 + 42 * f64(i), 512), vec2(42, 10), density = 0.5)
        paint(p, rgb(0.62, 0.45, 0.28))
        w.pin(prev, p, vec2(160 + 42 * f64(i), 512))
        prev = p
    w.pin(prev, physics.ground, vec2(580, 512))
    loop i in 0..5: add_ball(vec2(250 + 60 * f64(i), 300), 16 + 3 * f64(i % 3))
    # a wrecking ball on a rope, pulled aside
    ball = w.add_circle(vec2(640, 160), 40, density = 6, friction = 0.3)
    paint(ball, rgb(0.2, 0.22, 0.25))
    rope = w.rod(physics.ground, ball, vec2(1000, 60), vec2(640, 160), rope = true)

setup()

update = (dt: f64):
    global grab
    if key_pressed(.escape): quit()
    if key_pressed(.r): setup()
    m = mouse_pos()
    if mouse_pressed(.left):
        loop b in w.bodies_at(m):
            if w.kind(b) == .dynamic:
                grab = w.drag(b, m)
                break
    if let g = grab:
        if mouse_down(.left): w.drag_to(g, m)
        else:
            w.remove(g)
            grab = none
    if mouse_pressed(.right): add_box(m, vec2(30 + 20 * random(), 30 + 20 * random()))
    if mouse_pressed(.middle) or key_pressed(.b): add_ball(m, 12 + 14 * random())
    w.step(dt)

draw = ():
    clear(rgb(0.1, 0.11, 0.14))
    if let r = rope:
        a, b = w.ends(r)
        line(a, b, 3, rgb(0.6, 0.6, 0.55))
    loop b in w.bodies():
        pts = w.outline(b)
        c = fills.get(b.id, WHITE)
        polygon(pts, c)
        polyline(pts, 2, darken(c, 0.35), closed = true)
        if w.radius(b) > 0.0: line(w.pos(b), pts[0], 2, darken(c, 0.35))
    if let g = grab:
        a, b = w.ends(g)
        line(a, b, 2, rgb(1.0, 0.9, 0.5))
        circle(b, 4, rgb(1.0, 0.9, 0.5))
    text("drag: left mouse   box: right click   ball: middle click or B   R: start over", vec2(20, 20), 22, rgb(0.8, 0.82, 0.88))
