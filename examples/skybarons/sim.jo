                gun(vec3(-14.5, 57.6, -7.0), vec3(-0.71, 0.64, -0.28), 72.0), gun(vec3(14.5, 57.6, -7.0), vec3(0.71, 0.64, -0.28), 72.0),
                gun(vec3(0.0, -55.0, -40.0), vec3(0.00, -0.97, -0.24), 70.0), gun(vec3(0.0, -53.4, 62.0), vec3(0.00, -0.97, 0.24), 70.0)]
const ZEP_SPEED = 21.0          # m/s at full throttle
const ZEP_TURN = 0.13           # radians a second
const ZEP_CLIMB = 6.0           # m/s

# ---------------- what is in a tick ----------------
# a player's controls for a tick (the computer's too)
struct Pad:
    pitch = 0                   # -100 (dive; on foot: ahead) .. 100 (climb; on foot: back)
    roll = 0                    # -100 (left) .. 100 (right): on foot, a step aside
    yaw = 0                     # -100 (left) .. 100 (right)
    throttle = 0                # -1, 0, 1 (-1 with the throttle shut: the brakes; on foot, 1 runs)
    fire = false
    rocket = false
    bomb = false
    enter = false               # get in (a craft's seat, a gun on the ground)
    leave = false               # get out (landed), bail out (flying), open the parachute, leave a gun; on foot back to one's field (or the air)
    seat = 0                    # 1, 2...: move to that seat of the craft
    scope = false               # (the ornithopter: through its scope, the long gun fires)
    kick = false                # (G: one's own side out of one's craft; on foot, out of the pilot's seat)
    aim_yaw = 0                 # where this player looks (a gunner aims, one on foot faces):
    aim_pitch = 0               # in thousandths of a radian, the world's way (yaw 0: -z)
    computer = false            # (the computer plays it: a player who left)
    witch = false               # (one's rocketeer a witch on a broom, or back)
    stand = false               # (U: up out of one's seat, on the craft's deck)

struct Craft:
    kind: int
    team: int                   # its colors: the side it is, as seen, whoever is in it
    pos: vec3
    vel: vec3
    rot: vec4                   # (a quaternion: the nose is -z, the right wing +x, up +y)
    throttle = 0.8
    health = 100
    heat = 0
    jammed = false
    cooldown = 0
    shots = 0                   # fired so far (the guns take turns)
    rockets = 0
    bombs = 0
    rcool = 0                   # (ticks until the next rocket or bomb)
    seats: int[] = []           # the person in each seat (-1: none)
    aims: vec3[] = []           # each gunner's gun, the world's way
    gheat: int[] = []           # each gunner's gun's heat and cooldown
    gcool: int[] = []
    gtarget: int[] = []         # (each of the computer's gunners: the craft it aims at)
    down = 0                    # ticks since it was shot down (0: flying)
    gone = 0                    # ticks until its wreck is cleared (its stand has it again)
    free = false                # (a slot with no craft in it)
    landed = false              # on the ground: standing, rolling, taking off
    home = -1                   # its stand (world.stands), -1: none
    owner = -1                  # (a craft of one's own, in fights that start in the air: its person)
    safe = 0                    # ticks it cannot be hit (just back)
    target = -1                 # (the computer's pilot: the craft it goes after)
    marked: int[] = [0, 0]      # until which tick each side knows who is in it (it shot at them)
    by = -1                     # (the person who last hit it)
    manned = -100000            # (the last tick someone flew it)
    rest = 0                    # (ticks it has stood still at its own field: rearmed after 3 s)
    knock = 0                   # (ticks since it hit another craft: not again till they part)
    wait = 0                    # (the computer's pilot: ticks it has waited for a player to come aboard)
    lean = vec2(0, 0)           # (a helicopter's: x to the right, y ahead, in radians)
    boulders = 0                # (da Vinci's: how many it has, one in the trebuchet's sling, the rest piled on its deck)
    dig = 0                     # (ticks it has dug for one)
    life = 0                    # (a drone's: ticks left)
    ccool: int[] = []           # (a balloon's cannons: ticks till each fires again)
    cgap = 0                    # (and till any of them does)
    since = 0                   # (the tick it was put on its stand)
    fuse0 = -1.0                # (the height Red's guns set their shells to burst at, firing at it: -1 none yet)
    fuse1 = -1.0                # (and Blue's)
    crew = 0                    # (da Vinci's: how its crew is drawn, models.DV_ROW or DV_PEDAL)
    taims: vec3[] = []          # (the little screw's automatic guns: the way each points, the world's way,
    tcool: int[] = []           # and ticks till it fires again)

# (one of the ball fight's balls)
struct Ball:
    kind: int
    pos: vec3
    vel: vec3
    home: vec3                  # (where it comes back, in the middle: after a goal, or long left)
    carrier = -1                # (the person carrying it, a carry ball)
    by = -1                     # (the person who touched it last)
    touched = 0                 # (the tick it was last touched)
    free_at = 0                 # (dropped or back: the tick from which it can be taken)
    dropper = -1                # (who dropped it: not theirs again for 2 s)
    hit_at = -100               # (the tick it was last struck hard, for its sound)
    jolts = 0                   # (carried: the hurt its carrier has taken since)

# a person: on foot, in a seat, falling, under a parachute, or dead for a while
const WALK = 0
const SEATED = 1
const FALL = 2
const CHUTE = 3
const DEAD = 4
const POST = 5                  # at a gun on the ground (Building `post`)

struct Person:
    team: int
    player = -1                 # (-1: the computer)
    pos = vec3(0, 0, 0)
    vel = vec3(0, 0, 0)
    yaw = 0.0
    state = DEAD
    craft = -1
    seat = -1
    timer = 1                   # (dead: ticks until back; falling: since it began)
    held = 0                    # (the buttons held the tick before: 1 use, 2 rocket, 4 bomb)
    seat_held = 0
    kills = 0
    deaths = 0
    carry = -1                  # (the flag carried: its side; -1 none)
    post = -1                   # (the gun on the ground manned)
    goal = -1                   # (the computer's: the craft it walks to)
    kind = FIGHTER              # what it flies when it starts in the air
    torn = false                # (its parachute shot through: it falls)
    cool = 0                    # (ticks until its pistol fires again)
    opened = 0                  # (falling: the timer when its parachute opened)
    witch = false               # (its rocketeer seen as a witch on a broom)
    left = -1                   # (falling: the craft bailed out of, not landed on again at once)
    deck = vec3(0, 0, 0)        # (on foot on a craft, `craft` it: where one stands, its frame)
    step = vec3(0, 0, 0)        # (and how fast one goes on it, its frame)
    walked = false              # (falling: off a deck walking, not bailing out: on it again if it comes under)

struct Bullet:
    pos: vec3
    vel: vec3
    by: int                     # (the person who fired it; -1 a gun of no one's)
    craft: int                  # (the craft it came from: it does not hit that)
    team: int                   # (the side of who fired it)
    life: int
    damage = DAMAGE
    snipe = false               # (the ornithopter's long gun's)
    bolt = false                # (a ballista's)
    heavy = false               # (a gun tower's: a long, bright tracer)
    flame = false               # (a siphon's gout of burning oil)

# a rocket, a bomb, or a shell from a gun against aircraft (it bursts at a time)
const ROCKET = 0
const BOMB = 1
const FLAK = 2
const PACK = 3                  # (a health pack: it seeks a craft ahead, any side's, and heals it)
const BOULDER = 4               # (da Vinci's: whatever it hits goes down)
const CANNONBALL = 5            # (a balloon's cannon's)
const POT = 6                   # (the little screw's fire pot: it bursts by what it passes, and burns)
struct Shot:
    kind: int
    pos: vec3
    vel: vec3
    by: int
    craft: int
    team: int
    life: int

# something on the ground (world.Site), with what it can still take
struct Building:
    kind: int
    team: int
    pos: vec3
    yaw: f64
    health: int
    aim = vec3(0, 1, 0)         # (a gun's barrel)
    cool = 0
    crew = -1                   # (a gun: the person at it; -1 its own crew, the computer)
    heat = 0
    shots = 0                   # (fired so far: for its sound)
    back = 0                    # (a target shot down: ticks until it stands again)

struct Flag:
    team: int
    home: vec3
    pos: vec3
    real = true                 # (Flag raid: the attackers have none, only where it would be)
    carrier = -1                # (the person carrying it)
    out = 0                     # (ticks since it was dropped away from home; back at 1800)

# what happened, to show and hear (who and by as each kind says)
const HIT = 0                   # a hit on craft `who`
const DIRT = 1                  # a bullet into the ground
const BLAST = 2                 # craft `who` exploding
const SHOT_DOWN = 3             # craft `who` shot down by person `by`
const CRASHED = 4               # craft `who` flown into the ground
const BURST = 5                 # a rocket's or a bomb's burst (`who`: 0 rocket, 1 bomb)
const FLAK_BURST = 6
const KILLED = 7                # person `who` killed (by person `by`, -1 none)
const RUINED = 8                # building `who` destroyed (by person `by`)
const OPENED = 9                # person `who`'s parachute open
const SPLASH = 10               # into the water
const TAKEN = 11                # flag `who` taken by person `by`
const SCORED = 12               # flag `who` brought home by person `by`
const RETURNED = 13             # flag `who` back at its home
const FIRED = 14                # a rocket away (`who` craft)
const DROPPED = 15              # a bomb away (`who` craft)
const LANDED = 16               # craft `who` down on the ground, whole
const DITCHED = 17              # craft `who` landed on the water: sinking
const BAILED = 18               # person `who` out of craft `by`
const BOARDED = 19              # person `who` in craft `by`
const TORN = 20                 # person `who`'s parachute shot through by person `by`
const HEALED = 21               # craft `who` healed by person `by`
const SNIPED = 22               # craft `who`'s long gun fired (by person `by`)
const HEADSHOT = 23             # person `who`, in a craft, killed by a long gun's shell from `by`
const PISTOL = 24               # person `who` fired a pistol
const KICKED = 25               # person `who` put out of their seat by person `by`
const DUG = 26                  # craft `who` has a boulder in its sling
const THROWN = 27               # craft `who` threw its boulder
const LAUNCHED = 28             # drone `who` launched (from craft `by`)
const CANNON = 29               # a balloon's cannon fired (craft `who`)
const SMASHED = 30              # craft `who` hit by a boulder thrown by person `by`
const RAMMED = 31               # craft `who` rammed by the cat flown by person `by`
const MENDED = 32               # target `who` (a building) standing again
const STRUCK = 33               # ball `who` struck by the craft of person `by`
const CAUGHT = 34               # ball `who` taken by person `by`
const LOOSE = 35                # ball `who` dropped by person `by`
const GOAL = 36                 # ball `who` through a ring (pos: the ring's middle), last touched by person `by`
const BALL_BACK = 37            # ball `who` back in the middle, long left alone
const POTTED = 38               # a fire pot burst (`who`: the craft it came from), thrown by person `by`
const GOLD_WON = 39             # the golden cat (craft `who`) shot down by person `by`: their side has won
const GOLD_OUT = 40             # the golden cat (craft `who`) out
const SWAPPED = 41              # person `by` took the seat of `who` (one of the computer's, of their side)
const ABOARD = 42               # person `who`, falling, landed aboard craft `by`, in a seat
const SCORCHED = 43             # craft `who` caught by a siphon's fire from person `by`
struct Boom:
    pos: vec3
    kind: int
    tick: int
    who: int
    by = -1

struct Rules:
    mode = DOGFIGHT
    friendly_fire = false
    ground_start = true         # each side starts on foot at its field (else in the air)
    rockets = true
    win = 0                     # crafts shot down (Dogfight), flags home (0: the fight's own number)
    time_limit = 0              # minutes (0: the fight's own): then the defenders have won
    attackers = 0               # (the fights one side attacks: which)
    crafts = 0                  # the kinds there are (a bit each: 1 << kind; 0 the fight's own)
    plain = false               # no one's screen marks the crafts (the skies scanned by eye; the
                                # sim does not read it)

# (a craft in the air, for the computer's pilots to keep clear of: which, where, how fast, how wide)
struct Near:
    craft: int
    pos: vec3
    vel: vec3
    reach: f32

# (a craft whole and on the ground this tick: what the computer's people on foot and taxiing
# look at, made once a tick, read without copying the craft)
struct Parked:
    craft: int
    pos: vec3
    vel: vec3
    kind: int
    team: int
    flown: bool                 # (someone in its pilot's seat)
    idle: int                   # (ticks since it was put there or last flown)

struct Game:
    crafts: Craft[]
    people: Person[]
    bullets: Bullet[]
    shots: Shot[]
    buildings: Building[]
    flags: Flag[]
    booms: Boom[]               # (the last 2 s of them)
    rules: Rules
    skill = 0.65                # the computer's: 0 to 1
    scores: int[] = [0, 0]      # each side's
    tick = 0
    winner = -1                 # (the side)
    goals: int[] = [-1, -1]     # (each side's target on the ground, this tick: mission_target)
    air: Near[] = []            # (the crafts in the air this tick: avoid's, made once a tick)
    crew: int[] = []            # (each craft's crew's side this tick: crew_team, made once a tick)
    ground: Parked[] = []       # (the crafts whole on the ground this tick, made once a tick)
    bomber = -1                 # (Bomber escort: the person who flies the attackers' bomber)
    bomber_kind = ULTRA
    balls: Ball[] = []          # (the ball fight's)
    gold = -1                   # (the golden cat: its craft, -1 none out)
    gold_at = GOLD_FIRST        # (and the tick it comes out, when none is)

# ---------------- a fight ----------------
# the planes each side has on its field, for n people a side
field_kinds = (n: int, mode: int, crafts: int) -> int[]:
    if mode == CLASSIC: return fill(FIGHTER, n + 2)
    if cat_fight(mode): return thunderdome_kinds(n, crafts)
    # (the flying castle: one a side, whatever the side's numbers)
    k = [ZEPPELIN, ULTRA, BALLOON, ROCKETEER, BOMBER, DAVINCI, CARCOPTER, SCREW, CASTLE]
    if n >= 4: k.push(BOMBER)
    if n <= 6:
        loop i in 0..n + 1: k.push(FIGHTER)
        loop i in 0..(n + 1) / 2 + 1: k.push(SCOUT)
        k.push(ORNITHOPTER)
    else:
        # (many a side: about a craft each, and a few more; not twice as many standing about.
        # An ornithopter or a few; and in the big fights more of the big ones: zeppelins,
        # ultra bombers, balloons, the helicopters)
        loop i in 0..n / 8: k.push(BOMBER)
        loop i in 0..n / 2: k.push(FIGHTER)
        loop i in 0..n / 4: k.push(SCOUT)
        loop i in 0..1 + n / 24: k.push(ORNITHOPTER)
        loop i in 0..n / 12:
            k.push(ULTRA)
            k.push(BALLOON)
            k.push(DAVINCI)
            k.push(CARCOPTER)
            k.push(SCREW)
        loop i in 0..min(n / 12, 4): k.push(ZEPPELIN)
    k = k.filter((x): crafts & (1 << x) != 0)
    # (a craft to fly for everyone on the side, and one more: what is allowed, more of it, the
    # small ones first; rocketeers only when nothing else is)
    # (the ornithopter late: not a field of them)
    more = [FIGHTER, SCOUT, BOMBER, CARCOPTER, SCREW, DAVINCI, ORNITHOPTER, BALLOON, ULTRA, ZEPPELIN].filter((x): crafts & (1 << x) != 0)
    if more.len() == 0: more = [ROCKETEER]
    i = 0
    loop k.len() < n + 1:
        k.push(more[i % more.len()])
        i += 1
    k

# (the Thunderdome's fields: the cat, rocketeers and ornithopters about half and half, and a few of
# anything else the lobby has added; a craft for everyone and one more)
thunderdome_kinds = (n: int, crafts: int) -> int[]:
    k = [CAT]
    loop i in 0..n / 2 + 1:
        k.push(ROCKETEER)
        k.push(ORNITHOPTER)
    loop x in [FIGHTER, SCOUT, CARCOPTER, SCREW, DAVINCI, BOMBER, BALLOON, ULTRA, ZEPPELIN]:
        loop i in 0..max(1, n / 6): k.push(x)
    k.push(CASTLE)
    k = k.filter((x): crafts & (1 << x) != 0)
    more = [ROCKETEER, ORNITHOPTER, FIGHTER, SCOUT, CARCOPTER, SCREW, DAVINCI].filter((x): crafts & (1 << x) != 0)
    if more.len() == 0: more = [CAT]
    i = 0
    loop k.len() < n + 1:
        k.push(more[i % more.len()])
        i += 1
    k

# (the kinds a fight has: the lobby's choice, in the fights it applies to)
allowed = (g: Game, kind: int) -> bool:
    m = g.rules.mode
    if m == CLASSIC: return kind == FIGHTER
    if m == TRENCH or m == ESCORT: return DEFAULT_CRAFTS & (1 << kind) != 0
    g.rules.crafts & (1 << kind) != 0

# what wins a fight unless the lobby says: crafts shot down, flags home; and its time (minutes,
# 0 none: then the defenders have won; in Bomber raids, the factory less hurt)
default_win = (m: int) -> int:
    if m == DOGFIGHT or m == CLASSIC: return 10
    if m == FLAG or m == FLAG_RAID: return 3
    if m == THUNDERDOME: return THUNDERDOME_WIN
    if m == BROOMS: return BROOMS_WIN
    1
default_minutes = (m: int) -> int:
    if m == TRENCH: return 5
    if m == ESCORT or m == FLAG_RAID: return 6
    if m == RAIDS or m == THUNDERDOME: return 8
    if m == BROOMS: return 10
    0

# a fight: pilots says who each person is (one player number, or -1 the computer, for each;
# person i is on side i % 2), kinds what each player flies when they start in the air. Bikes &
# Brooms: one more, last, the player who flies the golden cat (-1: the computer does)
new_game = (pilots: int[], skill: f64, rules: Rules, kinds: int[]) -> Game:
    n = pilots.len() / 2
    let g = Game([], [], [], [], [], [], [], rules, skill = skill)
    m = rules.mode
    if g.rules.win <= 0: g.rules.win = default_win(m)
    if m == CLASSIC: g.rules.rockets = false
    if m == TRENCH or m == ESCORT or g.rules.crafts & ALL_CRAFTS == 0: g.rules.crafts = mode_default(m)
    # (what the fight can have, and what it must)
    g.rules.crafts = (g.rules.crafts & MODE_CAN[m]) | MODE_MUST[m]
    if g.rules.crafts == 0: g.rules.crafts = (DEFAULT_CRAFTS & MODE_CAN[m]) | MODE_MUST[m]
    if g.rules.time_limit <= 0: g.rules.time_limit = default_minutes(m)
    if not one_sided(m): g.rules.attackers = 0
    loop s in sites(m, g.rules.attackers):
        g.buildings.push(Building(s.kind, s.team, s.pos, s.yaw, site_health(s.kind)))
    if m == FLAG or m == FLAG_RAID:
        # (Flag raid: the defenders' flag alone; the attackers bring it to where theirs would be)
        loop t in 0..2:
            h = on_field(t, -STRIP_LONG + 230.0, -STRIP_WIDE - 40.0)
            g.flags.push(Flag(t, h, h, real = m == FLAG or t != g.rules.attackers))
    if m == BROOMS: g.balls = ball_set(n)
    if starts_on_ground(g, 0) or starts_on_ground(g, 1):
        loop st in 0.. and s in stands(field_kinds(n, m, g.rules.crafts)):
            if not starts_on_ground(g, s.team): continue
            c = parked(s.kind, s.team, s.pos, s.yaw)
            c.home = st
            g.crafts.push(c)
    # (Bomber escort: the attackers' one bomber, the first of their players to choose one, as
    # they chose it; else the computer's, an ultra)
    if m == ESCORT:
        loop i in 0..2 * n:
            want = if pilots[i] >= 0 and pilots[i] < kinds.len(): kinds[pilots[i]] else: -1
            if g.bomber < 0 and i % 2 == g.rules.attackers and (want == BOMBER or want == ULTRA):
                g.bomber = i
                g.bomber_kind = want
        if g.bomber < 0:
            loop i in 0..2 * n:
                if g.bomber < 0 and i % 2 == g.rules.attackers and pilots[i] < 0: g.bomber = i
        if g.bomber < 0: g.bomber = g.rules.attackers
    loop i in 0..2 * n:
        p = Person(i % 2, player = pilots[i])
        p.kind = start_kind(g, i, if pilots[i] >= 0 and pilots[i] < kinds.len(): kinds[pilots[i]] else: -1)
        p.timer = 1 + i
        g.people.push(p)
    if m == BROOMS and pilots.len() > 2 * n and pilots[2 * n] >= 0:
        p = Person(GOLD, player = pilots[2 * n], kind = CAT, pos = GOLD_LOFT)
        g.people.push(p)
        g.gold_at = GOLD_FIRST_PLAYER
    g

# what person i flies, starting in the air: as chosen (want: -1 none), or as the fight has it
start_kind = (g: Game, i: int, want: int) -> int:
    m = g.rules.mode
    if m == CLASSIC: return FIGHTER
    # (Escort: the attackers' one bomber; the rest escort it)
    if m == ESCORT and i == g.bomber: return g.bomber_kind
    big = (k: int) -> bool: k == BOMBER or k == ULTRA or k == ZEPPELIN or k == BALLOON
    if want >= 0 and want < KINDS.len() and allowed(g, want):
        if big(want) and (m == TRENCH or m == ESCORT): return FIGHTER
        # (one cat a side; one rocketeer a side, when there is anything else to fly, but in
        # the Thunderdome)
        if want == CAT and has_cat(g, i): return fallback_kind(g)
        if want == CASTLE and has_castle(g, i): return fallback_kind(g, CASTLE)
        if want == ROCKETEER and others_allowed(g) and not cat_fight(m):
            loop j in 0.. and o in g.people:
                if j != i and o.team == i % 2 and o.kind == ROCKETEER: return fallback_kind(g)
        return want
    if m == TRENCH: return if i / 2 % 2 == 0: FIGHTER else: SCOUT
    # (Bikes & Brooms: the computer's on brooms and bikes, every third in a balloon, as the fight allows)
    if m == BROOMS:
        loop b in (if i / 2 % 3 == 2: [BALLOON, ROCKETEER, ORNITHOPTER] else: if i / 2 % 3 == 1: [ORNITHOPTER, ROCKETEER, BALLOON] else: [ROCKETEER, ORNITHOPTER, BALLOON]):
            if allowed(g, b): return b
        return fallback_kind(g)
    # (the Thunderdome: the computer's first of each side the cat, the rest on rockets and wings)
    if cat_fight(m):
        b = if i / 2 == 0 and not has_cat(g, i): CAT else: if i / 2 % 2 == 0: ORNITHOPTER else: ROCKETEER
        if allowed(g, b): return b
        return fallback_kind(g)
    # (the computer's: a mix, by its number, of what the fight allows)
    mix = [FIGHTER, SCOUT, FIGHTER, FIGHTER, SCOUT, FIGHTER]
    k = mix[i / 2 % mix.len()]
    if m != ESCORT and allowed(g, k): return k
    fallback_kind(g)

# (the first allowed of these: what one flies who chose nothing, or what is not to be had; not
# skip)
fallback_kind = (g: Game, skip: int = -1) -> int:
    loop k in [FIGHTER, SCOUT, ORNITHOPTER, CARCOPTER, SCREW, DAVINCI, BOMBER, ULTRA, ZEPPELIN, BALLOON, ROCKETEER, CASTLE, CAT]:
        if k != skip and allowed(g, k): return k
    FIGHTER

# (another of person i's side flies the flying castle)
has_castle = (g: Game, i: int) -> bool:
    loop j in 0.. and o in g.people:
        if j != i and o.team == i % 2 and o.kind == CASTLE: return true
    false

# (another of person i's side flies the cat)
has_cat = (g: Game, i: int) -> bool:
    loop j in 0.. and o in g.people:
        if j != i and o.team == i % 2 and o.kind == CAT: return true
    false

# (any kind allowed but the rocketeer)
others_allowed = (g: Game) -> bool:
    loop k in 0..KINDS.len():
        if k != ROCKETEER and allowed(g, k): return true
    false

starts_on_ground = (g: Game, team: int) -> bool:
    m = g.rules.mode
    if m == CLASSIC: return false
    # (the raiders come by air; the defenders take off to meet them)
    if m == TRENCH or m == ESCORT: return team != g.rules.attackers
    g.rules.ground_start

# a craft standing at pos, facing yaw, with no one in it
parked = (kind: int, team: int, pos: vec3, yaw: f64) -> Craft:
    k = KINDS[kind]
    c = Craft(kind, team, pos + vec3(0, f32(k.gear), 0), vec3(0, 0, 0), ground_rot(yaw, k.tilt), throttle = 0.0, health = k.health, rockets = k.rockets, bombs = k.bombs, landed = true)
    c.seats = fill(-1, k.seats.len())
    if kind == BALLOON: c.ccool = fill(0, CANNONS)
    if kind == SCREW:
        c.taims = SCREW_AUTO_A.map((a): screw_out(a, 0.1))
        c.tcool = fill(0, SCREW_AUTOS.len())
    c.aims = k.seats.map((s): s.dir)
    # (the flying castle's automatic guns: after its seats')
    n = k.seats.len()
    if kind == CASTLE:
        c.aims.extend(CASTLE_AUTOS.map((s): s.dir))
        n += CASTLE_AUTOS.len()
    c.gheat = fill(0, n)
    c.gcool = fill(0, n)
    c.gtarget = fill(-1, n)
    c

# a craft in the air, flying the way dir at a speed it holds
flying_craft = (kind: int, team: int, pos: vec3, dir: vec3) -> Craft:
    k = KINDS[kind]
    c = parked(kind, team, pos, 0.0)
    c.pos = pos
    c.rot = quat_facing(dir)
    speed = if k.lighter: ZEP_SPEED * 0.7 else: k.stall * 1.9
    c.vel = dir * f32(speed)
    c.throttle = 0.8
    c.landed = false
    if kind == DAVINCI: c.boulders = BOULDERS
    c

# (standing: turned to yaw, the nose up by tilt)
ground_rot = (yaw: f64, tilt: f64) -> vec4: quat_mul(quat_axis_angle(vec3(0, 1, 0), yaw), quat_axis_angle(vec3(1, 0, 0), tilt))

fwd_of = (c: Craft) -> vec3: quat_rotate(c.rot, vec3(0, 0, -1))
right_of = (c: Craft) -> vec3: quat_rotate(c.rot, vec3(1, 0, 0))
up_of = (c: Craft) -> vec3: quat_rotate(c.rot, vec3(0, 1, 0))
# a point of a craft (its own way) in the world
point_of = (c: Craft, at: vec3) -> vec3: c.pos + quat_rotate(c.rot, at)

alive = (c: Craft) -> bool: not c.free and c.gone == 0
flying = (c: Craft) -> bool: alive(c) and c.down == 0 and not c.landed
whole = (c: Craft) -> bool: alive(c) and c.down == 0

# the side of who is in craft c (its pilot's; a gunner's; else its colors)
crew_team = (g: Game, c: Craft) -> int:
    loop k in c.seats:
        if k >= 0: return g.people[k].team
    c.team

manned = (c: Craft) -> bool:
    loop k in c.seats:
        if k >= 0: return true
    false

pilot_of = (c: Craft) -> int: if c.seats.len() > 0: c.seats[0] else: -1

# (the same, of craft j, by its number: in a loop over many crafts a craft passed to a function
# is copied, its arrays counted, where reading its fields is not)
manned_at = (g: Game, j: int) -> bool:
    loop s in 0..g.crafts[j].seats.len():
        if g.crafts[j].seats[s] >= 0: return true
    false
crew_at = (g: Game, j: int) -> int:
    loop s in 0..g.crafts[j].seats.len():
        k = g.crafts[j].seats[s]
        if k >= 0: return g.people[k].team
    g.crafts[j].team
# (the side craft j seems to side v: g.crew, made once a tick)
seen_at = (g: Game, j: int, v: int) -> int: if g.crafts[j].marked[v] > g.tick: g.crew[j] else: g.crafts[j].team

# the side craft c seems, to side `viewer`: its colors, unless they know better (it shot at them)
seen_team = (g: Game, c: Craft, viewer: int) -> int:
    if c.marked[viewer] > g.tick: return crew_team(g, c)
    c.team

# (whether harm from side `from` counts against side `to`: always, or across sides alone)
harms = (g: Game, from: int, to: int) -> bool: g.rules.friendly_fire or from != to

# ---------------- one tick (1/60 s) ----------------
# pads: each player's
tick = (g: Game, pads: Pad[]) -> Game:
    let g = g
    g.tick += 1
    loop t in 0..2: g.goals[t] = find_target(g, t)
    g.air = []
    g.crew = []
    g.ground = []
    loop j in 0..g.crafts.len():
        g.crew.push(crew_at(g, j))
        if g.crafts[j].landed and not g.crafts[j].free and g.crafts[j].gone == 0 and g.crafts[j].down == 0 and g.crafts[j].kind != DRONE:
            g.ground.push(Parked(j, g.crafts[j].pos, g.crafts[j].vel, g.crafts[j].kind, g.crafts[j].team, g.crafts[j].seats.len() > 0 and g.crafts[j].seats[0] >= 0, g.tick - max(g.crafts[j].since, g.crafts[j].manned)))
        if not g.crafts[j].free and g.crafts[j].gone == 0 and g.crafts[j].down == 0 and not g.crafts[j].landed:
            h = KINDS[g.crafts[j].kind].half
            g.air.push(Near(j, g.crafts[j].pos, g.crafts[j].vel, max(h.x, h.z)))
    choose_targets(g)
    # (each person's controls: its player's, or the computer's)
    each: Pad[]
    loop i in 0..g.people.len():
        p = g.people[i]
        if p.player >= 0 and p.player < pads.len() and not pads[p.player].computer: each.push(pads[p.player])
        else if p.team == GOLD: each.push(Pad(computer = true))
        else: each.push(bot_pad(g, i))
    loop i in 0..g.people.len(): person(g, i, each[i])
    loop i in 0..g.crafts.len():
        if g.crafts[i].free: continue
        # (one standing still with no one in it: nothing to do but count down its safety)
        if g.crafts[i].landed and g.crafts[i].gone == 0 and g.crafts[i].down == 0 and g.crafts[i].vel == vec3(0, 0, 0) and not manned_at(g, i):
            if g.crafts[i].safe > 0: g.crafts[i].safe -= 1
            continue
        if g.crafts[i].kind == DRONE:
            fly(g, i, bot_drone(g, i), true)
            continue
        if g.crafts[i].team == GOLD:
            gp = pilot_of(g.crafts[i])
            fly(g, i, if gp >= 0 and not each[gp].computer: each[gp] else: gold_pad(g, i), true)
            continue
        pi = pilot_of(g.crafts[i])
        fly(g, i, if pi >= 0: each[pi] else: Pad(), pi >= 0)
        gunners(g, i, pads)
        if g.crafts[i].kind == SCREW: screw_autos(g, i)
    # (those on a deck where it is now)
    loop i in 0..g.people.len():
        k = g.people[i].craft
        if g.people[i].state == WALK and k >= 0 and alive(g.crafts[k]): g.people[i].pos = point_of(g.crafts[k], g.people[i].deck)
    collide(g)
    rams(g)
    if g.balls.len() > 0: balls(g)
    if g.rules.mode == BROOMS: golden_cat(g)
    shoot(g)
    shells(g)
    guns_on_ground(g, each)
    flags(g)
    rules(g)
    kept: Boom[]
    loop b in g.booms:
        if g.tick - b.tick < 120: kept.push(b)
    g.booms = kept
    g

score = (g: mut Game, team: int, n: int = 1):
    if g.winner >= 0: return
    g.scores[team] += n
    m = g.rules.mode
    if g.scores[team] >= g.rules.win and (m == DOGFIGHT or m == CLASSIC or m == FLAG or m == FLAG_RAID or cat_fight(m)): g.winner = team

# (the Thunderdome: each target shot down stands again, its time up)
targets_back = (g: mut Game):
    loop j in 0..g.buildings.len():
        k = g.buildings[j].kind
        if (k != TARGET and k != NEST) or g.buildings[j].health > 0: continue
        g.buildings[j].back -= 1
        if g.buildings[j].back <= 0:
            g.buildings[j].health = site_health(k)
            g.booms.push(Boom(g.buildings[j].pos, MENDED, g.tick, j))

# who has won, for the fights won otherwise than by a score
rules = (g: mut Game):
    if g.winner >= 0: return
    m = g.rules.mode
    att = g.rules.attackers
    late = g.rules.time_limit > 0 and g.tick >= g.rules.time_limit * 3600
    if m == BASES:
        loop t in 0..2:
            left = 0
            loop b in g.buildings:
                if b.team == t and b.health > 0 and (b.kind == HANGAR or b.kind == TANK or b.kind == HQ): left += 1
            if left == 0: g.winner = 1 - t
    if m == TRENCH or m == ESCORT:
        want = if m == TRENCH: DEPOT else: FACTORY
        loop b in g.buildings:
            if b.kind == want and b.team != att and b.health <= 0: g.winner = att
        if g.winner < 0 and m == ESCORT and g.tick > 60 * 185:
            # (the attackers' bombers all lost, in the last half of the time: they do not come back)
            left = 0
            loop c in g.crafts:
                if not c.free and (c.kind == BOMBER or c.kind == ULTRA) and c.team == att and c.down == 0 and c.gone == 0: left += 1
            if left == 0: g.winner = 1 - att
        if g.winner < 0 and late: g.winner = 1 - att
    if m == FLAG_RAID and late: g.winner = 1 - att
    # (the Thunderdome and Bikes & Brooms: the time up, the side ahead; level, the next points win)
    gp = gold_person(g)
    if m == BROOMS and late and gp >= 0 and g.people[gp].state == SEATED and flying(g.crafts[g.people[gp].craft]): g.winner = GOLD
    if m == BROOMS and late and g.winner < 0 and g.scores[0] != g.scores[1]: g.winner = if g.scores[0] > g.scores[1]: 0 else: 1
    if m == THUNDERDOME:
        targets_back(g)
        if late and g.scores[0] != g.scores[1]: g.winner = if g.scores[0] > g.scores[1]: 0 else: 1
    if m == RAIDS:
        # (a factory down: the other side has won; at the end, the one less hurt)
        share = [1.0, 1.0]
        loop b in g.buildings:
            if b.kind == FACTORY: share[b.team] = f64(b.health) / f64(site_health(FACTORY))
        loop t in 0..2:
            if share[t] <= 0.0: g.winner = 1 - t
        if g.winner < 0 and late and share[0] != share[1]: g.winner = if share[0] > share[1]: 0 else: 1

# ---------------- decks: where one stands on a craft ----------------
# A craft's walkable surface, in its own frame (x right, y up, z back): boxes (or upright
# cylinders, `round`, inside the box) stood on, their tops the floor; those taller than a step
# where one stands stop one. A ramp's top rises from lo.y to hi.y along `up` (1 +x, 2 -x, 3 +z,
# 4 -z). `drawn`: a stair the craft's model does not have, which the game draws. The zeppelin's
# back is its hull (deck_curve). Each craft's decks are what follows its model: when its shape
# changes, these change with it
struct Deck:
    lo: vec3
    hi: vec3
    up = 0
    round = false
    drawn = false
const STEP = 0.6                # (m one steps up without a jump)
const JUMP = 4.6                # (m/s up: a jump of about a meter)
const DECK_DROP = 4.0           # (m down past which one off a ledge falls as from a craft)
const DECK_REACH = 3.5          # (m from one's middle to a seat to get into it from its deck)
deck_box = (x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> Deck: Deck(v3s(x0, y0, z0), v3s(x1, y1, z1))
deck_disc = (x: f64, z: f64, r: f64, y0: f64, y1: f64) -> Deck: Deck(v3s(x - r, y0, z - r), v3s(x + r, y1, z + r), round = true)
v3s = (x: f64, y: f64, z: f64) -> vec3: vec3(f32(x), f32(y), f32(z))

# the flying castle's (models.jo, make_castle): its terraces' floors, the curtain wall's walk, the
# parapets round the terraces and the curtain's merlons (castle_deck_height, as deck_curve); the
# towers on the curtain, their tops (CASTLE_SEATS' guns on them), the bartizans, the gallery over
# the gate; the keep, its turrets, its roof and the bridge; the abbey on the summit, its hall
# below, the boiler houses and their stacks in the way; the stairs up the terraces' faces, and a
# stair up the inside of the curtain either side from the quay to the walk (drawn). The houses not
castle_decks = () -> Deck[]:
    d: Deck[] = [deck_disc(-56.4, -99.6, 11.4, -12.0, 8.0),
                 deck_disc(51.3, -90.6, 11.4, -12.0, 8.0),
                 deck_disc(-59.2, 104.5, 11.4, -12.0, 8.0),
                 deck_disc(56.5, 99.8, 11.4, -12.0, 8.0),
                 deck_disc(-12.6, -136.8, 8.4, -12.0, 6.0),
                 deck_disc(12.6, -137.7, 8.4, -12.0, 6.0),
                 deck_box(-84.4, -12.0, -46.4, -70.4, 5.0, -32.4),
                 deck_box(72.2, -12.0, -47.4, 86.2, 5.0, -33.4),
                 deck_box(-85.7, -12.0, 33.1, -71.7, 5.0, 47.1),
                 deck_box(75.4, -12.0, 35.0, 89.4, 5.0, 49.0),
                 deck_disc(-11.4, 124.1, 7.4, -12.0, 5.0),
                 deck_disc(11.6, 126.7, 7.4, -12.0, 5.0),
                 deck_disc(-36.7, -123.7, 2.7, -3.0, 1.1),
                 deck_disc(35.7, -120.5, 2.7, -3.0, 1.1),
                 deck_disc(-36.2, 122.0, 2.7, -3.0, 1.1),
                 deck_disc(36.4, 122.9, 2.7, -3.0, 1.1),
                 deck_disc(-41.5, -35.3, 2.7, 14.0, 18.1),
                 deck_disc(39.4, -32.6, 2.7, 14.0, 18.1),
                 deck_disc(-39.2, 68.3, 2.7, 14.0, 18.1),
                 deck_disc(36.5, 64.8, 2.7, 14.0, 18.1),
                 deck_box(34.0, 16.0, 29.9, 44.0, 24.8, 44.9),
                 deck_disc(39.0, 37.4, 2.4, 24.8, 46.0),
                 deck_box(34.3, 16.0, 3.0, 44.3, 24.8, 18.0),
                 deck_disc(39.3, 10.5, 2.4, 24.8, 46.0),
                 deck_box(-44.6, 16.0, 30.1, -34.6, 24.8, 45.1),
                 deck_disc(-39.6, 37.6, 2.4, 24.8, 46.0),
                 deck_box(-44.3, 16.0, 3.0, -34.3, 24.8, 18.0),
                 deck_disc(-39.3, 10.5, 2.4, 24.8, 46.0),
                 Deck(v3s(0.3, -8.0, -107.5), v3s(5.3, 4.0, -92.4), up = 3),
                 Deck(v3s(-0.5, 4.0, -68.9), v3s(4.5, 16.0, -53.8), up = 3),
                 Deck(v3s(-1.2, 16.0, -39.7), v3s(3.8, 28.0, -24.6), up = 3),
                 Deck(v3s(18.1, 28.0, 25.5), v3s(30.7, 40.0, 30.5), up = 2),
                 Deck(v3s(-75.6, -8.0, 6.0), v3s(-72.6, -1.0, 20.0), up = 3, drawn = true),
                 Deck(v3s(-77.6, -8.0, 20.0), v3s(-72.6, -1.0, 23.0), drawn = true),
                 Deck(v3s(80.0, -8.0, 6.0), v3s(83.0, -1.0, 20.0), up = 3, drawn = true),
                 Deck(v3s(80.0, -8.0, 20.0), v3s(85.0, -1.0, 23.0), drawn = true)]
    d.push(deck_box(-9, -1, -142.4, 9, 5, -135.4))
    d.push(deck_box(-13, 16, -27, 13, 52, -7))
    loop sx in [-1.0, 1.0]:
        loop z in [-27.0, -7.0]: d.push(deck_disc(sx * 13.0, z, 4.2, 16.0, 56.1))
    d.push(deck_box(-6, 52, -26, 6, 53, -18))
    d.push(deck_box(-7, 40, 6, 7, 55, 46))
    d.push(deck_box(-16, 40, 12, 16, 54, 24))
    d.push(deck_box(-6.6, 40, 11.4, 6.6, 70, 24.6))
    d.push(deck_disc(0, 46, 7.0, 40, 55))
    d.push(deck_box(-31, 28, 10, -21, 43, 50))
    d
CASTLE_DECKS = castle_decks()

# da Vinci's galleass's (models.jo, make_davinci): its deck between the gunwales, the forecastle
# and the stern deck (narrowing to the stem and the transom) and the steps up their middles, the
# fighting top up the middle tower, the towers in the way, the gunwale along the waist (a jump
# over it)
davinci_decks = () -> Deck[]:
    d: Deck[] = []
    d.push(deck_box(-9.8, -9, -27, 9.8, -4, 22))
    d.push(deck_box(-9.0, -9, -31, 9.0, -4, -27))
    d.push(deck_box(-8.8, -9, 22, 8.8, -4, 29))
    loop b in [vec3(-34, -31, 7.8), vec3(-36.5, -34, 6.0), vec3(-38.5, -36.5, 4.1), vec3(-40.5, -38.5, 1.9)]: d.push(deck_box(-f64(b.z), -9.0, f64(b.x), f64(b.z), -2.0, f64(b.y)))
    loop b in [vec3(29, 32, 7.6), vec3(32, 35, 6.0), vec3(35, 38, 4.0)]: d.push(deck_box(-f64(b.z), -9.0, f64(b.x), f64(b.z), -1.4, f64(b.y)))
    d.push(Deck(v3s(-0.9, -4, -31), v3s(0.9, -2, -28.9), up = 4))
    d.push(Deck(v3s(-0.9, -4, 26.9), v3s(0.9, -1.4, 29), up = 3))
    loop sx in [-1.0, 1.0]: d.push(deck_box(sx * 10.05 - 0.25, -4.0, -27.0, sx * 10.05 + 0.25, -3.15, 22.0))
    d.push(deck_box(-4.8, 4.75, -2.3, 4.8, 5.0, 2.3))
    loop r in [vec3(0, 11.35, -26), vec3(0, 14.85, 0), vec3(0, 11.35, 26)]: d.push(deck_box(-1.8, -4.0, f64(r.z) - 1.8, 1.8, f64(r.y), f64(r.z) + 1.8))
    d
DAVINCI_DECKS = davinci_decks()

# the zeppelin's (models.jo, make_zeppelin): its gunners' platforms on its back; the rest of its
# back its hull (deck_curve: models.jo's HULL, its radius along it)
ZEP_DECKS = [deck_disc(0, -25, 1.3, 7.7, 8.2), deck_disc(0, 20, 1.3, 7.2, 8.2)]
ZEP_HULL = [vec2(-45.0, 0.8), vec2(-44.0, 2.6), vec2(-42.0, 4.3), vec2(-39.0, 5.8), vec2(-35.0, 7.0), vec2(-30.0, 7.9), vec2(-24.0, 8.4), vec2(-16.0, 8.65), vec2(0.0, 8.65), vec2(10.0, 8.55), vec2(18.0, 8.0), vec2(25.0, 7.0), vec2(31.0, 5.6), vec2(36.0, 4.1), vec2(40.0, 2.8), vec2(43.0, 1.7), vec2(44.6, 0.9)]
NO_DECKS: Deck[] = []

decks_of = (kind: int) -> Deck[]: if kind == CASTLE: CASTLE_DECKS else: if kind == DAVINCI: DAVINCI_DECKS else: if kind == ZEPPELIN: ZEP_DECKS else: NO_DECKS
has_deck = (kind: int) -> bool: kind == CASTLE or kind == DAVINCI or kind == ZEPPELIN

# (a curved deck's top at x, z: the zeppelin's back, its hull's top across as far as it is not
# too steep to stand on; -1e9 none)
deck_curve = (kind: int, x: f64, z: f64) -> f64:
    if kind == CASTLE: return castle_deck_height(x, z)
    if kind != ZEPPELIN: return -1e9
    r = -1.0
    loop i in 0..ZEP_HULL.len() - 1:
        a = ZEP_HULL[i]
        b = ZEP_HULL[i + 1]
        if r < 0.0 and z >= f64(a.x) and z <= f64(b.x): r = (f64(a.y) + (f64(b.y) - f64(a.y)) * (z - f64(a.x)) / f64(b.x - a.x)) * 0.98
    if r < 0.0 or abs(x) > r * 0.7: return -1e9
    sqrt(r * r - x * x)

# (the flying castle's floor at x, z: its terraces' (castle_walk_height), up a parapet's height in
# the band of their edges (open where a stair comes up), the curtain wall's walk, and its merlons
# along its outer edge; -1e9 off it)
castle_deck_height = (x: f64, z: f64) -> f64:
    y = castle_walk_height(x, z)
    if y < -1e8: return y
    i = 0
    loop k in 0..CASTLE_TIERS.len():
        if CASTLE_TIERS[k].2 == y: i = k
    t = CASTLE_TIERS[i]
    dx = x / 82.0
    dz = (z - t.1) / 135.0
    a = atan2(dz, dx)
    e = sqrt(dx * dx + dz * dz) / (t.0 * castle_wobble(a, i))
    flat = sqrt(x * x + (z - t.1) * (z - t.1))
    inside = flat / max(e, 1e-6) - flat
    seg = (if a < 0.0: a + TAU else: a) / (TAU / 72.0)
    k = int(seg)
    if i == 0:
        if inside > 3.5: return y
        if inside > 1.0: return -1.0
        frac = seg - f64(k)
        half = 1.1 / max(flat / max(e, 1e-6) * TAU / 72.0, 1.0)
        return if abs(frac - 0.25) < half or abs(frac - 0.75) < half: 1.4 else: -1.0
    gap = if i == CASTLE_TIERS.len() - 1: k == 0 or k == 71 else: k == 53 or k == 54
    if inside < 0.9 and not gap: return y + (if i == 2: 2.4 else: 1.2)
    y

# (whether x, z is over deck d, and its top there)
on_deck_box = (d: Deck, x: f64, z: f64) -> bool:
    if x < f64(d.lo.x) or x > f64(d.hi.x) or z < f64(d.lo.z) or z > f64(d.hi.z): return false
    if not d.round: return true
    u = (x - f64(d.lo.x + d.hi.x) / 2.0) / f64(d.hi.x - d.lo.x) * 2.0
    w = (z - f64(d.lo.z + d.hi.z) / 2.0) / f64(d.hi.z - d.lo.z) * 2.0
    u * u + w * w <= 1.0
deck_top = (d: Deck, x: f64, z: f64) -> f64:
    if d.up == 0: return f64(d.hi.y)
    t = if d.up <= 2: (x - f64(d.lo.x)) / f64(d.hi.x - d.lo.x) else: (z - f64(d.lo.z)) / f64(d.hi.z - d.lo.z)
    if d.up == 2 or d.up == 4: t = 1.0 - t
    f64(d.lo.y) + (f64(d.hi.y) - f64(d.lo.y)) * clamp(t, 0.0, 1.0)

# the floor under one standing at l (a kind's frame): the highest top no more than a step over
# their feet (-1e9: none)
deck_floor = (kind: int, l: vec3) -> f64:
    x = f64(l.x)
    z = f64(l.z)
    best = -1e9
    top = f64(l.y) + STEP
    c = deck_curve(kind, x, z)
    if c <= top: best = c
    loop d in decks_of(kind):
        if not on_deck_box(d, x, z): continue
        t = deck_top(d, x, z)
        if t <= top and t > best: best = t
    best

# whether one standing at l would be in something there too tall to step onto
deck_blocked = (kind: int, l: vec3) -> bool:
    x = f64(l.x)
    z = f64(l.z)
    # (a curved deck solid under its top: a terrace's face, a parapet, a merlon)
    c = deck_curve(kind, x, z)
    if c > f64(l.y) + STEP and c - 30.0 < f64(l.y) + 1.7: return true
    loop d in decks_of(kind):
        if not on_deck_box(d, x, z): continue
        if deck_top(d, x, z) > f64(l.y) + STEP and f64(d.lo.y) < f64(l.y) + 1.7: return true
    false

# where one in seat s of a kind stands up: a step back from its gun, else where it is, on the
# floor under it (y -1e9: nowhere to stand)
stand_spot = (kind: int, s: int) -> vec3:
    st = KINDS[kind].seats[s]
    back = vec3(st.dir.x, 0, st.dir.z)
    tries = [st.at]
    if length(back) > 0.1: tries = [st.at - normalize(back) * 1.2, st.at]
    loop t in tries:
        f = deck_floor(kind, t + vec3(0, 0.5, 0))
        if f > f64(t.y) - 4.5 and not deck_blocked(kind, vec3(t.x, f32(f), t.z)): return vec3(t.x, f32(f), t.z)
    vec3(0, -1e9, 0)

# (person i, standing on craft k, a seat of it within reach: the nearest free one; -1 none)
seat_near = (g: Game, k: int, l: vec3) -> int:
    best = -1
    least = DECK_REACH
    loop s in 0.. and st in KINDS[g.crafts[k].kind].seats:
        if g.crafts[k].seats[s] >= 0: continue
        d = f64(length(st.at - l - vec3(0, 1, 0)))
        if d < least:
            least = d
            best = s
    best

# (off the deck of craft k, in the air: falling, as from it; on it again when coming down on it)
off_deck = (g: mut Game, i: int, p0: Person, k: int) -> Person:
    let p = p0
    c = g.crafts[k]
    p.pos = point_of(c, p.deck)
    p.vel = c.vel + quat_rotate(c.rot, p.step)
    p.state = FALL
    p.timer = 0
    p.torn = false
    p.left = k
    p.walked = true
    p.craft = -1
    p.seat = -1
    p

# the craft whose deck person p, falling or under a canopy, comes down on this tick, and where on
# it (its frame); not the one bailed out of just now, but the one walked off
deck_landing = (g: Game, p: Person) -> (int, vec3):
    loop j in 0..g.crafts.len():
        kind = g.crafts[j].kind
        if not has_deck(kind) or g.crafts[j].free or g.crafts[j].gone > 0 or g.crafts[j].down > 0: continue
        if j == p.left and p.timer < 120 and not p.walked: continue
        cp = g.crafts[j].pos
        if f64(length(cp - p.pos)) > f64(length(KINDS[kind].half)) + 10.0: continue
        inv = quat_inverse(g.crafts[j].rot)
        l = quat_rotate(inv, p.pos - cp)
        was = l - quat_rotate(inv, p.vel - g.crafts[j].vel) * f32(DT)
        f = deck_floor(kind, vec3(l.x, was.y, l.z))
        if f > -1e8 and f64(l.y) <= f: return (j, vec3(l.x, f32(f), l.z))
    (-1, vec3(0, 0, 0))

# ---------------- people ----------------
const WALK_SPEED = 5.5
const RUN_SPEED = 10.0
const SWIM_SPEED = 1.8
const CHUTE_FALL = 9.0          # m/s under a parachute
const ENTER = 8.0               # (m from a craft's seat to get in)

person = (g: mut Game, i: int, pad: Pad):
    if g.people[i].team == GOLD:
        gold_seat(g, i)
        return
    let p = g.people[i]
    pressed = pad.enter and p.held & 1 == 0
    out = pad.leave and p.held & 8 == 0
    kicked = pad.kick and p.held & 16 == 0
    stood = pad.stand and p.held & 64 == 0
    if pad.witch and p.held & 32 == 0:
        if p.state == SEATED and (g.crafts[p.craft].kind == DAVINCI or g.crafts[p.craft].kind == SCREW): g.crafts[p.craft].crew = 1 - g.crafts[p.craft].crew
        else: p.witch = not p.witch
    p.held = (if pad.enter: 1 else: 0) | (if pad.rocket: 2 else: 0) | (if pad.bomb: 4 else: 0) | (if pad.leave: 8 else: 0) | (if pad.kick: 16 else: 0) | (if pad.witch: 32 else: 0) | (if pad.stand: 64 else: 0)
    seat_now = pad.seat
    seat_new = seat_now != p.seat_held and seat_now > 0
    p.seat_held = seat_now
    if p.state == DEAD:
        p.timer -= 1
        if p.timer <= 0: respawn(g, i, p)
        else: g.people[i] = p
        return
    if p.state == SEATED:
        c = g.crafts[p.craft]
        # (the pilot: their own side out of the craft, those in the air on parachutes)
        if kicked and p.seat == 0:
            loop s in 1..c.seats.len():
                pk = c.seats[s]
                if pk >= 0 and g.people[pk].team == p.team: put_out(g, pk, i)
            c = g.crafts[p.craft]
        # (a gunner: the pilot, of one's own side, out, and this one in the pilot's seat)
        else if kicked and p.seat > 0 and c.seats[0] >= 0 and g.people[c.seats[0]].team == p.team:
            put_out(g, c.seats[0], i)
            p = change_seat(g, i, p, 0)
            c = g.crafts[p.craft]
        if seat_new: p = change_seat(g, i, p, seat_now - 1)
        c = g.crafts[p.craft]
        # (U: up out of the seat, standing on the deck there)
        spot = if stood and not out and whole(c): stand_spot(c.kind, p.seat) else: vec3(0, -1e9, 0)
        if f64(spot.y) > -1e8:
            g.crafts[p.craft].seats[p.seat] = -1
            p.state = WALK
            p.seat = -1
            p.deck = spot
            p.step = vec3(0, 0, 0)
            p.pos = point_of(c, spot)
            p.vel = c.vel
        else if out:
            if c.landed and f64(length(c.vel)) < 4.0: p = get_out(g, i, p)
            else: p = bail_out(g, i, p)
        else:
            p.pos = point_of(c, KINDS[c.kind].seats[p.seat].at)
            p.vel = c.vel
        g.people[i] = p
        return
    # (on foot, falling, under a canopy: a pistol, where one looks; not swimming)
    if p.cool > 0: p.cool -= 1
    if pad.fire and p.cool == 0 and p.state != POST and not (p.state == WALK and p.craft < 0 and is_water(f64(p.pos.x), f64(p.pos.z))):
        p.cool = PISTOL_GAP
        yaw = f64(pad.aim_yaw) / 1000.0
        pitch = f64(pad.aim_pitch) / 1000.0
        dir = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
        at = p.pos + vec3(0, 1.5, 0) + dir * 0.6
        g.bullets.push(Bullet(at, p.vel + dir * f32(BULLET_SPEED), i, -1, p.team, BULLET_LIFE))
        g.booms.push(Boom(at, PISTOL, g.tick, i))
    if p.state == FALL or p.state == CHUTE:
        p.timer += 1
        # (T, falling, opens the parachute: the key one bailed out with; under it, a second
        # later, back in the fight at once, in the air or at one's field)
        open_now = out and p.state == FALL and not p.torn
        if not open_now and out and p.timer > 10 and (p.state == FALL or p.timer > p.opened + 60):
            if starts_on_ground(g, p.team):
                p.state = DEAD
                p.timer = 120
                g.people[i] = p
                drop_flag(g, i)
            else: respawn(g, i, p)
            return
        if p.state == FALL and not p.torn and (p.timer > 75 or (open_now and p.timer > 10)):
            p.state = CHUTE
            p.opened = p.timer
            g.booms.push(Boom(p.pos, OPENED, g.tick, i))
        if p.state == FALL:
            p.vel.y -= f32(9.8 * DT)
            p.vel = p.vel * f32(1.0 - 0.15 * DT)
        else:
            # (the canopy: the fall slows to CHUTE_FALL, the way it went fades; steered a little)
            # (W spills air from the canopy: down faster, up to twice as fast)
            fall = CHUTE_FALL * (1.0 + max(-f64(pad.pitch) / 100.0, 0.0))
            p.vel.y = f32(approach(f64(p.vel.y), -fall, 6.0, DT))
            h = vec3(p.vel.x, 0, p.vel.z) * f32(1.0 - 1.2 * DT)
            yaw = f64(pad.aim_yaw) / 1000.0
            f = vec3(f32(-sin(yaw)), 0, f32(-cos(yaw)))
            h += f * f32(-f64(pad.pitch) / 100.0 * 2.5 * DT)
            p.vel = vec3(h.x, p.vel.y, h.z)
            p.yaw = yaw
        p.pos += p.vel * f32(DT)
        # (onto a craft, a seat free near: in it)
        k = landing_on(g, i, p)
        if k >= 0:
            p = land_aboard(g, i, p, k)
            g.people[i] = p
            return
        # (a player onto a craft's deck, no seat taken: standing on it)
        dk, at = if p.player >= 0: deck_landing(g, p) else: (-1, vec3(0, 0, 0))
        if dk >= 0:
            if p.state == FALL and f64(length(p.vel - g.crafts[dk].vel)) > 14.0:
                g.people[i] = p
                kill(g, i, -1)
                return
            p.state = WALK
            p.craft = dk
            p.deck = at
            p.step = vec3(0, 0, 0)
            p.left = -1
            p.walked = false
            p.torn = false
            p.pos = point_of(g.crafts[dk], at)
            p.vel = g.crafts[dk].vel
            g.people[i] = p
            return
        gy = ground(f64(p.pos.x), f64(p.pos.z))
        if f64(p.pos.y) <= gy:
            p.pos.y = f32(gy)
            if p.state == FALL and f64(length(p.vel)) > 14.0:
                g.people[i] = p
                kill(g, i, -1)
                return
            p.state = WALK
            p.vel = vec3(0, 0, 0)
            if gy <= 0.0: g.booms.push(Boom(p.pos, SPLASH, g.tick, i))
        g.people[i] = p
        return
    if p.state == POST:
        # (at a gun on the ground: its aim and firing, guns_on_ground; T leaves it)
        b = g.buildings[p.post]
        if out or b.health <= 0:
            g.buildings[p.post].crew = -1
            p.state = WALK
            p.post = -1
            p.pos = b.pos + quat_rotate(quat_axis_angle(vec3(0, 1, 0), b.yaw), vec3(0, 0, 3.0))
            p.pos.y = f32(ground(f64(p.pos.x), f64(p.pos.z)))
        else:
            p.yaw = f64(pad.aim_yaw) / 1000.0
            p.pos = b.pos
        g.people[i] = p
        return
    if p.craft >= 0:
        on_deck(g, i, p, pad, pressed, out, seat_now, seat_new)
        return
    # on foot (or swimming): Shift runs
    p.yaw = f64(pad.aim_yaw) / 1000.0
    f = vec3(f32(-sin(p.yaw)), 0, f32(-cos(p.yaw)))
    r = vec3(-f.z, 0, f.x)
    want = f * f32(-f64(pad.pitch) / 100.0) + r * f32(f64(pad.roll) / 100.0)
    if length(want) > 1.0: want = normalize(want)
    wet = is_water(f64(p.pos.x), f64(p.pos.z))
    want = want * f32(if wet: SWIM_SPEED else: if pad.throttle > 0: RUN_SPEED else: WALK_SPEED)
    # (the computer's people, each at their own pace: some quicker, some slower)
    if p.player < 0: want = want * f32(0.75 + f64(hash(i * 2654435761) % 1000) / 1000.0 * 0.45)
    p.vel = vec3(f32(approach(f64(p.vel.x), f64(want.x), 12.0, DT)), 0, f32(approach(f64(p.vel.z), f64(want.z), 12.0, DT)))
    np = p.pos + p.vel * f32(DT)
    # (a slope too steep is not climbed)
    if flatness(f64(np.x), f64(np.z)) > 0.55 or ground(f64(np.x), f64(np.z)) < f64(p.pos.y): p.pos = np
    p.pos = out_of_buildings(g, p.pos, 0.5)
    p.pos.y = f32(ground(f64(p.pos.x), f64(p.pos.z)))
    if wet: p.pos.y = -1.1
    # (beside a craft on the ground its pilot one's own side: they out, this one in)
    if kicked and p.state == WALK:
        k = flown_by_own(g, p)
        if k >= 0:
            put_out(g, g.crafts[k].seats[0], i)
            g.people[i] = p
            p = get_in(g, i, p, k)
    # (a seat's number, beside a craft on the ground: that seat, one of the computer's of one's
    # own side in it moving over)
    if seat_new and p.state == WALK:
        k = craft_in_reach(g, p)
        if k >= 0 and seat_now - 1 < g.crafts[k].seats.len():
            s = seat_now - 1
            o = g.crafts[k].seats[s]
            if o < 0 or can_take(g, i, o, k):
                g.people[i] = p
                if o >= 0: move_over(g, o, i, k, s)
                g.crafts[k].seats[s] = i
                p.state = SEATED
                p.craft = k
                p.seat = s
                p.goal = -1
                g.booms.push(Boom(p.pos, BOARDED, g.tick, i, k))
    if pressed and p.state == WALK:
        k = nearest_craft(g, p)
        gi = nearest_gun(g, p)
        if gi >= 0 and (k < 0 or f64(length(g.buildings[gi].pos - p.pos)) < 3.0):
            g.buildings[gi].crew = i
            p.state = POST
            p.post = gi
            p.pos = g.buildings[gi].pos
        else if k >= 0: p = get_in(g, i, p, k)
    # (T, on foot: in the fights that start in the air, flying again; far from one's field, back
    # there a moment later (F is getting in, alone: a craft to steal is never lost to it))
    if out and p.state == WALK:
        if not starts_on_ground(g, p.team):
            respawn(g, i, p)
            return
        if far_from_field(p):
            p.state = DEAD
            p.timer = 180
            drop_flag(g, i)
    g.people[i] = p

# on foot on craft p.craft's deck: walking it as on the ground (Shift runs, Ctrl jumps), riding
# with it, its frame's; off its edge, or T in the air, falling; T on the ground, down beside it;
# F, a free seat in reach, in it; a seat's number, that seat in reach (the computer's of one's
# side moving over). Downed, or gone, falling with it
on_deck = (g: mut Game, i: int, p0: Person, pad: Pad, pressed: bool, out: bool, seat_now: int, seat_new: bool):
    let p = p0
    k = p.craft
    c = g.crafts[k]
    if not alive(c) or c.down > 0:
        g.people[i] = off_deck(g, i, p, k)
        return
    p.yaw = f64(pad.aim_yaw) / 1000.0
    f = vec3(f32(-sin(p.yaw)), 0, f32(-cos(p.yaw)))
    r = vec3(-f.z, 0, f.x)
    want = f * f32(-f64(pad.pitch) / 100.0) + r * f32(f64(pad.roll) / 100.0)
    if length(want) > 1.0: want = normalize(want)
    speed = f64(length(want)) * (if pad.throttle > 0: RUN_SPEED else: WALK_SPEED)
    if p.player < 0: speed *= 0.75 + f64(hash(i * 2654435761) % 1000) / 1000.0 * 0.45
    lw = quat_rotate(quat_inverse(c.rot), want)
    lw = vec3(lw.x, 0, lw.z)
    if length(lw) > 0.001: lw = normalize(lw) * f32(speed)
    grounded = p.step.y == 0.0
    rate = if grounded: 12.0 else: 1.5
    p.step = vec3(f32(approach(f64(p.step.x), f64(lw.x), rate, DT)), p.step.y, f32(approach(f64(p.step.z), f64(lw.z), rate, DT)))
    l = p.deck
    nx = vec3(l.x + p.step.x * f32(DT), l.y, l.z)
    if deck_blocked(c.kind, nx): p.step.x = 0.0
    else: l = nx
    nz = vec3(l.x, l.y, l.z + p.step.z * f32(DT))
    if deck_blocked(c.kind, nz): p.step.z = 0.0
    else: l = nz
    fl = deck_floor(c.kind, l)
    hard = false
    if grounded and fl >= f64(l.y) - STEP:
        l.y = f32(fl)
        if pad.throttle < 0: p.step.y = f32(JUMP)
    else:
        p.step.y -= f32(9.8 * DT)
        l.y += p.step.y * f32(DT)
        if f64(p.step.y) <= 0.0 and f64(l.y) <= fl:
            hard = f64(p.step.y) < -14.0
            l.y = f32(fl)
            p.step.y = 0.0
    p.deck = l
    p.pos = point_of(c, l)
    p.vel = c.vel + quat_rotate(c.rot, p.step)
    if hard:
        g.people[i] = p
        kill(g, i, -1)
        return
    # (over its edge, or far down to what is under: falling, as from the craft)
    if fl < f64(l.y) - DECK_DROP:
        g.people[i] = off_deck(g, i, p, k)
        return
    if pressed or seat_new:
        s = if seat_new: seat_now - 1 else: seat_near(g, k, l)
        if s >= 0 and s < c.seats.len() and f64(length(KINDS[c.kind].seats[s].at - l - vec3(0, 1, 0))) < DECK_REACH:
            o = c.seats[s]
            if o < 0 or (seat_new and can_take(g, i, o, k)):
                g.people[i] = p
                if o >= 0: move_over(g, o, i, k, s)
                g.crafts[k].seats[s] = i
                p.state = SEATED
                p.seat = s
                p.goal = -1
                p.pos = point_of(c, KINDS[c.kind].seats[s].at)
                g.booms.push(Boom(p.pos, BOARDED, g.tick, i, k))
                g.people[i] = p
                return
    if out:
        if c.landed and f64(length(c.vel)) < 4.0:
            # (down beside it: by its gate, its ladder, its gondola; else under where one stood)
            side = p.pos
            if c.kind == CASTLE: side = point_of(c, CASTLE_GATE + vec3(0, 0, -3))
            if c.kind == DAVINCI: side = point_of(c, DV_LADDER)
            if c.kind == ZEPPELIN: side = point_of(c, vec3(-4, -11, -24))
            p.pos = vec3(side.x, f32(ground(f64(side.x), f64(side.z))), side.z)
            p.vel = vec3(0, 0, 0)
            p.craft = -1
            p.step = vec3(0, 0, 0)
        else:
            # (a jump out over the side: falling, the parachute as from a seat)
            p.step = p.step + vec3(0, 4, 0)
            p = off_deck(g, i, p, k)
            p.walked = false
            g.booms.push(Boom(p.pos, BAILED, g.tick, i, k))
    g.people[i] = p

# a gun on the ground p could man: standing, no one at it, within 4 m (either side's)
nearest_gun = (g: Game, p: Person) -> int:
    best = -1
    least = 4.0
    loop j in 0.. and b in g.buildings:
        if not is_gun(b.kind) or b.health <= 0 or b.crew >= 0: continue
        d = f64(length(vec2(b.pos.x - p.pos.x, b.pos.z - p.pos.z)))
        if d < least:
            least = d
            best = j
    best

far_from_field = (p: Person) -> bool:
    f = fields()[p.team]
    f64(length(vec2(p.pos.x - f.at.x, p.pos.z - f.at.z))) > STRIP_LONG + 400.0

# (one back on foot faces the parked planes, across the strip)
spawn_yaw = (team: int) -> f64:
    d = fields()[team].dir
    atan2(f64(d.z), -f64(d.x))

# (dead, and back: on foot at the side's field, or in the air in a craft of its own)
respawn = (g: mut Game, i: int, p0: Person):
    let p = p0
    p.state = WALK
    p.carry = -1
    p.goal = -1
    p.torn = false
    p.craft = -1
    p.seat = -1
    p.post = -1
    p.vel = vec3(0, 0, 0)
    # (Escort: a bomber lost in the last half of the time does not come back; its crew flies a fighter)
    if g.rules.mode == ESCORT and (p.kind == BOMBER or p.kind == ULTRA) and g.tick > 60 * 180: p.kind = FIGHTER
    if starts_on_ground(g, p.team):
        p.pos = foot_spawn(p.team, (i / 2 + g.tick / 61) % 12)
        p.yaw = spawn_yaw(p.team)
        g.people[i] = p
        return
    # (a craft of its own, made again: the old one's slot, once its wreck is cleared)
    k = -1
    loop j in 0..g.crafts.len():
        if g.crafts[j].owner == i: k = j
    if k >= 0 and not g.crafts[k].free and g.crafts[k].gone == 0 and (g.crafts[k].down > 0 or manned(g.crafts[k])):
        # (its last one still falls, or another has it: a new one)
        g.crafts[k].owner = -1
        k = -1
    if k < 0:
        loop j in 0..g.crafts.len():
            if k < 0 and g.crafts[j].free: k = j
    n = g.people.len() / 2
    at, dir = air_start(p.team, i / 2, n, if p.kind == ZEPPELIN: 470.0 else: 430.0)
    # (Bikes & Brooms: the balloons where all start, the whole line of them brought forward to
    # its side's rings)
    if g.rules.mode == BROOMS and p.kind == BALLOON and rings().len() >= 6:
        at.x += rings()[p.team * 3].at.x - f32(if p.team == 0: -AIR_LINE else: AIR_LINE)
    if p.kind == CASTLE: at, dir = castle_air_start(p.team)
    c = flying_craft(p.kind, p.team, at, dir)
    c.owner = i
    c.safe = 120
    if g.rules.mode == CLASSIC or not g.rules.rockets: c.rockets = 0
    if k < 0:
        k = g.crafts.len()
        g.crafts.push(c)
    else: g.crafts[k] = c
    g.crafts[k].seats[0] = i
    p.state = SEATED
    p.craft = k
    p.seat = 0
    p.pos = c.pos
    p.yaw = atan2(-f64(dir.x), -f64(dir.z))
    g.people[i] = p

# (where a side's flying castle starts in the air: behind the rest, clear of all their rows,
# lower; on the gorge high over its field)
castle_air_start = (team: int) -> (vec3, vec3):
    f = fields()[team]
    if map_id == GORGE: return (vec3(f.at.x, f32(field_height(f) + 420.0), f.at.z), f.dir)
    side = if team == 0: 1.0 else: -1.0
    (vec3(f32(-(AIR_LINE + 420.0) * side), 380, 0), vec3(f32(side), 0, 0))

# (how far one at p is from a flying castle's gate, along the ground: its drawbridge comes down
# to the ground there, however high or low it is)
castle_gate_distance = (c: Craft, p: vec3) -> f64:
    q = point_of(c, CASTLE_GATE)
    f64(length(vec2(q.x - p.x, q.z - p.z)))

# the craft p could get into: standing or rolling slowly, near one of its seats, a seat free
nearest_craft = (g: Game, p: Person) -> int:
    best = -1
    least = ENTER
    loop j in 0.. and c in g.crafts:
        if not whole(c) or not c.landed or f64(length(c.vel)) > 3.0: continue
        loop s in 0.. and st in KINDS[c.kind].seats:
            if c.seats[s] >= 0: continue
            d = f64(length(point_of(c, board_at(c.kind, st.at)) - p.pos - vec3(0, 1, 0)))
            # (a zeppelin's gunners on its back are reached by its gondola's ladder; all of da
            # Vinci's, high on its deck, by its ladder down to the ground)
            if c.kind == ZEPPELIN: d = min(d, f64(length(point_of(c, vec3(0, -11, -24)) - p.pos)) + 0.5 * f64(s))
            if c.kind == DAVINCI: d = f64(length(point_of(c, DV_LADDER) - p.pos - vec3(0, 1, 0))) + 0.5 * f64(s)
            # (the flying castle's, all of them, by its gate)
            if c.kind == CASTLE: d = castle_gate_distance(c, p.pos) + 0.05 * f64(s)
            if d < least:
                least = d
                best = j
    best

# (where a seat is got into from the ground: a balloon's from its lowest basket, up the ladders)
board_at = (kind: int, at: vec3) -> vec3: if kind == BALLOON: at - vec3(0, f32(TIER_DROP * f64(TIERS - 1)), 0) else: at

get_in = (g: mut Game, i: int, p0: Person, k: int) -> Person:
    let p = p0
    c = g.crafts[k]
    # (the pilot's seat if it is free, else the nearest gunner's)
    s = -1
    least = 1e9
    loop j in 0.. and st in KINDS[c.kind].seats:
        if c.seats[j] >= 0: continue
        d = f64(length(point_of(c, board_at(c.kind, st.at)) - p.pos)) + (if j == 0: -1000.0 else: 0.0)
        if d < least:
            least = d
            s = j
    if s < 0: return p
    g.crafts[k].seats[s] = i
    p.state = SEATED
    p.craft = k
    p.seat = s
    p.goal = -1
    g.booms.push(Boom(p.pos, BOARDED, g.tick, i, k))
    p

# (a free seat, or one of the computer's of one's own side in it, on a craft its crew one's own
# side: they move to another seat, or out)
change_seat = (g: mut Game, i: int, p0: Person, s: int) -> Person:
    let p = p0
    c = g.crafts[p.craft]
    if s < 0 or s >= c.seats.len() or s == p.seat: return p
    o = c.seats[s]
    if o >= 0 and not can_take(g, i, o, p.craft): return p
    g.crafts[p.craft].seats[p.seat] = -1
    if o >= 0: move_over(g, o, i, p.craft, s)
    g.crafts[p.craft].seats[s] = i
    p.seat = s
    p

# whether person i may have the seat person o has in craft k: o one of the computer's of i's
# side, the craft's crew i's side (never anyone of the other side, never a player)
can_take = (g: Game, i: int, o: int, k: int) -> bool:
    if o == i or g.people[o].player >= 0 or g.people[o].team != g.people[i].team: return false
    if g.people[o].state != SEATED or g.people[o].craft != k: return false
    crew_at(g, k) == g.people[i].team

# (person o, of the computer's, out of seat s of craft k for person `by`: to the pilot's seat if
# it is free, else the first free one; none, out of the craft)
move_over = (g: mut Game, o: int, by: int, k: int, s: int):
    to = -1
    loop j in 0..g.crafts[k].seats.len():
        if to < 0 and j != s and g.crafts[k].seats[j] < 0: to = j
    g.booms.push(Boom(g.people[o].pos, SWAPPED, g.tick, o, by))
    if to >= 0:
        g.crafts[k].seats[s] = -1
        g.crafts[k].seats[to] = o
        g.people[o].seat = to
        return
    q = g.people[o]
    c = g.crafts[k]
    q = if c.landed and f64(length(c.vel)) < 4.0: get_out(g, o, q) else: bail_out(g, o, q)
    q.goal = -1
    g.people[o] = q

# the craft whose seat p, on foot, is within reach of (taken or not): -1 none
craft_in_reach = (g: Game, p: Person) -> int:
    best = -1
    least = ENTER
    loop j in 0.. and c in g.crafts:
        if not whole(c) or not c.landed or f64(length(c.vel)) > 3.0: continue
        loop s in 0.. and st in KINDS[c.kind].seats:
            d = f64(length(point_of(c, board_at(c.kind, st.at)) - p.pos - vec3(0, 1, 0)))
            if c.kind == ZEPPELIN: d = min(d, f64(length(point_of(c, vec3(0, -11, -24)) - p.pos)))
            if c.kind == DAVINCI: d = f64(length(point_of(c, DV_LADDER) - p.pos - vec3(0, 1, 0)))
            if d < least:
                least = d
                best = j
    best

const ABOARD_REACH = 4.0        # (m from a free seat, falling, to land in it)

# the craft person i, falling or under a canopy, comes down on this tick, a seat of it free:
# within reach of that seat, or over the craft (inside its outline from above) as low as its
# highest seat and a little more, no lower than its lowest (a zeppelin's back, a galleass's deck,
# a balloon's baskets, a bomber's fuselage). Whole, not one that is a person (a rocketeer, the
# cat), nor a drone; not the one they have just bailed out of. Either side's, for a player; one
# of the computer's, its own side's crew's alone (-1: none)
landing_on = (g: Game, i: int, p: Person) -> int:
    loop j in 0.. and c in g.crafts:
        if not whole(c) or c.kind == ROCKETEER or c.kind == CAT or c.kind == DRONE or c.team == GOLD: continue
        if j == p.left and p.timer < 120: continue
        k = KINDS[c.kind]
        if f64(length(c.pos - p.pos)) > f64(length(k.half)) + ABOARD_REACH: continue
        if p.player < 0 and crew_at(g, j) != p.team: continue
        l = quat_rotate(quat_inverse(c.rot), p.pos - c.pos)
        low = 1e9
        high = -1e9
        free = false
        near = false
        loop s in 0.. and st in k.seats:
            low = min(low, f64(st.at.y))
            high = max(high, f64(st.at.y))
            if c.seats[s] >= 0: continue
            free = true
            if f64(length(point_of(c, st.at) - p.pos)) < ABOARD_REACH: near = true
        if not free: continue
        # (the flying castle: the computer's come down onto one of its terraces, into a seat; a
        # player stands on it, deck_landing)
        if c.kind == CASTLE:
            floor = castle_walk_height(f64(l.x), f64(l.z))
            if near or (p.player < 0 and floor > -1e8 and f64(l.y) > floor - 1.0 and f64(l.y) < floor + 3.0): return j
            continue
        over = (l.x / k.half.x) * (l.x / k.half.x) + (l.z / k.half.z) * (l.z / k.half.z) < 1.0
        if near or (over and f64(l.y) > low - 1.0 and f64(l.y) < high + 3.0): return j
    -1

# landed aboard craft k: in the nearest free seat (the computer's, the pilot's if it is free)
land_aboard = (g: mut Game, i: int, p0: Person, k: int) -> Person:
    let p = p0
    c = g.crafts[k]
    s = -1
    least = 1e9
    loop j in 0.. and st in KINDS[c.kind].seats:
        if c.seats[j] >= 0: continue
        d = f64(length(point_of(c, st.at) - p.pos)) + (if j == 0 and p.player < 0: -1000.0 else: 0.0)
        if d < least:
            least = d
            s = j
    g.crafts[k].seats[s] = i
    p.state = SEATED
    p.craft = k
    p.seat = s
    p.goal = -1
    p.left = -1
    p.torn = false
    p.pos = point_of(c, KINDS[c.kind].seats[s].at)
    p.vel = c.vel
    g.booms.push(Boom(p.pos, ABOARD, g.tick, i, k))
    p

# person pk put out of their seat by person `by`: beside the craft on the ground, else bailing out
put_out = (g: mut Game, pk: int, by: int):
    q = g.people[pk]
    if q.state != SEATED: return
    c = g.crafts[q.craft]
    q = if c.landed and f64(length(c.vel)) < 4.0: get_out(g, pk, q) else: bail_out(g, pk, q)
    g.people[pk] = q
    g.booms.push(Boom(q.pos, KICKED, g.tick, pk, by))

# the craft on the ground whose pilot is of p's side, its seat within reach (-1: none)
flown_by_own = (g: Game, p: Person) -> int:
    best = -1
    least = ENTER
    loop j in 0.. and c in g.crafts:
        if not whole(c) or not c.landed or f64(length(c.vel)) > 3.0 or c.seats.len() == 0: continue
        pk = c.seats[0]
        if pk < 0 or g.people[pk].team != p.team: continue
        d = if c.kind == CASTLE: castle_gate_distance(c, p.pos) else: f64(length(point_of(c, if c.kind == DAVINCI: DV_LADDER else: board_at(c.kind, KINDS[c.kind].seats[0].at)) - p.pos - vec3(0, 1, 0)))
        if d < least:
            least = d
            best = j
    best

# out of a craft standing on the ground: beside it, on its left
get_out = (g: mut Game, i: int, p0: Person) -> Person:
    let p = p0
    c = g.crafts[p.craft]
    g.crafts[p.craft].seats[p.seat] = -1
    k = KINDS[c.kind]
    side = point_of(c, k.seats[p.seat].at + vec3(f32(-1.6 - f64(k.half.x) * 0.25), 0, 0))
    if c.kind == ZEPPELIN: side = point_of(c, vec3(-4, -11, -24))
    if c.kind == DAVINCI: side = point_of(c, DV_LADDER)
    if c.kind == CASTLE: side = point_of(c, CASTLE_GATE + vec3(f32(f64(p.seat % 7) * 2.0 - 6.0), 0, f32(-2.0 - f64(p.seat / 7) * 2.0)))
    p.pos = vec3(side.x, f32(ground(f64(side.x), f64(side.z))), side.z)
    p.vel = vec3(0, 0, 0)
    p.state = WALK
    p.craft = -1
    p.seat = -1
    p

# out of a craft in the air: falling, the parachute opening a moment later
bail_out = (g: mut Game, i: int, p0: Person) -> Person:
    let p = p0
    k = p.craft
    c = g.crafts[k]
    g.crafts[k].seats[p.seat] = -1
    p.pos = point_of(c, KINDS[c.kind].seats[p.seat].at + vec3(0, 1.5, 0))
    p.vel = c.vel + up_of(c) * 4.0
    p.state = FALL
    p.timer = 0
    p.torn = false
    p.left = k
    p.walked = false
    p.craft = -1
    p.seat = -1
    g.booms.push(Boom(p.pos, BAILED, g.tick, i, k))
    p

# person i dies (by person `by`, -1: no one): anyone in a seat with it falls with its craft
kill = (g: mut Game, i: int, by: int):
    p = g.people[i]
    if p.state == DEAD: return
    if p.state == SEATED: g.crafts[p.craft].seats[p.seat] = -1
    if p.state == POST: g.buildings[p.post].crew = -1
    drop_flag(g, i)
    g.booms.push(Boom(p.pos, KILLED, g.tick, i, by))
    g.people[i].state = DEAD
    g.people[i].timer = RESPAWN
    g.people[i].craft = -1
    g.people[i].seat = -1
    g.people[i].post = -1
    g.people[i].deaths += 1
    if by >= 0 and by != i and g.people[by].team != p.team and g.winner < 0: g.people[by].kills += 1

# (pushed out of the buildings still standing: a box round each, r more)
out_of_buildings = (g: Game, p: vec3, r: f64) -> vec3:
    let q = p
    loop b in g.buildings:
        if b.kind == AA or b.kind == MAST or b.kind == TARGET: continue
        h = site_half(b.kind)
        l = quat_rotate(quat_axis_angle(vec3(0, 1, 0), -b.yaw), q - b.pos)
        ox = f64(h.x) + r - abs(f64(l.x))
        oz = f64(h.z) + r - abs(f64(l.z))
        if ox <= 0.0 or oz <= 0.0 or f64(l.y) > f64(h.y) * 2.0: continue
        if ox < oz: l.x += f32(if l.x > 0.0: ox else: -ox)
        else: l.z += f32(if l.z > 0.0: oz else: -oz)
        q = b.pos + quat_rotate(quat_axis_angle(vec3(0, 1, 0), b.yaw), l)
    q

# (a player on foot within 50 m of craft c, and a seat free in it)
player_near = (g: Game, c: Craft) -> bool:
    if not c.seats.contains(-1): return false
    loop p in g.people:
        if p.player >= 0 and p.state == WALK and f64(length(p.pos - c.pos)) < 50.0: return true
    false

# ---------------- flying ----------------
# craft i for a tick, flown by pad (no pilot: the controls let go)
fly = (g: mut Game, i: int, pad: Pad, piloted: bool):
    let c = g.crafts[i]
    if c.gone > 0:
        c.gone -= 1
        if c.gone == 0:
            # (cleared: its stand has a new one; one of a person's own, nothing until they need it)
            if c.home >= 0:
                s = stands(field_kinds(g.people.len() / 2, g.rules.mode, g.rules.crafts))[c.home]
                n = parked(s.kind, s.team, s.pos, s.yaw)
                n.since = g.tick
                n.home = c.home
                n.safe = 60
                c = n
            else: c.free = true
        g.crafts[i] = c
        return
    if c.safe > 0: c.safe -= 1
    # (standing still with no one in it: nothing to do but be mended, at its own field)
    if not piloted and c.landed and c.down == 0 and c.vel == vec3(0, 0, 0):
        g.crafts[i] = c
        return
    if piloted: c.manned = g.tick
    c.wait = if c.landed and piloted and player_near(g, c): c.wait + 1 else: 0
    k = KINDS[c.kind]
    pd = pad
    if not piloted: pd = Pad()
    if c.down > 0:
        # shot down: the engine dead, the controls gone, rolling over and down
        c.down += 1
        pd = Pad(-40, if i % 2 == 0: 100 else: -100, 0, -1)
    else if piloted and outside(c.pos) > 0.0 and not c.landed:
        # (past the fight's edge: back toward the middle)
        home = normalize(inward(c.pos) + vec3(0, f32(clamp((500.0 - f64(c.pos.y)) / 800.0, -0.3, 0.3)), 0))
        t = if k.heli: heli_to(c, c.pos + inward(c.pos) * 200.0, inward(c.pos), 25.0) else: steer(c, home)
        pd.pitch = t.pitch
        pd.roll = t.roll
        pd.yaw = t.yaw
    else if not piloted and outside(c.pos) > 1500.0: c.down = 1
    if c.kind == BALLOON: drift(g, i, c, pd)
    else if k.heli: hover(g, i, c, pd)
    else if k.lighter: float(g, i, c, pd)
    else if c.landed and (c.kind == ROCKETEER or c.kind == CAT): stand(g, i, c, pd)
    else if c.landed: roll_on_ground(g, i, c, pd)
    else: fly_air(g, i, c, pd)
    c = g.crafts[i]
    if c.gone > 0 or c.free: return
    # the pilot's guns, rockets and bombs
    if c.cooldown > 0: c.cooldown -= 1
    if c.heat > 0: c.heat -= 1
    if c.rcool > 0: c.rcool -= 1
    if c.jammed and c.heat < 120: c.jammed = false
    who = if c.kind == DRONE: c.owner else: pilot_of(c)
    team = crew_team(g, c)
    fired = false
    # (the little screw's fire pots: thrown the way its pilot looks, only so far up and down; ahead
    # at rest)
    if c.kind == SCREW and c.aims.len() > 0: c.aims[0] = screw_aim(c, if piloted and c.down == 0: pd else: Pad())
    if pd.fire and k.guns and c.down == 0 and not c.jammed and c.cooldown == 0 and piloted and not (c.kind == DRONE and c.rockets <= 0):
        if c.kind == DRONE: c.rockets -= 1
        fwd = fwd_of(c)
        up = up_of(c)
        right = right_of(c)
        # (the guns take turns: two on the cowling; outside Classic, a fighter's third on its top
        # wing, half as many shots again in the same time, each heating the guns less)
        three = c.kind == FIGHTER and g.rules.mode != CLASSIC
        gun_n = if three: 3 else: 2
        which = c.shots % gun_n
        at = c.pos + fwd * f32(f64(k.half.z) * 0.9) + right * f32(if which == 0: 0.35 else: -0.35) + up * 0.6
        if which == 2: at = point_of(c, vec3(0, 1.75, -1.6))
        if c.kind == ROCKETEER: at = point_of(c, vec3(0.25, -0.1, -1.1))
        if c.kind == ORNITHOPTER: at = point_of(c, if pd.scope: ORNI_SNIPER else: ORNI_GUN)
        # (a little scatter, from the tick: the same on every machine)
        h = hash(g.tick * 4 + i)
        sx = (f64(h & 1023) / 1023.0 - 0.5) * 0.008
        sy = (f64((h >> 10) & 1023) / 1023.0 - 0.5) * 0.008
        dir = normalize(fwd + right * f32(sx) + up * f32(sy))
        snipe = c.kind == ORNITHOPTER and pd.scope
        if snipe:
            # (the computer's aim at that range: off by a few meters a kilometer, a player's not)
            way = fwd
            if who < 0 or g.people[who].player < 0: way = normalize(fwd + right * f32(sx * (2.2 - g.skill)) + up * f32(sy * (2.2 - g.skill)))
            g.bullets.push(Bullet(at, c.vel + way * f32(SNIPE_SPEED), who, i, team, SNIPE_LIFE, SNIPE_DAMAGE, snipe = true))
            g.booms.push(Boom(at, SNIPED, g.tick, i, who))
        else: g.bullets.push(Bullet(at, c.vel + dir * f32(BULLET_SPEED), who, i, team, BULLET_LIFE))
        c.shots += 1
        c.cooldown = if snipe: SNIPE_GAP else: if three: (if which == 2: 2 else: 3) else: k.fire_gap
        fired = true
        if not snipe: c.heat += if three: k.heat_shot * 2 / 3 else: k.heat_shot
        if c.heat >= JAM_HEAT: c.jammed = true
    if piloted and c.down == 0 and c.rcool == 0:
        # (a carcopter's pilot: its guns alone; its stock is the tail gunner's drones)
        if c.kind == SCREW:
            if pd.rocket and c.rockets > 0 and not c.landed:
                at = pot_from(c)
                g.shots.push(Shot(POT, at, pot_velocity(c), who, i, team, 600))
                g.booms.push(Boom(at, THROWN, g.tick, i, who))
                c.rockets -= 1
                c.rcool = k.rocket_gap
                fired = true
        else if pd.rocket and c.rockets > 0 and g.rules.rockets and c.kind != CARCOPTER:
            # (each side in turn; Le Prieur's rockets, lit and let go from the struts)
            side = if (c.shots + c.rockets) % 2 == 0: 1.0 else: -1.0
            at = point_of(c, vec3(f32(side * f64(k.half.x) * 0.45), -0.3, f32(-f64(k.half.z) * 0.3)))
            if k.lighter: at = point_of(c, vec3(f32(side * 2.0), -11, -27))
            if c.kind == ORNITHOPTER:
                at = point_of(c, ORNI_LAUNCHER)
                g.shots.push(Shot(PACK, at, c.vel + fwd_of(c) * 70.0, who, i, team, 360))
            else: g.shots.push(Shot(ROCKET, at, c.vel + fwd_of(c) * 60.0, who, i, team, 240))
            g.booms.push(Boom(at, FIRED, g.tick, i))
            if k.endless: c.shots += 1
            else: c.rockets -= 1
            c.rcool = k.rocket_gap
            fired = true
        else if pd.bomb and c.bombs > 0 and c.kind != BALLOON:
            at = point_of(c, vec3(0, f32(-f64(k.half.y) * 0.8), 0))
            if k.lighter: at = point_of(c, vec3(0, -12.5, f32(-15.0 + 6.0 * f64(c.bombs % 4))))
            g.shots.push(Shot(BOMB, at, c.vel * 0.95, who, i, team, 60 * 40))
            g.booms.push(Boom(at, DROPPED, g.tick, i))
            c.bombs -= 1
            fired = true
            c.rcool = if k.lighter: 12 else: 18
    # (da Vinci's trebuchet: B held low and slow over the ground digs boulders out, one at a time,
    # up to BOULDERS; X throws one)
    if c.kind == DAVINCI and c.down == 0 and piloted:
        gy = ground(f64(c.pos.x), f64(c.pos.z))
        low = c.landed or (f64(c.pos.y) - DIG_KEEL - gy < DIG_LOW and f64(length(c.vel)) < 5.0)
        if c.boulders < BOULDERS and pd.bomb and low and gy > 0.0:
            c.dig += 1
            if c.dig >= DIG:
                c.boulders += 1
                c.dig = 0
                g.booms.push(Boom(point_of(c, TREB_POUCH), DUG, g.tick, i, who))
        else: c.dig = 0
        if c.boulders > 0 and pd.rocket and c.rcool == 0 and not c.landed:
            flat = normalize(vec3(fwd_of(c).x, 0, fwd_of(c).z) + vec3(0, 0, 0.0001))
            at = point_of(c, BOULDER_AT)
            g.shots.push(Shot(BOULDER, at, c.vel + flat * f32(BOULDER_SPEED) + vec3(0, f32(BOULDER_UP), 0), who, i, team, 600))
            g.booms.push(Boom(at, THROWN, g.tick, i, who))
            c.boulders -= 1
            c.rcool = 60
            fired = true
    # (a drone: its minute up, it falls)
    if c.kind == DRONE and c.down == 0:
        c.life -= 1
        if c.life <= 0: c.down = 1
    if fired:
        g.crafts[i] = c
        seen_firing(g, i)
        c = g.crafts[i]
    # (the ornithopter's health packs: one more each 6 s, up to its six, wherever it is)
    if k.refill > 0 and c.rockets < k.rockets and (g.rules.rockets or c.kind == SCREW) and g.tick % k.refill == 0: c.rockets += 1
    # (stood still at its own side's field for 3 s: rearmed, mended)
    if c.landed and f64(length(c.vel)) < 0.5 and on_own_field(c, team): c.rest += 1
    else: c.rest = 0
    if c.rest > 180:
        c.rockets = k.rockets
        c.bombs = k.bombs
        c.health = min(c.health + 2, k.health)
    g.crafts[i] = c

# (the way the little screw's fire pots are thrown, as its pilot looks with pad: any way round,
# up and down only so far)
screw_aim = (c: Craft, pd: Pad) -> vec3:
    f = fwd_of(c)
    fl = vec3(f.x, 0, f.z)
    fl = if length(fl) > 0.05: normalize(fl) else: vec3(0, 0, -1)
    yaw = f64(pd.aim_yaw) / 1000.0
    pitch = clamp(f64(pd.aim_pitch) / 1000.0, -POT_LOW, POT_HIGH)
    if pd.aim_yaw == 0 and pd.aim_pitch == 0:
        yaw = atan2(-f64(fl.x), -f64(fl.z))
        pitch = 0.0
    want = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
    now = c.aims[0]
    if length(now) < 0.5: now = fl
    normalize(approach(now, want, 12.0, DT))

# (a fire pot thrown now: from over the rail the way they are thrown, with the craft's own speed)
pot_from = (c: Craft) -> vec3:
    a = vec3(c.aims[0].x, 0, c.aims[0].z)
    c.pos + (if length(a) > 0.05: normalize(a) else: fwd_of(c)) * f32(SCREW_DECK * 0.5 + 0.3) + up_of(c) * f32(SCREW_FLOOR + 0.9)
pot_velocity = (c: Craft) -> vec3: c.vel + c.aims[0] * f32(POT_SPEED) + vec3(0, f32(POT_UP), 0)

on_own_field = (c: Craft, team: int) -> bool:
    f = fields()[team]
    f64(length(vec2(c.pos.x - f.at.x, c.pos.z - f.at.z))) < STRIP_LONG + 150.0

# a winged craft in the air: Aces' flight (the kind's own numbers)
fly_air = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    k = KINDS[c.kind]
    speed = f64(length(c.vel))
    auth = clamp(speed / (k.stall * 1.45), 0.25, 1.0)
    q = c.rot
    q = quat_mul(q, quat_axis_angle(vec3(1, 0, 0), f64(pd.pitch) / 100.0 * k.pitch_rate * auth * DT))
    q = quat_mul(q, quat_axis_angle(vec3(0, 0, 1), -f64(pd.roll) / 100.0 * k.roll_rate * auth * DT))
    q = quat_mul(q, quat_axis_angle(vec3(0, 1, 0), -f64(pd.yaw) / 100.0 * k.yaw_rate * auth * DT))
    # (one person flying (a rocketeer, the cat), the stick let go: rolled upright again, from a
    # bank or upside down, as a helicopter levels itself)
    if (c.kind == ROCKETEER or c.kind == CAT) and pd.roll == 0 and c.down == 0:
        r_now = quat_rotate(q, vec3(1, 0, 0))
        u_now = quat_rotate(q, vec3(0, 1, 0))
        bank = atan2(f64(r_now.y), f64(u_now.y))
        q = quat_mul(q, quat_axis_angle(vec3(0, 0, 1), -clamp(bank * 1.5, -1.0, 1.0) * k.roll_rate * 0.5 * DT))
    fwd = quat_rotate(q, vec3(0, 0, -1))
    vdir = fwd
    if speed > 0.1: vdir = c.vel * f32(1.0 / speed)
    # (stalled: the nose falls toward the way it is going, and down)
    lift = smoothstep(k.stall * 0.75, k.stall * 1.15, speed)
    if lift < 1.0:
        axis = cross(fwd, normalize(vdir + vec3(0, -0.7, 0)))
        if length(axis) > 0.001: q = quat_mul(quat_axis_angle(axis, (1.0 - lift) * 1.6 * DT), q)
    # (banked, the nose falls too, more the more the wings stand on their side (or hang upside
    # down): on its side, half the rudder, toward the sky, holds it up)
    if c.kind != ROCKETEER and c.kind != CAT and c.kind != ZEPPELIN and c.kind != BALLOON:
        tilt = 1.0 - max(f64(quat_rotate(q, vec3(0, 1, 0)).y), 0.0)
        axis = cross(quat_rotate(q, vec3(0, 0, -1)), vec3(0, -1, 0))
        if length(axis) > 0.001: q = quat_mul(quat_axis_angle(normalize(axis), tilt * lift * 0.5 * k.yaw_rate * DT), q)
        # (and it turns the way its wings lean, toward the lower one: its lift pulls it round)
        up_now = quat_rotate(q, vec3(0, 1, 0))
        f_now = quat_rotate(q, vec3(0, 0, -1))
        flat = vec3(f_now.x, 0, f_now.z)
        if length(flat) > 0.05:
            flat = normalize(flat)
            lean = f64(dot(up_now, vec3(-flat.z, 0, flat.x)))
            q = quat_mul(quat_axis_angle(vec3(0, 1, 0), -lean * lift * 0.5 * k.yaw_rate * DT), q)
    c.rot = normalize(q)
    fwd = quat_rotate(c.rot, vec3(0, 0, -1))
    up = quat_rotate(c.rot, vec3(0, 1, 0))
    c.throttle = clamp(c.throttle + f64(pd.throttle) * 0.6 * DT, 0.0, 1.0)
    # speed along the way it goes: the engine (fading up high), drag (more pulling hard), and
    # gravity (diving gains speed, climbing costs it)
    thin = clamp((CEILING + 300.0 - f64(c.pos.y)) / 600.0, 0.0, 1.0)
    pull = abs(f64(pd.pitch)) / 100.0 * auth
    acc = k.thrust * c.throttle * thin - k.drag * speed * speed * (1.0 + 0.9 * pull) - 9.8 * f64(vdir.y)
    speed = max(speed + acc * DT, 0.0)
    # the way it goes turns toward the nose: hardly at all when stalled
    t = min(k.grip * lift * DT, 1.0)
    vdir = normalize(vdir + (fwd - vdir) * f32(t))
    c.vel = vdir * f32(speed)
    # what the wings do not hold up falls: all of it stalled; banked, what their lift no longer
    # holds up (on its side, none of it: the rudder holds the nose up, or it falls); a rocket
    # pack pushes where it is pointed
    level = max(f64(up.y), 0.0)
    sag = 9.8 * (1.0 - lift) + 9.8 * lift * (1.0 - level)
    if c.kind == ROCKETEER or c.kind == CAT: sag = 2.0 * (1.0 - level)
    c.vel.y -= f32(sag * DT)
    c.pos += c.vel * f32(DT)
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    if f64(c.pos.y) - k.gear < gy or c.down > (if c.kind == CASTLE: 3600 else: 900): touch_down(g, i, c, gy)
    else: g.crafts[i] = c

# the ground reached: landed (slow, level, gently, on flat ground), ditched (the same on water:
# the craft sinks, the people swim) or crashed
touch_down = (g: mut Game, i: int, c0: Craft, gy: f64):
    let c = c0
    if c.kind == DRONE:
        crash(g, i, c)
        return
    k = KINDS[c.kind]
    # (the cat lands on its feet: down gently on flat ground it stands; else it bounces off, the
    # right way up, unhurt (shot down, it falls as anything does))
    if c.kind == CAT and c.down == 0:
        v = c.vel
        if f64(length(v)) < 12.0 and f64(up_of(c).y) > 0.5 and gy > 0.0 and flatness(f64(c.pos.x), f64(c.pos.z)) > 0.9:
            flat = vec3(fwd_of(c).x, 0, fwd_of(c).z)
            if length(flat) < 0.05: flat = vec3(0, 0, -1)
            c.landed = true
            c.vel = vec3(0, 0, 0)
            c.rot = ground_rot(atan2(-f64(flat.x), -f64(flat.z)), k.tilt)
            c.pos.y = f32(gy + k.gear)
            g.booms.push(Boom(c.pos, LANDED, g.tick, i))
            g.crafts[i] = c
            return
        v.y = f32(max(abs(f64(v.y)) * 0.6, 6.0))
        c.vel = v * 0.85
        c.pos.y = f32(gy + k.gear + 0.1)
        c.rot = quat_facing(normalize(c.vel))
        g.crafts[i] = c
        return
    up = up_of(c)
    fwd = fwd_of(c)
    flat = vec3(fwd.x, 0, fwd.z)
    sink = -f64(c.vel.y)
    gentle = c.down == 0 and sink < 4.5 and f64(length(c.vel)) < k.stall * 1.9 and f64(up.y) > 0.82 and f64(fwd.y) > -0.25
    wet = gy <= 0.0
    if gentle and not wet and flatness(f64(c.pos.x), f64(c.pos.z)) > 0.93 and length(flat) > 0.1:
        c.landed = true
        speed = f64(length(vec2(c.vel.x, c.vel.z)))
        yaw = atan2(-f64(flat.x), -f64(flat.z))
        c.rot = ground_rot(yaw, k.tilt * 0.5)
        c.vel = normalize(flat) * f32(speed)
        if c.kind == ROCKETEER:
            c.rot = ground_rot(yaw, k.tilt)
            c.vel = vec3(0, 0, 0)
        c.pos.y = f32(gy + k.gear)
        g.booms.push(Boom(c.pos, LANDED, g.tick, i))
        g.crafts[i] = c
        return
    if gentle and wet:
        # (ditched: the people in it come out in the water)
        g.booms.push(Boom(c.pos, DITCHED, g.tick, i))
        loop s in 0.. and pk in c.seats:
            if pk < 0: continue
            g.people[pk].state = WALK
            g.people[pk].pos = vec3(c.pos.x + f32(s * 2), -1.1, c.pos.z)
            g.people[pk].vel = vec3(0, 0, 0)
            g.people[pk].craft = -1
            g.people[pk].seat = -1
            c.seats[s] = -1
        c.gone = WRECK / 4
        c.vel = vec3(0, 0, 0)
        g.crafts[i] = c
        return
    crash(g, i, c)

# craft i destroyed against the ground (or an obstacle): who is in it dies
crash = (g: mut Game, i: int, c0: Craft):
    let c = c0
    g.booms.push(Boom(c.pos, BLAST, g.tick, i))
    if c.down == 0:
        g.booms.push(Boom(c.pos, CRASHED, g.tick, i))
        if counts_kills(g) and c.kind != DRONE and (manned(c) or g.tick - c.manned < 600): score(g, 1 - crew_team(g, c))
    g.crafts[i] = c
    loop pk in c.seats:
        if pk >= 0: kill(g, pk, if c.down > 0: c.by else: -1)
    c = g.crafts[i]
    c.seats = fill(-1, c.seats.len())
    c.down = 0
    c.landed = false
    c.gone = if c.kind == CASTLE: CASTLE_WRECK else: WRECK
    c.vel = vec3(0, 0, 0)
    g.crafts[i] = c

# rolling on the ground: the throttle pushes it along, the rudder (and the stick's roll) steers,
# the brakes with the throttle shut; past its speed of flying, pulling back lifts it off
roll_on_ground = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    k = KINDS[c.kind]
    fwd = fwd_of(c)
    flat = vec3(fwd.x, 0, fwd.z)
    if length(flat) < 0.05: flat = vec3(0, 0, -1)
    flat = normalize(flat)
    yaw = atan2(-f64(flat.x), -f64(flat.z))
    speed = f64(dot(c.vel, flat))
    c.throttle = clamp(c.throttle + f64(pd.throttle) * 0.6 * DT, 0.0, 1.0)
    brake = if pd.throttle < 0 and c.throttle <= 0.0: 4.0 else: 0.0
    acc = k.thrust * c.throttle * 1.1 - k.drag * speed * speed - (0.6 + brake) * sign(speed)
    speed = speed + acc * DT
    if abs(speed) < 0.05 and c.throttle <= 0.0: speed = 0.0
    speed = clamp(speed, -2.0, 1000.0)
    turn = clamp(f64(pd.yaw + pd.roll) / 100.0, -1.0, 1.0) * 0.7 * min(1.0, abs(speed) / 6.0 + 0.25)
    if c.down == 0: yaw -= turn * DT
    flat = vec3(f32(-sin(yaw)), 0, f32(-cos(yaw)))
    np = c.pos + flat * f32(speed * DT)
    gy = ground(f64(np.x), f64(np.z))
    # (the tail comes up as it gathers speed)
    lift_off = speed > k.stall * 1.12 and pd.pitch > 10 and c.down == 0
    c.rot = ground_rot(yaw, k.tilt * (1.0 - smoothstep(0.0, k.stall, speed)))
    c.vel = flat * f32(speed)
    c.pos = vec3(np.x, f32(gy + k.gear), np.z)
    # (rough ground, water, a building or another craft in the way: fast, it breaks)
    rough = flatness(f64(np.x), f64(np.z)) < 0.9 or gy <= 0.0
    hit = bumped(g, i, c)
    if (rough or hit) and abs(speed) > 9.0:
        crash(g, i, c)
        return
    if hit:
        c.pos = c0.pos
        c.vel = vec3(0, 0, 0)
    if lift_off:
        c.landed = false
        c.vel = flat * f32(speed) + vec3(0, 1.5, 0)
        c.rot = quat_mul(quat_axis_angle(vec3(0, 1, 0), yaw), quat_axis_angle(vec3(1, 0, 0), 0.12))
    if c.down > 0 and c.down > 120: crash(g, i, c)
    else: g.crafts[i] = c

# (a craft on the ground into a building, or another craft on the ground)
bumped = (g: Game, i: int, c: Craft) -> bool:
    r = f64(KINDS[c.kind].half.z) * 0.8
    loop b in g.buildings:
        if b.health <= 0 or b.kind == AA or b.kind == TARGET: continue
        h = site_half(b.kind)
        l = quat_rotate(quat_axis_angle(vec3(0, 1, 0), -b.yaw), c.pos - b.pos)
        if abs(f64(l.x)) < f64(h.x) + r and abs(f64(l.z)) < f64(h.z) + r: return true
    false

# the rocketeer (or the cat) on the ground, standing: the throttle (or pulling back) takes it
# straight up, then level, the way it faces
stand = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    fwd = fwd_of(c)
    up = up_of(c)
    flat = vec3(-up.x, 0, -up.z)
    if length(flat) < 0.05: flat = vec3(fwd.x, 0, fwd.z)
    if length(flat) < 0.05: flat = vec3(0, 0, -1)
    flat = normalize(flat)
    yaw = atan2(-f64(flat.x), -f64(flat.z))
    yaw -= clamp(f64(pd.yaw + pd.roll) / 100.0, -1.0, 1.0) * 1.5 * DT
    c.rot = ground_rot(yaw, KINDS[c.kind].tilt)
    c.vel = vec3(0, 0, 0)
    c.pos.y = f32(ground(f64(c.pos.x), f64(c.pos.z)) + KINDS[c.kind].gear)
    if (pd.throttle > 0 or pd.pitch > 30) and c.down == 0:
        c.landed = false
        c.throttle = 1.0
        c.rot = quat_mul(quat_axis_angle(vec3(0, 1, 0), yaw), quat_axis_angle(vec3(1, 0, 0), 0.6))
        dir = vec3(f32(-sin(yaw)), 0, f32(-cos(yaw)))
        c.vel = dir * 20.0 + vec3(0, 12, 0)
    g.crafts[i] = c

# a helicopter: the throttle its lift (about 0.6 holds it where it is), the stick leans it and it
# goes the way it leans (let go, it levels itself), the rudder (and the stick's roll, standing)
# turns it. Down on the ground gently and level: it stands; harder, it crashes
hover = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    k = KINDS[c.kind]
    fwd = fwd_of(c)
    flat = vec3(fwd.x, 0, fwd.z)
    if length(flat) < 0.05: flat = vec3(0, 0, -1)
    flat = normalize(flat)
    yaw = atan2(-f64(flat.x), -f64(flat.z))
    turn = f64(pd.yaw) / 100.0
    if c.landed: turn = clamp(turn + f64(pd.roll) / 100.0, -1.0, 1.0)
    yaw -= clamp(turn, -1.0, 1.0) * k.yaw_rate * DT
    most = HELI_LEAN * k.tip
    want = if c.landed: vec2(0, 0) else: vec2(f32(clamp(f64(pd.roll) / 100.0, -1.0, 1.0) * most * k.aside), f32(clamp(-f64(pd.pitch) / 100.0, -1.0, 1.0) * most))
    if c.down > 0: want = vec2(f32(sin(f64(c.down) * 0.05) * 0.8 * k.tip), f32(0.6 * k.tip))
    c.lean = vec2(f32(approach(f64(c.lean.x), f64(want.x), k.roll_rate, DT)), f32(approach(f64(c.lean.y), f64(want.y), k.pitch_rate, DT)))
    if c.down > 0: yaw += 2.5 * k.tip * DT
    c.rot = normalize(quat_mul(quat_axis_angle(vec3(0, 1, 0), yaw), quat_mul(quat_axis_angle(vec3(1, 0, 0), -f64(c.lean.y)), quat_axis_angle(vec3(0, 0, 1), -f64(c.lean.x)))))
    c.throttle = clamp(c.throttle + f64(pd.throttle) * 1.2 * DT, 0.0, 1.0)
    up = up_of(c)
    thin = clamp((CEILING + 300.0 - f64(c.pos.y)) / 600.0, 0.0, 1.0)
    lift = if c.down > 0: 0.0 else: c.throttle * k.thrust * thin
    acc = up * f32(lift) + vec3(0, -9.8, 0) - c.vel * f32(k.drag + 0.004 * f64(length(c.vel)))
    # (pushed along by its screws the way it leans, as far as it leans: the flying castle)
    if k.drive > 0.0 and c.down == 0:
        fl = vec3(f32(-sin(yaw)), 0, f32(-cos(yaw)))
        rt = vec3(-fl.z, 0, fl.x)
        acc += (fl * f32(f64(c.lean.y) / most) + rt * f32(f64(c.lean.x) / (most * k.aside))) * f32(k.drive * thin)
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    if c.landed:
        # (standing: up once its lift is more than its weight)
        c.vel = vec3(0, 0, 0)
        c.pos.y = f32(max(gy, 0.0) + k.gear)
        if lift > 10.3 and c.down == 0:
            c.landed = false
            c.vel = vec3(0, 1.5, 0)
        g.crafts[i] = c
        return
    c.vel += acc * f32(DT)
    c.pos += c.vel * f32(DT)
    if f64(c.pos.y) - k.gear < gy or c.down > 900:
        wet = gy <= 0.0
        if c.down == 0 and not wet and f64(c.vel.y) > -7.0 and f64(up.y) > 0.8 and f64(length(vec2(c.vel.x, c.vel.z))) < 12.0:
            c.landed = true
            c.vel = vec3(0, 0, 0)
            c.lean = vec2(0, 0)
            c.rot = quat_axis_angle(vec3(0, 1, 0), yaw)
            c.pos.y = f32(gy + k.gear)
            g.booms.push(Boom(c.pos, LANDED, g.tick, i))
            g.crafts[i] = c
            return
        touch_down(g, i, c, gy)
        return
    g.crafts[i] = c

# a balloon: no steering; it goes where the wind blows (which turns with the height: a balloon
# is steered by going up or down), its burner (the first seat's stick, back) up, down by letting
# it cool; shot down, it sinks
drift = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    w = wind(f64(c.pos.y))
    climb = clamp(f64(pd.pitch) / 100.0, -1.0, 1.0) * 3.5
    if c.down > 0: climb = -4.0 - f64(c.down) / 200.0
    vy = approach(f64(c.vel.y), climb, 0.5, DT)
    if f64(c.pos.y) > CEILING and vy > 0.0: vy = 0.0
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    k = KINDS[c.kind]
    # (on the ground, tethered: no wind)
    h = if c.landed: vec3(0, 0, 0) else: vec3(c.vel.x, 0, c.vel.z) + (w - vec3(c.vel.x, 0, c.vel.z)) * f32(min(0.4 * DT, 1.0))
    c.vel = vec3(h.x, f32(vy), h.z)
    if c.landed and vy > 0.2: c.landed = false
    c.pos += c.vel * f32(DT)
    # (the basket turns slowly with the wind)
    c.rot = quat_axis_angle(vec3(0, 1, 0), f64(g.tick) * 0.0005 + f64(i))
    if f64(c.pos.y) - k.gear <= gy:
        if c.down > 0 or f64(c.vel.y) < -6.0:
            crash(g, i, c)
            return
        c.pos.y = f32(gy + k.gear)
        if c.vel.y < 0.0: c.vel.y = 0.0
        c.landed = gy > 0.0
        if c.landed: c.vel = vec3(0, 0, 0)
    g.crafts[i] = c

# the wind at a height: about 6 m/s, from a way that turns as one goes up
wind = (y: f64) -> vec3:
    a = 0.6 + y * 0.004 + 0.3 * sin(y * 0.011)
    sp = 5.0 + 2.0 * sin(y * 0.007 + 1.0)
    vec3(f32(cos(a) * sp), 0, f32(sin(a) * sp))

# a zeppelin: the throttle its speed ahead, the rudder (and the stick's roll) turns it, the
# stick's pitch takes it up and down; shot down, it burns and sinks, nose first
float = (g: mut Game, i: int, c0: Craft, pd: Pad):
    let c = c0
    k = KINDS[c.kind]
    fwd = fwd_of(c)
    flat = vec3(fwd.x, 0, fwd.z)
    if length(flat) < 0.05: flat = vec3(0, 0, -1)
    flat = normalize(flat)
    yaw = atan2(-f64(flat.x), -f64(flat.z))
    c.throttle = clamp(c.throttle + f64(pd.throttle) * 0.4 * DT, 0.0, 1.0)
    speed = approach(f64(dot(c.vel, flat)), ZEP_SPEED * c.throttle, 0.25, DT)
    turn = clamp(f64(pd.yaw + pd.roll) / 100.0, -1.0, 1.0) * ZEP_TURN * min(1.0, speed / 8.0 + 0.3)
    yaw -= turn * DT
    climb = f64(pd.pitch) / 100.0 * ZEP_CLIMB
    if c.down > 0: climb = -3.0 - f64(c.down) / 120.0
    vy = approach(f64(c.vel.y), climb, 0.6, DT)
    if f64(c.pos.y) > CEILING and vy > 0.0: vy = 0.0
    flat = vec3(f32(-sin(yaw)), 0, f32(-cos(yaw)))
    c.vel = flat * f32(speed) + vec3(0, f32(vy), 0)
    c.pos += c.vel * f32(DT)
    nose = if c.down > 0: clamp(f64(c.down) / 900.0, 0.0, 0.35) else: clamp(vy / ZEP_CLIMB, -1.0, 1.0) * 0.04
    c.rot = quat_mul(quat_axis_angle(vec3(0, 1, 0), yaw), quat_axis_angle(vec3(1, 0, 0), -nose))
    if turn != 0.0: c.rot = quat_mul(c.rot, quat_axis_angle(vec3(0, 0, 1), turn * 0.8))
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    c.landed = false
    if f64(c.pos.y) - k.gear <= gy:
        if c.down > 0 or f64(c.vel.y) < -5.0:
            crash(g, i, c)
            return
        # (resting on its gondolas: moored)
        c.pos.y = f32(gy + k.gear)
        if c.vel.y < 0.0: c.vel.y = 0.0
        c.landed = speed < 3.0 and gy > 0.0
    g.crafts[i] = c

# ---------------- crafts into each other ----------------
# two crafts meeting (their ellipsoids, by a few points of the smaller): each hurt by how fast
# they met, the more the heavier the other is; on the ground slowly, they only stop
collide = (g: mut Game):
    n = g.crafts.len()
    # (each craft that can hit another: where, how far it reaches, and whether it moves)
    at: vec3[]
    reach: f32[]
    live: bool[]
    moving: bool[]
    loop i in 0..n:
        if g.crafts[i].knock > 0: g.crafts[i].knock -= 1
        h = KINDS[g.crafts[i].kind].half
        at.push(g.crafts[i].pos)
        reach.push(max(h.x, max(h.y, h.z)))
        live.push(not g.crafts[i].free and g.crafts[i].gone == 0)
        moving.push(not g.crafts[i].landed or g.crafts[i].vel != vec3(0, 0, 0))
    # (sorted along x: a pair looked at only when their x are as near as they reach)
    order: (f32, int)[]
    most = f32(0.0)
    loop i in 0..n:
        if live[i]:
            order.push((at[i].x, i))
            most = max(most, reach[i])
    order.sort_with((a, b): a.0 < b.0 or (a.0 == b.0 and a.1 < b.1))
    loop oi in 0..order.len():
        i0 = order[oi].1
        loop oj in oi + 1..order.len():
            if order[oj].0 - order[oi].0 > reach[i0] + most: break
            j0 = order[oj].1
            i = min(i0, j0)
            j = max(i0, j0)
            if not (moving[i] or moving[j]): continue
            d = at[i] - at[j]
            r = reach[i] + reach[j]
            if dot(d, d) > r * r: continue
            a = g.crafts[i]
            b = g.crafts[j]
            if a.knock > 0 or b.knock > 0: continue
            if not touching(a, b) and not touching(b, a): continue
            # (a drone: it bursts on what it touches)
            if a.kind == DRONE or b.kind == DRONE:
                dj = if a.kind == DRONE: i else: j
                oj = if dj == i: j else: i
                dr = g.crafts[dj]
                if g.crafts[oj].kind != DRONE: hurt_craft(g, oj, dr.owner, dr.team, 60, dr.pos)
                crash(g, dj, g.crafts[dj])
                continue
            # (the cat: its own, rams)
            if a.kind == CAT or b.kind == CAT: continue
            # (either on the ground: no harm, the fields are crowded; one on the ground rolling
            # toward the other stops that way, and is eased apart)
            if a.landed or b.landed:
                away = vec3(d.x, 0, d.z)
                if length(away) < 0.01: away = vec3(1, 0, 0)
                away = normalize(away)
                if a.landed:
                    toward = f64(dot(a.vel, away * -1.0))
                    if toward > 0.0: g.crafts[i].vel = a.vel + away * f32(toward)
                    if moving[i]: g.crafts[i].pos += away * 0.04
                if b.landed:
                    toward = f64(dot(b.vel, away))
                    if toward > 0.0: g.crafts[j].vel = b.vel - away * f32(toward)
                    if moving[j]: g.crafts[j].pos -= away * 0.04
                continue
            g.crafts[i].knock = 30
            g.crafts[j].knock = 30
            rel = f64(length(a.vel - b.vel))
            ma = KINDS[a.kind].mass
            mb = KINDS[b.kind].mass
            bump(g, i, int(rel * 6.0 * clamp(mb / ma, 0.15, 6.0)), (a.pos + b.pos) * 0.5)
            bump(g, j, int(rel * 6.0 * clamp(ma / mb, 0.15, 6.0)), (a.pos + b.pos) * 0.5)

# the cat into a craft in the air (its way this tick through it: it is fast): that one hurt, the
# more the faster they met, the other side's (or anyone's, with friendly fire); the cat
# unhurt, bounced off it
rams = (g: mut Game):
    loop i in 0..g.crafts.len():
        if g.crafts[i].kind != CAT or g.crafts[i].knock > 0 or not flying(g.crafts[i]): continue
        c = g.crafts[i]
        team = crew_at(g, i)
        a = c.pos - c.vel * f32(DT)
        loop o in g.air:
            j = o.craft
            if j == i or not flying(g.crafts[j]) or g.crafts[j].kind == DRONE: continue
            if not seg_near(a - g.crafts[j].pos, c.pos - g.crafts[j].pos, f64(o.reach) + f64(length(c.vel)) * DT + 2.0): continue
            if not hits_craft(g.crafts[j], a, c.pos, 0.4): continue
            e = g.crafts[j]
            rel = f64(length(c.vel - e.vel))
            if e.kind != CAT and harms(g, team, g.crew[j]):
                hurt_craft(g, j, pilot_of(c), team, int(clamp(25.0 + rel * 0.22, 30.0, 80.0)), c.pos)
                g.booms.push(Boom(c.pos, RAMMED, g.tick, j, pilot_of(c)))
            # (off it, the way it came, slower)
            away = c.pos - e.pos
            away = if length(away) > 0.01: normalize(away) else: up_of(e)
            v = c.vel - e.vel
            v = v - away * f32(2.0 * min(f64(dot(v, away)), 0.0))
            g.crafts[i].vel = e.vel + v * 0.5
            g.crafts[i].pos = c.pos + away * f32(f64(o.reach) * 0.5 + 1.0)
            g.crafts[i].rot = quat_facing(normalize(g.crafts[i].vel + fwd_of(c) * 0.01))
            g.crafts[i].knock = 30
            g.crafts[j].knock = max(g.crafts[j].knock, 30)
            break

# (whether a point of craft a, its middle, nose, tail or wing tips, is inside craft b)
touching = (a: Craft, b: Craft) -> bool:
    h = KINDS[a.kind].half
    loop at in [vec3(0, 0, 0), vec3(h.x * 0.85, 0, 0), vec3(-h.x * 0.85, 0, 0), vec3(0, 0, h.z * 0.85), vec3(0, 0, -h.z * 0.85)]:
        if craft_distance(b, point_of(a, at)) < 0.0: return true
    false

# craft i hurt this much in a collision (no one's doing): down at 0, as if crashed
bump = (g: mut Game, i: int, amount: int, at: vec3):
    c = g.crafts[i]
    if not whole(c): return
    g.booms.push(Boom(at, HIT, g.tick, i, -1))
    lose_ball(g, i, amount)
    g.crafts[i].health -= amount
    if g.crafts[i].health > 0: return
    g.crafts[i].health = 0
    if c.landed:
        crash(g, i, g.crafts[i])
        return
    g.crafts[i].down = 1
    g.booms.push(Boom(c.pos, CRASHED, g.tick, i))
    if counts_kills(g) and c.kind != DRONE and (manned(c) or g.tick - c.manned < 600): score(g, 1 - crew_team(g, c))

# ---------------- the gunners ----------------
# each gunner's seat of craft i: its gun turned toward where its person aims (one of the
# computer's, or no one: the nearest enemy, led), and firing
gunners = (g: mut Game, i: int, pads: Pad[]):
    c = g.crafts[i]
    k = KINDS[c.kind]
    first = if gun_seat(c.kind, 0): 0 else: 1
    if not whole(c) or c.seats.len() <= first or (c.landed and not manned(c)): return
    crew_side = crew_team(g, c)
    loop q in 0..c.ccool.len():
        if g.crafts[i].ccool[q] > 0: g.crafts[i].ccool[q] -= 1
    if c.cgap > 0: g.crafts[i].cgap -= 1
    # (the flying castle's automatic guns too, after its seats: no one at them, its crew's)
    autos = if c.kind == CASTLE: CASTLE_AUTOS.len() else: 0
    loop s in first..k.seats.len() + autos:
        st = if s < k.seats.len(): k.seats[s] else: CASTLE_AUTOS[s - k.seats.len()]
        base = quat_rotate(c.rot, st.dir)
        at = point_of(c, st.at)
        pk = if s < k.seats.len(): c.seats[s] else: -1
        # (each gunner for their own side: one aboard the other side's craft too; whose its shots
        # are: its gunner's; the flying castle's, with no one at them, its pilot's)
        team = if pk >= 0: g.people[pk].team else: crew_side
        by = if pk < 0 and c.kind == CASTLE: c.seats[0] else: pk
        want = c.aims[s]
        fire = false
        far = 1e9                   # (the computer's: how far its target is)
        human = pk >= 0 and g.people[pk].player >= 0 and g.people[pk].player < pads.len() and not pads[g.people[pk].player].computer
        if human:
            pad = pads[g.people[pk].player]
            yaw = f64(pad.aim_yaw) / 1000.0
            pitch = f64(pad.aim_pitch) / 1000.0
            want = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
            fire = pad.fire
        else:
            # (the computer's gunner, there or not: the nearest the crew knows to be the other
            # side's, within reach of its gun; less skill, it aims worse and fires sooner)
            best = c.gtarget[s]
            reach = if st.weapon == FLAKGUN: 1000.0 else: if st.weapon == TWIN: 820.0 else: 650.0
            if (g.tick + i + s) % 4 == 0 or best >= g.crafts.len():
                best = -1
                # (a siphon's: only one near enough to be soon in reach)
                least = if st.weapon == FLAME: 150.0 else: reach
                loop o in g.air:
                    j = o.craft
                    if j == i or g.crafts[j].safe > 0 or seen_at(g, j, team) == team: continue
                    d = f64(length(o.pos - at))
                    if d < least and f64(dot(normalize(o.pos - at), base)) > st.arc:
                        least = d
                        best = j
                g.crafts[i].gtarget[s] = best
            least = if best >= 0: f64(length(g.crafts[best].pos - at)) else: 1e9
            far = least
            if best >= 0 and not flying(g.crafts[best]): best = -1
            if best >= 0:
                o = g.crafts[best]
                l = lead_from(at, c.vel, o.pos, o.vel, if st.weapon == BALLISTA: BOLT_SPEED else: if st.weapon == FLAME: FLAME_SPEED * 0.55 else: if st.weapon == FLAKGUN: CASTLE_FLAK_SPEED else: BULLET_SPEED)
                w = (1.0 - g.skill) * 0.05 + 0.012
                t = f64(g.tick)
                want = normalize(normalize(l) + vec3(f32(sin(t * 0.031 + f64(i + s)) * w), f32(cos(t * 0.027 + f64(s)) * w), f32(sin(t * 0.023 + 1.0) * w)))
                fire = f64(dot(normalize(c.aims[s]), normalize(l))) > 0.996 and least < 600.0
                # (the flying castle's flak, at what is far enough off to be worth a shell; its twin guns' long reach)
                if st.weapon == FLAKGUN: fire = f64(dot(normalize(c.aims[s]), normalize(l))) > 0.99 and least < reach and least > 150.0
                if st.weapon == TWIN: fire = f64(dot(normalize(c.aims[s]), normalize(l))) > 0.995 and least < reach
                if fire and st.weapon == FLAKGUN: far = f64(length(l))
                # (a siphon's fire: only as near as it carries, and loosed a little wide of dead on)
                if st.weapon == FLAME: fire = f64(dot(normalize(c.aims[s]), normalize(l))) > 0.985 and least < FLAME_REACH
        # (the gun turns only so far from its rest, and only so fast)
        if f64(dot(want, base)) < st.arc:
            loop _ in 0..6:
                if f64(dot(want, base)) < st.arc: want = normalize(want + base * 0.5)
            fire = false
        g.crafts[i].aims[s] = normalize(approach(c.aims[s], want, if human: 30.0 else: 4.0 + 4.0 * g.skill, DT))
        if g.crafts[i].gcool[s] > 0: g.crafts[i].gcool[s] -= 1
        if g.crafts[i].gheat[s] > 0: g.crafts[i].gheat[s] -= 1
        if fire and g.crafts[i].gcool[s] == 0 and g.crafts[i].gheat[s] < JAM_HEAT:
            dir = g.crafts[i].aims[s]
            if st.weapon == BALLISTA:
                g.bullets.push(Bullet(at + dir * 2.8, c.vel + dir * f32(BOLT_SPEED), pk, i, team, 150, BOLT_DAMAGE, bolt = true))
                g.crafts[i].gcool[s] = BOLT_GAP
            else if st.weapon == FLAKGUN:
                # (a shell: the computer's timed to burst where it aimed; a gunner's bursting by a
                # craft of the others it passes, or at its longest)
                life = if human: 200 else: max(int(far / CASTLE_FLAK_SPEED * 60.0), 20)
                g.shots.push(Shot(FLAK, at + dir * 3.5, c.vel + dir * f32(CASTLE_FLAK_SPEED), by, i, team, life))
                g.crafts[i].gcool[s] = CASTLE_FLAK_GAP
            else if st.weapon == TWIN:
                # (side by side, both at once: a gun tower's half-weight rounds)
                side = normalize(cross(dir, vec3(0, 1, 0)) + vec3(0.0001, 0, 0)) * 0.45
                loop sd in [-1.0, 1.0]: g.bullets.push(Bullet(at + dir * 2.0 + side * f32(sd), c.vel + dir * f32(BULLET_SPEED), by, i, team, NEST_LIFE, NEST_DAMAGE, heavy = true))
                g.crafts[i].gcool[s] = TWIN_GAP
                g.crafts[i].gheat[s] += 7
            else if st.weapon == MG2:
                # (the little screw's: no one at it, its pilot's, as its automatic guns are)
                twin_fire(g, i, at, dir, if pk >= 0: pk else: pilot_of(c), team)
                g.crafts[i].gcool[s] = MG2_GAP
                g.crafts[i].gheat[s] += MG2_GAP
            else if st.weapon == FLAME:
                # (a spray of gouts, the same on every machine: from the tick)
                side = normalize(cross(dir, if abs(f64(dir.y)) > 0.9: vec3(1, 0, 0) else: vec3(0, 1, 0)))
                upw = cross(side, dir)
                loop b in 0..FLAME_JETS:
                    h = hash(g.tick * 16 + i * 4 + b)
                    a = TAU * f64(h & 1023) / 1024.0
                    r = FLAME_SPREAD * sqrt(f64((h >> 10) & 1023) / 1023.0)
                    way = normalize(dir + side * f32(cos(a) * r) + upw * f32(sin(a) * r))
                    g.bullets.push(Bullet(at + dir * 1.3, c.vel + way * f32(FLAME_SPEED * (0.85 + 0.3 * f64((h >> 20) & 255) / 255.0)), if pk >= 0: pk else: pilot_of(c), i, team, FLAME_LIFE, FLAME_DAMAGE, flame = true))
                g.crafts[i].gcool[s] = FLAME_GAP
                g.crafts[i].gheat[s] += 2
            else:
                g.bullets.push(Bullet(at + dir * 1.5, c.vel + dir * f32(BULLET_SPEED), by, i, team, BULLET_LIFE))
                g.crafts[i].gcool[s] = 6
                g.crafts[i].gheat[s] += 6
            seen_firing(g, i)
        # (a launcher's drones: X, or the computer's with one of the others within 700 m)
        if st.weapon == LAUNCHER and g.crafts[i].rockets > 0 and g.crafts[i].rcool == 0:
            go = if human: pads[g.people[pk].player].rocket else: g.crafts[i].gtarget[s] >= 0 and far < 700.0 and (g.tick + i) % 60 == 0
            if go: launch_drone(g, i, pk, team)
        # (a balloon's cannons: X, the one nearest where its gunner aims; the computer's at one
        # within 450 m)
        if c.kind == BALLOON and g.crafts[i].ccool.len() > 0:
            shoot_cannon = if human: pads[g.people[pk].player].rocket else: g.crafts[i].gtarget[s] >= 0 and far < 450.0 and fire
            if shoot_cannon: fire_cannon(g, i, pk, team, g.crafts[i].aims[s])
        # (a balloon: anyone in it drops its bombs; the computer's first seat, over a target)
        if c.kind == BALLOON and g.crafts[i].rcool == 0 and g.crafts[i].bombs > 0:
            drop = false
            if human: drop = pads[g.people[pk].player].bomb
            else if s == 0: drop = bomb_now(g, g.crafts[i], team, 40.0)
            if drop:
                bat = point_of(c, vec3(f32(-1.5 + 1.5 * f64(s)), f32(-13.8 - TIER_DROP * f64(TIERS - 1)), 0))
                g.shots.push(Shot(BOMB, bat, c.vel, pk, i, team, 60 * 40))
                g.booms.push(Boom(bat, DROPPED, g.tick, i))
                g.crafts[i].bombs -= 1
                g.crafts[i].rcool = 25
                seen_firing(g, i)

# (a twin gun's two rounds, side by side, from craft i at `at` the way dir)
twin_fire = (g: mut Game, i: int, at: vec3, dir: vec3, by: int, team: int):
    side = normalize(cross(dir, vec3(0, 1, 0)) + vec3(0.0001, 0, 0)) * 0.2
    loop sd in [-1.0, 1.0]: g.bullets.push(Bullet(at + dir * 1.4 + side * f32(sd), g.crafts[i].vel + dir * f32(BULLET_SPEED), by, i, team, TWIN_LIFE, NEST_DAMAGE, heavy = true))

# the little screw's automatic guns: each at the nearest its crew knows to be the other side's,
# within AUTO_RANGE and its arc (a craft, or one on foot near), led and a little wide as a gun
# tower's, turning only so fast; its kills its pilot's, if it has one (as its gun seats' are,
# with no one at them)
screw_autos = (g: mut Game, i: int):
    c = g.crafts[i]
    if not whole(c) or c.landed or c.taims.len() < SCREW_AUTOS.len(): return
    team = crew_team(g, c)
    by = pilot_of(c)
    loop s in 0..SCREW_AUTOS.len():
        if g.crafts[i].tcool[s] > 0: g.crafts[i].tcool[s] -= 1
        at = point_of(c, SCREW_AUTOS[s])
        base = quat_rotate(c.rot, screw_out(SCREW_AUTO_A[s], 0.1))
        best = vec3(0, 0, 0)
        bv = vec3(0, 0, 0)
        least = AUTO_RANGE
        loop o in g.air:
            if o.craft == i or g.crafts[o.craft].safe > 0 or seen_at(g, o.craft, team) == team: continue
            d = f64(length(o.pos - at))
            if d < least and f64(dot(normalize(o.pos - at), base)) > AUTO_ARC:
                least = d
                best = o.pos
                bv = o.vel
        loop p in g.people:
            if p.team == team or (p.state != WALK and p.state != CHUTE): continue
            d = f64(length(p.pos - at))
            if d < min(least, 300.0) and f64(dot(normalize(p.pos - at), base)) > AUTO_ARC:
                least = d
                best = p.pos + vec3(0, 1, 0)
                bv = p.vel
        if least >= AUTO_RANGE:
            g.crafts[i].taims[s] = turn_toward(normalize(c.taims[s]), base, AUTO_TURN * 0.3 * DT)
            continue
        l = lead_from(at, c.vel, best, bv)
        w = NEST_SPREAD + 0.01 * (1.0 - g.skill)
        t = f64(g.tick)
        dir = normalize(normalize(l) + vec3(f32(sin(t * 0.37 + f64(i + s)) * w), f32(cos(t * 0.29 + f64(s)) * w), f32(sin(t * 0.41 + 2.0) * w)))
        g.crafts[i].taims[s] = turn_toward(normalize(c.taims[s]), dir, AUTO_TURN * DT)
        if g.crafts[i].tcool[s] == 0 and f64(dot(g.crafts[i].taims[s], normalize(l))) > 0.99:
            twin_fire(g, i, at, g.crafts[i].taims[s], by, team)
            g.crafts[i].tcool[s] = MG2_GAP
            seen_firing(g, i)

# a drone from craft i's rack, launched by person pk (side team): in a slot no craft is in
launch_drone = (g: mut Game, i: int, pk: int, team: int):
    c = g.crafts[i]
    way = quat_rotate(c.rot, DRONE_RACK_WAY)
    d = flying_craft(DRONE, team, point_of(c, DRONE_RACK_AT) + way * 1.5, way)
    d.vel = c.vel + way * 26.0
    d.owner = pk
    d.life = DRONE_LIFE
    d.rockets = DRONE_AMMO
    d.throttle = 1.0
    k = -1
    loop j in 0..g.crafts.len():
        if k < 0 and g.crafts[j].free: k = j
    if k < 0:
        k = g.crafts.len()
        g.crafts.push(d)
    else: g.crafts[k] = d
    g.crafts[i].rockets -= 1
    g.crafts[i].rcool = 90
    g.booms.push(Boom(d.pos, LAUNCHED, g.tick, k, i))

# a balloon's cannon (craft i): of those loaded facing within 70 degrees of `aim`, the nearest it,
# fired out of it (along the aim, if within 50 degrees of its way out)
fire_cannon = (g: mut Game, i: int, pk: int, team: int, aim: vec3):
    c = g.crafts[i]
    if c.cgap > 0: return
    ports = CANNON_PORTS[c.team]
    best = -1
    most = 0.3
    loop k in 0..ports.len():
        port = ports[k]
        out = quat_rotate(c.rot, normalize(vec3(port.x, 0, port.z)))
        v = f64(dot(out, aim))
        if g.crafts[i].ccool[k] == 0 and v > most:
            most = v
            best = k
    if best < 0: return
    port = ports[best]
    out = quat_rotate(c.rot, normalize(vec3(port.x, 0, port.z)))
    way = if most > 0.64: aim else: normalize(out + vec3(0, -0.05, 0))
    at = point_of(c, port) + out * 0.6
    g.shots.push(Shot(CANNONBALL, at, c.vel + way * f32(CANNON_SPEED), pk, i, team, 360))
    g.booms.push(Boom(at, CANNON, g.tick, i, pk))
    g.crafts[i].ccool[best] = CANNON_GAP
    g.crafts[i].cgap = CANNON_SPACING
    seen_firing(g, i)

# (whether a seat of the kind is a gun: every seat but a pilot's, and a balloon's first too)
gun_seat = (kind: int, s: int) -> bool: KINDS[kind].seats[s].dir != vec3(0, 0, 0)

# (the computer: whether a bomb let go now from c would fall on its side's target)
bomb_now = (g: Game, c: Craft, team: int, within: f64) -> bool:
    bi = mission_target(g, team)
    if bi < 0: return false
    goal = g.buildings[bi].pos
    h = max(f64(c.pos.y) - f64(goal.y), 1.0)
    t = sqrt(2.0 * h / 9.8)
    fall = c.pos + c.vel * f32(t)
    f64(length(vec2(fall.x - goal.x, fall.z - goal.z))) < within

# the way to aim from `at` (moving at v) to hit something at e (moving at ev): where it will be
# when the bullets get there (they keep the shooter's speed, and drop a little)
lead_from = (at: vec3, v: vec3, e: vec3, ev: vec3, speed: f64 = BULLET_SPEED) -> vec3:
    rel = e - at
    rv = ev - v
    t = f64(length(rel)) / speed
    loop k in 0..2: t = f64(length(rel + rv * f32(t))) / speed
    rel + rv * f32(t) + vec3(0, f32(4.9 * t * t), 0)

lead = (c: Craft, e: Craft) -> vec3: lead_from(c.pos, c.vel, e.pos, e.vel)

# ---------------- what hits what ----------------
# whether the segment a-b passes within r of the origin
seg_near = (a: vec3, b: vec3, r: f64) -> bool:
    d = b - a
    l2 = f64(dot(d, d))
    t = 0.0
    if l2 > 0.0: t = clamp(-f64(dot(a, d)) / l2, 0.0, 1.0)
    q = a + d * f32(t)
    f64(dot(q, q)) < r * r

# whether the segment a-b (the world's) passes through craft c (its ellipsoid, where it was a tick
# ago at the start: it moved too), grown by `more` meters
hits_craft = (c: Craft, a: vec3, b: vec3, more: f64) -> bool:
    h = KINDS[c.kind].half + vec3(f32(more), f32(more), f32(more))
    # (first: near its sphere at all)
    if not seg_near(a - c.pos, b - c.pos, f64(max(h.x, max(h.y, h.z))) + f64(length(c.vel)) * DT): return false
    inv = quat_inverse(c.rot)
    la = quat_rotate(inv, a - (c.pos - c.vel * f32(DT)))
    lb = quat_rotate(inv, b - c.pos)
    if c.kind == CASTLE: return seg_castle(la, lb, more)
    seg_near(vec3(la.x / h.x, la.y / h.y, la.z / h.z), vec3(lb.x / h.x, lb.y / h.y, lb.z / h.z), 1.0)

# (whether the segment a-b passes through a flying castle (its own frame), grown by `more`: through
# one of its ovals, a box round them all first)
seg_castle = (a: vec3, b: vec3, more: f64) -> bool:
    if not seg_box(a - vec3(0, 14, 0), b - vec3(0, 14, 0), vec3(f32(92.0 + more), f32(80.0 + more), f32(148.0 + more))): return false
    loop o in CASTLE_SOLIDS:
        if seg_oval(a, b, o.0, o.1, o.2 + more, o.3 + more, o.4 - more, o.5 + more, o.6): return true
    false

# (whether the segment a-b passes through the upright oval round (x, z), half rx across and rz
# along, from y0 up to y1, uneven as terrace wob's (-1 not): roughly, where it comes nearest)
seg_oval = (a: vec3, b: vec3, x: f64, z: f64, rx: f64, rz: f64, y0: f64, y1: f64, wob: int) -> bool:
    t0 = 0.0
    t1 = 1.0
    ay = f64(a.y)
    dy = f64(b.y) - ay
    if abs(dy) < 1e-9:
        if ay < y0 or ay > y1: return false
    else:
        u0 = (y0 - ay) / dy
        u1 = (y1 - ay) / dy
        t0 = max(t0, min(u0, u1))
        t1 = min(t1, max(u0, u1))
        if t0 > t1: return false
    px = (f64(a.x) - x) / rx
    pz = (f64(a.z) - z) / rz
    dx = f64(b.x - a.x) / rx
    dz = f64(b.z - a.z) / rz
    dd = dx * dx + dz * dz
    t = if dd > 1e-12: clamp(-(px * dx + pz * dz) / dd, t0, t1) else: t0
    qx = px + dx * t
    qz = pz + dz * t
    e = qx * qx + qz * qz
    if wob < 0 or e > 1.2: return e <= 1.0
    w = castle_wobble(atan2(qz, qx), wob)
    e <= w * w

# (how far p (a flying castle's own frame) is from it, roughly: from the nearest of its ovals)
castle_distance = (p: vec3) -> f64:
    best = 1e9
    loop o in CASTLE_SOLIDS:
        dx = f64(p.x) - o.0
        dz = f64(p.z) - o.1
        e = sqrt((dx / o.2) * (dx / o.2) + (dz / o.3) * (dz / o.3))
        if o.6 >= 0: e = e / castle_wobble(atan2(dz / o.3, dx / o.2), o.6)
        flat = sqrt(dx * dx + dz * dz)
        side = if e > 1e-6: flat * (1.0 - 1.0 / e) else: -min(o.2, o.3)
        up = max(o.4 - f64(p.y), f64(p.y) - o.5)
        d = if side > 0.0 and up > 0.0: sqrt(side * side + up * up) else: max(side, up)
        best = min(best, d)
    best

# (whether the segment a-b passes through the box round the origin, half h)
seg_box = (a: vec3, b: vec3, h: vec3) -> bool:
    t0 = 0.0
    t1 = 1.0
    d = b - a
    loop ax in 0..3:
        o = f64(if ax == 0: a.x else: if ax == 1: a.y else: a.z)
        v = f64(if ax == 0: d.x else: if ax == 1: d.y else: d.z)
        e = f64(if ax == 0: h.x else: if ax == 1: h.y else: h.z)
        if abs(v) < 1e-9:
            if abs(o) > e: return false
            continue
        u0 = (-e - o) / v
        u1 = (e - o) / v
        t0 = max(t0, min(u0, u1))
        t1 = min(t1, max(u0, u1))
    t0 <= t1

# how far point p is from craft c's ellipsoid (roughly: its surface, in meters; < 0 inside)
craft_distance = (c: Craft, p: vec3) -> f64:
    h = KINDS[c.kind].half
    l = quat_rotate(quat_inverse(c.rot), p - c.pos)
    if c.kind == CASTLE: return castle_distance(l)
    s = vec3(l.x / h.x, l.y / h.y, l.z / h.z)
    f64(length(s) - 1.0) * f64(min(h.x, min(h.y, h.z)))

# damage to craft j from person `by` (side `team`): its health down, and shot down at 0 (what is
# said of it: HIT, or SCORCHED, by a siphon's fire)
hurt_craft = (g: mut Game, j: int, by: int, team: int, amount: int, at: vec3, how: int = HIT):
    c = g.crafts[j]
    if not whole(c) or c.safe > 0: return
    victim = crew_team(g, c)
    if not harms(g, team, victim): return
    g.booms.push(Boom(at, how, g.tick, j, by))
    lose_ball(g, j, amount)
    g.crafts[j].health -= amount
    g.crafts[j].by = by
    if g.crafts[j].health > 0: return
    g.crafts[j].health = 0
    # (the Thunderdome and Bikes & Brooms: the cat, flown lately, down: many points to the other side)
    if c.kind == CAT and cat_fight(g.rules.mode) and harms(g, team, victim) and team != victim and (manned(c) or g.tick - c.manned < 600): score(g, team, cat_points(g.rules.mode))
    if c.team == GOLD and team >= 0 and team < 2 and g.winner < 0:
        g.winner = team
        g.booms.push(Boom(c.pos, GOLD_WON, g.tick, j, by))
    if c.landed:
        crash(g, j, g.crafts[j])
        return
    g.crafts[j].down = 1
    g.booms.push(Boom(c.pos, SHOT_DOWN, g.tick, j, by))
    if g.winner < 0 and by >= 0 and g.people[by].team != victim: g.people[by].kills += 1
    if counts_kills(g) and c.kind != DRONE and (manned(c) or g.tick - c.manned < 600): score(g, 1 - victim)

# (the fights whose score is the crafts shot down)
counts_kills = (g: Game) -> bool: g.rules.mode == DOGFIGHT or g.rules.mode == CLASSIC

hurt_building = (g: mut Game, j: int, by: int, team: int, amount: int):
    b = g.buildings[j]
    if b.health <= 0 or b.kind == MAST or not harms(g, team, b.team): return
    g.buildings[j].health -= amount
    if g.buildings[j].health <= 0:
        g.buildings[j].health = 0
        g.booms.push(Boom(b.pos, RUINED, g.tick, j, by))
        # (a target: points to the side that shot it, and up again in a while)
        if b.kind == TARGET:
            g.buildings[j].back = TARGET_BACK
            if team != b.team: score(g, team, TARGET_POINTS)
        # (a gun tower: built again in a while, no points for it)
        if b.kind == NEST: g.buildings[j].back = NEST_BACK
        if b.crew >= 0: kill(g, b.crew, by)

hurt_person = (g: mut Game, j: int, by: int, team: int, amount: int):
    p = g.people[j]
    if p.state == DEAD or p.state == SEATED or not harms(g, team, p.team): return
    if amount >= 20 or hash(g.tick * 13 + j) % 3 == 0: kill(g, j, by)

# craft i fires: in another side's colors, if one of that side sees it, that side knows it now
# (for 30 s). Seeing is narrow: a pilot, the craft within about 23 degrees of their nose and 700
# m; a gunner, or a gun on the ground, about 15 degrees of where it points; one on foot, 45
# degrees of where they face and 400 m
seen_firing = (g: mut Game, i: int):
    c = g.crafts[i]
    v = c.team
    if crew_team(g, c) == v or c.marked[v] > g.tick + 60 * 25: return
    if witness(g, c.pos, v, i): g.crafts[i].marked[v] = g.tick + 60 * 30

witness = (g: Game, at: vec3, v: int, skip: int) -> bool:
    within = (from: vec3, dir: vec3, cosine: f64, far: f64) -> bool:
        d = at - from
        l = f64(length(d))
        l < far and l > 0.1 and f64(dot(d, dir)) / l > cosine
    loop j in 0.. and o in g.crafts:
        if j == skip or not whole(o): continue
        loop s in 0.. and pk in o.seats:
            if pk < 0 or g.people[pk].team != v: continue
            if s == 0 and within(o.pos, fwd_of(o), 0.92, 700.0): return true
            if s > 0 and s < o.aims.len() and within(point_of(o, KINDS[o.kind].seats[s].at), o.aims[s], 0.965, 600.0): return true
    loop b in g.buildings:
        if is_gun(b.kind) and b.health > 0 and b.team == v and within(b.pos + vec3(0, f32(gun_height(b.kind)), 0), b.aim, 0.965, 700.0): return true
    loop p in g.people:
        if p.team == v and p.state == WALK and within(p.pos + vec3(0, 1.6, 0), vec3(f32(-sin(p.yaw)), 0, f32(-cos(p.yaw))), 0.7, 400.0): return true
    false

# the bullets: on, down a little, into a craft, a person, a building or the ground
shoot = (g: mut Game):
    kept: Bullet[]
    # (each craft that can be hit: where, how near a bullet must come to be looked at closer,
    # its crew's side, and whether anyone is in it)
    teams: int[]
    near: f32[]
    open: bool[]
    full: bool[]
    at: vec3[]
    loop j in 0..g.crafts.len():
        teams.push(crew_at(g, j))
        h = KINDS[g.crafts[j].kind].half
        near.push(max(h.x, max(h.y, h.z)) + 3.0)
        open.push(not g.crafts[j].free and g.crafts[j].gone == 0 and g.crafts[j].safe == 0)
        full.push(manned_at(g, j))
        at.push(g.crafts[j].pos)
    # (how high over the ground a bullet may hit a building: the Thunderdome's targets are high)
    reach = if g.rules.mode == THUNDERDOME: 75.0 else: 25.0
    loop b in g.bullets:
        let b = b
        a = b.pos
        # (a siphon's fire slowed by the air, and rising)
        if b.flame: b.vel = b.vel * f32(1.0 - FLAME_DRAG * DT) + vec3(0, f32((FLAME_RISE - 9.8) * DT), 0)
        else: b.vel.y -= f32(9.8 * DT)
        b.pos += b.vel * f32(DT)
        b.life -= 1
        hit = false
        # (near enough to look at closer: the segment's middle within the craft's size and half
        # the segment, which a fast shell makes long)
        mid = (a + b.pos) * 0.5
        half = f32(length(b.pos - a) * 0.5)
        loop j in 0..g.crafts.len():
            if not open[j] or j == b.craft: continue
            d = mid - at[j]
            r = near[j] + half
            if dot(d, d) > r * r: continue
            t = g.crafts[j]
            # (through those it would not harm)
            if full[j] and not harms(g, b.team, teams[j]): continue
            # (the long gun's shell hits what it comes near; the cat, small and quick, only what it
            # comes half as near)
            # (a siphon's fire, the wider the farther it has gone)
            if hits_craft(t, a, b.pos, if b.snipe: (if t.kind == CAT: SNIPE_NEAR * 0.5 else: SNIPE_NEAR) else: if b.flame: FLAME_NEAR * f64(FLAME_LIFE - b.life) / f64(FLAME_LIFE) else: 0.0):
                hit = true
                if b.snipe: through_crew(g, j, a, b)
                if t.down == 0:
                    hurt_craft(g, j, b.by, b.team, b.damage, b.pos, if b.flame: SCORCHED else: HIT)
                else if not b.flame: g.booms.push(Boom(b.pos, HIT, g.tick, j, b.by))
                break
        if not hit:
            loop j in 0.. and p in g.people:
                if p.state == DEAD or p.state == SEATED or j == b.by: continue
                # (a parachute's canopy, 3.5 m across, 6.5 m over its person: shot through, it fails)
                if p.state == CHUTE and harms(g, b.team, p.team) and seg_near(a - p.pos - vec3(0, 6.5, 0), b.pos - p.pos - vec3(0, 6.5, 0), 3.5):
                    g.people[j].state = FALL
                    g.people[j].torn = true
                    g.booms.push(Boom(b.pos, TORN, g.tick, j, b.by))
                    hit = true
                    break
                if seg_near(a - p.pos - vec3(0, 0.9, 0), b.pos - p.pos - vec3(0, 0.9, 0), if b.flame: 1.5 else: 0.7) and harms(g, b.team, p.team):
                    hurt_person(g, j, b.by, b.team, b.damage)
                    hit = true
                    break
        if hit: continue
        if f64(b.pos.y) < 700.0:
            gy = ground(f64(b.pos.x), f64(b.pos.z))
            if f64(b.pos.y) < gy + reach:
                bi = building_hit(g, a, b.pos)
                if bi >= 0:
                    k = g.buildings[bi].kind
                    hurt_building(g, bi, b.by, b.team, if k == TARGET: b.damage else: if is_gun(k): DAMAGE else: 2)
                    if not b.flame: g.booms.push(Boom(b.pos, DIRT, g.tick, -1))
                    continue
            if f64(b.pos.y) < gy:
                if not b.flame: g.booms.push(Boom(b.pos, if gy <= 0.0: SPLASH else: DIRT, g.tick, -1))
                continue
        if b.life > 0: kept.push(b)
    g.bullets = kept

# a long gun's shell through craft j (from a to b.pos): those whose heads it passes near, killed
through_crew = (g: mut Game, j: int, a: vec3, b: Bullet):
    c = g.crafts[j]
    up = up_of(c)
    loop s in 0.. and pk in c.seats:
        if pk < 0 or pk == b.by or g.people[pk].team == GOLD or not harms(g, b.team, g.people[pk].team): continue
        head = point_of(c, KINDS[c.kind].seats[s].at) + up * 0.5
        if seg_near(a - head, b.pos - head, SNIPE_CREW):
            g.booms.push(Boom(head, HEADSHOT, g.tick, pk, b.by))
            kill(g, pk, b.by)

# the building the segment a-b passes into (-1: none): a box round each, in its own way
building_hit = (g: Game, a: vec3, b: vec3) -> int:
    loop j in 0.. and bd in g.buildings:
        if bd.health <= 0 or bd.kind == MAST: continue
        h = site_half(bd.kind)
        mid = bd.pos + vec3(0, h.y, 0)
        r = f64(length(h)) + 8.0
        if f64(length(b - mid)) > r + f64(length(b - a)): continue
        turn = quat_axis_angle(vec3(0, 1, 0), -bd.yaw)
        la = quat_rotate(turn, a - mid)
        lb = quat_rotate(turn, b - mid)
        # (the part of the segment inside each pair of planes; inside all three: a hit)
        t0 = 0.0
        t1 = 1.0
        d = lb - la
        ok = true
        loop ax in 0..3:
            o = f64(if ax == 0: la.x else: if ax == 1: la.y else: la.z)
            v = f64(if ax == 0: d.x else: if ax == 1: d.y else: d.z)
            e = f64(if ax == 0: h.x else: if ax == 1: h.y else: h.z)
            if abs(v) < 1e-9:
                if abs(o) > e: ok = false
                continue
            u0 = (-e - o) / v
            u1 = (e - o) / v
            t0 = max(t0, min(u0, u1))
            t1 = min(t1, max(u0, u1))
        if ok and t0 <= t1: return j
    -1

# the building whose box p is in (-1: none)
building_at = (g: Game, p: vec3) -> int:
    loop j in 0.. and b in g.buildings:
        if b.health <= 0: continue
        h = site_half(b.kind)
        l = quat_rotate(quat_axis_angle(vec3(0, 1, 0), -b.yaw), p - b.pos)
        if abs(f64(l.x)) < f64(h.x) and f64(l.y) > -1.0 and f64(l.y) < f64(h.y) * 2.0 and abs(f64(l.z)) < f64(h.z): return j
    -1

# rockets (on, faster, into what they come near), bombs (down, bursting on the ground or what
# they fall on) and shells (bursting when their fuse is done)
shells = (g: mut Game):
    kept: Shot[]
    loop s in g.shots:
        let s = s
        a = s.pos
        s.life -= 1
        if s.kind == PACK:
            # (a health pack: toward the craft nearest its way within 35 degrees and 450 m, any
            # side's; at it, it heals it)
            sp = f64(length(s.vel))
            d = normalize(s.vel)
            best = -1
            most = 0.82
            loop j in 0.. and c in g.crafts:
                if j == s.craft or not whole(c): continue
                to = c.pos - s.pos
                l = f64(length(to))
                if l > 450.0 or l < 0.1: continue
                v = f64(dot(to, d)) / l
                if v > most:
                    most = v
                    best = j
            if best >= 0:
                want = normalize(g.crafts[best].pos - s.pos)
                d = turn_toward(d, want, 2.2 * DT)
                if hits_craft(g.crafts[best], a, s.pos + d * f32(sp * DT), 2.0):
                    c = g.crafts[best]
                    g.crafts[best].health = min(c.health + HEAL, KINDS[c.kind].health)
                    g.booms.push(Boom(c.pos, HEALED, g.tick, best, s.by))
                    continue
            s.vel = d * f32(min(sp + 30.0 * DT, 110.0))
            s.pos += s.vel * f32(DT)
            if s.life > 0 and f64(s.pos.y) > ground(f64(s.pos.x), f64(s.pos.z)): kept.push(s)
            continue
        if s.kind == ROCKET:
            d = normalize(s.vel)
            sp = min(f64(length(s.vel)) + 120.0 * DT, 240.0)
            s.vel = d * f32(sp) + vec3(0, f32(-2.0 * DT), 0)
        else: s.vel.y -= f32(9.8 * DT)
        if s.kind == BOMB: s.vel = s.vel * f32(1.0 - 0.02 * DT)
        s.pos += s.vel * f32(DT)
        burst = s.life <= 0 and s.kind != BOMB
        # (a rocket bursts on, or right by, any craft but its own; a bomb on one it falls onto)
        # (a shell fired by someone at a gun: it bursts by any craft of the others it passes, after 120 m)
        if s.kind == FLAK and s.by >= 0 and s.life < 190 and not burst:
            loop c in g.crafts:
                if flying(c) and crew_team(g, c) != s.team and craft_distance(c, s.pos) < 12.0: burst = true
        struck = -1
        if s.kind != FLAK and not burst:
            loop j in 0..g.crafts.len():
                if j == s.craft or g.crafts[j].free or g.crafts[j].gone > 0: continue
                # (a rocket bursts by what it passes within 3 m: not by the cat, gone by before it can)
                if hits_craft(g.crafts[j], a, s.pos, if s.kind == ROCKET and g.crafts[j].kind != CAT: 3.0 else: if s.kind == ROCKET: 0.0 else: if s.kind == BOULDER: BOULDER_NEAR else: if s.kind == POT: POT_NEAR else: 0.0):
                    burst = true
                    struck = j
                    break
        gy = ground(f64(s.pos.x), f64(s.pos.z))
        if f64(s.pos.y) <= gy or (f64(s.pos.y) < gy + (if g.rules.mode == THUNDERDOME: 80.0 else: 40.0) and building_hit(g, a, s.pos) >= 0): burst = true
        if s.kind == ROCKET and s.life <= 0: burst = true
        if not burst:
            if f64(s.pos.y) > -50.0: kept.push(s)
            continue
        if s.kind == BOULDER:
            # (whatever it hits goes down; on the ground, what it lands on is crushed)
            if struck >= 0:
                g.booms.push(Boom(s.pos, SMASHED, g.tick, struck, s.by))
                hurt_craft(g, struck, s.by, s.team, if g.crafts[struck].kind == CASTLE: CASTLE_BOULDER else: 100000, s.pos)
            else:
                g.booms.push(Boom(s.pos, if gy <= 0.0: SPLASH else: DIRT, g.tick, -1))
                blast(g, s, 12.0, 170)
        else if s.kind == POT:
            # (a fire pot: it shatters and burns all round it, on what it struck or the ground)
            g.booms.push(Boom(s.pos, if struck < 0 and gy <= 0.0: SPLASH else: POTTED, g.tick, s.craft, s.by))
            if struck >= 0 or gy > 0.0: blast(g, s, POT_BLAST, POT_BURN)
        else if s.kind == CANNONBALL:
            if struck >= 0: hurt_craft(g, struck, s.by, s.team, CANNON_DAMAGE, s.pos)
            else:
                g.booms.push(Boom(s.pos, if gy <= 0.0: SPLASH else: BURST, g.tick, ROCKET))
                blast(g, s, 8.0, 40)
        else if s.kind == FLAK:
            g.booms.push(Boom(s.pos, FLAK_BURST, g.tick, -1))
            blast(g, s, 20.0, 18)
        else:
            g.booms.push(Boom(s.pos, if f64(s.pos.y) <= 0.3 and gy <= 0.0: SPLASH else: BURST, g.tick, s.kind))
            if s.kind == ROCKET: blast(g, s, 14.0, 55)
            else: blast(g, s, 30.0, 170)
    g.shots = kept

# what is within r of a burst: hurt the more the nearer
blast = (g: mut Game, s: Shot, r: f64, most: int):
    loop j in 0..g.crafts.len():
        c = g.crafts[j]
        if not whole(c): continue
        d = craft_distance(c, s.pos)
        if d < r:
            n = int(f64(most) * (1.0 - max(d, 0.0) / r))
            if n > 0:
                hurt_craft(g, j, s.by, s.team, n, s.pos)
    loop j in 0.. and b in g.buildings:
        if b.health <= 0: continue
        h = site_half(b.kind)
        l = quat_rotate(quat_axis_angle(vec3(0, 1, 0), -b.yaw), s.pos - b.pos - vec3(0, h.y, 0))
        q = vec3(f32(max(abs(f64(l.x)) - f64(h.x), 0.0)), f32(max(abs(f64(l.y)) - f64(h.y), 0.0)), f32(max(abs(f64(l.z)) - f64(h.z), 0.0)))
        d = f64(length(q))
        if d < r:
            hurt_building(g, j, s.by, s.team, int(f64(most) * (1.0 - d / r)))
    loop j in 0.. and p in g.people:
        if p.state == DEAD or p.state == SEATED: continue
        d = f64(length(p.pos - s.pos))
        if d < r * 0.8: hurt_person(g, j, s.by, s.team, int(f64(most) * (1.0 - d / r)))

# (nothing of the ground between a and b: a gun tower sees what it fires at; low behind a hill,
# a craft is out of its sight)
clear_line = (a: vec3, b: vec3) -> bool:
    d = b - a
    n = int(f64(length(d)) / 40.0) + 1
    loop k in 1..n:
        q = a + d * f32(f64(k) / f64(n))
        if f64(q.y) < ground(f64(q.x), f64(q.z)) + 1.0: return false
    true

# the guns on the ground. Against aircraft (AA): each at the nearest craft it takes for the
# other side's, within 900 m and well above it (its barrel goes no lower than 15 degrees, and its
# shells are fused for 120 m and up: low enough, it is flown under), a shell timed to burst
# where the craft will be (less skill, wider); along the gorge, with none to aim at, a barrage
# over a raider below. Machine guns: bursts at aircraft within 350 m, low ones too, and at people
# on foot. Someone at a gun aims and fires it (an AA shell bursts by any craft it passes)
guns_on_ground = (g: mut Game, pads: Pad[]):
    loop j in 0..g.buildings.len():
        b = g.buildings[j]
        if not is_gun(b.kind) or b.health <= 0: continue
        if b.cool > 0: g.buildings[j].cool -= 1
        if b.heat > 0: g.buildings[j].heat -= 1
        at = b.pos + vec3(0, f32(gun_height(b.kind)), 0)
        team = b.team
        if b.crew >= 0:
            # (a person at it: their aim, their trigger)
            pad = pads[b.crew]
            team = g.people[b.crew].team
            yaw = f64(pad.aim_yaw) / 1000.0
            pitch = clamp(f64(pad.aim_pitch) / 1000.0, if b.kind == AA: 0.1 else: if b.kind == NEST: -0.7 else: -0.25, 1.5)
            dir = vec3(f32(-sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))
            g.buildings[j].aim = dir
            if pad.fire and g.buildings[j].cool == 0: fire_gun(g, j, at, dir, team, b.crew)
            continue
        if b.cool > 0: continue
        # (the Thunderdome's time up and level: the towers' crews cease fire, the next points
        # soon scored)
        if b.kind == NEST and g.rules.time_limit > 0 and g.tick >= g.rules.time_limit * 3600: continue
        if b.kind == MG or b.kind == NEST:
            # (the nearest it takes for the other side's: a craft, or one on foot; a gun tower's
            # out to NEST_RANGE, its fire spread wide over where it aims: a hail to be flown through)
            reach = if b.kind == NEST: NEST_RANGE else: 350.0
            best = vec3(0, 0, 0)
            bv = vec3(0, 0, 0)
            least = reach
            loop o in g.air:
                if g.crafts[o.craft].safe > 0 or seen_at(g, o.craft, team) == team: continue
                d = f64(length(o.pos - at))
                if d < least and f64(o.pos.y) > f64(at.y) - (if b.kind == NEST: 60.0 else: 30.0) and (b.kind != NEST or clear_line(at, o.pos)):
                    least = d
                    best = o.pos
                    bv = o.vel
            loop p in g.people:
                if p.team == team or (p.state != WALK and p.state != CHUTE): continue
                d = f64(length(p.pos - at))
                if d < min(least, if b.kind == NEST: 400.0 else: 250.0):
                    least = d
                    best = p.pos + vec3(0, 1, 0)
                    bv = p.vel
            if least >= reach:
                g.buildings[j].cool = 20
                continue
            l = lead_from(at, vec3(0, 0, 0), best, bv)
            # (a gun tower's crew leads true: what flies on straight is hit; what turns hard, its
            # bullets two seconds on the way, they miss)
            w = if b.kind == NEST: NEST_SPREAD + 0.01 * (1.0 - g.skill) else: 0.03 + 0.04 * (1.0 - g.skill)
            t = f64(g.tick)
            dir = normalize(normalize(l) + vec3(f32(sin(t * 0.37 + f64(j)) * w), f32(cos(t * 0.29) * w), f32(sin(t * 0.41 + 2.0) * w)))
            # (it turns at most 80 degrees a second: one flashing past close is hard to follow)
            g.buildings[j].aim = turn_toward(b.aim, dir, 1.4 * 7.0 * DT)
            # (and a shell now and then, timed to burst where it will be: flak among the tracers)
            if b.kind == NEST and least > 220.0 and (g.tick + j * 17) % NEST_FLAK_GAP == 0:
                tt = f64(length(l)) / 300.0
                fd = normalize(l)
                g.shots.push(Shot(FLAK, at + fd * 3.0, fd * 300.0 + vec3(0, f32(4.9 * tt), 0), -1, -1, team, max(int(tt * 60.0), 12)))
            if g.buildings[j].heat < 200: fire_gun(g, j, at, g.buildings[j].aim, team, -1)
            else: g.buildings[j].cool = if b.kind == NEST: 50 else: 90
            continue
        best = -1
        least = 900.0
        loop o in g.air:
            k = o.craft
            if g.crafts[k].safe > 0 or seen_at(g, k, team) == team: continue
            d = f64(length(o.pos - at))
            if d < least and f64(o.pos.y) > f64(at.y) + max(120.0, d * 0.27):
                least = d
                best = k
        aim = vec3(0, 0, 0)
        level = -1.0
        if best >= 0:
            c = g.crafts[best]
            aim = c.pos + c.vel * f32(least / 300.0)
            # (the side's guns burst their shells at one height for it: a guess at first (now and
            # then a good one), then each shot set a third nearer where it was when fired; a
            # curtain of bursts at that height, which follows it up or down late)
            f = if team == 0: c.fuse0 else: c.fuse1
            now = f64(c.pos.y)
            if f < 0.0:
                h0 = hash(g.tick * 13 + best * 7 + team)
                off = 40.0 + f64(h0 % 100)
                f = now + (if (h0 >> 8) % 2 == 0: off else: -off)
                if (h0 >> 9) % 4 == 0: f = now + f64((h0 >> 12) % 20) - 10.0
            else: f += (now - f) * 0.33
            if team == 0: g.crafts[best].fuse0 = f
            else: g.crafts[best].fuse1 = f
            level = f
        else if g.rules.mode == TRENCH:
            # (a raider low in the gorge, within reach: a barrage over it, where it is going)
            loop o in g.air:
                if best < 0 and seen_at(g, o.craft, team) != team and f64(length(o.pos - at)) < 900.0:
                    best = 0
                    aim = o.pos + o.vel * 1.5 + vec3(0, f32(85.0 + f64(hash(g.tick + j) % 50)), 0)
        if best < 0:
            g.buildings[j].cool = 15
            continue
        h = hash(g.tick * 7 + j)
        spread = 14.0 + 30.0 * (1.0 - g.skill) + 0.03 * f64(length(aim - at))
        aim += vec3(f32((f64(h & 255) / 255.0 - 0.5) * spread * 2.0), f32((f64((h >> 8) & 255) / 255.0 - 0.5) * spread), f32((f64((h >> 16) & 255) / 255.0 - 0.5) * spread * 2.0))
        # (at the height set for it, give or take a few meters)
        if level >= 0.0: aim.y = f32(level + (f64((h >> 24) & 255) / 255.0 - 0.5) * 12.0)
        dir = normalize(aim - at)
        tt = f64(length(aim - at)) / 300.0
        g.buildings[j].aim = dir
        g.shots.push(Shot(FLAK, at + dir * 4.0, dir * 300.0 + vec3(0, f32(4.9 * tt), 0), -1, -1, team, max(int(tt * 60.0), 24)))
        g.buildings[j].shots += 1
        g.buildings[j].cool = 40 + int(hash(g.tick + j * 3) % 25)

# (the way `from` turned toward `to`, by at most `most` radians)
turn_toward = (from: vec3, to: vec3, most: f64) -> vec3:
    a = acos(clamp(f64(dot(from, to)), -1.0, 1.0))
    if a <= most: return to
    normalize(lerp(from, to, f32(most / a)))

# a ground gun fires, the way dir: an AA gun a shell (bursting by a craft it passes, or at 1 km),
# a machine gun a bullet
fire_gun = (g: mut Game, j: int, at: vec3, dir: vec3, team: int, by: int):
    b = g.buildings[j]
    if b.kind == AA:
        g.shots.push(Shot(FLAK, at + dir * 4.0, dir * 300.0, by, -1, team, 200))
        g.buildings[j].cool = 40
    else:
        if b.heat >= JAM_HEAT: return
        # (a gun tower's: farther, and faster)
        tower = b.kind == NEST
        if tower:
            # (a gun tower's twin guns, both at once, side by side: a hail of half-weight rounds)
            side = normalize(cross(dir, vec3(0, 1, 0)) + vec3(0.0001, 0, 0)) * 0.45
            loop sd in [-1.0, 1.0]: g.bullets.push(Bullet(at + dir * 1.8 + side * f32(sd), dir * f32(BULLET_SPEED), by, -1, team, NEST_LIFE, NEST_DAMAGE, heavy = true))
        else: g.bullets.push(Bullet(at + dir * 1.8, dir * f32(BULLET_SPEED), by, -1, team, BULLET_LIFE))
        g.buildings[j].cool = if by >= 0: (if tower: 4 else: 5) else: if tower: NEST_GAP else: 10
        g.buildings[j].heat += if tower: 5 else: 8
    g.buildings[j].shots += 1

# ---------------- the flags ----------------
# a flag is taken by one of the other side who comes to it (on foot, or flying through it low
# and slow), carried, dropped where its carrier died; brought home to one's own flag (at its
# home), it scores; one's own, touched where it was dropped, goes home (or by itself, later)
flags = (g: mut Game):
    loop fi in 0..g.flags.len():
        f = g.flags[fi]
        if not f.real: continue
        if f.carrier >= 0:
            p = g.people[f.carrier]
            g.flags[fi].pos = p.pos
            if p.state == DEAD:
                g.flags[fi].carrier = -1
                continue
            # (home with it, its own flag there: a point)
            own = g.flags[1 - fi]
            if own.carrier < 0 and f64(length(own.pos - own.home)) < 1.0 and near_flag(g, p, own.home):
                g.booms.push(Boom(own.home, SCORED, g.tick, fi, f.carrier))
                g.people[f.carrier].carry = -1
                g.flags[fi].carrier = -1
                g.flags[fi].pos = f.home
                g.flags[fi].out = 0
                score(g, p.team)
            continue
        away = f64(length(f.pos - f.home)) > 1.0
        if away:
            g.flags[fi].out += 1
            if g.flags[fi].out > 1800:
                g.flags[fi].pos = f.home
                g.flags[fi].out = 0
                g.booms.push(Boom(f.home, RETURNED, g.tick, fi))
                continue
        loop j in 0.. and p in g.people:
            if p.state == DEAD or p.state == FALL or p.state == CHUTE or not near_flag(g, p, f.pos): continue
            if p.team != f.team and p.carry < 0:
                g.flags[fi].carrier = j
                g.people[j].carry = fi
                g.booms.push(Boom(f.pos, TAKEN, g.tick, fi, j))
                break
            if p.team == f.team and away:
                g.flags[fi].pos = f.home
                g.flags[fi].out = 0
                g.booms.push(Boom(f.home, RETURNED, g.tick, fi, j))
                break

# (on foot within 3 m of it; in a craft, the craft through it low: within 12 m, under 45 m/s)
near_flag = (g: Game, p: Person, at: vec3) -> bool:
    if p.state == WALK: return f64(length(p.pos - at)) < 3.0
    if p.state != SEATED: return false
    c = g.crafts[p.craft]
    f64(length(c.pos - at - vec3(0, 4, 0))) < 12.0 and f64(length(c.vel)) < 45.0

drop_flag = (g: mut Game, i: int):
    p = g.people[i]
    if p.carry < 0: return
    fi = p.carry
    g.flags[fi].carrier = -1
    at = p.pos
    if p.state == SEATED: at = g.crafts[p.craft].pos
    g.flags[fi].pos = vec3(at.x, f32(ground(f64(at.x), f64(at.z))), at.z)
    g.people[i].carry = -1

# ---------------- the balls ----------------
# (the ball fight's balls at the start: about the middle of the field, each kind on either side of
# it alike, a little over the height each floats at)
BALL_HOMES = [vec2(0, 70), vec2(0, -70), vec2(120, -60), vec2(-120, 60), vec2(70, 140), vec2(-70, -140), vec2(0, 0), vec2(170, 170), vec2(-170, -170)]
# (and in the big fights, more struck balls, a pair for every two a side over eight, three pairs at
# most: so many strikers to so few balls, every one is fought over in the middle and none goes far)
MORE_KINDS = [BIG_BALL, BIG_BALL, MID_BALL, MID_BALL, SMALL_BALL, SMALL_BALL]
MORE_HOMES = [vec2(60, -220), vec2(-60, 220), vec2(220, -10), vec2(-220, 10), vec2(150, -200), vec2(-150, 200)]
ball_set = (n: int) -> Ball[]:
    out: Ball[]
    loop i in 0.. and k in BALL_KINDS: out.push(ball_at(k, BALL_HOMES[i]))
    loop i in 0..2 * clamp((n - 7) / 2, 0, 3): out.push(ball_at(MORE_KINDS[i], MORE_HOMES[i]))
    out
ball_at = (k: int, at: vec2) -> Ball:
    x = f64(at.x)
    z = f64(at.y)
    h = vec3(f32(x), f32(max(ground(x, z), 0.0) + BALL_REST[k] + 25.0), f32(z))
    Ball(k, h, vec3(0, 0, 0), h)

# (the ball person pk carries: -1 none)
ball_of = (g: Game, pk: int) -> int:
    if pk < 0: return -1
    loop bi in 0..g.balls.len():
        if g.balls[bi].carrier == pk: return bi
    -1
# (whether craft j's pilot carries a ball)
carrying = (g: Game, j: int) -> bool: g.balls.len() > 0 and g.crafts[j].seats.len() > 0 and ball_of(g, g.crafts[j].seats[0]) >= 0

# (craft j hurt this much: its pilot's ball, if it has one, let go when it has been hurt enough)
lose_ball = (g: mut Game, j: int, amount: int):
    if g.balls.len() == 0 or g.crafts[j].seats.len() == 0: return
    bi = ball_of(g, g.crafts[j].seats[0])
    if bi < 0: return
    g.balls[bi].jolts += amount
    if g.balls[bi].jolts >= BALL_HOLD: drop_ball(g, bi)

# (a carried ball let go: on the way it was going, anyone's to take in a moment, its carrier's
# again only after 2 s)
drop_ball = (g: mut Game, bi: int):
    b = g.balls[bi]
    g.booms.push(Boom(b.pos, LOOSE, g.tick, bi, b.carrier))
    g.balls[bi].dropper = b.carrier
    g.balls[bi].carrier = -1
    g.balls[bi].free_at = g.tick + 20
    g.balls[bi].touched = g.tick

# (whether the way a-b passes through ring rg's face, within r of its middle)
through = (rg: Ring, a: vec3, b: vec3, r: f64) -> bool:
    da = f64(dot(a - rg.at, rg.dir))
    db = f64(dot(b - rg.at, rg.dir))
    if (da > 0.0) == (db > 0.0): return false
    t = da / (da - db)
    p = a + (b - a) * f32(t)
    f64(length(p - rg.at)) < r

# (ball bi through ring ri: its points to the other side, and the ball back in the middle)
goal = (g: mut Game, bi: int, ri: int):
    b = g.balls[bi]
    rg = rings()[ri]
    g.booms.push(Boom(rg.at, GOAL, g.tick, bi, b.by))
    score(g, 1 - rg.team, BALL_POINTS[b.kind])
    to_middle(g, bi)

to_middle = (g: mut Game, bi: int):
    b = g.balls[bi]
    g.balls[bi] = Ball(b.kind, b.home, vec3(0, 0, 0), b.home, touched = g.tick, free_at = g.tick + 60)

# (v, no faster than most m/s)
cap = (v: vec3, most: f64) -> vec3:
    l = f64(length(v))
    if l > most: v * f32(most / l) else: v

# the balls for a tick: struck by the crafts flying into them (pushed the way the craft met them,
# the more the heavier and faster it is; the craft slowed a little, unhurt), carry balls taken by
# those who fly through them, carried slung under their crafts; free, each floats back to its
# height, slows, bounces off the ground, the rings' rims and posts, the fight's edge, and the
# others; through a ring, a goal
balls = (g: mut Game):
    rs = rings()
    loop o in g.air:
        ci = o.craft
        if g.crafts[ci].down > 0 or g.crafts[ci].kind == DRONE: continue
        loop bi in 0..g.balls.len():
            if g.balls[bi].carrier >= 0: continue
            b = g.balls[bi]
            r = BALL_R[b.kind]
            d = b.pos - o.pos
            reach = f64(o.reach) + r + 4.0
            if f64(dot(d, d)) > reach * reach: continue
            c = g.crafts[ci]
            pk = pilot_of(c)
            if b.kind == CARRY_BALL:
                # (taken: flown through, by a pilot with none, not the cat's; not at once by who dropped it)
                if pk >= 0 and c.kind != CAT and g.tick >= b.free_at and (pk != b.dropper or g.tick >= b.free_at + 100) and ball_of(g, pk) < 0:
                    g.balls[bi].carrier = pk
                    g.balls[bi].jolts = 0
                    g.balls[bi].by = pk
                    g.balls[bi].dropper = -1
                    g.booms.push(Boom(b.pos, CAUGHT, g.tick, bi, pk))
                continue
            gap = craft_distance(c, b.pos) - r
            if gap > 0.0: continue
            n = if length(d) > 0.01: normalize(d) else: fwd_of(c)
            g.balls[bi].pos = b.pos + n * f32(-gap + 0.05)
            vn = f64(dot(c.vel - b.vel, n))
            if vn <= 0.0 or (b.by == pk and g.tick - b.touched < KICK_AGAIN): continue
            mc = KINDS[c.kind].mass * CRAFT_PUSH
            mb = BALL_MASS[b.kind]
            j = (1.0 + BALL_BOUNCE[b.kind]) * vn * mc * mb / (mc + mb)
            # (struck, it is off like a ball kicked, far ahead of what struck it: the faster met
            # and the heavier the craft against it, the harder. Pushed more the way the craft met
            # it than off its middle, a craft's nose being broad to a ball; and it lifts a little)
            kick = BALL_KICK[b.kind] * vn * sqrt(mc / (mc + mb))
            rv = c.vel - b.vel
            way = normalize(n + normalize(rv) * f32(1.2))
            g.balls[bi].vel = cap(b.vel + way * f32(kick) + vec3(0, f32(kick * 0.05), 0), BALL_TOP[b.kind])
            g.crafts[ci].vel = c.vel - way * f32(j / mc * 0.5)
            j = kick * mb
            g.balls[bi].by = pk
            g.balls[bi].touched = g.tick
            if j / mb > 3.0 and g.tick - b.hit_at > 12:
                g.balls[bi].hit_at = g.tick
                g.booms.push(Boom(b.pos - n * f32(r), STRUCK, g.tick, bi, pk))
    loop bi in 0..g.balls.len():
        let b = g.balls[bi]
        k = b.kind
        r = BALL_R[k]
        if b.carrier >= 0:
            p = g.people[b.carrier]
            if p.state != SEATED or p.seat != 0 or not whole(g.crafts[p.craft]):
                drop_ball(g, bi)
                continue
            c = g.crafts[p.craft]
            # (slung under it, toward its nose)
            h = KINDS[c.kind].half
            b.pos = c.pos + fwd_of(c) * f32(f64(h.z) * 0.5 + 0.8) - up_of(c) * f32(f64(h.y) + r + 0.3)
            b.vel = c.vel
            b.touched = g.tick
            g.balls[bi] = b
            # (carried through one of the others' rings, on the craft's way this tick)
            loop ri in 0.. and rg in rs:
                if rg.team != p.team and through(rg, c.pos - c.vel * f32(DT), c.pos, RING_R - 1.0):
                    goal(g, bi, ri)
                    break
            continue
        a = b.pos
        alt = f64(b.pos.y) - ground(f64(b.pos.x), f64(b.pos.z))
        b.vel.y -= f32(BALL_FALL[k] * clamp((alt - BALL_REST[k]) / 12.0, -1.0, 1.0) * DT)
        b.vel = b.vel * f32(1.0 - BALL_DRAG[k] * DT)
        # (its bobbing about its height dies away)
        b.vel.y = b.vel.y * f32(1.0 - 0.3 * DT)
        if alt > 450.0: b.vel.y = min(b.vel.y, 0.0)
        # (the small ones spin, struck: they swerve, one way, then the other, every second and a half)
        if k == SMALL_BALL:
            across = vec3(b.vel.z, 0, -b.vel.x)
            sp = f64(length(across))
            if sp > 2.0:
                way = if hash((g.tick / 90) * 7 + bi) % 2 == 0: 1.0 else: -1.0
                b.vel += normalize(across) * f32(way * min(sp * 0.06, 2.5) * DT)
        b.pos += b.vel * f32(DT)
        gy = ground(f64(b.pos.x), f64(b.pos.z))
        if f64(b.pos.y) - r < gy:
            b.pos.y = f32(gy + r)
            if b.vel.y < 0.0: b.vel.y = f32(-f64(b.vel.y) * BALL_BOUNCE[k])
            b.vel = vec3(b.vel.x * 0.92, b.vel.y, b.vel.z * 0.92)
        # (the fight's edge: back off it)
        out = outside(b.pos)
        if out > 0.0:
            w = inward(b.pos)
            toward = f64(dot(b.vel, w))
            if toward < 0.0: b.vel -= w * f32(toward * (1.0 + BALL_BOUNCE[k]))
            b.pos += w * f32(out)
        # (the rings' rims, round their holes, and the posts under them)
        loop rg in rs:
            rel = b.pos - rg.at
            dp = f64(dot(rel, rg.dir))
            if abs(dp) < r + RING_RIM:
                rad = rel - rg.dir * f32(dp)
                rl = f64(length(rad))
                rc = RING_R + RING_RIM
                if rl > RING_R and rl < rc + RING_RIM + r:
                    q = rg.at + rad * f32(rc / rl)
                    dd = b.pos - q
                    dl = f64(length(dd))
                    if dl < RING_RIM + r and dl > 0.01:
                        nn = dd * f32(1.0 / dl)
                        b.pos = q + nn * f32(RING_RIM + r)
                        vn = f64(dot(b.vel, nn))
                        if vn < 0.0: b.vel -= nn * f32(vn * (1.0 + BALL_BOUNCE[k]))
            if f64(b.pos.y) - r < f64(rg.at.y) - RING_R - 2.0 * RING_RIM:
                h = vec3(b.pos.x - rg.foot.x, 0, b.pos.z - rg.foot.z)
                hl = f64(length(h))
                if hl < r + 0.8 and hl > 0.01:
                    nn = h * f32(1.0 / hl)
                    b.pos += nn * f32(r + 0.8 - hl)
                    vn = f64(dot(b.vel, nn))
                    if vn < 0.0: b.vel -= nn * f32(vn * (1.0 + BALL_BOUNCE[k]))
        g.balls[bi] = b
        scored = false
        loop ri in 0.. and rg in rs:
            if through(rg, a, b.pos, RING_R):
                goal(g, bi, ri)
                scored = true
                break
        if not scored and g.tick - b.touched > BALL_IDLE and f64(length(b.pos - b.home)) > 40.0:
            to_middle(g, bi)
            g.booms.push(Boom(b.home, BALL_BACK, g.tick, bi))
    # (into each other: apart, bounced by their masses)
    loop i in 0..g.balls.len():
        if g.balls[i].carrier >= 0: continue
        loop j in i + 1..g.balls.len():
            if g.balls[j].carrier >= 0: continue
            d = g.balls[j].pos - g.balls[i].pos
            rr = BALL_R[g.balls[i].kind] + BALL_R[g.balls[j].kind]
            l = f64(length(d))
            if l >= rr + BALL_APART or l < 0.01: continue
            n = d * f32(1.0 / l)
            mi = BALL_MASS[g.balls[i].kind]
            mj = BALL_MASS[g.balls[j].kind]
            # (near, the struck ones drift apart a little, level: a knot of them in the middle
            # loosens, by their masses)
            if g.balls[i].kind != CARRY_BALL and g.balls[j].kind != CARRY_BALL:
                a = BALL_SPREAD * (1.0 - max(l - rr, 0.0) / BALL_APART) * DT
                flat = vec3(n.x, 0, n.z)
                g.balls[i].vel -= flat * f32(a * mj / (mi + mj))
                g.balls[j].vel += flat * f32(a * mi / (mi + mj))
            if l >= rr: continue
            push = rr - l
            g.balls[i].pos -= n * f32(push * mj / (mi + mj))
            g.balls[j].pos += n * f32(push * mi / (mi + mj))
            vn = f64(dot(g.balls[i].vel - g.balls[j].vel, n))
            if vn <= 0.0: continue
            jj = 1.7 * vn * mi * mj / (mi + mj)
            g.balls[i].vel -= n * f32(jj / mi)
            g.balls[j].vel += n * f32(jj / mj)

# ---------------- the computer ----------------
# the stick and rudder that turn craft c toward the direction want: far off, roll it overhead and
# pull; nearly there (or a little below: pushed down, not rolled over), small corrections with
# the wings level (between, some of each: no twitching from one to the other). The corrections
# are as strong as the kind turns fast: each closes on the aim in about a sixth of a second,
# whatever the kind (stronger, a nimble one would overshoot and wobble; weaker, a big one lag)
steer = (c: Craft, want: vec3) -> Pad:
    k = KINDS[c.kind]
    l = quat_rotate(quat_inverse(c.rot), normalize(want))     # (-z ahead, +x right, +y up)
    ahead = f64(-l.z)
    a = max(ahead, 0.1)
    right = right_of(c)
    rate = 6.0
    pr = max(k.pitch_rate, 0.1)
    yr = max(k.yaw_rate, 0.1)
    rr = max(k.roll_rate, 0.1)
    near_pitch = clamp(f64(l.y) / a * rate / pr, -1.0, 1.0)
    near_yaw = clamp(f64(l.x) / a * rate / yr * 0.4, -1.0, 1.0)
    near_roll = clamp((f64(right.y) * 1.6 + f64(l.x) / a * 4.0) * 2.6 / rr, -1.0, 1.0)
    err = atan2(f64(l.x), f64(l.y))
    off = acos(clamp(ahead, -1.0, 1.0))
    # (far off: rolled and pulled as hard as a fighter would be, no harder: a kind that rolls
    # and pulls far faster (the cat) would go past and back, round and round, upside down)
    far_roll = clamp(err * 2.0 * min(1.0, 3.6 / rr), -1.0, 1.0)
    far_pitch = (if abs(err) < 1.2: clamp(off * 3.0, 0.0, 1.0) else: 0.2) * min(1.0, 2.4 / pr)
    blend = smoothstep(0.94, 0.995, ahead)
    # (a little below and not far aside: pushed down, not rolled over)
    if l.y < 0.0 and abs(f64(l.x)) < 0.5 * abs(f64(l.y)) + 0.05: blend = max(blend, smoothstep(0.7, 0.85, ahead))
    p = Pad()
    p.pitch = int((far_pitch + (near_pitch - far_pitch) * blend) * 100.0)
    p.roll = int((far_roll + (near_roll - far_roll) * blend) * 100.0)
    p.yaw = int(near_yaw * blend * 100.0)
    # (banked, the nose falls (fly_air): rudder toward the sky holds it up, as a player's would)
    if c.kind != ROCKETEER and c.kind != CAT and abs(f64(right.y)) > 0.05:
        tilt = 1.0 - max(f64(up_of(c).y), 0.0)
        hold = min(0.5 * tilt / abs(f64(right.y)), 1.0) * (if right.y < 0.0: -1.0 else: 1.0)
        p.yaw = clamp(p.yaw + int(hold * 100.0), -100, 100)
    p

# a zeppelin's (or a bomber's on the ground's) way toward a point: turn by the rudder, up or down
steer_flat = (c: Craft, want: vec3, alt: f64) -> Pad:
    l = quat_rotate(quat_inverse(c.rot), normalize(vec3(want.x, 0, want.z)))
    p = Pad()
    p.yaw = int(clamp(f64(l.x) * 3.0 + (if l.z > 0.0: (if l.x >= 0.0: 1.0 else: -1.0) else: 0.0), -1.0, 1.0) * 100.0)
    p.pitch = int(clamp((alt - f64(c.pos.y)) / 60.0, -1.0, 1.0) * 100.0)
    p.throttle = 1
    p

# the craft each of the computer's pilots goes after: the nearest it takes for the other side's,
# the nearer the more ahead; looked at again every 1.5 s, and when that one is down
choose_targets = (g: mut Game):
    loop me in g.air:
        i = me.craft
        if g.crafts[i].down > 0 or g.crew[i] == GOLD: continue
        team = g.crew[i]
        cur = g.crafts[i].target
        ok = cur >= 0 and cur < g.crafts.len() and not g.crafts[cur].free and g.crafts[cur].gone == 0 and g.crafts[cur].down == 0 and not g.crafts[cur].landed and g.crafts[cur].safe == 0 and seen_at(g, cur, team) != team
        if ok and (g.tick + i * 7) % 90 != 0: continue
        f = quat_rotate(g.crafts[i].rot, vec3(0, 0, -1))
        kind = g.crafts[i].kind
        best = -1
        least = 1e18
        loop o in g.air:
            j = o.craft
            if j == i or g.crafts[j].safe > 0 or seen_at(g, j, team) == team: continue
            d = o.pos - me.pos
            l = max(f64(length(d)), 1.0)
            v = l * (2.0 - f64(dot(f, d)) / l)
            # (fighters go for the big ones first, scouts for fighters)
            ek = g.crafts[j].kind
            if ek == BOMBER or ek == ZEPPELIN or ek == ULTRA or ek == CASTLE: v *= if kind == FIGHTER: 0.6 else: 1.3
            if j == cur: v *= 0.7
            if ek == DRONE: v *= 2.5
            # (the little screw, a gun tower: let alone unless it is much the nearest)
            if ek == SCREW: v *= 2.0
            # (the cat: worth the most, gone after first; it goes for anything but the other cat)
            if ek == CAT and cat_fight(g.rules.mode): v *= 0.45
            # (the golden cat: the fight won, if shot down)
            if g.crafts[j].team == GOLD: v *= 0.2
            # (the ball fight: one carrying a ball, gone after first)
            if g.rules.mode == BROOMS and carrying(g, j): v *= 0.35
            if kind == CAT and ek == CAT: v *= 50.0
            if v < least:
                least = v
                best = j
        g.crafts[i].target = best

# (Bikes & Brooms' golden cat: out in its time, over the middle; crashed by itself, out again
# in a while)
golden_cat = (g: mut Game):
    gi = g.gold
    # (never faster than GOLD_FAST: caught, by one flown well; and after the fight, still)
    if gi >= 0 and gi < g.crafts.len() and g.crafts[gi].team == GOLD: g.crafts[gi].vel = cap(g.crafts[gi].vel, GOLD_FAST)
    if g.winner >= 0: return
    gp = gold_person(g)
    if gi >= 0 and (gi >= g.crafts.len() or g.crafts[gi].team != GOLD or g.crafts[gi].free or g.crafts[gi].down > 0):
        g.gold = -1
        g.gold_at = g.tick + (if gp >= 0: GOLD_AGAIN_PLAYER else: GOLD_AGAIN)
    if g.gold >= 0 or g.tick < g.gold_at: return
    # (a player's: not out again after the whistle)
    if gp >= 0 and g.rules.time_limit > 0 and g.tick >= g.rules.time_limit * 3600: return
    a = f64(hash(g.tick * 31 + 7) % 6283) / 1000.0
    dir = vec3(f32(cos(a)), 0, f32(sin(a)))
    c = flying_craft(CAT, GOLD, vec3(0, f32(max(ground(0.0, 0.0), 0.0) + 200.0), 0), dir)
    c.throttle = 1.0
    c.health = GOLD_HEALTH
    g.crafts.push(c)
    g.gold = g.crafts.len() - 1
    if gp >= 0:
        g.crafts[g.gold].seats[0] = gp
        g.crafts[g.gold].manned = g.tick
        g.people[gp].state = SEATED
        g.people[gp].craft = g.gold
        g.people[gp].seat = 0
        g.people[gp].pos = c.pos
    g.booms.push(Boom(c.pos, GOLD_OUT, g.tick, g.gold))

# (the golden cat's player: in its seat while it is out, else in the loft, waiting; never out of it)
gold_seat = (g: mut Game, i: int):
    let p = g.people[i]
    p.held = 0
    if p.state == SEATED and g.crafts[p.craft].team == GOLD and not g.crafts[p.craft].free and g.crafts[p.craft].gone == 0:
        c = g.crafts[p.craft]
        p.pos = point_of(c, KINDS[c.kind].seats[0].at)
        p.vel = c.vel
    else:
        if p.state == SEATED and p.craft >= 0 and p.craft < g.crafts.len() and g.crafts[p.craft].seats[0] == i: g.crafts[p.craft].seats[0] = -1
        p.state = DEAD
        p.craft = -1
        p.seat = -1
        p.pos = GOLD_LOFT
        p.vel = vec3(0, 0, 0)
        p.timer = max(g.gold_at - g.tick, 0)
    g.people[i] = p

# (the computer at the balls goes after the golden cat instead, near enough, carrying none)
after_gold = (g: Game, c: Craft) -> bool:
    if g.gold < 0 or c.target != g.gold: return false
    pi = pilot_of(c)
    pi >= 0 and ball_of(g, pi) < 0 and f64(length(g.crafts[g.gold].pos - c.pos)) < GOLD_CHASE

# (the golden cat's flying: away from whoever is near, the nearer the harder, weaving all the
# while and breaking hard aside when one is close; back over the field between the rings when it
# strays; off the ground and under the clouds)
gold_pad = (g: Game, i: int) -> Pad:
    c = g.crafts[i]
    fwd = fwd_of(c)
    away = vec3(0, 0, 0)
    near = 1e9
    loop o in g.air:
        if o.craft == i: continue
        d = c.pos - o.pos
        l = f64(length(d))
        near = min(near, l)
        if l < GOLD_SHY and l > 0.1: away += d * f32((GOLD_SHY - l) / (l * GOLD_SHY))
    t = f64(g.tick) / 60.0
    flat = vec3(fwd.x, 0, fwd.z)
    flat = if length(flat) > 0.05: normalize(flat) else: vec3(1, 0, 0)
    side = vec3(-flat.z, 0, flat.x)
    want = fwd + side * f32(sin(t * 0.9) * 0.7) + vec3(0, f32(sin(t * 0.55) * 0.3), 0)
    if length(away) > 0.001:
        want = normalize(away) * 2.0 + want * 0.6
        # (one close behind: a hard break, one way then the other)
        if near < 60.0: want += side * f32(if (g.tick / 50) % 2 == 0: 2.2 else: -2.2)
    home = vec3(0, 0, 0) - vec3(c.pos.x, 0, c.pos.z)
    far = f64(length(home))
    if far > 900.0: want += normalize(home) * f32((far - 900.0) / 250.0)
    alt = f64(c.pos.y) - max(ground(f64(c.pos.x), f64(c.pos.z)), 0.0)
    if alt < 80.0: want += vec3(0, f32((80.0 - alt) / 25.0), 0)
    if alt > 420.0: want -= vec3(0, f32((alt - 420.0) / 60.0), 0)
    ah = c.pos + c.vel * 2.5
    if f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + 40.0: want += vec3(0, 2.0, 0)
    # (no steep dives: it would outrun everything)
    want = normalize(want)
    if want.y < -0.35: want = normalize(vec3(want.x, -0.35, want.z))
    pad = steer(c, want)
    # (chased, about as fast as a witch flat out, a little less: caught by one flown well; else idling)
    fast = if near < GOLD_SHY * 1.5: GOLD_FAST else: GOLD_FAST * 0.55
    pad.throttle = if f64(length(c.vel)) > fast: -1 else: 1
    pad

# person i's controls, played by the computer: on foot to a craft and in; in a craft, its pilot
bot_pad = (g: Game, i: int) -> Pad:
    p = g.people[i]
    if p.state == DEAD: return Pad()
    # (on a deck (a player who left): into a seat in reach, else off it)
    if p.state == WALK and p.craft >= 0:
        near = seat_near(g, p.craft, p.deck) >= 0
        return Pad(aim_yaw = int(p.yaw * 1000.0), enter = near and g.tick % 10 == i % 10, leave = not near and g.tick % 60 == i % 60)
    if p.state == WALK: return bot_walk(g, i, p)
    if p.state == FALL or p.state == CHUTE: return Pad(aim_yaw = int(p.yaw * 1000.0))
    c = g.crafts[p.craft]
    # (going down in flames, far enough up: out, the less skilled the later)
    if c.down > 20 + int((1.0 - g.skill) * 60.0) and f64(c.pos.y) - ground(f64(c.pos.x), f64(c.pos.z)) > 60.0 and not KINDS[c.kind].lighter: return Pad(leave = g.tick % 2 == 0)
    if p.seat != 0: return Pad()
    bot_fly(g, p.craft, c)

# on foot: to the nearest free craft of its side (the pilot's seat), and in; in the air-start
# fights, back in the air at once
bot_walk = (g: Game, i: int, p: Person) -> Pad:
    if not starts_on_ground(g, p.team): return Pad(leave = g.tick % 20 == 0)
    best = -1
    least = 1e18
    # (each picks by its number: some the big ones, the rest fighters and scouts)
    want_big = role(i) == 1
    loop c in g.ground:
        if f64(length(c.vel)) > 3.0: continue
        # (its side's flying castle on the ground, flown, a seat free: those for the big ones go
        # aboard, its gunners)
        crew = c.flown and c.kind == CASTLE and c.team == p.team and want_big and g.crafts[c.craft].seats.contains(-1)
        if c.flown and not crew: continue
        # (its own side's colors; one of the other side's only when very near)
        d = f64(length(c.pos - p.pos))
        if c.team != p.team and d > 60.0: continue
        big = c.kind == BOMBER or c.kind == ULTRA or c.kind == ZEPPELIN or c.kind == BALLOON or c.kind == CASTLE
        if big != want_big: d += 400.0
        if c.kind == ZEPPELIN: d += 150.0
        # (the flying castle, far out past the rest, for those for the big ones: theirs first)
        if c.kind == CASTLE and want_big: d -= 600.0
        # (the unusual ones are the players' to take: one only when it has stood a minute unflown,
        # or nothing else is free)
        # (in the Thunderdome and Bikes & Brooms they are what there is)
        if c.kind != SCOUT and c.kind != FIGHTER and c.kind != BOMBER and c.idle < 3600 and not cat_fight(g.rules.mode) and not crew: d += 5000.0
        if d < least:
            least = d
            best = c.craft
    # (nothing near, far from its field: back there)
    if best < 0 or (least > 350.0 and far_from_field(p)): return Pad(aim_yaw = int(p.yaw * 1000.0), leave = g.tick % 30 == i % 30)
    c = g.crafts[best]
    to = point_of(c, board_at(c.kind, KINDS[c.kind].seats[0].at)) - p.pos
    if c.kind == ZEPPELIN: to = point_of(c, vec3(-3, -11, -24)) - p.pos
    if c.kind == DAVINCI: to = point_of(c, DV_LADDER) - p.pos
    if c.kind == CASTLE: to = point_of(c, CASTLE_GATE) - p.pos
    to.y = 0.0
    d = f64(length(to))
    pad = Pad()
    pad.aim_yaw = int(atan2(-f64(to.x), -f64(to.z)) * 1000.0)
    pad.pitch = if d > 1.5: -100 else: 0
    # (round the craft, not into it: aside when it is in the way)
    if d < 12.0 and d > 3.0: pad.roll = if hash(i) % 2 == 0: 40 else: -40
    # (the long way to a flying castle's gate: round the buildings between, aside of one ahead)
    if c.kind == CASTLE and d > 12.0:
        way = normalize(to)
        loop bd in g.buildings:
            if bd.health <= 0 or bd.kind == AA or bd.kind == MAST or bd.kind == TARGET: continue
            h = site_half(bd.kind)
            ahead = quat_rotate(quat_axis_angle(vec3(0, 1, 0), -bd.yaw), p.pos + way * 7.0 - bd.pos)
            if abs(f64(ahead.x)) < f64(h.x) + 2.0 and abs(f64(ahead.z)) < f64(h.z) + 2.0:
                side = f64(cross(way, bd.pos - p.pos).y)
                pad.roll = if side > 0.0: 100 else: -100
                pad.pitch = -30
                break
    pad.enter = d < ENTER - 2.0 and g.tick % 10 == 0
    pad.throttle = 1
    pad

# what the computer's person i does: 0 fights, 1 flies the big ones, 2 runs for the flag (in
# Capture the flag; else fights)
role = (i: int) -> int: (i / 2) % 3

# the computer's pilot of craft ci: take off (along the field), then fight, bomb, or go home
bot_fly = (g: Game, ci: int, c: Craft) -> Pad:
    k = KINDS[c.kind]
    team = crew_team(g, c)
    if c.down > 0: return Pad()
    # (the ball fight: most of the computer's at the balls, each in its part; the rest fight; the
    # big ones, too slow for the balls and every gun's mark, as ever, their gunners fighting)
    if g.rules.mode == BROOMS and at_balls(g, c) and not after_gold(g, c): return bot_ball(g, ci, c, team)
    if k.heli: return bot_heli(g, ci, c, team)
    if c.landed:
        pad = Pad()
        # (a player on foot near, a seat free: wait for them to come aboard, 15 s at most)
        if c.wait > 0 and c.wait < 900:
            pad.throttle = -1
            return pad
        pad.throttle = 1
        if k.lighter:
            pad.pitch = 100
            return pad
        # (out of the row of parked planes onto the strip, slowly and straight; then turned
        # down the strip; then away)
        f = fields()[team]
        fwd = fwd_of(c)
        speed = f64(length(c.vel))
        across = f64(dot(c.pos - f.at, vec3(-f.dir.z, 0, f.dir.x)))
        want = f.dir
        if c.team != team or abs(across) > STRIP_WIDE + 60.0: want = vec3(fwd.x, 0, fwd.z)
        # (another craft in its way on the ground, the farther the faster this one rolls: one
        # rolling, wait for it to go; one standing, steer round it. Onto the strip only when no
        # one is rolling down it toward this one. Waited 6 s, it goes on all the same: a slow
        # bump only stops them)
        right = vec3(-fwd.z, 0, fwd.x)
        if c.rest < 360:
            loop o in g.ground:
                if o.craft == ci: continue
                d = o.pos - c.pos
                l = f64(length(d))
                if l < 0.1 or l > 200.0: continue
                ahead_d = f64(dot(d, vec3(fwd.x, 0, fwd.z)))
                aside = f64(dot(d, right))
                width = f64(k.half.x + KINDS[o.kind].half.x) * 0.9 + 2.0
                reach = f64(k.half.z + KINDS[o.kind].half.z) + 10.0 + speed * 2.5
                if ahead_d > 0.0 and ahead_d < reach and abs(aside) < width:
                    if o.vel != vec3(0, 0, 0):
                        pad.throttle = -1
                        return pad
                    pad.yaw = if aside > 0.0: -100 else: 100
                    if speed > 4.0: pad.throttle = -1
                    return pad
                os = f64(length(o.vel))
                if abs(across) > STRIP_WIDE - 4.0 and os > 6.0 and l < 160.0 and f64(dot(o.vel, d * -1.0)) / (os * l) > 0.5:
                    pad.throttle = -1
                    return pad
        # (down the strip in three lanes, each by its number: many take off side by side)
        if c.team == team and abs(across) < STRIP_WIDE + 60.0:
            lane = f64(ci % 3 - 1) * 22.0
            side = vec3(-f.dir.z, 0, f.dir.x)
            want = normalize(f.dir + side * f32(clamp((lane - across) * 0.03, -0.35, 0.35)))
        l = f64(cross(vec3(fwd.x, 0, fwd.z), want).y)
        aligned = f64(dot(vec3(fwd.x, 0, fwd.z), want)) > 0.97
        on_strip = abs(across) < STRIP_WIDE - 4.0
        if on_strip or aligned: pad.yaw = int(clamp(-l * 4.0, -1.0, 1.0) * 100.0)
        if not aligned and speed > 6.0: pad.throttle = -1
        if aligned and speed > k.stall * 1.2: pad.pitch = 40
        return pad
    if c.kind == BALLOON: return bot_balloon(g, c, team)
    if c.kind == CAT: return bot_cat(g, ci, c)
    if c.kind == ORNITHOPTER: return bot_ornithopter(g, ci, c, team)
    if k.lighter or c.kind == BOMBER or c.kind == ULTRA: return bot_bomber(g, ci, c, team)
    bot_fighter(g, ci, c)

# (the ball fight's parts, by the computer's person's number: 0, 2 and 4 strike the balls toward
# the other side's rings, 1 carries the small ones there, 3 fights (the carriers first). Four a
# side or fewer, none is kept back to fight: the cat does that; the fourth carries too)
ball_role = (g: Game, i: int) -> int:
    j = i / 2
    if g.people.len() <= 8: return [0, 1, 2, 1][j % 4]
    j % 5

# (whether craft c is flown at the balls by the computer, in its part: not a fighter's, nor one too
# big or slow for them)
at_balls = (g: Game, c: Craft) -> bool:
    k = KINDS[c.kind]
    if c.landed or c.kind == CAT or c.kind == BALLOON or c.kind == BOMBER or c.kind == ULTRA or k.lighter: return false
    pi = pilot_of(c)
    pi >= 0 and (ball_role(g, pi) != 3 or ball_of(g, pi) >= 0)

# (how many strikers of a side may go after one struck ball before the rest look for another: one
# ball mobbed by all of them goes nowhere)
const BALL_CHASERS = 2

# the computer at the balls: carrying one, to the nearest of the other side's rings, round to its
# face and through it; a carrier, to the nearest carry ball and through it; a striker, to a ball
# (the nearer the more likely, and the nearer its own rings), round behind it from the ring it is to
# go through, and into it that way. A burst at one of the others close ahead
bot_ball = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    k = KINDS[c.kind]
    pi = pilot_of(c)
    fwd = fwd_of(c)
    speed = f64(length(c.vel))
    rs = rings()
    mine = ball_of(g, pi)
    go = vec3(0, f32(ground(0.0, 0.0) + 60.0), 0)
    run_in = false
    if mine >= 0:
        ri = -1
        least = 1e18
        loop j in 0.. and rg in rs:
            d = f64(length(rg.at - c.pos))
            if rg.team != team and d < least:
                least = d
                ri = j
        if ri >= 0:
            rg = rs[ri]
            rel = c.pos - rg.at
            ahead = f64(dot(rel, rg.dir))
            aside = f64(length(rel - rg.dir * f32(ahead)))
            # (in front of it and lined up: through it; else out in front of it first)
            go = if ahead > 30.0 and aside < ahead * 0.45 + 4.0: rg.at - rg.dir * 25.0 else: rg.at + rg.dir * f32(max(ahead, 0.0) * 0.5 + 280.0)
    else:
        role = ball_role(g, pi)
        best = -1
        least = 1e18
        loop bi in 0..g.balls.len():
            b = g.balls[bi]
            if b.carrier >= 0 or (b.kind == CARRY_BALL) != (role == 1): continue
            if b.kind == CARRY_BALL and g.tick < b.free_at: continue
            d = f64(length(b.pos - c.pos))
            # (the nearer either side's rings, the likelier: a goal to stop, or one to score)
            end = 1e9
            loop rg in rs: end = min(end, f64(length(rg.at - b.pos)))
            v = d * (0.7 + 0.6 * f64(hash(ci * 977 + bi * 31) % 1000) / 1000.0) * (0.4 + 0.6 * clamp(end / 1800.0, 0.0, 1.0))
            # (a struck ball BALL_CHASERS of the side's other strikers are nearer to: another, likelier)
            if b.kind != CARRY_BALL:
                ahead = 0
                loop oj in 0.. and oc in g.crafts:
                    if oj == ci or not flying(oc) or not at_balls(g, oc) or crew_team(g, oc) != team: continue
                    op = pilot_of(oc)
                    if ball_role(g, op) == 1 or ball_of(g, op) >= 0: continue
                    if f64(length(b.pos - oc.pos)) < d: ahead += 1
                if ahead >= BALL_CHASERS: v *= 1.0 + 1.5 * f64(ahead - BALL_CHASERS + 1)
            if v < least:
                least = v
                best = bi
        # (a carrier with none to carry: a striker meanwhile)
        if best < 0 and role == 1:
            loop bi in 0..g.balls.len():
                b = g.balls[bi]
                if b.carrier >= 0 or b.kind == CARRY_BALL: continue
                d = f64(length(b.pos - c.pos))
                if d < least:
                    least = d
                    best = bi
        if best >= 0:
            b = g.balls[best]
            rel = b.pos - c.pos
            dist = max(f64(length(rel)), 0.1)
            if b.kind == CARRY_BALL: go = b.pos + b.vel * f32(min(dist / max(speed, 20.0), 3.0))
            else:
                r = BALL_R[b.kind]
                ri = -1
                least2 = 1e18
                loop j in 0.. and rg in rs:
                    d = f64(length(rg.at - b.pos))
                    if rg.team != team and d < least2:
                        least2 = d
                        ri = j
                gd = normalize(rs[ri].at - b.pos)
                # (far from it, level: the ball floats back to its height anyway)
                if least2 > 400.0: gd = normalize(vec3(gd.x, 0, gd.z))
                # (struck the way that turns where it goes now toward the ring, not just toward it:
                # its drift aside undone)
                gd = normalize(gd * f32(max(f64(length(b.vel)) + 12.0, 20.0)) - b.vel)
                lined = f64(dot(rel, gd)) / dist
                behind = f64(dot(c.pos - b.pos, gd))
                if behind < -(r + 4.0) and lined > 0.8:
                    # (in: at it, on the line through it to the ring, closer as it nears; the last
                    # 250 m hardly turned aside for the others about it, or in a crowd it never
                    # gets there)
                    run_in = dist < 250.0
                    t = min(dist / max(speed, 15.0), 3.0)
                    go = b.pos + b.vel * f32(t) - gd * f32(max(dist * 0.35, r * 0.4))
                else:
                    # (round behind it; out to its side first, not through it the wrong way)
                    go = b.pos - gd * f32(150.0 + r * 4.0)
                    if behind > -(r + 4.0):
                        across = normalize(cross(gd, vec3(0, 1, 0)) + vec3(0.0001, 0, 0))
                        sgn = if f64(dot(c.pos - b.pos, across)) >= 0.0: 1.0 else: -1.0
                        go = b.pos - gd * 110.0 + across * f32(sgn * (90.0 + r * 3.0))
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    alt = f64(c.pos.y) - gy
    go.y = f32(max(f64(go.y), ground(f64(go.x), f64(go.z)) + 14.0))
    want = go - c.pos
    pad = Pad()
    if k.heli:
        pad = heli_to(c, go, want, 32.0)
    else:
        ah = c.pos + c.vel * 2.0
        if alt < 14.0 or f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + 10.0: want = vec3(fwd.x, 0, fwd.z) + vec3(0, 0.9, 0)
        pad = steer(c, normalize(want) + avoid(g, ci, c) * f32(if run_in: 0.1 else: 0.6))
        pad.pitch = int(f64(pad.pitch) * (0.55 + 0.45 * g.skill))
        if speed < k.stall * 1.3: pad.pitch = min(pad.pitch, 15)
        pad.throttle = 1
    if k.guns and c.target >= 0 and c.target < g.crafts.len() and flying(g.crafts[c.target]):
        e = g.crafts[c.target]
        aim = lead(c, e)
        d = f64(length(aim))
        pad.fire = d < 320.0 and f64(dot(fwd, normalize(aim))) > 0.996 and c.heat < JAM_HEAT - 30
    pad

# a helicopter's controls toward a point: leaning toward it (the faster the farther, `most` m/s at
# most), up or down to its height, turned to face `face`
heli_to = (c: Craft, goal: vec3, face: vec3, most: f64) -> Pad:
    to = goal - c.pos
    flat_to = vec3(to.x, 0, to.z)
    dist = f64(length(flat_to))
    want_v = if dist > 0.5: normalize(flat_to) * f32(min(dist * 0.35, most)) else: vec3(0, 0, 0)
    # (the throttle toward what holds it up, more to climb as fast as it would, less to sink)
    vy = clamp(f64(to.y) * 0.4, -10.0, 6.0)
    # (low, going somewhere not to land: up first; da Vinci's by its skids, its middle so high
    # over them)
    gy = max(ground(f64(c.pos.x), f64(c.pos.z)), 0.0)
    skids = if c.kind == DAVINCI or c.kind == CASTLE: KINDS[c.kind].gear else: 0.0
    if f64(c.pos.y) - skids - gy < 25.0 and f64(goal.y) - skids - gy > 10.0: vy = max(vy, 4.0)
    heli_vel(c, want_v, vy, face)

# a player's helicopter: move (level, the world's way, up to 1 long) times HELI_TOP, climb (-1 to
# 1) times HELI_CLIMB, both by the power set; climbing nought, held at hold_y; its nose toward face
heli_player = (c: Craft, move: vec3, climb: f64, power: f64, hold_y: f64, face: vec3) -> Pad:
    pw = clamp(power, HELI_LEAST, 1.0)
    vy = if abs(climb) > 0.05: climb * HELI_CLIMB * pw else: clamp((hold_y - f64(c.pos.y)) * 0.6, -6.0, 6.0)
    p = heli_vel(c, move * f32(HELI_TOP * pw), vy, face)
    # (more lift, climbing: leaning as much would also go faster; leaning less, as much more)
    hover = 9.8 / (KINDS[c.kind].thrust * max(f64(up_of(c).y), 0.5))
    if c.throttle > hover:
        f = clamp(sqrt(hover / c.throttle), 0.5, 1.0)
        p.pitch = int(f64(p.pitch) * f)
        p.roll = int(f64(p.roll) * f)
    p

# a helicopter's controls toward a way of going: want_v level (m/s, the world's way), climbing at vy
# m/s, its nose turned toward face. Leaning gives the one, the throttle the other, the lift made
# more as it leans (so neither moves the other)
heli_vel = (c: Craft, want_v: vec3, vy: f64, face: vec3) -> Pad:
    p = Pad()
    dv = want_v - vec3(c.vel.x, 0, c.vel.z)
    fwd = fwd_of(c)
    f = vec3(fwd.x, 0, fwd.z)
    f = if length(f) > 0.05: normalize(f) else: vec3(0, 0, -1)
    r = vec3(-f.z, 0, f.x)
    p.pitch = int(clamp(-f64(dot(dv, f)) * 0.25, -1.0, 1.0) * 100.0)
    p.roll = int(clamp(f64(dot(dv, r)) * 0.25, -1.0, 1.0) * 100.0)
    ff = vec3(face.x, 0, face.z)
    ff = if length(ff) > 0.05: normalize(ff) else: f
    side = f64(dot(ff, r))
    back = if f64(dot(ff, f)) < 0.0: (if side >= 0.0: 1.0 else: -1.0) else: 0.0
    p.yaw = int(clamp(side * 3.0 + back, -1.0, 1.0) * 100.0)
    up = max(f64(up_of(c).y), 0.5)
    want_t = 9.8 / (KINDS[c.kind].thrust * up) + (vy - f64(c.vel.y)) * 0.08
    p.throttle = if want_t > c.throttle + 0.02: 1 else: if want_t < c.throttle - 0.02: -1 else: 0
    p

# the computer's helicopter pilot. Da Vinci's: no boulders, down to dig them (where it is, the
# ground flat and dry; else at its field), all it can carry once it is down there; with them,
# over the craft it goes after, each thrown when its fall would meet it. A carcopter's: within 150 m of it, at its height, facing it, its guns
bot_heli = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    if c.kind == CASTLE: return bot_castle(g, ci, c, team)
    k = KINDS[c.kind]
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    if c.kind == SCREW: return bot_screw(g, ci, c, team)
    fwd = fwd_of(c)
    # (da Vinci's: digging, it hovers with its keel half its reach over the ground, not down on it)
    low = f64(c.pos.y) - DIG_KEEL - max(gy, 0.0) < DIG_LOW - 5.0
    if c.kind == DAVINCI and (c.boulders == 0 or (c.boulders < BOULDERS and low)):
        if gy > 0.0 and flatness(f64(c.pos.x), f64(c.pos.z)) > 0.9:
            p = heli_to(c, vec3(c.pos.x, f32(gy + DIG_KEEL + DIG_LOW * 0.5), c.pos.z), fwd, 8.0)
            p.bomb = true
            return p
        f = fields()[team]
        return heli_to(c, vec3(f.at.x, f32(ground(f64(f.at.x), f64(f.at.z)) + k.gear + 30.0), f.at.z), f.at - c.pos, 25.0)
    tg = c.target
    # (da Vinci's: what it can catch: one of the others' slow ones in the air, else one standing on
    # their field)
    if c.kind == DAVINCI:
        tg = -1
        least = 1e18
        loop o in g.air:
            if g.crew[o.craft] == team or f64(length(o.vel)) > 35.0: continue
            d = f64(length(o.pos - c.pos))
            if d < least and d < 2500.0:
                least = d
                tg = o.craft
        if tg < 0:
            loop o in g.ground:
                if o.team == team: continue
                d = f64(length(o.pos - c.pos))
                if d < least:
                    least = d
                    tg = o.craft
    has = tg >= 0 and tg < g.crafts.len() and whole(g.crafts[tg])
    if not has:
        o = fields()[1 - team].at
        p0 = heli_to(c, vec3(o.x * 0.5, f32(max(gy, 0.0) + 300.0), o.z * 0.5), o - c.pos, 25.0)
        return p0
    e = g.crafts[tg]
    rel = e.pos - c.pos
    flat = vec3(rel.x, 0, rel.z)
    dh = f64(length(flat))
    away = if dh > 1.0: normalize(flat) else: vec3(0, 0, -1)
    if c.kind == DAVINCI:
        # (as far back as a boulder thrown from 60 m over it falls onto it: from BOULDER_AT, under
        # its middle and ahead of it)
        ba = BOULDER_AT
        fall = 60.0 + f64(ba.y)
        tt = (BOULDER_UP + sqrt(BOULDER_UP * BOULDER_UP + 2.0 * 9.8 * fall)) / 9.8
        goal = e.pos + e.vel * f32(tt) + vec3(0, 60, 0) - away * f32(BOULDER_SPEED * tt - f64(ba.z))
        goal.y = f32(max(f64(goal.y), gy + k.gear + 40.0))
        p = heli_to(c, goal, flat, 26.0)
        # (where the boulder would be when it is as far as the craft will be)
        fl = vec3(fwd.x, 0, fwd.z)
        fl = if length(fl) > 0.05: normalize(fl) else: away
        vh = f64(length(vec3(c.vel.x, 0, c.vel.z) + fl * f32(BOULDER_SPEED)))
        t = max(dh + f64(ba.z), 0.0) / max(vh, 1.0)
        e_at = e.pos + e.vel * f32(t)
        drop = (f64(c.vel.y) + BOULDER_UP) * t - 4.9 * t * t
        lined = f64(dot(fl, normalize(vec3(e_at.x - c.pos.x, 0, e_at.z - c.pos.z) + vec3(0, 0, 0.0001)))) > 0.97
        p.rocket = dh < 360.0 and lined and abs(f64(c.pos.y) + f64(ba.y) + drop - f64(e_at.y)) < 6.0 + BOULDER_NEAR
        return p
    l = lead(c, e)
    goal = e.pos - away * 150.0
    goal.y = f32(max(f64(e.pos.y), gy + 40.0))
    p = heli_to(c, goal, l, 25.0)
    p.fire = f64(dot(fwd, normalize(l))) > 0.992 and f64(length(l)) < 450.0
    p

# (side team's flying castle in the air: its craft, -1 none)
castle_up = (g: Game, team: int) -> int:
    loop o in g.air:
        if g.crafts[o.craft].kind == CASTLE and g.crew[o.craft] == team and g.crafts[o.craft].down == 0: return o.craft
    -1

# (where an escort of the flying castle q holds station: on a ring round it, CASTLE_STATION out
# from its middle and a little over it, each its own place on it (by its number), the ring
# turning slowly)
const CASTLE_STATION = 230.0
const CASTLE_GUARD = 700.0          # (what comes this near the castle, its escorts fight)
escort_station = (g: Game, ci: int, q: Craft) -> vec3:
    a = f64(ci) * 2.39996 + f64(g.tick) / 60.0 * 0.015
    gy = max(ground(f64(q.pos.x), f64(q.pos.z)), 0.0)
    y = max(f64(q.pos.y) + 25.0 + f64(ci % 3) * 15.0, gy + 60.0)
    vec3(f32(f64(q.pos.x) + cos(a) * CASTLE_STATION), f32(y), f32(f64(q.pos.z) + sin(a) * CASTLE_STATION))

# the computer's flying castle: on the ground, its crew mustered first (some of its side's on
# foot come aboard: CASTLE_MUSTER of them, or it waits CASTLE_WAIT at most); then up, slowly,
# straight up till its plinth is well over the ground, then on at a height over the highest
# ground under it, toward the craft it goes after (its guns' reach off it), else across the fight
const CASTLE_MUSTER = 6
const CASTLE_WAIT = 60 * 40
bot_castle = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    k = KINDS[c.kind]
    if c.landed:
        # (a player on foot near, a seat free: waited for, 15 s at most)
        if c.wait > 0 and c.wait < 900: return Pad(throttle = -1)
        aboard = 0
        loop pk in c.seats:
            if pk >= 0: aboard += 1
        if aboard < CASTLE_MUSTER and c.rest < CASTLE_WAIT and on_own_field(c, team): return Pad(throttle = -1)
    low = castle_ground(c)
    fwd = fwd_of(c)
    over = f64(c.pos.y) - k.gear - low
    tg = c.target
    has = tg >= 0 and tg < g.crafts.len() and flying(g.crafts[tg]) and f64(length(g.crafts[tg].pos - c.pos)) < 1800.0
    goal = c.pos
    face = fwd
    height = low + k.gear + 220.0
    if has:
        e = g.crafts[tg]
        flat = vec3(e.pos.x - c.pos.x, 0, e.pos.z - c.pos.z)
        d = f64(length(flat))
        if d > 380.0: goal = c.pos + normalize(flat) * f32(d - 380.0)
        face = flat
        height = clamp(f64(e.pos.y), low + k.gear + 120.0, low + k.gear + 600.0)
    else:
        own = fields()[team].at
        o = fields()[1 - team].at
        goal = own + (o - own) * 0.6
        face = goal - c.pos
    to = vec3(goal.x - c.pos.x, 0, goal.z - c.pos.z)
    dist = f64(length(to))
    want_v = if dist > 1.0 and over > 70.0: normalize(to) * f32(min(dist * 0.05, 9.0)) else: vec3(0, 0, 0)
    vy = clamp((height - f64(c.pos.y)) * 0.05, -3.0, 6.0)
    if over < 70.0: vy = 6.0
    heli_vel(c, want_v, vy, face)

# (the highest ground under the flying castle: under its middle and corners, now and where it
# will be in 10 s)
castle_ground = (c: Craft) -> f64:
    h = KINDS[c.kind].half
    top = 0.0
    loop s in [0.0, 10.0]:
        mid = c.pos + vec3(c.vel.x, 0, c.vel.z) * f32(s)
        loop at in [vec3(0, 0, 0), vec3(h.x, 0, h.z), vec3(-h.x, 0, h.z), vec3(h.x, 0, -h.z), vec3(-h.x, 0, -h.z)]:
            p = mid + quat_rotate(c.rot, at)
            top = max(top, ground(f64(p.x), f64(p.z)))
    top

# (where the little screw keeps station, guarding its side: over its own field, out from it
# toward the middle, high enough to see over the field; each of a side's apart)
screw_station = (g: Game, ci: int, team: int) -> vec3:
    f = fields()[team].at
    out = vec3(-f.x, 0, -f.z)
    out = if length(out) > 1.0: normalize(out) else: vec3(0, 0, 1)
    side = vec3(-out.z, 0, out.x)
    at = f + out * 250.0 + side * f32(f64(ci % 4) * 110.0 - 165.0)
    at.y = f32(max(ground(f64(at.x), f64(at.z)), 0.0) + 160.0)
    at

# (the little screw's: on station, turned slowly toward the nearest of the others' its crew knows
# of, its guns working on their own; a fire pot thrown when one would fall on it)
bot_screw = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    # (its side's flying castle up: on station round it, its guard)
    ca = castle_up(g, team)
    goal = if ca >= 0: escort_station(g, ci, g.crafts[ca]) else: screw_station(g, ci, team)
    tg = -1
    least = 900.0
    loop o in g.air:
        if o.craft == ci or g.crafts[o.craft].safe > 0 or seen_at(g, o.craft, team) == team: continue
        d = f64(length(o.pos - c.pos))
        if d < least:
            least = d
            tg = o.craft
    face = if tg >= 0: g.crafts[tg].pos - c.pos else: fields()[1 - team].at - c.pos
    p = screw_clear(c, heli_to(c, goal, face, 14.0))
    want = normalize(face)
    pot = tg >= 0 and c.rockets > 0 and c.rcool == 0 and least < 260.0 and least > 25.0
    if pot:
        if let w = pot_aim(c, g.crafts[tg]): want = w
        else: pot = false
    t = f64(g.tick + ci * 97) / 60.0
    wob = (1.0 - g.skill) * 0.05 + 0.012
    want = normalize(want + vec3(f32(sin(t * 1.9 + f64(ci)) * wob), f32(cos(t * 1.7) * wob), f32(sin(t * 1.3 + 2.0) * wob)))
    p.aim_yaw = int(atan2(-f64(want.x), -f64(want.z)) * 1000.0)
    p.aim_pitch = int(asin(clamp(f64(want.y), -1.0, 1.0)) * 1000.0)
    p.rocket = pot and f64(dot(c.aims[0], want)) > 0.997
    p

# (the little screw low over rising ground ahead (where it will be in 3 s, and 6): leaned back
# to slow, the throttle open, until it is well over it)
screw_clear = (c: Craft, p0: Pad) -> Pad:
    p = p0
    gy = max(ground(f64(c.pos.x), f64(c.pos.z)), 0.0)
    loop s in [3.0, 6.0]:
        ah = c.pos + vec3(c.vel.x, 0, c.vel.z) * f32(s)
        gy = max(gy, ground(f64(ah.x), f64(ah.z)))
    room = f64(c.pos.y) - KINDS[c.kind].gear - gy
    if room < 40.0:
        p.throttle = 1
        if room < 25.0:
            f = fwd_of(c)
            ahead = f64(dot(vec3(c.vel.x, 0, c.vel.z), vec3(f.x, 0, f.z)))
            p.pitch = if ahead > 2.0: 100 else: if ahead < -2.0: -100 else: 0
            p.roll = 0
    p

# (the way to throw the little screw's fire pot to fall on craft e (where it will be), as far up
# and down as it is thrown: none if there is none)
pot_aim = (c: Craft, e: Craft) -> vec3?:
    fl = vec3(e.pos.x - c.pos.x, 0, e.pos.z - c.pos.z)
    at = c.pos + (if length(fl) > 0.5: normalize(fl) else: fwd_of(c)) * f32(SCREW_DECK * 0.5 + 0.3) + up_of(c) * f32(SCREW_FLOOR + 0.9)
    best = 1e9
    bw = vec3(0, 0, -1)
    loop k in 0..24:
        el = -POT_LOW + (POT_HIGH + POT_LOW) * f64(k) / 23.0
        rel = e.pos - at
        tt = 0.0
        miss = 1e9
        loop n in 0..3:
            r = rel + (e.vel - c.vel) * f32(tt)
            fl = vec3(r.x, 0, r.z)
            d = f64(length(fl))
            vh = POT_SPEED * cos(el)
            tt = d / max(vh, 1.0)
            y = (POT_SPEED * sin(el) + POT_UP) * tt - 4.9 * tt * tt
            miss = abs(y - f64(r.y))
            if n == 2:
                if miss < best and tt < 6.0:
                    best = miss
                    f = normalize(fl + vec3(0, 0, 0.0001))
                    bw = f * f32(cos(el)) + vec3(0, f32(sin(el)), 0)
    if best < POT_NEAR + 2.0: return bw
    none

# a drone: after the craft it was given (the nearest of the others), its gun on it, led; its
# shots spent, into it
bot_drone = (g: Game, i: int) -> Pad:
    c = g.crafts[i]
    alt = f64(c.pos.y) - ground(f64(c.pos.x), f64(c.pos.z))
    t = c.target
    want = vec3(f32(-c.pos.x), f32(400.0 - f64(c.pos.y)), f32(-c.pos.z))
    fire = false
    if t >= 0 and t < g.crafts.len() and flying(g.crafts[t]):
        e = g.crafts[t]
        if c.rockets > 0:
            l = lead(c, e)
            want = l
            fire = f64(dot(fwd_of(c), normalize(l))) > 0.995 and f64(length(l)) < 350.0
        else:
            d = f64(length(e.pos - c.pos))
            want = e.pos + e.vel * f32(min(d / 60.0, 2.0)) - c.pos
    if alt < 60.0: want = vec3(fwd_of(c).x, 0, fwd_of(c).z) + vec3(0, 0.9, 0)
    st = steer(c, normalize(want) + avoid(g, i, c))
    p = Pad(throttle = 1)
    p.pitch = st.pitch
    p.roll = st.roll
    p.yaw = st.yaw
    p.fire = fire
    p

# the cat: after its craft, at where it will be, to ram it; clear of the ground (it would bounce,
# and lose its speed); nothing to go after, over the middle of the field
bot_cat = (g: Game, ci: int, c: Craft) -> Pad:
    fwd = fwd_of(c)
    speed = f64(length(c.vel))
    want = vec3(-c.pos.x * 0.3, f32(200.0 - f64(c.pos.y)), -c.pos.z * 0.3)
    t = c.target
    if t >= 0 and t < g.crafts.len() and flying(g.crafts[t]):
        e = g.crafts[t]
        to = e.pos - c.pos
        # (less skill: it leads it worse)
        time = min(f64(length(to)) / max(speed, 60.0), 3.0) * (0.6 + 0.4 * g.skill)
        want = to + (e.vel - c.vel * 0.15) * f32(time)
    ah = c.pos + c.vel * 0.7
    alt = f64(c.pos.y) - ground(f64(c.pos.x), f64(c.pos.z))
    if alt < 12.0 or f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + 8.0: want = vec3(fwd.x, 0, fwd.z) + vec3(0, 1.2, 0)
    p = steer(c, normalize(want))
    p.throttle = 1
    p

# (the Thunderdome: the other side's target craft ci goes for, each its own, by its number; -1 none
# standing)
bikes_goal = (g: Game, ci: int, team: int) -> int:
    n = 0
    loop b in g.buildings:
        if b.kind == TARGET and b.team != team and b.health > 0: n += 1
    if n == 0: return -1
    k = ci % n
    loop j in 0.. and b in g.buildings:
        if b.kind == TARGET and b.team != team and b.health > 0:
            if k == 0: return j
            k -= 1
    -1

# a balloon: up or down to the height whose wind blows most toward the other side's target (or
# field), no lower than 200 m over the ground
bot_balloon = (g: Game, c: Craft, team: int) -> Pad:
    bi = mission_target(g, team)
    goal = if bi >= 0: g.buildings[bi].pos else: on_field(1 - team, 0.0, -STRIP_WIDE - 80.0)
    to = goal - c.pos
    to.y = 0.0
    if length(to) < 1.0: return Pad()
    to = normalize(to)
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    best = f64(c.pos.y)
    most = -2.0
    loop k in 0..16:
        y = gy + 200.0 + 50.0 * f64(k)
        w = wind(y)
        v = f64(dot(normalize(w), to)) - abs(y - f64(c.pos.y)) * 0.0004
        if v > most:
            most = v
            best = y
    Pad(pitch = int(clamp((best - f64(c.pos.y)) / 40.0, -1.0, 1.0) * 100.0))

# the ornithopter: a hurt craft of its side near, to it and a health pack at it; else the long
# gun from afar (250 to 700 m), the ordinary one when one comes close
bot_ornithopter = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    fwd = fwd_of(c)
    alt = f64(c.pos.y) - ground(f64(c.pos.x), f64(c.pos.z))
    friend = -1
    least = 900.0
    if c.rockets > 0:
        loop o in g.air:
            j = o.craft
            # (the cheap tests first: hurt, near; then whose)
            if j == ci or g.crafts[j].health * 100 > KINDS[g.crafts[j].kind].health * 65: continue
            d = f64(length(o.pos - c.pos))
            if d >= least or not manned_at(g, j) or g.crew[j] != team: continue
            if d < least:
                least = d
                friend = j
    pad = Pad()
    want = vec3(-c.pos.x, f32(450.0 - f64(c.pos.y)), -c.pos.z)
    # (the Thunderdome: two in three of them at the other side's targets, with the long gun from
    # afar, unless one of the others comes close)
    goal = -1
    if g.rules.mode == THUNDERDOME and pilot_of(c) >= 0 and role(pilot_of(c)) != 1:
        goal = bikes_goal(g, ci, team)
        if goal >= 0 and c.target >= 0 and c.target < g.crafts.len() and flying(g.crafts[c.target]) and f64(length(g.crafts[c.target].pos - c.pos)) < 250.0: goal = -1
    if friend < 0 and goal >= 0:
        rel = g.buildings[goal].pos + vec3(0, 3.2, 0) - c.pos
        d = f64(length(rel))
        tt = d / SNIPE_SPEED
        aim = rel + c.vel * f32(-tt) + vec3(0, f32(4.9 * tt * tt), 0)
        # (from 250 to 700 m: nearer, away and up; farther, toward it, above it)
        want = if d < 250.0: rel * -1.0 + vec3(0, f32(d * 0.6), 0) else: if d > 700.0: rel + vec3(0, 150, 0) else: aim
        on = f64(dot(fwd, normalize(aim)))
        pad.scope = true
        pad.fire = d < 900.0 and on > 0.9985 - (1.0 - g.skill) * 0.002
    else if friend >= 0:
        o = g.crafts[friend]
        to = o.pos + o.vel - c.pos
        want = if least < 150.0: o.vel + to * 0.2 else: to
        pad.rocket = least < 400.0 and f64(dot(fwd, normalize(to))) > 0.93
    else if c.target >= 0 and c.target < g.crafts.len() and flying(g.crafts[c.target]):
        e = g.crafts[c.target]
        rel = e.pos - c.pos
        d = f64(length(rel))
        far = d > 180.0
        t = d / (if far: SNIPE_SPEED else: BULLET_SPEED)
        aim = rel + (e.vel - c.vel) * f32(t) + vec3(0, f32(4.9 * t * t), 0)
        want = if d < 250.0 and far: rel * -1.0 + vec3(0, f32(d * 0.5), 0) else: aim
        if d > 700.0: want = rel
        on = f64(dot(fwd, normalize(aim)))
        pad.scope = far
        pad.fire = if far: d < 1100.0 and on > 0.9985 - (1.0 - g.skill) * 0.002 else: on > 0.995
    if alt < 120.0: want = vec3(fwd.x, 0, fwd.z) + vec3(0, 0.9, 0)
    st = steer(c, normalize(want) + avoid(g, ci, c))
    pad.pitch = int(f64(st.pitch) * (0.55 + 0.45 * g.skill))
    pad.roll = st.roll
    pad.yaw = st.yaw
    if f64(length(c.vel)) < KINDS[c.kind].stall * 1.3: pad.pitch = min(pad.pitch, 15)
    pad.throttle = 1
    pad

# a fighter or a scout: Aces' pilot, and rockets for the big ones
bot_fighter = (g: Game, ci: int, c: Craft) -> Pad:
    k = KINDS[c.kind]
    skill = g.skill
    has = c.target >= 0 and c.target < g.crafts.len()
    e = if has: g.crafts[c.target] else: c
    fwd = fwd_of(c)
    speed = f64(length(c.vel))
    alt = f64(c.pos.y) - ground(f64(c.pos.x), f64(c.pos.z))
    ahead = c.pos + c.vel * 4.0
    low = alt < 130.0 or f64(ahead.y) < ground(f64(ahead.x), f64(ahead.z)) + 100.0
    # (the trench run's raiders keep low in the gorge: lower is safer from its guns)
    hug = g.rules.mode == TRENCH and crew_team(g, c) == 0
    if hug:
        ah = c.pos + c.vel * 2.5
        low = alt < 26.0 or f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + 22.0
    aim = vec3(0, 0, 0)
    fight = has and flying(e) and e.safe == 0 and not low
    # (the Thunderdome: two in three of them after the targets, fighting only what comes close, or
    # the cat)
    goal = -1
    if g.rules.mode == THUNDERDOME and pilot_of(c) >= 0 and role(pilot_of(c)) != 1:
        goal = bikes_goal(g, ci, crew_team(g, c))
        if goal >= 0:
            # (low to it, but not into the ground)
            ah = c.pos + c.vel * 3.0
            low = alt < 40.0 or f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + 30.0
            fight = has and flying(e) and e.safe == 0 and not low and f64(length(e.pos - c.pos)) < (if e.kind == CAT: 400.0 else: 100.0)
    want = vec3(0, 0, 0)
    strafe = -1
    # (Capture the flag's runners: to the other side's flag, or home with it)
    run_for = -1
    run_at = vec3(0, 0, 0)
    pi = pilot_of(c)
    fm = g.rules.mode
    runner = pi >= 0 and (role(pi) == 2 or (fm == FLAG_RAID and role(pi) == 0 and pi / 2 % 2 == 0))
    if pi >= 0 and (fm == FLAG or (fm == FLAG_RAID and g.people[pi].team == g.rules.attackers)) and (runner or g.people[pi].carry >= 0):
        team = g.people[pi].team
        if g.people[pi].carry >= 0:
            run_for = team
            run_at = g.flags[team].home
        else if g.flags[1 - team].carrier < 0 and g.flags[1 - team].real:
            run_for = 1 - team
            run_at = g.flags[1 - team].pos
        if run_for >= 0: fight = false
        # (low all the way, under the others' fighters; lower still near the flag)
        if run_for >= 0:
            near = f64(length(vec2(run_at.x - c.pos.x, run_at.z - c.pos.z))) < 700.0
            ah = c.pos + c.vel * 2.0
            low = alt < (if near: 2.5 else: 25.0) or f64(ah.y) < ground(f64(ah.x), f64(ah.z)) + (if near: 2.0 else: 20.0)
    if low:
        flat = vec3(fwd.x, 0, fwd.z)
        if length(flat) < 0.1: flat = vec3(1, 0, 0)
        want = normalize(flat) + vec3(0, 0.9, 0)
    else if hug and not (fight and f64(length(e.pos - c.pos)) < 220.0 and f64(dot(normalize(e.pos - c.pos), fwd)) > 0.9):
        # (up the gorge, along the river, toward the depot)
        # (the river's line 200 m on, as high as the highest ground along the next 300 m)
        tz = f64(c.pos.z) - 200.0
        top = 0.0
        loop k in 1..4:
            z = f64(c.pos.z) - 100.0 * f64(k)
            top = max(top, ground(river_x(z), z))
        want = vec3(f32(river_x(tz)) - c.pos.x, f32(top + 32.0) - c.pos.y, f32(tz) - c.pos.z)
        bi = mission_target(g, crew_team(g, c))
        if bi >= 0 and f64(length(g.buildings[bi].pos - c.pos)) < 900.0: want = g.buildings[bi].pos + vec3(0, 6, 0) - c.pos
    else if fight and f64(length(e.pos - c.pos)) < 70.0 and f64(dot(c.vel - e.vel, e.pos - c.pos)) > 0.0:
        # (too close and closing: break off, up and away; the fight goes on after)
        want = normalize(c.pos - e.pos) + vec3(0, 0.8, 0)
        fight = false
    else if fight:
        aim = lead(c, e)
        # (less skill: aims round about, as if it misjudged)
        w = (1.0 - skill) * 14.0
        t = f64(g.tick)
        want = aim + vec3(f32(sin(t * 0.013 + f64(ci)) * w), f32(cos(t * 0.011) * w), f32(sin(t * 0.017 + 2.0) * w))
        # (far from it yet: each in its own place across and up, a spread formation, not a line;
        # closing on it as it nears)
        d = f64(length(e.pos - c.pos))
        if d > 1200.0:
            to = e.pos - c.pos
            side = normalize(vec3(-to.z, 0, to.x) + vec3(0.0001, 0, 0))
            k2 = min((d - 1200.0) / 800.0, 1.0)
            want = to + side * f32((f64(ci % 5) - 2.0) * 90.0 * k2) + vec3(0, f32(f64(ci / 5 % 3) * 45.0 * k2), 0)
    else if run_for >= 0:
        # (to the flag, then home with it: low and slow through it)
        to = run_at - c.pos
        flat = f64(length(vec2(to.x, to.z)))
        h = if flat > 700.0: 60.0 else: 4.0 + flat * 0.08
        # (far off, wide of the middle, where the others fight: each side round its own way)
        side = if flat > 1100.0: normalize(vec3(-to.z, 0, to.x)) * f32(flat * 0.45) else: vec3(0, 0, 0)
        want = vec3(to.x + side.x, f32(ground(f64(run_at.x), f64(run_at.z)) + h) - c.pos.y, to.z + side.z)
    else:
        bi = if goal >= 0: goal else: mission_target(g, crew_team(g, c))
        if bi >= 0:
            # (an attack run: high over to it, then down at it, guns and rockets)
            to = g.buildings[bi].pos + vec3(0, 4, 0) - c.pos
            flat = f64(length(vec2(to.x, to.z)))
            want = if flat > 800.0: vec3(to.x, f32(320.0 - f64(c.pos.y) + f64(g.buildings[bi].pos.y)), to.z) else: to
            # (a target up on its frame: at it, the bullets' drop allowed for, not diving)
            if goal >= 0 and flat < 800.0:
                tt = f64(length(to)) / BULLET_SPEED
                want = to + vec3(0, f32(4.9 * tt * tt), 0)
                # (past it, or too close to line up: away, out to 350 m, and round again)
                if flat < 150.0 or (flat < 350.0 and f64(dot(c.vel, to)) < 0.0): want = vec3(-to.x, f32(max(f64(g.buildings[bi].pos.y) + 40.0 - f64(c.pos.y), 0.0)), -to.z)
            # (the Thunderdome, two in three: in under the gun towers' fire low and fast, weaving
            # (their crews lead true: a straight run is a dead one), lining up only at the last)
            if goal >= 0 and ci % 3 != 0 and flat < 1500.0 and flat > 150.0:
                fl = normalize(vec3(to.x, 0, to.z) + vec3(0.0001, 0, 0))
                side = vec3(-fl.z, 0, fl.x)
                weave = sin(f64(g.tick) * 0.07 + f64(ci) * 1.7) * (if flat > 450.0: 0.85 else: 0.15)
                if flat > 450.0:
                    gy = ground(f64(c.pos.x), f64(c.pos.z))
                    want = fl + side * f32(weave) + vec3(0, f32(clamp((gy + 28.0 - f64(c.pos.y)) / 60.0, -0.5, 0.5)), 0)
                else: want = normalize(want) + side * f32(weave)
            if flat < 800.0: strafe = bi
        else: want = vec3(-c.pos.x, f32(500.0 - f64(c.pos.y)), -c.pos.z)
    pad = steer(c, normalize(want) + avoid(g, ci, c))
    pad.pitch = int(f64(pad.pitch) * (0.55 + 0.45 * skill))
    # (slow: no hard pulling, which would stall it)
    if speed < k.stall * 1.3: pad.pitch = min(pad.pitch, 15)
    pad.throttle = 1
    if fight and length(aim) > 0.0:
        d = f64(length(aim))
        within = 0.9995 - (1.0 - skill) * 0.003
        on = f64(dot(fwd, normalize(aim)))
        pad.fire = d < 480.0 and on > within and c.heat < JAM_HEAT - 30
        # (a rocket at a big one, close and lined up)
        pad.rocket = (e.kind == BOMBER or e.kind == ZEPPELIN or e.kind == ULTRA or e.kind == BALLOON) and d < 260.0 and on > 0.995 and g.tick % 30 == ci % 30
        if c.kind == ROCKETEER: pad.rocket = d < 400.0 and on > 0.99
        # (close behind it: slow down, not to fly past)
        if d < 140.0 and f64(dot(e.pos - c.pos, fwd)) > 0.0 and f64(dot(c.vel - e.vel, fwd)) > 6.0: pad.throttle = -1
    else if run_for >= 0:
        to = run_at - c.pos
        if f64(length(vec2(to.x, to.z))) < 600.0 and speed > 38.0: pad.throttle = -1
    else if strafe >= 0:
        to = g.buildings[strafe].pos + vec3(0, 3, 0) - c.pos
        d = f64(length(to))
        on = f64(dot(fwd, normalize(to)))
        pad.fire = d < 500.0 and on > 0.995
        pad.rocket = d < 330.0 and on > 0.99 and g.tick % 25 == ci % 25
    else if hug:
        bi = mission_target(g, crew_team(g, c))
        if bi >= 0:
            to = g.buildings[bi].pos - c.pos
            pad.rocket = f64(length(to)) < 450.0 and f64(dot(fwd, normalize(to))) > 0.97 and g.tick % 25 == ci % 25
            pad.fire = f64(length(to)) < 450.0 and f64(dot(fwd, normalize(to))) > 0.99
    pad

# (away from any craft close ahead and closing: the computer's pilots do not fly into each other)
avoid = (g: Game, ci: int, c: Craft) -> vec3:
    out = vec3(0, 0, 0)
    h = KINDS[c.kind].half
    mine = f64(max(h.x, h.z))
    loop o in g.air:
        if o.craft == ci: continue
        d = o.pos - c.pos
        l2 = f64(dot(d, d))
        if l2 > 160000.0 or l2 < 0.01: continue
        l = sqrt(l2)
        closing = f64(dot(c.vel - o.vel, d)) / l
        # (as far ahead as a second and more of closing)
        reach = mine + f64(o.reach) + 25.0 + max(closing, 0.0) * 1.3
        if l > reach: continue
        if closing <= 0.0 and l > reach * 0.5: continue
        # (away from where it will be, and up or down, whichever it is not)
        rel = d + (o.vel - c.vel) * f32(min(l / max(closing, 1.0), 1.5))
        away = normalize(rel * -1.0 + vec3(0, if rel.y > 0.0: -0.5 else: 0.5, 0))
        out += away * f32(2.5 * (1.0 - l / reach) + 0.5)
    out

# the other side's building this side goes for (found once a tick: find_target)
mission_target = (g: Game, team: int) -> int:
    j = g.goals[team]
    if j >= 0 and g.buildings[j].health <= 0: return -1
    j

# the other side's building this side goes for: the mission's target, or in Base attack the
# first still standing of the field's (-1: none)
find_target = (g: Game, team: int) -> int:
    m = g.rules.mode
    best = -1
    loop j in 0.. and b in g.buildings:
        if b.health <= 0 or b.team == team: continue
        if (m == TRENCH and b.kind == DEPOT) or ((m == ESCORT or m == RAIDS) and b.kind == FACTORY): return j
        if m == BASES and (b.kind == HQ or b.kind == TANK or b.kind == HANGAR) and best < 0: best = j
    best

# a bomber or a zeppelin: to the other side's target (or field), level, high enough; bombs away
# when they would fall on it; its gunners fight (gunners)
bot_bomber = (g: Game, ci: int, c: Craft, team: int) -> Pad:
    k = KINDS[c.kind]
    bi = mission_target(g, team)
    goal = if bi >= 0: g.buildings[bi].pos else: on_field(1 - team, 0.0, -STRIP_WIDE - 80.0)
    alt = if k.lighter: 520.0 else: 550.0
    if g.rules.mode == TRENCH: alt = 420.0
    gy = ground(f64(c.pos.x), f64(c.pos.z))
    want_alt = max(alt, gy + 220.0)
    to = goal - c.pos
    pad = Pad()
    if k.lighter: pad = steer_flat(c, to, want_alt)
    else:
        dir = normalize(vec3(to.x, 0, to.z)) + vec3(0, f32(clamp((want_alt - f64(c.pos.y)) / 300.0, -0.25, 0.25)), 0)
        # (past it: round again)
        pad = steer(c, dir)
        pad.pitch = int(f64(pad.pitch) * 0.7)
        pad.throttle = 1
    # (where a bomb let go now would fall: the fall's time from the height, carried on)
    h = max(f64(c.pos.y) - f64(goal.y), 1.0)
    t = sqrt(2.0 * h / 9.8)
    fall = c.pos + c.vel * f32(t)
    near = f64(length(vec2(fall.x - goal.x, fall.z - goal.z)))
    pad.bomb = near < (if k.lighter or c.kind == ULTRA: 40.0 else: 24.0) and c.bombs > 0 and (bi >= 0 or g.rules.mode == DOGFIGHT)
    pad

# this version of the game, as a number: short fights of the computer's on each map, played
# here, hashed (two games whose numbers differ play fights differently: one of them is another
# version, a page loaded before the game was changed)
version_print = () -> str:
    out = 0
    loop m in [DOGFIGHT, BASES, TRENCH, ESCORT, THUNDERDOME, BROOMS]:
        set_map(if m == TRENCH: GORGE else: FARMLAND, 0)
        r = Rules(mode = m, ground_start = m == BASES)
        if m == DOGFIGHT: r.crafts = (1 << ROCKETEER) | (1 << ORNITHOPTER)
        let g = new_game(fill(-1, 4), 0.65, r, [])
        loop k in 0..240: g = tick(g, [])
        out = out * 31 + int(hash(g) % 1000000007)
    # (and Bikes & Brooms with a player's golden cat, out)
    let h = new_game([-1, -1, -1, -1, 0], 0.65, Rules(mode = BROOMS, ground_start = false), [])
    h.gold_at = 10
    loop k in 0..240: h = tick(h, [Pad(computer = true)])
    out = out * 31 + int(hash(h) % 1000000007)
    "v{out % 1000000007}"
