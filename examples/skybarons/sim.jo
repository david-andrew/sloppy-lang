# The game of Sky Barons: everything a tick depends on (the same game and pads give the same game
# on every machine: rollback netplay plays ticks again). Aircraft (crafts) and people are apart:
# a person walks, gets into a craft's seat (the pilot's, or a gunner's), gets out, bails out under
# a parachute; a craft is its side's by its colors, whoever is in it.
use 'world.jo'

const DT = 1.0 / 60.0           # a tick
const RESPAWN = 300             # ticks from death to coming back
const WRECK = 600               # ticks a craft's wreck stays, before its stand has it again
const BULLET_SPEED = 380.0
const BULLET_LIFE = 75          # ticks (about 470 m)
const JAM_HEAT = 300            # jammed until it is down to 120
const DAMAGE = 7
const CEILING = 1600.0          # (the engine fades above it)

# the kinds of craft
const SCOUT = 0
const FIGHTER = 1
const BOMBER = 2
const ZEPPELIN = 3
const ULTRA = 4                 # the ultra bomber: three light bombers' size, gunners all over
const BALLOON = 5               # a balloon: three guns and bombs; it goes where the wind blows
const ROCKETEER = 6             # one person on a rocket pack: fast, fragile, a pistol, rockets without end
const ORNITHOPTER = 7           # pedalled flapping wings: a long gun with a scope, and health packs
const DAVINCI = 8               # da Vinci's galleass: a galley of the air, rowed, three screws: a trebuchet's boulders (dug up), four ballistas
const CARCOPTER = 9             # a motor car under a pumping canopy: guns, a tail gunner who launches drones
const CAT = 10                  # the cat: the fastest thing in the sky, no guns; it rams, and crashing does it no harm
const CAT_SPEED = 455.0         # (m/s, its own flat out)
const DRONE = 11                # a little fighter with no one in it, launched by a carcopter
KIND_NAMES = ["scout", "fighter", "light bomber", "zeppelin", "ultra bomber", "balloon", "rocketeer", "ornithopter", "da Vinci's galleass", "carcopter", "cat", "drone"]
const ALL_CRAFTS = 2047 | (1 << 12) | (1 << 13)   # (Rules.crafts: every kind that can be chosen; not drones)
const CHOOSABLE = 14            # (the kinds one can choose to fly, 0 to 13: not drones, 11)
# (what a fight has unless its lobby says otherwise: not the helicopters, the balloon, the cat)
const DEFAULT_CRAFTS = 2047 & ~((1 << 5) | (1 << 8) | (1 << 9) | (1 << 10))
# (and the Thunderdome: the ornithopters, the rocketeers, the cat)
const THUNDERDOME_CRAFTS = (1 << 6) | (1 << 7) | (1 << 10)
# (the helicopters: hover at about 0.6 throttle; the stick leans them, and they go the way they lean)
const HELI_LEAN = 0.62          # radians at full stick
# (a player's: W/A/S/D for so fast, Shift/Ctrl climbing and sinking so fast, at full power: less,
# as less power is set (HELI_LEAST of it at least); let go, it holds where it is)
const HELI_TOP = 34.0
const HELI_CLIMB = 12.0
const HELI_LEAST = 0.25
# (da Vinci's trebuchet: boulders dug from the ground (DIG ticks with B held, low and slow, for
# each: its keel within DIG_LOW of it, its trebuchet's sling let down on a rope; DIG_KEEL its keel under
# its middle), up to BOULDERS of them piled on its deck (and
# all of them, starting in the air), each thrown
# ahead from BOULDER_AT; whatever it hits goes down (BOULDER_NEAR: how near its middle comes, it
# is so big), on the ground a crater)
const DIG = 30
const DIG_LOW = 40.0
const DIG_KEEL = 8.5
const BOULDERS = 10
const BOULDER_SPEED = 48.0
const BOULDER_UP = 14.0
const BOULDER_NEAR = 2.6
BOULDER_AT = vec3(0, -7.6, -44.25)
# (the ballista's bolts: slower than bullets, heavier)
const BOLT_SPEED = 260.0
const BOLT_DAMAGE = 34
const BOLT_GAP = 50
# (a carcopter's drones: a few shots, then into what it chases; gone after a minute)
const DRONE_AMMO = 60
const DRONE_LIFE = 3600
# (a balloon's cannons, all round its baskets: X fires the one nearest where its gunner aims)
const CANNON_SPEED = 170.0
const CANNON_GAP = 300             # (ticks to load one again: sixty of them, a long broadside, then a wait)
const CANNON_DAMAGE = 70
# (where they are on the crafts, by side: twenty round each basket of three hung one under the
# other, TIER_DROP apart (the gunners in the top one), Red's round, Blue's a little oblong;
# models.jo has the same)
const TIERS = 3
const TIER_DROP = 3.0
const CANNONS = 20 * TIERS
const CANNON_SPACING = 5        # (ticks between one craft's cannons going off: a broadside rolls)
# (a point of the top basket's side: lower ones the same, TIER_DROP down for each)
basket_point = (team: int, a: f64, y: f64) -> vec3:
    t = clamp((y + 13.35) / 1.6, 0.0, 1.0)
    hx = if team == 0: 1.55 + 0.4 * t else: 1.45 + 0.35 * t
    hz = if team == 0: hx else: 2.25 + 0.5 * t
    vec3(f32(cos(a) * hx), f32(y), f32(sin(a) * hz))
cannon_ports = (team: int) -> vec3[]:
    out: vec3[] = []
    loop tier in 0..TIERS:
        loop row in 0..2:
            y = if row == 0: -12.05 else: -12.85
            loop j in 0..10:
                p = basket_point(team, TAU * (f64(j) + 0.5 * f64(row)) / 10.0, y)
                out.push(p + normalize(vec3(p.x, 0, p.z)) * 0.75 - vec3(0, f32(TIER_DROP * f64(tier)), 0))
    out
CANNON_PORTS = [cannon_ports(0), cannon_ports(1)]
TREB_POUCH = vec3(0, -20.51, -6.545)
# (where one climbs aboard it from the ground, at its ladder's foot; its ballistas' pivots, its
# gunners' seats: models.jo has the same)
DV_LADDER = vec3(-6.9, -25.0, 35.0)
DV_BALLISTAS = [vec3(0, -0.7, -37.5), vec3(-3.7, 6.3, 0), vec3(3.7, 6.3, 0), vec3(0, -0.1, 36.2)]
DRONE_RACK_AT = vec3(1.45, 0.17, 2.7)
DRONE_RACK_WAY = normalize(vec3(0, 0.22, 1))
# the ornithopter's long gun (scoped): a shell that flies fast and far, and hits hard; its
# health packs heal what they reach by HEAL, the craft's own side's or not
# (the ornithopter's long gun: so fast that a craft aimed at where it is now is hit, mostly; the
# shell hits what it comes 1.2 m near; through its crew, where they sit, it kills them)
const SNIPE_SPEED = 12000.0
const SNIPE_LIFE = 12           # ticks (2.4 km)
const SNIPE_DAMAGE = 80
const SNIPE_NEAR = 1.2
const SNIPE_CREW = 1.3          # (how near a seat's head it must pass)
const PISTOL_GAP = 30           # ticks between a pistol's shots (on foot, falling, under a canopy)
const SNIPE_GAP = 80            # ticks between shots
const HEAL = 45
# (where the ornithopter's guns and health packs come out: models.jo has the same)
ORNI_SNIPER = vec3(0.42, 0.3, -3.05)
ORNI_GUN = vec3(-0.4, 0.28, -1.5)
ORNI_LAUNCHER = vec3(-0.42, -0.2, -1.12)
# the little aerial screw (kind 12), da Vinci's 8 m screw over a deck SCREW_DECK m across: a sky gun
# tower, slow and heavy, holding where it is. Round its rail, at SCREW_MOUNT out: four twin machine
# guns (seats, MG2), two Greek fire siphons (seats, FLAME), and two automatic twin guns
# (SCREW_AUTOS) its crew works at the nearest of the others' within AUTO_RANGE, as a gun tower's
# are; a gun seat no one is at is worked by the crew too. None turns more than 60 degrees from
# straight out (70 a siphon): not up through its screw, nor down under its deck, so that right over
# it and right under it none can reach. Its pilot throws fire pots (X) the way they look,
# bursting by what they pass within POT_NEAR, burning what is within POT_BLAST (POT_BURN at
# most), one more made each POT_REFILL ticks up to its three
const SCREW = 12
KIND_NAMES.push("da Vinci's screw")
const SCREW_DECK = 6.4
const SCREW_FLOOR = -0.5
const SCREW_MOUNT = 3.0
# (a point of the deck: so far out, at the angle a (radians, counter-clockwise from the right as
# seen from above), so high)
screw_at = (a: f64, r: f64, y: f64) -> vec3: vec3(f32(cos(a) * r), f32(y), f32(-sin(a) * r))
screw_out = (a: f64, down: f64) -> vec3: normalize(vec3(f32(cos(a)), f32(-down), f32(-sin(a))))
const SCREW_GUN_Y = 0.65
SCREW_HELM = vec3(0.5, 1.1, 1.15)  # (the pilot's eyes, at the wheel behind the tower; models.jo has the same)
# (the guns' angles: the twin guns ahead, right, astern and left; the siphons ahead on the right
# and astern on the left; the automatic guns between)
SCREW_TWINS = [PI / 2.0, 0.0, PI * 1.5, PI]
SCREW_SIPHONS = [PI / 4.0, PI * 1.25]
SCREW_AUTO_A = [PI * 0.75, PI * 1.75]
SCREW_AUTOS = SCREW_AUTO_A.map((a): screw_at(a, SCREW_MOUNT, SCREW_GUN_Y))
const POT_SPEED = 62.0
const POT_UP = 5.0
const POT_NEAR = 3.5
const POT_BLAST = 12.0
const POT_BURN = 75
const POT_REFILL = 420
const POT_HIGH = 0.5            # (how far up and down the pilot can throw them, radians)
const POT_LOW = 0.9
# (its twin guns, a seat's and an automatic one's: both barrels at once, every MG2_GAP ticks,
# half-weight rounds as a gun tower's, out about 500 m)
const MG2_GAP = 5
const TWIN_LIFE = 80
const AUTO_RANGE = 500.0
const AUTO_TURN = 2.5           # (radians a second)
const AUTO_ARC = 0.5            # (the cosine: 60 degrees from straight out; not up through the screw)
# (the siphons: a spray of burning oil, FLAME_JETS gouts every FLAME_GAP ticks, a little spread,
# slowed by the air and rising, gone in FLAME_LIFE ticks: about 40 m; each grows as it goes,
# hitting what it comes FLAME_NEAR near at the end. Its pump heats as a gun does: 5 s of it at
# full, then as fast as it cools)
const FLAME_SPEED = 90.0
const FLAME_LIFE = 60
const FLAME_DRAG = 2.0
const FLAME_RISE = 12.0         # (m/s², against gravity's 9.8)
const FLAME_JETS = 2
const FLAME_GAP = 1
const FLAME_SPREAD = 0.08
const FLAME_DAMAGE = 2
const FLAME_NEAR = 2.2
const FLAME_REACH = 42.0
# the flying castle (kind 13), the Himmelsfeste: an island of rock flown, 280 m from its gatehouse
# to its rear wall (three times the zeppelin and the galleass), a walled town climbing in
# terraces to an abbey on top, the rock it was torn from hanging under it, lifted by five great
# steam-driven screws under the rock. The slowest thing in the sky, flown as the helicopters are,
# its lean a few degrees (CASTLE_TIP of theirs), its screws' push driving it (CASTLE_DRIVE m/s² at
# full stick). Hit as the ovals it is made of (CASTLE_SOLIDS), not an ellipsoid. Its pilot on the
# keep's bridge; its gunners at flak guns on the curtain wall's four quarter towers (shells timed
# to burst where they aim), twin heavy guns on the gatehouse, the wall towers and the rear gate,
# machine guns on bartizans on the curtain wall and on the second terrace's rampart; and
# automatic guns of its own on the keep's turrets and under its rock (CASTLE_AUTOS), firing as
# its crew's (its pilot's, the kills theirs). One a side. Parked, it sits in a ring of piers, its
# gate reached by a steam lift: boarded at the lift's foot (CASTLE_GATE); downed, its wreck lies
# CASTLE_WRECK ticks
const CASTLE = 13
KIND_NAMES.push("Himmelsfeste")
const CASTLE_TIP = 0.1
const CASTLE_DRIVE = 2.6
const CASTLE_WRECK = 60 * 90
const CASTLE_BOULDER = 900          # (a boulder's harm to it: it is not crushed whole)
CASTLE_GATE = vec3(0, -72, -164)
const CASTLE_FLAK_SPEED = 320.0
const CASTLE_FLAK_GAP = 45
const CASTLE_GEAR = 72.0
# (what of it is hit: upright ovals, each (its middle's x and z, its half across and along, its
# foot's height and its top's, and whose unevenness it has: a terrace's, as castle_wobble, or
# none, -1): the terraces with their houses, the keep, the abbey's tower, the rock band by band
# down (the quay's unevenness), its screws, the towers on its curtain wall
CASTLE_SOLIDS = [(0.0, 0.0, 82.0, 135.0, -15.0, 2.6, 0), (0.0, 10.0, 64.0, 105.3, -9.0, 14.6, 1), (0.0, 18.0, 47.6, 78.3, -9.0, 26.6, 2), (0.0, 24.0, 32.8, 54.0, -9.0, 38.6, 3), (0.0, 28.0, 19.7, 32.4, -9.0, 58.0, 4),
                 (0.0, -17.5, 20.0, 15.5, 16.0, 55.5, -1), (0.0, 18.0, 9.0, 9.0, 40.0, 92.0, -1),
                 (0.0, 2.0, 78.3, 128.9, -23.0, -15.0, 0), (0.0, 4.0, 72.2, 118.8, -32.0, -23.0, 0), (0.0, 6.5, 61.9, 101.9, -41.0, -32.0, 0), (0.0, 9.0, 48.4, 79.7, -49.0, -41.0, 0), (0.0, 11.0, 33.6, 55.4, -56.0, -49.0, 0), (0.0, 12.0, 22.1, 36.5, -60.0, -56.0, 0),
                 (-50.0, -74.0, 19.0, 19.0, -47.5, -44.5, -1), (50.0, -74.0, 19.0, 19.0, -47.5, -44.5, -1), (-50.0, 92.0, 19.0, 19.0, -47.5, -44.5, -1), (50.0, 92.0, 19.0, 19.0, -47.5, -44.5, -1), (0.0, 12.0, 25.0, 25.0, -65.1, -62.1, -1),
                 (-56.4, -99.6, 11.5, 11.5, -21.0, 10.5, -1), (51.3, -90.6, 11.5, 11.5, -21.0, 10.5, -1), (-59.2, 104.5, 11.5, 11.5, -21.0, 10.5, -1), (56.5, 99.8, 11.5, 11.5, -21.0, 10.5, -1),
                 (-12.6, -136.8, 8.5, 8.5, -21.0, 8.5, -1), (12.6, -137.7, 8.5, 8.5, -21.0, 8.5, -1), (-77.4, -39.4, 8.0, 8.0, -20.0, 7.5, -1), (79.2, -40.4, 8.0, 8.0, -20.0, 7.5, -1),
                 (-78.7, 40.1, 8.0, 8.0, -20.0, 7.5, -1), (82.4, 42.0, 8.0, 8.0, -20.0, 7.5, -1), (-11.4, 124.1, 7.5, 7.5, -21.0, 7.5, -1), (11.6, 126.7, 7.5, 7.5, -21.0, 7.5, -1)]
# (the terraces, as models.jo's CA_TIERS: (share of the outline, middle's z, floor's height); the
# outline 82 m across and 135 along, each terrace's uneven as castle_wobble)
CASTLE_TIERS = [(1.0, 0.0, -8.0), (0.78, 10.0, 4.0), (0.58, 18.0, 16.0), (0.4, 24.0, 28.0), (0.24, 28.0, 40.0)]
castle_wobble = (a: f64, i: int) -> f64: 1.0 + 0.045 * sin(3.0 * a + 0.6 + 0.9 * f64(i)) + 0.03 * sin(5.0 * a + 2.1 - 0.7 * f64(i)) + 0.02 * sin(2.0 * a + 1.0 + 0.4 * f64(i))
# the walkable top of a flying castle, in its own frame: the floor of the highest terrace (x, z)
# is on (the quay's, inside its curtain wall, the lowest), its houses, walls and towers not
# counted; -1e9 off it (models.jo's ca_walk_height the same)
castle_walk_height = (x: f64, z: f64) -> f64:
    y = -1e9
    loop i in 0.. and t in CASTLE_TIERS:
        dx = x / 82.0
        dz = (z - t.1) / 135.0
        if sqrt(dx * dx + dz * dz) <= t.0 * castle_wobble(atan2(dz, dx), i): y = t.2
    y
const TWIN_GAP = 8

# the fights (Rules.mode)
const DOGFIGHT = 0              # shoot down the other side's crafts
const CLASSIC = 1               # the same: fighters alone, guns alone, starting in the air
const BASES = 2                 # destroy the other side's airfield: hangars, fuel, command post
const FLAG = 3                  # take the other side's flag home
const TRENCH = 4                # the attackers raid the depot at the end of the gorge; the others defend it
const ESCORT = 5                # the attackers' bombers go for the defenders' factory
const FLAG_RAID = 6             # the attackers take the defenders' flag home, again and again
const RAIDS = 7                 # each side's bombers go for the other's factory
const THUNDERDOME = 8           # The Thunderdome: shoot the other side's targets (they come back); the cat is worth many
const BROOMS = 9                # the ball fight: balls through the other side's rings; the cat is worth many
MODE_NAMES = ["Dogfight", "Classic", "Base attack", "Capture the flag", "Trench run", "Bomber escort", "Flag raid", "Bomber raids", "The Thunderdome", "Bikes & Brooms"]
# (each fight's kinds of craft: those it can have at all (a bit each), and those it must; the
# lobby lists the first, the second locked on)
NO_CAT = ALL_CRAFTS & ~(1 << CAT)
MODE_CAN = [NO_CAT, 1 << FIGHTER, NO_CAT, NO_CAT, NO_CAT, NO_CAT, NO_CAT, NO_CAT, ALL_CRAFTS, NO_CAT]
MODE_MUST = [0, 0, 0, 0, 0, 0, 0, 0, 1 << CAT, 0]
# (Bikes & Brooms unless the lobby says: witches, bikes (the ornithopters) and balloons)
const BROOMS_CRAFTS = (1 << ROCKETEER) | (1 << BALLOON) | (1 << ORNITHOPTER)
# (what a fight has unless its lobby says)
mode_default = (m: int) -> int: if m == BROOMS: BROOMS_CRAFTS else: if cat_fight(m): THUNDERDOME_CRAFTS else: DEFAULT_CRAFTS
# (the fights with the cat, the rocketeers and the ornithopters: the targets', and the balls')
cat_fight = (m: int) -> bool: m == THUNDERDOME or m == BROOMS
# (the Thunderdome's points: a target down, the cat shot down; a target stands again TARGET_BACK
# ticks after)
const TARGET_POINTS = 10
# (the Thunderdome's gun towers: what their crews fire at, how far their bullets go (ticks), the
# ticks between a crew's shots, how wide they spread, and how long one shot down takes to stand
# again)
const NEST_RANGE = 800.0
const NEST_LIFE = 135
const NEST_GAP = 4
const NEST_SPREAD = 0.018
const NEST_FLAK_GAP = 80
const NEST_DAMAGE = 4
const NEST_BACK = 60 * 60
const CAT_POINTS = 150          # (to the side that shoots it down: only guns, rockets and bursts can; a ram is no harm to it)
const TARGET_BACK = 60 * 40
const THUNDERDOME_WIN = 250           # (points to win, unless the lobby says: a cat shot down, and a few targets, and it is won)
# (the ball fight's balls, by kind: two great ones, slow and heavy, struck to move; two middling;
# two small, light and quick, swerving as they spin; three small enough to carry, taken by flying
# through them. Each floats back to a height of its own over the ground (filled with a little gas,
# its leather or canvas the rest of its weight), is slowed by the air, bounces, and scores its
# points through one of the other side's rings)
const BIG_BALL = 0
const MID_BALL = 1
const SMALL_BALL = 2
const CARRY_BALL = 3
BALL_R = [8.0, 4.5, 2.5, 0.8]          # (its radius, m)
BALL_MASS = [7.0, 3.0, 1.1, 0.5]       # (against the crafts' masses, as the kinds have them)
BALL_REST = [46.0, 52.0, 58.0, 44.0]   # (the height it floats back to)
BALL_FALL = [1.4, 2.2, 3.2, 3.0]       # (m/s² toward it, at most)
BALL_DRAG = [0.2, 0.11, 0.1, 0.35]    # (its speed lost to the air, a second)
BALL_BOUNCE = [0.5, 0.6, 0.8, 0.4]
BALL_KICK = [2.4, 2.8, 3.0, 0.0]       # (struck: off at so many times the speed it was met at, against a craft as heavy)
BALL_TOP = [70.0, 110.0, 130.0, 60.0]    # (m/s at most, struck)
const KICK_AGAIN = 45           # (ticks before the craft that struck a ball can strike it again)
BALL_POINTS = [20, 30, 50, 15]
BALL_NAMES = ["great ball", "ball", "small ball", "carry ball"]
BALL_KINDS = [BIG_BALL, BIG_BALL, MID_BALL, MID_BALL, SMALL_BALL, SMALL_BALL, CARRY_BALL, CARRY_BALL, CARRY_BALL]
# (a craft strikes a ball as if this many times its mass: it drives on, the ball is only pushed)
const CRAFT_PUSH = 5.0
const BALL_IDLE = 60 * 90       # (a ball no one has touched this long goes back to the middle)
const BALL_APART = 40.0          # (two struck balls nearer than this, rim to rim, drift apart:
const BALL_SPREAD = 2.0          # at most so many m/s², touching)
const BALL_HOLD = 24            # (carried: let go when its carrier has been hurt this much: four bullets, or a rocket)
const BROOMS_WIN = 120
const BROOMS_CAT = 60            # (the cat shot down, in the ball fight: half a win)
# (Bikes & Brooms' golden cat: no one's (side GOLD), flown by the game, first out GOLD_FIRST ticks
# in (as the Thunderdome's cat: unhurt by what it hits, ramming what it meets); shot down, it wins
# the fight for that side. It shies from crafts within GOLD_SHY m)
const GOLD = 2
const GOLD_FIRST = 60 * 120
const GOLD_AGAIN = 60 * 60
const GOLD_SHY = 160.0
const GOLD_HEALTH = 8            # (two bullets, or a rocket near)
const GOLD_FAST = 66.0           # (m/s at most, chased)
const GOLD_CHASE = 500.0         # (the computer at the balls goes after it this near)
# (a player may fly it, Team Cat: then first out GOLD_FIRST_PLAYER ticks in, again GOLD_AGAIN_PLAYER
# after it crashes by itself, waiting till then in its loft, high over the field, out of reach;
# in the air at the whistle, it has won)
const GOLD_FIRST_PLAYER = 60 * 60
const GOLD_AGAIN_PLAYER = 60 * 15
const GOLD_LOFT = vec3(0, 520, 0)
# (the person who flies the golden cat, a player's, the last of all; -1: the computer flies it)
gold_person = (g: Game) -> int: if g.people.len() % 2 == 1: g.people.len() - 1 else: -1
# (the cat's points, by the fight)
cat_points = (m: int) -> int: if m == BROOMS: BROOMS_CAT else: CAT_POINTS
# (the fights where one side attacks and the other defends)
one_sided = (m: int) -> bool: m == TRENCH or m == ESCORT or m == FLAG_RAID

# a seat in a craft: where it is (the craft's own way: -z ahead, +x right, +y up), and for a
# gunner the way its gun points at rest and how far it turns from that (the cosine of the angle)
struct Seat:
    at: vec3
    dir = vec3(0, 0, 0)         # (0: the pilot's seat, its guns fixed ahead, if the kind has any)
    arc = 1.0
    weapon = 0                  # (a gunner's: GUN, BALLISTA, LAUNCHER (a gun, and X a drone))
const GUN = 0
const BALLISTA = 1
const LAUNCHER = 2
const MG2 = 3                  # (the little screw's twin machine guns)
const FLAKGUN = 4               # (the castle's: a shell, burst where it is timed to, or by a craft it passes)
const TWIN = 5                  # (the castle's twin heavy guns: a gun tower's)
const FLAME = 6                 # (the little screw's Greek fire siphons)

struct Kind:
    stall: f64                  # m/s: slower, the wings lose their grip
    thrust: f64                 # m/s² at full throttle
    drag: f64
    pitch_rate: f64             # radians a second, at full stick and speed
    roll_rate: f64
    yaw_rate: f64
    grip: f64                   # how fast the way it goes follows its nose (per second)
    health: int
    guns: bool                  # the pilot's guns, ahead
    fire_gap: int               # ticks between shots
    heat_shot: int              # (and it cools 1 a tick)
    rockets: int
    bombs: int
    half: vec3                  # half its extents: what is hit (an ellipsoid)
    seats: Seat[]
    gear: f64                   # its middle above the ground when it stands
    tilt: f64                   # (its nose up, standing on its tail wheel or skid)
    lighter = false             # (a zeppelin: lighter than air)
    mass = 1.0                  # (in a collision, the heavier one takes less)
    rocket_gap = 20             # (ticks between rockets)
    endless = false             # (rockets without end)
    refill = 0                  # (ticks to make one more rocket in the air: 0, none)
    heli = false                # (a helicopter: hovers, leans to go)
    aside = 1.0                 # (a helicopter: how far it leans to the side at full stick, of HELI_LEAN)
    tip = 1.0                   # (a helicopter: how far it leans at all, of HELI_LEAN)
    drive = 0.0                 # (a helicopter pushed along by its screws, not its lean: m/s² at full stick)

# (a gun's rest and how far it turns: never through the craft it is on)
gun = (at: vec3, dir: vec3, degrees: f64, weapon: int = GUN) -> Seat: Seat(at, normalize(dir), cos(radians(degrees)), weapon)
