# An inventory screen made with the layout module: it reflows from a wide window down to a phone
# held upright, and works with the mouse, a finger, keys and a gamepad.
#
# Wide: the tabs at the left, the list of items, the chosen item's details at the right.
# Narrower: the tabs go above the list. A phone held upright: the list alone, and an item's
# details in its place once it is chosen. Arrows, the d-pad or the left stick move between
# controls; Enter or A chooses; Q and E (LB and RB) change the tab; Escape or B goes back.
# The pictures are drawn by the program (no image files).
import layout as ui

window("Inventory", 1280, 720)
screen_fit(.native)         # one unit per point: a phone's screen is about 390 wide
redraw_on_input()           # a menu: a frame only when something changes
sideways_hint(false)        # (laid out for a phone either way up)

enum Icon: sword, axe, bow, staff, knives, shield, helmet, boots, ring, potion, gem, ore, herb, map, coin, all
enum Slot: none, hand, offhand, head, feet, finger
enum Sort: name, rarity, value

struct Item:
    name: str
    tab = 1                 # 1 weapons, 2 armour, 3 potions, 4 materials
    kind = ""               # what it is, shown under its name
    icon: Icon = .sword
    rarity = 0              # common, uncommon, rare, epic
    count = 1
    slot: Slot = .none
    attack = 0
    defense = 0
    weight = 0.0
    value = 0
    durability = -1.0       # 0 to 1; -1 for things that do not wear
    effect = ""             # what it does
    quest = false
    equipped = false
    new = false

items = [
    Item("Iron Sword", 1, "Sword", .sword, 0, slot = .hand, attack = 12, weight = 3.0, value = 40, durability = 0.82, effect = "One-handed. Can be used with a shield.", equipped = true),
    Item("Hunting Bow", 1, "Bow", .bow, 1, slot = .hand, attack = 15, weight = 1.5, value = 85, durability = 0.64, effect = "Two-handed. Uses one arrow per shot; range 40 m."),
    Item("Battle Axe", 1, "Axe", .axe, 2, slot = .hand, attack = 22, weight = 5.5, value = 210, durability = 0.95, effect = "Two-handed. Heavy attacks break blocks.", new = true),
    Item("Ember Staff", 1, "Staff", .staff, 3, slot = .hand, attack = 18, weight = 2.0, value = 480, durability = 0.5, effect = "Two-handed. Fire damage. Each cast uses 5 mana.", new = true),
    Item("Throwing Knives", 1, "Thrown", .knives, 0, 12, slot = .offhand, attack = 6, weight = 0.2, value = 4, effect = "Thrown one at a time. Picked up again after a fight."),
    Item("Oak Shield", 2, "Shield", .shield, 0, slot = .offhand, defense = 10, weight = 4.0, value = 35, durability = 0.4, effect = "Blocks attacks from the front while held up.", equipped = true),
    Item("Tower Shield", 2, "Shield", .shield, 2, slot = .offhand, defense = 18, weight = 9.0, value = 260, durability = 1.0, effect = "Blocks arrows from the front. Movement 10% slower while held up."),
    Item("Leather Cap", 2, "Helmet", .helmet, 0, slot = .head, defense = 3, weight = 0.8, value = 15, durability = 0.7, effect = "Light. No penalty to stamina.", equipped = true),
    Item("Iron Helm", 2, "Helmet", .helmet, 1, slot = .head, defense = 7, weight = 2.5, value = 90, durability = 0.9, effect = "Stamina regenerates 5% slower."),
    Item("Travel Boots", 2, "Boots", .boots, 1, slot = .feet, defense = 2, weight = 1.0, value = 60, durability = 0.55, effect = "Movement 5% faster on roads."),
    Item("Silver Ring", 2, "Ring", .ring, 2, slot = .finger, weight = 0.1, value = 300, effect = "Magic damage taken 10% lower.", new = true),
    Item("Health Potion", 3, "Potion", .potion, 0, 5, weight = 0.3, value = 25, effect = "Restores 50 health."),
    Item("Mana Potion", 3, "Potion", .potion, 1, 3, weight = 0.3, value = 30, effect = "Restores 40 mana."),
    Item("Stamina Tonic", 3, "Potion", .potion, 2, 2, weight = 0.3, value = 55, effect = "Stamina regenerates twice as fast for 30 seconds."),
    Item("Iron Ore", 4, "Material", .ore, 0, 14, weight = 1.0, value = 6, effect = "A smithy forges 3 into an iron ingot."),
    Item("Moonpetal", 4, "Material", .herb, 1, 6, weight = 0.05, value = 12, effect = "Ingredient of mana potions."),
    Item("Ruby", 4, "Gem", .gem, 2, weight = 0.05, value = 150, effect = "Set into a weapon at a smithy: fire damage +4."),
    Item("Harbour Map", 4, "Quest item", .map, 3, weight = 0.1, effect = "Marks the way to the harbour vault. Cannot be sold.", quest = true),
]

SLOTS = [Slot.hand, Slot.offhand, Slot.head, Slot.feet, Slot.finger]
TABS = ["All", "Weapons", "Armour", "Potions", "Materials"]
TAB_ICONS = [Icon.all, Icon.sword, Icon.shield, Icon.potion, Icon.gem]
RARITY = ["Common", "Uncommon", "Rare", "Epic"]
CAPACITY = 60.0

struct State:
    tab = 0
    chosen = 2              # an index into items
    sort: Sort = .name
    open = false            # on a phone held upright: the chosen item's page instead of the list
    gold = 1240
    note = ""               # a message for a moment after an action
    note_time = 0.0
    weight_hover = false

st = State()

rarity_color = (r: int) -> vec4:
    match r:
        0: rgb(0.72, 0.74, 0.78)
        1: rgb(0.45, 0.82, 0.48)
        2: rgb(0.4, 0.66, 1.0)
        _: rgb(0.78, 0.52, 1.0)

carried = () -> f64:
    w = 0.0
    loop it in items: w += it.weight * f64(it.count)
    w

# the items of the current tab, in the chosen order (indices into items)
shown = () -> int[]:
    out: int[]
    loop i in 0.. and it in items:
        if st.tab == 0 or it.tab == st.tab: out.push(i)
    match st.sort:
        name: out.sort_by((i: int) -> str: items[i].name)
        rarity: out.sort_by((i: int) -> int: -items[i].rarity * 100000 - items[i].value)
        value: out.sort_by((i: int) -> int: -items[i].value)
    out

count_in = (tab: int) -> int:
    n = 0
    loop it in items:
        if tab == 0 or it.tab == tab: n += 1
    n

# what is worn in the same place as it (-1: nothing)
worn = (it: Item) -> int:
    loop i in 0.. and o in items:
        if o.equipped and o.slot == it.slot and it.slot != .none: return i
    -1

say = (s: str):
    st.note = s
    st.note_time = elapsed()

choose_tab = (t: int):
    st.tab = (t + TABS.len()) % TABS.len()
    list = shown()
    if list.len() > 0 and not list.contains(st.chosen): st.chosen = list[0]
    ui.scroll_to("items", 0, root = "inventory")

equip = (i: int):
    it = items[i]
    if it.equipped:
        items[i].equipped = false
        say("Unequipped {it.name}")
        return
    w = worn(it)
    if w >= 0: items[w].equipped = false
    items[i].equipped = true
    say("Equipped {it.name}")

drink = (i: int):
    it = items[i]
    items[i].count -= 1
    say("Used {it.name}")
    if items[i].count == 0: take_out(i)

sell = (i: int):
    it = items[i]
    st.gold += it.value
    items[i].count -= 1
    say("Sold {it.name} for {it.value} gold")
    if items[i].count == 0: take_out(i)

take_out = (i: int):
    items.remove_at(i)
    list = shown()
    st.chosen = if list.len() > 0: list[0] else: 0
    st.open = false

# ---------------- pictures, drawn with shapes ----------------

# an icon in the square middle of r: c is its color (the rarity's for items)
icon = (kind: Icon, r: Rect, c: vec4):
    s = f64(min(r.w, r.h))
    ox = f64(r.x) + (f64(r.w) - s) / 2.0
    oy = f64(r.y) + (f64(r.h) - s) / 2.0
    p = (x: f64, y: f64) -> vec2: vec2(ox + x * s, oy + y * s)
    steel = rgb(0.86, 0.89, 0.94)
    wood = rgb(0.55, 0.38, 0.24)
    dark = rgb(0.1, 0.11, 0.14)
    match kind:
        sword:
            polygon([p(0.36, 0.56), p(0.78, 0.14), p(0.86, 0.14), p(0.86, 0.22), p(0.44, 0.64)], steel)
            line(p(0.24, 0.48), p(0.52, 0.76), 0.07 * s, c)
            line(p(0.36, 0.64), p(0.2, 0.8), 0.07 * s, wood)
            circle(p(0.17, 0.83), 0.06 * s, c)
        axe:
            line(p(0.28, 0.88), p(0.62, 0.16), 0.07 * s, wood)
            polygon([p(0.5, 0.2), p(0.84, 0.1), p(0.9, 0.36), p(0.82, 0.56), p(0.6, 0.4)], steel)
            line(p(0.5, 0.2), p(0.6, 0.4), 0.05 * s, c)
        bow:
            pts: vec2[]
            loop k in 0..9:
                a = -1.05 + 2.1 * f64(k) / 8.0
                pts.push(p(0.22 + 0.5 * cos(a), 0.5 + 0.5 * sin(a)))
            loop k in 0..8: line(pts[k], pts[k + 1], 0.07 * s, wood)
            line(pts[0], pts[8], 0.02 * s, steel)
            line(p(0.2, 0.5), p(0.86, 0.5), 0.03 * s, steel)
            polygon([p(0.92, 0.5), p(0.8, 0.44), p(0.8, 0.56)], c)
        staff:
            line(p(0.3, 0.9), p(0.6, 0.3), 0.07 * s, wood)
            circle_gradient(p(0.64, 0.22), 0.24 * s, with_alpha(c, 0.55), with_alpha(c, 0.0))
            circle(p(0.64, 0.22), 0.11 * s, c)
            circle(p(0.61, 0.19), 0.04 * s, rgb(1, 1, 1))
        knives:
            loop k in 0..3:
                d = f64(k) * 0.16
                polygon([p(0.22 + d, 0.82), p(0.3 + d, 0.82), p(0.34 + d, 0.36), p(0.26 + d, 0.14), p(0.2 + d, 0.36)], steel)
                line(p(0.26 + d, 0.82), p(0.26 + d, 0.9), 0.06 * s, c)
        shield:
            polygon([p(0.18, 0.16), p(0.82, 0.16), p(0.82, 0.48), p(0.5, 0.9), p(0.18, 0.48)], c)
            polygon([p(0.26, 0.24), p(0.74, 0.24), p(0.74, 0.46), p(0.5, 0.78), p(0.26, 0.46)], with_alpha(dark, 0.45))
            line(p(0.5, 0.26), p(0.5, 0.74), 0.07 * s, c)
            line(p(0.3, 0.42), p(0.7, 0.42), 0.07 * s, c)
        helmet:
            pts: vec2[]
            loop k in 0..13:
                a = PI + PI * f64(k) / 12.0
                pts.push(p(0.5 + 0.34 * cos(a), 0.58 + 0.4 * sin(a)))
            polygon(pts, steel)
            rect(p(0.14, 0.56), vec2(0.72 * s, 0.12 * s), c)
            rect(p(0.3, 0.4), vec2(0.4 * s, 0.07 * s), dark)
            line(p(0.5, 0.18), p(0.5, 0.4), 0.05 * s, c)
        boots:
            polygon([p(0.3, 0.14), p(0.56, 0.14), p(0.56, 0.6), p(0.86, 0.68), p(0.86, 0.86), p(0.3, 0.86)], wood)
            rect(p(0.3, 0.14), vec2(0.26 * s, 0.1 * s), c)
            rect(p(0.3, 0.8), vec2(0.56 * s, 0.06 * s), dark)
        ring:
            loop k in 0..20:
                a = 2.0 * PI * f64(k) / 20.0
                b = 2.0 * PI * f64(k + 1) / 20.0
                line(p(0.5 + 0.28 * cos(a), 0.6 + 0.26 * sin(a)), p(0.5 + 0.28 * cos(b), 0.6 + 0.26 * sin(b)), 0.08 * s, steel)
            polygon([p(0.5, 0.1), p(0.64, 0.24), p(0.5, 0.4), p(0.36, 0.24)], c)
        potion:
            circle(p(0.5, 0.64), 0.27 * s, rgba(1, 1, 1, 0.22))
            circle(p(0.5, 0.66), 0.22 * s, c)
            rect(p(0.42, 0.2), vec2(0.16 * s, 0.22 * s), rgba(1, 1, 1, 0.22))
            rect(p(0.4, 0.12), vec2(0.2 * s, 0.1 * s), wood)
            circle(p(0.42, 0.58), 0.05 * s, rgba(1, 1, 1, 0.7))
        gem:
            polygon([p(0.3, 0.2), p(0.7, 0.2), p(0.88, 0.4), p(0.5, 0.88), p(0.12, 0.4)], c)
            polygon([p(0.3, 0.2), p(0.7, 0.2), p(0.62, 0.4), p(0.38, 0.4)], rgba(1, 1, 1, 0.35))
            polygon([p(0.38, 0.4), p(0.62, 0.4), p(0.5, 0.88)], rgba(1, 1, 1, 0.14))
        ore:
            polygon([p(0.14, 0.8), p(0.2, 0.46), p(0.44, 0.3), p(0.66, 0.42), p(0.7, 0.8)], rgb(0.42, 0.42, 0.46))
            polygon([p(0.5, 0.82), p(0.58, 0.56), p(0.78, 0.48), p(0.9, 0.64), p(0.86, 0.82)], rgb(0.52, 0.52, 0.56))
            circle(p(0.36, 0.56), 0.05 * s, c)
            circle(p(0.5, 0.44), 0.04 * s, c)
            circle(p(0.74, 0.62), 0.04 * s, c)
        herb:
            line(p(0.5, 0.9), p(0.5, 0.3), 0.04 * s, rgb(0.35, 0.6, 0.3))
            polygon([p(0.5, 0.56), p(0.3, 0.4), p(0.16, 0.44), p(0.3, 0.6)], rgb(0.4, 0.7, 0.35))
            polygon([p(0.5, 0.66), p(0.7, 0.5), p(0.86, 0.54), p(0.7, 0.7)], rgb(0.4, 0.7, 0.35))
            circle(p(0.5, 0.24), 0.12 * s, c)
            circle(p(0.5, 0.24), 0.05 * s, rgb(1, 1, 0.85))
        map:
            rect(p(0.2, 0.22), vec2(0.6 * s, 0.56 * s), rgb(0.86, 0.78, 0.6))
            rect(p(0.14, 0.18), vec2(0.08 * s, 0.64 * s), rgb(0.72, 0.62, 0.45))
            rect(p(0.78, 0.18), vec2(0.08 * s, 0.64 * s), rgb(0.72, 0.62, 0.45))
            line(p(0.3, 0.64), p(0.44, 0.5), 0.03 * s, rgb(0.5, 0.4, 0.3))
            line(p(0.44, 0.5), p(0.56, 0.56), 0.03 * s, rgb(0.5, 0.4, 0.3))
            line(p(0.58, 0.34), p(0.7, 0.46), 0.04 * s, c)
            line(p(0.7, 0.34), p(0.58, 0.46), 0.04 * s, c)
        coin:
            circle(p(0.5, 0.5), 0.42 * s, rgb(0.93, 0.72, 0.25))
            circle(p(0.5, 0.5), 0.3 * s, rgb(1, 0.84, 0.4))
            rect(p(0.44, 0.32), vec2(0.12 * s, 0.36 * s), rgb(0.93, 0.72, 0.25))
        all:
            loop k in 0..4:
                rect_rounded(f64(p(0.14 + 0.38 * f64(k % 2), 0.0).x), f64(p(0.0, 0.14 + 0.38 * f64(k / 2)).y), 0.34 * s, 0.34 * s, 0.08 * s, c)

# the room behind the menu: a dim scene, as a game paused under its inventory
backdrop = (v: Rect):
    rect_gradient(f64(v.x), f64(v.y), f64(v.w), f64(v.h), rgb(0.11, 0.13, 0.18), rgb(0.05, 0.055, 0.07))
    circle_gradient(vec2(v.x + v.w * 0.18, v.y + v.h * 0.1), f64(max(v.w, v.h)) * 0.55, rgba(1, 0.7, 0.35, 0.1), rgba(1, 0.7, 0.35, 0))
    circle_gradient(vec2(v.x + v.w * 0.9, v.y + v.h * 0.95), f64(max(v.w, v.h)) * 0.5, rgba(0.3, 0.5, 1, 0.08), rgba(0.3, 0.5, 1, 0))

# ---------------- the screen ----------------

update = (dt: f64):
    narrow = st.open
    if key_pressed(.q) or gamepad_pressed(.lb): choose_tab(st.tab - 1)
    if key_pressed(.e) or gamepad_pressed(.rb): choose_tab(st.tab + 1)
    if (key_pressed(.escape) or gamepad_pressed(.b)) and narrow: st.open = false

draw = ():
    v = visible_rect()
    backdrop(v)
    # (a big window: everything larger, as if it were 1280 x 720; a short one on a computer,
    # smaller, so that it all fits)
    zoom = clamp(min(f64(v.w) / 1280.0, f64(v.h) / 720.0), 1.0, 2.0)
    if f64(v.h) < 560.0 and not touch_device(): zoom = max(f64(v.h) / 560.0, 0.6)
    w = f64(v.w) / zoom
    h = f64(v.h) / zoom
    push_transform()
    scale(zoom, zoom)
    wide = w >= 980.0
    phone = w < 620.0
    compact = phone or h < 500.0            # (a phone either way up)
    if not phone: st.open = false
    gap = if compact: 10.0 else: 16.0
    ui.screen(key = "inventory", pad = if compact: 12 else: 24, gap = gap, ():
        header(phone, compact)
        if not wide: tab_strip()
        ui.row(width = ui.grow(), height = ui.grow(), gap = gap, ():
            if wide: tab_column()
            if phone:
                if st.open: details(ui.grow(), true, h >= 640)
                else: item_list(true)
            else:
                item_list(false)
                details(if wide: ui.fixed(360) else: ui.percent(0.44), false, h >= 640)
        )
        if not phone and h >= 520 and not touch_input(): hints()
        toast()
    )
    pop_transform()

header = (phone: bool, compact: bool):
    ui.row(width = ui.grow(), gap = 12, cross = .center, ():
        ui.label("Inventory", size = if compact: 26 else: 32)
        ui.space(width = ui.grow())
        # gold: a coin and the amount
        ui.row(pad = ui.insets(10, 6, 12, 6), radius = 16, color = rgba(1, 1, 1, 0.06), (): price(st.gold, 18))
        if not phone: weight_meter(ui.fit(), ui.fixed(120))
    )
    if phone: weight_meter(ui.grow(), ui.grow())

# how much is carried, against what can be: its tooltip says what the limit does
weight_meter = (width: ui.Size, bar_width: ui.Size):
    load = carried()
    over = load > CAPACITY
    hover = ui.row(width = width, pad = ui.insets(12, 6, 12, 6), gap = 10, cross = .center, radius = 16, color = rgba(1, 1, 1, 0.06), key = "weight", ():
        ui.label("Weight", size = 16, color = hud_style.muted)
        ui.bar(load / CAPACITY, color = if over: rgb(1, 0.45, 0.4) else: rgb(0.55, 0.78, 1), width = bar_width, height = 8)
        ui.label("{load:.1f} / {CAPACITY:.0f}", size = 16)
        if st.weight_hover:
            ui.over(anchor = .bottom_right, at = .top_right, offset = vec2(0, 8), width = ui.fit(max = 300), pad = 12, radius = 8, color = rgba(0.08, 0.09, 0.12, 0.97), border = ui.Border(hud_style.border), ():
                ui.label("Over {CAPACITY:.0f} kg, you walk at half speed and cannot run.", size = 16, wrap = true)
            )
    ).hovered
    st.weight_hover = hover

# the tabs as a column at the left (wide windows)
tab_column = ():
    ui.panel(width = 210, height = ui.grow(), pad = 8, gap = 4, ():
        loop t in 0.. and name in TABS:
            on = t == st.tab
            if ui.row(width = ui.grow(), height = 44, pad = ui.insets(12, 0, 12, 0), gap = 12, cross = .center, radius = 8, color = if on: with_alpha(hud_style.accent, 0.14) else: vec4(), focusable = true, key = name, ():
                ui.slot(width = 20, height = 20, (r: Rect): icon(TAB_ICONS[t], r, if on: hud_style.accent else: hud_style.muted))
                ui.label(name, size = 18, color = if on: hud_style.text else: hud_style.muted)
                ui.space(width = ui.grow())
                ui.label("{count_in(t)}", size = 15, color = hud_style.muted)
                # (the chosen tab's mark at its left edge)
                if on: ui.over(anchor = .left, at = .left, width = 3, height = 20, radius = 2, color = hud_style.accent, (): pass)
            ).clicked: choose_tab(t)
    )

# the tabs as a row that scrolls sideways (narrower windows)
tab_strip = ():
    ui.scroll(axis = .horizontal, width = ui.grow(), pad = ui.insets(4, 4, 4, 10), gap = 8, key = "tabs", ():
        loop t in 0.. and name in TABS:
            if ui.button("{name}  {count_in(t)}", height = 36, selected = t == st.tab, key = name): choose_tab(t)
    )

SORTS = ["Name", "Rarity", "Value"]

item_list = (phone: bool):
    list = shown()
    ui.panel(width = ui.grow(), height = ui.grow(), pad = 8, gap = 8, ():
        ui.row(width = ui.grow(), pad = ui.insets(8, 4, 4, 0), gap = 6, cross = .center, ():
            ui.label("{list.len()} items", size = 16, color = hud_style.muted)
            ui.space(width = ui.grow())
            # (on a phone, one button that goes on to the next order; else one for each)
            if phone:
                if ui.button("Sort: {SORTS[int(st.sort)]}", height = 30, key = "sort"): st.sort = Sort((int(st.sort) + 1) % 3)
            else:
                ui.label("Sort", size = 16, color = hud_style.muted)
                ui.space(width = 2)
                loop k in 0.. and name in SORTS:
                    if ui.button(name, height = 30, selected = int(st.sort) == k, key = name): st.sort = Sort(k)
        )
        ui.scroll(width = ui.grow(), height = ui.grow(), pad = ui.insets(6, 6, 16, 6), gap = 8, key = "items", ():
            loop i in list: card(i, phone)
        )
    )

# one item in the list: its picture (with how many), name, kind, wear and price
card = (i: int, phone: bool):
    it = items[i]
    chosen = i == st.chosen
    rc = rarity_color(it.rarity)
    back = if chosen: rgba(1, 1, 1, 0.09) else: rgba(1, 1, 1, 0.035)
    edge = if chosen: ui.Border(hud_style.accent, 1.5) else: ui.Border(rgba(1, 1, 1, 0.06))
    got = ui.row(width = ui.grow(), pad = 10, gap = if phone: 12 else: 14, cross = .center, radius = 10, color = back, border = edge, focusable = true, key = it.name, ():
        tile(it, if phone: 48 else: 56)
        ui.column(width = ui.grow(), gap = 5, ():
            ui.row(gap = 8, cross = .center, ():
                ui.label(it.name, size = 18, wrap = true)
                if it.equipped: badge("Equipped", hud_style.accent)
            )
            ui.label(kind_text(it), size = 14, color = with_alpha(rc, 0.9))
            if it.durability >= 0.0: ui.bar(it.durability, color = wear_color(it.durability), width = ui.grow(max = 220), height = 5)
        )
        if not it.quest: price(it.value, 17)
        # (not looked at yet: a dot at the card's corner)
        if it.new: ui.over(anchor = .top_right, at = .center, offset = vec2(-8, 8), width = 8, height = 8, radius = 4, color = hud_style.accent, clip = true, (): pass)
    )
    # (keys and a gamepad show the details of the card they move to; a click or Enter opens it)
    if got.focused: st.chosen = i
    if got.clicked:
        st.chosen = i
        st.open = true

# an item's picture on a square of its rarity's color, with how many at the corner
tile = (it: Item, size: f64):
    rc = rarity_color(it.rarity)
    ui.row(width = size, height = size, align = .center, cross = .center, radius = size * 0.18, color = vec4(rc.x * 0.22, rc.y * 0.22, rc.z * 0.22, 1), border = ui.Border(with_alpha(rc, 0.5)), ():
        ui.slot(width = size * 0.72, height = size * 0.72, (r: Rect): icon(it.icon, r, rc))
        if it.count > 1:
            ui.over(anchor = .bottom_right, at = .bottom_right, offset = vec2(4, 4), clip = true, pad = ui.insets(5, 1, 5, 1), radius = 6, color = rgba(0.04, 0.05, 0.07, 0.92), border = ui.Border(with_alpha(rc, 0.5)), ():
                ui.label("{it.count}", size = 13)
            )
    )

kind_text = (it: Item) -> str: if it.quest: it.kind else: "{RARITY[it.rarity]} {it.kind}"

# an amount of gold: a coin and the number
price = (n: int, size: f64):
    ui.row(gap = 6, cross = .center, ():
        ui.slot(width = size * 0.8, height = size * 0.8, (r: Rect): icon(.coin, r, WHITE))
        ui.label("{n}", size = size)
    )

badge = (s: str, c: vec4):
    ui.row(pad = ui.insets(7, 1, 7, 2), radius = 6, color = with_alpha(c, 0.16), border = ui.Border(with_alpha(c, 0.5)), ():
        ui.label(s, size = 12, color = c)
    )

wear_color = (d: f64) -> vec4:
    if d < 0.3: return rgb(1, 0.45, 0.4)
    if d < 0.6: return rgb(1, 0.78, 0.35)
    rgb(0.5, 0.82, 0.5)

# the chosen item: picture, numbers against what is worn now, what it does, what can be done
details = (width: ui.Size, page: bool, roomy: bool):
    if items.len() == 0: return
    i = clamp(st.chosen, 0, items.len() - 1)
    items[i].new = false        # (looked at now)
    it = items[i]
    ui.panel(width = width, height = ui.grow(), pad = 20, gap = 14, key = "details", ():
        if page:
            if ui.button("Back", height = 34, key = "back"): st.open = false
        # (what does not fit a short screen scrolls; the buttons stay at the bottom)
        ui.scroll(width = ui.grow(), height = ui.grow(), pad = ui.insets(0, 0, 12, 0), gap = 14, key = "about", (): about(it, i))
        if roomy: worn_row()
        ui.row(width = ui.grow(), gap = 10, ():
            if it.slot != .none:
                if ui.button(if it.equipped: "Unequip" else: "Equip", width = ui.grow(), key = "equip"): equip(i)
            else if it.tab == 3:
                if ui.button("Use", width = ui.grow(), key = "use"): drink(i)
            sell_text = if it.quest: "Cannot sell" else: "Sell for {it.value}"
            if ui.button(sell_text, width = ui.grow(), enabled = not it.quest and not it.equipped, key = "sell"): sell(i)
        )
    )

# the item's picture, name, numbers and what it does
about = (it: Item, i: int):
    rc = rarity_color(it.rarity)
    ui.row(width = ui.grow(), gap = 16, cross = .center, ():
        tile(it, 84)
        ui.column(width = ui.grow(), gap = 6, ():
            ui.label(it.name, size = 24, wrap = true, width = ui.grow())
            ui.label(kind_text(it), size = 15, color = rc)
            if it.equipped: badge("Equipped", hud_style.accent)
        )
    )
    ui.row(width = ui.grow(), height = 1, color = rgba(1, 1, 1, 0.08), (): pass)
    w = worn(it)
    other = if w >= 0 and w != i: items[w] else: it
    if it.slot == .hand or it.slot == .offhand and it.attack > 0: stat("Attack", f64(it.attack), f64(other.attack), 30.0, true)
    if it.defense > 0 or it.slot == .head or it.slot == .feet: stat("Defense", f64(it.defense), f64(other.defense), 20.0, true)
    stat("Weight", it.weight, other.weight, 10.0, false)
    if it.durability >= 0.0: stat("Condition", it.durability * 100.0, -1.0, 100.0, true)
    if w >= 0 and w != i: ui.label("Compared with {items[w].name}", size = 14, color = hud_style.muted)
    ui.label(it.effect, size = 17, wrap = true, width = ui.grow())

# what is worn: a square for each place, with what is in it (a click shows it)
worn_row = ():
    ui.label("Equipped", size = 14, color = hud_style.muted)
    ui.row(width = ui.grow(), gap = 8, ():
        loop sl in SLOTS:
            k = -1
            loop i in 0.. and it in items:
                if it.equipped and it.slot == sl: k = i
            if k >= 0:
                if ui.row(width = ui.grow(max = 52), focusable = true, radius = 10, key = "worn {k}", (): tile(items[k], 52)).clicked: st.chosen = k
            else: ui.row(width = ui.grow(max = 52), height = 52, radius = 10, border = ui.Border(rgba(1, 1, 1, 0.1)), (): pass)
    )

# a number with a bar, and how it differs from what is worn (green: better)
stat = (name: str, value: f64, worn_value: f64, top: f64, more_is_better: bool):
    ui.row(width = ui.grow(), gap = 12, cross = .center, ():
        ui.label(name, size = 15, color = hud_style.muted, width = 84)
        ui.bar(value / top, color = rgb(0.55, 0.78, 1), height = 6)
        ui.label(if value == floor(value): "{value:.0f}" else: "{value:.1f}", size = 16, width = 40, align = .right)
        d = value - worn_value
        diff = if worn_value < 0.0 or abs(d) < 0.001: "" else if d > 0.0: "+{d:.3g}" else: "{d:.3g}"
        good = (d > 0.0) == more_is_better
        ui.label(diff, size = 14, color = if good: rgb(0.5, 0.86, 0.5) else: rgb(1, 0.5, 0.45), width = 40)
    )

# what the keys and a gamepad's buttons do
hints = ():
    pad = gamepad_connected()
    ui.row(gap = 18, cross = .center, ():
        hint(if pad: "D-pad" else: "Arrows", "Move")
        hint(if pad: "A" else: "Enter", "Choose")
        hint(if pad: "LB RB" else: "Q E", "Tabs")
    )

hint = (keys: str, what: str):
    ui.row(gap = 8, cross = .center, ():
        ui.row(pad = ui.insets(7, 2, 7, 3), radius = 5, border = ui.Border(hud_style.border), color = rgba(1, 1, 1, 0.05), ():
            ui.label(keys, size = 13)
        )
        ui.label(what, size = 14, color = hud_style.muted)
    )

# the last action, at the bottom for two seconds
toast = ():
    t = elapsed() - st.note_time
    if len(st.note) == 0 or t > 2.0: return
    request_redraw()
    a = f32(clamp((2.0 - t) / 0.3, 0.0, 1.0))
    ui.over(anchor = .bottom, at = .bottom, offset = vec2(0, -8), pad = ui.insets(16, 9, 16, 10), radius = 18, color = rgba(0.1, 0.11, 0.14, 0.96 * a), border = ui.Border(with_alpha(hud_style.accent, 0.6 * a)), ():
        ui.label(st.note, size = 16, color = with_alpha(hud_style.text, a))
    )
