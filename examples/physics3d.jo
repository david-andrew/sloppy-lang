# Physics in 3D: walk a capsule around a yard with a ramp, steps, a pyramid of crates, a hanging
# chain and a door on a hinge (import physics3d). Click to take the mouse (Escape gives it
# back); W A S D to walk, Space to jump, the mouse to look, the left button to throw a ball.
# R starts over.

import physics3d

window("Physics 3D", 1280, 720)

const WALK = 5.0
const JUMP = 5.5

w = physics3d.World()
me = w.character(vec3(0, 0, 10))
yaw = 0.45
pitch = -0.3
colors: {int: vec4}
level_mesh = custom_mesh([])
cube = cube_mesh(1.0)
ball = sphere_mesh(0.5)
stick = capsule_mesh(0.2, 1.2)          # (the capsules to knock over)
walker = capsule_mesh(0.3, 1.8)         # (the character's shape)

setup = ():
    w = physics3d.World()
    me = w.character(vec3(0, 0, 10))
    colors.clear()
    level: Vertex3D[]
    stone = rgb(0.55, 0.56, 0.6)
    add_box(level, vec3(0, -0.5, 0), vec3(60, 1, 60), rgb(0.42, 0.5, 0.38))
    w.add_box(vec3(0, -0.5, 0), vec3(60, 1, 60), kind = .fixed)
    # a ramp of triangles up to a platform, and steps down from it
    ramp = [vec3(-14, 0, -2), vec3(-14, 0, 2), vec3(-6, 2.5, 2), vec3(-14, 0, -2), vec3(-6, 2.5, 2), vec3(-6, 2.5, -2)]
    w.add_mesh(ramp)
    n = normalize(cross(ramp[1] - ramp[0], ramp[2] - ramp[0]))
    loop p in ramp: level.push(Vertex3D(p, n, vec2(0, 0), stone))
    w.add_box(vec3(-4, 1.25, 0), vec3(4, 2.5, 4), kind = .fixed)
    add_box(level, vec3(-4, 1.25, 0), vec3(4, 2.5, 4), stone)
    loop k in 0..8:
        h = 2.5 - 0.3125 * f64(k + 1)
        c = vec3(-1.5 + 0.5 * f32(k), f32(h / 2.0), 0)
        w.add_box(c, vec3(0.5, f32(h), 4), kind = .fixed)
        add_box(level, c, vec3(0.5, f32(h), 4), stone)
    # a beam the chain and the door hang from
    w.add_box(vec3(8, 4, -6), vec3(8, 0.4, 0.4), kind = .fixed)
    add_box(level, vec3(8, 4, -6), vec3(8, 0.4, 0.4), stone)
    level_mesh = custom_mesh(level)
    # a pyramid of crates
    loop r in 0..6:
        loop k in 0..6 - r:
            b = w.add_box(vec3(6 + f64(k) * 1.02 - f64(5 - r) * 0.51, 0.5 + f64(r), 6), vec3(1, 1, 1), density = 300)
            colors[b.id] = hsv(0.07 + 0.03 * f64((k + r) % 3), 0.55, 0.85)
    # a chain of balls hanging from the beam
    prev = physics3d.ground
    loop k in 0..8:
        b = w.add_sphere(vec3(5, 3.5 - 0.45 * f64(k), -6), 0.2)
        colors[b.id] = rgb(0.75, 0.75, 0.8)
        w.ball(prev, b, vec3(5, 3.8 - 0.45 * f64(k), -6))
        prev = b
    # a door on a hinge
    door = w.add_box(vec3(10, 2.3, -6), vec3(2, 3, 0.15), density = 200)
    colors[door.id] = rgb(0.55, 0.38, 0.25)
    w.hinge(physics3d.ground, door, vec3(9, 2.3, -6), vec3(0, 1, 0))
    # some capsules standing, to knock over
    loop k in 0..5:
        b = w.add_capsule(vec3(-6 + f64(k) * 0.7, 3.3, 6), 0.2, 1.2)
        colors[b.id] = rgb(0.9, 0.9, 0.85)
    # three heavy balls, falling on the pyramid as it starts
    loop k in 0..3:
        b = w.add_sphere(vec3(5.5 + f64(k) * 1.2, 9 + f64(k) * 2.5, 6.3), 0.45, density = 3000)
        colors[b.id] = rgb(1.0, 0.55, 0.2)
    yaw = 0.45
    pitch = -0.3

setup()

forward = () -> vec3: vec3(f32(sin(yaw) * cos(pitch)), f32(sin(pitch)), f32(-cos(yaw) * cos(pitch)))

update = (dt: f64):
    if key_pressed(.r): setup()
    if mouse_pressed(.left) and not is_mouse_locked(): mouse_lock()
    else if mouse_pressed(.left):
        eye = me.feet + vec3(0, 1.6, 0)
        b = w.add_sphere(eye + forward() * 1.2, 0.25, density = 2000, bounce = 0.3)
        colors[b.id] = rgb(1.0, 0.55, 0.2)
        w.set_velocity(b, forward() * 18.0)
    if key_pressed(.escape): mouse_lock(false)
    if is_mouse_locked():
        d = mouse_delta() * 0.0025
        yaw += f64(d.x)
        pitch = clamp(pitch - f64(d.y), -1.3, 1.3)
    mv = vec3(0, 0, 0)
    f = vec3(f32(sin(yaw)), 0, f32(-cos(yaw)))
    r = vec3(-f.z, 0, f.x)
    if key_down(.w): mv += f
    if key_down(.s): mv -= f
    if key_down(.d): mv += r
    if key_down(.a): mv -= r
    if length(mv) > 0.0: mv = normalize(mv) * f32(WALK)
    j = 0.0
    if key_pressed(.space): j = JUMP
    w.walk(me, mv, dt, jump = j)
    w.step(dt)

draw = ():
    sky(vec3(0.3, 0.5, 0.85), vec3(0.8, 0.85, 0.9))
    sun(vec3(-0.5, 0.9, 0.6))
    shadows(true)
    fog(vec3(0.8, 0.85, 0.9), 0.004)
    eye = me.feet + vec3(0, 1.6, 0) - forward() * 4.0 + vec3(0, 0.6, 0)
    camera3d(eye, me.feet + vec3(0, 1.4, 0), 70)
    draw_mesh(level_mesh)
    # (the level is drawn as one mesh: these are what move)
    loop b in w.bodies():
        if not colors.has(b.id): continue
        c = colors[b.id]
        sz = w.size(b)
        t = w.transform(b)
        match w.shape(b):
            .box: draw_mesh(cube, t * scaling(sz), c)
            .sphere: draw_mesh(ball, t * scaling(sz), c)
            .capsule: draw_mesh(stick, t, c)
            _: pass
    draw_mesh(walker, translation(me.feet + vec3(0, 0.9, 0)), rgb(0.35, 0.6, 1.0))
    if not is_mouse_locked(): text_centered("click to look around", vec2(640, 420), 28, rgba(1, 1, 1, 0.7))
    text("W A S D: walk   Space: jump   left button: throw   R: start over", vec2(20, 20), 22, rgba(1, 1, 1, 0.75))
