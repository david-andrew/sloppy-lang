theme = mix([
    melody_loop("D3 - - - - - - - A2 - - - - - - - Bb2 - - - - - - - F2 - - - C3 - - -", 66.0, .triangle, 0.1, 1.0),
    melody_loop("D4 - - - E4 - F4 - - - E4 - D4 - - - A4 - - - G4 - F4 - - - E4 - - - - - D4 - - - F4 - G4 - - - A4 - - - - - - - - - - -", 66.0, .sine, 0.07, 0.5),
    melody_loop("A4 - - - - - - - F4 - - - - - - - F4 - - - - - - - A4 - - - G4 - - -", 66.0, .sine, 0.035, 1.0),
])

sound_volume = 0.8              # (settings)

# a sound, quieter and to one side with distance and direction from the player when it has a place
sfx = (s: Sound, volume: f64 = 1.0, pitch: f64 = 1.0):
    if quiet: return
    play(s, volume * sound_volume, pitch = pitch)

sfx_at = (s: Sound, at: vec3, volume: f64 = 1.0, pitch: f64 = 1.0):
    if quiet: return
    d = at - eye()
    l = f64(length(d))
    pan = 0.0
    if l > 0.1: pan = f64(dot(d * f32(1.0 / l), right_of(you.yaw))) * 0.8
    play(s, volume * sound_volume / (1.0 + l * 0.08), pan, pitch)

# ---------------- the player ----------------
struct Player:
    body: Body
    yaw: f64 = 0.0
    pitch: f64 = 0.0
    shield: f64 = SHIELD
    health: f64 = HEALTH
    calm: f64 = 10.0            # seconds since the last hit
    alive: bool = true
    air: f64 = 0.0              # seconds off the ground (a jump still works just after leaving it)
    jump_wait: f64 = 1.0        # seconds since jump was pressed (it works just before landing)
    walked: f64 = 0.0           # meters, for footsteps and the weapon's bob
    kick: f64 = 0.0             # recoil, settling back
    shake: f64 = 0.0
    lunge: int = -1             # the raider a melee strike is lunging at
    lunge_time: f64 = 0.0

# the weapons: what each does (damage to health and to shields; a magazine and the most held in
# reserve; spread and how it blooms with firing, in radians; zoom; unshielded head shots)
# (the shotgun's damage is each pellet's, near: it falls off with distance)
enum Arm: pistol, rifle, shotgun, rockets, caster

struct ArmInfo:
    name: str
    mag: int                    # (the caster: its battery, no reloading)
    reserve: int
    gap: f64                    # seconds between shots
    auto: bool                  # fires while held (else once a press)
    reload: f64
    damage: f64
    shield_damage: f64
    spread: f64
    bloom: f64                  # added a shot,
    bloom_max: f64              # up to this
    zoom: f64                   # (1: none)
    head: f64                   # head shots on an unshielded raider: damage times this

arms = [ArmInfo("PISTOL", 12, 60, 0.27, false, 1.4, 22, 16, 0.003, 0.0045, 0.024, 2, 3),
        ArmInfo("RIFLE", 36, 180, 0.105, true, 1.6, 10, 7, 0.009, 0.0028, 0.03, 1, 1),
        ArmInfo("SHOTGUN", 8, 32, 0.7, false, 2.2, 16, 12, 0.12, 0, 0, 1, 1),
        ArmInfo("ROCKETS", 2, 2, 0.9, false, 3.0, 300, 300, 0.002, 0, 0, 1, 1),
        ArmInfo("CASTER", 100, 0, 0.15, true, 0, 13, 30, 0.012, 0, 0, 1, 1)]

# a weapon carried (arm -1: an empty hand)
struct Gun:
    arm: int = -1
    ammo: int = 0               # in the magazine (the caster: its charge)
    reserve: int = 0
    heat: f64 = 0.0             # 0 to 1 (caster)
    vent: f64 = 0.0             # overheated: seconds left to cool
    wait: f64 = 0.0             # until it can fire
    reload: f64 = 0.0           # reloading: seconds left
    bloom: f64 = 0.0            # spread added by firing, radians
    flash: f64 = 0.0            # (the muzzle flash)

gun_of = (a: Arm) -> Gun: Gun(int(a), arms[int(a)].mag, arms[int(a)].reserve)
arm_info = (g: Gun) -> ArmInfo: arms[max(g.arm, 0)]

# what the player does in a step: from the keyboard, mouse and pad, or the autopilot
struct Controls:
    move: vec2                  # x right, y forward
    jump: bool = false
    fire: bool = false
    fire_pressed: bool = false
    zoom: bool = false
    grenade: bool = false
    melee: bool = false
    reload: bool = false
    swap: bool = false
    pick: bool = false          # (held)

# (what the keys, buttons and sticks do: the player can change them, under Settings)
action("Forward", [.key(.w), .stick(1, -1)])
action("Back", [.key(.s), .stick(1, 1)])
action("Left", [.key(.a), .stick(0, -1)])
action("Right", [.key(.d), .stick(0, 1)])
action("Look up", [.key(.i), .key(.up)])
action("Look down", [.key(.k), .key(.down)])
action("Look left", [.key(.j), .key(.left)])
action("Look right", [.key(.l), .key(.right)])
action("Jump", [.key(.space), .button(.a)])
action("Fire", [.mouse(.left), .stick(5, 1)])
action("Zoom", [.mouse(.right), .key(.u), .stick(4, 1)])
action("Grenade", [.key(.g), .key(.o), .button(.lb)])
action("Melee", [.key(.f), .key(.h), .mouse(.middle), .button(.rb), .button(.b)])
action("Reload", [.key(.r), .button(.x)])
action("Pick up", [.key(.e), .button(.x)])
action("Swap weapons", [.key(.q), .key(.tab), .button(.y)])
action("Pause", [.key(.escape), .key(.p), .button(.start)])

you = Player(Body(v3(0, 2, 0), vec3(0, 0, 0), RADIUS))
guns = [gun_of(.pistol), Gun()]
held = 0                        # the one in hand
swap_time = 0.0                 # lowering one weapon and raising the other
melee_time = 0.0                # the strike's swing (and its cooldown)
throw_time = 0.0
grenades = 2
recharge_id = -1
alarm = 0.0
zoomed = false
zoom_k = 0.0                    # (easing in and out: 0 to 1)

eye = () -> vec3: you.body.pos + vec3(0, f32(EYE), 0)
aim = () -> vec3: look_dir(you.yaw, you.pitch)
right_of = (yaw: f64) -> vec3: v3(cos(yaw), 0, -sin(yaw))
chest = () -> vec3: you.body.pos + vec3(0, 1.2, 0)

# ---------------- raiders ----------------
enum Kind: skitter, warden, lobber
enum Mood: roam, hold, retreat, panic, charge

struct Foe:
    kind: Kind
    body: Body
    yaw: f64 = 0.0
    health: f64 = 0.0
    shield: f64 = 0.0
    calm: f64 = 10.0            # seconds since it was hit (its shield returns)
    mood: Mood = .roam
    mood_time: f64 = 0.0
    goal: vec3 = vec3(0, 0, 0)
    think: f64 = 0.0            # until it next picks a goal
    sees: bool = false
    seen: f64 = 0.0             # how long it has had the player in sight
    unseen: f64 = 0.0           # how long it has not (too long, and it comes looking)
    look: f64 = 0.0             # until it next checks
    fire_wait: f64 = 1.5
    burst: int = 0
    shot_wait: f64 = 0.0
    windup: f64 = 0.0
    flinch: f64 = 0.0
    dodge: f64 = 0.0
    dodge_dir: f32 = 1
    dodge_wait: f64 = 0.0
    strafe: f32 = 1
    strafe_time: f64 = 0.0
    melee_wait: f64 = 0.0
    swing: f64 = 0.0            # a melee strike winding up (it lands when this runs out)
    shield_flash: f64 = 0.0
    shield_pop: f64 = 0.0       # (the ring when the shield breaks)
    dead: f64 = -1.0            # seconds since it fell (-1: alive)
    gait: f64 = 0.0             # meters walked (its stride)
    recoil: f64 = 1.0           # seconds since it fired
    aiming: f64 = 0.0           # how far its head and gun have turned from looking about to aiming
    blip: f64 = 9.0             # seconds since it moved fast or fired (the tracker shows it)

# (size: its robot's scale; drop: the charge of the caster it leaves)
struct KindInfo:
    health: f64
    shield: f64
    speed: f64
    radius: f32
    points: int
    name: str
    size: f32
    drop: int

kinds = [KindInfo(45, 0, 4.0, 0.45, 100, "skitter", 1.5, 20), KindInfo(70, 70, 3.3, 0.55, 250, "warden", 1.7, 40),
         KindInfo(280, 0, 2.2, 0.7, 400, "lobber", 2.0, 0)]
info = (f: Foe) -> KindInfo: kinds[int(f.kind)]

# each kind's robot at size 1 (x to its left, y up, z ahead): its middle, what it sees from,
# where its shots leave, and the spheres a shot hits (x, y, z, radius; the last `eyes` of them
# its eyes: head shots)
struct Hull:
    center: vec3
    eye: vec3
    muzzle: vec3
    hits: vec4[]
    eyes: int

hulls = [Hull(vec3(0, 0.47, 0), vec3(0, 0.75, 0.2), vec3(0, 0.8, 0.66),
              [vec4(0, 0.47, 0, 0.25), vec4(0, 0.78, 0.2, 0.17), vec4(0, 0.47, 0.2, 0.08)], 1),
         Hull(vec3(0, 0.59, 0.05), vec3(0, 0.75, 0.25), vec3(0, 0.67, 0.4),
              [vec4(0, 0.59, 0.05, 0.39), vec4(0.24, 0.67, 0.24, 0.09), vec4(-0.24, 0.67, 0.24, 0.09)], 2),
         Hull(vec3(0, 0.59, 0.05), vec3(0, 1.0, 0.1), vec3(0, 1.05, 0.5),
              [vec4(0, 0.59, 0.05, 0.39), vec4(0, 1.02, -0.04, 0.3), vec4(0.24, 0.67, 0.24, 0.09), vec4(-0.24, 0.67, 0.24, 0.09)], 2)]
hull = (f: Foe) -> Hull: hulls[int(f.kind)]

# a point on a raider's robot (at size 1) where it stands now
on_foe = (f: Foe, at: vec3) -> vec3:
    z = info(f).size
    f.body.pos + vec3(0, at.y * z, 0) + look_dir(f.yaw, 0.0) * (at.z * z) - right_of(f.yaw) * (at.x * z)

foes: Foe[]

alive = (f: Foe) -> bool: f.dead < 0.0
foe_eye = (f: Foe) -> vec3: on_foe(f, hull(f).eye)
foe_center = (f: Foe) -> vec3: on_foe(f, hull(f).center)
# where its shots come from: its gun (a warden's eye; a lobber's cannon, on its back)
muzzle = (f: Foe) -> vec3: on_foe(f, hull(f).muzzle)

# where a shot along the ray hits a raider: its index (-1: none), the distance, and a head shot
# (slack widens every sphere; assist widens it by so much a meter away, up to 0.22 m: aim assist)
ray_foes = (o: vec3, d: vec3, far: f32, slack: f32, assist: f32 = 0) -> (int, f32, bool):
    near_t = far
    who = -1
    head = false
    loop i in 0.. and f in foes:
        if not alive(f): continue
        z = info(f).size
        spheres = hull(f).hits
        eyes = spheres.len() - hull(f).eyes
        loop k in 0.. and h in spheres:
            c = on_foe(f, h.xyz)
            t = ray_sphere(o, d, c, h.w * z + slack + min(f32(0.22), assist * max(dot(c - o, d), f32(0))))
            if t >= 0.0 and t < near_t:
                near_t = t
                who = i
                head = k >= eyes
    (who, near_t, head)

# ---------------- shots, grenades and effects ----------------
struct Bolt:
    pos: vec3
    vel: vec3
    damage: f64
    shield_damage: f64
    mine: bool                  # the player's (else a raider's)
    lob: bool                   # a lobber's shell: it falls, and bursts where it lands
    life: f64
    target: vec3 = vec3(0, 0, 0)
    from: vec3 = vec3(0, 0, 0)
    by: int = 0                 # (the kind that fired it)
    rocket: bool = false        # (the player's: it bursts where it hits)

struct Nade:
    pos: vec3
    vel: vec3
    fuse: f64 = -1.0            # starts at the first bounce
    age: f64 = 0.0

struct Spark:
    pos: vec3
    vel: vec3
    life: f64
    full: f64
    color: vec4
    size: f32
    falls: bool

struct Tracer:
    a: vec3
    b: vec3
    life: f64
    width: f64 = 0.015

struct Flash:
    pos: vec3
    color: vec3
    radius: f64
    life: f64
    full: f64

struct Warp:
    pos: vec3
    time: f64
    group: Kind[]

# a weapon to pick up: on a rack (which fills again), or dropped (for a while)
struct Pickup:
    gun: Gun
    pos: vec3
    yaw: f64
    life: f64                   # seconds left (a rack's: forever)
    rack: int = -1

# Racks hold a weapon: taken, a pistol or rifle comes back in 30 s (or when a wave starts); the
# shotgun from wave 3, every second wave, and rockets from wave 5, every third.
struct Rack:
    arm: Arm
    pos: vec3
    yaw: f64
    from_wave: int = 1
    every: int = 0              # (waves; 0: by time)
    wait: f64 = 0.0             # (seconds until it fills again)

racks = [Rack(.pistol, v3(-3.2, 2, 4.6), 0.0, 0), Rack(.rifle, v3(15.5, 0, 3.6), PI / 2.0, 0), Rack(.rifle, v3(-15.5, 0, -3.6), -PI / 2.0, 0),
         Rack(.shotgun, v3(-8, 0, 19.6), 0.0, 3, 2), Rack(.rockets, v3(8, 0, -19.6), PI, 5, 3)]

struct Popup:
    text: str
    age: f64
    big: bool

bolts: Bolt[]
nades: Nade[]
sparks: Spark[]
tracers: Tracer[]
flashes: Flash[]
warps: Warp[]
popups: Popup[]
pickups: Pickup[]
hurt_from: (vec3, f64)[]        # where hits came from, and how long ago
hit_mark = 0.0                  # the reticle's hit marker (and a kill's)
kill_mark = 0.0

burst = (at: vec3, n: int, speed: f64, color: vec4, life: f64, size: f64, falls: bool = true):
    loop k in 0..n:
        v = scatter(vec3(0, 1, 0), 2.6) * f32(speed * random(0.3, 1.0))
        sparks.push(Spark(at, v, life * random(0.6, 1.0), life, color, f32(size * random(0.6, 1.2)), falls))

flash_at = (at: vec3, color: vec3, radius: f64, life: f64): flashes.push(Flash(at, color, radius, life, life))

popup = (text: str, big: bool = false): popups.push(Popup(text, 0.0, big))

# a word of advice, the first time something comes up (once a session)
hint_text = ""
hint_time = 0.0
hints_seen: str[]
hint = (key: str, text: str):
    global hint_text, hint_time
    if quiet or not you.alive or hints_seen.contains(key): return
    hints_seen.push(key)
    hint_text = text
    hint_time = 6.0
# what to press for an action: its first key or button (on a touch screen, its button there)
key_of = (action_name: str) -> str:
    if using_touch():
        if action_name == "Pick up": return "the prompt"
        if action_name == "Grenade": return "NADE"
        loop t in TOUCH_BUTTONS:
            if upper(action_name) == t: return t
    b = bindings(action_name)
    if b.len() == 0: return "?"
    input_name(b[0])

# ---------------- score and waves ----------------
score = 0
wave = 0
pending: Kind[]                 # raiders still to arrive this wave
between = 0.0                   # the break after a wave (seconds left)
chain = 0                       # kills in quick succession
chain_time = 0.0
kills = 0
shots = 0
hits = 0
run_time = 0.0
over = false
over_time = 0.0
damage_by: f64[] = [0, 0, 0, 0] # (the balance test: damage taken from each kind, and own grenades)
cause = ""

# the raiders of wave n: more each wave, wardens joining early, lobbers from wave 3
plan = (n: int) -> Kind[]:
    # (the first two teach: skitters alone, then the first warden, arriving third)
    if n == 1: return [.skitter, .skitter, .skitter, .skitter, .skitter]
    if n == 2: return [.skitter, .skitter, .warden, .skitter, .skitter, .skitter]
    count = min(4 + 2 * n, 21)
    lob = 0
    if n >= 3: lob = 1
    if n >= 6: lob = 2
    war = min(1 + n / 2, 7)
    out: Kind[]
    loop i in 0..lob: out.push(.lobber)
    loop i in 0..war: out.push(.warden)
    loop out.len() < count: out.push(.skitter)
    # (shuffled, but the lobbers never first)
    loop i in 1..out.len():
        j = random_int(1, out.len())
        t = out[i]
        out[i] = out[j]
        out[j] = t
    out

# raiders get quicker to fire and hit a little harder, wave by wave
fierce = () -> f64: min(1.0 + 0.04 * f64(max(wave - 1, 0)), 1.5)

start_wave = (n: int):
    global pending, wave
    wave = n
    pending = plan(n)
    popup("WAVE {n}", true)
    sfx(snd_horn, 0.9)
    step_racks(0, true)
    if n == 1 and not using_touch(): hint("keys", "{key_of("Grenade")}: grenade     {key_of("Melee")}: melee     {key_of("Zoom")}: zoom")
    if n == 2: hint("rifle", "Rifles wait on racks by the ramps: hold {key_of("Pick up")} to take one")

# a group warps in at a bay away from the player (one it cannot see into, if it can)
open_warp = ():
    order: int[]
    loop i in 0..gates.len(): order.push(i)
    order.sort((i: int) -> f32: -length(gates[i] - you.body.pos))
    pick = order[random_int(0, 2)]
    group: Kind[]
    n = min(random_int(2, 5), MAX_ALIVE - count_alive())
    loop group.len() < n and pending.len() > 0:
        k = pending.pop()
        group.push(k)
        if k == .lobber: break
    warps.push(Warp(gates[pick], 0.0, group))
    sfx_at(snd_warp, gates[pick], 1.2)

count_alive = () -> int:
    n = 0
    loop f in foes:
        if alive(f): n += 1
    n

spawn = (k: Kind, at: vec3):
    ki = kinds[int(k)]
    if k == .warden: hint("warden", "Wardens are shielded: break the shield (a caster does it fast), then shoot its eye")
    if k == .lobber: hint("lobber", "Lobbers' shells land in the rings on the ground: get out of them")
    f = Foe(k, Body(at, vec3(0, 0, 0), ki.radius))
    f.health = ki.health
    f.shield = ki.shield
    f.yaw = yaw_of(flat(vec3(0, 0, 0) - at))
    f.think = random(0.0, 0.6)
    f.fire_wait = random(1.0, 2.5)
    f.strafe = f32(random_int(0, 2) * 2 - 1)
    foes.push(f)

step_waves = (dt: f64):
    global between, foes, grenades, warps
    if between > 0.0:
        between -= dt
        if between <= 0.0: start_wave(wave + 1)
        return
    loop mut w in warps:
        w.time += dt
        if w.time >= 1.6:
            loop i in 0.. and k in w.group:
                a = TAU * f64(i) / f64(w.group.len())
                spawn(k, w.pos + v3(cos(a) * 1.4, 0, sin(a) * 1.4))
            burst(w.pos + vec3(0, 1, 0), 24, 7.0, vec4(1.0, 0.6, 0.25, 1), 0.7, 0.07, false)
    warps = [loop w in warps if w.time < 1.6: w]
    n = count_alive()
    if pending.len() == 0 and n == 0 and warps.len() == 0:
        # the wave is over: a bonus, health back, another grenade, a breather
        bonus = 250 * wave
        score += bonus
        popup("WAVE {wave} HELD   +{bonus}", true)
        sfx(snd_cleared, 0.9)
        you.health = HEALTH
        grenades = min(grenades + 1, 4)
        between = 10.0
        foes = [loop f in foes if alive(f): f]
        return
    if pending.len() > 0 and warps.len() == 0 and n < MAX_ALIVE - 1: open_warp()

# a raider is down: points, a chain for quick kills, and fear among the skitters nearby
killed = (i: int, how: str):
    global chain, chain_time, kill_mark
    f = foes[i]
    ki = info(f)
    kills += 1
    if chain_time > 0.0: chain = min(chain + 1, 5)
    else: chain = 0
    chain_time = 3.0
    pts = ki.points + 50 * chain
    if how == "head":
        pts += 50
        popup("HEADSHOT  +50")
    if how == "melee":
        pts += 50
        popup("STRUCK DOWN  +50")
    if chain == 1: popup("DOUBLE  +50")
    else if chain == 2: popup("TRIPLE  +100")
    else if chain >= 3: popup("RAMPAGE  +{50 * chain}")
    score += pts
    kill_mark = 0.3
    sfx(snd_kill, 0.6)
    if f.kind == .warden:
        loop mut o in foes:
            if alive(o) and o.kind == .skitter and length(o.body.pos - f.body.pos) < 15.0 and chance(0.8):
                o.mood = .panic
                o.mood_time = random(2.0, 3.2)
                o.burst = 0
                sfx_at(snd_squeal, o.body.pos, 0.7, random(0.9, 1.2))
    foes[i].dead = 0.0
    burst(foe_center(f), 18, 5.0, vec4(1.0, 0.55, 0.2, 1), 0.8, 0.06)
    # its caster, dropped (with what charge it has)
    if ki.drop > 0:
        g = gun_of(.caster)
        g.ammo = ki.drop + random_int(-5, 6)
        drop(g, f.body.pos + right_of(f.yaw) * 0.5)

# damage to a raider: shields take shield_damage first (what is left over carries on in proportion)
hurt_foe = (i: int, damage: f64, shield_damage: f64, head: bool, how: str, head_times: f64 = 1.0):
    global hit_mark
    if not alive(foes[i]): return
    f = foes[i]
    bare = f.shield <= 0.0
    left = 1.0
    if f.shield > 0.0:
        f.shield_flash = 0.25
        if shield_damage >= f.shield:
            left = (shield_damage - f.shield) / shield_damage
            f.shield = 0
            f.shield_pop = 0.4
            sfx_at(snd_pop, foe_center(f), 0.9)
            burst(foe_center(f), 14, 6.0, vec4(1.0, 0.75, 0.3, 1), 0.5, 0.05, false)
            if f.kind == .warden:
                # (staggered, its burst cut short: then it runs for cover)
                f.mood = .retreat
                f.think = 0
                f.burst = 0
                f.swing = 0
                f.flinch = 0.3
        else:
            f.shield -= shield_damage
            left = 0
    d = damage * left
    if head and bare: d *= head_times
    f.health -= d
    f.calm = 0
    if f.flinch <= -0.6 and d > 0.0: f.flinch = 0.14
    if f.kind == .skitter and f.health < 20.0 and f.mood != .panic and chance(0.3):
        f.mood = .panic
        f.mood_time = 2.0
    foes[i] = f
    hit_mark = 0.15
    if f.health <= 0.0:
        if head and bare and how == "shot": killed(i, "head")
        else: killed(i, how)

# ---------------- the player: moving, weapons, damage ----------------
hurt = (amount: f64, from: vec3, by: int):
    global cause, over, recharge_id, zoomed
    if not you.alive or over: return
    had = you.shield
    you.calm = 0
    zoomed = false
    left = amount
    if you.shield > 0.0:
        a = min(you.shield, left)
        you.shield -= a
        left -= a
        if you.shield <= 0.0 and had > 0.0:
            hint("shield", "Shield down: get out of fire and it comes back")
            sfx(snd_crack, 0.8)
            you.shake = max(you.shake, 0.6)
    you.health -= left
    if by >= 0: damage_by[by] += amount
    hurt_from.push((from, 0.0))
    you.shake = max(you.shake, 0.25)
    sfx(snd_hit_me, 0.5)
    if recharge_id >= 0:
        stop(recharge_id)
        recharge_id = -1
    if you.health <= 0.0:
        you.health = 0
        you.alive = false
        over = true
        if by == 0: cause = "a skitter"
        else if by == 1: cause = "a warden"
        else if by == 2: cause = "a lobber's shell"
        else: cause = "your own grenade"

# a blast: full damage within `inner` m, falling to none at `radius` (cover stops it)
blast = (at: vec3, radius: f64, damage: f64, mine: bool, inner: f64 = 0.0):
    loop i in 0.. and f in foes:
        if not alive(f) or not mine: continue
        c = foe_center(f)
        d = f64(length(c - at))
        if d > radius or not clear_line(at + vec3(0, 0.3, 0), c): continue
        k = min(1.0, (radius - d) / (radius - inner))
        hurt_foe(i, damage * k, damage * k, false, "blast")
        push = normalize(flat(c - at) + vec3(0, 0.01, 0)) * f32(7.0 * k)
        foes[i].body.vel += push + vec3(0, f32(4.0 * k), 0)
    d = f64(length(chest() - at))
    if d < radius and clear_line(at + vec3(0, 0.3, 0), chest()):
        k = min(1.0, (radius - d) / (radius - inner))
        by = 2
        if mine: by = 3
        hurt(damage * k * 0.8, at, by)
        you.body.vel += normalize(flat(chest() - at) + vec3(0, 0.01, 0)) * f32(6.0 * k) + vec3(0, f32(3.0 * k), 0)
    you.shake = max(you.shake, clamp(1.2 - d / 20.0, 0.0, 1.0))
    burst(at + vec3(0, 0.3, 0), 40, 9.0, vec4(1.0, 0.7, 0.3, 1), 0.9, 0.09)
    burst(at + vec3(0, 0.3, 0), 16, 4.0, vec4(0.25, 0.25, 0.28, 1), 1.4, 0.16)
    flash_at(at + vec3(0, 1, 0), vec3(1.0, 0.6, 0.25), radius * 2.5, 0.35)
    sfx_at(snd_boom, at, 1.4)
    # skitters near a blast run from it
    loop mut o in foes:
        if alive(o) and o.kind == .skitter and length(o.body.pos - at) < 8.0 and chance(0.5):
            o.mood = .panic
            o.mood_time = 1.5

# a weapon left on the deck (at most 12 at once: the oldest goes)
drop = (g: Gun, at: vec3):
    if g.ammo + g.reserve <= 0: return
    loose = [loop k in pickups if k.rack < 0: k]
    if loose.len() >= 12:
        oldest = 0
        loop i in 0.. and k in pickups:
            if k.rack < 0 and k.life < pickups[oldest].life or pickups[oldest].rack >= 0: oldest = i
        pickups.remove_at(oldest)
    p = at
    p.y = floor_under(at, 0.2)
    kept = g
    kept.wait = 0
    kept.reload = 0
    kept.heat = 0
    kept.vent = 0
    kept.bloom = 0
    kept.flash = 0
    pickups.push(Pickup(kept, p, random(0.0, TAU), 30.0))

fire = ():
    g = guns[held]
    ai = arm_info(g)
    o = eye()
    if g.arm == int(Arm.caster) and g.vent > 0.0: return
    if g.ammo <= 0:
        if g.arm != int(Arm.caster) and g.reload <= 0.0 and g.reserve > 0: start_reload()
        else: sfx(snd_click, 0.4)
        guns[held].wait = 0.25
        return
    g.ammo -= 1
    g.wait = ai.gap
    shots += 1
    if g.arm == int(Arm.caster):
        g.heat += CASTER_HEAT
        you.kick += 0.004
        d = scatter(aim(), ai.spread)
        # (from the eye, so it goes where the reticle is; it is drawn from the weapon)
        bolts.push(Bolt(o + d * 0.5, d * 52.0, ai.damage, ai.shield_damage, true, false, 3.0, from = gun_muzzle()))
        sfx(snd_caster, 0.5, random(0.95, 1.05))
        if g.heat >= 1.0:
            g.heat = 1
            g.vent = VENT
            sfx(snd_vent, 0.7)
    else if g.arm == int(Arm.rockets):
        you.kick += 0.03
        d = scatter(aim(), ai.spread)
        bolts.push(Bolt(o + d * 0.6, d * 32.0, ai.damage, ai.shield_damage, true, false, 4.0, from = gun_muzzle(), rocket = true))
        sfx(snd_rocket, 0.8)
    else if g.arm == int(Arm.shotgun):
        you.kick += 0.045
        # pellets: what each raider takes summed (full to 30 m, falling to 0.6 at 60), and it is
        # knocked back
        took = fill(0.0, foes.len())
        loop k in 0..PELLETS:
            d = scatter(aim(), ai.spread * sqrt(random(0.0, 1.0)))
            far = ray_world(o, d, 90)
            h = ray_foes(o, d, far, 0.0)
            stop_at = o + d * far
            if h.0 >= 0:
                stop_at = o + d * h.1
                took[h.0] += clamp(1.0 - (f64(h.1) - 30.0) / 75.0, 0.6, 1.0)
                burst(stop_at, 2, 3.0, vec4(1.0, 0.85, 0.5, 1), 0.2, 0.02, false)
            else if far < 89.0: burst(stop_at, 1, 2.5, vec4(0.9, 0.9, 0.8, 1), 0.25, 0.02)
            tracers.push(Tracer(gun_muzzle() + d * 1.0, stop_at, 0.04, 0.01))
        struck = false
        loop i in 0.. and t in took:
            if t > 0.0:
                struck = true
                foes[i].body.vel += normalize(flat(foe_center(foes[i]) - o)) * f32(12.0 * t / f64(PELLETS))
                hurt_foe(i, ai.damage * t, ai.shield_damage * t, false, "shot")
        if struck: hits += 1
        sfx(snd_shotgun, 0.8, random(0.95, 1.05))
    else:
        # hitscan: the pistol takes heads off unshielded raiders
        spread = ai.spread + g.bloom
        if zoomed: spread *= 0.5
        d = scatter(aim(), spread)
        g.bloom = min(g.bloom + ai.bloom, ai.bloom_max)
        you.kick += [0.012, 0.006, 0.0, 0.0][g.arm]
        far = ray_world(o, d, 200)
        h = ray_foes(o, d, far, 0.0)
        # (a near miss still counts, just: bullet magnetism, as every shooter has)
        if h.0 < 0: h = ray_foes(o, d, far, 0, 0.012)
        stop_at = o + d * far
        if h.0 >= 0:
            stop_at = o + d * h.1
            hits += 1
            hurt_foe(h.0, ai.damage, ai.shield_damage, h.2, "shot", ai.head)
            c = vec4(1.0, 0.85, 0.5, 1)
            if foes[h.0].shield > 0.0: c = vec4(1.0, 0.7, 0.3, 1)
            burst(stop_at, 3, 3.0, c, 0.25, 0.025, false)
        else if far < 199.0: burst(stop_at, 2, 2.5, vec4(0.9, 0.9, 0.8, 1), 0.3, 0.02)
        tracers.push(Tracer(gun_muzzle() + d * 1.0, stop_at, 0.05, 0.015))
        if g.arm == int(Arm.pistol): sfx(snd_pistol, 0.6, random(0.95, 1.05))
        else: sfx(snd_rifle, 0.55, random(0.95, 1.05))
    g.flash = 0.035
    guns[held] = g
    if guns[held].ammo == 0 and guns[held].reserve > 0: hint("reload", "Out of rounds: {key_of("Reload")} reloads")

start_reload = ():
    global zoomed
    g = guns[held]
    if g.arm < 0 or g.arm == int(Arm.caster) or g.reload > 0.0 or g.reserve <= 0 or g.ammo >= arm_info(g).mag: return
    guns[held].reload = arm_info(g).reload
    zoomed = false
    sfx(snd_clack, 0.6)

throw_grenade = ():
    global throw_time
    grenades -= 1
    throw_time = 0.45
    d = aim()
    nades.push(Nade(eye() + d * 0.5 + right_of(you.yaw) * 0.2 - vec3(0, 0.15, 0), d * 15.0 + vec3(0, 3.5, 0) + you.body.vel * 0.5))
    sfx(snd_whoosh, 0.6)

# a melee strike: at a raider in reach (lunging at it from a little further), else the air
strike = ():
    global melee_time
    melee_time = 0.8
    sfx(snd_swing, 0.6)
    tgt = -1
    bd = LUNGE_REACH
    loop i in 0.. and f in foes:
        if not alive(f): continue
        to = foe_center(f) - eye()
        d = f64(length(flat(to)))
        if d > bd or abs(f64(foe_center(f).y) - f64(eye().y)) > 2.2: continue
        if abs(wrap(yaw_of(to) - you.yaw)) > 0.45: continue
        if not clear_line(eye(), foe_center(f)): continue
        tgt = i
        bd = d
    if tgt < 0: return
    you.lunge = tgt
    you.lunge_time = 0.25

land_strike = (i: int):
    you.lunge = -1
    f = foes[i]
    sfx_at(snd_smack, foe_center(f), 1.0)
    burst(foe_center(f), 12, 4.0, vec4(1.0, 0.8, 0.5, 1), 0.4, 0.05)
    hurt_foe(i, 70.0, 70.0, false, "melee")
    foes[i].body.vel += normalize(flat(foe_center(f) - eye())) * 6.0 + vec3(0, 2, 0)
    foes[i].flinch = 0.3
    you.shake = max(you.shake, 0.3)

# the weapon's muzzle, in the world (for tracers and bolts as they are drawn)
gun_muzzle = () -> vec3:
    o = eye()
    g = guns[max(held, 0)]
    l = 0.6
    if g.arm >= 0: l = -f64(HOLD_AT[g.arm].z) + arm_length[g.arm] * 0.5 * FP
    o + aim() * f32(l) + right_of(you.yaw) * 0.15 - look_up() * 0.14

look_up = () -> vec3: cross(right_of(you.yaw), aim())

step_player = (c: Controls, dt: f64):
    global alarm, held, recharge_id, swap_time, zoom_k, zoomed
    if not you.alive:
        you.body.vel.x *= 0.9
        you.body.vel.z *= 0.9
        move_body(you.body, dt)
        return
    # walking: quick to start and stop on the ground, a third of that in the air
    fw = flat(look_dir(you.yaw, 0.0))
    want = (fw * c.move.y + right_of(you.yaw) * c.move.x) * f32(RUN)
    rate = ACCEL
    if not you.body.grounded: rate = ACCEL / 3.0
    hv = flat(you.body.vel)
    dv = want - hv
    l = f64(length(dv))
    if l > rate * dt: dv = dv * f32(rate * dt / l)
    you.body.vel += dv
    if you.lunge >= 0:
        f = foes[you.lunge]
        to = flat(foe_center(f) - you.body.pos)
        you.lunge_time -= dt
        if not alive(f) or you.lunge_time <= 0.0 or length(to) < f32(1.2 + f64(info(f).radius)):
            if alive(f) and length(to) < f32(MELEE_REACH + f64(info(f).radius)): land_strike(you.lunge)
            you.lunge = -1
        else: you.body.vel = normalize(to) * 13.0 + vec3(0, you.body.vel.y, 0)
    # jumping (a moment after leaving an edge, or pressed a moment before landing, still counts)
    you.jump_wait += dt
    if c.jump: you.jump_wait = 0
    if you.body.grounded: you.air = 0
    else: you.air += dt
    if you.jump_wait < 0.1 and you.air < 0.08 and you.body.vel.y <= 0.5:
        you.body.vel.y = f32(JUMP)
        you.body.grounded = false
        you.air = 1
        you.jump_wait = 1
    was = you.body.pos
    move_body(you.body, dt)
    if you.body.grounded:
        before = you.walked
        you.walked += f64(length(flat(you.body.pos - was)))
        if floor(you.walked / 1.8) != floor(before / 1.8): sfx(snd_step, 0.6, random(0.85, 1.15))
    # the shield: back after a few quiet seconds
    you.calm += dt
    if you.calm >= RECHARGE_WAIT and you.shield < SHIELD:
        if you.shield <= 0.0 or recharge_id < 0:
            if recharge_id < 0 and not quiet: recharge_id = play(snd_charge, 0.5 * sound_volume)
        you.shield = min(SHIELD, you.shield + RECHARGE * dt)
    if you.shield >= SHIELD: recharge_id = -1
    if you.shield <= 0.0:
        alarm -= dt
        if alarm <= 0.0:
            alarm = 0.4
            sfx(snd_beep, 0.6)
    # the weapons
    loop mut g in guns:
        g.wait -= dt
        g.flash -= dt
        if g.wait < -0.12: g.bloom = max(0.0, g.bloom - 0.09 * dt)
        if g.vent > 0.0:
            g.vent -= dt
            g.heat = max(0.0, g.vent / VENT)
        else if g.wait < -0.25: g.heat = max(0.0, g.heat - 0.6 * dt)
    g = guns[held]
    if g.reload > 0.0:
        g.reload -= dt
        if g.reload <= 0.0:
            n = min(arm_info(g).mag - g.ammo, g.reserve)
            g.ammo += n
            g.reserve -= n
            sfx(snd_clack, 0.7, 1.3)
        guns[held] = g
    swap_time -= dt
    melee_time -= dt
    throw_time -= dt
    you.kick = max(0.0, you.kick - you.kick * 12.0 * dt)
    busy = swap_time > 0.0 or melee_time > 0.5 or throw_time > 0.2
    # zoom: in and out with a press; any hit, a reload, a swap or a throw takes it away
    zk = arm_info(guns[held]).zoom
    if c.zoom and zk > 1.0 and not busy and guns[held].reload <= 0.0:
        zoomed = not zoomed
        sfx(snd_tick, 0.5, 0.7)
    if zk <= 1.0 or busy: zoomed = false
    if zoomed: zoom_k = min(1.0, zoom_k + dt * 8.0)
    else: zoom_k = max(0.0, zoom_k - dt * 8.0)
    pick_up(c, dt)
    if c.swap and swap_time <= 0.0 and guns[1 - held].arm >= 0:
        guns[held].reload = 0
        held = 1 - held
        swap_time = 0.3
        zoomed = false
        sfx(snd_clack, 0.5, 0.8)
    else if c.melee and melee_time <= 0.0:
        zoomed = false
        strike()
    else if c.grenade and grenades > 0 and throw_time <= 0.0 and not busy:
        zoomed = false
        throw_grenade()
    else if c.reload and not busy: start_reload()
    else if not busy and guns[held].arm >= 0 and guns[held].wait <= 0.0 and guns[held].reload <= 0.0:
        # (a single-shot weapon fires again while held, a little slower than pressing)
        if c.fire_pressed or (c.fire and (arm_info(guns[held]).auto or guns[held].wait <= -0.12)): fire()

# Weapons to pick up: the same kind as one carried gives its rounds (walking over it); another
# is taken by holding the key: into an empty hand, or in place of the one held (left on the deck).
near_pick = -1                  # the one in reach (the prompt says so)
pick_time = 0.0                 # how long the key has been held for it
reload_later = false            # (a pad's X is reload and pick up: reload when let go quickly)

pick_up = (c: Controls, dt: f64):
    global held, near_pick, pick_time, pickups, reload_later, swap_time, zoomed
    near_pick = -1
    bd = REACH
    loop i in 0.. and k in pickups:
        d = f64(length(flat(k.pos - you.body.pos)))
        if abs(f64(k.pos.y - you.body.pos.y)) > 1.4: continue
        # (rounds for a weapon carried)
        if d < 1.2:
            loop mut g in guns:
                if g.arm != k.gun.arm: continue
                ai = arm_info(g)
                if g.arm == int(Arm.caster):
                    room = ai.mag - g.ammo
                    n = min(room, pickups[i].gun.ammo)
                    if n > 0:
                        g.ammo += n
                        pickups[i].gun.ammo -= n
                        popup("+{n} CHARGE")
                        sfx(snd_pickup, 0.6)
                else:
                    room = ai.mag + ai.reserve - g.ammo - g.reserve
                    n = min(room, pickups[i].gun.ammo + pickups[i].gun.reserve)
                    if n > 0:
                        g.reserve += n
                        take = min(n, pickups[i].gun.reserve)
                        pickups[i].gun.reserve -= take
                        pickups[i].gun.ammo -= n - take
                        popup("+{n} {ai.name} ROUNDS")
                        sfx(snd_pickup, 0.6)
        if pickups[i].gun.ammo + pickups[i].gun.reserve <= 0: continue
        if guns[0].arm == k.gun.arm or guns[1].arm == k.gun.arm: continue
        if d < bd:
            bd = d
            near_pick = i
    # (emptied: gone; a rack's fills again later)
    loop k in pickups:
        if k.rack >= 0 and k.gun.ammo + k.gun.reserve <= 0: racks[k.rack].wait = 30.0
    pickups = [loop k in pickups if k.gun.ammo + k.gun.reserve > 0: k]
    if near_pick >= pickups.len(): near_pick = -1
    if near_pick >= 0: hint("pick", "Hold {key_of("Pick up")} to take a weapon")
    if near_pick < 0 or not c.pick:
        pick_time = 0
        return
    pick_time += dt
    if pick_time < HOLD: return
    pick_time = 0
    k = pickups[near_pick]
    slot = held
    if guns[1 - held].arm < 0: slot = 1 - held
    else: drop(guns[held], you.body.pos + look_dir(you.yaw, 0.0) * 0.6)
    pickups.remove_at(near_pick)
    if k.rack >= 0: racks[k.rack].wait = 30.0
    guns[slot] = k.gun
    held = slot
    swap_time = 0.3
    zoomed = false
    reload_later = false
    sfx(snd_pickup, 0.8)
    near_pick = -1

# racks fill again: by time, or at the start of the waves they belong to
step_racks = (dt: f64, new_wave: bool):
    loop i in 0.. and r in racks:
        if wave < r.from_wave: continue
        has = false
        loop k in pickups:
            if k.rack == i: has = true
        if has: continue
        fill = false
        if r.every == 0:
            racks[i].wait -= dt
            fill = racks[i].wait <= 0.0 or new_wave
        else: fill = new_wave and (wave - r.from_wave) % r.every == 0
        if fill:
            pickups.push(Pickup(gun_of(r.arm), r.pos + vec3(0, 0.9, 0), r.yaw, 1e9, i))
            if r.every > 0:
                popup("{arms[int(r.arm)].name} READY", false)
                if r.arm == .shotgun: hint("shotgun", "A shotgun is on its rack, across the deck")
                if r.arm == .rockets: hint("rockets", "Rockets are on their rack, across the deck")

# ---------------- raiders: what they do ----------------
# A goal near `from`: a walkable cell (or a cover cell) scored by how far it is from the
# player (wanting lo to hi m), whether it sees the player (wanted or not), and how crowded it is.
pick_goal = (f: Foe, lo: f64, hi: f64, sight: int, cover: bool, target: vec3 = chest()) -> vec3:
    spot = f.body.pos
    spot_score = -1000000.0
    loop k in 0..14:
        c = 0
        if cover and cover_cells.len() > 0: c = cover_cells[random_int(0, cover_cells.len())]
        else:
            p = f.body.pos + v3(random(-12.0, 12.0), 0, random(-12.0, 12.0))
            c = cell_of(p)
        if not grid.open[c]: continue
        cp = cell_pos(c)
        d = f64(length(flat(cp - target)))
        s = -f64(length(flat(cp - f.body.pos))) * 0.3
        if d < lo: s -= (lo - d) * 3.0
        if d > hi: s -= (d - hi) * 2.0
        if sight != 0:
            sees = clear_line(cp + vec3(0, 1.5, 0), target + vec3(0, 0.4, 0))
            if sees == (sight > 0): s += 10.0
        loop o in foes:
            if alive(o) and length(flat(o.goal - cp)) < 2.5: s -= 6.0
        if s > spot_score:
            spot_score = s
            spot = cp
    spot

fire_bolt = (f: mut Foe):
    m = muzzle(f)
    target = chest() + v3(0, random(-0.3, 0.4), 0)
    if f.kind == .warden: target += flat(you.body.vel) * f32(f64(length(target - m)) / 24.0 * 0.5)
    d = normalize(target - m)
    speed = 17.0
    dmg = 6.0
    spread = 0.07
    if f.kind == .warden:
        speed = 24.0
        dmg = 6.0
        spread = 0.045
    d = scatter(d, spread)
    bolts.push(Bolt(m, d * f32(speed), dmg * fierce(), dmg * fierce(), false, false, 4.0, from = m, by = int(f.kind)))
    sfx_at(snd_bolt, m, 0.8, random(0.9, 1.1) * (1.2 - 0.25 * f64(int(f.kind))))
    f.blip = 0
    f.recoil = 0

# a lobber's shell: up and over, landing where the player is headed in 1.3 s
lob_shell = (f: mut Foe):
    m = muzzle(f)
    t = 1.3
    target = you.body.pos + flat(you.body.vel) * 0.6 + v3(random(-1.5, 1.5), 0, random(-1.5, 1.5))
    target.y = floor_under(target, 0.1)
    v = (target - m) * f32(1.0 / t) + vec3(0, f32(0.5 * GRAVITY * t), 0)
    bolts.push(Bolt(m, v, 45.0 * fierce(), 45.0, false, true, 3.0, target, m))
    sfx_at(snd_shell, m, 1.0)
    f.blip = 0

firing = 0                      # raiders shooting (or winding up) now

think = (f: mut Foe, dt: f64):
    ki = info(f)
    if f.dead >= 0.0:
        f.dead += dt
        f.body.vel.x *= f32(0.9)
        f.body.vel.z *= f32(0.9)
        move_body(f.body, dt)
        return
    f.calm += dt
    if f.sees or f.burst > 0 or f.windup > 0.0: f.aiming = min(1.0, f.aiming + dt * 4.0)
    else: f.aiming = max(0.0, f.aiming - dt * 2.0)
    f.flinch -= dt
    f.dodge -= dt
    f.dodge_wait -= dt
    f.melee_wait -= dt
    f.shield_flash -= dt
    f.shield_pop -= dt
    f.mood_time -= dt
    f.think -= dt
    f.blip += dt
    f.strafe_time -= dt
    f.recoil += dt
    if ki.shield > 0.0 and f.calm > 4.0 and f.shield < ki.shield:
        if f.shield <= 0.0: f.shield_flash = 0.4
        f.shield = min(ki.shield, f.shield + 30.0 * dt)
    # seeing the player (checked a few times a second)
    f.look -= dt
    if f.look <= 0.0:
        f.look = random(0.15, 0.3)
        f.sees = you.alive and clear_line(foe_eye(f), eye())
    if f.sees:
        f.seen += dt
        f.unseen = 0
    else:
        f.seen = 0
        f.unseen += dt
    to = flat(chest() - f.body.pos)
    dist = f64(length(to))
    # moods
    if f.mood == .panic and f.mood_time <= 0.0:
        f.mood = .roam
        f.think = 0
    if f.mood == .retreat and f.shield >= ki.shield:
        f.mood = .roam
        f.think = 0
    if you.alive and f.mood != .panic and f.mood != .retreat:
        # close up, wardens and lobbers go for a melee strike
        if f.kind != .skitter and dist < 4.0: f.mood = .charge
        else if f.mood == .charge and dist > 6.0:
            f.mood = .roam
            f.think = 0
    # where to go
    if not you.alive:
        if f.think <= 0.0:
            f.think = random(2.0, 5.0)
            f.goal = cell_pos(cell_of(f.body.pos + v3(random(-10.0, 10.0), 0, random(-10.0, 10.0))))
    else if f.mood == .panic:
        if f.think <= 0.0:
            f.think = 0.8
            f.goal = pick_goal(f, 18.0, 40.0, -1, false)
    else if f.mood == .retreat:
        if f.think <= 0.0:
            f.think = 2.0
            f.goal = pick_goal(f, 10.0, 30.0, -1, true)
    else if f.mood == .charge: f.goal = you.body.pos
    else if f.unseen > 6.0:
        # hunting: toward the player until it sees them again
        f.goal = you.body.pos
        if f.sees: f.unseen = 0
    else if f.think <= 0.0:
        if f.kind == .skitter:
            f.think = random(1.5, 3.0)
            f.goal = pick_goal(f, 7.0, 14.0, 1, false)
        else if f.kind == .warden:
            f.think = random(2.5, 4.5)
            f.goal = pick_goal(f, 8.0, 20.0, 1, true)
        else:
            f.think = random(4.0, 7.0)
            f.goal = pick_goal(f, 14.0, 24.0, 0, false)
    # moving: along the path, strafing a little once there, dodging when aimed at
    speed = ki.speed
    if f.mood == .panic: speed *= 1.3
    if f.mood == .charge: speed *= 1.25
    way = toward(f.body.pos, f.goal)
    want = flat(way - f.body.pos)
    if length(want) > 0.3: want = normalize(want) * f32(speed)
    else:
        if f.strafe_time <= 0.0:
            f.strafe_time = random(0.7, 1.6)
            f.strafe = -f.strafe
        side = vec3(0, 0, 0)
        if dist > 0.1: side = normalize(cross(to, vec3(0, 1, 0)))
        want = side * f.strafe * f32(speed * 0.45)
        if f.kind == .lobber: want = vec3(0, 0, 0)
    if f.kind == .warden and you.alive and f.dodge_wait <= 0.0 and f.sees and dist < 25.0 and f.shield > 0.0:
        off = abs(wrap(yaw_of(f.body.pos - you.body.pos) - you.yaw))
        if off < 0.06 and (guns[held].wait > 0.0 or throw_time > 0.0) and chance(0.5):
            f.dodge = 0.5
            f.dodge_wait = 3.0
            f.dodge_dir = f32(random_int(0, 2) * 2 - 1)
    # (a dodge: a crouch for 0.15 s, then a quick sidestep)
    if f.dodge > 0.0 and f.dodge < 0.35: want = normalize(cross(to, vec3(0, 1, 0))) * f.dodge_dir * 7.0
    if f.flinch > 0.0 or f.windup > 0.0 or f.swing > 0.0 or f.dodge > 0.35: want = want * 0.2
    # keeping apart
    loop o in foes:
        if not alive(o): continue
        od = flat(f.body.pos - o.body.pos)
        ol = length(od)
        if ol > 0.01 and ol < 1.6: want += od * f32(2.0 * (1.6 - f64(ol)) / f64(ol))
    grip = 18.0
    if not f.body.grounded: grip = 2.0
    dv = want - flat(f.body.vel)
    l = f64(length(dv))
    if l > grip * dt: dv = dv * f32(grip * dt / l)
    f.body.vel += dv
    was = f.body.pos
    move_body(f.body, dt)
    moved = f64(length(flat(f.body.pos - was))) / dt
    f.gait += moved * dt
    if moved > 2.5: f.blip = 0
    # facing: the player when in sight, else the way it walks
    face = f.yaw
    if f.sees and f.mood != .panic: face = yaw_of(to)
    else if moved > 0.5: face = yaw_of(flat(f.body.pos - was))
    f.yaw += wrap(face - f.yaw) * min(1.0, 8.0 * dt)
    # striking: an arm raised for 0.45 s (time to back off), then the blow, if still in reach
    reach = 2.0 + f64(ki.radius)
    level = abs(f64(you.body.pos.y - f.body.pos.y)) < 1.2
    if f.swing > 0.0:
        f.swing -= dt
        if f.swing <= 0.0:
            f.melee_wait = 1.3
            if dist < reach + 0.3 and level and clear_line(foe_center(f), chest()):
                dmg = 25.0
                if wave > 3: dmg = 35.0
                if f.kind == .lobber: dmg = 40.0
                hurt(dmg * fierce(), f.body.pos, int(f.kind))
                you.body.vel += normalize(to) * 5.0 + vec3(0, 2.5, 0)
                sfx_at(snd_smack, f.body.pos, 1.0, 0.7)
        return
    if f.mood == .charge and f.melee_wait <= 0.0 and dist < reach and level and f.sees:
        f.swing = 0.45
        f.burst = 0
        sfx_at(snd_windup, f.body.pos, 1.0)
        return
    # shooting: bursts (only a few raiders at once), after a moment to react
    if f.burst > 0:
        f.shot_wait -= dt
        if f.shot_wait <= 0.0:
            fire_bolt(f)
            f.burst -= 1
            f.shot_wait = 0.16
            if f.kind == .warden: f.shot_wait = 0.13
            if f.burst == 0: f.fire_wait = random(1.3, 2.1) / fierce()
        return
    if f.windup > 0.0:
        f.windup -= dt
        if f.windup <= 0.0:
            lob_shell(f)
            f.fire_wait = random(2.8, 3.6) / fierce()
        return
    f.fire_wait -= dt
    if f.fire_wait > 0.0 or not you.alive or f.mood == .panic or f.mood == .retreat or f.flinch > 0.0: return
    if firing >= MAX_FIRING or (wave <= 4 and firing >= 2) or (wave == 1 and firing >= 1): return
    react = 0.7
    if f.kind == .warden: react = 0.5
    if f.kind == .lobber:
        if dist > 6.0 and dist < 34.0 and (f.sees or f.seen > 0.0 or chance(0.3)):
            f.windup = 0.9
            firing += 1
        else: f.fire_wait = 0.5
        return
    if f.sees and f.seen > react and dist < 32.0:
        f.burst = 3
        if f.kind == .warden: f.burst = 4
        f.shot_wait = 0
        firing += 1

step_foes = (dt: f64):
    global firing, foes
    firing = 0
    loop f in foes:
        if alive(f) and (f.burst > 0 or f.windup > 0.0): firing += 1
    loop mut f in foes: think(f, dt)
    # (the fallen are cleared away, but not while a strike lunges at one of them by number)
    if you.lunge < 0: foes = [loop f in foes if f.dead < 4.2: f]

# ---------------- shots and grenades in flight ----------------
# the nearest distance between the segment a-b and the point p
seg_dist = (a: vec3, b: vec3, p: vec3) -> f32:
    ab = b - a
    l2 = dot(ab, ab)
    t: f32 = 0.0
    if l2 > 0.0: t = clamp(dot(p - a, ab) / l2, f32(0), f32(1))
    length(a + ab * t - p)

step_shots = (dt: f64):
    global bolts, nades
    loop mut b in bolts:
        b.life -= dt
        if b.lob: b.vel.y -= f32(GRAVITY * dt)
        a = b.pos
        e = a + b.vel * f32(dt)
        l = length(e - a)
        d = (e - a) * (1.0 / max(l, 0.0001))
        hit = ray_world(a, d, l)
        if b.rocket:
            # a rocket bursts on what it meets (a raider struck takes the full blast)
            h = ray_foes(a, d, hit, 0.15)
            at = a + d * hit
            if h.0 >= 0: at = a + d * h.1
            if h.0 >= 0 or hit < l:
                if h.0 >= 0: hits += 1
                blast(at - d * 0.2, 5.0, b.damage, true, 1.25)
                b.life = 0
                continue
            if chance(0.7): sparks.push(Spark(a, scatter(d * -1.0, 0.5) * 1.5, 0.6, 0.6, vec4(0.55, 0.55, 0.55, 1), 0.12, false))
        else if b.mine:
            h = ray_foes(a, d, hit, 0.1)
            if h.0 >= 0:
                hits += 1
                hurt_foe(h.0, b.damage, b.shield_damage, false, "shot")
                burst(a + d * h.1, 4, 3.5, vec4(0.4, 1.0, 0.95, 1), 0.35, 0.03, false)
                flash_at(a + d * h.1, vec3(0.3, 1.0, 0.9), 3.0, 0.12)
                b.life = 0
                continue
        else if not b.lob and you.alive:
            # raiders' bolts: the player is a capsule from knees to head
            # (only up to where it meets a wall: cover is cover)
            p = you.body.pos
            e2 = a + d * hit
            q = seg_dist(a, e2, p + vec3(0, 0.5, 0))
            q = min(q, seg_dist(a, e2, p + vec3(0, 1.0, 0)))
            q = min(q, seg_dist(a, e2, p + vec3(0, 1.5, 0)))
            if q < 0.45:
                hurt(b.damage, b.from, b.by)
                b.life = 0
                continue
        if hit < l:
            b.life = 0
            at = a + d * hit
            if b.lob: blast(at, 3.5, b.damage, false)
            else if b.mine: burst(at, 4, 3.0, vec4(0.4, 1.0, 0.95, 1), 0.35, 0.03, false)
            else: burst(at, 3, 3.0, vec4(1.0, 0.55, 0.3, 1), 0.3, 0.03, false)
            continue
        b.pos = e
    bolts = [loop b in bolts if b.life > 0.0: b]
    # grenades: they bounce, and go off a second after the first bounce
    loop mut n in nades:
        n.age += dt
        n.vel.y -= f32(GRAVITY * dt)
        a = n.pos
        e = a + n.vel * f32(dt)
        l = length(e - a)
        if l > 0.0:
            d = (e - a) * (1.0 / l)
            hit = ray_world(a, d, l + 0.12)
            if hit < l + 0.12:
                # bounce off whichever face it met (found by trying each axis alone)
                if ray_world(a, vec3(0, sign_of(d.y), 0), abs(e.y - a.y) + 0.12) < abs(e.y - a.y) + 0.12: n.vel.y = -n.vel.y * 0.35
                else if ray_world(a, vec3(sign_of(d.x), 0, 0), abs(e.x - a.x) + 0.12) < abs(e.x - a.x) + 0.12: n.vel.x = -n.vel.x * 0.5
                else: n.vel.z = -n.vel.z * 0.5
                n.vel = n.vel * 0.7
                if n.fuse < 0.0: n.fuse = 1.0
                if length(n.vel) > 2.0: sfx_at(snd_bounce, a, 0.6)
                e = a
        n.pos = e
        if n.fuse > 0.0:
            n.fuse -= dt
            if n.fuse <= 0.0: n.age = 99
        if n.age > 4.0 or n.pos.y < -3.0: n.age = 99
        if n.age >= 99.0: blast(n.pos, 5.0, 120.0, true)
    nades = [loop n in nades if n.age < 99.0: n]

sign_of = (x: f32) -> f32:
    if x < 0.0: return -1
    1

step_effects = (dt: f64):
    global flashes, hurt_from, popups, sparks, tracers
    loop mut s in sparks:
        s.life -= dt
        if s.falls: s.vel.y -= f32(GRAVITY * 0.6 * dt)
        s.vel = s.vel * f32(1.0 - 1.5 * dt)
        s.pos += s.vel * f32(dt)
        if s.pos.y < 0.0 and s.falls:
            s.pos.y = 0
            s.vel = s.vel * 0.3
    sparks = [loop s in sparks if s.life > 0.0: s]
    loop mut t in tracers: t.life -= dt
    tracers = [loop t in tracers if t.life > 0.0: t]
    loop mut f in flashes: f.life -= dt
    flashes = [loop f in flashes if f.life > 0.0: f]
    loop mut p in popups: p.age += dt
    popups = [loop p in popups if p.age < 2.5: p]
    loop mut h in hurt_from: h.1 = h.1 + dt
    hurt_from = [loop h in hurt_from if h.1 < 1.2: h]
    hit_mark -= dt
    kill_mark -= dt
    hint_time -= dt
    you.shake = max(0.0, you.shake - 2.0 * dt)

# one fixed step of the whole game
step = (c: Controls, dt: f64):
    global pickups
    if over: over_time += dt
    else: run_time += dt
    chain_time -= dt
    step_racks(dt, false)
    loop mut k in pickups: k.life -= dt
    pickups = [loop k in pickups if k.life > 0.0: k]
    step_player(c, dt)
    step_foes(dt)
    step_shots(dt)
    if not over: step_waves(dt)
    step_effects(dt)

bot_react = 0.35
bot_error = 0.02                # radians
bot_target = -1
bot_seen = 0.0
bot_dir = 1.0
bot_turn = 0.0
bot_goal = vec3(0, 0, 0)
bot_think = 0.0
bot_lost = 0.0

new_run = ():
    global between, bolts, bot_goal, bot_lost, bot_target, cause, chain, chain_time, damage_by, flashes, foes, grenades, guns, held, hit_mark, hits, hurt_from, kill_mark, kills, melee_time, nades, near_pick, over, over_time, pending, pick_time, pickups, popups, recharge_id, run_time, score, shots, sparks, swap_time, throw_time, tracers, warps, wave, you, zoom_k, zoomed
    # (on the platform, looking out over the deck)
    you = Player(Body(v3(0, 2, 3.5), vec3(0, 0, 0), RADIUS))
    you.yaw = PI
    guns = [gun_of(.pistol), Gun()]
    held = 0
    zoomed = false
    zoom_k = 0
    pickups = []
    loop mut r in racks: r.wait = 0
    near_pick = -1
    pick_time = 0
    grenades = 2
    foes = []
    bolts = []
    nades = []
    sparks = []
    warps = []
    popups = []
    hurt_from = []
    score = 0
    wave = 0
    pending = []
    between = 3.0
    chain = 0
    kills = 0
    shots = 0
    hits = 0
    run_time = 0
    over = false
    over_time = 0
    damage_by = [0, 0, 0, 0]
    cause = ""
    swap_time = 0
    melee_time = 0
    throw_time = 0
    chain_time = 0
    hit_mark = 0
    kill_mark = 0
    tracers = []
    flashes = []
    if recharge_id >= 0: stop(recharge_id)
    recharge_id = -1
    bot_target = -1
    bot_goal = vec3(0, 0, 0)
    bot_lost = 0

# ---------------- the autopilot (balance tests) ----------------
# Fights like a steady player: aims at the nearest raider it can see (stripping shields with the
# caster), with a reaction time and aiming error; strafes, backs off when they come close, and
# takes cover when its shield is down.
autopilot = (dt: f64) -> Controls:
    global bot_dir, bot_goal, bot_lost, bot_seen, bot_target, bot_think
    c = Controls(vec2(0, 0))
    tgt = -1
    bd = 1000.0
    loop i in 0.. and f in foes:
        if not alive(f): continue
        d = f64(length(foe_center(f) - eye()))
        if d < bd and clear_line(eye(), foe_center(f)):
            bd = d
            tgt = i
    if tgt != bot_target:
        bot_target = tgt
        bot_seen = 0
    bot_seen += dt
    # (which weapon: a caster for shields; else one with rounds)
    rounds = (g: Gun) -> int: g.ammo + g.reserve
    usable = (g: Gun) -> bool: g.arm >= 0 and rounds(g) > 0 and g.vent <= 0.0
    want = held
    if not usable(guns[held]) and usable(guns[1 - held]): want = 1 - held
    if tgt >= 0:
        f = foes[tgt]
        loop i in 0..2:
            if guns[i].arm == int(Arm.caster) and usable(guns[i]) and f.shield > 0.0: want = i
            if guns[i].arm != int(Arm.caster) and usable(guns[i]) and f.shield <= 0.0 and guns[held].arm == int(Arm.caster): want = i
        # (the shotgun near, else the other)
        near = f64(length(foe_center(f) - eye())) < 30.0
        if guns[want].arm == int(Arm.shotgun) and not near and usable(guns[1 - want]): want = 1 - want
        else if guns[1 - want].arm == int(Arm.shotgun) and near and usable(guns[1 - want]) and f.shield <= 0.0: want = 1 - want
    if want != held and swap_time <= 0.0: c.swap = true
    if tgt >= 0:
        f = foes[tgt]
        point = foe_center(f) + vec3(0, 0.3, 0)
        to = point - eye()
        ty = yaw_of(to) + sin(run_time * 3.1) * bot_error
        tp = atan2(f64(to.y), f64(length(flat(to)))) + cos(run_time * 2.3) * bot_error
        k = min(1.0, 10.0 * dt)
        if bot_seen > bot_react:
            you.yaw += wrap(ty - you.yaw) * k
            you.pitch += (tp - you.pitch) * k
            off = abs(wrap(ty - you.yaw))
            if off < 0.04 + bot_error:
                c.fire = true
                c.fire_pressed = true
        if bd < 2.5 and melee_time <= 0.0: c.melee = true
        # a grenade at two or more close together, not too near
        if grenades > 0 and bd > 8.0 and bd < 18.0 and bot_seen > 1.0:
            near = 0
            loop o in foes:
                if alive(o) and length(o.body.pos - f.body.pos) < 4.0: near += 1
            if near >= 3 or (near >= 2 and chance(0.01)): c.grenade = true
    gh = guns[held]
    if gh.arm >= 0 and gh.arm != int(Arm.caster) and gh.ammo < arm_info(gh).mag / 3 and (tgt < 0 or gh.ammo == 0): c.reload = true
    # weapons: to a pickup when a hand is empty or out of rounds (taking it when there)
    fetch = -1
    if not usable(guns[0]) or not usable(guns[1]):
        nd = 30.0
        loop i in 0.. and k in pickups:
            # (racks first: a rifle beats a caster)
            d = f64(length(k.pos - you.body.pos))
            if k.rack >= 0: d -= 12.0
            if d < nd and guns[0].arm != k.gun.arm and guns[1].arm != k.gun.arm:
                nd = d
                fetch = i
    # (or to a rack of the weapon held, for its rounds, when they run low)
    if fetch < 0 and gh.arm >= 0 and gh.arm != int(Arm.caster) and gh.reserve < arm_info(gh).mag:
        loop i in 0.. and k in pickups:
            if k.gun.arm == gh.arm and f64(length(k.pos - you.body.pos)) < 30.0: fetch = i
    if fetch >= 0 and (tgt < 0 or you.shield > SHIELD * 0.5):
        bot_goal = pickups[fetch].pos
        c.pick = near_pick == fetch
    # moving
    bot_think -= dt
    if bot_think <= 0.0:
        bot_think = random(1.0, 2.0)
        bot_dir = -bot_dir
        if you.shield < SHIELD * 0.4 and tgt >= 0:
            # cover: somewhere out of sight of what it fights
            fake = Foe(.skitter, Body(you.body.pos, vec3(0, 0, 0), RADIUS))
            bot_goal = pick_goal(fake, 0.0, 30.0, -1, true, foe_eye(foes[tgt]) - vec3(0, 0.4, 0))
        else: bot_goal = vec3(0, 0, 0)
    world = vec3(0, 0, 0)
    if tgt < 0: bot_lost += dt
    else: bot_lost = 0
    if bot_lost > 3.0:
        # nothing in sight for a while: toward the nearest raider
        nd = 1000.0
        loop f in foes:
            if alive(f) and f64(length(f.body.pos - you.body.pos)) < nd:
                nd = f64(length(f.body.pos - you.body.pos))
                bot_goal = f.body.pos
        if nd < 1000.0: world = normalize(flat(toward(you.body.pos, bot_goal) - you.body.pos) + vec3(0.001, 0, 0))
    else if fetch >= 0 and length(bot_goal) > 0.0:
        world = normalize(flat(toward(you.body.pos, bot_goal) - you.body.pos) + vec3(0.001, 0, 0))
    else if length(bot_goal) > 0.0 and you.shield < SHIELD:
        world = normalize(flat(toward(you.body.pos, bot_goal) - you.body.pos) + vec3(0.001, 0, 0))
    else if tgt >= 0:
        to = flat(foe_center(foes[tgt]) - you.body.pos)
        side = normalize(cross(to, vec3(0, 1, 0)))
        world = side * f32(bot_dir)
        if bd < 7.0: world -= normalize(to)
        if bd > 18.0: world += normalize(to) * 0.6
    if length(world) > 0.0:
        world = normalize(world)
        c.move = vec2(dot(world, right_of(you.yaw)), dot(world, flat(look_dir(you.yaw, 0.0))))
    c

# ---------------- the platform, drawn ----------------
const IVORY = vec4(0.9, 0.86, 0.78, 1)
const SLATE = vec4(0.42, 0.48, 0.54, 1)
const DECK = vec4(0.25, 0.31, 0.41, 1)
const TEAL = vec4(0.25, 0.95, 0.9, 1)
const AMBER = vec4(1.0, 0.55, 0.2, 1)

# ---------------- the sky and the sea ----------------
# Late afternoon: the sun over the sea at the left of where a run starts looking.
# The sky is a picture made at the start (a gradient, the sun's glow, clouds): the backdrop, and
# what the robots' and the platform's materials reflect. The sea is a shader of its own.
const SUN_DIR = vec3(-0.6, 0.62, 0.3)
const SUN_LIGHT = vec3(1.45, 1.22, 0.95)
const SKY_TOP = vec3(0.13, 0.33, 0.66)       # (the picture's colors, as on a screen)
const SKY_HAZE = vec3(0.68, 0.79, 0.88)        # the horizon away from the sun,
const SKY_GLOW = vec3(0.98, 0.86, 0.68)        # and toward it
const SEA_FAR = vec3(0.2, 0.36, 0.43)         # the sea in the picture, under the horizon
const SKY_BOUNCE = vec3(0.56, 0.56, 0.54)     # (under that: light from the deck)
const FOG = vec3(0.86, 0.96, 1.08)            # (as the simple lighting takes it: shown as the haze)

sky_tex = Texture(0, 0, 0)
sky_ready = false

sm = (e0: f64, e1: f64, x: f64) -> f64:
    t = clamp((x - e0) / (e1 - e0), 0.0, 1.0)
    t * t * (3.0 - 2.0 * t)

# the sky's color looking along d (as on a screen)
sky_color = (d: vec3) -> vec3:
    sun = normalize(SUN_DIR)
    y = f64(d.y)
    toward = f64(dot(normalize(vec3(d.x, 0, d.z)), normalize(vec3(sun.x, 0, sun.z)))) * 0.5 + 0.5
    horizon = mix(SKY_HAZE, SKY_GLOW, f32(pow(toward, 5.0)))
    sd = max(f64(dot(d, sun)), 0.0)
    if y < 0.0:
        # (below the horizon: the sea, far off, hazy at the horizon; further down, never seen
        # behind the sea, the light the deck throws back up, for the materials)
        c = mix(horizon, SEA_FAR, f32(sm(0.0, 0.06, -y)))
        return mix(c, SKY_BOUNCE, f32(sm(0.1, 0.45, -y)))
    c = mix(horizon, SKY_TOP, f32(pow(sm(0.0, 1.0, y), 0.55)))
    # the sun's glow, and the sun
    c = c + SKY_GLOW * f32(pow(sd, 6.0) * 0.28 + pow(sd, 60.0) * 0.3)
    # clouds: a layer overhead, seen in perspective (thinning out toward the horizon)
    t = 1.0 / (y + 0.09)
    px = f64(d.x) * t * 1.3 + 4.0
    pz = f64(d.z) * t * 1.3
    n = fbm(px, pz, 5)
    cover = sm(0.5, 0.78, n) * sm(0.01, 0.16, y)
    if cover > 0.0:
        # (lit on the side toward the sun: the density a little that way)
        n2 = fbm(px + f64(sun.x) * 0.12, pz + f64(sun.z) * 0.12, 5)
        lit = clamp(0.6 + (n - n2) * 5.0, 0.0, 1.0)
        shade = mix(vec3(0.58, 0.63, 0.72), vec3(1.0, 0.95, 0.88), f32(lit))
        shade = shade + SKY_GLOW * f32(pow(sd, 4.0) * 0.35)
        c = mix(c, shade, f32(cover * 0.92))
    if sd > 0.99995: c = vec3(1, 1, 1)
    clamp(c, vec3(0, 0, 0), vec3(1, 1, 1))

make_sky = ():
    global sky_ready, sky_tex
    sky_ready = true
    w = 1024
    h = 512
    img = image(w, h)
    # (each row on a thread)
    rows = parallel_range(h, (y: int) -> vec3[]:
        th = PI * (f64(y) + 0.5) / f64(h)
        row: vec3[]
        loop x in 0..w:
            ph = (f64(x) + 0.5) / f64(w) * TAU - PI
            row.push(sky_color(v3(cos(ph) * sin(th), cos(th), sin(ph) * sin(th))))
        row
    )
    loop y in 0..h:
        loop x in 0..w: img.set(x, y, vec4(rows[y][x], 1))
    sky_tex = texture(img)

# the sea: waves (only in how the light falls), the sky in them, the sun's glitter, foam round
# the platform's legs
struct SeaParams:
    view_proj: mat4
    cam: vec3
    sun_dir: vec3
    sun_color: vec3
    fog_color: vec3
    fog: vec2
    time: f32
    sky: Texture
    legs: vec4[8]               # (x, z, radius)

struct SeaOut:
    pos: vec4
    world: vec3

const SEA_Y = -4.0

sea_vs = (v: Vertex3D, u: SeaParams) -> SeaOut:
    w = vec3(v.pos.x, f32(SEA_Y), v.pos.z) + vec3(u.cam.x, 0, u.cam.z)
    SeaOut(u.view_proj * vec4(w, 1), w)

# (in shaders: to and from linear light, near enough, and cheap for the software renderer)
lin = (c: vec3) -> vec3: c * c
shown = (c: vec3) -> vec3: vec3(sqrt(c.x), sqrt(c.y), sqrt(c.z))

# the sky picture's light along d
sky_at = (tex: Texture, d: vec3) -> vec3:
    u = atan2(d.z, d.x) / 6.28318531 + 0.5
    v = acos(clamp(d.y, -1.0, 1.0)) / 3.14159265
    lin(sample(tex, vec2(u, clamp(v, 0.002, 0.998))).xyz)

swell = (p: vec2, dir: vec2, k: f32, amp: f32, t: f32) -> vec2:
    dir * (cos(dot(p, dir) * k + t) * amp * k)

sea_fs = (i: SeaOut, u: SeaParams) -> vec4:
    p = vec2(i.world.x, i.world.z)
    t = u.time
    to_cam = u.cam - i.world
    dist = length(to_cam)
    v = to_cam / dist
    # the surface's slope: long swells and shorter chop, the chop fading with distance
    far = 1.0 / (1.0 + dist / 90.0)
    g = swell(p, vec2(0.8, 0.6), 0.16, 0.2, t * 1.1) + swell(p, vec2(-0.45, 0.89), 0.23, 0.12, t * 1.4) + swell(p, vec2(0.31, -0.95), 0.37, 0.05, t * 1.9)
    near = clamp(1.0 - dist / 200.0, 0.0, 1.0)
    g = g * far + (swell(p, vec2(0.96, -0.28), 0.9, 0.03, t * 2.6) + swell(p, vec2(-0.7, -0.71), 1.3, 0.02, t * 3.1) + swell(p, vec2(0.2, 0.98), 2.1, 0.008, t * 4.0)) * near
    n = normalize(vec3(-g.x, 1.0, -g.y))
    nv = max(dot(n, v), 0.0)
    r = n * (2.0 * dot(n, v)) - v
    r.y = abs(r.y)
    sky = sky_at(u.sky, r)
    grazing = (1.0 - nv) * (1.0 - nv)
    fres = 0.02 + 0.6 * grazing * grazing
    l = normalize(u.sun_dir)
    # the water's own color: deep blue-green, lighter where a wave faces the sun
    body = vec3(0.012, 0.07, 0.1) + vec3(0.02, 0.1, 0.09) * max(dot(n, l), 0.0)
    c = body * (1.0 - fres) + sky * fres
    # the sun's glitter
    hv = normalize(l + v)
    c = c + u.sun_color * (pow(max(dot(n, hv), 0.0), 380.0) * 6.0)
    # foam round the legs
    foam: f32 = 0.0
    if abs(p.x) < 25.0 and abs(p.y) < 23.0:
        loop k in [0..8):
            lg = u.legs[k]
            d = length(p - vec2(lg.x, lg.y)) - lg.z
            if d < 2.0 and d > -0.5:
                ripple = 0.5 + 0.5 * sin(d * 7.0 - t * 3.0 + p.x * 0.7)
                foam = max(foam, (1.0 - d / 2.0) * (0.45 + 0.55 * ripple))
    c = mix(c, vec3(0.75, 0.8, 0.82), foam * 0.8)
    # (fogged as the simple lighting fogs the platform: toward the fog color tone-mapped)
    fog_amount = 1.0 - exp(-dist * u.fog.x)
    vec4(mix(shown(aces(c)), aces(u.fog_color), clamp(fog_amount, 0.0, 1.0)), 1)

draw_sea = ():
    legs: vec4[8]
    k = 0
    loop s in [-1.0, 1.0]:
        loop j in 0..4:
            legs[k] = vec4(f32(-21.0 + f64(j) * 14.0), f32((HALF_Z - 3.0) * s), 1.6, 0)
            k += 1
    draw_custom(():
        draw(sea_sh, sea_mesh, SeaParams(scene_view_proj(), scene_camera(), scene_sun(), scene_sun_color(), scene_fog_color(), scene_fog(), f32(elapsed()), sky_tex, legs))
    )


world_mesh = Mesh()
metal_mesh = Mesh()
glow_mesh = Mesh()
amber_mesh = Mesh()
sea_mesh = Mesh()
far_mesh = Mesh()
beam_mesh = Mesh()
cube = Mesh()
ball = Mesh()
disc = Mesh()
shield_mesh = Mesh()
nade_mesh = Mesh()
rocket_mesh = Mesh()
meshes_made = false

# each kind's robot: its model, its animations, and the joints turned to aim (its head, its
# eye and its gun)
struct Rig:
    model: Model
    idle: int
    walk: int
    run: int
    shoot: int
    attack: int
    die: int
    aim: int[]
    rest: Pose

rigs: Rig[]
arm_models: Model[]
arm_fit: mat4[]                 # (each weapon's model: its barrel along -z, centered, its true size)
arm_length = [0.26, 0.85, 0.9, 1.15, 0.62]
fp_arms = Model([], vec3(0, 0, 0), vec3(0, 0, 0))     # (the forearms and hands alone, for the view)
fp_right = -1
fp_left = -1
fp_left_arm = -1

# the robots' colors (to change one: from, to)
const TRIM = vec4(0.8, 0.366, 0.071, 1)
const DOME = vec4(0.037, 0.037, 0.037, 1)
const SHELL = vec4(0.57, 0.57, 0.57, 1)
const EYE_RED = vec4(0.8, 0.004, 0, 1)

rig = (m0: Model, colors: (vec4, vec4)[]) -> Rig:
    m = m0
    loop i in 0.. and pt in m.parts:
        loop c in colors:
            if length(pt.color - c.0) < 0.01: m.parts[i].color = c.1
        # (its eyes glow)
        if length(pt.color - EYE_RED) < 0.01: m.parts[i].emissive = 1.5
    Rig(m, find_animation(m, "Idle"), find_animation(m, "Walk"), find_animation(m, "Run"), find_animation(m, "Shoot"),
        find_animation(m, "Attack"), find_animation(m, "Death"), [loop n in ["Head", "Eye", "Gun"]: find_node(m, n)], rest_pose(m))

make_meshes = ():
    global amber_mesh, arm_models, ball, beam_mesh, cube, disc, far_mesh, fp_arms, fp_left, fp_left_arm, fp_right, glow_mesh, meshes_made, metal_mesh, nade_mesh, rigs, rocket_mesh, sea_mesh, shield_mesh, world_mesh
    meshes_made = true
    cube = cube_mesh(1.0)
    ball = sphere_mesh(0.5, 10, 6)
    disc = cylinder_mesh(1.0, 0.04, 32)
    vs: Vertex3D[]
    mt: Vertex3D[]              # (metal: railings, masts, consoles, racks)
    gl: Vertex3D[]
    am: Vertex3D[]
    # the deck: a slab, and tiles on it with dark seams between
    add_box(vs, v3(0, -0.8, 0), v3(HALF_X * 2.0 + 2.0, 1.5, HALF_Z * 2.0 + 2.0), vec4(0.16, 0.18, 0.22, 1))
    seed_random(3)
    loop tx in 0..14:
        loop tz in 0..11:
            x = -HALF_X + 2.0 + f64(tx) * 4.0
            z = -HALF_Z + 2.0 + f64(tz) * 4.0
            shade = f32(random(-0.03, 0.03))
            add_box(vs, v3(x, -0.03, z), v3(3.92, 0.06, 3.92), DECK + vec4(shade, shade, shade, 0))
    # the railing round the edge, and the legs down into the sea
    loop s in [-1.0, 1.0]:
        add_box(mt, v3(0, 1.05, (HALF_Z + 0.3) * s), v3(HALF_X * 2.0 + 0.6, 0.1, 0.1), SLATE)
        add_box(mt, v3((HALF_X + 0.3) * s, 1.05, 0), v3(0.1, 0.1, HALF_Z * 2.0 + 0.6), SLATE)
        add_box(mt, v3(0, 0.55, (HALF_Z + 0.3) * s), v3(HALF_X * 2.0 + 0.6, 0.06, 0.06), SLATE)
        add_box(mt, v3((HALF_X + 0.3) * s, 0.55, 0), v3(0.06, 0.06, HALF_Z * 2.0 + 0.6), SLATE)
        loop k in 0..15:
            x = -HALF_X + f64(k) * 4.0
            add_box(mt, v3(x, 0.55, (HALF_Z + 0.3) * s), v3(0.12, 1.1, 0.12), SLATE)
        loop k in 0..12:
            z = -HALF_Z + f64(k) * 4.0
            add_box(mt, v3((HALF_X + 0.3) * s, 0.55, z), v3(0.12, 1.1, 0.12), SLATE)
        loop k in 0..4:
            x = (-21.0 + f64(k) * 14.0)
            add_cylinder(vs, v3(x, -6, (HALF_Z - 3.0) * s), 1.6, 5.0, vec4(0.62, 0.62, 0.6, 1), 12)
            # (a band where the sea meets them)
            add_cylinder(vs, v3(x, -4.6, (HALF_Z - 3.0) * s), 1.66, 1.0, vec4(0.32, 0.36, 0.34, 1), 12)
    # the blocks
    loop b in blocks:
        c = (b.lo + b.hi) * 0.5
        size = b.hi - b.lo
        if b.rise != 0:
            add_ramp(vs, b, DECK)
            continue
        col = IVORY
        if b.look == 1: col = vec4(0.7, 0.68, 0.63, 1)
        if b.look == 4: col = vec4(0.62, 0.62, 0.6, 1)
        if b.look == 5: col = SLATE
        if b.look == 5: add_box(mt, c, size, col)
        else: add_box(vs, c, size, col)
        if b.look == 5:
            # a console: screens on its long sides
            add_box(gl, c + vec3(0, 0.2, 0), vec3(size.x + 0.02, 0.35, size.z - 0.3), TEAL)
        if b.look == 0 and size.y > 2.0:
            # tall walls: a recessed panel on each broad face
            if size.x > size.z:
                loop side in [-1.0, 1.0]: add_box(vs, c + v3(0, 0.1, f64(size.z) * 0.5 * side), vec3(size.x - 0.6, size.y - 0.9, 0.04), darken(col, 0.14))
            else:
                loop side in [-1.0, 1.0]: add_box(vs, c + v3(f64(size.x) * 0.5 * side, 0.1, 0), vec3(0.04, size.y - 0.9, size.z - 0.6), darken(col, 0.14))
        if b.look == 2:
            # the platform's floor and the glowing line round its top
            add_box(vs, c + vec3(0, size.y * 0.5 + 0.01, 0), vec3(size.x - 0.3, 0.02, size.z - 0.3), DECK)
            add_box(gl, c + vec3(0, size.y * 0.5 - 0.15, 0), size + vec3(0.04, -size.y + 0.08, 0.04), TEAL)
        if b.look == 0 or b.look == 1:
            # a cap, a little wider
            add_box(vs, c + vec3(0, size.y * 0.5, 0), vec3(size.x + 0.12, 0.12, size.z + 0.12), lighten(col, 0.08))
        if b.look == 4: add_box(am, c + vec3(0, size.y * 0.5 - 0.25, 0), vec3(size.x + 0.02, 0.1, size.z + 0.02), AMBER)
    # the relay tower: a mast, a dish and a beacon
    add_box(mt, v3(0, 9.4, 0), v3(1.6, 0.8, 1.6), SLATE)
    add_cylinder(mt, v3(0, 9.8, 0), 0.25, 4.0, IVORY, 10)
    add_cylinder(mt, v3(0, 11.5, 0), 0.4, 0.9, IVORY, 20, 1.9)
    add_sphere(gl, v3(0, 14.0, 0), 0.32, TEAL, 10, 6)
    loop k in 0..4:
        add_box(gl, v3(0, 3.0 + f64(k) * 1.6, 0), v3(2.44, 0.08, 2.44), TEAL)
    # buttresses at the tower's corners
    loop sx in [-1.0, 1.0]:
        loop sz in [-1.0, 1.0]: add_box(mt, vec3(0, 0, 0), vec3(1, 1, 1), SLATE, beam(v3(1.55 * sx, 2, 1.55 * sz), v3(1.1 * sx, 5.5, 1.1 * sz), 0.3))
    # the bays' floors: amber rings where raiders arrive
    loop gp in gates:
        loop k in 0..16:
            a = TAU * f64(k) / 16.0
            add_box(am, vec3(0, 0, 0), v3(0.5, 0.04, 0.12), AMBER, translation(gp + v3(cos(a) * 1.8, 0.02, sin(a) * 1.8)) * rotation_y(-a - PI / 2.0))
        # hazard stripes across the bay's mouth
        inward = normalize(flat(vec3(0, 0, 0) - gp))
        across = vec3(inward.z, 0, -inward.x)
        mouth = gp + inward * 4.2
        loop k in -3..4:
            add_box(vs, vec3(0, 0, 0), v3(0.3, 0.03, 1.3), vec4(0.85, 0.55, 0.15, 1), translation(mouth + across * f32(f64(k) * 0.6)) * rotation_y(yaw_of(inward) + 0.785))
    # the weapon racks: a pedestal with a glowing top
    loop r in racks:
        add_box(mt, vec3(0, 0.35, 0), vec3(0.5, 0.7, 1.0), SLATE, translation(r.pos) * rotation_y(r.yaw))
        add_box(gl, vec3(0, 0.71, 0), vec3(0.4, 0.03, 0.9), TEAL, translation(r.pos) * rotation_y(r.yaw))
    world_mesh = custom_mesh(vs)
    metal_mesh = custom_mesh(mt)
    glow_mesh = custom_mesh(gl)
    amber_mesh = custom_mesh(am)
    sea_mesh = plane_mesh(2400.0)
    # far off: islands of rock, and a tall spire with a beam of light into the sky
    fr: Vertex3D[]
    seed_random(11)
    loop k in 0..9:
        a = random(0.0, TAU)
        r = random(220.0, 420.0)
        rs = random(25.0, 60.0)
        t = translation(v3(cos(a) * r, -10, sin(a) * r)) * scaling(v3(rs * random(1.0, 2.2), rs * random(0.5, 1.1), rs))
        add_sphere(fr, vec3(0, 0, 0), 1.0, vec4(0.32, 0.38, 0.36, 1), 7, 5, t)
    spire = v3(-170, -8, -300)
    loop k in 0..6:
        w = 26.0 - f64(k) * 4.0
        add_box(fr, spire + v3(0, 20.0 + f64(k) * 28.0, 0), v3(w, 28, w * 0.8), vec4(0.62, 0.64, 0.66, 1), rotation_y(0.3))
    far_mesh = custom_mesh(fr)
    bm: Vertex3D[]
    add_box(bm, spire + v3(0, 600, 0), v3(3, 1000, 3), vec4(0.6, 1.0, 1.0, 1))
    beam_mesh = custom_mesh(bm)
    seed_random(time_ns())
    # the raiders, the shield around a warden, the weapons
    sh: Vertex3D[]
    add_sphere(sh, vec3(0, 0, 0), 1.0, vec4(1, 1, 1, 1), 14, 8)
    shield_mesh = custom_mesh(sh)
    # (a warden's dome navy and its trim teal; a lobber's shell gunmetal and its trim red)
    rigs = [rig(load_model(embed("skitter.glb")).unwrap(), []),
            rig(load_model(embed("warden.glb")).unwrap(), [(TRIM, vec4(0.15, 0.6, 0.65, 1)), (DOME, vec4(0.04, 0.09, 0.26, 1))]),
            rig(load_model(embed("lobber.glb")).unwrap(), [(TRIM, vec4(0.75, 0.1, 0.06, 1)), (SHELL, vec4(0.3, 0.31, 0.33, 1))])]
    fp_arms = load_model(embed("arms.glb")).unwrap()
    fp_right = find_node(fp_arms, "RightHand")
    fp_left = find_node(fp_arms, "LeftHand")
    fp_left_arm = find_node(fp_arms, "LeftForeArm")
    arm_models = [load_model(embed("pistol.glb")).unwrap(), load_model(embed("rifle.glb")).unwrap(), load_model(embed("shotgun.glb")).unwrap(),
                  load_model(embed("rockets.glb")).unwrap(), load_model(embed("caster.glb")).unwrap()]
    loop i in 0.. and m in arm_models:
        sz = model_size(m)
        k = f32(arm_length[i] / f64(max(sz.x, max(sz.y, sz.z))))
        # (Quaternius' guns point along +x; the shotgun along -x, the caster along -z)
        turn = rotation_y(PI / 2.0)
        if i == int(Arm.shotgun): turn = rotation_y(-PI / 2.0)
        if i == int(Arm.caster): turn = mat4()
        arm_fit.push(scaling(vec3(k, k, k)) * turn * translation(model_center(m) * -1.0))
    rk: Vertex3D[]
    add_cylinder(rk, vec3(0, 0, 0), 0.06, 0.4, vec4(0.85, 0.85, 0.8, 1), 8, 0.0, rotation_x(-PI / 2.0))
    add_cylinder(rk, vec3(0, 0, 0), 0.06, 0.3, vec4(0.3, 0.32, 0.3, 1), 8, -1.0, rotation_x(PI / 2.0))
    rocket_mesh = custom_mesh(rk)
    nv: Vertex3D[]
    add_sphere(nv, vec3(0, 0, 0), 0.11, vec4(0.3, 0.35, 0.3, 1), 8, 5)
    add_box(nv, vec3(0, 0.1, 0), vec3(0.06, 0.06, 0.06), SLATE)
    nade_mesh = custom_mesh(nv)

# a triangle facing away from `inside`
add_tri = (vs: mut Vertex3D[], a: vec3, b: vec3, c: vec3, inside: vec3, col: vec4):
    n = normalize(cross(b - a, c - a))
    if dot(n, a - inside) < 0.0:
        vs.push(Vertex3D(a, -n, vec2(0, 0), col))
        vs.push(Vertex3D(c, -n, vec2(0, 0), col))
        vs.push(Vertex3D(b, -n, vec2(0, 0), col))
    else:
        vs.push(Vertex3D(a, n, vec2(0, 0), col))
        vs.push(Vertex3D(b, n, vec2(0, 0), col))
        vs.push(Vertex3D(c, n, vec2(0, 0), col))

# a ramp: a solid wedge (its slope, its two sides and its high end)
add_ramp = (vs: mut Vertex3D[], b: Block, col: vec4):
    h = b.hi.y
    # (u along the rise, 0 at the low end; w across it)
    at = (u: f32, y: f32, w: f32) -> vec3:
        if b.rise == 1: return vec3(mix(b.lo.x, b.hi.x, u), y, mix(b.lo.z, b.hi.z, w))
        if b.rise == 2: return vec3(mix(b.hi.x, b.lo.x, u), y, mix(b.lo.z, b.hi.z, w))
        if b.rise == 3: return vec3(mix(b.lo.x, b.hi.x, w), y, mix(b.lo.z, b.hi.z, u))
        vec3(mix(b.lo.x, b.hi.x, w), y, mix(b.hi.z, b.lo.z, u))
    mid = at(0.67, h / 3.0, 0.5)
    add_tri(vs, at(0, 0, 0), at(1, h, 0), at(1, h, 1), mid, col)
    add_tri(vs, at(0, 0, 0), at(1, h, 1), at(0, 0, 1), mid, col)
    side = IVORY
    add_tri(vs, at(0, 0, 0), at(1, 0, 0), at(1, h, 0), mid, side)
    add_tri(vs, at(0, 0, 1), at(1, 0, 1), at(1, h, 1), mid, side)
    add_tri(vs, at(1, 0, 0), at(1, h, 0), at(1, h, 1), mid, side)
    add_tri(vs, at(1, 0, 0), at(1, h, 1), at(1, 0, 1), mid, side)

# a box stretched from a to b (tracers, shell trails)
beam = (a: vec3, b: vec3, w: f32) -> mat4:
    d = b - a
    l = length(d)
    z = d * (1.0 / max(l, 0.0001))
    x = cross(vec3(0, 1, 0), z)
    if length(x) < 0.01: x = vec3(1, 0, 0)
    x = normalize(x)
    y = cross(z, x)
    m = mat4()
    m[0] = vec4(x * w, 0)
    m[1] = vec4(y * w, 0)
    m[2] = vec4(z * l, 0)
    m[3] = vec4((a + b) * 0.5, 1)
    m

# ---------------- camera ----------------
fov_setting = 0.43              # (settings: 0 to 1, a 75 to 110 degree view across)
sensitivity = 0.5
invert = false
cam_pos = vec3(0, 3, 0)
cam_look = vec3(0, 3, -1)

fov_y = () -> f64:
    across = radians(75.0 + 35.0 * fov_setting)
    degrees(2.0 * atan(tan(across / 2.0) / (16.0 / 9.0)))

draw_world = ():
    if not meshes_made: make_meshes()
    if not sky_ready: make_sky()
    # (the gradient: the light of the effects drawn without materials)
    sky(vec3(0.3, 0.45, 0.66), SKY_HAZE, vec3(0.42, 0.42, 0.4))
    sky_image(sky_tex, 1.0)
    sun(SUN_DIR, SUN_LIGHT, 0.0)
    fog(FOG, 0.0018, 0.02)
    shadows(true, 0.75, 28.0)
    post_effects(0.5, 0.82, 0.3, 1.15, vec3(1.02, 1.0, 0.97))
    # (zoomed in: the view narrows by the weapon's zoom)
    zf = 1.0 + (arm_info(guns[held]).zoom - 1.0) * zoom_k
    if not you.alive: zf = 1.0
    camera3d(cam_pos, cam_look, degrees(2.0 * atan(tan(radians(fov_y()) / 2.0) / zf)), 0.05, 1200.0)
    # (near to far, so what is hidden is not shaded: the platform, then the islands and the sea)
    # (the platform in the simple lighting: materials would double what the software renderer
    # spends on a frame, for little that shows on concrete)
    draw_mesh(world_mesh, specular = 0.15)
    draw_mesh(metal_mesh, specular = 0.7)
    draw_mesh(glow_mesh, emissive = 1.8, cast_shadow = false)
    draw_mesh(amber_mesh, emissive = 1.2 + 0.5 * sin(elapsed() * 3.0), cast_shadow = false)
    draw_mesh(far_mesh, cast_shadow = false, specular = 0.0)
    draw_sea()
    draw_mesh(beam_mesh, color = vec4(0.6, 1.0, 1.0, 0.35), emissive = 2.0, cast_shadow = false)
    point_light(v3(0, 14, 0), vec3(0.3, 1.0, 0.95), 7.0, 1.0)
    loop f in foes: draw_foe(f)
    draw_pickups()
    # raiders arriving: a column of light growing over the bay
    loop w in warps:
        k = f32(w.time / 1.6)
        draw_mesh(cube, beam(w.pos, w.pos + vec3(0, 6, 0), 1.6 * k + 0.2), vec4(1.0, 0.65, 0.3, 0.3 + 0.3 * k), emissive = 2.5, cast_shadow = false)
        point_light(w.pos + vec3(0, 1.5, 0), vec3(1.0, 0.6, 0.25), 6.0, 1.5 * f64(k))
    # shots in flight
    lit = 0
    loop b in bolts:
        col = vec4(1.0, 0.38, 0.12, 1)
        if b.mine: col = vec4(0.2, 0.95, 0.9, 1)
        if b.rocket:
            draw_mesh(rocket_mesh, translation(b.pos) * inverse(look_at(vec3(0, 0, 0), b.vel, vec3(0, 1, 0))), emissive = 0.2, cast_shadow = false)
            draw_mesh(ball, translation(b.pos - normalize(b.vel) * 0.35) * scaling(vec3(0.22, 0.22, 0.22)), vec4(1.0, 0.7, 0.3, 1), emissive = 3.0, cast_shadow = false)
            col = vec4(1.0, 0.6, 0.25, 1)
        else if b.lob:
            draw_mesh(ball, translation(b.pos) * scaling(vec3(0.5, 0.5, 0.5)), vec4(1.0, 0.6, 0.2, 1), emissive = 3.0, cast_shadow = false)
            # where it will land: a ring that closes in
            k = f32(clamp(b.life - 1.7, 0.0, 1.3) / 1.3)
            draw_mesh(disc, translation(b.target + vec3(0, 0.04, 0)) * scaling(vec3(3.5, 1, 3.5)), vec4(1.0, 0.4, 0.2, 0.18), emissive = 1.2, cast_shadow = false)
            draw_mesh(disc, translation(b.target + vec3(0, 0.07, 0)) * scaling(vec3(3.5 * (1.0 - k), 1, 3.5 * (1.0 - k))), vec4(1.0, 0.45, 0.2, 0.4), emissive = 1.6, cast_shadow = false)
        else:
            # a glowing head and a fading trail
            tail = b.pos - normalize(b.vel) * 0.9
            draw_mesh(ball, translation(b.pos) * scaling(vec3(0.2, 0.2, 0.2)), col, emissive = 2.2, cast_shadow = false)
            draw_mesh(cube, beam(tail, b.pos, 0.05), with_alpha(col, 0.5), emissive = 1.5, cast_shadow = false)
        if lit < 5:
            lit += 1
            point_light(b.pos, col.xyz, 3.5, 1.2)
    loop n in nades:
        draw_mesh(nade_mesh, translation(n.pos) * rotation_x(n.age * 9.0))
        if n.fuse >= 0.0 and int(n.fuse * 10.0) % 2 == 0: point_light(n.pos + vec3(0, 0.3, 0), vec3(1.0, 0.3, 0.2), 2.5, 1.5)
    loop t in tracers: draw_mesh(cube, beam(t.a, t.b, f32(t.width)), vec4(1.0, 0.9, 0.6, 1), emissive = 2.5, cast_shadow = false)
    loop f in flashes: point_light(f.pos, f.color, f.radius, 2.5 * f.life / f.full)
    if sparks.len() > 0:
        inst: Instance3D[]
        loop s in sparks:
            k = f32(s.life / s.full)
            inst.push(instance(translation(s.pos) * scaling(vec3(s.size, s.size, s.size) * (0.4 + 0.6 * k)), s.color))
        draw_mesh_instanced(cube, inst, emissive = 2.0, cast_shadow = false)

# a raider's pose: standing, or walking or running (in step with how far it has gone), its head
# and gun turned to aim at the player (a lobber's cannon raised to lob); kicked by its shots,
# striking (rearing up, then lunging), or falling
foe_pose = (f: Foe) -> Pose:
    r = rigs[int(f.kind)]
    m = r.model
    if f.dead >= 0.0: return pose_at(m, r.die, f.dead, false)
    z = f64(info(f).size)
    v = flat(f.body.vel)
    sp = f64(length(v))
    p = pose_at(m, r.idle, elapsed() + f64(f.strafe) * 0.7)
    if sp > 0.15:
        # (at size 1, a stride: 1.4 m walking at 0.84 m/s, 1.9 running at 3; backing off, back)
        run = clamp((sp - 0.84 * z) / (2.16 * z), 0.0, 1.0)
        u = f.gait / (mix(1.4, 1.88, run) * z)
        u = u - floor(u)
        if dot(v, look_dir(f.yaw, 0.0)) < 0.0: u = 1.0 - u
        moving = pose_at(m, r.walk, u * animation_length(m, r.walk))
        if run > 0.0: moving = blend_poses(moving, pose_at(m, r.run, u * animation_length(m, r.run)), run)
        p = blend_poses(p, moving, clamp(sp / 0.8, 0.0, 1.0))
    if f.recoil < animation_length(m, r.shoot): p = blend_poses(p, pose_at(m, r.shoot, f.recoil, false), 0.7)
    # a strike: its animation up to the lunge (0.45 s in) while it winds up, then on through it
    if f.swing > 0.0: p = pose_at(m, r.attack, 0.45 - f.swing, false)
    else if f.melee_wait > 0.8:
        p = blend_poses(p, pose_at(m, r.attack, 0.45 + 1.3 - f.melee_wait, false), clamp((f.melee_wait - 0.8) / 0.2, 0.0, 1.0))
    # (looking about, its head and gun turn; aiming, they face ahead, tilted at the player)
    tilt = 0.0
    if f.sees or f.burst > 0:
        to = chest() - foe_eye(f)
        tilt = atan2(f64(to.y), f64(length(flat(to))))
    if f.windup > 0.0: tilt = 0.6
    if f.flinch > 0.0: tilt += f.flinch * 1.5
    loop n in r.aim:
        if n < 0: continue
        q = r.rest.r[n]
        if dot(p.r[n], q) < 0.0: q = q * -1.0
        p.r[n] = normalize(mix(p.r[n], q, f32(f.aiming)))
        turn_node(m, p, n, vec3(1, 0, 0), -tilt)
    p

# a weapon in hands: from the right hand toward the left (which holds it further up)
in_hands = (p: Pose, m: Model, right: int, left: int) -> mat4:
    rp = (node_transform(m, p, right) * vec4(0, 0, 0, 1)).xyz
    lp = (node_transform(m, p, left) * vec4(0, 0, 0, 1)).xyz
    fw = normalize(lp - rp)
    side = normalize(cross(fw, vec3(0, 1, 0)))
    up = cross(side, fw)
    out = mat4()
    out[0] = vec4(side, 0)
    out[1] = vec4(up, 0)
    out[2] = vec4(fw * -1.0, 0)
    out[3] = vec4(rp, 1)
    out

draw_foe = (f: Foe):
    z = info(f).size
    sink = 0.0
    if f.dead >= 3.0: sink = (f.dead - 3.0) * 0.8
    xf = translation(f.body.pos - v3(0, sink, 0)) * rotation_y(f.yaw + PI) * scaling(vec3(z, z, z))
    if f.dodge > 0.35: xf = xf * scaling(vec3(1.05, 0.9, 1.05))
    tint = vec4(1, 1, 1, 1)
    if f.shield_flash > 0.0: tint = mix(tint, vec4(1.6, 1.3, 0.9, 1), f32(f.shield_flash / 0.25) * 0.4)
    draw_model(rigs[int(f.kind)].model, xf, tint, pose = foe_pose(f))
    # (a lobber's cannon glowing as it lobs)
    if f.windup > 0.0: point_light(muzzle(f), vec3(1.0, 0.45, 0.15), 3.0, f32((0.9 - f.windup) * 2.5))
    # a warden's shield: faint while it holds, bright when hit, a ring flying out when it breaks
    shell = translation(foe_center(f)) * rotation_y(f.yaw) * scaling(vec3(0.75 * z, 0.5 * z, 0.75 * z))
    if f.kind == .warden and f.dead < 0.0 and (f.shield > 0.0 or f.shield_flash > 0.0):
        a = 0.07 + f32(max(f.shield_flash, 0.0) / 0.25) * 0.45
        draw_mesh(shield_mesh, shell, vec4(1.0, 0.7, 0.3, a), emissive = 1.5, cast_shadow = false)
    if f.shield_pop > 0.0:
        k2 = f32(1.0 + (0.4 - f.shield_pop) * 3.0)
        draw_mesh(shield_mesh, shell * scaling(vec3(k2, k2 * 0.6, k2)), vec4(1.0, 0.8, 0.4, f32(f.shield_pop / 0.4) * 0.5), emissive = 2.0, cast_shadow = false)

# weapons on racks (turning slowly over them) and dropped on the deck
draw_pickups = ():
    loop i in 0.. and k in pickups:
        m = arm_models[k.gun.arm]
        xf = translation(k.pos + vec3(0, 0.12, 0)) * rotation_y(k.yaw) * rotation_z(PI / 2.0 * 0.0)
        if k.rack >= 0: xf = translation(k.pos + v3(0, 0.15 + 0.05 * sin(elapsed() * 2.0), 0)) * rotation_y(k.yaw + elapsed() * 0.6)
        tint = vec4(1, 1, 1, 1)
        if i == near_pick: tint = vec4(1.35, 1.35, 1.25, 1)
        # (lying down: on its side)
        if k.rack < 0: xf = xf * rotation_z(PI / 2.0) * translation(vec3(0, 0, 0))
        draw_model(m, xf * arm_fit[k.gun.arm], tint)
        if k.rack >= 0: point_light(k.pos + vec3(0, 0.3, 0), vec3(0.3, 1.0, 0.95), 2.5, 0.8)

# the weapon in hand: swaying with the walk, kicking with each shot, dipping to reload or swap
# (in view space: x right, y up, looking along -z; its muzzle at the far end)
# (and drawn at 0.8 of their size)
const HOLD_AT = [vec3(0.16, -0.15, -0.5), vec3(0.17, -0.19, -0.7), vec3(0.17, -0.19, -0.66), vec3(0.2, -0.15, -0.72), vec3(0.16, -0.16, -0.55)]
const FP = 0.8
# (the right hand, from the weapon's middle)
const GRIP_AT = [vec3(0, -0.07, 0.03), vec3(0, -0.08, 0.13), vec3(0, -0.08, 0.14), vec3(0, -0.1, 0.12), vec3(0, -0.09, 0.04)]

draw_weapon = ():
    if not you.alive or guns[held].arm < 0: return
    g = guns[held]
    bob = you.walked * PI / 1.8
    move = f64(length(flat(you.body.vel))) / RUN
    off = HOLD_AT[g.arm] + v3(cos(bob) * 0.006 * move, abs(sin(bob)) * 0.008 * move, you.kick * 3.0)
    off = off + v3(-0.15 * zoom_k, 0.05 * zoom_k, 0.08 * zoom_k)
    tilt = you.kick * 4.0
    dip = 0.0
    if swap_time > 0.0: dip = sin(PI * swap_time / 0.3) * 0.9
    if g.reload > 0.0: dip = sin(PI * g.reload / arm_info(g).reload) * 0.6
    if throw_time > 0.0: dip = max(dip, sin(PI * throw_time / 0.45) * 0.5)
    thrust = 0.0
    if melee_time > 0.5: thrust = sin(PI * (0.8 - melee_time) / 0.3)
    off += v3(-0.08 * thrust + 0.03 * dip, -0.16 * dip, -0.25 * thrust)
    view = inverse(look_at(cam_pos, cam_look, vec3(0, 1, 0)))
    m = view * translation(off) * rotation_y(0.04) * rotation_x(tilt - dip * 0.3) * rotation_z(dip * 0.35 + thrust * 0.3) * scaling(vec3(FP, FP, FP))
    tint = vec4(1, 1, 1, 1)
    if g.arm == int(Arm.caster): tint = vec4(1.0 + f32(g.heat) * 0.8, 1.0 - f32(g.heat) * 0.3, 1.0 - f32(g.heat) * 0.4, 1)
    # the hands holding it (the raiders' forearms, in their aiming pose, placed by the weapon)
    # (the pistol and caster in one hand: the other folded away)
    p = pose_at(fp_arms, 0, elapsed())
    hands = in_hands(p, fp_arms, fp_right, fp_left)
    if g.arm == int(Arm.pistol) or g.arm == int(Arm.caster): p.s[fp_left_arm] = vec3(0, 0, 0)
    grip = m * scaling(vec3(1.0 / FP, 1.0 / FP, 1.0 / FP)) * translation(GRIP_AT[g.arm])
    draw_model(fp_arms, grip * inverse(hands), vec4(0.4, 0.5, 0.42, 1), cast_shadow = false, pose = p, in_front = true)
    draw_model(arm_models[g.arm], m * arm_fit[g.arm], tint, cast_shadow = false, in_front = true)
    if g.flash > 0.0:
        col = vec4(1.0, 0.8, 0.45, 1)
        if g.arm == int(Arm.caster): col = vec4(0.4, 1.0, 0.95, 1)
        tip = m * translation(vec3(0, 0.02, -f32(arm_length[g.arm]) * 0.5 - 0.03))
        draw_mesh(cube, tip * rotation_z(random(0.0, 1.5)) * scaling(vec3(0.09, 0.09, 0.02)), col, emissive = 4.0, in_front = true)
        point_light(gun_muzzle(), col.xyz, 6.0, 1.5)

# where the camera is: the eye, shaken a little by blasts and hits
# where the camera is: the eye (looking where shots go), shaken by blasts and hits
place_camera = ():
    global cam_look, cam_pos
    s = you.shake * you.shake * 0.06
    pitch = you.pitch
    cam_pos = eye() + v3(sin(elapsed() * 37.0) * s, cos(elapsed() * 29.0) * s, sin(elapsed() * 23.0) * s)
    if not you.alive:
        # fallen: the view sinks and tips
        k = min(over_time, 1.0)
        cam_pos = you.body.pos + v3(0, EYE - 1.3 * k, 0)
        pitch -= 0.5 * k
    # (14 m ahead: the shadows are sharpest round that point)
    cam_look = cam_pos + look_dir(you.yaw, pitch) * 14.0

# ---------------- heads-up display ----------------
const HUD = vec4(0.55, 0.95, 1.0, 1)
const HUD_BACK = vec4(0.0, 0.05, 0.08, 0.42)
const ALERT = vec4(1.0, 0.33, 0.27, 1)

# The heads-up display: boxes at the screen's edges, laid out as the menus are (at a 1280 x 720
# screen's size, larger on a phone), and what is drawn at its middle (the reticle, hit marks,
# prompts and news)
draw_hud = ():
    # shield down: the edges of the view go red
    if you.shield <= 0.0 and you.alive:
        al = f32(0.25 + 0.15 * sin(elapsed() * 8.0))
        v = visible_rect()
        rect_gradient(f64(v.x), f64(v.y), f64(v.w), 90.0, with_alpha(ALERT, al), with_alpha(ALERT, 0))
        rect_gradient(f64(v.x), f64(v.y + v.h) - 90.0, f64(v.w), 90.0, with_alpha(ALERT, 0), with_alpha(ALERT, al))
    in_menu_units((w: f64, h: f64):
        hud_edges(w, h)
        hud_middle(w, h)
    )

hud_edges = (w: f64, h: f64):
    g = guns[held]
    other = guns[1 - held]
    left = pending.len() + count_alive()
    loop wp in warps: left += wp.group.len()
    pad = if h < 600.0: 14.0 else: 22.0
    touch = using_touch()
    # (a display: it takes no input)
    ui.at(Rect(0, 0, f32(w), f32(h)), key = "hud", pad = pad, input = ui.Input(), ():
        ui.row(width = ui.grow(), cross = .start, ():
            ui.column(width = 230, gap = 12, ():
                ui.row(gap = 8, cross = .center, ():
                    # (on a touch screen: the pause button first)
                    if touch: ui.space(width = 52, height = 40)
                    ui.slot(width = 100, height = 30, (r: Rect): draw_grenades(r))
                )
                if touch: ui.slot(width = 124, height = 124, (r: Rect): draw_tracker(r))
            )
            ui.space(width = ui.grow())
            ui.slot(width = 400, height = 36, (r: Rect): draw_shield(r))
            ui.space(width = ui.grow())
            ui.column(width = 230, gap = 10, cross = .end, ():
                ui.column(width = ui.grow(), pad = ui.insets(14, 6, 14, 8), cross = .end, radius = 8, color = HUD_BACK, ():
                    ui.label("{score}", size = 38)
                    ui.row(gap = 10, cross = .center, ():
                        if wave == 0: ui.label("GET READY", size = 18, color = HUD)
                        else if between > 0.0: ui.label("NEXT WAVE IN {int(ceil(between))}", size = 18, color = HUD)
                        else:
                            ui.label("WAVE {wave}", size = 18, color = HUD)
                            ui.label("{left} LEFT", size = 18, color = hud_style.muted)
                    )
                )
                if touch: weapon_box(g, other, true)
            )
        )
        ui.space(height = ui.grow())
        if not touch:
            ui.row(width = ui.grow(), cross = .end, ():
                ui.slot(width = 150, height = 150, (r: Rect): draw_tracker(r))
                ui.space(width = ui.grow())
                weapon_box(g, other, false)
            )
    )
    draw_touch(w, h)

# the weapon in hand: its name (and the other one's), its rounds and what is in reserve, or a
# caster's charge and heat (on a touch screen, in one line, out of the buttons' way: a tap on it
# swaps weapons)
weapon_box = (g: Gun, other: Gun, compact: bool):
    if g.arm < 0: return
    ai = arm_info(g)
    if compact:
        ui.row(width = 230, pad = ui.insets(14, 4, 14, 6), gap = 8, cross = .end, radius = 8, color = HUD_BACK, key = "weapon", ():
            ui.label(ai.name, size = 18, color = HUD)
            ui.space(width = ui.grow())
            if g.arm == int(Arm.caster): ui.label("{g.ammo}%", size = 30, color = mix(WHITE, ALERT, f32(g.heat)))
            else:
                ui.label("{g.ammo}", size = 30, color = if g.ammo == 0: ALERT else: WHITE)
                ui.label("/ {g.reserve}", size = 16, color = rgba(1, 1, 1, 0.6))
        )
        return
    ui.column(width = 230, pad = ui.insets(14, 6, 14, 8), cross = .end, radius = 8, color = HUD_BACK, key = "weapon", ():
        if other.arm >= 0: ui.label(arms[other.arm].name, size = 14, color = rgba(1, 1, 1, 0.42))
        ui.label(ai.name, size = 22, color = HUD)
        if g.arm == int(Arm.caster):
            ui.label("{g.ammo}%", size = 40)
            ui.bar(g.heat, color = mix(HUD, ALERT, f32(g.heat)), width = 170, height = 8, back = rgba(1, 1, 1, 0.15))
        else:
            ui.row(gap = 8, cross = .end, ():
                ui.label("{g.ammo}", size = 44, color = if g.ammo == 0: ALERT else: WHITE)
                ui.label("/ {g.reserve}", size = 20, color = rgba(1, 1, 1, 0.6))
            )
            rows = (ai.mag + 17) / 18
            ui.slot(width = 172, height = f64(rows) * 12.0, (r: Rect): draw_rounds(r, g, ai))
    )

# grenades: a diamond each
draw_grenades = (r: Rect):
    loop i in 0..4:
        c = with_alpha(HUD, 0.85)
        if i >= grenades: c = rgba(1, 1, 1, 0.15)
        x = r.x + 9.0 + f32(i) * 22.0
        y = r.y + r.h / 2.0
        triangle(vec2(x, y - 12.0), vec2(x - 8.0, y), vec2(x, y + 12.0), c)
        triangle(vec2(x, y - 12.0), vec2(x + 8.0, y), vec2(x, y + 12.0), c)

# the shield, and health in segments under it
draw_shield = (r: Rect):
    sx = f64(r.x)
    sy = f64(r.y)
    sw = f64(r.w)
    k = you.shield / SHIELD
    col = HUD
    if k < 0.25 and you.shield < SHIELD: col = mix(ALERT, HUD, f32(0.5 + 0.5 * sin(elapsed() * 12.0)))
    rect_rounded(sx - 3.0, sy + 1.0, sw + 6.0, 20.0, 4.0, rgba(0, 0.1, 0.15, 0.45))
    rect_outline(sx - 3.0, sy + 1.0, sw + 6.0, 20.0, 1.5, with_alpha(HUD, 0.6))
    rect(sx, sy + 4.0, sw * k, 14.0, with_alpha(col, 0.85))
    if you.calm >= RECHARGE_WAIT and you.shield < SHIELD: rect(sx + sw * k - 6.0, sy + 4.0, 6.0, 14.0, WHITE)
    loop i in 0..8:
        full = you.health >= HEALTH * f64(i + 1) / 8.0 - 0.5
        c = rgba(0.6, 1.0, 0.7, 0.85)
        if you.health < HEALTH * 0.34: c = rgba(1.0, 0.35, 0.3, 0.9)
        if not full: c = rgba(1, 1, 1, 0.15)
        rect(sx + f64(i) * (sw / 8.0) + 2.0, sy + 26.0, sw / 8.0 - 4.0, 6.0, c)

# the rounds in the magazine, right to left, 18 a row
draw_rounds = (r: Rect, g: Gun, ai: ArmInfo):
    n = ai.mag
    w = min(6.0, 170.0 / f64(n) - 2.0)
    right = f64(r.x + r.w)
    loop i in 0..n:
        c = with_alpha(HUD, 0.85)
        if i >= g.ammo: c = rgba(1, 1, 1, 0.12)
        rect(right - f64(i % 18 + 1) * (w + 2.0), f64(r.y) + 2.0 + f64(i / 18) * 12.0, w, 9.0, c)

# the middle: the reticle (red over a raider in range), hit marks, where hits come from, what
# the weapon needs, a weapon in reach, a word of advice, and news
hud_middle = (w: f64, h: f64):
    global pick_box
    g = guns[held]
    mid = vec2(f32(w / 2.0), f32(h / 2.0))
    over_foe = false
    if you.alive:
        look_hit = ray_foes(eye(), aim(), ray_world(eye(), aim(), 90), 0.05)
        over_foe = look_hit.0 >= 0
    rc = with_alpha(HUD, 0.85)
    if over_foe: rc = rgba(1.0, 0.3, 0.25, 0.95)
    if g.arm == int(Arm.shotgun):
        # (a ring as wide as the pellets spread)
        r = tan(arm_info(g).spread) / tan(radians(fov_y()) / 2.0) * h / 2.0
        ring(mid, r, 1.5, rc)
        loop i in 0..4:
            a = PI / 4.0 + f64(i) * PI / 2.0
            line(mid + from_angle(a) * f32(r - 5.0), mid + from_angle(a) * f32(r + 5.0), 2, rc)
        circle(mid, 1.6, rc)
    else if g.arm == int(Arm.caster):
        loop i in 0..3:
            a = f64(i) * TAU / 3.0 - PI / 2.0
            line(mid + from_angle(a) * 8, mid + from_angle(a) * 18, 2.5, rc)
    else if g.arm == int(Arm.rockets):
        ring(mid, 26.0, 2, rc)
        ring(mid, 8.0, 1.5, rc)
    else if g.arm >= 0:
        r = 10.0 + g.bloom * 500.0
        if g.arm == int(Arm.rifle): r += 4.0
        ring(mid, r, 1.5, rc)
        loop i in 0..4:
            a = f64(i) * PI / 2.0
            line(mid + from_angle(a) * f32(r - 4.0), mid + from_angle(a) * f32(r + 6.0), 2, rc)
        circle(mid, 1.6, rc)
    if hit_mark > 0.0 or kill_mark > 0.0:
        s = 9.0
        mc = rgba(1, 1, 1, 0.9)
        if kill_mark > 0.0:
            s = 14.0
            mc = rgba(1.0, 0.4, 0.3, 1)
        loop i in 0..4:
            a = PI / 4.0 + f64(i) * PI / 2.0
            line(mid + from_angle(a) * f32(s), mid + from_angle(a) * f32(s + 8.0), 2.5, mc)
    # where hits come from: red arcs around the middle
    loop hf in hurt_from:
        d = flat(hf.0 - you.body.pos)
        a = wrap(yaw_of(d) - you.yaw)
        sa = -PI / 2.0 - a
        arc(mid, 90.0, 9.0, sa - 0.3, sa + 0.3, rgba(1, 0.25, 0.2, f32(0.8 * (1.0 - hf.1 / 1.2))))
    below = mid.y + 60.0
    if g.arm >= 0:
        say = ""
        sc = rgba(1, 0.4, 0.3, 0.95)
        if g.reload > 0.0:
            say = "RELOADING"
            sc = with_alpha(HUD, 0.85)
        else if g.ammo == 0 and g.reserve > 0: say = "RELOAD"
        else if g.ammo == 0: say = "NO ROUNDS"
        if g.arm == int(Arm.caster) and g.vent > 0.0: say = "OVERHEATED"
        if len(say) > 0: text_centered(say, vec2(mid.x, below), 18, sc)
    # a weapon in reach: what it is, and holding the key to take it
    if near_pick >= 0 and near_pick < pickups.len():
        pk = pickups[near_pick]
        what = arms[pk.gun.arm].name
        if guns[1 - held].arm >= 0 and guns[held].arm >= 0: what = "{what} FOR THE {arm_info(guns[held]).name}"
        t = if using_touch(): "HOLD HERE  {what}" else: "HOLD {key_of("Pick up")}  {what}"
        tw = text_width(t, 20.0)
        y = f64(mid.y) + 140.0
        pick_box = Rect(f32(f64(mid.x) - tw / 2.0 - 14.0), f32(y - 17.0), f32(tw + 28.0), 34)
        rect_rounded(f64(mid.x) - tw / 2.0 - 14.0, y - 17.0, tw + 28.0, 34.0, 6.0, rgba(0, 0.05, 0.08, 0.6))
        text_centered(t, vec2(mid.x, f32(y)), 20, WHITE)
        if pick_time > 0.0: rect(f64(mid.x) - tw / 2.0 - 14.0, y + 15.0, (tw + 28.0) * min(pick_time / HOLD, 1.0), 3.0, HUD)
    if hint_time > 0.0:
        al = f32(clamp(hint_time, 0.0, 1.0))
        tw = text_width(hint_text, 20.0)
        y = f64(mid.y) + 96.0
        rect_rounded(f64(mid.x) - tw / 2.0 - 14.0, y - 17.0, tw + 28.0, 34.0, 6.0, rgba(0, 0.05, 0.08, 0.6 * f64(al)))
        text_centered(hint_text, vec2(mid.x, f32(y)), 20, with_alpha(WHITE, al))
    # news: a wave's in the middle, the rest at the left over the tracker
    y = h - 210.0
    loop p in popups:
        al = f32(clamp(2.5 - p.age, 0.0, 1.0))
        if p.big: text_centered(p.text, vec2(mid.x, f32(f64(mid.y) - 140.0 - min(p.age, 0.3) * 30.0)), 40, with_alpha(HUD, al))
        else:
            rect_rounded(22.0, y - 3.0, text_width(p.text, 20.0) + 16.0, 28.0, 5.0, rgba(0, 0.05, 0.08, 0.45 * f64(al)))
            text(p.text, vec2(30, f32(y)), 20, rgba(1, 0.9, 0.6, al))
            y -= 32.0

# The motion tracker: raiders within 25 m that move fast or fire, as seen from above, ahead up.
draw_tracker = (box: Rect):
    c = vec2(box.x + box.w / 2.0, box.y + box.h / 2.0)
    r = f64(box.w) / 2.0
    circle(c, r, rgba(0, 0.12, 0.16, 0.45))
    ring(c, r, 1.5, with_alpha(HUD, 0.5))
    ring(c, r * 0.5, 1, with_alpha(HUD, 0.2))
    line(c - vec2(f32(r), 0), c + vec2(f32(r), 0), 1, with_alpha(HUD, 0.15))
    line(c - vec2(0, f32(r)), c + vec2(0, f32(r)), 1, with_alpha(HUD, 0.15))
    pulse = fract(elapsed() * 0.8)
    ring(c, r * pulse, 1.5, with_alpha(HUD, f32(0.3 * (1.0 - pulse))))
    triangle(c + vec2(0, -6), c + vec2(-4, 4), c + vec2(4, 4), with_alpha(HUD, 0.9))
    loop f in foes:
        if not alive(f) or f.blip > 0.6: continue
        d = flat(f.body.pos - you.body.pos)
        l = f64(length(d))
        if l > 25.0: continue
        rel = wrap(yaw_of(d) - you.yaw)
        p = c + vec2(f32(-sin(rel) * l / 25.0 * r), f32(-cos(rel) * l / 25.0 * r))
        a = f32(1.0 - f.blip / 0.6)
        size = 5.0
        if f.kind == .lobber: size = 7.0
        circle(p, size, rgba(1.0, 0.3, 0.25, a))

# ---------------- a touch screen ----------------
# On a phone or a tablet: a finger at the left moves (a stick where it lands), one at the right
# looks, and buttons at the lower right fire, jump, zoom, throw, strike and reload. The weapon's
# box swaps weapons, the prompt over a weapon in reach takes it (held), the top left button pauses.
TOUCH_BUTTONS = ["FIRE", "JUMP", "ZOOM", "NADE", "MELEE", "RELOAD"]

struct Finger:
    id: int
    role: int                   # -1 moving, -2 looking, -3 swapping, -4 picking up, -5 pausing; else a button
    at: vec2                    # (in the HUD's units)
    from: vec2

fingers: Finger[]
touch_down: bool[6]             # each button: held,
touch_hit: bool[6]              # and pressed since the last step
touch_swap = false
touch_pause = false
touch_move = vec2(0, 0)
pick_box = Rect(0, 0, 0, 0)     # (the prompt over a weapon in reach, last drawn)
const STICK = 60.0              # how far the moving finger goes for full speed

using_touch = () -> bool: touch_device() and not settings.keys_only

# the buttons' middles and sizes (w by h: the HUD's size)
touch_spots = (w: f64, h: f64) -> (vec2, f64)[]:
    at = (x: f64, y: f64) -> vec2: vec2(f32(w - x), f32(h - y))
    [(at(118, 118), 56.0), (at(250, 64), 40.0), (at(256, 172), 34.0), (at(170, 238), 30.0), (at(64, 246), 30.0), (at(38, 168), 28.0)]

pause_spot = (w: f64, h: f64) -> (vec2, f64): (vec2(42, 42), 24.0)

# the fingers on the screen, read each frame in play
read_touch = (dt: f64):
    global fingers, touch_move, touch_pause, touch_swap
    if not using_touch(): return
    z = menu_zoom()
    v = visible_rect()
    w = f64(v.w) / z
    h = f64(v.h) / z
    ids = touch_ids()
    pts = touches()
    fingers = [loop f in fingers if ids.contains(f.id): f]
    loop i in 0..6: touch_down[i] = false
    touch_move = vec2(0, 0)
    spots = touch_spots(w, h)
    zf = 1.0 + (arm_info(guns[held]).zoom - 1.0) * zoom_k
    loop k in 0.. and id in ids:
        p = (pts[k] - vec2(v.x, v.y)) * f32(1.0 / z)
        j = -1
        loop i in 0.. and f in fingers:
            if f.id == id: j = i
        if j < 0:
            # a finger landing: on what
            role = if f64(p.x) < w * 0.45: -1 else: -2
            loop i in 0.. and s in spots:
                if f64(length(p - s.0)) < s.1 * 1.2: role = i
            ps = pause_spot(w, h)
            if f64(length(p - ps.0)) < ps.1 * 1.4: role = -5
            if let b = ui.bounds("weapon", root = "hud"):
                if contains(b, p): role = -3
            if near_pick >= 0 and contains(pick_box, p): role = -4
            if role >= 0: touch_hit[role] = true
            if role == -3: touch_swap = true
            if role == -5: touch_pause = true
            fingers.push(Finger(id, role, p, p))
            continue
        f = fingers[j]
        if f.role == -2:
            # looking: as far as the finger moved
            d = p - f.at
            s = 0.0065 * pow(3.0, sensitivity * 2.0 - 1.0) / zf
            you.yaw -= f64(d.x) * s
            if invert: you.pitch += f64(d.y) * s * 0.8
            else: you.pitch -= f64(d.y) * s * 0.8
            you.pitch = clamp(you.pitch, -1.45, 1.45)
        if f.role == -1:
            m = (p - f.from) * f32(1.0 / STICK)
            if length(m) > 1.0:
                # (the stick follows a finger that goes past its edge)
                m = normalize(m)
                fingers[j].from = p - m * f32(STICK)
            touch_move = vec2(m.x, -m.y)
        if f.role >= 0: touch_down[f.role] = true
        fingers[j].at = p

# what the fingers do in a step, into the controls
touch_controls = (c: mut Controls):
    global touch_swap
    if not using_touch(): return
    if length(touch_move) > 0.0: c.move = touch_move
    c.fire = touch_down[0]
    c.fire_pressed = c.fire_pressed or touch_hit[0]
    c.jump = c.jump or touch_hit[1]
    c.zoom = c.zoom or touch_hit[2]
    c.grenade = c.grenade or touch_hit[3]
    c.melee = c.melee or touch_hit[4]
    c.reload = c.reload or touch_hit[5]
    c.swap = c.swap or touch_swap
    loop f in fingers:
        if f.role == -4: c.pick = true
    loop i in 0..6: touch_hit[i] = false
    touch_swap = false

# the buttons and the stick, drawn
draw_touch = (w: f64, h: f64):
    if not using_touch(): return
    loop i in 0.. and s in touch_spots(w, h):
        held = touch_down[i]
        circle(s.0, s.1, rgba(0.02, 0.08, 0.12, if held: 0.55 else: 0.32))
        ring(s.0, s.1, 1.5, with_alpha(HUD, if held: 0.9 else: 0.45))
        size = if i == 0: 18.0 else: 12.0
        text_centered(TOUCH_BUTTONS[i], s.0, size, with_alpha(WHITE, if held: 1.0 else: 0.75))
    ps = pause_spot(w, h)
    circle(ps.0, ps.1, rgba(0.02, 0.08, 0.12, 0.35))
    ring(ps.0, ps.1, 1.5, with_alpha(HUD, 0.45))
    rect(f64(ps.0.x) - 7.0, f64(ps.0.y) - 8.0, 4.0, 16.0, with_alpha(WHITE, 0.8))
    rect(f64(ps.0.x) + 3.0, f64(ps.0.y) - 8.0, 4.0, 16.0, with_alpha(WHITE, 0.8))
    loop f in fingers:
        if f.role == -1:
            ring(f.from, STICK, 2, with_alpha(HUD, 0.4))
            circle(f.at, 22, with_alpha(HUD, 0.45))

# ---------------- a balance run, without a window ----------------
# BREAKWATER_TEST="runs react error": each run fought by the autopilot until it falls (or wave
# 30), then what happened
when TARGET != "wasm":
    if let spec = env("BREAKWATER_TEST"):
        words = split(spec, " ")
        n_runs = to_int(words[0]) ?? 10
        if words.len() > 1: bot_react = to_float(words[1]) ?? 0.35
        if words.len() > 2: bot_error = to_float(words[2]) ?? 0.02
        quiet = true
        build_platform()
        build_paths()
        waves_sum = 0.0
        loop r in 0..n_runs:
            seed_random(1000 + r)
            new_run()
            loop not over and wave < 30 and run_time < 1800.0:
                step(autopilot(STEP), STEP)
            if not over:
                loop f in foes:
                    if alive(f): print("  left: {f.kind} at {f.body.pos} ({f.mood}, cell walkable {grid.open[cell_of(f.body.pos)]}); player at {you.body.pos}")
            pct = 0.0
            if shots > 0: pct = f64(hits) / f64(shots) * 100.0
            print("run {r}: wave {wave}, {int(run_time)} s, score {score}, kills {kills}, accuracy {int(pct)}%, killed by {cause}, holding {[loop g in guns if g.arm >= 0: "{arms[g.arm].name} {g.ammo}/{g.reserve}"]}; damage from skitters {int(damage_by[0])}, wardens {int(damage_by[1])}, lobbers {int(damage_by[2])}")
            waves_sum += f64(wave)
        print("mean wave {waves_sum / f64(n_runs):.1}")
        exit(0)

# (made after the balance run, which opens no window)
sea_sh = make_shader(shader(sea_vs, sea_fs))

# ---------------- settings and records ----------------
struct Settings:
    music = 0.5
    sound = 0.8
    sensitivity = 0.5
    invert = false
    fov = 0.43
    fullscreen = false
    keys_only = false           # no mouse: Space fires, Shift jumps

settings = Settings()
best = 0
best_wave = 0
runs = 0

save_records = (): save_data("best", "score {best}\nwave {best_wave}\nruns {runs}")
save_settings = (): save_data("settings", "music {settings.music}\nsound {settings.sound}\nsensitivity {settings.sensitivity}\ninvert {settings.invert}\nfov {settings.fov}\nfullscreen {settings.fullscreen}\nkeys_only {settings.keys_only}")

load_saved = ():
    global best, best_wave, runs
    if let t = load_data("settings"):
        loop line in lines(t):
            w = split(line, " ")
            if w.len() < 2: continue
            v = clamp(to_float(w[1]) ?? 0.5, 0.0, 1.0)
            if w[0] == "music": settings.music = v
            else if w[0] == "sound": settings.sound = v
            else if w[0] == "sensitivity": settings.sensitivity = v
            else if w[0] == "fov": settings.fov = v
            else if w[0] == "invert": settings.invert = w[1] == "true"
            else if w[0] == "fullscreen": settings.fullscreen = w[1] == "true"
            else if w[0] == "keys_only": settings.keys_only = w[1] == "true"
    if let t = load_data("best"):
        loop line in lines(t):
            w = split(line, " ")
            if w.len() < 2: continue
            if w[0] == "score": best = max(to_int(w[1]) ?? 0, 0)
            else if w[0] == "wave": best_wave = max(to_int(w[1]) ?? 0, 0)
            else if w[0] == "runs": runs = max(to_int(w[1]) ?? 0, 0)

# keys only: Space fires and Shift jumps (and the mouse is left alone)
keys_only_bindings = ():
    if settings.keys_only:
        set_bindings("Fire", [.key(.space), .mouse(.left), .stick(5, 1)])
        set_bindings("Jump", [.key(.shift), .button(.a)])
    else:
        set_bindings("Fire", [.mouse(.left), .stick(5, 1)])
        set_bindings("Jump", [.key(.space), .button(.a)])

apply_settings = ():
    global fov_setting, invert, sensitivity, sound_volume
    sound_volume = settings.sound
    sensitivity = settings.sensitivity
    invert = settings.invert
    fov_setting = settings.fov

# ---------------- playing ----------------

enum Screen: title, play, paused, over, settings, controls

screen = Screen.title
settings_back = Screen.title
new_best = false
acc = 0.0
had_lock = false
music_id = -1
demo = false                    # (BREAKWATER_DEMO=seconds: the autopilot plays, that far in)
pending_controls = Controls(vec2(0, 0))

# the frame's input: looking turns at once; presses wait for the next step
look_held = 0.0                 # (looking with keys: how long, for the speed to build)

read_input = (dt: f64):
    global look_held, pending_controls, reload_later
    # looking slows when zoomed in, and over a raider (with a stick or keys)
    zf = 1.0 + (arm_info(guns[held]).zoom - 1.0) * zoom_k
    if is_mouse_locked() and not settings.keys_only:
        d = mouse_delta()
        s = 0.0022 * pow(3.0, sensitivity * 2.0 - 1.0) / zf
        you.yaw -= f64(d.x) * s
        if invert: you.pitch += f64(d.y) * s
        else: you.pitch -= f64(d.y) * s
    rs = right_stick()
    turn = vec2(f32(f64(rs.x) * abs(f64(rs.x))), f32(f64(rs.y) * abs(f64(rs.y))))
    keys = vec2(f32(action_axis("Look left", "Look right")), f32(action_axis("Look up", "Look down")))
    if length(keys) > 0.0:
        # (keys: slow at first for small turns, then quicker)
        look_held += dt
        turn = keys * f32(0.28 + 0.72 * min(look_held / 0.22, 1.0))
    else: look_held = 0
    slow = 1.0
    if length(turn) > 0.0:
        h = ray_foes(eye(), aim(), ray_world(eye(), aim(), 60), 0.35)
        if h.0 >= 0: slow = 0.55
    ps = 3.1 * pow(2.0, sensitivity * 2.0 - 1.0) * slow / zf
    you.yaw -= f64(turn.x) * ps * dt
    if invert: you.pitch += f64(turn.y) * ps * 0.7 * dt
    else: you.pitch -= f64(turn.y) * ps * 0.7 * dt
    you.pitch = clamp(you.pitch, -1.45, 1.45)
    you.yaw = wrap(you.yaw)
    c = pending_controls
    c.move = vec2(f32(action_axis("Left", "Right")), f32(action_axis("Back", "Forward")))
    if length(c.move) > 1.0: c.move = normalize(c.move)
    # (on a touch screen, the first finger is also the mouse: the fire button fires instead)
    if not using_touch():
        c.fire = action_down("Fire")
        c.fire_pressed = c.fire_pressed or action_pressed("Fire")
    c.zoom = c.zoom or action_pressed("Zoom")
    c.jump = c.jump or action_pressed("Jump")
    c.grenade = c.grenade or action_pressed("Grenade")
    c.melee = c.melee or action_pressed("Melee")
    c.swap = c.swap or action_pressed("Swap weapons") or mouse_wheel() != 0.0
    c.pick = action_down("Pick up")
    # (reload pressed with pick up, near a weapon: a quick press reloads, holding picks it up)
    if action_pressed("Reload"):
        if c.pick and near_pick >= 0: reload_later = true
        else: c.reload = true
    if reload_later and not c.pick:
        reload_later = false
        c.reload = true
    if reload_later and near_pick < 0: reload_later = false
    read_touch(dt)
    touch_controls(c)
    pending_controls = c

simulate = (dt: f64, auto: bool):
    global pending_controls
    acc += min(dt, 0.1)
    loop acc >= STEP:
        acc -= STEP
        c = Controls(vec2(0, 0))
        if auto: c = autopilot(STEP)
        else:
            c = pending_controls
            pending_controls = Controls(c.move, fire = c.fire, pick = c.pick)
        step(c, STEP)

start = ():
    global acc, had_lock, pending_controls, screen
    new_run()
    acc = 0
    pending_controls = Controls(vec2(0, 0))
    go(.play)
    had_lock = false
    mouse_lock(not settings.keys_only)

finish = ():
    global best, best_wave, new_best, screen
    runs += 1
    new_best = score > best
    if new_best: best = score
    best_wave = max(best_wave, wave)
    save_records()
    go(.over)
    mouse_lock(false)

# behind the title: raiders wandering the platform, the camera going round it
title_scene = ():
    global over
    new_run()
    you.alive = false
    you.health = 0
    loop i in 0..6:
        kind = Kind.skitter
        if i % 3 == 1: kind = .warden
        if i == 5: kind = .lobber
        spawn(kind, cell_pos(cover_cells[random_int(0, cover_cells.len())]))
    over = true

update = (dt: f64):
    global cam_look, cam_pos, had_lock, music_id, screen, touch_pause
    if music_id < 0 and not quiet: music_id = play(theme, settings.music, looping = true)
    m = settings.music
    if screen == .play and between <= 0.0: m *= 0.45
    set_volume(music_id, m)
    if screen == .play:
        # (a browser lets go of the mouse on Escape: that pauses)
        if is_mouse_locked(): had_lock = true
        else if had_lock:
            go(.paused)
            return
        if demo or settings.keys_only: had_lock = false
        if action_pressed("Pause") or touch_pause:
            touch_pause = false
            go(.paused)
            mouse_lock(false)
            return
        if not is_mouse_locked() and not settings.keys_only: mouse_lock(true)
        if not demo: read_input(dt)
        simulate(dt, demo)
        place_camera()
        if over and over_time > 2.2: finish()
    else if screen == .over:
        simulate(dt, false)
        place_camera()
    else if screen == .paused or settings_back == .paused: place_camera()
    else:
        simulate(dt, false)
        t = elapsed() * 0.06
        cam_pos = v3(sin(t) * 34.0, 13.0, cos(t) * 26.0)
        cam_look = v3(0, 3, 0)

draw = ():
    draw_world()
    if screen == .play or screen == .paused or screen == .over:
        draw_weapon()
        if screen == .play: draw_hud()
    if screen == .play: return
    v = visible_rect()
    # (behind a menu: the scene darkened, at the left over the title's camera flight)
    if screen == .title or ((screen == .settings or screen == .controls) and settings_back == .title): side_shade(v)
    else: rect(v, rgba(0.01, 0.03, 0.05, 0.62))
    in_menu_units((w: f64, h: f64):
        if screen == .title: title_menu(w, h)
        else if screen == .paused: pause_menu(w, h)
        else if screen == .over: over_menu(w, h)
        else if screen == .settings: settings_menu(w, h)
        else if screen == .controls: controls_menu(w, h)
    )

# ---------------- menus ----------------
# The menus are boxes laid out by `layout` (import layout as ui): at the size they would be on a
# 1280 x 720 screen, larger on a phone or a short window so their text stays readable.
menu_zoom = () -> f64:
    v = visible_rect()
    z = clamp(min(f64(v.w) / 1280.0, f64(v.h) / 720.0), 0.5, 2.5)
    if touch_device() or f64(v.h) < 560.0: z = max(z, min(f64(v.h) / 480.0, f64(v.w) / 860.0))
    z

# drawing in the menus' units (w by h of them on the screen)
in_menu_units = (draw_it: (f64, f64) -> void):
    z = menu_zoom()
    v = visible_rect()
    push_transform()
    translate(f64(v.x), f64(v.y))
    scale(z, z)
    draw_it(f64(v.w) / z, f64(v.h) / z)
    pop_transform()

menu_frame = -1                 # (the frame the screen changed: the press that changed it is used up)

go = (s: Screen):
    global menu_frame, screen
    screen = s
    menu_frame = frame_number()

# a root of boxes over the whole w by h (keys, buttons and taps ignored in the frame a screen opens)
menu_root = (key: str, w: f64, h: f64, children: () -> void, pad: f64 = 24.0, align: ui.MainAlign = .center, cross: ui.CrossAlign = .center):
    r = Rect(0, 0, f32(w), f32(h))
    if frame_number() == menu_frame or rebinding_now:
        ui.at(r, children, pad = pad, align = align, cross = cross, key = key, input = ui.Input())
    else: ui.at(r, children, pad = pad, align = align, cross = cross, key = key)

back_pressed = () -> bool: frame_number() != menu_frame and not rebinding_now and (key_pressed(.escape) or gamepad_pressed(.b))

side_shade = (v: Rect):
    c = rgba(0.01, 0.04, 0.07, 0.8)
    edge = f64(v.x) + min(f64(v.w) * 0.42, 560.0 * menu_zoom())
    fade = 260.0 * menu_zoom()
    rect(f64(v.x), f64(v.y), edge - f64(v.x), f64(v.h), c)
    quad_gradient(vec2(f32(edge), v.y), vec2(f32(edge + fade), v.y), vec2(f32(edge + fade), v.y + v.h), vec2(f32(edge), v.y + v.h), c, with_alpha(c, 0), with_alpha(c, 0), c)

style_menus = ():
    hud_style.accent = HUD
    hud_style.panel = rgba(0.02, 0.06, 0.09, 0.86)
    hud_style.button = rgba(0.09, 0.16, 0.2, 0.95)
    hud_style.hover = rgba(0.13, 0.25, 0.3, 1)
    hud_style.pressed = rgba(0.05, 0.1, 0.13, 1)
    hud_style.border = rgba(0.55, 0.95, 1.0, 0.22)
    hud_style.panel_edge = rgba(0.55, 0.95, 1.0, 0.14)
    hud_style.focus = rgba(0.75, 1.0, 1.0, 0.95)
    hud_style.field = rgba(1, 1, 1, 0.035)
    hud_style.track = rgba(1, 1, 1, 0.12)
    hud_style.radius = 6
    hud_style.panel_radius = 10

# a word in widely spaced capitals (the title)
spaced = (s: str, size: f64, gap: f64, color: vec4):
    w = 0.0
    loop i in 0..len(s): w += text_width(s[i..i + 1], size) + gap
    w -= gap
    ui.slot(width = w, height = size * 1.15, (r: Rect):
        x = f64(r.x)
        loop i in 0..len(s):
            ch = s[i..i + 1]
            text(ch, vec2(f32(x), r.y), size, color)
            x += text_width(ch, size) + gap
    )

# a key and what it does
key_hint = (keys: str, what: str):
    ui.row(gap = 7, cross = .center, ():
        ui.row(pad = ui.insets(7, 2, 7, 3), radius = 5, border = ui.Border(hud_style.border), color = rgba(1, 1, 1, 0.06), ():
            ui.label(keys, size = 13)
        )
        ui.label(what, size = 14, color = hud_style.muted)
    )

look_keys = () -> str: if settings.keys_only: "I J K L" else: "Mouse"

title_menu = (w: f64, h: f64):
    global settings_back
    short = h < 600.0
    menu_root("title", w, h, pad = if short: 20.0 else: 48.0, align = .center, cross = .start, ():
        ui.column(width = min(w * 0.42, 500.0), gap = if short: 10.0 else: 16.0, cross = .center, ():
            spaced("BREAKWATER", if short: 40.0 else: 54.0, if short: 10.0 else: 14.0, WHITE)
            ui.space(height = if short: 4.0 else: 16.0)
            ui.column(width = 300, gap = 10, ():
                if ui.button("Play", width = ui.grow(), height = 48, key = "play"): start()
                if ui.button("Settings", width = ui.grow(), height = 48, key = "settings"):
                    settings_back = .title
                    go(.settings)
                when TARGET != "wasm":
                    if ui.button("Quit", width = ui.grow(), height = 48, key = "quit"): quit()
            )
            if best > 0: ui.label("Best {best}   Wave {best_wave}", size = 18, color = HUD)
            if not touch_device() and not short:
                ui.space(height = 8)
                ui.row(gap = 16, cross = .center, ():
                    key_hint("W A S D", "Move")
                    key_hint(look_keys(), "Look")
                    key_hint(key_of("Fire"), "Fire")
                    key_hint(key_of("Jump"), "Jump")
                )
                ui.row(gap = 16, cross = .center, ():
                    key_hint(key_of("Zoom"), "Zoom")
                    key_hint(key_of("Pick up"), "Pick up")
                    key_hint(key_of("Grenade"), "Grenade")
                    key_hint(key_of("Melee"), "Melee")
                )
        )
    )

pause_menu = (w: f64, h: f64):
    global had_lock, settings_back
    resume = back_pressed() or (frame_number() != menu_frame and action_pressed("Pause") and not key_pressed(.escape))
    menu_root("pause", w, h, ():
        ui.panel(width = 340, pad = 22, gap = 10, cross = .stretch, ():
            ui.label("Paused", size = 34, align = .center, width = ui.grow())
            ui.label("Wave {wave}   Score {score}", size = 16, color = hud_style.muted, align = .center, width = ui.grow())
            ui.space(height = 6)
            if ui.button("Resume", width = ui.grow(), height = 46, key = "resume"): resume = true
            if ui.button("Restart", width = ui.grow(), height = 46, key = "restart"): start()
            if ui.button("Settings", width = ui.grow(), height = 46, key = "settings"):
                settings_back = .paused
                go(.settings)
            if ui.button("Leave to the title", width = ui.grow(), height = 46, key = "leave"):
                title_scene()
                go(.title)
        )
    )
    if resume and screen == .paused:
        go(.play)
        had_lock = false
        mouse_lock(not settings.keys_only)

clock = (t: f64) -> str:
    sec = int(t) % 60
    if sec < 10: return "{int(t) / 60}:0{sec}"
    "{int(t) / 60}:{sec}"

# a number over what it counts
figure = (value: str, what: str):
    ui.column(width = ui.grow(), cross = .center, gap = 2, ():
        ui.label(value, size = 26)
        ui.label(what, size = 13, color = hud_style.muted)
    )

over_menu = (w: f64, h: f64):
    a = 0
    if shots > 0: a = hits * 100 / shots
    menu_root("over", w, h, ():
        ui.panel(width = ui.fit(max = 520), pad = 24, gap = 12, cross = .center, ():
            ui.label("{score}", size = 72)
            if new_best: ui.label("New best", size = 22, color = HUD)
            else: ui.label("Best {best}", size = 18, color = hud_style.muted)
            ui.row(width = 440, gap = 8, pad = ui.insets(0, 8, 0, 8), ():
                figure("{wave}", "Wave")
                figure("{kills}", "Raiders")
                figure("{a}%", "Accuracy")
                figure(clock(run_time), "Time")
            )
            ui.label("Taken down by {cause}", size = 16, color = hud_style.muted)
            ui.row(width = ui.grow(), gap = 10, ():
                if ui.button("Again", width = ui.grow(), height = 46, key = "again"): start()
                if ui.button("Title", width = ui.grow(), height = 46, key = "title") or back_pressed():
                    title_scene()
                    go(.title)
            )
        )
    )

# a group of settings under its name
group = (name: str, children: () -> void):
    ui.column(width = ui.grow(), gap = 6, ():
        ui.label(name, size = 14, color = HUD)
        children()
    )

settings_menu = (w: f64, h: f64):
    was = settings
    leave = back_pressed()
    wide_left = settings_back == .title and w >= 900.0
    menu_root("settings", w, h, pad = if h < 600.0: 14.0 else: 32.0, align = .center, cross = if wide_left: ui.CrossAlign.start else: ui.CrossAlign.center, ():
        ui.panel(width = ui.fit(min = 420, max = 520), height = ui.fit(max = h - 28.0), pad = 18, gap = 12, ():
            ui.label("Settings", size = 30)
            ui.scroll(width = ui.grow(), height = ui.grow(), pad = ui.insets(0, 2, 14, 2), gap = 14, key = "list", ():
                group("Sound", ():
                    settings.music = ui.slider(settings.music, 0.0, 1.0, 0.05, "Music", height = 40, key = "music")
                    settings.sound = ui.slider(settings.sound, 0.0, 1.0, 0.05, "Sounds", height = 40, key = "sound")
                )
                group("Looking", ():
                    settings.sensitivity = ui.slider(settings.sensitivity, 0.0, 1.0, 0.05, "Look speed", height = 40, key = "look")
                    # (in degrees across the view)
                    settings.fov = (ui.slider(75.0 + 35.0 * settings.fov, 75.0, 110.0, 1.0, "Field of view", height = 40, key = "fov") - 75.0) / 35.0
                    settings.invert = ui.switch(settings.invert, "Invert look", height = 40, key = "invert")
                )
                group("Playing", ():
                    settings.keys_only = ui.switch(settings.keys_only, "Keyboard only", height = 40, key = "keys")
                    if can_fullscreen(): settings.fullscreen = ui.switch(settings.fullscreen, "Fullscreen", height = 40, key = "full")
                )
            )
            ui.row(width = ui.grow(), gap = 10, ():
                if ui.button("Controls", width = ui.grow(), height = 42, key = "controls"): go(.controls)
                if ui.button("Back", width = ui.grow(), height = 42, key = "back"): leave = true
            )
        )
    )
    apply_settings()
    if settings.sound != was.sound: sfx(snd_click, 1.0)
    if settings.fullscreen != was.fullscreen: set_fullscreen(settings.fullscreen)
    if settings.keys_only != was.keys_only: keys_only_bindings()
    if leave and screen == .settings:
        save_settings()
        go(settings_back)

# ---------------- controls ----------------
# Each action and its inputs: choosing one waits for a new key or button, which takes the place
# of its first of that kind (a key or the mouse; a gamepad's button or stick)
CONTROLS = ["Forward", "Back", "Left", "Right", "Look up", "Look down", "Look left", "Look right", "Jump", "Fire", "Zoom",
            "Grenade", "Melee", "Reload", "Pick up", "Swap weapons", "Pause"]
rebind_at = -1                  # (the action waiting for its new input)
rebinding_now = false           # (waiting, or took one this frame: the menus ignore that press)

is_pad = (x: Input) -> bool:
    match x:
        .button(b): return true
        .stick(a, d): return true
        _: pass
    false

rebind = (name: str, x: Input):
    b = bindings(name)
    loop k in 0..b.len():
        if is_pad(b[k]) == is_pad(x):
            b[k] = x
            set_bindings(name, b)
            return
    b.push(x)
    set_bindings(name, b)

controls_menu = (w: f64, h: f64):
    global rebind_at, rebinding_now
    # (waiting: the first key or button pressed, Escape to cancel; a finger's tap is not one,
    # and taps still reach the Cancel button)
    rebinding_now = rebind_at >= 0 and not touch_input()
    if rebind_at >= 0 and frame_number() > menu_frame:
        if key_pressed(.escape):
            rebind_at = -1
            rebinding_now = true
        else if let x = input_pressed():
            if not (touch_input() and x == Input.mouse(.left)):
                rebind(CONTROLS[rebind_at], x)
                rebind_at = -1
                rebinding_now = true
    leave = back_pressed()
    menu_root("controls", w, h, pad = if h < 600.0: 14.0 else: 32.0, ():
        ui.panel(width = ui.fit(min = 460, max = 600), height = ui.fit(max = h - 28.0), pad = 18, gap = 12, ():
            ui.label("Controls", size = 30)
            if rebind_at >= 0:
                ui.row(width = ui.grow(), pad = 12, gap = 10, cross = .center, radius = 8, color = with_alpha(HUD, 0.12), border = ui.Border(with_alpha(HUD, 0.5)), ():
                    ui.label(if touch_input(): "{CONTROLS[rebind_at]}: press a key or button" else: "{CONTROLS[rebind_at]}: press a key or button (Escape: cancel)", size = 17, wrap = true, width = ui.grow())
                    if touch_input() and ui.button("Cancel", height = 36, key = "cancel"): rebind_at = -1
                )
            ui.scroll(width = ui.grow(), height = ui.grow(), pad = ui.insets(0, 0, 14, 0), gap = 4, key = "list", ():
                loop i in 0.. and name in CONTROLS:
                    parts: str[]
                    loop x in bindings(name): parts.push(input_name(x))
                    on = i == rebind_at
                    got = ui.row(width = ui.grow(), height = 38, pad = ui.insets(12, 0, 12, 0), gap = 12, cross = .center, radius = 6, color = if on: with_alpha(HUD, 0.16) else: rgba(1, 1, 1, 0.035), focusable = true, key = name, ():
                        ui.label(name, size = 16, width = 140)
                        ui.label(if on: "..." else: join(parts, ", "), size = 15, color = if on: HUD else: hud_style.muted, align = .right, width = ui.grow())
                    )
                    if got.clicked and rebind_at < 0:
                        rebind_at = i
                        go(.controls)
            )
            ui.row(width = ui.grow(), gap = 10, ():
                if ui.button("Defaults", width = ui.grow(), height = 42, enabled = rebind_at < 0, key = "defaults"): reset_controls()
                if ui.button("Back", width = ui.grow(), height = 42, enabled = rebind_at < 0, key = "back"): leave = true
            )
        )
    )
    if leave and screen == .controls and rebind_at < 0: go(.settings)

style_menus()
load_saved()
apply_settings()
if settings.keys_only: keys_only_bindings()
if settings.fullscreen: set_fullscreen(true)
build_platform()
build_paths()
title_scene()
when TARGET != "wasm":
    if let d = env("BREAKWATER_DEMO"):
        start()
        demo = true
        quiet = true
        loop k in 0..int((to_float(d) ?? 0.0) / STEP): step(autopilot(STEP), STEP)
        # (BREAKWATER_ARM=n: holding that weapon, for a picture of it)
        if let w = env("BREAKWATER_ARM"):
            guns = [gun_of((to_int(w) ?? 0) as Arm), Gun()]
