# Checked file reads. Failures travel with their results; streaming none/empty means EOF.
# open_file creates a buffered File; close it when finished. Writes still report bool and
# file_error(). File reads are synchronous and hold up tasks while the operating system reads.

# an operating-system read failure, with the path and operation that failed
error struct FileError:
    message: str
    path: str
    operation: str

# read a whole UTF-8 file, omitting a leading UTF-8 BOM; read failure is never partial success
read_file = (path: str) -> str | FileError:
    r = __read_text_file(path)
    if r == none: return FileError(__file_err, path, "read_file")
    r!

# read every byte of a file, including a UTF-8 BOM; failures return FileError
read_bytes = (path: str) -> u8[] | FileError:
    r = __read_file_raw(path)
    if r == none: return FileError(__file_err, path, "read_bytes")
    bytes(r!)

# the next line without its line ending; none only at EOF, FileError on read failure
read_line = (f: mut File) -> str? | FileError:
    r = __file_read_line(f)
    if len(f.__read_error) > 0: return FileError(f.__read_error, f.path, "read_line")
    if r == none: return none
    r!

# up to n more bytes; empty only at EOF (or n=0), FileError on read failure; n must be nonnegative
read_bytes = (f: mut File, n: int) -> u8[] | FileError:
    r = __read_bytes(f, n)
    if len(f.__read_error) > 0: return FileError(f.__read_error, f.path, "read_bytes")
    r

# names in a directory, excluding . and ..; a failed listing returns FileError, never a partial list
list_dir = (path: str) -> str[] | FileError:
    r = __list_dir(path)
    if len(__list_dir_error) > 0: return FileError(__list_dir_error, path, "list_dir")
    r
