# Data parallelism on a pool of worker threads (fork-join).
#
#   squares = parallel_map(nums, (x): x * x)
#   parallel_update(particles, (p): step(p, dt))      # xs[i] = f(xs[i]), in place
#   rows = parallel_range(height, (y): render_row(y))
#
# The function runs on several threads at once: it may read anything, but it must not change
# globals or the variables it captured (that would be a data race); return results instead.
# On the web target everything runs on the calling thread.

# job control block (shared between threads, accessed atomically)
const __C_GEN = 0          # bumped to start a job (futex word for sleeping workers)
const __C_NEXT = 1         # next chunk to claim
const __C_DONE = 2         # chunks finished
const __C_ACK = 3          # workers finished with the current job (futex word for the caller)
const __C_CHUNKS = 4       # chunks in the current job
const __C_SLEEPERS = 5     # workers asleep on __C_GEN (woken only when there are some)
const __C_WAITING = 6      # the caller asleep on __C_DONE (woken only then)
__pool_ctl: *int = null
__pool_workers = 0
__job_idle_c: (int, int) -> void = __job_idle      # (made once: converting a function to a closure allocates)
__job: (int, int) -> void = __job_idle_c
__job_total = 0
__job_chunk = 1

__job_idle = (lo: int, hi: int): pass

# number of hardware threads available to this process
cpu_count = () -> int:
    when TARGET == "wasm":
        return 1
    else when TARGET == "windows":
        return max(int(GetActiveProcessorCount(u16(0xFFFF))), 1)
    else when TARGET == "macos":
        return max(int(__mac_sysconf(i32(58))), 1)                  # _SC_NPROCESSORS_ONLN
    else:
        mask = fill(0, 16)
        r = syscall(204, 0, 128, data(mask))           # sched_getaffinity
        if r <= 0: return 1
        n = 0
        loop w in mask:
            x = w
            loop x != 0:
                n += x & 1
                x = (x >> 1) & 0x7FFFFFFFFFFFFFFF
        if n < 1: n = 1
        n

when TARGET == "windows":
    @lib("kernel32.dll")
    extern GetActiveProcessorCount = (group: u16) -> u32
    @lib("kernelbase.dll")
    extern WaitOnAddress = (p: *u8, compare: *u8, size: int, ms: u32) -> i32
    @lib("kernelbase.dll")
    extern WakeByAddressAll = (p: *u8)
    @lib("kernel32.dll")
    extern CreateThread = (sec: *u8, stack: int, start: *u8, param: *u8, flags: u32, id: *u32) -> *u8

    # (no allocation: a worker sleeps in here)
    __futex_wait = (p: *int, v: int):
        cmp = v
        WaitOnAddress(p as *u8, (&cmp) as *u8, 8, u32(0xFFFFFFFF))
    __futex_wake = (p: *int): WakeByAddressAll(p as *u8)

    # a worker starts on a small stack of Windows' and moves to its own in __tstack_base (where
    # __tid finds which worker it is), entering __w32_worker as if called
    @cabi
    __w32_thread_start = (id: int) -> int:
        top = __tstack_base + (id << __TSTACK_SHIFT) - 16
        (top as *int)[1] = 0
        entry: cfn() = __w32_worker
        __jump(entry as *u8, top + 8)
        0

    @cabi
    __w32_worker = (): __thread_main(__tid())
else when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("sysconf")
    extern __mac_sysconf = (name: i32) -> int
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("pthread_create")
    extern __mac_pthread_create = (t: *u8, attr: *u8, start: *u8, arg: *u8) -> i32
    # (macOS's futex: UL_COMPARE_AND_WAIT64, waking all with ULF_WAKE_ALL)
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("__ulock_wait")
    extern __mac_ulock_wait = (op: u32, p: *u8, v: int, us: u32) -> i32
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("__ulock_wake")
    extern __mac_ulock_wake = (op: u32, p: *u8, v: int) -> i32

    __futex_wait = (p: *int, v: int): __mac_ulock_wait(u32(5), p as *u8, v, u32(0))
    __futex_wake = (p: *int): __mac_ulock_wake(u32(5 | 0x100), p as *u8, 0)

    # as on Windows: a worker starts on a stack of the system's and moves to its own
    @cabi
    __mac_thread_start = (id: *u8) -> *u8:
        top = __tstack_base + ((id as int) << __TSTACK_SHIFT) - 16
        entry: cfn() = __mac_worker
        __jump(entry as *u8, top)
        null

    @cabi
    __mac_worker = (): __thread_main(__tid())
else:
    __futex_wait = (p: *int, v: int): syscall(202, p, 128, v, 0)      # FUTEX_WAIT_PRIVATE
    __futex_wake = (p: *int): syscall(202, p, 129, 0x7FFFFFFF)        # FUTEX_WAKE_PRIVATE (all)

# claim and run chunks of the current job until none are left
__run_chunks = ():
    c = __pool_ctl
    loop true:
        k = __atomic_add(c + __C_NEXT, 1)
        if k >= c[__C_CHUNKS]: return
        __run_chunk(k)
        # (the last chunk wakes the caller, waiting for them all)
        # (a wake is a system call: made only when the caller went to sleep. It counts itself
        # asleep before it sleeps, and the sleep checks __C_DONE again: no wake is missed)
        if __atomic_add(c + __C_DONE, 1) + 1 == c[__C_CHUNKS] and __atomic_add(c + __C_WAITING, 0) > 0: __futex_wake(c + __C_DONE)

# (a function of its own, kept out of line: the reference to the job's function it takes is
# dropped before the chunk is counted done, while refcounts are still atomic; after the last
# one the caller drops its own, and two drops at once would lose one)
@noinline
__run_chunk = (k: int):
    lo = k * __job_chunk
    hi = lo + __job_chunk
    if hi > __job_total: hi = __job_total
    f = __job
    f(lo, hi)

# (a thread of the program's own, its number from its stack: a worker of the pool, or one of the
# helpers of __off_thread, whose numbers are the last ones)
__thread_main = (id: int):
    if id >= __HELPER_FIRST: __helper_main()
    else: __worker_main(id)

@cabi
__worker_main = (id: int):
    c = __pool_ctl
    seen = 0
    loop true:
        # wait for the next job: spin briefly (frames come quickly), then sleep
        spins = 0
        loop __atomic_add(c + __C_GEN, 0) == seen:
            spins += 1
            if spins > 20000:
                __atomic_add(c + __C_SLEEPERS, 1)
                __futex_wait(c + __C_GEN, seen)
                __atomic_add(c + __C_SLEEPERS, -1)
        seen = __atomic_add(c + __C_GEN, 0)
        __run_chunks()
        __atomic_add(c + __C_ACK, 1)

__pool_tried = false

__pool_start = ():
    global __pool_ctl, __pool_tried
    __pool_tried = true
    when TARGET != "wasm":
        n = cpu_count() - 1
        if let t = env("SLOPPY_THREADS"): n = (to_int(t) ?? (n + 1)) - 1      # SLOPPY_THREADS caps the threads used
        if n > __HELPER_FIRST - 1: n = __HELPER_FIRST - 1
        if n < 1: return
        __pool_ctl = __alloc(64) as *int
        loop i in [0..8): __pool_ctl[i] = 0
        if not __tstack_reserve(): return
        loop i in [0..n):
            if not __thread_start(i + 1): break
            __pool_workers += 1

# (one reserved region for the stacks of all the threads the program starts, a thread's number
# from where its stack is: pages are only touched as needed)
__tstack_reserve = () -> bool:
    global __tstack_base
    if __tstack_base != null: return true
    size = __MAX_THREADS << __TSTACK_SHIFT
    when TARGET == "windows":
        # (what the threads call, looked up here first)
        x = 0
        __futex_wake(&x)
        __futex_wait(&x, 1)
        base = VirtualAlloc(null, size, u32(0x2000), 4)               # MEM_RESERVE
        if base == null: return false
        __tstack_base = base
    else when TARGET != "wasm":
        base = syscall(9, 0, size, 3, 0x22 | 0x4000, -1, 0)       # MAP_PRIVATE|ANON|NORESERVE
        if base < 0 and base > -4096: return false
        __tstack_base = base as *u8
    true

# (thread number id started on its stack in the region: false if it could not be)
__thread_start = (id: int) -> bool:
    when TARGET == "windows":
        # (a thread's stack is committed whole: no guard pages to grow it)
        if VirtualAlloc(__tstack_base + ((id - 1) << __TSTACK_SHIFT), 1 << __TSTACK_SHIFT, u32(0x1000), 4) == null: return false
        start: cfn(int) -> int = __w32_thread_start
        return CreateThread(null, 65536, start as *u8, id as *u8, 0, null) != null
    else when TARGET == "macos":
        start: cfn(*u8) -> *u8 = __mac_thread_start
        th = [0]
        return __mac_pthread_create(data(th) as *u8, null, start as *u8, id as *u8) == 0
    else when TARGET != "wasm":
        top = __tstack_base + (id << __TSTACK_SHIFT)
        if id >= __HELPER_FIRST:
            h: cfn(int) = __helper_entry
            return __clone_thread(h as *u8, id, top) >= 0
        entry: cfn(int) = __worker_main
        return __clone_thread(entry as *u8, id, top) >= 0
    else:
        return false

# (set by library code around a parallel call whose work is too little to share: waking the
# workers and waiting for them costs more than doing it here)
__par_serial = false

# run f(lo, hi) over 0..total split into chunks, on all threads; returns when everything is done
@parallel
__parallel_run = (total: int, f: (int, int) -> void):
    global __rng_in_job
    if total <= 0: return
    # (random() in a job: each thread its own generator, the main thread too, so the numbers
    # outside parallel code are the same whether it ran on workers or here)
    __rng_threads()
    if __rng_in_job:
        __parallel_run_job(total, f)
        return
    __rng_in_job = true
    __parallel_run_job(total, f)
    __rng_in_job = false

@parallel
__parallel_run_job = (total: int, f: (int, int) -> void):
    global __job, __job_chunk, __job_total, __mt_active, __out_direct
    when TARGET == "wasm":
        f(0, total)
    else:
        if not __pool_tried: __pool_start()
        if __pool_workers == 0 or total == 1 or __mt_active or __par_serial:
            f(0, total)                       # no workers (or nested): run here
            return
        c = __pool_ctl
        threads = __pool_workers + 1
        chunk = total / (threads * 4)
        if chunk < 1: chunk = 1
        __job = f
        __job_total = total
        __job_chunk = chunk
        c[__C_CHUNKS] = (total + chunk - 1) / chunk
        c[__C_DONE] = 0
        c[__C_ACK] = 0
        __out_flush()
        __out_direct = true                 # (prints from the threads: written at once)
        __mt_active = true
        # (the chunks opened last, atomically, a barrier after everything above: a worker that
        # wakes late and claims one sees this job's function and sizes, and __mt_active, so its
        # refcounts are atomic and a parallel call inside runs in place. Swapped, not stored, so
        # that a late claim on the closed count in between is not lost)
        loop true:
            o = __atomic_add(c + __C_NEXT, 0)
            if __atomic_cas(c + __C_NEXT, o, 0) == o: break
        __atomic_add(c + __C_GEN, 1)
        # (only when some worker sleeps: the others are spinning, and see the job by themselves)
        if __atomic_add(c + __C_SLEEPERS, 0) > 0: __futex_wake(c + __C_GEN)
        __run_chunks()
        # wait until every chunk is done, not for every worker: one the system has not woken
        # yet (on a busy machine) would hold each call up by milliseconds. A worker that wakes
        # late finds no chunk to claim (the count is closed below until the next job is set up)
        # or helps with the next one.
        chunks = c[__C_CHUNKS]
        spins = 0
        loop true:
            d = __atomic_add(c + __C_DONE, 0)
            if d >= chunks: break
            spins += 1
            if spins > 2000:
                __atomic_add(c + __C_WAITING, 1)
                __futex_wait(c + __C_DONE, d)
                __atomic_add(c + __C_WAITING, -1)
        __atomic_add(c + __C_NEXT, 1 << 40)
        __mt_active = false
        __out_direct = false
        __job = __job_idle_c

# [loop x in xs: f(x)], computed in parallel (f must not change globals or what it captured)
@parallel
parallel_map[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    out: U[]
    n = xs.len()
    if n == 0: return out
    out.resize(n)
    op = data(out)
    ip = data(xs)
    # (f taken once for each chunk: calling the captured f would count a reference to it, an
    # atomic add that every thread makes on the same memory, for each element)
    __parallel_run(n, (lo: int, hi: int):
        g = f
        loop i in [lo..hi): op[i] = g(ip[i])
    )
    out

# xs[i] = f(xs[i]) for every element, in parallel
@parallel
parallel_update[T] = (xs: mut T[], f: (T) -> T):
    n = xs.len()
    if n == 0: return
    xs.reserve(n)                      # make the storage unique before sharing it
    p = data(xs)
    __parallel_run(n, (lo: int, hi: int):
        g = f
        loop i in [lo..hi): p[i] = g(p[i])
    )

# [loop i in 0..n: f(i)], computed in parallel
@parallel
parallel_range[U] = (n: int, f: (int) -> U) -> U[]:
    out: U[]
    if n <= 0: return out
    out.resize(n)
    op = data(out)
    __parallel_run(n, (lo: int, hi: int):
        g = f
        loop i in [lo..hi): op[i] = g(i)
    )
    out

# ---------------- work off the program's thread (for the library: lib/crypto.jo's passwords) ----------------
# A computation that takes long (a password's hash, a sixth of a second) holds up every task while
# it runs. __off_thread runs it on a helper thread instead: the task that asked waits, and the
# others go on. Only for work that shares nothing counted with the program (reference counts are
# not atomic here): run gets a block of plain bytes (what it reads, copied in, and room for what
# it gives), and what it makes is its own, the helper's, let go of there before it ends. A cfn
# (a @cabi function): no function value, whose count the threads would share.
#   if __off_thread_ok(): __off_thread(run, block)
#   else: ...  (the same work, here)
const __HELPERS = 4                             # (at most: Node's thread pool has as many)
const __HELPER_FIRST = __MAX_THREADS - __HELPERS + 1   # (their numbers: the region's last stacks)
# (the helpers' control block: a lock, jobs given (the futex word they sleep on), the queue's
# first and last job, helpers started, helpers asleep)
const __H_LOCK = 0
const __H_GEN = 1
const __H_HEAD = 2
const __H_TAIL = 3
const __H_STARTED = 4
const __H_ASLEEP = 5
# (a job: done, its function, the next in the queue, its block)
const __J_DONE = 0
const __J_RUN = 1
const __J_NEXT = 2
const __J_ARG = 3
__helper_ctl: *int = null
__helper_max = 0
__helper_rfd = -1           # (a pipe a helper writes a byte to as it ends a job: a task's wait ends)
__helper_wfd = -1
# (the wait of a task for a job: lib/std/task.jo's, once tasks run)
__task_job_wait_fn: (int, f64) -> void = __job_wait_plain

# (work handed to __off_thread would run on a helper: tasks run (otherwise there are no others to
# go on, and it runs here as before), on the program's thread, outside a parallel job, and not in
# a web page, which has no threads)
__off_thread_ok = () -> bool:
    when TARGET == "wasm":
        return false
    else:
        if not __tasks_on or __mt_active or __tid() != 0: return false
        if __helper_ctl == null: __helper_init()
        __helper_max > 0

__helper_init = ():
    global __helper_ctl, __helper_max, __helper_rfd, __helper_wfd
    when TARGET != "wasm":
        c = __alloc(64) as *int
        loop i in [0..8): c[i] = 0
        __helper_ctl = c
        # (one at least, beside the program's thread: on one processor too, the system shares it
        # between them; SLOPPY_THREADS=1, none, all of it on the program's thread)
        n = min(max(cpu_count() - 1, 1), __HELPERS)
        if let t = env("SLOPPY_THREADS"): n = min((to_int(t) ?? (n + 1)) - 1, n)
        if n < 1 or not __tstack_reserve(): return
        when TARGET != "windows":
            fds = [0]
            if syscall(293, data(fds), 0x80800) != 0: return              # pipe2(O_CLOEXEC | O_NONBLOCK)
            __helper_rfd = fds[0] & 0xFFFFFFFF
            __helper_wfd = fds[0] >> 32
        __helper_max = n

# run(arg) on a helper thread; the task that calls this waits until it has ended (also when it is
# cancelled: the block is in use until then), and the others take their turns
__off_thread = (run: cfn(*u8), arg: *u8):
    when TARGET != "wasm":
        c = __helper_ctl
        job = __alloc(32) as *int
        job[__J_RUN] = run as int
        job[__J_ARG] = arg as int
        __helper_lock(c)
        if c[__H_TAIL] == 0: c[__H_HEAD] = job as int
        else: (c[__H_TAIL] as *int)[__J_NEXT] = job as int
        c[__H_TAIL] = job as int
        # (another helper while there are fewer than jobs waiting, up to the most)
        start = c[__H_STARTED] < __helper_max and __atomic_add(c + __H_ASLEEP, 0) == 0
        if start: c[__H_STARTED] += 1
        id = __HELPER_FIRST + c[__H_STARTED] - 1
        __helper_unlock(c)
        __atomic_add(c + __H_GEN, 1)
        if start and not __thread_start(id):
            __helper_lock(c)
            c[__H_STARTED] -= 1
            __helper_unlock(c)
        __futex_wake(c + __H_GEN)
        # (Windows: no pipe its wait can watch; it looks again after a while, at most 10 ms)
        pause = 0.001
        loop __atomic_add(job + __J_DONE, 0) == 0:
            if __helper_rfd >= 0:
                __task_job_wait_fn(__helper_rfd, -1.0)
                __helper_drain()
            else:
                __task_job_wait_fn(-1, pause)
                pause = min(pause * 2.0, 0.01)
        __free(job as *u8)

# (the pipe's bytes read: each job's ending wrote one, and every task waiting on it has been woken)
__helper_drain = ():
    when TARGET != "windows" and TARGET != "wasm":
        buf = [0, 0, 0, 0, 0, 0, 0, 0]
        loop syscall(0, __helper_rfd, data(buf), 64) == 64: pass

# (a task's wait for a job, before tasks run: the pipe, or a sleep)
__job_wait_plain = (fd: int, seconds: f64):
    when TARGET == "windows":
        Sleep(u32(int(seconds * 1000.0) + 1))
    else when TARGET != "wasm":
        if fd < 0: return
        p = [(fd & 0xFFFFFFFF) | (1 << 32)]                   # POLLIN
        syscall(7, data(p), 1, -1)

__helper_lock = (c: *int):
    loop __atomic_cas(c + __H_LOCK, 0, 1) != 0: pass
__helper_unlock = (c: *int): __atomic_cas(c + __H_LOCK, 1, 0)

# (a helper: the queue's jobs, one at a time, asleep while there are none)
__helper_main = ():
    c = __helper_ctl
    loop true:
        seen = __atomic_add(c + __H_GEN, 0)
        __helper_lock(c)
        job = c[__H_HEAD] as *int
        if job != null:
            c[__H_HEAD] = job[__J_NEXT]
            if job[__J_NEXT] == 0: c[__H_TAIL] = 0
        __helper_unlock(c)
        if job == null:
            __atomic_add(c + __H_ASLEEP, 1)
            __futex_wait(c + __H_GEN, seen)
            __atomic_add(c + __H_ASLEEP, -1)
            continue
        run: cfn(*u8) = job[__J_RUN] as cfn(*u8)
        run(job[__J_ARG] as *u8)
        __atomic_add(job + __J_DONE, 1)
        when TARGET != "windows":
            one = [1]
            syscall(1, __helper_wfd, data(one), 1)

when TARGET != "windows" and TARGET != "macos" and TARGET != "wasm":
    @cabi
    @own_thread
    __helper_entry = (id: int): __helper_main()

# ---------------- atomics ----------------
# A whole number threads change together: parallel code may change it (and no other variable),
# as a count of work done or a flag that tells the other threads to stop. Copies of an Atomic
# are the same number.
#   found = atomic(-1)
#   parallel_range(n, (i: int) -> int:
#       if found.get() >= 0: return 0          # another thread found it: skip the rest
#       if is_answer(i): found.compare_swap(-1, i)
#       0
#   )
struct Atomic:
    __cell: int[]
    __p: *int

atomic = (v: int = 0) -> Atomic:
    cell = fill(v, 1)
    # (the pointer is taken while the array is this one's alone: copies share it from then on)
    p = data(cell)
    Atomic(cell, p)

# its value now
get = (a: Atomic) -> int:
    when TARGET == "wasm": return a.__p[0]
    else: return __atomic_add(a.__p, 0)

# add v (negative: subtract) and give the value after
add = (a: Atomic, v: int) -> int:
    when TARGET == "wasm":
        a.__p[0] += v
        return a.__p[0]
    else: return __atomic_add(a.__p, v) + v

# set it to v
set = (a: Atomic, v: int):
    loop:
        old = get(a)
        if compare_swap(a, old, v): return

# set it to v if it is `expected` (true), or leave it (false): one thread wins
compare_swap = (a: Atomic, expected: int, v: int) -> bool:
    when TARGET == "wasm":
        if a.__p[0] != expected: return false
        a.__p[0] = v
        return true
    else: return __atomic_cas(a.__p, expected, v) == expected

# make it at least v (the largest of what the threads give)
set_max = (a: Atomic, v: int):
    loop:
        old = get(a)
        if old >= v or compare_swap(a, old, v): return

# ---------------- tasks (lib/std/task.jo, read only for a program that names them) ----------------
# (once a task has started, the library's waits go through these: sockets to wait for, each one's
# 1 reading, 2 writing, and a time in seconds, -1 none; what came for each socket. A game's frame
# lets the tasks take their turns; the program's end waits for them)
__tasks_on = false
__task_wait_fn: (int[], int[], f64) -> int[] = __task_wait_none
__task_frame_fn: () -> void = __task_none
__task_end_fn: () -> void = __task_none
# (stopping() asked in the running task; a panic's report, which tells the task's spawn; a socket
# about to be closed, whose waiters are woken; the waiters of a list (ids and waits) woken; the
# running task's place on such a list (its id and the wait it is about to begin))
__task_stop_fn: () -> void = __task_none
__task_panic_fn: () -> void = __task_none
__task_closing_fn: (int) -> void = __task_closing_none
__task_wake_fn: (int[]) -> void = __task_wake_none
__task_waiter_fn: () -> (int, int) = __task_waiter_none
__task_cancelling = false   # (the running task has been cancelled: its waits end at once)
# (the running task's number, each task's its own: 0 for main, and in a program without tasks)
__task_id_fn: () -> int = __task_id_none
__task_id_none = () -> int: 0
# (called when a panic is caught, in the task that panicked: lib/sqlite.jo rolls back its
# transaction)
__caught_fns: (() -> void)[]
__task_wait_none = (fds: int[], want: int[], seconds: f64) -> int[]: fill(0, fds.len())
__task_none = (): pass
__task_closing_none = (fd: int): pass
__task_wake_none = (ws: int[]): pass
__task_waiter_none = () -> (int, int): (0, 0)
