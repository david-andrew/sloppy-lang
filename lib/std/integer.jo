# Number theory on whole numbers, as contests and puzzles want it: greatest common divisors,
# square roots and arithmetic modulo m, exact for every int (no float in between):
#
#   gcd(12, 18)                  # 6
#   isqrt(10 ^ 18 - 1)           # 999999999
#   pow_mod(3, 10 ^ 18, 1_000_000_007)
#   inv_mod(2, 1_000_000_007)    # 500000004 (an optional: none when there is none)
#   mul_mod(a, b, m)             # a * b mod m without overflow, for m up to 2^63
#
# The results of the modulo functions are from 0 to m - 1, negative arguments too (as `mod(x,
# m)`; `%` keeps the sign of x). Past 64 bits, BigInt keeps every digit, with gcd, isqrt,
# pow_mod and the others for it too (bigint.jo).

# the greatest common divisor, 0 or more (gcd(0, 0) is 0; gcd(-4, 6) is 2)
gcd = (a: int, b: int) -> int: int(gcd(__abs_u64(a), __abs_u64(b)))
gcd = (a: u64, b: u64) -> u64:
    x = a
    y = b
    loop y != 0:
        t = x % y
        x = y
        y = t
    x

# the least common multiple, 0 or more (0 when either is 0; it wraps around when it does not
# fit, as `*` does)
lcm = (a: int, b: int) -> int:
    if a == 0 or b == 0: return 0
    abs(a / gcd(a, b) * b)
lcm = (a: u64, b: u64) -> u64:
    if a == 0 or b == 0: return 0
    a / gcd(a, b) * b

# the whole square root: the largest r with r * r <= n (isqrt(15) is 3), exact where
# int(sqrt(f64(n))) is not (past 2^52)
isqrt = (n: int) -> int:
    if n < 0: panic("isqrt of a negative number ({n})")
    r = int(sqrt(f64(n)))
    loop r > 0 and r > n / r: r -= 1
    loop r + 1 <= n / (r + 1): r += 1
    r

# a * b mod m, from 0 to m - 1, with the 128-bit product (a * b % m overflows once a * b passes
# 2^63, as it does for m past about 3e9)
mul_mod = (a: int, b: int, m: int) -> int:
    if m <= 0: panic("mul_mod: the modulus must be more than 0, not {m}")
    x = mod(a, m)
    y = mod(b, m)
    if m <= 3037000499: return x * y % m
    int(__mod128(__mul_high(x as u64, y as u64), (x as u64) * (y as u64), m as u64))
mul_mod = (a: u64, b: u64, m: u64) -> u64:
    if m == 0: panic("mul_mod: the modulus must be more than 0")
    x = a % m
    y = b % m
    __mod128(__mul_high(x, y), x * y, m)

# base to the power e, mod m (from 0 to m - 1), in about log2(e) steps: pow_mod(2, 10 ^ 18,
# 1_000_000_007). A negative e is a power of base's inverse (pow_mod(2, -1, 7) is 4); without
# one it stops the program (inv_mod says whether there is one)
pow_mod = (base: int, e: int, m: int) -> int:
    if m <= 0: panic("pow_mod: the modulus must be more than 0, not {m}")
    b = mod(base, m)
    k = e
    if k < 0:
        b = inv_mod(b, m) ?? panic("pow_mod: {base} has no inverse mod {m} (they have a common divisor), so no negative power")
        k = -k
    r = 1 % m
    if m <= 3037000499:
        loop k > 0:
            if k & 1 == 1: r = r * b % m
            b = b * b % m
            k = k >> 1
        return r
    um = m as u64
    ur = r as u64
    ub = b as u64
    loop k > 0:
        if k & 1 == 1: ur = __mod128(__mul_high(ur, ub), ur * ub, um)
        ub = __mod128(__mul_high(ub, ub), ub * ub, um)
        k = k >> 1
    int(ur)
pow_mod = (base: u64, e: u64, m: u64) -> u64:
    if m == 0: panic("pow_mod: the modulus must be more than 0")
    b = base % m
    k = e
    r = u64(1) % m
    loop k > 0:
        if k & 1 == 1: r = __mod128(__mul_high(r, b), r * b, m)
        b = __mod128(__mul_high(b, b), b * b, m)
        k = k >> 1
    r

# the inverse of a mod m: the x from 0 to m - 1 with a * x mod m == 1, or none when a and m have
# a common divisor (inv_mod(3, 7) is 5; inv_mod(2, 4) is none). For a prime m it is also
# pow_mod(a, m - 2, m)
inv_mod = (a: int, m: int) -> int?:
    if m <= 0: panic("inv_mod: the modulus must be more than 0, not {m}")
    r0 = m
    r1 = mod(a, m)
    t0 = 0
    t1 = 1
    loop r1 != 0:
        q = r0 / r1
        r2 = r0 - q * r1
        r0 = r1
        r1 = r2
        t2 = t0 - q * t1
        t0 = t1
        t1 = t2
    if r0 != 1: return none
    mod(t0, m)

# parse a whole number from 0 to 2^64 - 1 (to_int stops at 2^63 - 1), as to_int does: decimal,
# or hex after 0x, binary after 0b, octal after 0o; _ may separate digits; none if it is not
# one, is negative or does not fit
to_u64 = (s: str) -> u64?: __to_u64(s, 0)

# a whole number from 0 to 2^64 - 1 written in base 2 to 36 (to_u64("ffffffffffffffff", 16))
to_u64 = (s: str, base: int) -> u64?:
    if base < 2 or base > 36: panic("to_u64: a base from 2 to 36, not {base}")
    __to_u64(s, base)

__to_u64 = (s: str, base0: int) -> u64?:
    t = trim(s)
    n = len(t)
    i = 0
    if n > 0 and t[0] == '+': i = 1
    if i >= n: return none
    base = base0
    if base == 0: base = 10
    if i + 1 < n and t[i] == '0':
        p = t[i + 1] | 0x20
        pb = 0
        if p == 'x': pb = 16
        else if p == 'b': pb = 2
        else if p == 'o': pb = 8
        if pb > 0 and (base0 == 0 or base0 == pb):
            base = pb
            i += 2
    ub = u64(base)
    v = u64(0)
    any = false
    loop i < n:
        c = t[i]
        d = -1
        if c >= '0' and c <= '9': d = int(c) - 48
        else if c >= 'a' and c <= 'z': d = int(c) - 87
        else if c >= 'A' and c <= 'Z': d = int(c) - 55
        else if c == '_':
            i += 1
            continue
        if d < 0 or d >= base: return none
        if v > (u64(0xFFFFFFFFFFFFFFFF) - u64(d)) / ub: return none
        v = v * ub + u64(d)
        any = true
        i += 1
    if not any: return none
    v

# (|x| as a u64: 2^63 for the smallest int)
__abs_u64 = (x: int) -> u64:
    if x < 0: return u64(0) - (x as u64)
    x as u64

# ((hi * 2^64 + lo) mod m, for hi < m: Hacker's Delight's divlu, the remainder only)
__mod128 = (hi: u64, lo: u64, m: u64) -> u64:
    if hi == 0: return lo % m
    B = u64(1) << 32
    s = leading_zeros(m as int)
    v = m << u64(s)
    vn1 = v >> 32
    vn0 = v & 0xFFFFFFFF
    un32 = hi << u64(s)
    if s > 0: un32 = un32 | (lo >> u64(64 - s))
    un10 = lo << u64(s)
    un1 = un10 >> 32
    un0 = un10 & 0xFFFFFFFF
    q1 = un32 / vn1
    rhat = un32 - q1 * vn1
    loop q1 >= B or q1 * vn0 > (rhat << 32) + un1:
        q1 -= 1
        rhat += vn1
        if rhat >= B: break
    un21 = (un32 << 32) + un1 - q1 * v
    q0 = un21 / vn1
    rhat = un21 - q0 * vn1
    loop q0 >= B or q0 * vn0 > (rhat << 32) + un0:
        q0 -= 1
        rhat += vn1
        if rhat >= B: break
    ((un21 << 32) + un0 - q0 * v) >> u64(s)
