# Key repeats as a game wants them (PICO-8's btnp): key_repeat, gamepad_repeat, action_repeat.

# (This file is read only for a program that names one of them: compiler/check.jo, on_demand_names.)

# true in the frame the key was pressed, then again while it is held: after `delay` seconds, each
# `period` seconds (PICO-8's btnp: a quarter second, then 15 times a second); for moving through a
# menu or a grid a step at a time. It counts the game's time, the same in a SLOPPY_INPUT run; in a
# fixed_update step, the steps'. gamepad_repeat and action_repeat are the same for a button and an
# action.
key_repeat = (k: Key, delay: f64 = 0.25, period: f64 = 1.0 / 15.0) -> bool: __repeat(int(k), key_down(k), key_pressed(k), delay, period)

# (each key, button or action repeat asks for, in frames and apart in steps: the frame or step it
# was last asked in, how long it had been held then and whether that was a repeat)
struct __Rep:
    tick = -10
    held = 0.0
    fired = false
__reps: {int: __Rep}

__repeat = (id0: int, down: bool, pressed: bool, delay: f64, period: f64) -> bool:
    id = id0 * 2
    t = __frame_count
    dt = __raw_dt
    if __fx_in:
        id += 1
        t = __fx_steps
        dt = __fx_h
    r = __reps.get(id) ?? __Rep()
    if r.tick == t: return r.fired
    held = r.held
    r.fired = pressed
    # (held from the press on: asked first while it is held, it counts from then)
    if pressed or not down or r.tick != t - 1: r.held = 0.0
    else:
        r.held = held + dt
        r.fired = __repeats(r.held, delay, period) > __repeats(held, delay, period)
    r.tick = t
    __reps[id] = r
    r.fired

# (how many repeats have come after held seconds: -1 before the first)
__repeats = (held: f64, delay: f64, period: f64) -> int:
    if held < delay - 1e-6: return -1
    int(floor((held - delay) / max(period, 1e-3) + 1e-6))

# true as the button is pressed, then again while it is held, as key_repeat
gamepad_repeat = (pad: int, b: PadButton, delay: f64 = 0.25, period: f64 = 1.0 / 15.0) -> bool:
    __repeat(1000 + pad * 15 + int(b), gamepad_down(pad, b), gamepad_pressed(pad, b), delay, period)
gamepad_repeat = (b: PadButton, delay: f64 = 0.25, period: f64 = 1.0 / 15.0) -> bool: __repeat(2000 + int(b), gamepad_down(b), gamepad_pressed(b), delay, period)

# true as the action is pressed, then again while it is held, as key_repeat (a menu's up and down)
action_repeat = (name: str, player: int = -1, delay: f64 = 0.25, period: f64 = 1.0 / 15.0) -> bool:
    __repeat(3000 + __ctl_get(name) * 16 + player + 1, action_down(name, player), action_pressed(name, player), delay, period)
