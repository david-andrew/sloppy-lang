# Bytes and bits: whole numbers in byte arrays (file formats, network messages) in little- or
# big-endian order, bit counting and turning, and bytes from C.
#   header: u8[]
#   append_le(header, 0x46464952, 4)              # "RIFF"
#   append_le(header, 36 + n, 4)
#   size = get_le(file, 4, 4)                     # 4 bytes at offset 4, little-endian
#   rate = get_be(packet, 0, 2)
#   rate_f = f32_from_bits(u32(get_le(file, 8, 4)))   # a float's bytes
# Sizes are 1 to 8 bytes (3 for a 24-bit field); get_le and get_be give the bytes as an unsigned
# number (8 bytes: its bits as an int), get_le_signed and get_be_signed with their sign. A float's
# bits are a u64 (f64_bits) and these take an int: `append_le(b, int(f64_bits(x)), 8)`, and back
# `f64_from_bits(u64(get_le(b, at, 8)))`; to_bytes(xs) and array_from_bytes[f64](b) do a whole array.

# the size-byte number at b[at..], least significant byte first
get_le = (b: u8[], at: int, size: int) -> int:
    # (the usual sizes in place: one load; every system Sloppy builds for is little-endian)
    if at >= 0 and at + size <= b.len():
        p = data(b) + at
        if size == 4: return int((p as *u32)[0])
        if size == 8: return (p as *int)[0]
        if size == 2: return int((p as *u16)[0])
        if size == 1: return int(p[0])
    __bytes_check(b, at, size)
    v = 0
    loop i in [0..size): v |= int(b[at + i]) << (8 * i)
    v

# the size-byte number at b[at..], most significant byte first (network order)
get_be = (b: u8[], at: int, size: int) -> int:
    __bytes_check(b, at, size)
    v = 0
    loop i in [0..size): v = (v << 8) | int(b[at + i])
    v

get_le_signed = (b: u8[], at: int, size: int) -> int: __sign_extend(get_le(b, at, size), size)
get_be_signed = (b: u8[], at: int, size: int) -> int: __sign_extend(get_be(b, at, size), size)

# v as size bytes at b[at..] (b grows to hold them), least or most significant byte first
put_le = (b: mut u8[], at: int, size: int, v: int):
    __bytes_room(b, at, size)
    loop i in [0..size): b[at + i] = u8((v >> (8 * i)) & 0xFF)
put_be = (b: mut u8[], at: int, size: int, v: int):
    __bytes_room(b, at, size)
    loop i in [0..size): b[at + i] = u8((v >> (8 * (size - 1 - i))) & 0xFF)

# v as size bytes at the end of b
append_le = (b: mut u8[], v: int, size: int): put_le(b, b.len(), size, v)
append_be = (b: mut u8[], v: int, size: int): put_be(b, b.len(), size, v)

__bytes_check = (b: u8[], at: int, size: int):
    if size < 1 or size > 8: panic("a size of {size} bytes (1 to 8)")
    if at < 0 or at + size > b.len(): panic("{size} bytes at {at} of {b.len()}")

__bytes_room = (b: mut u8[], at: int, size: int):
    if size < 1 or size > 8: panic("a size of {size} bytes (1 to 8)")
    if at < 0: panic("bytes at {at}")
    if at + size > b.len(): b.resize(at + size)

__sign_extend = (v: int, size: int) -> int:
    if size >= 8: return v
    bits = 8 * size
    if (v >> (bits - 1)) & 1 == 1: return v - (1 << bits)
    v

# ---------------- bits ----------------
# how many bits are 1
popcount = (x: int) -> int:
    v = u64(x)
    v = v - ((v >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
    int((v * 0x0101010101010101) >> 56)

# how many 0 bits come before the highest 1 (64 for 0)
leading_zeros = (x: int) -> int:
    if x == 0: return 64
    v = u64(x)
    n = 0
    loop s in [32, 16, 8, 4, 2, 1]:
        if v >> u64(64 - s) == 0:
            n += s
            v = v << u64(s)
    n

# how many 0 bits come after the lowest 1 (64 for 0)
trailing_zeros = (x: int) -> int:
    if x == 0: return 64
    v = u64(x)
    n = 0
    loop s in [32, 16, 8, 4, 2, 1]:
        if v << u64(64 - s) == 0:
            n += s
            v = v >> u64(s)
    n

# the bits turned by n places (those going out at one end come back at the other)
rotate_left = (x: int, n: int) -> int:
    k = n & 63
    if k == 0: return x
    int((u64(x) << u64(k)) | (u64(x) >> u64(64 - k)))
rotate_right = (x: int, n: int) -> int: rotate_left(x, 64 - (n & 63))

# (each of the above for a number of each size, counting and turning its own bits: a u32's 32)
popcount = (x: u8) -> int: popcount(int(x))
leading_zeros = (x: u8) -> int: leading_zeros(int(x)) - 56
trailing_zeros = (x: u8) -> int: min(trailing_zeros(int(x)), 8)
rotate_left = (x: u8, n: int) -> u8:
    k = n & 7
    if k == 0: return x
    (x << u8(k)) | (x >> u8(8 - k))
rotate_right = (x: u8, n: int) -> u8: rotate_left(x, 8 - (n & 7))
popcount = (x: u16) -> int: popcount(int(x))
leading_zeros = (x: u16) -> int: leading_zeros(int(x)) - 48
trailing_zeros = (x: u16) -> int: min(trailing_zeros(int(x)), 16)
rotate_left = (x: u16, n: int) -> u16:
    k = n & 15
    if k == 0: return x
    (x << u16(k)) | (x >> u16(16 - k))
rotate_right = (x: u16, n: int) -> u16: rotate_left(x, 16 - (n & 15))
popcount = (x: u32) -> int: popcount(int(x))
leading_zeros = (x: u32) -> int: leading_zeros(int(x)) - 32
trailing_zeros = (x: u32) -> int: min(trailing_zeros(int(x)), 32)
rotate_left = (x: u32, n: int) -> u32:
    k = n & 31
    if k == 0: return x
    (x << u32(k)) | (x >> u32(32 - k))
rotate_right = (x: u32, n: int) -> u32: rotate_left(x, 32 - (n & 31))
popcount = (x: u64) -> int: popcount(int(x))
leading_zeros = (x: u64) -> int: leading_zeros(int(x))
trailing_zeros = (x: u64) -> int: trailing_zeros(int(x))
rotate_left = (x: u64, n: int) -> u64:
    k = n & 63
    if k == 0: return x
    (x << u64(k)) | (x >> u64(64 - k))
rotate_right = (x: u64, n: int) -> u64: rotate_left(x, 64 - (n & 63))
popcount = (x: i8) -> int: popcount(int(u8(x)))
leading_zeros = (x: i8) -> int: leading_zeros(int(u8(x))) - 56
trailing_zeros = (x: i8) -> int: min(trailing_zeros(int(u8(x))), 8)
rotate_left = (x: i8, n: int) -> i8: i8(rotate_left(u8(x), n))
rotate_right = (x: i8, n: int) -> i8: i8(rotate_right(u8(x), n))
popcount = (x: i16) -> int: popcount(int(u16(x)))
leading_zeros = (x: i16) -> int: leading_zeros(int(u16(x))) - 48
trailing_zeros = (x: i16) -> int: min(trailing_zeros(int(u16(x))), 16)
rotate_left = (x: i16, n: int) -> i16: i16(rotate_left(u16(x), n))
rotate_right = (x: i16, n: int) -> i16: i16(rotate_right(u16(x), n))
popcount = (x: i32) -> int: popcount(int(u32(x)))
leading_zeros = (x: i32) -> int: leading_zeros(int(u32(x))) - 32
trailing_zeros = (x: i32) -> int: min(trailing_zeros(int(u32(x))), 32)
rotate_left = (x: i32, n: int) -> i32: i32(rotate_left(u32(x), n))
rotate_right = (x: i32, n: int) -> i32: i32(rotate_right(u32(x), n))

# the bytes of a size-byte number in the other order (0x1234, 2 -> 0x3412)
byte_swap = (x: int, size: int = 8) -> int:
    v = 0
    loop i in [0..size): v = (v << 8) | ((x >> (8 * i)) & 0xFF)
    v

# ---------------- plain values ----------------
# a plain value's bytes as it is in memory (numbers, bools, vectors, fixed-size arrays and structs
# of them; no str or T[]): a machine's state saved in one go, `write_bytes(path, to_bytes(cpu))`.
# They are this program's layout of the type, on a little-endian machine (every one Sloppy runs
# on): for reading back with from_bytes, not a file format for other programs
@plain
to_bytes[T] = (x: T) -> u8[]:
    v = x
    bytes_from(&v as *u8, size_of(T))

# the plain value whose bytes are b (from to_bytes): `from_bytes[Cpu](read_bytes(path) ?? [])`;
# none when b is not the size of a T
@plain
from_bytes[T] = (b: u8[]) -> T?:
    if b.len() != size_of(T): return none
    v: T
    mem_copy(&v as *u8, data(b), size_of(T))
    v

# an array of plain values: its elements' bytes one after another (n f64s are 8n bytes, as in a C
# array and NumPy's tobytes): `write_bytes(path, to_bytes(weights))`
@plain
to_bytes[T] = (xs: T[]) -> u8[]:
    if xs.len() == 0: return []
    bytes_from(data(xs) as *u8, xs.len() * size_of(T))

# the array whose elements' bytes are b (from to_bytes): `array_from_bytes[f64](read_bytes(path) ?? [])`;
# none when b is not a whole number of them
@plain
array_from_bytes[T] = (b: u8[]) -> T[]?:
    if b.len() % size_of(T) != 0: return none
    xs: T[]
    xs.resize(b.len() / size_of(T))
    if b.len() > 0: mem_copy(data(xs) as *u8, data(b), b.len())
    xs

# ---------------- from C ----------------
# a copy of the n bytes at p
bytes_from = (p: *u8, n: int) -> u8[]:
    out = fill(u8(0), max(n, 0))
    if n > 0: mem_copy(data(out), p, n)
    out

# a copy of C's text at p, up to its zero byte ("" for null)
str_from_c = (p: *u8) -> str: __cstr(p)
