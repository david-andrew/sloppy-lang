# JSON: parse_json reads text into a Json value (or a JsonError saying where it is wrong), and
# to_json writes one. Reading: get (a field), at (an element) and the as_* functions all take a
# Json? and give an optional, so they chain, and a missing piece anywhere gives none:
#   j = parse_json(text)
#   if j is JsonError: return j
#   width = j.get("width").as_int() ?? 0
#   name = j.get("layers").at(0).get("name").as_str() ?? "?"
#   loop l in j.get("layers").as_list(): print(l.get("name").as_str() ?? "")
# For JSON straight into your own structs and back, from_json[Config](text) and to_json(value)
# are in "Saving, and values as text" (they give a TextError, with the same message, line, column).

# a whole number in the text is an integer, kept exactly as written while it fits in an int; any
# other is a number (as_num and as_int read both). print shows a Json as JSON text
enum Json: null_, boolean(b: bool), integer(i: int), number(n: f64), text(s: str), list(items: Json[]), object(keys: str[], values: Json[])

struct JsonError:
    message: str
    line: int
    column: int

struct __JsonReader:
    s: str
    i = 0
    err = ""

parse_json = (s: str) -> Json | JsonError:
    r = __JsonReader(s)
    v = __json_value(r, 0)
    __json_space(r)
    if r.err == "" and r.i < len(s): r.err = "more after the end of the value"
    if r.err != "":
        # (a web server's error page where JSON was expected)
        t = trim_start(s)
        if len(t) > 0 and t[0] == '<' and r.i <= len(s) - len(t):
            r.err = "this is HTML (a web page, an error page perhaps), not JSON: it starts with '<'"
        line = 1
        col = 1
        loop k in [0..min(r.i, len(s))):
            if s[k] == '\n':
                line += 1
                col = 1
            else: col += 1
        return JsonError(r.err, line, col)
    v

__json_space = (r: mut __JsonReader):
    s = r.s
    i = r.i
    loop i < len(s):
        c = s[i]
        if c != ' ' and c != '\n' and c != '\r' and c != '\t': break
        i += 1
    r.i = i

__json_fail = (r: mut __JsonReader, msg: str) -> Json:
    if r.err == "": r.err = msg
    Json.null_

__json_value = (r: mut __JsonReader, depth: int) -> Json:
    __json_space(r)
    if r.i >= len(r.s): return __json_fail(r, "a value was expected, found the end")
    if depth > 500: return __json_fail(r, "nested too deeply")
    c = r.s[r.i]
    if c == '\{':
        r.i += 1
        keys: str[]
        values: Json[]
        __json_space(r)
        if r.i < len(r.s) and r.s[r.i] == '}':
            r.i += 1
            return Json.object(keys, values)
        loop r.err == "":
            __json_space(r)
            if r.i >= len(r.s) or r.s[r.i] != '"': return __json_fail(r, "a field name (in quotes) was expected")
            keys.push(__json_string(r))
            __json_space(r)
            if r.i >= len(r.s) or r.s[r.i] != ':': return __json_fail(r, "':' was expected after a field name")
            r.i += 1
            values.push(__json_value(r, depth + 1))
            __json_space(r)
            if r.i < len(r.s) and r.s[r.i] == ',': r.i += 1
            else if r.i < len(r.s) and r.s[r.i] == '}':
                r.i += 1
                return Json.object(keys, values)
            else: return __json_fail(r, "',' or '}' was expected")
        return Json.null_
    if c == '[':
        r.i += 1
        items: Json[]
        __json_space(r)
        if r.i < len(r.s) and r.s[r.i] == ']':
            r.i += 1
            return Json.list(items)
        loop r.err == "":
            items.push(__json_value(r, depth + 1))
            __json_space(r)
            if r.i < len(r.s) and r.s[r.i] == ',': r.i += 1
            else if r.i < len(r.s) and r.s[r.i] == ']':
                r.i += 1
                return Json.list(items)
            else: return __json_fail(r, "',' or ']' was expected")
        return Json.null_
    if c == '"': return Json.text(__json_string(r))
    if c == '-' or c >= '0' and c <= '9':
        # (infinity, which JSON leaves out, as JavaScript's and Python's write it)
        if __json_word(r, "-Infinity"): return Json.number(-1e308 * 10.0)
        return __json_number(r)
    if c == 't' and __json_word(r, "true"): return Json.boolean(true)
    if c == 'f' and __json_word(r, "false"): return Json.boolean(false)
    if c == 'n' and __json_word(r, "null"): return Json.null_
    if c == 'I' and __json_word(r, "Infinity"): return Json.number(1e308 * 10.0)
    if c == 'N' and __json_word(r, "NaN"): return Json.number(0.0 / 0.0)
    __json_fail(r, "a value was expected")

# (at a '-' or a digit) a whole number as an integer, while it fits in an int (as Python's json
# reads it), anything else as a number
__json_number = (r: mut __JsonReader) -> Json:
    s = r.s
    n = len(s)
    start = r.i
    i = start
    neg = s[i] == '-'
    if neg: i += 1
    # (up to 15 digits and 22 decimals, or an exponent that keeps within 10^22, read here: m
    # times or over a power of ten is then exactly rounded)
    m = 0
    digits = 0
    loop i < n and s[i] >= '0' and s[i] <= '9':
        m = m * 10 + int(s[i]) - 48
        digits += 1
        i += 1
    places = 0
    if i < n and s[i] == '.':
        i += 1
        loop i < n and s[i] >= '0' and s[i] <= '9':
            m = m * 10 + int(s[i]) - 48
            digits += 1
            places += 1
            i += 1
        if places == 0: digits = 0
    ex = 0
    exs = false
    if i < n and (s[i] == 'e' or s[i] == 'E'):
        i += 1
        eneg = false
        if i < n and (s[i] == '+' or s[i] == '-'):
            eneg = s[i] == '-'
            i += 1
        loop i < n and s[i] >= '0' and s[i] <= '9':
            if ex < 10000: ex = ex * 10 + int(s[i]) - 48
            exs = true
            i += 1
        if not exs: digits = 0
        if eneg: ex = -ex
    if digits == 0:
        return __json_fail(r, "not a number")
    r.i = i
    if places == 0 and not exs:
        if digits <= 18:
            if neg: m = -m
            return Json.integer(m)
        if let v = to_int(s[start..i)): return Json.integer(v)
    else if digits <= 15:
        e = ex - places
        if e >= 0 and e <= 22:
            v = f64(m) * __TX_POW10[e]
            if neg: v = -v
            return Json.number(v)
        if e < 0 and e >= -22:
            v = f64(m) / __TX_POW10[-e]
            if neg: v = -v
            return Json.number(v)
    if let v = to_float(s[start..i)): return Json.number(v)
    r.i = start
    __json_fail(r, "not a number")

__json_word = (r: mut __JsonReader, w: str) -> bool:
    if r.i + len(w) > len(r.s) or not __mem_eq(data(r.s) + r.i, data(w), len(w)): return false
    r.i += len(w)
    true

__json_hex4 = (r: mut __JsonReader) -> int:
    v = 0
    loop k in [0..4):
        if r.i >= len(r.s): return -1
        c = r.s[r.i]
        d = -1
        if c >= '0' and c <= '9': d = int(c) - int('0')
        else if c >= 'a' and c <= 'f': d = int(c) - int('a') + 10
        else if c >= 'A' and c <= 'F': d = int(c) - int('A') + 10
        if d < 0: return -1
        v = v * 16 + d
        r.i += 1
    v

__utf8_push = (b: mut u8[], cp: int):
    if cp < 0x80: b.push(u8(cp))
    else if cp < 0x800:
        b.push(u8(0xC0 | (cp >> 6)))
        b.push(u8(0x80 | (cp & 0x3F)))
    else if cp < 0x10000:
        b.push(u8(0xE0 | (cp >> 12)))
        b.push(u8(0x80 | ((cp >> 6) & 0x3F)))
        b.push(u8(0x80 | (cp & 0x3F)))
    else:
        b.push(u8(0xF0 | (cp >> 18)))
        b.push(u8(0x80 | ((cp >> 12) & 0x3F)))
        b.push(u8(0x80 | ((cp >> 6) & 0x3F)))
        b.push(u8(0x80 | (cp & 0x3F)))

# (at the opening quote)
__json_string = (r: mut __JsonReader) -> str:
    s = r.s
    n = len(s)
    r.i += 1
    # (text with no escapes in it: the slice of it, made at once)
    i = r.i
    loop i < n and s[i] != '"' and s[i] != '\\': i += 1
    if i < n and s[i] == '"':
        t = s[r.i..i)
        r.i = i + 1
        return t
    b: u8[]
    __buf_append_raw(b, data(s) + r.i, i - r.i)
    r.i = i
    loop true:
        if r.i >= n:
            __json_fail(r, "the text has no closing '\"'")
            return ""
        c = s[r.i]
        r.i += 1
        if c == '"': break
        if c != '\\':
            b.push(c)
            continue
        if r.i >= n: continue
        e = s[r.i]
        r.i += 1
        if e == 'n': b.push('\n')
        else if e == 't': b.push('\t')
        else if e == 'r': b.push('\r')
        else if e == 'b': b.push(u8(8))
        else if e == 'f': b.push(u8(12))
        else if e == 'u':
            cp = __json_hex4(r)
            if cp < 0:
                __json_fail(r, "\\u needs four hex digits")
                return ""
            # (a surrogate pair: one character beyond the first 65536)
            if cp >= 0xD800 and cp < 0xDC00 and __json_word(r, "\\u"):
                lo = __json_hex4(r)
                if lo >= 0xDC00 and lo < 0xE000: cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
            __utf8_push(b, cp)
        else: b.push(e)
    str_from_bytes(b)

# ---------------- reading ----------------
# an object's field
get = (j: Json?, key: str) -> Json?:
    if j is Json:
        match j:
            .object(keys, values):
                loop i in 0.. and k in keys:
                    if k == key: return values[i]
            _: pass
    none

# a list's element
at = (j: Json?, i: int) -> Json?:
    if j is Json:
        match j:
            .list(items):
                if i >= 0 and i < items.len(): return items[i]
            _: pass
    none

as_num = (j: Json?) -> f64?:
    if j is Json:
        match j:
            .number(n): return n
            .integer(i): return f64(i)
            _: pass
    none

# (a number with a fraction: its whole part)
as_int = (j: Json?) -> int?:
    if j is Json:
        match j:
            .integer(i): return i
            .number(n): return int(n)
            _: pass
    none

as_str = (j: Json?) -> str?:
    if j is Json:
        match j:
            .text(s): return s
            _: pass
    none

as_bool = (j: Json?) -> bool?:
    if j is Json:
        match j:
            .boolean(b): return b
            _: pass
    none

# a list's elements (none: an empty array)
as_list = (j: Json?) -> Json[]:
    if j is Json:
        match j:
            .list(items): return items
            _: pass
    []

# an object's field names, in order
keys = (j: Json?) -> str[]:
    if j is Json:
        match j:
            .object(ks, vs): return ks
            _: pass
    []

is_null = (j: Json?) -> bool:
    if j is Json:
        match j:
            .null_: return true
            _: pass
    false

# ---------------- writing ----------------
# JSON text for a value (indent > 0: on several lines, indented by that many spaces)
to_json = (j: Json, indent: int = 0) -> str:
    b: u8[]
    __json_write(b, j, indent, 0)
    str_from_bytes(b)

# any value as JSON: a struct as an object (by field name), an array, tuple or vector as a list,
# a map as an object (its keys as text), none as null, an enum's variant as its name (one with
# fields as {"name": [fields]}), and a Json inside it as itself; from_json[T] reads it back
to_json[T] = (x: T, indent: int = 0) -> str:
    if indent > 0: return to_json(json_value(x), indent)
    # (on one line: written as to_text's text is read, with no Json made in between)
    r = __TextIn(to_text(x))
    b: u8[]
    __json_of_text_write(r, b)
    str_from_bytes(b)

# any value as a Json (what to_json writes for it)
json_value[T] = (x: T) -> Json:
    r = __TextIn(to_text(x))
    __json_of_text(r)

# (to_text's text of a value, as a Json)
__json_of_text = (r: mut __TextIn) -> Json:
    k = __tx_kind(r)
    if k == 1:
        s = ""
        __read(r, s)
        return Json.text(s)
    if k == 2:
        # (a whole number: exactly, as an integer, unless it is beyond an int: a u64's)
        at = r.i
        if let i = to_int(__tx_word(r, true)): return Json.integer(i)
        r.i = at
    if k == 2 or k == 3:
        v = 0.0
        __read(r, v)
        return Json.number(v)
    if k == 4:
        __tx_word(r, false)
        return Json.null_
    if k == 5:
        b = false
        __read(r, b)
        return Json.boolean(b)
    if k == 8 or k == 10:
        close: u8 = ']'
        if k == 10: close = ')'
        r.i += 1
        items: Json[]
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, close): break
            items.push(__json_of_text(r))
        return Json.list(items)
    if k == 9:
        r.i += 1
        keys: str[]
        vals: Json[]
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, '}}'): break
            kv = __json_of_text(r)
            match kv:
                .text(t): keys.push(t)
                _: keys.push(to_json(kv))
            __tx_want(r, ':')
            vals.push(__json_of_text(r))
        return Json.object(keys, vals)
    if k == 6:
        name = r.name
        __tx_word(r, false)
        __tx_want(r, '(')
        # (a struct names its fields: Name(a=1); a vector or an enum's variant does not)
        at = r.i
        w = __tx_word(r, false)
        named = len(w) > 0 and __tx_eat(r, '=')
        r.i = at
        keys: str[]
        vals: Json[]
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, ')'): break
            if named:
                keys.push(__tx_word(r, false))
                __tx_want(r, '=')
            vals.push(__json_of_text(r))
        if named: return Json.object(keys, vals)
        if starts_with(name, "vec") or starts_with(name, "ivec") or name == "mat4": return Json.list(vals)
        # (a Json inside the value: what it stands for)
        if vals.len() == 1 and (name == "boolean" or name == "integer" or name == "number" or name == "text" or name == "list"): return vals[0]
        if vals.len() == 2 and name == "object":
            match vals[0]:
                .list(ks):
                    match vals[1]:
                        .list(vs):
                            names: str[]
                            loop kj in ks:
                                match kj:
                                    .text(t): names.push(t)
                                    _: names.push(to_json(kj))
                            return Json.object(names, vs)
                        _: pass
                _: pass
        return Json.object([name], [Json.list(vals)])
    if k == 7:
        w = __tx_word(r, false)
        if w == "null_": return Json.null_
        return Json.text(w)
    __tx_fail(r, "a value that is not JSON")
    Json.null_

# (to_text's text of a value, written as JSON: what __json_of_text reads, as __json_write writes
# it with no indent)
__json_of_text_write = (r: mut __TextIn, b: mut u8[]):
    k = __tx_kind(r)
    if k == 2 or k == 3:
        # (a number as to_text wrote it: whole numbers exactly, a float as its shortest text,
        # which JSON reads the same; a whole one without its .0, as __json_write writes it)
        __tx_word_at(r, true)
        w0 = r.n0
        w1 = r.n1
        if k == 3:
            w = r.s[w0..w1)
            if w == "inf" or w == "-inf" or w == "nan":
                wr = __TextIn(w)
                __json_write(b, __json_of_text(wr), 0, 0)
                return
            if find(w, "e") < 0 and ends_with(w, ".0") and w != "-0.0": w1 -= 2
        __buf_append_raw(b, data(r.s) + w0, w1 - w0)
        return
    if k == 8 or k == 10:
        close: u8 = ']'
        if k == 10: close = ')'
        r.i += 1
        b.push('[')
        n = 0
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, close): break
            if n > 0: b.push(',')
            __json_of_text_write(r, b)
            n += 1
        b.push(']')
        return
    if k == 9:
        r.i += 1
        b.push('\{')
        n = 0
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, '}}'): break
            if n > 0: b.push(',')
            # (a key that is not text: its JSON, as text)
            if __tx_kind(r) == 1: __json_of_text_write(r, b)
            else: __json_write_str(b, to_json(__json_of_text(r)))
            __tx_want(r, ':')
            b.push(':')
            __json_of_text_write(r, b)
            n += 1
        b.push('}')
        return
    if k == 6:
        name = r.name
        # (a Json inside the value, and vectors: as __json_of_text reads them)
        if name == "boolean" or name == "integer" or name == "number" or name == "text" or name == "list" or name == "object" or starts_with(name, "vec") or starts_with(name, "ivec") or name == "mat4":
            __json_write(b, __json_of_text(r), 0, 0)
            return
        __tx_word(r, false)
        __tx_want(r, '(')
        # (a struct names its fields: Name(a=1); an enum's variant does not)
        at = r.i
        w = __tx_word(r, false)
        named = len(w) > 0 and __tx_eat(r, '=')
        r.i = at
        b.push('\{')
        if not named:
            __json_write_str(b, name)
            __json_put(b, ":[")
        n = 0
        loop len(r.err) == 0:
            __tx_eat(r, ',')
            if __tx_eat(r, ')'): break
            if n > 0: b.push(',')
            if named:
                __tx_word_at(r, false)
                __json_write_str(b, r.s[r.n0..r.n1))
                __tx_want(r, '=')
                b.push(':')
            __json_of_text_write(r, b)
            n += 1
        if not named: b.push(']')
        b.push('}')
        return
    __json_write(b, __json_of_text(r), 0, 0)

__json_put = (b: mut u8[], s: str): __buf_append_str(b, s)

__json_newline = (b: mut u8[], indent: int, level: int):
    if indent <= 0: return
    b.push('\n')
    loop k in [0..indent * level): b.push(' ')

__json_write_str = (b: mut u8[], s: str):
    b.push('"')
    # (the runs of plain characters between escapes, copied whole)
    run = 0
    loop k in [0..len(s)):
        c = s[k]
        if c != '"' and c != '\\' and c >= u8(32): continue
        __buf_append_raw(b, data(s) + run, k - run)
        run = k + 1
        if c == '"' or c == '\\':
            b.push('\\')
            b.push(c)
        else if c == '\n': __json_put(b, "\\n")
        else if c == '\t': __json_put(b, "\\t")
        else if c == '\r': __json_put(b, "\\r")
        else:
            __json_put(b, "\\u00")
            b.push("0123456789abcdef"[int(c) >> 4])
            b.push("0123456789abcdef"[int(c) & 15])
    __buf_append_raw(b, data(s) + run, len(s) - run)
    b.push('"')

__json_write = (b: mut u8[], j: Json, indent: int, level: int):
    match j:
        .null_: __json_put(b, "null")
        .boolean(v):
            if v: __json_put(b, "true")
            else: __json_put(b, "false")
        .number(n):
            # (whole numbers without a fraction; JSON has no infinity or NaN: written as
            # Python's json and JavaScript's numbers name them, and read back)
            if n != n: __json_put(b, "NaN")
            else if n - n != 0.0 and n > 0.0: __json_put(b, "Infinity")
            else if n - n != 0.0: __json_put(b, "-Infinity")
            else if n == 0.0 and 1.0 / n < 0.0: __json_put(b, "-0.0")
            else if n == floor(n) and abs(n) <= 9007199254740992.0: __fmt(b, int(n))      # (2^53: every whole number below is exact)
            else: __fmt(b, n)
        .integer(i): __fmt(b, i)
        .text(s): __json_write_str(b, s)
        .list(items):
            # (a list of numbers, bools and nulls stays on one line: a map's tiles are rows,
            # not one number a line)
            flat = true
            loop x in items:
                match x:
                    .list(_): flat = false
                    .object(_, _): flat = false
                    .text(_): flat = false
                    _: pass
            b.push('[')
            loop i in 0.. and x in items:
                if i > 0:
                    b.push(',')
                    if flat and indent > 0: b.push(' ')
                if not flat: __json_newline(b, indent, level + 1)
                __json_write(b, x, indent, level + 1)
            if items.len() > 0 and not flat: __json_newline(b, indent, level)
            b.push(']')
        .object(ks, vs):
            b.push('\{')
            loop i in 0.. and k in ks:
                if i > 0: b.push(',')
                __json_newline(b, indent, level + 1)
                __json_write_str(b, k)
                b.push(':')
                if indent > 0: b.push(' ')
                __json_write(b, vs[i], indent, level + 1)
            if ks.len() > 0: __json_newline(b, indent, level)
            b.push('}')

# (print and "{j}" show a Json as its JSON text; to_text and saving write its variant)
__fmt = (buf: mut u8[], j: Json):
    if __text_exact: __fmt_fields(buf, j)
    else: __json_write(buf, j, 0, 0)
