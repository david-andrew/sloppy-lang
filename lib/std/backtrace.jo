# Backtraces at a panic (called by __panic in lib/core/rt.jo).

# where the functions on the call stack were called from: return addresses found through the
# frame pointers, function names in the program file's .symtab, lines in its .sloppy_lines
# (written by the compiler: compiler/x64.jo, x64_line_table)
__in_backtrace = false

__backtrace = ():
    when TARGET != "wasm":
        jb = __alloc(192)
        __setjmp(jb)
        # (the frame pointer: rbp, the jump buffer's second word; arm64's x29, its eleventh)
        when ARCH == "arm64":
            __backtrace_from((jb as *int)[10], 0)
        else:
            __backtrace_from((jb as *int)[1], 0)

# the frames from frame pointer fp (pc: where the program was, when it is not in a call; 0:
# none). Runs of the same call (deep recursion) are told once, with a count, and so are a few
# calls over and over (functions calling each other): a return address of -2 - p after p of them
# counts how many times they are there. Of a deeper stack than that makes short, the innermost
# 200 calls and the outermost 200 are kept (where it went wrong, and where the program's own code
# called it from), with a return address of -1 between them.
__backtrace_from = (fp0: int, pc: int):
    global __in_backtrace
    when TARGET != "wasm":
        if __in_backtrace: return
        __in_backtrace = true
        rets: int[]
        counts: int[]
        cyc = 0                 # (the calls before the last are p calls over and over: p)
        cyc_at = 0              # (how many of them the next calls are, so far)
        # (the outermost, once there are 200 of the innermost: a ring of the last 200)
        ring_r = fill(0, 200)
        ring_c = fill(0, 200)
        ring_n = 0
        if pc != 0:
            rets.push(pc + 1)
            counts.push(1)
        fp = fp0
        n = 0
        loop n < 1000000000 and fp != 0 and fp & 7 == 0:
            ret = (fp as *int)[1]
            next = (fp as *int)[0]
            # (Apple's arm64 signs return addresses in their top bits, which makes them negative:
            # the address is the low 47)
            when TARGET == "macos": ret = ret & 0x7FFFFFFFFFFF
            if ret == 0: break
            m = rets.len()
            if cyc > 0 and rets[m - 1 - cyc + cyc_at] == ret:
                cyc_at += 1
                if cyc_at == cyc:
                    counts[m - 1] += 1
                    cyc_at = 0
            else:
                # (the calls over and over end: those of them that came again are calls of their own)
                if cyc > 0:
                    loop k in [0..cyc_at):
                        rets.push(rets[m - 1 - cyc + k])
                        counts.push(1)
                    cyc = 0
                    m = rets.len()
                if ring_n == 0 and m > 0 and rets[m - 1] == ret: counts[m - 1] += 1
                else if ring_n == 0 and m < 200:
                    rets.push(ret)
                    counts.push(1)
                    cyc = __bt_cycle(rets, counts)
                    cyc_at = 0
                else if ring_n > 0 and ring_r[(ring_n - 1) % 200] == ret: ring_c[(ring_n - 1) % 200] += 1
                else:
                    ring_r[ring_n % 200] = ret
                    ring_c[ring_n % 200] = 1
                    ring_n += 1
            n += 1
            # (frames of callers are above; another stack -- a thread's parent -- is not followed)
            if next <= fp or next - fp > (1 << 23): break
            fp = next
        if ring_n > 200:
            rets.push(-1)
            counts.push(0)
        loop k in [max(ring_n - 200, 0)..ring_n):
            rets.push(ring_r[k % 200])
            counts.push(ring_c[k % 200])
        __backtrace_out(rets, counts)
        __in_backtrace = false

__backtrace_out = (rets: int[], counts: int[]):
    when TARGET == "windows":
        __backtrace_print_pe(rets, counts)
    else when TARGET == "macos":
        __backtrace_print_macho(rets, counts)
    else when TARGET != "wasm":
        if let exe = read_bytes("/proc/self/exe"): __backtrace_print(rets, counts, exe)

# (the calls of return addresses rets, as more "called from" lines: where a task was spawned,
# lib/std/task.jo, spawn itself left out)
__bt_site = false
__backtrace_site = (rets: int[]):
    global __bt_site, __in_backtrace
    if __in_backtrace: return
    __in_backtrace = true
    __bt_site = true
    __backtrace_out(rets, fill(1, rets.len()))
    __bt_site = false
    __in_backtrace = false

# (the last 2p calls are p calls twice, for p up to 6: they become p calls and a count of 2;
# gives p, or 0)
__bt_cycle = (rets: mut int[], counts: mut int[]) -> int:
    m = rets.len()
    loop p in [2..6]:
        if m < 2 * p: return 0
        same = true
        loop k in [0..p):
            a = m - 2 * p + k
            if rets[a] < 0 or counts[a] != 1 or counts[a + p] != 1 or rets[a] != rets[a + p]:
                same = false
                break
        if same:
            loop k in [0..p):
                rets.pop()
                counts.pop()
            rets.push(-2 - p)
            counts.push(2)
            return p
    0

# (the calls on the stack from frame pointer fp: how deep a stack overflow got)
__stack_depth = (fp0: int) -> int:
    n = 0
    when TARGET != "wasm":
        fp = fp0
        loop fp != 0 and fp & 7 == 0 and (fp as *int)[1] != 0:
            n += 1
            next = (fp as *int)[0]
            if next <= fp or next - fp > (1 << 23): break
            fp = next
    n

__overflow_what = (fp: int) -> str:
    "stack overflow, {__stack_depth(fp):,} calls deep (a function that calls itself without end? Recursion this deep wants a loop instead, with an array as its stack if it needs one)"

# ---------------- crashes ----------------
# a segmentation fault (a stack overflow, or a bad pointer in code using raw pointers or C) or
# another fatal signal is told like a panic, with a backtrace. The handler runs on a stack of
# its own, since a stack overflow leaves none.
# (the compiler puts a call of __crash_install first in a native program)
when TARGET == "windows":
    # (a vectored handler: it comes before Windows looks for handlers through the stack, which
    # it cannot do in code without unwind tables. It runs on the stack the exception happened on:
    # for a stack overflow Windows keeps 64 KB at the stack's end to tell it in. Wine commits the
    # whole stack at once and keeps no more than 8 KB: there a guard page 64 KB above the end
    # tells of it.)
    __crash_install = () -> bool:
        if env("SLOPPY_NO_CRASH_HANDLER") != none: return false
        f: cfn(*u8) -> i32 = __w32_crash
        AddVectoredExceptionHandler(1, f as *u8)
        room = u32(64 << 10)
        SetThreadStackGuarantee(&room)
        __w32_stack_guard()
        true

    # (again after a stack overflow the program went on from: the interactive prompt's session.
    # On Windows the page is not there until the stack first gets to it, nor needed.)
    __w32_stack_guard = ():
        lo = [0]
        hi = [0]
        GetCurrentThreadStackLimits(data(lo), data(hi))
        old: u32[] = [0]
        if lo[0] != 0: VirtualProtect((lo[0] + (64 << 10)) as *u8, 4096, u32(0x104), data(old))   # PAGE_READWRITE | PAGE_GUARD

    __w32_image_size = () -> int:
        base = 0x400000 as *u8
        int(((base + int(((base + 0x3C) as *u32)[0]) + 24 + 56) as *u32)[0])

    # (EXCEPTION_POINTERS: the record (code at 0, address at 32 + 8) and the registers (CONTEXT:
    # rsp at 0x98, rbp at 0xA0, rip at 0xF8). Only faults in the program's own code: libraries
    # may handle their exceptions themselves.)
    @cabi
    __w32_crash = (ep: *u8) -> i32:
        global __w32_panic_at
        rec = (ep as **u8)[0]
        ctx = (ep as **u8)[1]
        code = int((rec as *u32)[0])
        rsp = ((ctx + 0x98) as *int)[0]
        rbp = ((ctx + 0xA0) as *int)[0]
        rip = ((ctx + 0xF8) as *int)[0]
        # (code of the interactive prompt's inputs is the program's too: lib/std/repl.jo)
        if (rip < 0x400000 or rip >= 0x400000 + __w32_image_size()) and (rip < __repl_lo or rip >= __repl_hi): return 0          # EXCEPTION_CONTINUE_SEARCH
        if code != 0x80000001 and code != 0xC00000FD and code != 0xC0000005 and code != 0xC0000094 and code != 0xC0000095 and code != 0xC000001D and code != 0xC0000096: return 0
        what = "crashed (exception 0x{code:x})"
        if code == 0x80000001 or code == 0xC00000FD: what = __overflow_what(rbp)
        else if code == 0xC0000005:
            a = ((rec + 40) as *int)[0]
            if a < rsp + 4096 and a > rsp - (1 << 20): what = __overflow_what(rbp)
            else: what = "crashed: memory access at 0x{a:x} (a bad pointer, in code using raw pointers or C?)"
        else if code == 0xC0000094 or code == 0xC0000095: what = "arithmetic error"
        else if code == 0xC000001D or code == 0xC0000096: what = "illegal instruction"
        __w32_panic_at = __w32_err_kept.len()
        __term_reset_fn()
        __write_err("panic: {what}\n")
        __backtrace_from(rbp, rip)
        if __repl_crashed(ctx): return -1                                    # EXCEPTION_CONTINUE_EXECUTION
        __w32_crash_report()
        __exit(101)
        0

    # A program with nowhere to write its errors (a game, double-clicked: it has no console)
    # that panics or crashes: what it would have written is shown in a message box, and kept in
    # crash.txt in its save folder (with what it wrote to standard error before)
    __w32_crash_report = ():
        global __w32_box_args, __w32_box_text, __w32_box_title
        if not __w32_err_nowhere() or __w32_err_kept.len() == 0: return
        all = str_from_bytes(__w32_err_kept)
        text = str_from_bytes(__w32_err_kept[min(__w32_panic_at, __w32_err_kept.len())..])
        lines = split(text, "\n")
        if lines.len() > 25: text = join(lines[..25), "\n") + "\n..."
        name = PROGRAM_NAME
        if len(name) == 0: name = "The program"
        msg = "{name} stopped because of an error:\n\n{trim(text)}"
        dir = save_dir()
        path = "{dir}\\crash.txt"
        make_dirs(dir)
        if write_file(path, replace(all, "\n", "\r\n")): msg += "\n\nThis is also in {path}"
        # (shown from a thread of its own: after a stack overflow this one has little stack left)
        __w32_box_text = __wide(msg)
        __w32_box_title = __wide(name)
        __w32_box_args = [data(__w32_box_text), data(__w32_box_title), __ffi_resolve("user32.dll", "MessageBoxW") as *u16]
        f: cfn(*u8) -> u32 = __w32_box_thread
        t = CreateThread(null, 0, f as *u8, data(__w32_box_args) as *u8, 0, null)
        if t != null: WaitForSingleObject(t, u32(0xFFFFFFFF))

    __w32_box_text: u16[]
    __w32_box_title: u16[]
    __w32_box_args: *u16[]

    # (on a thread Windows started, which has none of a Sloppy thread's own: no allocating)
    @cabi
    __w32_box_thread = (p: *u8) -> u32:
        a = p as **u16
        box = (a[2] as *u8) as cfn(*u8, *u16, *u16, u32) -> i32
        box(null, a[0], a[1], u32(0x10 | 0x10000 | 0x40000))         # MB_ICONERROR | MB_SETFOREGROUND | MB_TOPMOST
        u32(0)
else when TARGET == "macos":
    __crash_install = () -> bool:
        if env("SLOPPY_NO_CRASH_HANDLER") != none: return false
        size = 1 << 16
        st = fill(0, 3)
        st[0] = __os_pages(size) as int
        st[1] = size
        __c_sigaltstack(data(st) as *u8, null)
        h: cfn(i32, *u8, *u8) = __crash
        act = fill(0, 2)
        act[0] = h as int
        act[1] = (1 | 4 | 0x40) << 32                       # SA_ONSTACK | SA_RESETHAND | SA_SIGINFO
        loop sig in [4, 8, 10, 11]: __c_sigaction(i32(sig), data(act) as *u8, null)
        true

    # (ucontext's uc_mcontext, a pointer, at 48; in it x0-x28 from 16, then fp, lr, sp, pc;
    # siginfo's si_addr at 24)
    @cabi
    __crash = (sig: i32, info: *u8, uc: *u8):
        g = (((uc + 48) as **u8)[0] + 16) as *int
        rbp = g[29]
        rsp = g[31]
        rip = g[32]
        what = "crashed (signal {sig})"
        if sig == 11 or sig == 10:
            a = ((info + 24) as *int)[0]
            if a < rsp + 4096 and a > rsp - (1 << 20): what = __overflow_what(rbp)
            else: what = "crashed: memory access at 0x{a:x} (a bad pointer, in code using raw pointers or C?)"
        else if sig == 8: what = "arithmetic error"
        else if sig == 4: what = "illegal instruction"
        if env("SLOPPY_CRASH_DETAIL") != none: what = "{what} [signal {sig}, address 0x{((info + 24) as *int)[0]:x}, sp 0x{rsp:x}, pc 0x{rip:x}, thread {__tid()}]"
        __term_reset_fn()
        __write_err("panic: {what}\n")
        __backtrace_from(rbp, rip)
        __exit(101)
else when TARGET != "wasm":
    __crash_install = () -> bool:
        if env("SLOPPY_NO_CRASH_HANDLER") != none: return false
        size = 1 << 16
        alt = __os_pages(size)
        st = fill(0, 3)
        st[0] = alt as int
        st[2] = size
        syscall(131, data(st), 0)                          # sigaltstack
        h: cfn(i32, *u8, *u8) = __crash
        act = fill(0, 4)
        act[0] = h as int
        act[1] = 4 | 0x08000000 | 0x04000000 | 0x80000000   # SA_SIGINFO | SA_ONSTACK | SA_RESTORER | SA_RESETHAND
        act[2] = h as int                                  # (never returned to)
        loop sig in [4, 7, 8, 11]: syscall(13, sig, data(act), 0, 8)    # rt_sigaction
        true

    @cabi
    __crash = (sig: i32, info: *u8, uc: *u8):
        # the registers when it happened (x86-64: ucontext_t's uc_mcontext.gregs at 40; arm64:
        # uc_mcontext at 176, its x0-x30 from 184, then sp and pc)
        rbp = 0
        rsp = 0
        rip = 0
        when ARCH == "arm64":
            g = (uc + 184) as *int
            rbp = g[29]
            rsp = g[31]
            rip = g[32]
        else:
            g = (uc + 40) as *int
            rbp = g[10]
            rsp = g[15]
            rip = g[16]
        addr = (info + 16) as *int
        what = "crashed (signal {sig})"
        if sig == 11 or sig == 7:
            a = addr[0]
            if a < rsp + 4096 and a > rsp - (1 << 20): what = __overflow_what(rbp)
            else: what = "crashed: memory access at 0x{a:x} (a bad pointer, in code using raw pointers or C?)"
        else if sig == 8: what = "arithmetic error"
        else if sig == 4: what = "illegal instruction"
        __term_reset_fn()
        __write_err("panic: {what}\n")
        __backtrace_from(rbp, rip)
        __exit(101)

__u16_at = (b: u8[], o: int) -> int: int(b[o]) | (int(b[o + 1]) << 8)
__u32_at = (b: u8[], o: int) -> int: __u16_at(b, o) | (__u16_at(b, o + 2) << 16)
__u64_at = (b: u8[], o: int) -> int: __u32_at(b, o) | (__u32_at(b, o + 4) << 32)

__cstr_at = (b: u8[], o: int) -> str:
    e = o
    loop e < b.len() and b[e] != 0: e += 1
    str_from_bytes(b[o..e))

# the function each return address is in, from the program file's .symtab; then the report
__backtrace_print = (rets: int[], counts: int[], exe: u8[]):
    if exe.len() < 64 or exe[0] != 0x7F: return
    shoff = __u64_at(exe, 0x28)
    shnum = __u16_at(exe, 0x3C)
    shstr = __u16_at(exe, 0x3E)
    if shnum == 0 or shoff + shnum * 64 > exe.len(): return
    names_off = __u64_at(exe, shoff + shstr * 64 + 24)
    sym_off = 0
    sym_size = 0
    str_off = 0
    lines_off = 0
    text_addr = 0
    loop i in [0..shnum):
        h = shoff + i * 64
        nm = __cstr_at(exe, names_off + __u32_at(exe, h))
        if nm == ".symtab":
            sym_off = __u64_at(exe, h + 24)
            sym_size = __u64_at(exe, h + 32)
        else if nm == ".strtab": str_off = __u64_at(exe, h + 24)
        else if nm == ".sloppy_lines": lines_off = __u64_at(exe, h + 24)
        else if nm == ".text": text_addr = __u64_at(exe, h + 16)
    if sym_off == 0 or lines_off == 0: return
    fnames: str[]
    loop ret in rets:
        fname = ""
        s = sym_off
        loop s + 24 <= sym_off + sym_size:
            v = __u64_at(exe, s + 8)
            sz = __u64_at(exe, s + 16)
            if ret > v and ret <= v + sz:
                fname = __cstr_at(exe, str_off + __u32_at(exe, s))
                break
            s += 24
        when WATCH:
            if len(fname) == 0: fname = __watch_fn_of(ret)
        fnames.push(fname)
    __backtrace_report(rets, counts, fnames, exe, lines_off, text_addr)

# (Windows: the program's .sloppy section, where it is loaded: compiler/pe.jo, pe_backtrace_info)
__backtrace_print_pe = (rets: int[], counts: int[]):
    base = 0x400000 as *u8
    pe = base + int(((base + 0x3C) as *u32)[0])
    nsec = int(((pe + 6) as *u16)[0])
    sects = pe + 24 + int(((pe + 20) as *u16)[0])
    text_addr = 0
    info: u8[]
    loop i in [0..nsec):
        h = sects + i * 40
        nm = __cstr(h)
        if len(nm) > 8: nm = nm[..8)
        rva = int(((h + 12) as *u32)[0])
        size = int(((h + 8) as *u32)[0])
        if nm == ".text": text_addr = 0x400000 + rva
        else if nm == ".sloppy":
            info = fill(u8(0), size)
            mem_copy(data(info), base + rva, size)
    __backtrace_print_info(rets, counts, info, text_addr)

# (macOS: the same in __TEXT's __sloppy section, found through the program's Mach-O header
# where dyld put it: compiler/macho.jo)
__backtrace_print_macho = (rets: int[], counts: int[]):
    when TARGET == "macos":
        mh = __c_dyld_get_image_header(0)
        if mh == null: return
        ncmds = int(((mh + 16) as *u32)[0])
        lc = mh + 32
        text_addr = 0
        info: u8[]
        loop k in [0..ncmds):
            cmd = int((lc as *u32)[0])
            if cmd == 0x19 and __cstr(lc + 8) == "__TEXT":
                vm = ((lc + 24) as *int)[0]
                nsect = int(((lc + 64) as *u32)[0])
                loop j in [0..nsect):
                    sc = lc + 72 + 80 * j
                    nm = __cstr(sc)
                    if len(nm) > 16: nm = nm[..16)
                    at = mh + (((sc + 32) as *int)[0] - vm)
                    size = ((sc + 40) as *int)[0]
                    if nm == "__text": text_addr = at as int
                    else if nm == "__sloppy":
                        info = fill(u8(0), size)
                        mem_copy(data(info), at, size)
            lc = lc + int(((lc + 4) as *u32)[0])
        __backtrace_print_info(rets, counts, info, text_addr)

# (the functions' names and places, then the line table: compiler/x64.jo, pe_backtrace_info)
__backtrace_print_info = (rets: int[], counts: int[], info: u8[], text_addr: int):
    if info.len() < 8 or info[0] != 'S' or info[3] != '1': return
    n = __u32_at(info, 4)
    p = 8
    starts = fill(0, n)
    ends = fill(0, n)
    names: str[]
    loop k in [0..n):
        starts[k] = text_addr + __u32_at(info, p)
        ends[k] = starts[k] + __u32_at(info, p + 4)
        ln = __u32_at(info, p + 8)
        names.push(str_from_bytes(info[p + 12..p + 12 + ln)))
        p += 12 + ln
    fnames: str[]
    loop ret in rets:
        fname = ""
        loop k in [0..n):
            if ret > starts[k] and ret <= ends[k]:
                fname = names[k]
                break
        when WATCH:
            if len(fname) == 0: fname = __watch_fn_of(ret)
        fnames.push(fname)
    if p + 4 <= info.len(): __backtrace_report(rets, counts, fnames, info, p, text_addr)

# the frames shown, with the lines of the calls from the line table at b[lines_off..]
__backtrace_report = (rets: int[], counts: int[], fnames: str[], b: u8[], lines_off: int, text_addr: int):
    # the line table: return address -> (file, line)
    files: str[]
    p = lines_off + 4
    nf = __u32_at(b, p)
    p += 4
    loop k in [0..nf):
        n = __u32_at(b, p)
        files.push(str_from_bytes(b[p + 4..p + 4 + n)))
        p += 4 + n
    ne = __u32_at(b, p)
    p += 4
    addrs = fill(0, ne)
    fis = fill(0, ne)
    lns = fill(0, ne)
    a = text_addr
    loop k in [0..ne):
        v = 0
        loop j in [0..3):
            x = 0
            sh = 0
            loop true:
                c = int(b[p])
                p += 1
                x |= (c & 127) << sh
                sh += 7
                if c < 128: break
            if j == 0: v = x
            else if j == 1: fis[k] = x
            else: lns[k] = x
        a += v
        addrs[k] = a
    # the calls shown: what each is, and how many times over (-1: a line as it is)
    lines: str[]
    times: int[]
    line_at: int[]          # (the lines before each of rets)
    game_loop = false
    loop ri in 0.. and ret in rets:
        line_at.push(lines.len())
        if ret == -1:
            if lines.len() > 0:
                lines.push("...")
                times.push(-1)
            continue
        if ret < -1 and ret >= -8:
            # (the calls of the p before, over and over: those of them shown)
            k = lines.len() - line_at[ri + 2 + ret]
            if k > 0:
                lines.push("(the {k} calls above, {counts[ri]:,} times over)")
                times.push(-1)
            continue
        fname = fnames[ri]
        # (runtime and library internals are left out; update and draw are called by the game loop,
        # which the top level starts: no line of it is where they were called from)
        if fname == "__game_run": game_loop = true
        if len(fname) == 0 or starts_with(fname, "__") or fname == "_start" or fname == "_main": continue
        if __bt_site and fname == "spawn": continue
        what = __fn_display(fname)
        if len(what) == 0: continue
        if game_loop and starts_with(fname, "init_") and lines.len() > 0:
            lines.push("called by the game loop, each frame")
            times.push(-1)
            break
        lo = 0
        hi = ne - 1
        found = -1
        loop lo <= hi:
            mid = (lo + hi) / 2
            if addrs[mid] == ret:
                found = mid
                break
            if addrs[mid] < ret: lo = mid + 1
            else: hi = mid - 1
        if found >= 0 and fis[found] < files.len():
            # (where a task starts its function: lib/std/task.jo's spawn)
            if fname == "lambda" and files[fis[found]] == "task.jo": continue
            what = "{what} ({files[fis[found]]}:{lns[found]})"
        else:
            # (code sloppy watch put in after a change: lib/std/watch.jo)
            when WATCH:
                at = __watch_line_of(ret)
                if len(at) > 0: what = "{what} ({at})"
        # (the same call again, with internals between: one line)
        if lines.len() > 0 and lines[lines.len() - 1] == what and times[times.len() - 1] > 0: times[times.len() - 1] += counts[ri]
        else:
            lines.push(what)
            times.push(counts[ri])
    out: str[]
    loop k in 0.. and line in lines:
        if times[k] < 0: out.push("    {line}")
        else:
            how = "    called from "
            if out.len() == 0 and not __bt_site: how = "    in "
            n = ""
            if times[k] > 1: n = " ({times[k]:,} times)"
            out.push("{how}{line}{n}")
    loop k in 0.. and line in out:
        if out.len() <= 24 or k < 16 or k >= out.len() - 7: __write_err("{line}\n")
        else if k == 16: __write_err("    ...\n")

# (the compiler's names: init_game is the top level of game; lambda a function literal)
__fn_display = (s: str) -> str:
    if starts_with(s, "init_"):
        if __test_child: return "this test"
        return "the top level of {s[5..]}"
    if s == "lambda": return "a function literal"
    # (the compiler's helpers for a type: h_<kind>_<number> <type>)
    if starts_with(s, "h_"):
        sp = find(s, " ")
        if sp < 0: return ""
        t = s[sp + 1..]
        k = s[2..sp)
        if starts_with(k, "eq_"): return "comparing two {t} values"
        if starts_with(k, "hash_"): return "hashing {t} values"
        if starts_with(k, "copy_") or starts_with(k, "arruniq_") or starts_with(k, "boxuniq_"): return "copying {t} values"
        if starts_with(k, "drop_") or starts_with(k, "arrrel_") or starts_with(k, "boxrel_") or starts_with(k, "boxdrop_"): return "freeing {t} values"
        return ""
    if s == "op_index": return "[] (indexing)"
    if s == "op_set": return "[]= (indexing)"
    if starts_with(s, "op_"): return "an operator ({s[3..]})"
    s
