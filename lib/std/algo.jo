# Searching sorted arrays, orderings and choices, as C++'s <algorithm> and Python's bisect and
# itertools have them:
#
#   xs = [1 3 3 5 8]
#   lower_bound(xs, 3)           # 1: the first index whose element is not less than 3
#   upper_bound(xs, 3)           # 3: the first index whose element is more than 3
#   partition_point(xs, (x): x < 4)   # 3: the first index where the condition stops holding
#   loop next_permutation(p):    # each ordering of p after the one it has, in sorted order
#   combinations(xs, 2)          # every choice of 2, as arrays
#
# The binary searches take time in proportion to the log of the length; the array must be
# sorted (as by sort()) for their answers to mean anything.

# the first index i where xs[i] is not less than x (xs.len() when there is none): where x would
# go in the sorted array before the ones equal to it (C++'s lower_bound; Python's bisect_left)
lower_bound[T] = (xs: T[], x: T) -> int:
    lo = 0
    hi = xs.len()
    loop lo < hi:
        mid = (lo + hi) >> 1
        if xs[mid] < x: lo = mid + 1
        else: hi = mid
    lo

# the first index i where x is less than xs[i] (xs.len() when there is none): where x would go
# after the ones equal to it; upper_bound - lower_bound is how many equal x (C++'s upper_bound;
# Python's bisect_right)
upper_bound[T] = (xs: T[], x: T) -> int:
    lo = 0
    hi = xs.len()
    loop lo < hi:
        mid = (lo + hi) >> 1
        if x < xs[mid]: hi = mid
        else: lo = mid + 1
    lo

# Python's name for lower_bound
bisect_left[T] = (xs: T[], x: T) -> int: lower_bound(xs, x)
# Python's name for upper_bound
bisect_right[T] = (xs: T[], x: T) -> int: upper_bound(xs, x)

# the first index where f is false, for an f that is true for the first elements and false for
# the rest (xs.len() when it is true for all): partition_point(xs, (p): p.age < 30) in people
# sorted by age (Rust's partition_point; C++'s with a condition)
partition_point[T] = (xs: T[], f: (T) -> bool) -> int:
    lo = 0
    hi = xs.len()
    loop lo < hi:
        mid = (lo + hi) >> 1
        if f(xs[mid]): lo = mid + 1
        else: hi = mid
    lo

# the elements from index start up to (not including) end reversed in place: xs[start..end]
# backwards (reverse(xs) turns the whole array)
reverse[T] = (xs: mut T[], start: int, end: int):
    n = xs.len()
    if start < 0 or end > n or start > end: panic("reverse: {start}..{end} is not inside 0..{n}")
    i = start
    j = end - 1
    loop i < j:
        xs.swap(i, j)
        i += 1
        j -= 1

# the next ordering of xs in sorted order (by <), in place, and true; for the last one (largest
# first) xs goes back to the first (sorted) and it gives false. Starting from a sorted array,
# `loop next_permutation(p):` after a first look at p goes through each ordering once, equal
# elements not repeating any (C++'s next_permutation)
next_permutation[T] = (xs: mut T[]) -> bool:
    n = xs.len()
    i = n - 2
    loop i >= 0 and not (xs[i] < xs[i + 1]): i -= 1
    if i < 0:
        xs.reverse()
        return false
    j = n - 1
    loop not (xs[i] < xs[j]): j -= 1
    xs.swap(i, j)
    xs.reverse(i + 1, n)
    true

# the previous ordering of xs in sorted order, in place, and true; for the first one (sorted) xs
# goes to the last (largest first) and it gives false (C++'s prev_permutation)
prev_permutation[T] = (xs: mut T[]) -> bool:
    n = xs.len()
    i = n - 2
    loop i >= 0 and not (xs[i + 1] < xs[i]): i -= 1
    if i < 0:
        xs.reverse()
        return false
    j = n - 1
    loop not (xs[j] < xs[i]): j -= 1
    xs.swap(i, j)
    xs.reverse(i + 1, n)
    true

# every ordering of xs, each an array: n! of them (10 elements are 3.6 million arrays; to go
# through them without keeping them all, sort and loop on next_permutation). In the order of
# Python's itertools.permutations: by the positions taken, so equal elements give repeats
permutations[T] = (xs: T[]) -> T[][]: permutations(xs, xs.len())

# every ordering of k of the elements of xs: n! / (n - k)! arrays of k (permutations([1 2 3], 2)
# is [[1, 2], [1, 3], [2, 1], [2, 3], [3, 1], [3, 2]])
permutations[T] = (xs: T[], k: int) -> T[][]:
    out: T[][]
    if k < 0 or k > xs.len(): return out
    cur: T[]
    used = fill(false, xs.len())
    __permute(xs, k, cur, used, out)
    out

__permute[T] = (xs: T[], k: int, cur: mut T[], used: mut bool[], out: mut T[][]):
    if cur.len() == k:
        out.push(cur)
        return
    loop i in 0..xs.len():
        if used[i]: continue
        used[i] = true
        cur.push(xs[i])
        __permute(xs, k, cur, used, out)
        cur.pop()
        used[i] = false

# every choice of k of the elements of xs, each an array in the order they are in xs: n! / (k! (n
# - k)!) of them (combinations([1 2 3 4], 2) is [[1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4]],
# as Python's itertools.combinations; 30 choose 15 is 155 million arrays: count first)
combinations[T] = (xs: T[], k: int) -> T[][]:
    out: T[][]
    n = xs.len()
    if k < 0 or k > n: return out
    idx = range(0, k)
    loop true:
        c: T[]
        loop i in idx: c.push(xs[i])
        out.push(c)
        # (the last index that can move on, moved on, and the ones after it right behind it)
        i = k - 1
        loop i >= 0 and idx[i] == n - k + i: i -= 1
        if i < 0: break
        idx[i] += 1
        loop j in i + 1..k: idx[j] = idx[j - 1] + 1
    out

# the elements as text with sep between them, as print shows each: [1 2 3].join(" ") is "1 2 3"
# (an array of str joins as it is)
join[T] = (xs: T[], sep: str = "") -> str: __fmt_join(xs, sep)
