# Keys and a gamepad on the hud_ boxes: hud_nav, hud_nav_active, hud_nav_box, hud_nav_focused,
# hud_nav_focus, hud_nav_input.

# (This file is read only for a program that names one of them: compiler/check.jo, on_demand_names.
# The boxes ask it through __hud_nav_fn and __hud_nav_list_fn, which hud_nav sets: lib/game/ui.jo.)

# hud_nav(true), each frame before the boxes: the arrow keys, the d-pad and the left stick move a
# focus among the hud_button, hud_checkbox, hud_slider, hud_text_field, hud_text_area and
# hud_nav_box boxes drawn after it, to the nearest box that way; Enter, space or the gamepad's A
# chooses the focused one (a button returns true, a checkbox flips, a text field takes the
# keyboard), and left and right move a focused slider by its step (a twentieth of the way with a
# step of 0). Held, the d-pad and the stick go on a box at a time, as gamepad_repeat does. It reads
# standard gamepads only (gamepad_standard): what gamepad_down and gamepad_axis make of a flight
# stick, a wheel or pedals (their stick, throttle or pedals as a stick, a trigger or the d-pad,
# their trigger as A) moves nothing; a game gives such a device's hat and buttons to it with
# hud_nav_input. The focus shows as a ring of hud_style.focus around the box while the keys or a
# gamepad are what is used (hud_nav_active()); moving the mouse hides it, and the mouse moved onto
# a box takes the focus there, as in a ui_ menu. A row of a hud_scroll list scrolls into view as
# the focus reaches it.
#   paused = false
#   draw = ():
#       global paused
#       if key_pressed(.escape) or gamepad_pressed(.start): paused = not paused
#       hud_nav(paused)
#       if paused:
#           hud_panel(visible_rect(), rgba(0, 0, 0, 0.5))
#           if hud_button(Rect(540, 280, 200, 44), "Resume"): paused = false
#           if hud_button(Rect(540, 340, 200, 44), "Quit"): quit()
# The focus starts on the first box drawn (or where hud_nav_focus puts it), or on the one it was on
# when the same boxes come back. A box under a hud_panel drawn after it (a dialog's) cannot have
# it, and it goes back to the box it was on when the dialog goes. `name` tells screens apart
# (`hud_nav(true, "settings")`): each keeps its own focus, and one shown again starts on the box it
# was left on. hud_nav(false) later in the frame leaves the boxes after it out (a game's own HUD,
# drawn after its menu). While a text field has the keyboard, the arrow keys move its caret and the
# d-pad leaves it. A layout root (import layout) with controls has its own navigation: the keys go
# to whichever was drawn last, its controls or the hud_ boxes after it
hud_nav = (on: bool, name: str = ""):
    global __hud_nav_fn, __hud_nav_frame, __hud_nav_list_fn
    if not on:
        __hud_nav_frame = -10
        return
    __hud_nav_fn = __hud_nav_add
    __hud_nav_list_fn = __hud_nav_list
    if __hud_nav_read != __frame_count: __hud_nav_begin(name)
    __hud_nav_frame = __frame_count

# whether hud_nav's focus shows: the keys or a gamepad moved it (or chose with it) since the mouse
# moved or a finger touched; false without hud_nav. For a game's own hints ("A: choose")
hud_nav_active = () -> bool: __hud_nav_shown and __hud_nav_read >= __frame_count - 1 and not touch_input()

# a box the game draws itself (a page, a card, a counter), clicked or chosen as a hud_button is,
# with no look of its own: called after the game draws it, each frame, it is true in the frame it
# is clicked or tapped, or chosen with hud_nav's focus on it (Enter, space, A). hud_nav(true) draws
# its ring around it, over what the game drew; `ring = false` leaves the focus's look to the game
# (hud_nav_focused). A mouse over it counts in hud_hovered(), as over any hud_ box
#   draw_card(r, lit = hud_nav_focused(r))
#   if hud_nav_box(r, ring = false): open(card)
hud_nav_box = (r: Rect, ring: bool = true) -> bool:
    over = __hud_touch(r)
    nav = if __hud_nav_frame == __frame_count: __hud_nav_add(r, 0) else: 0
    on = __hud_press_on(r)
    k = (nav >> 4) & 3
    if not ring: k = k & 2
    if k != 0: __hud_nav_add(r, -k)
    (on and over and mouse_released(.left)) or (nav & 2) != 0

# whether hud_nav's focus is on the box at r and shows (its ring is drawn: hud_nav_active()), for
# a box that draws its own (hud_nav_box(r, ring = false)); asked after hud_nav(true) in the frame,
# before or after the box. False without hud_nav
hud_nav_focused = (r: Rect) -> bool:
    at = __hud_nav_at
    if __hud_nav_frame != __frame_count or at < 0 or not __hud_nav_shown or not __hud_nav_keys or touch_input(): return false
    b = if at < __hud_nav_boxes.len(): __hud_nav_boxes[at] else: __hud_nav_boxes_last[at]
    b.kind == __hud_nav_kind and __hud_nav_near(b.r, __ui_to_screen(r))

# the focus to the box at r, or to the first box inside r (a page's first line, not the tabs above
# it), or else the nearest to it: once, as a screen opens or its content changes (a page turned).
# It goes there among the boxes of the frame it is called in, from the next frame on (with no
# focus for the rest of this one); a screen that starts that frame, or the next screen to start
# while hud_nav is off, starts there
hud_nav_focus = (r: Rect):
    global __hud_nav_at, __hud_nav_go, __hud_nav_go_frame, __hud_nav_going, __hud_nav_kind, __hud_nav_ok
    __hud_nav_go = __ui_to_screen(r)
    __hud_nav_go_frame = __frame_count
    __hud_nav_going = true
    if __hud_nav_read == __frame_count:
        __hud_nav_at = -1
        __hud_nav_kind = -1
        __hud_nav_ok = false

# another device's controls given to hud_nav, each frame before hud_nav(true) (in update): the way
# held (dx, dy: -1, 0 or 1; a flight stick's hat, read with joystick_axis) and whether a button
# that chooses is down (joystick_button). As the d-pad's: held, the way goes on a box at a time
# (as gamepad_repeat), and choose chooses as it goes down; either shows the focus
# (hud_nav_active). Called more than once in a frame (two devices), what each holds counts
#   if gamepad_connected(0) and not gamepad_standard(0):
#       hud_nav_input(int(round(joystick_axis(0, 4))), int(round(joystick_axis(0, 5))), joystick_button(0, 0))
hud_nav_input = (dx: int, dy: int, choose: bool):
    global __hud_nav_given
    f = __frame_count
    g = __hud_nav_given
    x = if dx < 0: -1 else if dx > 0: 1 else: 0
    y = if dy < 0: -1 else if dy > 0: 1 else: 0
    if g.frame == f:
        if x == 0: x = g.dx
        if y == 0: y = g.dy
        __hud_nav_given = __HudNavGiven(x, y, choose or g.choose, g.was, f)
        return
    __hud_nav_given = __HudNavGiven(x, y, choose, g.frame == f - 1 and g.choose, f)

# (each box hud_nav can focus, as drawn: where on the screen, what it is, in which list)
struct __HudNavBox:
    r = Rect(0, 0, 0, 0)        # (all of it, on the screen)
    vis = Rect(0, 0, 0, 0)      # (as much as is not clipped away)
    kind = -1                   # (0 a button, 1 a checkbox, 2 a slider, 3 a text field or area)
    list = -1                   # (the hud_scroll list it is in: its index in its frame's lists)
    panels = 0                  # (the hud_panels drawn before it: one after it covers it)
    seq = 0                     # (the boxes drawn before it and it, with hud_nav on, ever)
struct __HudNavList:
    key = ""
    r = Rect(0, 0, 0, 0)        # (as hud_scroll had it, in its transform's units)
    screen = Rect(0, 0, 0, 0)
    off = 0.0
__hud_nav_boxes: __HudNavBox[]
__hud_nav_boxes_last: __HudNavBox[]
__hud_nav_lists: __HudNavList[]
__hud_nav_lists_last: __HudNavList[]
__hud_nav_read = -10            # (the frame hud_nav read the keys in: it was on in it)
__hud_nav_name = ""
__hud_nav_names: {str: __HudNavBox}
__hud_nav_had = __HudNavBox()   # (the box with the focus, as it was in the last frame, and its index)
__hud_nav_had_at = -1
__hud_nav_under = __HudNavBox() # (the box a dialog drawn over it took the focus from)
__hud_nav_fresh = true          # (just started: the focus on the box it was on, or the first)
__hud_nav_at = -1               # (this frame's: the box with the focus, in draw order, and its kind)
__hud_nav_kind = -1
__hud_nav_shown = false
__hud_nav_keys = true           # (the keys are hud_nav's, not a layout root's drawn over its boxes)
__hud_nav_ok = false
__hud_nav_side = 0
__hud_nav_held = false
__hud_nav_mouse = vec2(0, 0)
__hud_nav_way = 0               # (the way the d-pad or the stick is held, and for how long)
__hud_nav_hold = 0.0
__hud_nav_ring: (Rect, mat4, bool, vec4) = (Rect(0, 0, 0, 0), mat4(), false, vec4(0, 0, 0, 0))
__hud_nav_ring_box = Rect(0, 0, 0, 0)   # (on the screen)
__hud_nav_ring_frame = -10
__hud_nav_go = Rect(0, 0, 0, 0)  # (hud_nav_focus's box, on the screen, the frame it was asked in, and
__hud_nav_go_frame = -10        # whether it is still to be gone to)
__hud_nav_going = false
struct __HudNavGiven:           # (hud_nav_input's, in the frame it was last called: the way, choose
    dx = 0                      # down, and down in the frame before)
    dy = 0
    choose = false
    was = false
    frame = -10
__hud_nav_given = __HudNavGiven()
__hud_nav_given_read = -10      # (the frame of the hud_nav_input hud_nav read last: a press is read once)
__hud_nav_pads: int[] = fill(-1, 8)     # (each pad: -1 not known, 0 another device, 1 a standard gamepad)

# (whether hud_nav reads pad p: a standard gamepad, asked once while it stays connected and
# hud_nav on)
__hud_nav_pad = (p: int) -> bool:
    if not gamepad_connected(p):
        __hud_nav_pads[p] = -1
        return false
    if __hud_nav_pads[p] < 0: __hud_nav_pads[p] = int(gamepad_standard(p))
    __hud_nav_pads[p] == 1

# (each frame, at the first hud_nav(true): the last frame's boxes, the keys, and the focus moved)
__hud_nav_begin = (name: str):
    global __hud_nav_at, __hud_nav_boxes, __hud_nav_boxes_last, __hud_nav_fresh, __hud_nav_going, __hud_nav_given_read, __hud_nav_under, __hud_nav_had, __hud_nav_had_at, __hud_nav_held, __hud_nav_hold, __hud_nav_keys, __hud_nav_kind, __hud_nav_lists, __hud_nav_lists_last, __hud_nav_mouse, __hud_nav_name, __hud_nav_names, __hud_nav_ok, __hud_nav_read, __hud_nav_shown, __hud_nav_side, __hud_nav_way, __hud_focus
    f = __frame_count
    m = mouse_pos()
    # (off in the last frame: starting, its boxes not known yet; shown, unless a click or a finger
    # opened it)
    if __hud_nav_read != f - 1:
        __hud_nav_fresh = true
        __hud_nav_boxes = []
        __hud_nav_lists = []
        __hud_nav_mouse = m
        __hud_nav_shown = not touch_input() and not mouse_down(.left) and __tap_frame < f - 3
        loop p in [0..8): __hud_nav_pads[p] = -1
    __hud_nav_read = f
    __hud_nav_boxes_last = __hud_nav_boxes
    __hud_nav_lists_last = __hud_nav_lists
    __hud_nav_boxes = []
    __hud_nav_lists = []
    # (another screen: its own focus; the boxes of the last frame are not its)
    if name != __hud_nav_name:
        __hud_nav_names[__hud_nav_name] = __hud_nav_had
        __hud_nav_had = __hud_nav_names.get(name) ?? __HudNavBox()
        __hud_nav_had_at = -1
        __hud_nav_name = name
        __hud_nav_fresh = true
        __hud_nav_boxes_last = []
    # (the keys and the gamepad)
    moved = m != __hud_nav_mouse
    __hud_nav_mouse = m
    if moved or mouse_pressed(.left) or (touch_input() and mouse_down(.left)): __hud_nav_shown = false
    typing = ui_typing()
    still = rebinding()
    dx = 0
    dy = 0
    if not typing and not still:
        if key_typed(.left): dx = -1
        if key_typed(.right): dx = 1
        if key_typed(.up): dy = -1
        if key_typed(.down): dy = 1
    # (standard gamepads, and what hud_nav_input gave)
    sx = 0.0
    sy = 0.0
    pad = [false, false, false, false, false, false]    # (up, down, left, right; A pressed, A down)
    loop p in [0..MAX_GAMEPADS):
        if not __hud_nav_pad(p): continue
        x = gamepad_axis(p, 0)
        y = gamepad_axis(p, 1)
        if abs(x) > abs(sx): sx = x
        if abs(y) > abs(sy): sy = y
        loop i in 0.. and b in [PadButton.up, PadButton.down, PadButton.left, PadButton.right]:
            if gamepad_down(p, b): pad[i] = true
        if gamepad_pressed(p, .a): pad[4] = true
        if gamepad_down(p, .a): pad[5] = true
    g = __hud_nav_given
    if g.frame >= f - 1:
        if g.dy < 0: pad[0] = true
        if g.dy > 0: pad[1] = true
        if g.dx < 0: pad[2] = true
        if g.dx > 0: pad[3] = true
        if g.choose and not g.was and g.frame != __hud_nav_given_read: pad[4] = true
        if g.choose: pad[5] = true
        __hud_nav_given_read = g.frame
    way = 0
    if pad[0] or (sy < -0.6 and abs(sy) >= abs(sx)): way = 1
    else if pad[1] or (sy > 0.6 and abs(sy) >= abs(sx)): way = 2
    else if pad[2] or sx < -0.6: way = 3
    else if pad[3] or sx > 0.6: way = 4
    # (as gamepad_repeat: at once, then after a quarter second 15 times a second)
    go = false
    if way != __hud_nav_way:
        __hud_nav_hold = 0.0
        go = way != 0
    else if way != 0:
        was = __hud_nav_hold
        __hud_nav_hold += __raw_dt
        go = __hud_nav_reps(__hud_nav_hold) > __hud_nav_reps(was)
    __hud_nav_way = way
    if go and not still:
        if way == 1: dy = -1
        if way == 2: dy = 1
        if way == 3: dx = -1
        if way == 4: dx = 1
    if dy != 0: dx = 0
    ok = not still and (pad[4] or (not typing and (key_pressed(.enter) or key_pressed(.space))))
    __hud_nav_held = pad[5] or (not typing and (key_down(.enter) or key_down(.space)))
    # (a layout root with controls drawn over the boxes has the keys)
    l = __hud_mark_at(__hud_layout_mark, __hud_layout_mark_was, f - 1)
    h = __hud_mark_at(__hud_nav_mark, __hud_nav_mark_was, f - 1)
    was_keys = __hud_nav_keys
    __hud_nav_keys = l.0 != f - 1 or (h.0 == f - 1 and h.1 > l.1)
    if not __hud_nav_keys:
        dx = 0
        dy = 0
        ok = false
    __hud_nav_side = 0
    __hud_nav_ok = false
    __hud_nav_at = -1
    __hud_nav_kind = -1
    boxes = __hud_nav_boxes_last
    if boxes.len() == 0: return
    at = __hud_nav_find()
    # (hud_nav_focus: asked this frame, no focus until its boxes are known; then to its box)
    if __hud_nav_going:
        if __hud_nav_go_frame == f: return
        __hud_nav_going = false
        j = __hud_nav_toward(__hud_nav_go)
        if j >= 0:
            at = j
            __hud_nav_under = __HudNavBox()
            if __hud_nav_shown and boxes[at].list >= 0: __hud_nav_reveal(boxes[at])
    # (the keys back from a layout root drawn before boxes now: the focus to the first of those)
    if __hud_nav_keys and not was_keys and l.0 == f - 1 and at >= 0 and boxes[at].seq <= l.1:
        loop i in 0.. and b in boxes:
            if b.seq > l.1 and __hud_nav_open(b, -1):
                at = i
                break
    # (the mouse moved onto a box: the focus there)
    if moved and not touch_input():
        k = boxes.len() - 1
        loop k >= 0:
            if contains(boxes[k].vis, m) and __hud_nav_open(boxes[k], -1):
                at = k
                break
            k -= 1
    if at < 0: return
    # (the first key after the mouse shows where the focus is: it neither moves it nor chooses)
    if (dx != 0 or dy != 0 or ok) and not __hud_nav_shown:
        __hud_nav_shown = true
        if boxes[at].list >= 0: __hud_nav_reveal(boxes[at])
        dx = 0
        dy = 0
        ok = false
    if dx != 0 or dy != 0:
        if boxes[at].kind == 2 and dx != 0: __hud_nav_side = dx
        else:
            j = __hud_nav_pick(at, dx, dy)
            if j >= 0:
                # (a text field typed in, left with the gamepad, lets go of the keyboard)
                if boxes[at].kind == 3: __hud_focus = ""
                at = j
                if boxes[at].list >= 0: __hud_nav_reveal(boxes[at])
    __hud_nav_ok = ok
    __hud_nav_at = at
    __hud_nav_kind = boxes[at].kind
    __hud_nav_had = boxes[at]
    __hud_nav_had_at = at

# (how many repeats after held seconds, as gamepad_repeat's: -1 before the first)
__hud_nav_reps = (held: f64) -> int:
    if held < 0.25 - 1e-6: return -1
    int(floor((held - 0.25) * 15.0 + 1e-6))

# (the box the focus was on, among the last frame's: in the same place, or in the same order and
# size (a menu sliding in, a list scrolled); the box a dialog took it from, as the dialog goes; the
# nearest; or the first)
__hud_nav_find = () -> int:
    global __hud_nav_fresh, __hud_nav_under
    boxes = __hud_nav_boxes_last
    had = __hud_nav_had
    fresh = __hud_nav_fresh
    __hud_nav_fresh = false
    at = -1
    if had.kind >= 0:
        at = __hud_nav_same(had)
        if at < 0 and not fresh and __hud_nav_had_at >= 0 and __hud_nav_had_at < boxes.len():
            b = boxes[__hud_nav_had_at]
            if b.kind == had.kind and (b.list >= 0) == (had.list >= 0) and abs(f64(b.r.w - had.r.w)) < 0.5 and abs(f64(b.r.h - had.r.h)) < 0.5: at = __hud_nav_had_at
        # (covered by a dialog: its first box; the focus comes back here after it)
        if at >= 0 and not __hud_nav_open(boxes[at], boxes[at].list):
            __hud_nav_under = had
            return __hud_nav_first()
    if at < 0 and __hud_nav_under.kind >= 0:
        u = __hud_nav_same(__hud_nav_under)
        if u >= 0 and __hud_nav_open(boxes[u], -1):
            __hud_nav_under = __HudNavBox()
            return u
    if at < 0 and had.kind >= 0 and not fresh:
        best = 1e30
        c = center(had.vis)
        loop i in 0.. and b in boxes:
            if not __hud_nav_open(b, -1): continue
            d = f64(length(center(b.vis) - c))
            if d < best:
                best = d
                at = i
    if at < 0: at = __hud_nav_first()
    at
# (hud_nav_focus's box among the last frame's: the one in that place, the first inside it, or the
# nearest; -1 for none)
__hud_nav_toward = (r: Rect) -> int:
    boxes = __hud_nav_boxes_last
    loop i in 0.. and b in boxes:
        if __hud_nav_near(b.r, r) and __hud_nav_open(b, b.list): return i
    loop i in 0.. and b in boxes:
        if contains(r, center(b.vis)) and __hud_nav_open(b, -1): return i
    at = -1
    best = 1e30
    c = center(r)
    loop i in 0.. and b in boxes:
        if not __hud_nav_open(b, -1): continue
        d = f64(length(center(b.vis) - c))
        if d < best:
            best = d
            at = i
    at
__hud_nav_near = (a: Rect, b: Rect) -> bool: abs(f64(a.x - b.x)) < 0.5 and abs(f64(a.y - b.y)) < 0.5 and abs(f64(a.w - b.w)) < 0.5 and abs(f64(a.h - b.h)) < 0.5
__hud_nav_first = () -> int:
    loop i in 0.. and b in __hud_nav_boxes_last:
        if __hud_nav_open(b, -1): return i
    -1
# (the box in the same place as had and of its kind; not for a list's rows, which move as it scrolls)
__hud_nav_same = (had: __HudNavBox) -> int:
    if had.list >= 0: return -1
    at = -1
    loop i in 0.. and b in __hud_nav_boxes_last:
        if b.list < 0 and b.kind == had.kind and abs(f64(b.r.x - had.r.x)) < 0.5 and abs(f64(b.r.y - had.r.y)) < 0.5 and abs(f64(b.r.w - had.r.w)) < 0.5 and abs(f64(b.r.h - had.r.h)) < 0.5:
            if at < 0 or abs(i - __hud_nav_had_at) < abs(at - __hud_nav_had_at): at = i
    at

# (whether a box of the last frame can have the focus: not clipped away (a row of the list `list`
# may be: it scrolls into view), nor under a hud_panel drawn after it)
__hud_nav_open = (b: __HudNavBox, list: int) -> bool:
    if b.r.w <= 0 or b.r.h <= 0: return false
    p = center(b.vis)
    if b.vis.w <= 0 or b.vis.h <= 0:
        if b.list < 0 or b.list != list: return false
        p = center(__hud_nav_lists_last[b.list].screen)
    loop k in [b.panels..__hud_panels_last.len()):
        pk = __hud_panels_last[k]
        # (a row's own panel, in its list)
        if pk.1 and b.list >= 0 and __hud_nav_inside(pk.0, __hud_nav_lists_last[b.list].screen): continue
        if contains(pk.0, p): return false
    true
__hud_nav_inside = (a: Rect, b: Rect) -> bool: a.x >= b.x - 1 and a.y >= b.y - 1 and a.x + a.w <= b.x + b.w + 1 and a.y + a.h <= b.y + b.h + 1

# (the box to go to from box `at` this way, -1 for none: as Android's FocusFinder chooses, of those
# whose edges lie that way, those in line with it first, then the nearest, its distance to the side
# weighted less; in a list, along it, its own rows before anything outside it)
__hud_nav_pick = (at: int, dx: int, dy: int) -> int:
    boxes = __hud_nav_boxes_last
    from = boxes[at]
    hidden = from.vis.w <= 0 or from.vis.h <= 0
    best = -1
    best_d = vec4(0, 0, 0, 0)
    stage = if from.list >= 0 and dy != 0: 0 else: 1
    loop stage < 2:
        loop i in 0.. and b in boxes:
            if i == at or not __hud_nav_open(b, from.list): continue
            shared = from.list >= 0 and b.list == from.list
            if stage == 0 and not shared: continue
            # (rows of one list by where they are in it; other boxes where they show)
            s = __hud_nav_axes(if shared or hidden: from.r else: from.vis, dx, dy)
            d = __hud_nav_axes(if shared: b.r else: b.vis, dx, dy)
            if not ((s.x < d.x or s.y <= d.x) and s.y < d.y): continue
            if best < 0 or __hud_nav_better(s, d, best_d, dx != 0):
                best = i
                best_d = d
        if best >= 0: return best
        stage += 1
    -1
# (a rectangle as its edges along the way (near, far) and across it (low, high))
__hud_nav_axes = (r: Rect, dx: int, dy: int) -> vec4:
    if dy > 0: return vec4(r.y, r.y + r.h, r.x, r.x + r.w)
    if dy < 0: return vec4(-(r.y + r.h), -r.y, r.x, r.x + r.w)
    if dx > 0: return vec4(r.x, r.x + r.w, r.y, r.y + r.h)
    vec4(-(r.x + r.w), -r.x, r.y, r.y + r.h)
__hud_nav_better = (s: vec4, a: vec4, b: vec4, across: bool) -> bool:
    if __hud_nav_beam_beats(s, a, b, across): return true
    if __hud_nav_beam_beats(s, b, a, across): return false
    __hud_nav_weight(s, a) < __hud_nav_weight(s, b)
__hud_nav_beam = (s: vec4, d: vec4) -> bool: d.w > s.z and d.z < s.w
__hud_nav_beam_beats = (s: vec4, a: vec4, b: vec4, across: bool) -> bool:
    if __hud_nav_beam(s, b) or not __hud_nav_beam(s, a): return false
    if s.y > b.x: return true          # (b not wholly that way)
    if across: return true
    max(f64(a.x - s.y), 0.0) < max(f64(b.y - s.y), 1.0)
__hud_nav_weight = (s: vec4, d: vec4) -> f64:
    major = max(f64(d.x - s.y), 0.0)
    minor = abs(f64(d.z + d.w - s.z - s.w)) / 2.0
    13.0 * major * major + minor * minor

# (a list's row given the focus: scrolled into view)
__hud_nav_reveal = (b: __HudNavBox):
    l = __hud_nav_lists_last[b.list]
    k = f64(l.r.h) / max(f64(l.screen.h), 1e-9)
    top = f64(b.r.y - l.screen.y) * k + l.off
    hud_scroll_reveal(l.key, top, top + f64(b.r.h) * k)

# (a box hud_nav can focus, drawn: kept, and what the keys and the gamepad did to it, in bits: 1 it
# has the focus, 2 chosen, 4 and 8 a step left or right, 16 its ring shows, 32 it is drawn over the
# ring of one before it, 64 held down. Kind -1 or -2, after it is drawn: its ring, or that one's again)
__hud_nav_add = (r: Rect, kind: int) -> int:
    global __hud_nav_mark, __hud_nav_mark_was, __hud_nav_seq
    if kind < 0:
        __hud_nav_draw_ring(r, kind == -2)
        return 0
    f = __frame_count
    i = __hud_nav_boxes.len()
    s = __ui_to_screen(r)
    list = -1
    if __clip_on and __cur_target < 0:
        c = Rect(__clip.x, __clip.y, __clip.z, __clip.w)
        k = __hud_nav_lists.len() - 1
        loop k >= 0:
            if __hud_nav_inside(c, __hud_nav_lists[k].screen):
                list = k
                break
            k -= 1
    __hud_nav_seq += 1
    __hud_nav_boxes.push(__HudNavBox(s, __hud_screen_box(r), kind, list, __hud_panels.len(), __hud_nav_seq))
    if __hud_nav_mark.0 != f: __hud_nav_mark_was = __hud_nav_mark
    __hud_nav_mark = (f, __hud_nav_seq)
    if i == __hud_nav_at and kind == __hud_nav_kind:
        n = 1
        if __hud_nav_ok: n = n | 2
        if __hud_nav_side < 0: n = n | 4
        if __hud_nav_side > 0: n = n | 8
        if __hud_nav_shown and __hud_nav_keys and not touch_input():
            n = n | 16
            if __hud_nav_held: n = n | 64
        return n
    rb = __hud_nav_ring_box
    if __hud_nav_ring_frame == f and s.x < rb.x + rb.w and s.x + s.w > rb.x and s.y < rb.y + rb.h and s.y + s.h > rb.y: return 32
    0

# (a hud_scroll list drawn while hud_nav is on: the boxes drawn in its clip are its rows)
__hud_nav_list = (key: str, r: Rect, off: f64, content: f64):
    __hud_nav_lists.push(__HudNavList(key, r, __ui_to_screen(r), off))

# (the focus ring, as layout draws its own around its rounded boxes: a line 2 wide, a gap of 1 out
# from the box; over its edge where a clip would cut it, a list's row's)
__hud_nav_draw_ring = (r: Rect, again: bool):
    global __hud_nav_ring, __hud_nav_ring_frame, __xform
    if again:
        ring = __hud_nav_ring
        was = __xform
        saved = (__clip_on, __clip)
        __xform = ring.1
        __hud_clip_out((ring.2, ring.3))
        __hud_nav_ring_draw(ring.0)
        __hud_clip_out(saved)
        __xform = was
        return
    __hud_nav_ring = (r, __xform, __clip_on and __cur_target < 0, __clip)
    __hud_nav_ring_frame = __frame_count
    __hud_nav_ring_draw(r)
__hud_nav_ring_draw = (r: Rect):
    global __hud_nav_ring_box
    g = 3.0
    x = f64(r.x)
    y = f64(r.y)
    w = f64(r.w)
    h = f64(r.h)
    if __clip_on and __cur_target < 0 and not __hud_nav_inside(__ui_to_screen(Rect(x - g, y - g, w + 2.0 * g, h + 2.0 * g)), Rect(__clip.x, __clip.y, __clip.z, __clip.w)): g = 0.0
    __hud_nav_ring_box = __ui_to_screen(Rect(x - g, y - g, w + 2.0 * g, h + 2.0 * g))
    rect_outline(x - g, y - g, w + 2.0 * g, h + 2.0 * g, 2.0, hud_style.focus)
