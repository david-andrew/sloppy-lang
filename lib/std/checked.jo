# Integer arithmetic that says when it overflows. `+`, `-` and `*` on integers wrap around, in
# debug and release builds alike (`i8(127) + i8(1)` is -128); these say what to do instead:
#
#   checked_add(a, b)        # an optional: none when the sum does not fit the type
#   saturating_add(a, b)     # the type's largest (or smallest) value when it does not fit
#   wrapping_add(a, b)       # as a + b: wrapped around, said on purpose
#   checked_cast[u8](x)      # x as a u8 when it fits, else none (u8(x) keeps the low bits)
#   saturating_cast[u8](x)   # 0 below, 255 above
#
#   total = checked_add(total, n) ?? panic("total overflowed")
#   if let p = checked_mul(w, h): ...
#
# They take two values of one integer type (int, i32, i16, i8, u64, u32, u16, u8) and give that
# type; values of mixed types go as the int ones, as other operators do (`checked_add(x, n)`
# with x an i32 and n an int is an int). A literal takes the other's type: `checked_add(b, 1)`
# with b a u8 is a u8.

# --- checked: none when the exact result does not fit ---

# a + b, or none when it overflows
checked_add = (a: int, b: int) -> int?:
    r = a + b
    if ((a xor r) & (b xor r)) < 0: return none
    r
checked_add = (a: u64, b: u64) -> u64?:
    r = a + b
    if r < a: return none
    r
checked_add = (a: i32, b: i32) -> i32?: __ck_fit[i32](int(a) + int(b))
checked_add = (a: i16, b: i16) -> i16?: __ck_fit[i16](int(a) + int(b))
checked_add = (a: i8, b: i8) -> i8?: __ck_fit[i8](int(a) + int(b))
checked_add = (a: u32, b: u32) -> u32?: __ck_fit[u32](int(a) + int(b))
checked_add = (a: u16, b: u16) -> u16?: __ck_fit[u16](int(a) + int(b))
checked_add = (a: u8, b: u8) -> u8?: __ck_fit[u8](int(a) + int(b))

# a - b, or none when it overflows (for the unsigned types: when b > a)
checked_sub = (a: int, b: int) -> int?:
    r = a - b
    if ((a xor b) & (a xor r)) < 0: return none
    r
checked_sub = (a: u64, b: u64) -> u64?:
    if b > a: return none
    a - b
checked_sub = (a: i32, b: i32) -> i32?: __ck_fit[i32](int(a) - int(b))
checked_sub = (a: i16, b: i16) -> i16?: __ck_fit[i16](int(a) - int(b))
checked_sub = (a: i8, b: i8) -> i8?: __ck_fit[i8](int(a) - int(b))
checked_sub = (a: u32, b: u32) -> u32?: __ck_fit[u32](int(a) - int(b))
checked_sub = (a: u16, b: u16) -> u16?: __ck_fit[u16](int(a) - int(b))
checked_sub = (a: u8, b: u8) -> u8?: __ck_fit[u8](int(a) - int(b))

# a * b, or none when it overflows
checked_mul = (a: int, b: int) -> int?:
    r = a * b
    if __mul_high(a, b) != r >> 63: return none
    r
checked_mul = (a: u64, b: u64) -> u64?:
    if __mul_high(a, b) != 0: return none
    a * b
checked_mul = (a: i32, b: i32) -> i32?: __ck_fit[i32](int(a) * int(b))
checked_mul = (a: i16, b: i16) -> i16?: __ck_fit[i16](int(a) * int(b))
checked_mul = (a: i8, b: i8) -> i8?: __ck_fit[i8](int(a) * int(b))
checked_mul = (a: u32, b: u32) -> u32?: __ck_fit[u32](u64(a) * u64(b))
checked_mul = (a: u16, b: u16) -> u16?: __ck_fit[u16](int(a) * int(b))
checked_mul = (a: u8, b: u8) -> u8?: __ck_fit[u8](int(a) * int(b))

# --- saturating: the nearest value the type has ---

# a + b, or the type's largest or smallest value when it overflows
saturating_add = (a: int, b: int) -> int:
    r = a + b
    if ((a xor r) & (b xor r)) < 0:
        if a < 0: return MIN_INT
        return MAX_INT
    r
saturating_add = (a: u64, b: u64) -> u64:
    r = a + b
    if r < a: return 0xFFFFFFFFFFFFFFFF
    r
saturating_add = (a: i32, b: i32) -> i32: i32(clamp(int(a) + int(b), -2147483648, 2147483647))
saturating_add = (a: i16, b: i16) -> i16: i16(clamp(int(a) + int(b), -32768, 32767))
saturating_add = (a: i8, b: i8) -> i8: i8(clamp(int(a) + int(b), -128, 127))
saturating_add = (a: u32, b: u32) -> u32: u32(clamp(int(a) + int(b), 0, 4294967295))
saturating_add = (a: u16, b: u16) -> u16: u16(clamp(int(a) + int(b), 0, 65535))
saturating_add = (a: u8, b: u8) -> u8: u8(clamp(int(a) + int(b), 0, 255))

# a - b, or the type's largest or smallest value when it overflows (0 for the unsigned types
# when b > a)
saturating_sub = (a: int, b: int) -> int:
    r = a - b
    if ((a xor b) & (a xor r)) < 0:
        if a < 0: return MIN_INT
        return MAX_INT
    r
saturating_sub = (a: u64, b: u64) -> u64:
    if b > a: return 0
    a - b
saturating_sub = (a: i32, b: i32) -> i32: i32(clamp(int(a) - int(b), -2147483648, 2147483647))
saturating_sub = (a: i16, b: i16) -> i16: i16(clamp(int(a) - int(b), -32768, 32767))
saturating_sub = (a: i8, b: i8) -> i8: i8(clamp(int(a) - int(b), -128, 127))
saturating_sub = (a: u32, b: u32) -> u32: u32(clamp(int(a) - int(b), 0, 4294967295))
saturating_sub = (a: u16, b: u16) -> u16: u16(clamp(int(a) - int(b), 0, 65535))
saturating_sub = (a: u8, b: u8) -> u8: u8(clamp(int(a) - int(b), 0, 255))

# a * b, or the type's largest or smallest value when it overflows
saturating_mul = (a: int, b: int) -> int:
    r = a * b
    if __mul_high(a, b) != r >> 63:
        if (a < 0) != (b < 0): return MIN_INT
        return MAX_INT
    r
saturating_mul = (a: u64, b: u64) -> u64:
    if __mul_high(a, b) != 0: return 0xFFFFFFFFFFFFFFFF
    a * b
saturating_mul = (a: i32, b: i32) -> i32: i32(clamp(int(a) * int(b), -2147483648, 2147483647))
saturating_mul = (a: i16, b: i16) -> i16: i16(clamp(int(a) * int(b), -32768, 32767))
saturating_mul = (a: i8, b: i8) -> i8: i8(clamp(int(a) * int(b), -128, 127))
saturating_mul = (a: u32, b: u32) -> u32: u32(min(u64(a) * u64(b), u64(0xFFFFFFFF)))
saturating_mul = (a: u16, b: u16) -> u16: u16(clamp(int(a) * int(b), 0, 65535))
saturating_mul = (a: u8, b: u8) -> u8: u8(clamp(int(a) * int(b), 0, 255))

# --- wrapping: as the operators, said on purpose ---

# a + b, wrapped around on overflow (as `+` does: this says it is meant)
wrapping_add = (a: int, b: int) -> int: a + b
wrapping_add = (a: u64, b: u64) -> u64: a + b
wrapping_add = (a: i32, b: i32) -> i32: a + b
wrapping_add = (a: i16, b: i16) -> i16: a + b
wrapping_add = (a: i8, b: i8) -> i8: a + b
wrapping_add = (a: u32, b: u32) -> u32: a + b
wrapping_add = (a: u16, b: u16) -> u16: a + b
wrapping_add = (a: u8, b: u8) -> u8: a + b

# a - b, wrapped around on overflow (as `-` does: this says it is meant)
wrapping_sub = (a: int, b: int) -> int: a - b
wrapping_sub = (a: u64, b: u64) -> u64: a - b
wrapping_sub = (a: i32, b: i32) -> i32: a - b
wrapping_sub = (a: i16, b: i16) -> i16: a - b
wrapping_sub = (a: i8, b: i8) -> i8: a - b
wrapping_sub = (a: u32, b: u32) -> u32: a - b
wrapping_sub = (a: u16, b: u16) -> u16: a - b
wrapping_sub = (a: u8, b: u8) -> u8: a - b

# a * b, wrapped around on overflow (as `*` does: this says it is meant)
wrapping_mul = (a: int, b: int) -> int: a * b
wrapping_mul = (a: u64, b: u64) -> u64: a * b
wrapping_mul = (a: i32, b: i32) -> i32: a * b
wrapping_mul = (a: i16, b: i16) -> i16: a * b
wrapping_mul = (a: i8, b: i8) -> i8: a * b
wrapping_mul = (a: u32, b: u32) -> u32: a * b
wrapping_mul = (a: u16, b: u16) -> u16: a * b
wrapping_mul = (a: u8, b: u8) -> u8: a * b

# --- conversions ---

# x as a T (an integer type: checked_cast[u8](x)) when it has that value, else none (`u8(x)`
# keeps the low bits: u8(300) is 44, checked_cast[u8](300) none)
checked_cast[T] = (x: int) -> T?:
    y = T(x) | T(0)             # (`|`: T is an integer type)
    if int(y) != x or (x < 0) != (y < T(0)): return none
    y
checked_cast[T] = (x: u64) -> T?:
    y = T(x) | T(0)
    if u64(y) != x or y < T(0): return none
    y

# x as a T (an integer type: saturating_cast[u8](x)), or T's smallest or largest value when x
# is past it (saturating_cast[u8](300) is 255, saturating_cast[u8](-5) 0)
saturating_cast[T] = (x: int) -> T:
    y = T(x) | T(0)
    if int(y) == x and (x < 0) == (y < T(0)): return y
    if x < 0: return __ck_min[T]()
    __ck_max[T]()
saturating_cast[T] = (x: u64) -> T:
    y = T(x) | T(0)
    if u64(y) == x and y >= T(0): return y
    __ck_max[T]()

# (r as a T, when it has that value)
__ck_fit[T] = (r: int) -> T?:
    y = T(r)
    if int(y) != r: return none
    y
__ck_fit[T] = (r: u64) -> T?:
    y = T(r)
    if u64(y) != r: return none
    y

# (the smallest and largest values of the integer type T)
# (variables, not constants: a constant that does not fit T is an error even where unreached)
__ck_min[T] = () -> T:
    m = MIN_INT
    if T(m - m - 1) > T(0): return T(0)
    T(m >> (64 - 8 * size_of(T)))
__ck_max[T] = () -> T:
    m = MAX_INT
    if T(m - m - 1) > T(0): return T(m - m - 1)
    T(m >> (64 - 8 * size_of(T)))

# (__mul_high where the machine has no instruction for it: WebAssembly; the compiler calls these)
__mul_high_soft_u = (a: u64, b: u64) -> u64:
    m = u64(0xFFFFFFFF)
    al = a & m
    ah = a >> 32
    bl = b & m
    bh = b >> 32
    p0 = al * bl
    p1 = al * bh
    p2 = ah * bl
    mid = (p0 >> 32) + (p1 & m) + (p2 & m)
    ah * bh + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
__mul_high_soft_s = (a: int, b: int) -> int:
    h = __mul_high_soft_u(a as u64, b as u64)
    if a < 0: h -= b as u64
    if b < 0: h -= a as u64
    h as int
