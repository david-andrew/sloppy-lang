# Values as text and back, for saved games and settings. to_text(value) writes a value the
# way print shows one inside a list (strings in quotes):
#
#   Settings(volume=0.8, keys={"jump": 32}, mode=hard, pos=vec2(1.5, 2.0), best=none)
#
# from_text[T](text) reads such text back as a T, or says where it is not one (a TextError).
# Fields go by name, in any order: one the text leaves out keeps its default value, and one the
# struct does not have (any more) is skipped, so what an older version of a program wrote
# still reads after its structs change.
#
#   save_value("settings", settings)
#   settings = load_value("settings", Settings())     # (the default when there is none yet)
#
# Numbers, bool, str, arrays (T[] and T[N]), maps, optionals, tuples, structs, enums (with
# fields too), unions and vectors can be read; function values and pointers cannot.

error struct TextError:
    message: str
    line: int
    column: int
    path = ""       # where in the value: items[2].count (the message names it too)

to_text[T] = (x: T) -> str:
    buf: u8[]
    was = __text_exact
    __text_exact = true
    __fmt_elem(buf, x)
    __text_exact = was
    __buf_finish_val(buf)

from_text[T] = (text: str) -> T | TextError:
    x: T
    __default_init(x)
    if let e = __from_text_into(text, x): return e
    x

# a value of type T from JSON: objects for structs (by field name: a field left out keeps its
# default, one the struct does not have is skipped) and maps, lists for arrays, tuples and
# vectors, null for none, an enum's variant by its name in quotes
from_json[T] = (text: str) -> T | TextError:
    x: T
    __default_init(x)
    if let e = __from_text_into(text, x, true): return e
    x

# keep value under name (save_data) as text; false if it could not be written
save_value[T] = (name: str, x: T) -> bool: save_data(name, to_text(x))

# the value kept under name, or default if there is none or it does not read as one (said on
# stderr then, and what was kept is copied to name + ".bad" first: the next save_value over it
# does not lose it)
load_value[T] = (name: str, default: T) -> T:
    x = default
    if let s = load_data(name):
        if let e = __from_text_into(s, x):
            save_data(name + ".bad", s)
            eprint("load_value: what is kept under '{name}' does not read back ({e.message}, line {e.line}, column {e.column}): the default is used, and what was kept is copied to '{name}.bad'")
            return default
        return x
    default

# read text into x (whatever it leaves out stays as it is)
__from_text_into[T] = (text: str, x: mut T, json: bool = false) -> TextError?:
    r = __TextIn(text, json = json)
    __read(r, x)
    __tx_space(r)
    if len(r.err) == 0 and r.i < len(text):
        if json: __tx_fail(r, "more after the end of the value")
        else: __tx_fail(r, "more text after the value")
    if len(r.err) == 0: return none
    line = 1
    col = 1
    loop i in [0..min(r.at, len(text))):
        col += 1
        if text[i] == '\n':
            line += 1
            col = 1
    msg = r.err
    if len(r.err_path) > 0: msg = "{r.err_path}: {r.err}"
    if json:
        # (a web server's error page where JSON was expected, as parse_json says)
        t = trim_start(text)
        if len(t) > 0 and t[0] == '<' and r.at <= len(text) - len(t): msg = "this is HTML (a web page, an error page perhaps), not JSON: it starts with '<'"
        else if len(r.err_path) > 0 and ends_with(r.err, ", found the end of the text"): msg = "the text ends before {r.err_path}'s value"
    TextError(msg, line, col, r.err_path)

# ---------------- the reader ----------------
struct __TextIn:
    s: str
    i = 0
    err = ""
    at = 0          # where err is
    name = ""       # the field name just read (__tx_field), or the type name ahead (__tx_kind)
    w0 = 0          # where the last word read starts
    n0 = 0          # where the field name just read (__tx_field) starts and ends in s
    n1 = 0
    json = false    # reading JSON (from_json): {"field": value}, [a, b] for tuples and vectors, null
    path: str[]     # the fields and elements being read (items, [2], count)
    err_path = ""   # where err is, as items[2].count
    open_err = false    # (JSON) err is a struct's or vector's start: its type is named in err after

__tx_space = (r: mut __TextIn):
    loop r.i < len(r.s) and (r.s[r.i] == ' ' or r.s[r.i] == '\n' or r.s[r.i] == '\t' or r.s[r.i] == '\r'): r.i += 1

# a word just read is not what it should be: the mistake is there (JSON: and what it is)
__tx_bad = (r: mut __TextIn, msg: str):
    if r.json and len(r.err) == 0:
        w = r.s[r.n0..r.n1)
        if len(w) > 24: w = w[0..24) + "..."
        r.i = r.w0
        if len(w) == 0: __tx_fail_json(r, msg)
        else if r.s[r.w0] == '"': __tx_fail(r, "{msg}, found \"{w}\"")
        else if is_digit(w[0]) or w[0] == '-' or w == "true" or w == "false" or w == "null": __tx_fail(r, "{msg}, found {w}")
        else: __tx_fail(r, "{msg}, found `{w}`")
        return
    r.i = r.w0
    __tx_fail(r, msg)

# (the first mistake is the one reported; reading stops there)
__tx_fail = (r: mut __TextIn, msg: str):
    if len(r.err) == 0:
        r.err = msg
        r.at = r.i
        r.err_path = ""
    r.i = len(r.s)

# (as __tx_fail, saying what is there: the word at it, up to a bracket, comma or space)
__tx_fail_found = (r: mut __TextIn, msg: str):
    if r.json:
        __tx_fail_json(r, msg)
        return
    __tx_space(r)
    if r.i >= len(r.s):
        __tx_fail(r, "{msg}, found the end")
        return
    e = r.i
    loop e < len(r.s) and e - r.i < 24 and r.s[e] != '(' and r.s[e] != ',' and r.s[e] != ')' and r.s[e] != ' ' and r.s[e] != '\n': e += 1
    if e == r.i: e = r.i + 1
    __tx_fail(r, "{msg}, found '{r.s[r.i..e)}'")

# (JSON: what is next, in JSON's words: an object, a list, a string, a number, true, false, null,
# nothing (the text is blank), the end of the text, or the start of anything else in `quotes`)
__tx_found = (r: mut __TextIn) -> str:
    __tx_space(r)
    s = r.s
    if r.i >= len(s):
        if len(trim_start(s)) == 0: return "nothing"
        return "the end of the text"
    c = s[r.i]
    if c == '{{': return "an object"
    if c == '[': return "a list"
    if c == '"': return "a string"
    if is_digit(c) or c == '-': return "a number"
    e = r.i
    loop e < len(s) and e - r.i < 24 and (is_alnum(s[e]) or s[e] == '_'): e += 1
    if e == r.i: e = r.i + 1
    w = s[r.i..e)
    if w == "true" or w == "false" or w == "null": return w
    "`{w}`"

# (JSON: as __tx_fail, saying what is there instead: "expected a string, found a number")
__tx_fail_json = (r: mut __TextIn, msg: str):
    if len(r.err) == 0: __tx_fail(r, "{msg}, found {__tx_found(r)}")
    else: __tx_fail(r, msg)

# (JSON: the same for a missing mark (a ',' or a closing bracket): at the end of the text, msg
# alone, as the text ending there is no value missing)
__tx_fail_end = (r: mut __TextIn, msg: str):
    __tx_space(r)
    if r.i >= len(r.s): __tx_fail(r, msg)
    else: __tx_fail_json(r, msg)

# (JSON: where the character before r.i is, past any spaces; -1 at the start)
__tx_before = (r: __TextIn) -> int:
    i = r.i - 1
    loop i >= 0 and (r.s[i] == ' ' or r.s[i] == '\n' or r.s[i] == '\t' or r.s[i] == '\r'): i -= 1
    i

# (after reading the field or element `part`: a mistake in it is in that part, so its name goes
# before the path, items[2].count built from the inside out; nothing to do while all is well)
__tx_at = (r: mut __TextIn, part: str):
    if len(r.err) == 0: return
    if len(r.err_path) > 0 and r.err_path[0] != '[': r.err_path = part + "." + r.err_path
    else: r.err_path = part + r.err_path

# (reading the field or element `part` of what is being read: for messages)
# (compilers before 0.17 marked each field read with these; the path is now made on a mistake)
__tx_in = (r: mut __TextIn, part: str): r.path.push(part)
__tx_out = (r: mut __TextIn):
    if r.path.len() > 0: r.path.pop()

__tx_eat = (r: mut __TextIn, c: u8) -> bool:
    __tx_space(r)
    if r.i < len(r.s) and r.s[r.i] == c:
        r.i += 1
        return true
    if r.json and r.i < len(r.s):
        # (JSON's way: lists for tuples, vectors and an enum variant's fields (a struct's object is
        # read by __tx_open and __tx_json_field); ':' for '=')
        d = r.s[r.i]
        if c == '(' and d == '[' or c == ')' and d == ']' or c == '=' and d == ':':
            r.i += 1
            return true
    false

__tx_want = (r: mut __TextIn, c: u8):
    if __tx_eat(r, c): return
    if not r.json: __tx_fail(r, "expected '{chr(c)}'")
    # (JSON: what the mark stands for there: '(' starts a tuple's or an enum variant's list)
    else if c == '[' or c == '(': __tx_fail_json(r, "expected a list")
    else if c == '{{': __tx_fail_json(r, "expected an object")
    else if c == ':': __tx_fail_end(r, "expected : after the key")
    else if c == ',': __tx_fail_end(r, "expected , and the next item")
    else: __tx_fail_end(r, "expected ] to end the list")

# a ',' before every item but the first
__tx_sep = (r: mut __TextIn, i: int):
    if i > 0: __tx_want(r, ',')

# a name (letters, digits, _), or a number's text (also . + -)
__tx_word = (r: mut __TextIn, number: bool) -> str:
    __tx_word_at(r, number)
    r.s[r.n0..r.n1)

# (the same, its place only: r.n0 to r.n1 in r.s, no text made)
__tx_word_at = (r: mut __TextIn, number: bool):
    __tx_space(r)
    s = r.s
    n = len(s)
    a = r.i
    r.w0 = a
    if r.json and a < n and s[a] == '"':
        # (a field's name, an enum's variant or a map's number key, in quotes)
        e = a + 1
        loop e < n and s[e] != '"': e += 1
        r.n0 = a + 1
        r.n1 = e
        if e < n: e += 1
        r.i = e
        return
    e = a
    loop e < n:
        c = s[e]
        if not (is_alnum(c) or c == '_' or number and (c == '.' or c == '+' or c == '-')): break
        e += 1
    r.n0 = a
    r.n1 = e
    r.i = e

# whether the field name just read is this one
__tx_name_is = (r: __TextIn, name: str) -> bool:
    r.n1 - r.n0 == len(name) and __mem_eq(data(r.s) + r.n0, data(name), len(name))

# Name( or ( : the start of a struct, the name (any: a renamed type still reads) left out
__tx_open = (r: mut __TextIn):
    if r.json:
        # ({ for a struct, [ for a vector; __read names the type in the message: it is not known here)
        __tx_space(r)
        if r.i < len(r.s) and (r.s[r.i] == '{{' or r.s[r.i] == '['):
            r.i += 1
            return
        if len(r.err) == 0: r.open_err = true
        __tx_fail_json(r, "expected an object")
        return
    __tx_word_at(r, false)
    # (a generic struct's type arguments, Pair[int], if written)
    if r.n1 > r.n0 and r.i < len(r.s) and r.s[r.i] == '[':
        r.i += 1
        depth = 1
        loop r.i < len(r.s) and depth > 0:
            if r.s[r.i] == '[': depth += 1
            else if r.s[r.i] == ']': depth -= 1
            r.i += 1
    __tx_want(r, '(')

# the next field's name= (in r.name), or false at the closing ')'
__tx_field = (r: mut __TextIn) -> bool:
    if len(r.err) > 0: return false
    if r.json: return __tx_json_field(r)
    __tx_eat(r, ',')
    if __tx_eat(r, ')'): return false
    if r.i >= len(r.s):
        __tx_fail(r, "expected ')'")
        return false
    __tx_word_at(r, false)
    if r.n1 == r.n0:
        __tx_fail(r, "expected a field's name")
        return false
    __tx_want(r, '=')
    true

# (JSON: the same: "name": with a ',' before each but the first, or false at the closing '}')
__tx_json_field = (r: mut __TextIn) -> bool:
    # (the first: just after the struct's '{', or a '[': a list where the struct is)
    b = __tx_before(r)
    first = b >= 0 and (r.s[b] == '{{' or r.s[b] == '[')
    if first and r.s[b] == '[':
        r.i = b
        r.open_err = true
        __tx_fail_json(r, "expected an object")
        return false
    if __tx_eat(r, '}}'): return false
    if not first and not __tx_eat(r, ','):
        __tx_fail_end(r, "expected , or } to end the object")
        return false
    __tx_space(r)
    if r.i >= len(r.s) or r.s[r.i] != '"':
        __tx_fail_end(r, "expected a field name in quotes")
        return false
    __tx_word_at(r, false)
    if not __tx_eat(r, ':'):
        __tx_fail_end(r, "expected : after \"{r.s[r.n0..r.n1)}\"")
        return false
    true

# what the next value looks like: 1 a string, 2 a whole number, 3 another number, 4 none,
# 5 true or false, 6 Name(...) (the name in r.name), 7 a name alone, 8 [, 9 {, 10 (
__tx_kind = (r: mut __TextIn) -> int:
    __tx_space(r)
    if r.i >= len(r.s): return 0
    c = r.s[r.i]
    if c == '"': return 1
    if c == '[': return 8
    if c == '{{': return 9
    if c == '(': return 10
    at = r.i
    if is_digit(c) or c == '-' or c == '+':
        w = __tx_word(r, true)
        r.i = at
        loop d in w:
            if d == '.' or d == 'e' or d == 'n': return 3
        return 2
    w = __tx_word(r, false)
    k = 7
    if w == "none" or r.json and w == "null": k = 4
    else if w == "true" or w == "false": k = 5
    else if w == "inf" or w == "nan" or w == "Infinity" or w == "NaN": k = 3
    else if __tx_eat(r, '('): k = 6
    r.name = w
    r.i = at
    k

# past one value of any kind (a field the struct does not have)
__tx_skip = (r: mut __TextIn):
    __tx_space(r)
    if r.json and (r.i >= len(r.s) or r.s[r.i] == ',' or r.s[r.i] == '}}' or r.s[r.i] == ']'):
        # (a field with no value: the field's name says where)
        name = r.s[r.n0..r.n1)
        __tx_fail_json(r, "expected a value")
        r.err_path = name
        return
    depth = 0
    loop r.i < len(r.s):
        c = r.s[r.i]
        if c == '"':
            s = ""
            __read(r, s)
            continue
        if c == '(' or c == '[' or c == '{{': depth += 1
        else if c == ')' or c == ']' or c == '}}':
            if depth == 0: return
            depth -= 1
        else if c == ',' and depth == 0: return
        r.i += 1

# (t: the type, for JSON's messages: "too large for an i32")
__tx_int = (r: mut __TextIn, lo: int, hi: int, t = "an int") -> int:
    __tx_word_at(r, true)
    # (plain digits, read where they are; anything else, 0x1F or 1_000, by to_int)
    s = r.s
    i = r.n0
    neg = false
    if i < r.n1 and (s[i] == '-' or s[i] == '+'):
        neg = s[i] == '-'
        i += 1
    if i < r.n1 and r.n1 - i <= 18:
        v = 0
        ok = true
        loop k in [i..r.n1):
            c = s[k]
            if c < '0' or c > '9':
                ok = false
                break
            v = v * 10 + int(c) - 48
        if ok:
            if neg: v = -v
            if v < lo or v > hi: __tx_range(r, "{v}", v < lo, lo, hi, t)
            return v
    w = r.s[r.n0..r.n1)
    if let v = to_int(w):
        if v < lo or v > hi: __tx_range(r, "{v}", v < lo, lo, hi, t)
        return v
    # (JSON: digits beyond an int's)
    if r.json and r.n1 > i:
        digits = true
        loop k in [i..r.n1):
            if not is_digit(s[k]): digits = false
        if digits:
            __tx_range(r, "", neg, lo, hi, t)
            return 0
    __tx_bad(r, "expected a whole number")
    0

# (the number v is beyond lo to hi, t's range (below it if small): JSON's message names t, "too
# large for an i32 (at most 2147483647)", and leaves out an int's and a u64's own bounds)
__tx_range = (r: mut __TextIn, v: str, small: bool, lo: int, hi: int, t: str):
    r.i = r.w0
    if not r.json: __tx_fail(r, "{v} is out of range ({lo} to {hi})")
    else if small and t == "an int": __tx_fail(r, "too small for an int")
    else if small: __tx_fail(r, "too small for {t} (at least {lo})")
    else if t == "an int" or t == "a u64": __tx_fail(r, "too large for {t}")
    else: __tx_fail(r, "too large for {t} (at most {hi})")

# ---------------- each type ----------------
__read = (r: mut __TextIn, x: mut int): x = __tx_int(r, -0x7FFFFFFFFFFFFFFF - 1, 0x7FFFFFFFFFFFFFFF)
__read = (r: mut __TextIn, x: mut i32): x = i32(__tx_int(r, -0x80000000, 0x7FFFFFFF, "an i32"))
__read = (r: mut __TextIn, x: mut i16): x = i16(__tx_int(r, -0x8000, 0x7FFF, "an i16"))
__read = (r: mut __TextIn, x: mut i8): x = i8(__tx_int(r, -0x80, 0x7F, "an i8"))
__read = (r: mut __TextIn, x: mut u32): x = u32(__tx_int(r, 0, 0xFFFFFFFF, "a u32"))
__read = (r: mut __TextIn, x: mut u16): x = u16(__tx_int(r, 0, 0xFFFF, "a u16"))
__read = (r: mut __TextIn, x: mut u8): x = u8(__tx_int(r, 0, 0xFF, "a u8"))
__read = (r: mut __TextIn, x: mut u64):
    w = __tx_word(r, true)
    v: u64 = 0
    loop c in w:
        if not is_digit(c) or v > 1844674407370955161 or v == 1844674407370955161 and c > '5':
            if not r.json: __tx_bad(r, "expected a whole number from 0 to 18446744073709551615")
            else if is_digit(c): __tx_range(r, "", false, 0, 0, "a u64")
            else if w[0] == '-' and len(w) > 1 and is_digit(w[1]): __tx_range(r, "", true, 0, 0, "a u64")
            else: __tx_bad(r, "expected a whole number")
            return
        v = v * 10 + u64(c - '0')
    if len(w) == 0: __tx_bad(r, "expected a whole number")
    x = v

__read = (r: mut __TextIn, x: mut f64):
    __tx_word_at(r, true)
    # (up to 15 digits and 22 decimals, read where they are: m / 10^e is then exactly rounded)
    s = r.s
    i = r.n0
    neg = false
    if i < r.n1 and (s[i] == '-' or s[i] == '+'):
        neg = s[i] == '-'
        i += 1
    m = 0
    digits = 0
    places = -1
    ok = i < r.n1
    loop k in [i..r.n1):
        c = s[k]
        if c >= '0' and c <= '9':
            m = m * 10 + int(c) - 48
            digits += 1
            if places >= 0: places += 1
        else if c == '.' and places < 0: places = 0
        else:
            ok = false
            break
    if ok and digits > 0 and digits <= 15 and places <= 22:
        v = f64(m)
        if places > 0: v = v / __TX_POW10[places]
        if neg: v = -v
        x = v
        return
    if let v = to_float(r.s[r.n0..r.n1)): x = v
    else: __tx_bad(r, "expected a number")

__TX_POW10 = [1.0, 10.0, 100.0, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]
__read = (r: mut __TextIn, x: mut f32):
    v = 0.0
    __read(r, v)
    x = f32(v)

__read = (r: mut __TextIn, x: mut bool):
    w = __tx_word(r, false)
    if w == "true": x = true
    else if w == "false": x = false
    else: __tx_bad(r, "expected true or false")

__read = (r: mut __TextIn, x: mut str):
    if not __tx_eat(r, '"'):
        if r.json: __tx_fail_json(r, "expected a string")
        else: __tx_fail(r, "expected a string (in \"quotes\")")
        return
    buf: u8[]
    loop r.i < len(r.s) and r.s[r.i] != '"':
        c = r.s[r.i]
        r.i += 1
        if c == '\\' and r.i < len(r.s):
            e = r.s[r.i]
            r.i += 1
            if e == 'n': c = '\n'
            else if e == 't': c = '\t'
            else if e == 'r': c = '\r'
            else if e == '0': c = 0
            else if e == 'x' and r.i + 2 <= len(r.s) and __tx_hex(r.s[r.i]) >= 0 and __tx_hex(r.s[r.i + 1]) >= 0:
                # (a control character, as to_text writes one: \x1b)
                c = u8(__tx_hex(r.s[r.i]) * 16 + __tx_hex(r.s[r.i + 1]))
                r.i += 2
            else if e == 'u' and r.i + 4 <= len(r.s):
                # (JSON's \u00e9: the character, in UTF-8)
                cp = 0
                loop k in [0..4):
                    d = __tx_hex(r.s[r.i + k])
                    if d < 0: cp = -1
                    else if cp >= 0: cp = cp * 16 + d
                if cp >= 0:
                    r.i += 4
                    loop b in bytes(chr(cp)): buf.push(b)
                    continue
                c = e
            else: c = e
        buf.push(c)
    if not __tx_eat(r, '"'): __tx_fail(r, "this string has no closing quote")
    x = __buf_finish_val(buf)

# (a hex digit's value, or -1)
__tx_hex = (h: u8) -> int:
    if h >= '0' and h <= '9': return int(h) - 48
    if h >= 'a' and h <= 'f': return int(h) - 87
    if h >= 'A' and h <= 'F': return int(h) - 55
    -1

# (before a list's or map's next item: false at its end, close; JSON wants a ',' between items,
# and none before the end)
__tx_more = (r: mut __TextIn, close: u8, n: int) -> bool:
    if len(r.err) > 0: return false
    if not r.json:
        __tx_eat(r, ',')
        return not __tx_eat(r, close)
    if __tx_eat(r, close): return false
    if n > 0 and not __tx_eat(r, ','):
        if close == ']': __tx_fail_end(r, "expected , or ] to end the list")
        else: __tx_fail_end(r, "expected , or } to end the object")
        return false
    __tx_space(r)
    if r.i >= len(r.s):
        if close == ']': __tx_fail(r, "expected ] to end the list")
        else: __tx_fail(r, "expected } to end the object")
        return false
    true

__read[T] = (r: mut __TextIn, xs: mut T[]):
    xs.clear()
    __tx_want(r, '[')
    loop __tx_more(r, ']', xs.len()):
        v: T
        __default_init(v)
        __read(r, v)
        if len(r.err) > 0: __tx_at(r, "[{xs.len()}]")
        xs.push(v)

# (a soa array, printed and saved as the array of its elements: [P(x=1.5), P(x=2.0)])
__read[T] = (r: mut __TextIn, xs: mut soa T[]):
    xs.clear()
    __tx_want(r, '[')
    loop __tx_more(r, ']', xs.len()):
        v: T
        __default_init(v)
        __read(r, v)
        if len(r.err) > 0: __tx_at(r, "[{xs.len()}]")
        xs.push(v)

__fmt[T] = (buf: mut u8[], xs: soa T[]):
    __buf_byte(buf, '[')
    loop i in [0..xs.len()):
        if i > 0: __buf_append_str(buf, ", ")
        __fmt_elem(buf, xs[i])
    __buf_byte(buf, ']')
__fmt_elem[T] = (buf: mut u8[], xs: soa T[]): __fmt(buf, xs)

__read[K, V] = (r: mut __TextIn, m: mut Map[K, V]):
    m.clear()
    __tx_want(r, '{{')
    n = 0
    loop __tx_more(r, '}}', n):
        n += 1
        # (JSON's keys are in quotes: a map's number keys too)
        if r.json and r.s[r.i] != '"':
            __tx_fail_json(r, "expected a key in quotes")
            return
        k: K
        __default_init(k)
        __read(r, k)
        if r.json and len(r.err) > 0: return
        __tx_want(r, ':')
        v: V
        __default_init(v)
        __read(r, v)
        if len(r.err) > 0: __tx_at(r, "[{k}]")
        m[k] = v

__read[T] = (r: mut __TextIn, x: mut T?):
    if __tx_kind(r) == 4:
        __tx_word(r, false)
        x = none
        return
    v: T
    __default_init(v)
    __read(r, v)
    x = v

# structs, tuples, enums, unions, vectors, fixed-size arrays: read field by field (the compiler
# writes the code for each type)
__read[T] = (r: mut __TextIn, x: mut T):
    __read_fields(r, x)
    if r.open_err: __tx_name_open(r, to_text(x))

# (JSON: a struct or vector that does not start as one: its type, the start of its text t, is
# named: "expected an object for Todo, found a list")
__tx_name_open = (r: mut __TextIn, t: str):
    r.open_err = false
    e = 0
    loop e < len(t) and t[e] != '(' and t[e] != '[': e += 1
    name = t[0..e)
    what = "an object"
    if starts_with(name, "vec") or starts_with(name, "ivec"): what = "a list"
    r.err = "expected {what} for {name}" + r.err[len("expected an object")..len(r.err))
