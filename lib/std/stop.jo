# Stopping a program that runs until it is stopped (a server, a tool watching something): ctrl-c in
# its terminal, SIGTERM (what systemd, docker stop and kill send) and, on Windows, ctrl-break or
# its console closed ask it to stop. A program that cleans up first watches for that:
#   loop not stopping():
#       ...
#       net.wait(1.0)              # (or sleep: either ends early when it is asked)
#   save()
# or has an on_quit = (): ..., which runs as any program ends: its window closed, its last line
# done, exit() called, or asked to stop. A program that does not look at stopping() ends at its
# next wait (sleep, net.wait, a server's), running on_quit; one busy elsewhere, at a second ctrl-c
# (then on_quit does not run).

# true once the program has been asked to stop (ctrl-c, SIGTERM, its console closed): from the
# first call on, being asked no longer ends the program at once, it is for the program to stop
stopping = () -> bool:
    global __stop_polled
    __stop_polled = true
    __stop_watch()
    __stop_asked

__stop_watching = false
__stop_finished = false             # (Windows: the program has ended, so the console may close)

# (from now on, ctrl-c and SIGTERM set __stop_asked rather than end the program; a second one
# ends it as before)
__stop_watch = ():
    global __stop_watching
    if __stop_watching: return
    __stop_watching = true
    when TARGET == "windows":
        h: cfn(u32) -> i32 = __stop_console
        SetConsoleCtrlHandler(h as *u8, 1)
        # (what it calls, looked up now: that allocates, which it cannot on the thread it runs on)
        Sleep(u32(0))
    else when TARGET != "wasm":
        h: cfn(i32) = __stop_signal
        act = [h as int, 0x10000000 | 0x80000000, 0, 0]       # SA_RESTART | SA_RESETHAND
        when TARGET == "linux" and ARCH != "arm64":
            act[1] |= 0x04000000                                # SA_RESTORER
            act[2] = __stop_restorer()
        syscall(13, 2, data(act), 0, 8)                         # rt_sigaction(SIGINT)
        syscall(13, 15, data(act), 0, 8)                        # rt_sigaction(SIGTERM)

@cabi
__stop_signal = (sig: i32):
    global __stop_asked, __stop_sig
    __stop_asked = true
    __stop_sig = int(sig)

# (x86-64 Linux: a handler returns through code of the program's that asks the system to go back to
# what it interrupted, rt_sigreturn: mov eax, 15; syscall)
__stop_restorer = () -> int:
    when TARGET == "linux":
        p = syscall(9, 0, 4096, 3, 0x22, -1, 0)                 # mmap: read, write
        if p < 0: return 0
        code: u8[] = [0xB8, 15, 0, 0, 0, 0x0F, 0x05]
        loop i in [0..code.len()): (p as *u8)[i] = code[i]
        syscall(10, p, 4096, 5)                                 # mprotect: read, run
        return p
    0

# (Windows: ctrl-c, ctrl-break, the console closed, a logoff or shutdown; a second ctrl-c is left
# to the system, which ends the program. Closed: the program is ended when this returns, so it waits
# for it to finish, up to the 5 seconds Windows gives)
@cabi
__stop_console = (kind: u32) -> i32:
    global __stop_asked, __stop_sig
    if __stop_asked and int(kind) < 2: return 0
    __stop_asked = true
    __stop_sig = 2
    if int(kind) >= 2:
        loop _ in [0..48):
            if __stop_finished: break
            when TARGET == "windows":
                Sleep(u32(100))
    1
