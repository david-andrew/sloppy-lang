# A set: values without repeats, kept in the order they were first added, asked about in about
# the same time however many it holds (a map from each to nothing, underneath).
#
#   seen: Set[int]                      # (or seen: Set[int] = {}, empty)
#   seen.add(start)
#   vowels = {"a", "e", "i", "o", "u"}  # the values written; {loop w in ws: w.lower()} too
#   if next in seen: continue           # x in s, or s.has(x)
#   words = set(split(text, " "))       # the different words
#   loop w in words: print(w)
#   both = a.intersection(b)            # also union, difference, is_subset
#
# Sets compare with `==` by what they hold, in any order, and print as {1, 2, 3}.

struct Set[T]:
    __m: {T: bool}

# a set of the values in xs (each once)
set[T] = (xs: T[]) -> Set[T]:
    s: Set[T]
    loop x in xs: s.__m[x] = true
    s

# put x in; true when it was not there yet (`if seen.add(v): queue.push(v)`)
add[T] = (s: mut Set[T], x: T) -> bool:
    if s.__m.has(x): return false
    s.__m[x] = true
    true

# take x out; true when it was there
remove[T] = (s: mut Set[T], x: T) -> bool: s.__m.remove(x)

has[T] = (s: Set[T], x: T) -> bool: s.__m.has(x)
# (x in s)
contains[T] = (s: Set[T], x: T) -> bool: s.__m.has(x)
len[T] = (s: Set[T]) -> int: s.__m.len()
is_empty[T] = (s: Set[T]) -> bool: s.__m.len() == 0
clear[T] = (s: mut Set[T]): s.__m.clear()

# the values, in the order they were added (a loop over the set goes over these)
items[T] = (s: Set[T]) -> T[]: s.__m.keys()

# what is in a, in b, or in both
union[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    s = a
    loop x in b.__m.keys(): s.__m[x] = true
    s

# what is in both a and b
intersection[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    s: Set[T]
    loop x in a.__m.keys():
        if b.__m.has(x): s.__m[x] = true
    s

# what is in a and not in b
difference[T] = (a: Set[T], b: Set[T]) -> Set[T]:
    s: Set[T]
    loop x in a.__m.keys():
        if not b.__m.has(x): s.__m[x] = true
    s

# whether everything in a is in b
is_subset[T] = (a: Set[T], b: Set[T]) -> bool:
    loop x in a.__m.keys():
        if not b.__m.has(x): return false
    true

# the same values, in any order
(==)[T] = (a: Set[T], b: Set[T]) -> bool: a.__m.len() == b.__m.len() and is_subset(a, b)
# a number made from the values, in any order: sets that are == hash alike (so a set can be a key)
hash[T] = (s: Set[T]) -> u64: hash(s.__m)

# (loop x in s: the compiler loops over this, check.jo)
__loop_items[T] = (s: Set[T]) -> T[]: s.__m.keys()

__fmt[T] = (buf: mut u8[], s: Set[T]):
    __buf_byte(buf, '{{')
    loop i in 0.. and x in s.__m.keys():
        if i > 0: __buf_append_str(buf, ", ")
        __fmt_elem(buf, x)
    __buf_byte(buf, '}}')

# ({1, 2, 3} and {loop w in ws: w}: a set of the values written)
__set_of[T] = (xs: T[]) -> Set[T]: set(xs)
