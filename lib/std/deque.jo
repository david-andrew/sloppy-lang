# A double-ended queue: values pushed and popped at either end in the same short time, however
# many it holds (an array's insert(0, x) and remove(0) move all the others). A breadth-first
# search's frontier, a sliding window, an undo list with a limit.
#
#   q: Deque[int]
#   q.push(start)                       # at the back
#   loop q.len() > 0:
#       v = q.pop_front()               # the oldest
#       ...q.push(next)
#   q.push_front(x)                     # at the front; q.pop() takes from the back
#   q.first(), q.last(), q[i]           # (i from the front)
#
# A loop over a deque goes from front to back; it prints as an array does.

struct Deque[T]:
    __buf: T[]           # a ring: its length a power of two, or 0
    __head = 0           # where the front is in __buf
    __n = 0

len[T] = (d: Deque[T]) -> int: d.__n
is_empty[T] = (d: Deque[T]) -> bool: d.__n == 0

# put x at the back
push[T] = (d: mut Deque[T], x: T):
    if d.__n == d.__buf.len(): __deque_grow(d)
    d.__buf[(d.__head + d.__n) & (d.__buf.len() - 1)] = x
    d.__n += 1

# put x at the front
push_front[T] = (d: mut Deque[T], x: T):
    if d.__n == d.__buf.len(): __deque_grow(d)
    d.__head = (d.__head - 1) & (d.__buf.len() - 1)
    d.__buf[d.__head] = x
    d.__n += 1

# take the value at the back out (the deque must not be empty)
pop[T] = (d: mut Deque[T]) -> T:
    if d.__n == 0: panic("pop from an empty Deque (ask d.len() > 0 first)")
    i = (d.__head + d.__n - 1) & (d.__buf.len() - 1)
    x = d.__buf[i]
    z: T
    d.__buf[i] = z
    d.__n -= 1
    x

# take the value at the front out (the deque must not be empty)
pop_front[T] = (d: mut Deque[T]) -> T:
    if d.__n == 0: panic("pop_front from an empty Deque (ask d.len() > 0 first)")
    x = d.__buf[d.__head]
    z: T
    d.__buf[d.__head] = z
    d.__head = (d.__head + 1) & (d.__buf.len() - 1)
    d.__n -= 1
    x

# the value at the front, and at the back (the deque must not be empty)
first[T] = (d: Deque[T]) -> T:
    if d.__n == 0: panic("first of an empty Deque (ask d.len() > 0 first)")
    d.__buf[d.__head]
last[T] = (d: Deque[T]) -> T:
    if d.__n == 0: panic("last of an empty Deque (ask d.len() > 0 first)")
    d.__buf[(d.__head + d.__n - 1) & (d.__buf.len() - 1)]

# the i-th value from the front
([])[T] = (d: Deque[T], i: int) -> T:
    if i < 0 or i >= d.__n: panic("index {i} out of bounds of a Deque of {d.__n}")
    d.__buf[(d.__head + i) & (d.__buf.len() - 1)]

([]=)[T] = (d: mut Deque[T], i: int, x: T):
    if i < 0 or i >= d.__n: panic("index {i} out of bounds of a Deque of {d.__n}")
    d.__buf[(d.__head + i) & (d.__buf.len() - 1)] = x

clear[T] = (d: mut Deque[T]):
    d.__buf.clear()
    d.__head = 0
    d.__n = 0

# the values from front to back, in an array (a loop over the deque goes over these)
items[T] = (d: Deque[T]) -> T[]:
    out: T[]
    out.reserve(d.__n)
    loop k in 0..d.__n: out.push(d.__buf[(d.__head + k) & (d.__buf.len() - 1)])
    out

# (a ring twice as big, the values from its start)
__deque_grow[T] = (d: mut Deque[T]):
    n = max(d.__buf.len() * 2, 8)
    z: T
    nb = fill(z, n)
    loop k in 0..d.__n: nb[k] = d.__buf[(d.__head + k) & (d.__buf.len() - 1)]
    d.__buf = nb
    d.__head = 0

# (loop x in d: the compiler loops over this, check.jo)
__loop_items[T] = (d: Deque[T]) -> T[]: items(d)

# (as an array: [1, 2, 3])
__fmt[T] = (buf: mut u8[], d: Deque[T]): __fmt(buf, items(d))

# the same values in the same order
(==)[T] = (a: Deque[T], b: Deque[T]) -> bool: a.__n == b.__n and items(a) == items(b)
# a number made from the values, in order: deques that are == hash alike (so a deque can be a key)
hash[T] = (d: Deque[T]) -> u64: hash(items(d))
