# __TITLE__: run it with `sloppy __NAME__.jo`, test it with `sloppy test __NAME__.jo`.

build:
    name = "__TITLE__"

# the words of a text and how often each comes, most frequent first
word_counts = (text: str) -> (str, int)[]:
    counts: {str: int}
    loop raw in text.lower().split(" "):
        w = raw.trim(".,;:!?\"'()")
        if len(w) > 0: counts[w] = (counts.get(w) ?? 0) + 1
    pairs: (str, int)[]
    loop w, n in counts: pairs.push((w, n))
    pairs.sort_by((p: (str, int)): -p.1)
    pairs

main = ():
    a = args()
    text = "the quick brown fox jumps over the lazy dog, and the dog sleeps"
    if a.len() >= 2:
        # (a file given: its words)
        text = read_file(a[1]) ?? ""
    counts = word_counts(text)
    loop p in counts[..min(5, counts.len())): print("{p.0:<10} {p.1}")

test "words are counted":
    c = word_counts("a b a, A!")
    assert(c[0] == ("a", 3))
    assert(c[1] == ("b", 1))
