# __TITLE__: a program for the whole terminal, a list of things to do. Run it with
# `sloppy __NAME__.jo`, test it with `sloppy test __NAME__.jo`. Up and down (or the mouse) choose,
# space marks one done, a adds one, d deletes one, q quits; the list is kept between runs.
import term

build:
    name = "__TITLE__"

struct Item:
    text: str
    done = false

items: Item[] = load_value("items", [Item("move with up and down"), Item("mark this one done with space"), Item("add one with a")])
chosen = 0
adding = false                  # (a new one is being typed)
typed = ""

# how many are done, as the title shows it
progress = (xs: Item[]) -> str: "{xs.count((x): x.done)} of {xs.len()} done"

choose = (i: int):
    global chosen
    chosen = clamp(i, 0, max(items.len() - 1, 0))

show = ():
    w, h = term.size()
    term.clear()
    term.box(0, 0, w, h - 1, fg = term.CYAN, lines = .rounded, title = "__TITLE__: {progress(items)}")
    loop i in 0.. and x in items and i < h - 3:
        mark = if x.done: "✓ " else: "· "
        fg = if x.done: term.GRAY else: term.DEFAULT
        style = if i == chosen: term.REVERSE else: 0
        term.put(2, 1 + i, term.fit(mark + x.text, w - 4), fg = fg, style = style)
    term.hide_cursor()
    if adding:
        x = term.put(0, h - 1, "new: ", fg = term.YELLOW)
        term.set_cursor(term.put(x, h - 1, typed), h - 1)
    else: term.put(0, h - 1, term.fit("up/down choose  space done  a add  d delete  q quit", w), fg = term.GRAY)
    term.flush()

main = () -> int:
    global adding, typed
    if not term.start(mouse = true):
        eprint("__NAME__: this is for a terminal (standard input and output are not one)")
        return 1
    loop:
        show()
        e = term.read_event() ?? break
        if e.kind == .mouse and e.mouse == .press: choose(e.y - 1)
        else if e.kind == .mouse and e.mouse == .wheel_up: choose(chosen - 1)
        else if e.kind == .mouse and e.mouse == .wheel_down: choose(chosen + 1)
        else if e.kind == .paste and adding: typed += e.text.replace("\n", " ")
        else if e.kind != .key: continue
        else if adding:
            if e.key == .enter and len(trim(typed)) > 0:
                items.push(Item(trim(typed)))
                choose(items.len() - 1)
            if e.key == .enter or e.key == .escape:
                adding = false
                typed = ""
            else if e.key == .backspace: typed = typed.without_last_char()
            else if e.key == .char and not e.ctrl and not e.alt: typed += e.text
        else:
            match e.name:
                "q", "escape": break
                "up", "k": choose(chosen - 1)
                "down", "j": choose(chosen + 1)
                "space", "enter":
                    if chosen < items.len(): items[chosen].done = not items[chosen].done
                "a": adding = true
                "d", "delete":
                    if chosen < items.len():
                        items.remove_at(chosen)
                        choose(chosen)
    0

# (as the program ends, by q, ctrl-c or the terminal closed)
on_quit = (): save_value("items", items)

test "progress counts the ones done":
    xs = [Item("a", done = true), Item("b"), Item("c", done = true)]
    assert(progress(xs) == "2 of 3 done")
    assert(progress([]) == "0 of 0 done")
