# __TITLE__: an animated third-person character in a small valley. No downloads: character.glb
# is CC0, generated by tools/makecharacter.py. Replace it with your own glTF and clip names.
# WASD/arrows or left stick: walk. Shift or gamepad X: run. Right drag or right stick:
# look. On touch screens use the move pad, Run and Pause. Escape/Start pauses.
# Run `sloppy watch __NAME__.jo`; build for the browser with `sloppy build --target wasm __NAME__.jo`.

build:
    name = "__TITLE__"

import layout as ui

window("__TITLE__", 1280, 720)
screen_fit(.native)                         # HUD and menu use the actual screen size
sideways_hint(false)                        # both portrait and landscape layouts fit
hero = load_model(embed("character.glb"))    # one skin, seven joints; faces +Z
hero_scale = 1.9 / max(f64(model_size(hero).y), 0.001)
anim: Animator
pos = vec3(0, 0, 0)
facing = PI
cam = follow_camera(distance = 5.5, height = 1.0, pitch = 0.25)
cam.update(pos, 0.0, input = false)
paused = false
touch_move = vec2(0, 0)
touch_run = false

# ---------------- the place: flat in the middle, hills around ----------------
height_at = (x: f64, z: f64) -> f64:
    d = max(sqrt(x * x + z * z) - 20.0, 0.0)        # how far past the flat middle
    d * d * 0.004 + d * 0.15 * sin(x * 0.09) * cos(z * 0.07)
grass = (x: f64, y: f64, z: f64) -> vec4:
    patches = 0.5 + 0.5 * sin(x * 0.3 + 2.0 * sin(z * 0.23))
    mix(rgb(0.09, 0.25, 0.06), rgb(0.22, 0.36, 0.08), f32(patches))
ground = terrain_mesh(160, 64, height_at, grass)

# What stands still is built once into two meshes, one draw each: cheap on phones.
flat: Vertex3D[]                                      # the paving, which casts no shadow
stone = rgb(0.5, 0.39, 0.27)
add_cylinder(flat, vec3(0, -0.1, 0), 9.6, 0.15, rgb(0.27, 0.24, 0.2), segments = 40)    # the plaza
seed_random(7)
loop x in -9..10:                                     # its tiles, of a few shades
    loop z in -9..10:
        shade = mix(stone, rgb(0.36, 0.3, 0.23), f32(random(0.0, 1.0)))
        if x * x + z * z < 84: add_box(flat, vec3(x, 0.08, z), vec3(0.94, 0.08, 0.94), shade)
loop i in 0..9:                                       # stepping stones out to a gate
    add_box(flat, vec3(sin(f64(i) * 0.8) * 0.6, 0, -10.6 - f64(i) * 1.4), vec3(1.1, 0.12, 0.9), stone)
paving = custom_mesh(flat)
tall: Vertex3D[]                                      # what stands up and casts shadows
loop i in 0..10:                                      # a ring of pillars, a few fallen
    a = f64(i) / 10.0 * TAU
    at = vec3(sin(a) * 9.0, 0, cos(a) * 9.0)
    h = if i % 4 == 1: 1.3 else: 3.4
    add_box(tall, at + vec3(0, h / 2.0, 0), vec3(0.7, h, 0.7), stone)
    if h > 3.0: add_box(tall, at + vec3(0, h + 0.15, 0), vec3(1.0, 0.3, 1.0), stone)
loop x in [-1.6, 1.6]: add_box(tall, vec3(x, 2.2, -24), vec3(0.8, 4.4, 0.8), stone)
add_box(tall, vec3(0, 4.6, -24), vec3(4.6, 0.6, 1.0), stone)
loop i in 0..70:                                      # trees and rocks around, none on the path
    a = random(0.0, TAU)
    r = random(12.0, 50.0)
    x = sin(a) * r
    z = cos(a) * r
    if abs(x) < 4.0 and z < 0.0: continue
    base = vec3(x, height_at(x, z) - 0.2, z)
    s = random(0.7, 1.4)
    if i % 4 == 0: add_sphere(tall, base, s, rgb(0.3, 0.29, 0.27), segments = 6, rings = 4)
    else:
        add_cylinder(tall, base, 0.2 * s, 1.4 * s, rgb(0.28, 0.18, 0.1), segments = 6)
        add_cylinder(tall, base + vec3(0, s, 0), 1.3 * s, 3.2 * s, rgb(0.08, 0.22 + 0.06 * s, 0.1), segments = 7, top_radius = 0)
place = custom_mesh(tall)

update = (dt: f64):
    global paused, facing
    if key_pressed(.escape) or gamepad_pressed(.start): paused = not paused
    if paused:
        cam.update(pos, dt, input = false)   # follow/smooth without menu look or zoom
        return
    axis = input_axis() + touch_move
    if length(axis) > 1.0: axis = normalize(axis)
    move = flat_forward(cam) * -axis.y + flat_right(cam) * axis.x
    running = key_down(.shift) or gamepad_down(.x) or touch_run
    clip = "Idle"
    if length(move) > 0.1:
        speed = if running: 5.0 else: 2.2
        pos += move * f32(speed * dt)
        facing = atan2(f64(move.x), f64(move.z))
        clip = if running: "Run" else: "Walk"
    on_plaza = length(vec2(pos.x, pos.z)) < 9.5
    pos.y = f32(if on_plaza: 0.12 else: height_at(f64(pos.x), f64(pos.z)))    # stand on the tiles or the ground
    anim.play(hero, clip, fade = 0.2)         # repeated play keeps this clip's time
    anim.update(hero, dt)                    # advance once; pose() also includes the crossfade
    cam.update(pos, dt)

draw = ():
    global paused, touch_move, touch_run
    haze = vec3(0.84, 0.82, 0.76)                     # the horizon: far things fade into it
    sky(vec3(0.2, 0.44, 0.8), haze, vec3(0.25, 0.3, 0.18))
    sun(vec3(-0.7, 0.7, 0.4), vec3(1.0, 0.86, 0.68))  # warm, from the left
    shadows(true, area = 16)                          # sharper near, none far away
    fog(haze, 0.006)
    sw = screen_width()
    sh = screen_height()
    camera3d(cam, fov_degrees = if sh > sw: 80.0 else: 60.0)    # a phone held upright sees more
    # Nearest first: what they hide then costs little to draw.
    draw_model(hero, transform(pos, facing, hero_scale), pose = anim.pose(hero))
    draw_mesh(place, material = Material(roughness = 0.85))
    draw_mesh(paving, material = Material(roughness = 0.8), cast_shadow = false)
    draw_mesh(ground, material = Material(roughness = 0.95), cast_shadow = false)
    narrow = sw < 700
    touch = touch_device() or touch_input()
    touch_move = vec2(0, 0)
    touch_run = false
    if not paused:
        if touch:
            center = vec2(84, sh - 90)
            run_at = vec2(sw - 70, sh - 90)
            loop finger in touches():
                if length(finger - center) < 76:
                    touch_move = (finger - center) / 50
                    if length(touch_move) > 1: touch_move = normalize(touch_move)
                if length(finger - run_at) < 44: touch_run = true
            circle(center, 64, rgba(0, 0, 0, 0.35))
            circle(center + touch_move * 40, 24, rgba(1, 1, 1, 0.65))
            circle(run_at, 38, if touch_run: rgba(1, 0.82, 0.4, 0.6) else: rgba(0, 0, 0, 0.35))
            text_centered("Run", run_at, 20)
        ui.screen(pad = 16, gap = 8, ():
            ui.row(width = ui.grow(), gap = 12, cross = .center, ():
                ui.panel(pad = ui.insets(14, 8, 14, 8), ():
                    ui.label("__TITLE__", size = if narrow: 20 else: 24)
                )
                ui.space(width = ui.grow())
                if ui.button("Pause", width = 90, key = "pause"): paused = true
            )
            if not touch:
                ui.space(height = ui.grow())
                ui.panel(pad = ui.insets(14, 8, 14, 8), ():
                    ui.label("WASD / stick: move · Shift / X: run · Right drag / right stick: look · Esc / Start: pause", size = if narrow: 13 else: 16, color = hud_style.muted, wrap = true)
                )
        )
    else:
        rect(Rect(0, 0, sw, sh), rgba(0, 0, 0, 0.55))
        ui.screen(pad = 20, cross = .center, ():
            ui.space(height = ui.grow())
            ui.panel(width = ui.grow(max = 360), gap = 16, ():
                ui.label("Paused", size = 32)
                cam.invert_y = ui.switch(cam.invert_y, "Invert Y", key = "invert-y")
                if ui.button("Resume", width = ui.grow(), key = "resume"): paused = false
                if not touch: ui.label("Esc / Start also resumes", size = 16, color = hud_style.muted)
            )
            ui.space(height = ui.grow())
        )
