    @lib("ws2_32.dll")
    @symbol("getsockname")
    extern __w_getsockname = (s: int, addr: *u8, len: *i32) -> i32

    __n_local_ip = () -> int:
        __n_start()
        s = __w_socket(i32(2), i32(2), i32(17))
        if s == -1: return -1
        a = __n_addr(0x08080808, 53)
        r = int(__w_connect(s, data(a), i32(16)))
        b = fill(u8(0), 16)
        l: i32[] = [16]
        g = int(__w_getsockname(s, data(b), data(l)))
        __w_closesocket(s)
        if r != 0 or g != 0: return -1
        (int(b[4]) << 24) | (int(b[5]) << 16) | (int(b[6]) << 8) | int(b[7])

    __n_sock_port = (s: int) -> int:
        b = fill(u8(0), 16)
        l: i32[] = [16]
        if int(__w_getsockname(s, data(b), data(l))) != 0: return -1
        (int(b[2]) << 8) | int(b[3])

    __n_udp = (port: int) -> int:
        __n_start()
        s = __w_socket(i32(2), i32(2), i32(17))
        if s == -1: return -1
        a = __n_addr(0, port)
        if int(__w_bind(s, data(a), i32(16))) != 0:
            __w_closesocket(s)
            return -1
        one: u32[] = [1]
        __w_ioctlsocket(s, i32(-2147195266), data(one))             # FIONBIO
        s

    __n_sendto = (s: int, p: *u8, n: int, ip: int, port: int) -> int:
        a = __n_addr(ip, port)
        int(__w_sendto(s, p, i32(n), i32(0), data(a), i32(16)))

    __n_recvfrom = (s: int, p: *u8, n: int, from: mut u8[]) -> int:
        # (a datagram sent earlier to a port nothing listens on fails a later receive: WSAECONNRESET)
        loop _ in [0..16):
            l: i32[] = [16]
            r = int(__w_recvfrom(s, p, i32(n), i32(0), data(from), data(l)))
            if r >= 0 or int(WSAGetLastError()) != 10054: return r
        -1

    __n_started = false
    __n_start = ():
        if __n_started: return
        __n_started = true
        d = fill(u8(0), 512)
        WSAStartup(u16(0x0202), data(d))

    __n_setup = (s: int):
        one: u32[] = [1]
        __w_ioctlsocket(s, i32(-2147195266), data(one))   # (0x8004667E)              # FIONBIO
        __w_setsockopt(s, i32(6), i32(1), data(one) as *u8, i32(4)) # TCP_NODELAY

    __n_listen = (ip: int, port: int, backlog: int) -> int:
        __n_start()
        s = __w_socket(i32(2), i32(1), i32(6))
        if s == -1: return -1
        a = __n_addr(ip, port)
        if int(__w_bind(s, data(a), i32(16))) != 0 or int(__w_listen(s, i32(backlog))) != 0:
            __w_closesocket(s)
            return -1
        __n_setup(s)
        s

    __n_connect = (ip: int, port: int) -> int:
        __n_start()
        s = __w_socket(i32(2), i32(1), i32(6))
        if s == -1: return -1
        __n_setup(s)
        a = __n_addr(ip, port)
        if int(__w_connect(s, data(a), i32(16))) != 0 and int(WSAGetLastError()) != 10035:
            __w_closesocket(s)
            return -1
        s

    __n_connected = (s: int) -> int:
        # (WSAPOLLFD: the socket, events, revents)
        pfd = [s, 0x10]                                             # POLLWRNORM
        if int(WSAPoll(data(pfd) as *u8, u32(1), i32(0))) <= 0: return 0
        if (pfd[1] >> 16) & 0x3 != 0:                               # (POLLERR, POLLHUP)
            # (why: SO_ERROR, a WSA error number)
            err: i32[] = [0]
            len_: i32[] = [4]
            __w_getsockopt(s, i32(0xFFFF), i32(0x1007), data(err) as *u8, data(len_))
            if err[0] != 0: return -int(err[0])
            return -1
        1

    __n_accept = (lfd: int) -> int:
        a = fill(u8(0), 16)
        l: i32[] = [16]
        s = __w_accept(lfd, data(a), data(l))
        if s == -1: return if int(WSAGetLastError()) == 10035: -1 else: -2
        __n_from = __n_addr_ip(a)
        __n_setup(s)
        s

    __n_send = (s: int, p: *u8, n: int) -> int:
        r = int(__w_send(s, p, i32(min(n, 1 << 30)), i32(0)))
        if r < 0:
            if int(WSAGetLastError()) == 10035: return -1
            return -2
        r

    __n_recv = (s: int, p: *u8, n: int) -> int:
        r = int(__w_recv(s, p, i32(n), i32(0)))
        if r < 0:
            if int(WSAGetLastError()) == 10035: return -1
            return -2
        r

    __n_close = (s: int): __w_closesocket(s)

    __n_lookup = (host: str) -> int:
        __n_start()
        h = __w_gethostbyname(data(__zstr(host)))
        if h == null: return -1
        list = ((h + 24) as **u8)[0]
        if list == null: return -1
        a = (list as **u8)[0]
        if a == null: return -1
        (int(a[0]) << 24) | (int(a[1]) << 16) | (int(a[2]) << 8) | int(a[3])

