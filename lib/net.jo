    __n_local_ip = () -> int:
        fd = int(__m_socket(i32(2), i32(2), i32(0)))
        if fd < 0: return -1
        a = __n_addr(0x08080808, 53)
        r = int(__m_connect(i32(fd), data(a), u32(16)))
        b = fill(u8(0), 16)
        l: u32[] = [16]
        g = int(__m_getsockname(i32(fd), data(b), data(l)))
        syscall(3, fd)
        if r != 0 or g != 0: return -1
        (int(b[4]) << 24) | (int(b[5]) << 16) | (int(b[6]) << 8) | int(b[7])

    __n_sock_port = (fd: int) -> int:
        b = fill(u8(0), 16)
        l: u32[] = [16]
        if int(__m_getsockname(i32(fd), data(b), data(l))) != 0: return -1
        (int(b[2]) << 8) | int(b[3])

    __n_udp = (port: int) -> int:
        fd = int(__m_socket(i32(2), i32(2), i32(0)))
        if fd < 0: return -1
        a = __n_addr(0, port)
        if int(__m_bind(i32(fd), data(a), u32(16))) != 0:
            syscall(3, fd)
            return -1
        __c_fcntl(i32(fd), i32(4), 0, 0, 0, 0, 0, 0, 4)            # F_SETFL O_NONBLOCK
        fd

    __n_sendto = (fd: int, p: *u8, n: int, ip: int, port: int) -> int:
        a = __n_addr(ip, port)
        __m_sendto(i32(fd), p, n, i32(0), data(a), u32(16))

    __n_recvfrom = (fd: int, p: *u8, n: int, from: mut u8[]) -> int:
        l: u32[] = [16]
        __m_recvfrom(i32(fd), p, n, i32(0), data(from), data(l))

    # (non-blocking, and no SIGPIPE when the other end has gone: SO_NOSIGPIPE)
    __n_setup = (fd: int):
        __c_fcntl(i32(fd), i32(4), 0, 0, 0, 0, 0, 0, 4)            # F_SETFL O_NONBLOCK
        one = [1]
        __m_setsockopt(i32(fd), i32(0xFFFF), i32(0x1022), data(one) as *u8, u32(4))
        __m_setsockopt(i32(fd), i32(6), i32(1), data(one) as *u8, u32(4))      # TCP_NODELAY

    __n_listen = (ip: int, port: int, backlog: int) -> int:
        fd = int(__m_socket(i32(2), i32(1), i32(0)))
        if fd < 0: return -1
        one = [1]
        __m_setsockopt(i32(fd), i32(0xFFFF), i32(4), data(one) as *u8, u32(4))  # SO_REUSEADDR
        a = __n_addr(ip, port)
        if int(__m_bind(i32(fd), data(a), u32(16))) != 0 or int(__m_listen(i32(fd), i32(backlog))) != 0:
            syscall(3, fd)
            return -1
        __n_setup(fd)
        fd

    __n_connect = (ip: int, port: int) -> int:
        fd = int(__m_socket(i32(2), i32(1), i32(0)))
        if fd < 0: return -1
        __n_setup(fd)
        a = __n_addr(ip, port)
        r = __mac_r(int(__m_connect(i32(fd), data(a), u32(16))))
        if r != 0 and r != -36:                                     # (EINPROGRESS: 36 on macOS, kept by __mac_r)
            syscall(3, fd)
            return -1
        fd

    __n_connected = (fd: int) -> int:
        pfd = [fd | (4 << 32)]
        if syscall(7, data(pfd), 1, 0) <= 0: return 0
        err = [0]
        len_: u32[] = [4]
        __m_getsockopt(i32(fd), i32(0xFFFF), i32(0x1007), data(err) as *u8, data(len_))   # SO_ERROR
        if err[0] & 0xFFFFFFFF != 0: return -(err[0] & 0xFFFFFFFF)
        1

    __n_accept = (lfd: int) -> int:
        a = fill(u8(0), 16)
        l: u32[] = [16]
        fd = __mac_r(int(__m_accept(i32(lfd), data(a), data(l))))
        if fd < 0: return if fd == -11: -1 else: -2
        __n_from = __n_addr_ip(a)
        __n_setup(fd)
        fd

    __n_send = (fd: int, p: *u8, n: int) -> int:
        r = __mac_r(__m_send(i32(fd), p, n, i32(0)))
        if r == -11: return -1                                  # (EAGAIN, as __mac_r gives it: Linux's number)
        if r < 0: return -2
        r

    __n_recv = (fd: int, p: *u8, n: int) -> int:
        r = __mac_r(__m_recv(i32(fd), p, n, i32(0)))
        if r == -11: return -1                                  # (EAGAIN, as __mac_r gives it: Linux's number)
        if r < 0: return -2
        r

    __n_close = (fd: int): syscall(3, fd)

    __n_lookup = (host: str) -> int:
        h = __m_gethostbyname(data(__zstr(host)))
        if h == null: return -1
        # (struct hostent: name, aliases, type and length, then the list of addresses)
        list = ((h + 24) as **u8)[0]
        if list == null: return -1
        a = (list as **u8)[0]
        if a == null: return -1
        (int(a[0]) << 24) | (int(a[1]) << 16) | (int(a[2]) << 8) | int(a[3])

