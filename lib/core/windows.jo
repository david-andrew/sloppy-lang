# The operating system layer of Windows programs (sloppy build --target windows): what
# os.jo and rt.jo do with Linux system calls, done with the functions of Windows' DLLs. Those
# are looked up on first use (with LoadLibraryA and GetProcAddress, which the program imports
# with ExitProcess: compiler/pe.jo), like the C functions of `extern` declarations on Linux.

when TARGET == "windows":
    # ---------------- C functions of DLLs ----------------
    __w32_libs: str[]
    __w32_handles: *u8[]

    # (threads may look functions up at once: one at a time; a plain global, zero before any
    # initializer runs, as functions may be looked up that early)
    __w32_resolve_lock = 0

    __ffi_resolve = (lib: str, name: str) -> *u8:
        if lib == "libGLESv2.so.2":
            # (the library's OpenGL ES functions: OpenGL's, through the WGL context)
            g = __w32_gl_proc(name)
            if g == null: panic("OpenGL function {name} not found")
            return g
        lk = &__w32_resolve_lock
        loop __atomic_cas(lk, 0, 1) != 0: pass
        h = __w32_lib(__w32_dll_name(lib))
        p: *u8 = null
        if h != null: p = GetProcAddress(h, data(__zstr(name)))
        __atomic_cas(lk, 1, 0)
        if h == null: panic("cannot load {lib} (needed for {name})")
        if p == null: panic("function {name} not found in {lib}")
        p

    __w32_lib = (lib: str) -> *u8:
        loop i in 0.. and n in __w32_libs:
            if n == lib: return __w32_handles[i]
        h = LoadLibraryA(data(__zstr(lib)))
        __w32_libs.push(lib)
        __w32_handles.push(h)
        h

    # (the Linux name of a library both systems have: Windows' name for it)
    __w32_dll_name = (lib: str) -> str:
        if lib == "libvulkan.so.1": return "vulkan-1.dll"
        lib

    # true if the library can be loaded on this system
    lib_available = (lib: str) -> bool: __w32_lib(__w32_dll_name(lib)) != null

    # (these are imported by the program: compiler/pe.jo, pe_imports)
    @lib("kernel32.dll")
    extern ExitProcess = (code: u32)
    @lib("kernel32.dll")
    extern IsDebuggerPresent = () -> i32
    @lib("kernel32.dll")
    extern DebugBreak = ()
    @lib("kernel32.dll")
    extern LoadLibraryA = (name: *u8) -> *u8
    @lib("kernel32.dll")
    extern GetProcAddress = (h: *u8, name: *u8) -> *u8
    @lib("kernel32.dll")
    extern GetStdHandle = (which: u32) -> *u8
    @lib("kernel32.dll")
    extern WriteFile = (h: *u8, buf: *u8, n: u32, written: *u32, ov: *u8) -> i32
    @lib("kernel32.dll")
    extern ReadFile = (h: *u8, buf: *u8, n: u32, got: *u32, ov: *u8) -> i32
    @lib("kernel32.dll")
    extern CreateFileW = (name: *u16, access: u32, share: u32, sec: *u8, disposition: u32, flags: u32, template: *u8) -> *u8
    @lib("kernel32.dll")
    extern GetFileSizeEx = (h: *u8, size: *int) -> i32
    @lib("kernel32.dll")
    extern CloseHandle = (h: *u8) -> i32
    @lib("kernel32.dll")
    extern DeleteFileW = (name: *u16) -> i32
    @lib("kernel32.dll")
    extern GetFileAttributesW = (name: *u16) -> u32
    @lib("kernel32.dll")
    extern CreateDirectoryW = (name: *u16, sec: *u8) -> i32
    @lib("kernel32.dll")
    extern FindFirstFileW = (pattern: *u16, found: *u8) -> *u8
    @lib("kernel32.dll")
    extern FindNextFileW = (h: *u8, found: *u8) -> i32
    @lib("kernel32.dll")
    extern FindClose = (h: *u8) -> i32
    @lib("kernel32.dll")
    extern GetModuleFileNameW = (module: *u8, buf: *u16, n: u32) -> u32
    @lib("kernel32.dll")
    extern GetCommandLineW = () -> *u16
    @lib("shell32.dll")
    extern CommandLineToArgvW = (cmd: *u16, argc: *i32) -> **u16
    @lib("kernel32.dll")
    extern GetEnvironmentVariableW = (name: *u16, buf: *u16, n: u32) -> u32
    @lib("kernel32.dll")
    extern QueryPerformanceCounter = (count: *int) -> i32
    @lib("kernel32.dll")
    extern QueryPerformanceFrequency = (freq: *int) -> i32
    @lib("kernel32.dll")
    extern Sleep = (ms: u32)
    @lib("kernel32.dll")
    extern VirtualAlloc = (p: *u8, size: int, kind: u32, protect: u32) -> *u8
    @lib("kernel32.dll")
    extern VirtualFree = (p: *u8, size: int, kind: u32) -> i32
    @lib("kernel32.dll")
    extern SetConsoleOutputCP = (cp: u32) -> i32
    @lib("kernel32.dll")
    extern CreateProcessW = (app: *u16, cmd: *u16, psec: *u8, tsec: *u8, inherit: i32, flags: u32, envb: *u8, dir: *u16, si: *u8, pi: *u8) -> i32
    @lib("kernel32.dll")
    extern WaitForSingleObject = (h: *u8, ms: u32) -> u32
    @lib("kernel32.dll")
    extern GetExitCodeProcess = (h: *u8, code: *u32) -> i32
    @lib("kernel32.dll")
    extern TerminateProcess = (h: *u8, code: u32) -> i32
    @lib("kernel32.dll")
    extern CreatePipe = (r: **u8, w: **u8, sec: *u8, size: u32) -> i32
    @lib("kernel32.dll")
    extern SetHandleInformation = (h: *u8, mask: u32, flags: u32) -> i32
    @lib("kernel32.dll")
    extern PeekNamedPipe = (h: *u8, buf: *u8, size: u32, got: *u32, avail: *u32, left: *u32) -> i32
    @lib("kernel32.dll")
    extern GetLastError = () -> u32
    @lib("kernel32.dll")
    extern VirtualQuery = (p: *u8, info: *u8, n: int) -> int
    @lib("kernel32.dll")
    extern SetEnvironmentVariableW = (name: *u16, value: *u16) -> i32
    @lib("kernel32.dll")
    extern GetEnvironmentStringsW = () -> *u16
    @lib("kernel32.dll")
    extern FreeEnvironmentStringsW = (p: *u16) -> i32
    @lib("kernel32.dll")
    extern GetCurrentProcessId = () -> u32
    @lib("kernel32.dll")
    extern GetFileAttributesExW = (name: *u16, level: i32, info: *u8) -> i32
    @lib("kernel32.dll")
    extern GetConsoleMode = (h: *u8, mode: *u32) -> i32
    @lib("kernel32.dll")
    extern GetNumberOfConsoleInputEvents = (h: *u8, n: *u32) -> i32
    @lib("kernel32.dll")
    extern ReadConsoleInputW = (h: *u8, records: *u8, n: u32, got: *u32) -> i32
    @lib("kernel32.dll")
    extern MoveFileExW = (from: *u16, to: *u16, flags: u32) -> i32
    @lib("kernel32.dll")
    extern RemoveDirectoryW = (path: *u16) -> i32
    @lib("kernel32.dll")
    extern AddVectoredExceptionHandler = (first: u32, h: *u8) -> *u8
    @lib("kernel32.dll")
    extern GetCurrentThreadStackLimits = (low: *int, high: *int)
    @lib("kernel32.dll")
    extern SetThreadStackGuarantee = (size: *u32) -> i32
    @lib("kernel32.dll")
    extern VirtualProtect = (p: *u8, size: int, protect: u32, old: *u32) -> i32
    @lib("kernel32.dll")
    extern GetCurrentDirectoryW = (n: u32, buf: *u16) -> u32
    @lib("kernel32.dll")
    extern GetTempPathW = (n: u32, buf: *u16) -> u32
    @lib("kernel32.dll")
    extern SetConsoleCtrlHandler = (f: *u8, add: i32) -> i32
    @lib("kernel32.dll")
    extern GetCurrentProcess = () -> *u8
    @lib("kernel32.dll")
    extern DuplicateHandle = (from_proc: *u8, h: *u8, to_proc: *u8, out: **u8, access: u32, inherit: i32, options: u32) -> i32
    @lib("kernel32.dll")
    extern GetFileType = (h: *u8) -> u32
    @lib("kernel32.dll")
    extern GetConsoleOutputCP = () -> u32
    @lib("kernel32.dll")
    extern ReadConsoleW = (h: *u8, buf: *u16, n: u32, got: *u32, ctl: *u8) -> i32
    @lib("kernel32.dll")
    extern FormatMessageW = (flags: u32, src: *u8, code: u32, lang: u32, buf: *u16, n: u32, args: *u8) -> u32

    # ---------------- text: UTF-8 <-> UTF-16 ----------------
    # a NUL-terminated UTF-16 copy of s (what the W functions take)
    __wide = (s: str) -> u16[]:
        out: u16[]
        out.reserve(len(s) + 1)
        i = 0
        n = len(s)
        loop i < n:
            c = int(s[i])
            cp = c
            k = 1
            if c >= 0xF0 and i + 3 < n:
                cp = ((c & 7) << 18) | ((int(s[i + 1]) & 63) << 12) | ((int(s[i + 2]) & 63) << 6) | (int(s[i + 3]) & 63)
                k = 4
            else if c >= 0xE0 and i + 2 < n:
                cp = ((c & 15) << 12) | ((int(s[i + 1]) & 63) << 6) | (int(s[i + 2]) & 63)
                k = 3
            else if c >= 0xC0 and i + 1 < n:
                cp = ((c & 31) << 6) | (int(s[i + 1]) & 63)
                k = 2
            if cp >= 0x10000:
                cp -= 0x10000
                out.push(u16(0xD800 + (cp >> 10)))
                out.push(u16(0xDC00 + (cp & 1023)))
            else: out.push(u16(cp))
            i += k
        out.push(0)
        out

    # UTF-16 (n units, or up to a NUL when n < 0) as UTF-8
    __narrow = (p: *u16, n0: int) -> str:
        n = n0
        if n < 0:
            n = 0
            loop p[n] != 0: n += 1
        b: u8[]
        b.reserve(n)
        i = 0
        loop i < n:
            cp = int(p[i])
            i += 1
            if cp >= 0xD800 and cp < 0xDC00 and i < n:
                cp = 0x10000 + ((cp - 0xD800) << 10) + (int(p[i]) - 0xDC00)
                i += 1
            if cp < 0x80: b.push(u8(cp))
            else if cp < 0x800:
                b.push(u8(0xC0 | (cp >> 6)))
                b.push(u8(0x80 | (cp & 63)))
            else if cp < 0x10000:
                b.push(u8(0xE0 | (cp >> 12)))
                b.push(u8(0x80 | ((cp >> 6) & 63)))
                b.push(u8(0x80 | (cp & 63)))
            else:
                b.push(u8(0xF0 | (cp >> 18)))
                b.push(u8(0x80 | ((cp >> 12) & 63)))
                b.push(u8(0x80 | ((cp >> 6) & 63)))
                b.push(u8(0x80 | (cp & 63)))
        str_from_bytes(b)

    # ---------------- output, files ----------------
    __w32_out: *u8 = null
    __w32_err: *u8 = null

    __w32_stdout_console = () -> bool:
        m = [u32(0)]
        GetConsoleMode(GetStdHandle(u32(0xFFFFFFF5)), data(m)) != 0

    # (the console's code page before this program made it UTF-8: put back as the program ends,
    # so what runs after it in the console shows as it did before)
    __w32_old_cp = 0

    __w32_utf8_console = ():
        if __w32_old_cp != 0: return
        __w32_old_cp = int(GetConsoleOutputCP())
        if __w32_old_cp == 0: __w32_old_cp = 65001        # (no console)
        if __w32_old_cp != 65001: SetConsoleOutputCP(65001)

    __w32_restore_cp = ():
        if __w32_old_cp != 0 and __w32_old_cp != 65001: SetConsoleOutputCP(u32(__w32_old_cp))
        __w32_old_cp = 0

    # (standard error: 0 not looked at yet, 1 it goes somewhere, 2 nowhere: a program with no
    # console, double-clicked. What is written to it then is kept, the last of it, for a crash's
    # report: lib/std/backtrace.jo, __w32_crash_report)
    __w32_err_where = 0
    __w32_err_kept: u8[]
    __w32_panic_at = 0              # (where in it a panic's text starts)

    __w32_err_nowhere = () -> bool:
        if __w32_err_where == 0:
            h = GetStdHandle(u32(0xFFFFFFF4))
            __w32_err_where = 1
            if h == null or (h as int) == -1 or GetFileType(h) == u32(0): __w32_err_where = 2
        __w32_err_where == 2

    __w32_write = (fd: int, p: *u8, n: int):
        if __w32_out == null:
            __w32_utf8_console()
            __w32_out = GetStdHandle(u32(0xFFFFFFF5))
            __w32_err = GetStdHandle(u32(0xFFFFFFF4))
        h = __w32_out
        if fd == 2:
            h = __w32_err
            if __w32_err_nowhere():
                if __w32_err_kept.len() > 32768:
                    # (the last 16 KB kept)
                    __w32_err_kept = __w32_err_kept[__w32_err_kept.len() - 16384..]
                    __w32_panic_at = 0
                loop i in [0..n): __w32_err_kept.push(p[i])
                return
        w: u32[] = [0]
        off = 0
        loop off < n:
            if WriteFile(h, p + off, u32(min(n - off, 1 << 30)), data(w), null) == 0 or w[0] == 0: return
            off += int(w[0])

    __w32_in: *u8 = null
    __w32_in_console = false
    __w32_in_rest: u8[]             # (a line typed at the console, as UTF-8: what is not read yet)

    __w32_read = (fd: int, p: *u8, n: int) -> int:
        if fd != 0: return -1
        if __w32_in == null:
            __w32_in = GetStdHandle(u32(0xFFFFFFF6))
            m = [u32(0)]
            __w32_in_console = GetConsoleMode(__w32_in, data(m)) != 0
        if __w32_in_console:
            # (typed text read as UTF-16 and given as UTF-8: ReadFile gives it in the console's
            # old code page, where é and ü are other bytes)
            loop __w32_in_rest.len() == 0:
                if not __w32_console_line(): return 0
            k = min(n, __w32_in_rest.len())
            loop i in [0..k): p[i] = __w32_in_rest[i]
            __w32_in_rest = __w32_in_rest[k..]
            return k
        r: u32[] = [0]
        # (a pipe whose writer is gone: the end)
        if ReadFile(__w32_in, p, u32(min(n, 1 << 30)), data(r), null) == 0: return 0
        int(r[0])

    # (a line from the console, into __w32_in_rest; false at its end: ctrl-z, then enter)
    __w32_console_line = () -> bool:
        buf = fill(u16(0), 4096)
        got: u32[] = [0]
        if ReadConsoleW(__w32_in, data(buf), 4096, data(got), null) == 0 or got[0] == 0: return false
        if buf[0] == u16(26): return false
        loop c in __narrow(data(buf), int(got[0])): __w32_in_rest.push(c)
        true

    __w32_open_file = (path: str, write: bool) -> *u8:
        wp = __wide(path)
        h: *u8 = null
        if write: h = CreateFileW(data(wp), u32(0x40000000), 1, null, 2, 0x80, null)      # GENERIC_WRITE, CREATE_ALWAYS
        else: h = CreateFileW(data(wp), u32(0x80000000), 7, null, 3, 0x80, null)          # GENERIC_READ, OPEN_EXISTING
        if (h as int) == -1:
            # (a directory: Windows says access is denied)
            if __w32_is_dir(path): __ferr(-21)
            else: __w32_ferr()
            return null
        h

    __w32_read_file = (path: str) -> str?:
        h = __w32_open_file(path, false)
        if h == null: return none
        defer CloseHandle(h)
        size = [0]
        if GetFileSizeEx(h, data(size)) == 0: return none
        p = __str_new(size[0])
        got = 0
        r: u32[] = [0]
        loop got < size[0]:
            if ReadFile(h, p + 24 + got, u32(min(size[0] - got, 1 << 30)), data(r), null) == 0 or r[0] == 0: break
            got += int(r[0])
        (p as *int)[1] = got
        p as str

    __w32_write_file = (path: str, contents: str) -> bool:
        h = __w32_open_file(path, true)
        if h == null: return false
        defer CloseHandle(h)
        off = 0
        n = len(contents)
        w: u32[] = [0]
        loop off < n:
            if WriteFile(h, data(contents) + off, u32(min(n - off, 1 << 30)), data(w), null) == 0: return __w32_ferr()
            off += int(w[0])
        true

    __w32_exists = (path: str) -> bool:
        wp = __wide(path)
        GetFileAttributesW(data(wp)) != u32(0xFFFFFFFF)

    __w32_is_dir = (path: str) -> bool:
        a = GetFileAttributesW(data(__wide(path)))
        a != u32(0xFFFFFFFF) and a & u32(0x10) != u32(0)

    # (false, with why the last call failed kept for file_error: Windows' error, as Linux's)
    __w32_ferr = () -> bool:
        c = int(GetLastError())
        e = 0
        if c == 2 or c == 3: e = 2                      # (no file; no directory on the way)
        else if c == 5: e = 13
        else if c == 32 or c == 33: e = 16              # (in use: by another program)
        else if c == 80 or c == 183: e = 17
        else if c == 112 or c == 39: e = 28
        else if c == 145: e = 39
        else if c == 206: e = 36
        else if c == 19: e = 30
        else if c == 17: e = 18
        else if c == 4: e = 24
        if e == 0:
            __file_errno = 0
            __file_err = __w32_error_words(c)
            return false
        __ferr(-e)

    # (an error of Windows' not like one of Linux's, in words)
    __w32_error_words = (c: int) -> str:
        if c == 123 or c == 161: return "the name is not allowed on Windows (it cannot have \\ / : * ? \" < > |, end with a dot or a space, or be CON, PRN, AUX, NUL, COM1 to COM9 or LPT1 to LPT9)"
        if c == 267: return "a part of the path is not a directory"
        if c == 15: return "there is no such drive"
        if c == 21: return "the drive is not ready (no disc or card in it?)"
        if c == 1920 or c == 1921: return "it cannot be reached (a link to something not there?)"
        if c == 225 or c == 226: return "Windows' virus protection blocked it"
        if c == 1224: return "it is in use (open in another program)"
        buf = fill(u16(0), 512)
        k = int(FormatMessageW(u32(0x1200), null, u32(c), 0, data(buf), 512, null))     # FROM_SYSTEM | IGNORE_INSERTS
        loop k > 0 and (buf[k - 1] == u16(10) or buf[k - 1] == u16(13) or buf[k - 1] == u16(32) or buf[k - 1] == u16(46)): k -= 1
        if k == 0: return "Windows error {c}"
        "{__narrow(data(buf), k)} (Windows error {c})"

    __w32_delete = (path: str) -> bool:
        wp = __wide(path)
        DeleteFileW(data(wp)) != 0 or __w32_ferr()

    __w32_mkdir = (path: str) -> bool:
        wp = __wide(path)
        CreateDirectoryW(data(wp), null) != 0 or __w32_exists(path) or __w32_ferr()

    # (WIN32_FIND_DATAW: the name, 260 UTF-16 units, is at 44)
    __w32_list_dir = (path: str) -> str[]:
        out: str[]
        wp = __wide(path + "\\*")
        found = fill(u8(0), 600)
        h = FindFirstFileW(data(wp), data(found))
        if (h as int) == -1:
            __w32_ferr()
            return out
        loop true:
            name = __narrow((data(found) + 44) as *u16, -1)
            if name != "." and name != "..": out.push(name)
            if FindNextFileW(h, data(found)) == 0: break
        FindClose(h)
        out

    # ---------------- the process ----------------
    __w32_args = () -> str[]:
        out: str[]
        n: i32[] = [0]
        argv = CommandLineToArgvW(GetCommandLineW(), data(n))
        if argv == null: return out
        loop i in [0..int(n[0])): out.push(__narrow(argv[i], -1))
        out

    __w32_env = (name: str) -> str?:
        wn = __wide(name)
        buf = fill(u16(0), 512)
        n = int(GetEnvironmentVariableW(data(wn), data(buf), 512))
        if n == 0: return none
        if n > 512:
            buf = fill(u16(0), n)
            n = int(GetEnvironmentVariableW(data(wn), data(buf), u32(n)))
        __narrow(data(buf), n)

    __w32_exe_path = () -> str:
        buf = fill(u16(0), 4096)
        n = int(GetModuleFileNameW(null, data(buf), 4096))
        __narrow(data(buf), n)

    __w32_cwd = () -> str:
        buf = fill(u16(0), 4096)
        n = int(GetCurrentDirectoryW(4096, data(buf)))
        __narrow(data(buf), n)

    # (without the backslash it ends with)
    __w32_temp_dir = () -> str:
        buf = fill(u16(0), 4096)
        n = int(GetTempPathW(4096, data(buf)))
        if n > 1 and buf[n - 1] == u16('\\'): n -= 1
        __narrow(data(buf), n)

    __w32_qpf = 0

    __w32_time_ns = () -> int:
        if __w32_qpf == 0:
            f = [0]
            QueryPerformanceFrequency(data(f))
            __w32_qpf = f[0]
        c = [0]
        QueryPerformanceCounter(data(c))
        # (in two parts: count * 1e9 overflows after some hours of uptime)
        (c[0] / __w32_qpf) * 1000000000 + (c[0] % __w32_qpf) * 1000000000 / __w32_qpf

    __w32_sleep = (seconds: f64):
        if seconds > 0.0: Sleep(u32(seconds * 1000.0))

    __w32_exit = (code: int):
        __w32_restore_cp()
        ExitProcess(u32(code))

    # (a panic: a debugger, if one is attached, stops here, with the stack and its variables)
    __w32_debug_break = ():
        if IsDebuggerPresent() != 0: DebugBreak()

    __w32_pages = (size: int) -> *u8:
        p = VirtualAlloc(null, size, u32(0x3000), 4)           # MEM_COMMIT | MEM_RESERVE, read/write
        if p == null: __out_of_memory()
        p

    __w32_free_pages = (p: *u8): VirtualFree(p, 0, u32(0x8000))   # MEM_RELEASE

    # a command line: the arguments, quoted where they need it
    __w32_cmdline = (argv: str[]) -> str:
        cmd = ""
        loop i in 0.. and a in argv:
            if i > 0: cmd += " "
            if len(a) > 0 and find(a, " ") < 0 and find(a, "\"") < 0: cmd += a
            else: cmd += "\"" + replace(a, "\"", "\\\"") + "\""
        cmd

    # run a program and wait for it: its exit code (-1: it could not be started)
    # run a program (looked for on the PATH by Windows when path is ""), its output collected:
    # its exit code (-1: not started) and what it wrote
    __w32_run_output = (path: str, argv: str[], show: bool, cwd: str) -> (int, str):
        sa = fill(0, 3)
        sa[0] = 24
        sa[2] = 1                                       # bInheritHandle
        out_r: *u8[] = [null]
        out_w: *u8[] = [null]
        if show: out_w[0] = GetStdHandle(u32(0xFFFFFFF5))  # (its output: this program's)
        else:
            if CreatePipe(data(out_r), data(out_w), data(sa) as *u8, u32(1 << 16)) == 0: return (-1, "")
            SetHandleInformation(out_r[0], 1, 0)
        si = fill(0, 13)                                # STARTUPINFOW
        si[0] = 104
        (data(si) as *u32)[15] = u32(0x100)             # STARTF_USESTDHANDLES
        si[10] = GetStdHandle(u32(0xFFFFFFF6)) as int   # (its input: this program's)
        si[11] = out_w[0] as int
        si[12] = GetStdHandle(u32(0xFFFFFFF4)) as int   # (its errors: this program's)
        pi = fill(0, 3)
        wcmd = __wide(__w32_cmdline(argv))
        wdir = __wide(cwd)
        dir: *u16 = null
        if len(cwd) > 0: dir = data(wdir)
        started = false
        if len(path) == 0: started = CreateProcessW(null, data(wcmd), null, null, 1, u32(0x08000000), null, dir, data(si) as *u8, data(pi) as *u8) != 0
        else:
            wpath = __wide(path)
            started = CreateProcessW(data(wpath), data(wcmd), null, null, 1, u32(0x08000000), null, dir, data(si) as *u8, data(pi) as *u8) != 0
        if not show: CloseHandle(out_w[0])
        if not started:
            if not show: CloseHandle(out_r[0])
            return (-1, "")
        proc = pi[0] as *u8
        CloseHandle(pi[1] as *u8)
        out: u8[]
        got: u32[] = [0]
        loop not show:
            n = out.len()
            out.resize(n + 65536)
            if ReadFile(out_r[0], data(out) + n, u32(65536), data(got), null) == 0 or got[0] == 0:
                out.resize(n)
                break
            out.resize(n + int(got[0]))
        if not show: CloseHandle(out_r[0])
        WaitForSingleObject(proc, u32(0xFFFFFFFF))
        code: u32[] = [0]
        GetExitCodeProcess(proc, data(code))
        CloseHandle(proc)
        (int(code[0]), str_from_bytes(out))

    # an inheritable copy of a handle of this program's (null for none), for a program it starts
    __w32_inheritable = (h: *u8) -> *u8:
        if h == null or (h as int) == -1: return null
        out: *u8[] = [null]
        if DuplicateHandle(GetCurrentProcess(), h, GetCurrentProcess(), data(out), 0, 1, u32(2)) == 0: return null    # DUPLICATE_SAME_ACCESS
        out[0]

    # (wait: the program is given this one's input, output and errors, also a game, which has no
    # console of its own: `sloppy game.jo` shows what it prints and why it panicked. While it
    # runs, ctrl-c is the program's alone: it may run its on_quit, and this one waits for it.)
    __w32_run = (path: str, argv: str[], wait: bool) -> int:
        wcmd = __wide(__w32_cmdline(argv))
        wpath = __wide(path)
        si = fill(0, 13)                                        # STARTUPINFOW
        si[0] = 104
        pi = fill(u8(0), 24)
        flags = u32(0)
        inherit = i32(0)
        if not wait: flags = u32(0x00000008)                    # DETACHED_PROCESS
        else:
            # (UTF-8 for what a game writes to the console: it has none to set that in)
            __w32_utf8_console()
            (data(si) as *u32)[15] = u32(0x100)                 # STARTF_USESTDHANDLES
            loop k in [0..3): si[10 + k] = __w32_inheritable(GetStdHandle(u32(0xFFFFFFF6 - k))) as int
            inherit = i32(1)
        ok = CreateProcessW(data(wpath), data(wcmd), null, null, inherit, flags, null, null, data(si) as *u8, data(pi)) != 0
        loop k in [10..13):
            if si[k] != 0: CloseHandle(si[k] as *u8)
        if not ok: return -1
        h = (data(pi) as **u8)[0]
        if not wait:
            CloseHandle(h)
            CloseHandle((data(pi) as **u8)[1])
            return 0
        SetConsoleCtrlHandler(null, 1)
        WaitForSingleObject(h, u32(0xFFFFFFFF))
        code: u32[] = [0]
        GetExitCodeProcess(h, data(code))
        int(code[0])
