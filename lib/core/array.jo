# Generic array utilities. Arrays are values with copy-on-write storage.

is_empty[T] = (xs: T[]) -> bool: xs.len() == 0
first[T] = (xs: T[]) -> T: xs[0]
last[T] = (xs: T[]) -> T: xs[xs.len() - 1]
# the first n elements (all of them when there are fewer: xs[..n) would panic)
first[T] = (xs: T[], n: int) -> T[]: xs[..clamp(n, 0, xs.len()))
# the last n elements (all of them when there are fewer)
last[T] = (xs: T[], n: int) -> T[]: xs[xs.len() - clamp(n, 0, xs.len())..]

contains[T] = (xs: T[], x: T) -> bool:
    loop e in xs:
        if e == x: return true
    false

index_of[T] = (xs: T[], x: T) -> int:
    loop i in 0.. and e in xs:
        if e == x: return i
    -1

map[T, U] = (xs: T[], f: (T) -> U) -> U[]:
    out: U[]
    out.reserve(xs.len())
    loop x in xs: out.push(f(x))
    out

filter[T] = (xs: T[], f: (T) -> bool) -> T[]:
    out: T[]
    loop x in xs:
        if f(x): out.push(x)
    out

each[T] = (xs: T[], f: (T) -> void):
    loop x in xs: f(x)

reduce[T, A] = (xs: T[], init: A, f: (A, T) -> A) -> A:
    acc = init
    loop x in xs: acc = f(acc, x)
    acc

any[T] = (xs: T[], f: (T) -> bool) -> bool:
    loop x in xs:
        if f(x): return true
    false

all[T] = (xs: T[], f: (T) -> bool) -> bool:
    loop x in xs:
        if not f(x): return false
    true

find[T] = (xs: T[], f: (T) -> bool) -> T?:
    loop x in xs:
        if f(x): return x
    none

count[T] = (xs: T[], f: (T) -> bool) -> int:
    n = 0
    loop x in xs:
        if f(x): n += 1
    n

sum[T] = (xs: T[]) -> T:
    s: T
    loop x in xs: s = s + x
    s

min[T] = (xs: T[]) -> T:
    m = xs[0]
    loop x in xs:
        if x < m: m = x
    m

max[T] = (xs: T[]) -> T:
    m = xs[0]
    loop x in xs:
        if x > m: m = x
    m

reverse[T] = (xs: mut T[]):
    i = 0
    j = xs.len() - 1
    loop i < j:
        t = xs[i]
        xs[i] = xs[j]
        xs[j] = t
        i += 1
        j -= 1

reversed[T] = (xs: T[]) -> T[]:
    out = xs
    out.reverse()
    out

range = (a: int, b: int) -> int[]:
    out: int[]
    loop i in [a..b): out.push(i)
    out

enumerate[T] = (xs: T[]) -> (int, T)[]:
    out: (int, T)[]
    loop i in 0.. and x in xs: out.push((i, x))
    out

zip[A, B] = (xs: A[], ys: B[]) -> (A, B)[]:
    out: (A, B)[]
    n = xs.len()
    if ys.len() < n: n = ys.len()
    loop i in [0..n): out.push((xs[i], ys[i]))
    out

flatten[T] = (xss: T[][]) -> T[]:
    out: T[]
    loop xs in xss:
        loop x in xs: out.push(x)
    out

swap[T] = (xs: mut T[], i: int, j: int):
    t = xs[i]
    xs[i] = xs[j]
    xs[j] = t

# ---------------- sorting ----------------
__insertion_sort[T] = (xs: mut T[], lo: int, hi: int, less: (T, T) -> bool):
    i = lo + 1
    loop i < hi:
        j = i
        loop j > lo and less(xs[j], xs[j - 1]):
            t = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = t
            j -= 1
        i += 1

# (stable: elements that are equal keep their order; sorted runs of 16, merged back and forth
# between xs and a copy)
__merge_sort[T] = (xs: mut T[], less: (T, T) -> bool):
    n = xs.len()
    lo = 0
    loop lo < n:
        __insertion_sort(xs, lo, min(lo + 16, n), less)
        lo += 16
    if n <= 16: return
    buf = xs
    in_xs = true
    w = 16
    loop w < n:
        if in_xs: __merge_pass(xs, buf, w, less)
        else: __merge_pass(buf, xs, w, less)
        in_xs = not in_xs
        w *= 2
    if not in_xs: xs = buf

# merges each two neighboring sorted runs of w in src into dst
__merge_pass[T] = (src: T[], dst: mut T[], w: int, less: (T, T) -> bool):
    n = src.len()
    lo = 0
    loop lo < n:
        mid = min(lo + w, n)
        hi = min(lo + 2 * w, n)
        i = lo
        j = mid
        k = lo
        loop k < hi:
            if j < hi and (i >= mid or less(src[j], src[i])):
                dst[k] = src[j]
                j += 1
            else:
                dst[k] = src[i]
                i += 1
            k += 1
        lo += 2 * w

# tuples compare element by element, the first that differs deciding (sorting (score, name)
# pairs sorts by score, then name)
(<)[A, B] = (a: (A, B), b: (A, B)) -> bool:
    if a.0 < b.0: return true
    if b.0 < a.0: return false
    a.1 < b.1
(<)[A, B, C] = (a: (A, B, C), b: (A, B, C)) -> bool:
    if a.0 < b.0: return true
    if b.0 < a.0: return false
    if a.1 < b.1: return true
    if b.1 < a.1: return false
    a.2 < b.2

__less[T] = (a: T, b: T) -> bool: a < b
__more[T] = (a: T, b: T) -> bool: b < a

# sort in place, smallest first (using <), or largest first; equal elements keep their order
sort[T] = (xs: mut T[], descending: bool = false):
    if descending: __merge_sort(xs, __more)
    else: __merge_sort(xs, __less)

# sort in place with a custom "less than" function (equal elements keep their order)
sort_with[T] = (xs: mut T[], less: (T, T) -> bool):
    __merge_sort(xs, less)

# sort in place by a key, smallest first or largest first (equal keys keep their order: sort by
# name, then by score, for the scores in order of name)
sort_by[T, K] = (xs: mut T[], key: (T) -> K, descending: bool = false):
    if descending: __merge_sort(xs, (a: T, b: T) -> bool: key(b) < key(a))
    else: __merge_sort(xs, (a: T, b: T) -> bool: key(a) < key(b))

# a sorted copy of xs
sorted[T] = (xs: T[], descending: bool = false) -> T[]:
    out = xs
    out.sort(descending)
    out

# a copy of xs sorted by a key
sorted_by[T, K] = (xs: T[], key: (T) -> K, descending: bool = false) -> T[]:
    out = xs
    out.sort_by(key, descending)
    out

__fmt_join[T] = (xs: T[], sep: str) -> str:
    buf: u8[]
    loop i in 0.. and x in xs:
        if i > 0: __buf_append_str(buf, sep)
        __fmt(buf, x)
    str_from_bytes(buf)
