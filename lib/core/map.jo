# Hash map {K: V}: insertion ordered, open addressing over a dense entry list.
# The first two fields must stay `keys` and `vals` (the compiler iterates them in for loops).

struct Map[K, V]:
    keys: K[]
    vals: V[]
    slots: u64[]      # 0 = empty, otherwise the entry's hash's upper 32 bits | entry index + 1
    hashes: u64[]

# full 64-bit avalanche (murmur3 finalizer): every key bit affects the low bits used for slots,
# so keys like multiples of 4096 or float bit patterns spread out
hash = (x: int) -> u64: hash(u64(x))

hash = (x: u64) -> u64:
    h = (x xor (x >> 33))
    h = h * 0xFF51AFD7ED558CCD
    h = (h xor (h >> 33))
    h = h * 0xC4CEB9FE1A85EC53
    (h xor (h >> 33))

hash = (x: bool) -> u64:
    if x: return 1
    0

hash = (x): __hash_value(x)

# xs[i] where the library knows i is in bounds (the compiler leaves out the check; the C
# bootstrap compiler calls this)
__at[T] = (xs: T[], i: int) -> T: xs[i]

# (slots has a power-of-two length when not empty, its entries are 0 or an entry index + 1
# with the upper half of the entry's hash above it, and keys, vals and hashes have an element per
# entry: every index here is in bounds. A slot whose hash half differs is passed over without
# looking at the entry, which is elsewhere in memory)
# k's entry, or -2 - the empty slot where it would go (-1 when there are no slots yet)
__map_probe[K, V] = (m: Map[K, V], k: K, h: u64) -> int:
    ns = m.slots.len()
    if ns == 0: return -1
    mask = ns - 1
    i = int(h) & mask
    hi = h & 0xFFFFFFFF00000000
    loop true:
        s = __at(m.slots, i)
        if s == 0: return -2 - i
        if s & 0xFFFFFFFF00000000 == hi:
            e = int(s & 0xFFFFFFFF) - 1
            if __at(m.keys, e) == k: return e
        i = (i + 1) & mask

__map_find[K, V] = (m: Map[K, V], k: K, h: u64) -> int:
    ns = m.slots.len()
    if ns == 0: return -1
    mask = ns - 1
    i = int(h) & mask
    hi = h & 0xFFFFFFFF00000000
    loop true:
        s = __at(m.slots, i)
        if s == 0: return -1
        if s & 0xFFFFFFFF00000000 == hi:
            e = int(s & 0xFFFFFFFF) - 1
            if __at(m.keys, e) == k: return e
        i = (i + 1) & mask

__map_rehash[K, V] = (m: mut Map[K, V], ns: int):
    m.slots.clear()
    m.slots.resize(ns)
    mask = ns - 1
    loop e in 0.. and h in m.hashes:
        i = int(h) & mask
        loop m.slots[i] != 0: i = (i + 1) & mask
        m.slots[i] = (h & 0xFFFFFFFF00000000) | u64(e + 1)

([]=)[K, V] = (m: mut Map[K, V], k: K, v: V):
    h = hash(k)
    e = __map_probe(m, k, h)
    if e >= 0:
        m.vals[e] = v
        return
    __map_add(m, k, v, h, -2 - e)

# the entry of k, for changing m[k] in place (m[k] += 1, m[k].push(x), m[k].hp -= 5): a missing
# key is added, its value starting as V's zero value (or the default d, for a struct with
# default field values)
__map_entry[K, V] = (m: mut Map[K, V], k: K) -> int:
    h = hash(k)
    e = __map_probe(m, k, h)
    if e >= 0: return e
    z: V
    __map_add(m, k, z, h, -2 - e)
    m.keys.len() - 1

__map_entry[K, V] = (m: mut Map[K, V], k: K, d: V) -> int:
    h = hash(k)
    e = __map_probe(m, k, h)
    if e >= 0: return e
    __map_add(m, k, d, h, -2 - e)
    m.keys.len() - 1

# room for n entries without growing (when many are to come)
reserve[K, V] = (m: mut Map[K, V], n: int):
    m.keys.reserve(n)
    m.vals.reserve(n)
    m.hashes.reserve(n)
    ns = 8
    loop ns * 3 < (n + 1) * 4: ns *= 2
    if ns > m.slots.len(): __map_rehash(m, ns)

# a new entry (k is not in m; slot: the empty slot a probe for it ended at, or -1)
__map_add[K, V] = (m: mut Map[K, V], k: K, v: V, h: u64, slot: int = -1):
    n = m.keys.len()
    if (n + 1) * 4 > m.slots.len() * 3:
        ns = m.slots.len() * 2
        if ns < 8: ns = 8
        m.keys.push(k)
        m.vals.push(v)
        m.hashes.push(h)
        __map_rehash(m, ns)
        return
    m.keys.push(k)
    m.vals.push(v)
    m.hashes.push(h)
    i = slot
    if i < 0:
        mask = m.slots.len() - 1
        i = int(h) & mask
        loop m.slots[i] != 0: i = (i + 1) & mask
    m.slots[i] = (h & 0xFFFFFFFF00000000) | u64(n + 1)

([])[K, V] = (m: Map[K, V], k: K) -> V:
    e = __map_find(m, k, hash(k))
    if e < 0: panic("key not found in map: {k} (m.get(k) gives none for a missing key, m.has(k) asks)")
    __at(m.vals, e)

get[K, V] = (m: Map[K, V], k: K) -> V?:
    e = __map_find(m, k, hash(k))
    if e < 0: return none
    __at(m.vals, e)

get[K, V] = (m: Map[K, V], k: K, default: V) -> V:
    e = __map_find(m, k, hash(k))
    if e < 0: return default
    __at(m.vals, e)

contains[K, V] = (m: Map[K, V], k: K) -> bool: __map_find(m, k, hash(k)) >= 0
has[K, V] = (m: Map[K, V], k: K) -> bool: __map_find(m, k, hash(k)) >= 0
len[K, V] = (m: Map[K, V]) -> int: m.keys.len()
is_empty[K, V] = (m: Map[K, V]) -> bool: m.keys.len() == 0
keys[K, V] = (m: Map[K, V]) -> K[]: m.keys
values[K, V] = (m: Map[K, V]) -> V[]: m.vals

clear[K, V] = (m: mut Map[K, V]):
    m.keys.clear()
    m.vals.clear()
    m.slots.clear()
    m.hashes.clear()

# remove a key; returns true if it was present. The entries after it move up (the rest keep
# their order).
remove[K, V] = (m: mut Map[K, V], k: K) -> bool:
    h = hash(k)
    e = __map_find(m, k, h)
    if e < 0: return false
    m.keys.remove(e)
    m.vals.remove(e)
    m.hashes.remove(e)
    __map_rehash(m, m.slots.len())
    true

__fmt[K, V] = (buf: mut u8[], m: Map[K, V]):
    __buf_byte(buf, '{{')
    loop i in 0.. and k in m.keys:
        if i > 0: __buf_append_str(buf, ", ")
        __fmt_elem(buf, k)
        __buf_append_str(buf, ": ")
        __fmt_elem(buf, m.vals[i])
    __buf_byte(buf, '}}')

# ({loop w in words: w: len(w)}: a map from its (key, value) pairs; a later key replaces an earlier)
__map_of[K, V] = (pairs: (K, V)[]) -> {K: V}:
    m: {K: V}
    loop p in pairs: m[p.0] = p.1
    m
