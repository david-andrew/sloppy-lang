# Operating system access: files, arguments, environment, time.

exit = (code: int):
    __out_flush()
    __exit(code)

# command line arguments (args()[0] is the program path)
args = () -> str[]:
    out: str[]
    when TARGET == "wasm":
        b = __wasm_bytes((p: *u8, cap: int): __wasm_args(p, cap))
        if b.len() > 0:
            loop a in split(str_from_bytes(b), "\0"): out.push(a)
    else when TARGET == "windows":
        return __w32_args()
    else:
        sp = __argv() as *int
        argc = sp[0]
        argv = (sp + 1) as **u8
        loop i in [0..argc): out.push(__cstr(argv[i]))
    out

__cstr = (p: *u8) -> str:
    if p == null: return ""
    n = 0
    loop p[n] != 0: n += 1
    q = __str_new(n)
    mem_copy(q + 24, p, n)
    q as str

# an environment variable (in a web page: the page's URL parameter of that name, where `SLOPPY_X`
# may also be written `x`, and a bare `?x` is "1")
env = (name: str) -> str?:
    when TARGET == "wasm":
        buf = fill(u8(0), 256)
        n = __wasm_env(data(name), len(name), data(buf), 256)
        if n < 0: return none
        if n > 256:
            buf = fill(u8(0), n)
            __wasm_env(data(name), len(name), data(buf), n)
        return str_from_bytes(buf[..n))
    else when TARGET == "windows":
        return __w32_env(name)
    else:
        sp = __argv() as *int
        argc = sp[0]
        envp = (sp + 2 + argc) as **u8
        i = 0
        loop envp[i] != null:
            e = envp[i]
            k = 0
            ok = true
            loop k < len(name):
                if e[k] != name[k]:
                    ok = false
                    break
                k += 1
            if ok and e[k] == '=': return __cstr(e + k + 1)
            i += 1
    none

# (a host call that fills a buffer and says how much it needed, or -1: none)
__wasm_bytes = (f: (*u8, int) -> int) -> u8[]:
    buf = fill(u8(0), 4096)
    n = f(data(buf), 4096)
    if n < 0: return []
    if n > 4096:
        buf = fill(u8(0), n)
        f(data(buf), n)
    buf.truncate(n)
    buf

__zstr = (s: str) -> str:
    # strings always carry a NUL terminator, except the empty string
    if len(s) == 0: return "\0"
    s

# read a whole file; none if it cannot be read (or is a directory)
read_file = (path: str) -> str?:
    when TARGET == "wasm":
        if not __wasm_has(path): return none
        return str_from_bytes(__wasm_bytes((p: *u8, cap: int): __wasm_read_file(data(path), len(path), p, cap)))
    else when TARGET == "windows":
        return __w32_read_file(path)
    else:
        fd = syscall(2, data(__zstr(path)), 0, 0)
        if fd < 0: return none
        defer syscall(3, fd)
        size = syscall(8, fd, 0, 2)
        if size < 0:
            # (no size: a pipe, /dev/stdin: read until it ends)
            out: u8[]
            chunk = fill(u8(0), 65536)
            loop:
                r = syscall(0, fd, data(chunk), chunk.len())
                if r == -21: return none
                if r <= 0: break
                loop i in [0..r): out.push(chunk[i])      # (not extend: the C bootstrap compiles this)
            return str_from_bytes(out)
        syscall(8, fd, 0, 0)
        p = __str_new(size)
        got = 0
        loop got < size:
            r = syscall(0, fd, p + 24 + got, size - got)
            if r == -21: return none                  # (EISDIR: a directory)
            if r <= 0: break
            got += r
        (p as *int)[1] = got
        p as str

__stdin_buf: u8[]
__stdin_pos = 0

# a line typed in (or piped in), without its end; none when the input has ended
read_line = () -> str?:
    __out_flush()                   # (a prompt printed before, shown first)
    line: u8[]
    got = false
    loop:
        if __stdin_pos >= __stdin_buf.len():
            __stdin_buf = fill(u8(0), 4096)
            r = __read_fd(0, data(__stdin_buf), __stdin_buf.len())
            if r <= 0:
                __stdin_buf.clear()
                __stdin_pos = 0
                if not got: return none
                break
            __stdin_buf.truncate(r)
            __stdin_pos = 0
        c = __stdin_buf[__stdin_pos]
        __stdin_pos += 1
        got = true
        if c == '\n': break
        line.push(c)
    if line.len() > 0 and line[line.len() - 1] == '\r': line.pop()
    str_from_bytes(line)

# all of standard input (what is piped in), until it ends
read_stdin = () -> str:
    __out_flush()
    out: u8[]
    loop i in [__stdin_pos..__stdin_buf.len()): out.push(__stdin_buf[i])
    __stdin_buf.clear()
    __stdin_pos = 0
    chunk = fill(u8(0), 65536)
    loop:
        r = __read_fd(0, data(chunk), chunk.len())
        if r <= 0: break
        loop i in [0..r): out.push(chunk[i])
    str_from_bytes(out)

read_bytes = (path: str) -> u8[]?:
    if let s = read_file(path): return bytes(s)
    none

write_file = (path: str, contents: str) -> bool:
    when TARGET == "wasm":
        return __wasm_write_file(data(path), len(path), data(contents), len(contents)) == 1
    else when TARGET == "windows":
        return __w32_write_file(path, contents)
    else:
        fd = syscall(2, data(__zstr(path)), 0x241, 0x1A4)
        if fd < 0: return false
        defer syscall(3, fd)
        off = 0
        n = len(contents)
        loop off < n:
            r = syscall(1, fd, data(contents) + off, n - off)
            if r <= 0: return false
            off += r
        true

write_bytes = (path: str, b: u8[]) -> bool: write_file(path, str_from_bytes(b))

# a directory (and not a file)
is_dir = (path: str) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        return __w32_is_dir(path)
    else:
        fd = syscall(2, data(__zstr(path)), 0, 0)
        if fd < 0: return false
        b = [u8(0)]
        r = syscall(0, fd, data(b), 0)
        if r == 0: r = syscall(0, fd, data(b), 1)
        syscall(3, fd)
        r == -21                                      # (EISDIR)

# the path is a symbolic link (to anything, or to nothing); is_dir and the rest follow links, so
# a walk through directories that should not go round in circles asks this first
is_symlink = (path: str) -> bool:
    when TARGET == "wasm" or TARGET == "windows":
        return false
    else:
        b = [u8(0)]
        syscall(89, data(__zstr(path)), data(b), 1) >= 0

# a file's size in bytes; none if it cannot be opened (or is a directory)
file_size = (path: str) -> int?:
    when TARGET == "wasm":
        if let s = read_file(path): return len(s)
        return none
    else when TARGET == "windows":
        if __w32_is_dir(path): return none
        if let s = read_file(path): return len(s)
        return none
    else:
        if is_dir(path): return none
        fd = syscall(2, data(__zstr(path)), 0, 0)
        if fd < 0: return none
        n = syscall(8, fd, 0, 2)
        syscall(3, fd)
        if n < 0: return none
        n

file_exists = (path: str) -> bool:
    when TARGET == "wasm":
        return __wasm_has(path)
    else when TARGET == "windows":
        return __w32_exists(path)
    else:
        syscall(21, data(__zstr(path)), 0) == 0

make_executable = (path: str) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        return true
    else:
        syscall(90, data(__zstr(path)), 0x1ED) == 0

delete_file = (path: str) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        return __w32_delete(path)
    else:
        syscall(87, data(__zstr(path))) == 0

# seconds since an arbitrary point (monotonic clock)
time = () -> f64:
    when TARGET == "wasm":
        return __wasm_now() / 1000.0
    else when TARGET == "windows":
        return f64(__w32_time_ns()) * 1e-9
    else:
        ts: (int, int)
        syscall(228, 1, &ts)
        f64(ts.0) + f64(ts.1) * 1e-9

# nanoseconds since an arbitrary point (monotonic clock)
time_ns = () -> int:
    when TARGET == "wasm":
        return int(__wasm_now() * 1000000.0)
    else when TARGET == "windows":
        return __w32_time_ns()
    else:
        ts: (int, int)
        syscall(228, 1, &ts)
        ts.0 * 1000000000 + ts.1

sleep = (seconds: f64):
    __out_flush()
    when TARGET == "windows":
        __w32_sleep(seconds)
    else when TARGET != "wasm":
        ts = (int(seconds), int((seconds - floor(seconds)) * 1e9))
        syscall(35, &ts, 0)

# print without a trailing newline
write = (s: str): __out(data(s), len(s), true)

# what print and write gave so far, written out now (output to a file or a pipe is collected
# and written in large pieces; to a terminal it goes at once anyway)
flush_output = (): __out_flush()

# standard output is a terminal (not a file or a pipe)
is_terminal = () -> bool: __stdout_tty()
# print to standard error (for messages about the program, kept apart from its output), and a
# line break
eprint = (s: str):
    __out_flush()
    __write_fd(2, data(s), len(s))
    __write_fd(2, data("\n"), 1)

# (a file or a directory)
__wasm_has = (path: str) -> bool:
    when TARGET == "wasm":
        b = [u8(0)]
        if __wasm_read_file(data(path), len(path), data(b), 0) >= 0: return true
        return __wasm_list_dir(data(path), len(path), data(b), 0) >= 0
    else:
        return false

# names of the entries in a directory (excluding . and ..); [] for a file or a path that is not
# there too (is_dir tells them apart)
list_dir = (path: str) -> str[]:
    out: str[]
    when TARGET == "wasm":
        b = __wasm_bytes((p: *u8, cap: int): __wasm_list_dir(data(path), len(path), p, cap))
        if b.len() > 0:
            loop n in split(str_from_bytes(b), "\n"): out.push(n)
    else when TARGET == "windows":
        return __w32_list_dir(path)
    else when TARGET == "macos":
        return __mac_list_dir(path)
    else:
        fd = syscall(2, data(__zstr(path)), 0x10000, 0)
        if fd < 0: return out
        buf = __alloc(8192)
        loop true:
            n = syscall(217, fd, buf, 8192)
            if n <= 0: break
            off = 0
            loop off < n:
                reclen = int(((buf + off + 16) as *u16)[0])
                name = __cstr(buf + off + 19)
                if name != "." and name != "..": out.push(name)
                off += reclen
        __free(buf)
        syscall(3, fd)
    out

# absolute path of the running executable
exe_path = () -> str:
    when TARGET == "wasm":
        a = args()
        if a.len() > 0: return a[0]
        return ""
    else when TARGET == "windows":
        return __w32_exe_path()
    else when TARGET == "macos":
        return __mac_exe_path()
    else:
        buf = __alloc(4096)
        n = syscall(89, data("/proc/self/exe"), buf, 4095)
        s = ""
        if n > 0:
            q = __str_new(n)
            mem_copy(q + 24, buf, n)
            s = q as str
        __free(buf)
        s

# replace the current process with another program (returns only on failure)
exec = (path: str, argv: str[]) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        # (Windows cannot replace a process: run the program, then end with its exit code)
        code = __w32_run(path, argv, true)
        if code < 0: return false
        __w32_exit(code)
        return true
    else:
        ptrs = __alloc(8 * (argv.len() + 1))
        pp = ptrs as **u8
        loop i in 0.. and a in argv: pp[i] = data(__zstr(a))
        pp[argv.len()] = null
        sp = __argv() as *int
        argc = sp[0]
        envp = (sp + 2 + argc) as *u8
        syscall(59, data(__zstr(path)), ptrs, envp)
        false

# exec, the program where it was linked: the interactive prompt's session and sloppy watch's game
# get code linked to their addresses (macOS: without its address space randomized, as debuggers
# start programs; elsewhere they are not moved)
__exec_unslid = (path: str, argv: str[]) -> bool:
    when TARGET == "macos":
        ptrs = __alloc(8 * (argv.len() + 1))
        pp = ptrs as **u8
        loop i in 0.. and a in argv: pp[i] = data(__zstr(a))
        pp[argv.len()] = null
        sp = __argv() as *int
        envp = (sp + 2 + sp[0]) as *u8
        attr = [0]
        __c_spawnattr_init(data(attr) as *u8)
        __c_spawnattr_setflags(data(attr) as *u8, i16(0x40 | 0x100))       # SETEXEC, DISABLE_ASLR
        __c_posix_spawn(null, data(__zstr(path)), null, data(attr) as *u8, ptrs, envp)
        return false
    else:
        return exec(path, argv)

# start a program in the background, detached from this one: its own session, no terminal
# (input and output go to /dev/null); returns whether it was started
spawn_detached = (path: str, argv: str[]) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        return __w32_run(path, argv, false) == 0
    else:
        pid = syscall(57)                            # fork
        if pid < 0: return false
        if pid == 0:
            syscall(112)                             # setsid
            fd = syscall(2, data(__zstr("/dev/null")), 2)  # open O_RDWR
            if fd >= 0:
                syscall(33, fd, 0)                   # dup2
                syscall(33, fd, 1)
                syscall(33, fd, 2)
            exec(path, argv)
            syscall(60, 127)                         # exit: exec failed
        true

# run a program and wait for it to end: its exit code (-1: it could not be started) and what it
# wrote to its standard output (its errors go where this program's go). A program named without
# a / is looked for on the PATH. args are its arguments, after its name.
run_program = (program: str, args: str[] = []) -> (int, str):
    argv = [program] + args
    when TARGET == "wasm":
        return (-1, "")
    else when TARGET == "windows":
        if find(program, "/") < 0 and find(program, "\\") < 0: return __w32_run_output("", argv)
        return __w32_run_output(program, argv)
    else:
        path = program
        if find(program, "/") < 0:
            path = ""
            loop d in split(env("PATH") ?? "/usr/bin:/bin", ":"):
                if len(d) > 0 and file_exists("{d}/{program}"):
                    path = "{d}/{program}"
                    break
            if len(path) == 0: return (-1, "")
        fds = [0]
        if syscall(293, data(fds), 0x80000) != 0: return (-1, "")       # pipe2(O_CLOEXEC)
        rfd = fds[0] & 0xFFFFFFFF
        wfd = fds[0] >> 32
        pid = syscall(57)                            # fork
        if pid < 0:
            syscall(3, rfd)
            syscall(3, wfd)
            return (-1, "")
        if pid == 0:
            syscall(33, wfd, 1)                      # dup2: its output into the pipe
            exec(path, argv)
            syscall(60, 127)                         # exit: exec failed
        syscall(3, wfd)
        out: u8[]
        loop true:
            n = out.len()
            out.resize(n + 65536)
            r = syscall(0, rfd, data(out) + n, 65536)
            out.resize(n + max(r, 0))
            if r == -4: continue                     # (EINTR: again)
            if r <= 0: break
        syscall(3, rfd)
        status = [0]
        syscall(61, pid, data(status), 0, 0)         # wait4
        st = status[0] & 0xFFFF
        code = (st >> 8) & 255
        if st & 127 != 0: code = 128 + (st & 127)    # (ended by a signal)
        if code == 127: return (-1, str_from_bytes(out))
        (code, str_from_bytes(out))

chmod = (path: str, mode: int) -> bool:
    when TARGET == "wasm":
        return false
    else when TARGET == "windows":
        return true
    else:
        syscall(90, data(__zstr(path)), mode) == 0

mkdir = (path: str) -> bool:
    when TARGET == "wasm":
        return true
    else when TARGET == "windows":
        return __w32_mkdir(path)
    else:
        r = syscall(83, data(__zstr(path)), 0x1ED)
        r == 0 or r == -17

# the current directory
cwd = () -> str:
    when TARGET == "wasm":
        return "/"
    else when TARGET == "windows":
        return __w32_cwd()
    else:
        buf = fill(u8(0), 4096)
        n = syscall(79, data(buf), 4096)
        if n <= 0: return "/"
        str_from_bytes(buf[..n - 1))

# a directory for temporary files (TMPDIR, else /tmp; on Windows, the user's temporary directory)
temp_dir = () -> str:
    when TARGET == "windows":
        return __w32_temp_dir()
    else:
        if let t = env("TMPDIR"):
            if len(t) > 0: return t
        "/tmp"

# ---------------- `sloppy test` support ----------------
# Each test runs in a process of its own where there is fork (Linux, macOS): one that fails (a
# failed assert, a panic) is reported, and the rest still run; elsewhere they run here in turn
__tests_run = 0
__tests_failed = 0
__test_t0 = 0.0
__test_child = false

# true where the test's code is to run (the child; or here)
__test_begin = (name: str) -> bool:
    write("test {name} ... ")
    __test_t0 = time()
    when TARGET == "linux" or TARGET == "macos":
        __out_flush()
        pid = syscall(57)
        if pid == 0:
            __test_child = true
            return true
        if pid > 0:
            st = [0]
            syscall(61, pid, data(st), 0, 0)
            __tests_run += 1
            if st[0] & 0xFFFF == 0: print("ok ({(time() - __test_t0) * 1000:.1} ms)")
            else:
                print("FAILED")
                __tests_failed += 1
            return false
    true

__test_end = ():
    if __test_child:
        __out_flush()
        __exit(0)
    __tests_run += 1
    print("ok ({(time() - __test_t0) * 1000:.1} ms)")

__test_done = (n: int):
    if __tests_failed > 0:
        print("{n - __tests_failed} passed, {__tests_failed} failed")
        exit(1)
    print("{n} tests passed")
