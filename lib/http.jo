# HTTP servers: a web site, an API, a game's page with its WebSockets on the same port. `import
# http`, then routes (a method and a path, with :names for parts that vary), each answered by a
# function from a Request to a Response:
#
#   http.get("/", (r: http.Request) -> http.Response: http.html("<h1>Hello</h1>"))
#   http.get("/todos/:id", (r: http.Request) -> http.Response:
#       if let t = todos.get(to_int(r.params["id"]) ?? -1): return http.json(t)
#       http.status(404))
#   http.post("/todos", add_todo)
#   http.files("/", "public")                   # the files under public/ (index.html for /)
#   http.serve(8080)                            # answers until ctrl-c (or SIGTERM)
#
# A program that does more than answer (a chat whose WebSockets come through net, a job that
# fetches meanwhile) answers what has come each time round its own loop:
#   http.listen(8080)
#   loop not stopping():
#       http.answer()
#       loop e in net.receive(): ...
#       net.wait(1.0)                           # until something comes (a request, a message)
#
# Each request's handler runs as a task of its own (lib/std/task.jo): one that waits (a net.fetch,
# sleep, a channel) lets the others be answered meanwhile; one connection's requests are answered
# in order. Tasks take turns on the program's one thread, so handlers change the program's
# variables (a map of todos, a count) with no locks: nothing else runs between two waits. One that
# computes for long, runs a program (run_program) or reads a big file holds up the others while it
# does. A client slow to send or to read holds up no other (what waits to go out to it goes as it
# takes it). A handler that panics is answered 500 and the server goes on (the panic and its
# backtrace are written to standard error; what the handler had changed stays changed). Behind a
# proxy that has the certificate (Caddy: docs/START.md's "Writing a server"), the same program
# serves https (trust_proxy: the clients' addresses; secure_cookies). Native programs only.
#
# Asked to stop (ctrl-c, SIGTERM), serve takes no more requests, gives the handlers running up to
# `drain` seconds to answer, and returns: the program then ends what it runs besides (closing the
# channels its tasks read), and saves. A program with its own loop calls shutdown() itself.
#
# Trying a server from the same program (a test, Go's httptest): serve in a task, and fetch from it:
#   http.listen(18080, host = "127.0.0.1")
#   spawn((): http.serve(18080), background = true)
#   assert(net.fetch("http://127.0.0.1:18080/todos/1").status == 200)

import crypto
import net

struct Request:
    method = ""             # "GET", "POST", ...
    path = ""               # "/todos/3": decoded (%20 a space), without the query
    query: {str: str}       # ?done=true&q=a%20b: {"done": "true", "q": "a b"} (a name given twice:
                            # the last; query_all(r, name) has each)
    params: {str: str}      # the route's :names: /todos/:id gives {"id": "3"}
    headers: {str: str}     # names in small letters (a header sent twice: its values joined by ", ")
    cookies: {str: str}     # (a name sent twice: the first, the one for the longer path)
    body: u8[]              # what was sent with it ...
    text = ""               # ... as text (read_json reads it into a struct)
    target = ""             # the path and query as sent: "/todos?done=true"
    version = "HTTP/1.1"
    address = ""            # where it came from: "1.2.3.4" (behind a proxy, the proxy's, unless
                            # trust_proxy names it: then the client's, from X-Forwarded-For)
    conn = 0                # its connection (a stream's: send_event and send_chunk go to it)

struct Response:
    status = 200
    headers: {str: str}     # (Content-Length, Date and Connection are added)
    body: u8[]
    cookies: str[]          # each a Set-Cookie header (set_cookie makes them)
    file = ""               # a file sent as the body, a piece at a time (file() sets it)
    stream = false          # the body is sent later, by send_chunk or send_event (stream(), events())
    upgrade = false         # (websocket(): the connection becomes a net peer ...)
    __largest = 0           # (... taking messages up to this big)

# ---------------- routes ----------------
# A pattern is a path whose parts may be :names (any one part: /todos/:id) and whose last part may
# be *name (the rest of the path, slashes too: /files/*path). Routes are tried in the order they
# were made, files() last whenever it was made (what no other route has); one for GET answers HEAD
# too. A path that no route has is answered 404, one that a route has for other methods 405 (before
# files() is looked in: a GET of a POST's path is 405, not a file not found). Those are on_error's.

# a route for requests of that method ("*": any) to paths of the pattern
route = (method: str, pattern: str, handler: (Request) -> Response):
    rt = __Route(method = method.upper(), handler = handler)
    loop part in split(pattern, "/"):
        p = part
        # ({id} too, as Go writes it: in a string, "/todos/{{id}}")
        if starts_with(p, "{") and ends_with(p, "}") and len(p) > 2: p = ":" + p[1..len(p) - 1)
        if starts_with(p, "*"):
            rt.rest = if len(p) > 1: p[1..] else: "*"
            break
        rt.parts.push(p)
    # (a slash at the end is the same path without it, as /todos/ and /todos)
    if rt.parts.len() > 2 and rt.parts[rt.parts.len() - 1] == "" and len(rt.rest) == 0: rt.parts.pop()
    __routes.push(rt)

get = (pattern: str, handler: (Request) -> Response): route("GET", pattern, handler)
post = (pattern: str, handler: (Request) -> Response): route("POST", pattern, handler)
put = (pattern: str, handler: (Request) -> Response): route("PUT", pattern, handler)
patch = (pattern: str, handler: (Request) -> Response): route("PATCH", pattern, handler)
delete = (pattern: str, handler: (Request) -> Response): route("DELETE", pattern, handler)

# the files under dir, at the paths under prefix ("/": the site's root): GET and HEAD, with each
# file's type, index.html for a directory (a directory asked for without its / is sent there), and
# what lets a browser keep a copy (ETag, Last-Modified: a file unchanged since is answered 304).
# Names starting with a dot (.git, .env) and paths with .. are not served
files = (prefix: str, dir: str):
    root = abs_path(dir)
    p = if ends_with(prefix, "/"): prefix else: prefix + "/"
    route("GET", p + "*path", (r: Request) -> Response: __http_files(r, root))
    __routes[__routes.len() - 1].files = true

struct __Route:
    method: str
    parts: str[]
    rest = ""               # (*name: the rest of the path, as that param)
    handler: (Request) -> Response
    files = false           # (files()'s: tried after the others)

__routes: __Route[]

# (the server's: its connections, the ports it listens on)
const __HTTP_MOST_CONNS = 10000
const __HTTP_IDLE = 30.0    # (seconds a connection may send and take nothing)
const __HTTP_SLOWEST = 60.0 # (seconds a request may take to come)
const __HTTP_MOST_HEAD = 65536
const __HTTP_MOST_OUT = 1 << 20     # (more than this waiting to go out: no more requests read till it goes)

__http_conns: {int: __Conn}
__http_next = 1
__http_listeners: int[]
__http_largest = 1 << 20
__http_hooked = false
__http_draining = false     # (shutdown: no more requests are started)
__http_full_until = 0.0
__http_t = 0.0              # (answer()'s time: what connections are timed by)
__http_day = -1.0
__http_day_text = ""
__http_day_next = 0.0

# (the route for a request: its index, its params set; -1 none for that path, -2 none for its
# method. The routes of files() after the others)
__http_route = (r: mut Request) -> int:
    segs = __http_segs(r.path)
    path_found = false
    loop fallback in [false, true]:
        loop i in [0..__routes.len()):
            if __routes[i].files != fallback or not __http_fits(__routes[i], segs): continue
            m = __routes[i].method
            if m != "*" and m != r.method and not (m == "GET" and r.method == "HEAD"):
                path_found = true
                continue
            np = __routes[i].parts.len()
            loop k in [0..np):
                p = __routes[i].parts[k]
                if len(p) > 0 and p[0] == ':': r.params[p[1..]] = segs[k]
            if len(__routes[i].rest) > 0: r.params[__routes[i].rest] = join(segs[np..], "/")
            return i
        if path_found: return -2
    -1

# (a path's parts: "/a/b/" as "", "a", "b")
__http_segs = (path: str) -> str[]:
    segs = split(path, "/")
    if segs.len() > 2 and segs[segs.len() - 1] == "": segs.pop()
    segs

# (whether a route's pattern has the path, whatever the method)
__http_fits = (rt: __Route, segs: str[]) -> bool:
    np = rt.parts.len()
    if segs.len() < np or (len(rt.rest) == 0 and segs.len() != np): return false
    loop k in [0..np):
        p = rt.parts[k]
        if len(p) > 0 and p[0] == ':':
            if len(segs[k]) == 0: return false
        else if p != segs[k]: return false
    true

# (the methods there are routes for at a path: a 405's Allow; files()'s only when no other has it)
__http_allowed = (path: str) -> str:
    segs = __http_segs(path)
    out: str[]
    loop fallback in [false, true]:
        loop rt in __routes:
            if rt.files != fallback or not __http_fits(rt, segs) or rt.method in out: continue
            out.push(rt.method)
            if rt.method == "GET" and not ("HEAD" in out): out.push("HEAD")
        if out.len() > 0: break
    join(out, ", ")

# ---------------- answers ----------------

# text (as text/plain, unless type says otherwise)
text = (s: str, status: int = 200, type: str = "text/plain; charset=utf-8") -> Response:
    Response(status = status, headers = {"Content-Type": type}, body = bytes(s))

# a web page's HTML
html = (s: str, status: int = 200) -> Response: text(s, status, "text/html; charset=utf-8")

# any value as JSON (to_json's): a struct, an array, a map...; JSON text already made goes with
# text(s, type = "application/json"). A literal of values of several types is a Json:
# `http.json({"ok": true, "id": id, "tags": tags})`
json = (value, status: int = 200) -> Response: text(to_json(value), status, "application/json")
json = (value: Json, status: int = 200) -> Response: text(to_json(value), status, "application/json")

# bytes, of a type ("image/png"...)
binary = (b: u8[], type: str = "application/octet-stream", status: int = 200) -> Response:
    Response(status = status, headers = {"Content-Type": type}, body = b)

# a status with its reason as the text ("404 Not Found"), or with the text given
status = (code: int, message: str = "") -> Response:
    if code == 204 or code == 304 or (code >= 100 and code < 200): return Response(status = code)
    text(if len(message) > 0: message else: "{code} {reason(code)}", code)

# an error for an API's client: {"error": message} as JSON
json_error = (code: int, message: str) -> Response: json({"error": message}, code)

# to another address (302: for now; 301: for good; 303: after a form's POST, a GET of it)
redirect = (to0: str, status: int = 302) -> Response:
    # (an address from a query, `?to=/x%0d%0aSet-Cookie:...`: its line breaks, spaces and bytes
    # past ASCII percent-encoded, as a browser sends a link)
    to = __http_url_escape(to0)
    Response(status = status, headers = {"Location": to, "Content-Type": "text/plain; charset=utf-8"}, body = bytes("{status} {reason(status)}: {to}\n"))

# (a header's value on one line: line breaks as spaces)
__http_one_line = (v: str) -> str:
    if find_byte(v, '\r') < 0 and find_byte(v, '\n') < 0: return v
    v.replace("\r", " ").replace("\n", " ")

# (an address as it goes in a header: control bytes, spaces and bytes past ASCII percent-encoded)
__http_url_escape = (u: str) -> str:
    plain = true
    loop c in u:
        if c <= 32 or c >= 127: plain = false
    if plain: return u
    out: u8[]
    hex = "0123456789ABCDEF"
    loop c in u:
        if c <= 32 or c >= 127:
            out.push('%')
            out.push(hex[int(c) >> 4])
            out.push(hex[int(c) & 15])
        else: out.push(c)
    str_from_bytes(out)

# (a cookie's name, value or attribute as RFC 6265 lets it be: bytes that would end it or start an
# attribute of their own, `;` and line breaks, left out)
__cookie_part = (v: str, attr: bool) -> str:
    out: u8[]
    loop c in v:
        if c < 32 or c == 127 or c == ';': continue
        if not attr and (c == '"' or c == '\\'): continue
        out.push(c)
    r = str_from_bytes(out)
    # (a value with a space or a comma in quotes, as Go writes it)
    if not attr and (find_byte(r, ' ') >= 0 or find_byte(r, ',') >= 0): return "\"{r}\""
    r

# (a cookie's name: RFC 9110's token characters only)
__cookie_name = (v: str) -> str:
    out: u8[]
    loop c in v:
        if net.__http_token(str_from_bytes([c])): out.push(c)
    str_from_bytes(out)

# a file, sent a piece at a time (a big one is never all in memory), with its type and what lets a
# browser keep a copy (as files() does); on_error's 404 when there is no such file
file = (r: Request, path: str) -> Response:
    if is_dir(path) or not file_exists(path): return on_error(r, 404, "")
    size = file_size(path) ?? 0
    t = file_time(path) ?? 0.0
    tag = "W/\"{int(t):x}-{size:x}\""
    res = Response(headers = {"Content-Type": mime_type(path), "ETag": tag, "Last-Modified": http_date(t)})
    if let inm = r.headers.get("if-none-match") and (inm == tag or inm == __http_gz_tag(tag)):
        res.status = 304
        return res
    if let since = r.headers.get("if-modified-since") and r.headers.get("if-none-match") == none:
        if let s = from_http_date(since) and f64(int(t)) <= s:
            res.status = 304
            return res
    res.file = path
    res.headers["Content-Length"] = "{size}"
    res

# the request's body, as JSON, read into `into` (a struct, an array...: what from_json reads):
# none when it went well, else the answer to give (400, saying what is wrong with it), and `into`
# is as it was. The fields the body has are set, the others keep the values they had (a struct
# in it too, field by field; an array or a map in it is replaced), so the same reads a new one and
# changes one, a PATCH. The request must say it sends JSON (Content-Type: application/json, or a
# type ending in +json, as net.fetch, a page's fetch() with that header and curl --json send it),
# else it is answered 415: what a page of another site can send with the browser's cookies and no
# CORS preflight (a form's post, text/plain) never reaches the handler.
#   t = TodoIn()
#   if let bad = http.read_json(r, t): return bad
#   ...
#   t = todos[id]                                   # (PATCH /todos/:id with {"done": true})
#   if let bad = http.read_json(r, t): return bad
#   todos[id] = t                                   # (its title as it was)
read_json[T] = (r: Request, into: mut T) -> Response?:
    if not __http_is_json(r.headers.get("content-type") ?? ""): return json_error(415, "the body is to be JSON, sent with Content-Type: application/json")
    v = into
    if let e = __from_text_into(r.text, v, true): return json_error(400, "the body is not what this takes: {e.message}")
    into = v
    none

# (a Content-Type of JSON: application/json, application/merge-patch+json; its charset whatever)
__http_is_json = (type: str) -> bool:
    k = find_byte(type, ';')
    t = trim(if k >= 0: type[..k) else: type).lower()
    t == "application/json" or (starts_with(t, "application/") and ends_with(t, "+json"))

# a Set-Cookie on the answer: the client sends the cookie back with its requests from then on
# (r.cookies), for max_age seconds (-1: until the browser closes). http_only: not for the page's
# JavaScript; secure: over https only (secure_cookies: every cookie); same_site: "Lax" (sent with
# the site's own requests, and when a link from another site is followed), "Strict" (the site's
# own only) or "None" (any site's requests too: then Secure, as browsers require)
set_cookie = (res: mut Response, name: str, value: str, max_age: int = -1, path: str = "/", http_only: bool = true, secure: bool = false, same_site: str = "Lax", domain: str = ""):
    c = "{__cookie_name(name)}={__cookie_part(value, false)}; Path={__cookie_part(path, true)}"
    if max_age >= 0: c += "; Max-Age={max_age}"
    if len(domain) > 0: c += "; Domain={__cookie_part(domain, true)}"
    if http_only: c += "; HttpOnly"
    if secure or secure_cookies or same_site.lower() == "none": c += "; Secure"
    if len(same_site) > 0: c += "; SameSite={__cookie_part(same_site, true)}"
    res.cookies.push(c)

# every cookie Secure: sent by the browser over https only. For a site served over https (behind
# Caddy), where a cookie that went over http too could be read on the way:
#   http.secure_cookies = env("DEV") == none        # (http://localhost while developing)
secure_cookies = false

# a Set-Cookie that has the client forget a cookie (path and domain as it was set with)
clear_cookie = (res: mut Response, name: str, path: str = "/", domain: str = ""):
    c = "{__cookie_name(name)}=; Path={__cookie_part(path, true)}; Max-Age=0"
    if len(domain) > 0: c += "; Domain={__cookie_part(domain, true)}"
    if secure_cookies: c += "; Secure"
    res.cookies.push(c)

# a cookie the client can read but not change or make up (a session's user, a cart): its value
# signed with secret (HMAC-SHA256 over its name, value and when it ends), signed_cookie reads it
# back. As set_cookie's (HttpOnly, SameSite=Lax), and good for max_age seconds, a week unless said
# (-1: until the browser closes, its signature good for as long). The value is in it to read
# (base64), not hidden: no password in it. secret: 16 bytes or more, kept out of the code
# (env("SESSION_SECRET"), or crypto.hex_text(crypto.random_bytes(32)) made once and saved); a new
# secret undoes every cookie signed with the old one (everyone signed out)
#   http.set_signed_cookie(res, "user", name, SECRET, max_age = 8 * 3600)
#   ...
#   if let user = http.signed_cookie(r, "user", SECRET): ...
set_signed_cookie = (res: mut Response, name: str, value: str, secret: str, max_age: int = 7 * 86400, path: str = "/", http_only: bool = true, secure: bool = false, same_site: str = "Lax", domain: str = ""):
    if len(secret) < 16: panic("set_signed_cookie's secret is {len(secret)} bytes: 16 or more (crypto.hex_text(crypto.random_bytes(32)), kept out of the code)")
    until = if max_age >= 0: int(unix_time()) + max_age else: 0
    v = "{__http_b64(bytes(value))}.{until}"
    set_cookie(res, name, "{v}.{__http_sign(__cookie_name(name), v, secret)}", max_age, path, http_only, secure, same_site, domain)

# the value of a cookie set_signed_cookie set; none when the request has none, or one whose
# signature is not secret's (changed, made up, another cookie's moved), or one past its max_age
signed_cookie = (r: Request, name: str, secret: str) -> str?:
    parts = split(r.cookies.get(name) ?? "", ".")
    if parts.len() != 3 or len(secret) == 0: return none
    v = "{parts[0]}.{parts[1]}"
    if not crypto.constant_time_equal(__http_sign(__cookie_name(name), v, secret), parts[2]): return none
    until = to_int(parts[1]) ?? -1
    if until < 0 or (until > 0 and f64(until) <= unix_time()): return none
    if let b = base64_decode(parts[0]): return str_from_bytes(b)
    none

# (a signed cookie's signature: of its name too, so that one cookie's cannot pass as another's)
__http_sign = (name: str, v: str, secret: str) -> str: __http_b64(crypto.hmac_sha256(bytes(secret), bytes("{name}={v}")))

# (base64 as a cookie's value has it: URL-safe, no = at the end; base64_decode reads it)
__http_b64 = (b: u8[]) -> str:
    t = base64_encode(b).replace("+", "-").replace("/", "_")
    loop ends_with(t, "="): t = t[..len(t) - 1)
    t

# every value a name has in the request's query, in order: ?tag=a&tag=b gives ["a", "b"] (r.query
# has the last); [] when it has none
query_all = (r: Request, name: str) -> str[]:
    out: str[]
    q = find_byte(r.target, '?')
    if q < 0: return out
    loop part in split(r.target[q + 1..], "&"):
        if len(part) == 0: continue
        k = find_byte(part, '=')
        n = if k < 0: part else: part[..k)
        if url_decode(n, plus = true) == name: out.push(if k < 0: "" else: url_decode(part[k + 1..], plus = true))
    out

# ---------------- rate limits ----------------
# allow(key, per_minute) says whether one more request of key (a client's address, a user's name,
# what they do: "login " + r.address) may go on: per_minute of them a minute, in a burst of up to
# burst (0: per_minute) at once. Each key's count fills back as time passes (a token bucket).
# Memory is bounded: past 100,000 keys, those nearest to full are forgotten (a key not seen starts
# full).
#   http.before("/api/", (r: mut http.Request) -> http.Response?:
#       if not http.allow(r.address, 120): return http.json_error(429, "slow down")
#       none)
allow = (key: str, per_minute: int, burst: int = 0) -> bool:
    now = time()
    most = f64(if burst > 0: burst else: per_minute)
    rate = f64(per_minute) / 60.0
    tokens = most
    if let b = __http_buckets.get(key): tokens = min(most, b.tokens + (now - b.at) * rate)
    else if __http_buckets.len() >= __HTTP_MOST_KEYS: __http_buckets_trim(now)
    ok = tokens >= 1.0
    if ok: tokens -= 1.0
    full = if rate > 0.0: now + (most - tokens) / rate else: now + 3600.0
    __http_buckets[key] = __Bucket(tokens, now, full)
    ok

struct __Bucket:
    tokens: f64
    at: f64                 # (when tokens was so)
    full: f64               # (when it is full again: then as a key not seen)

__http_buckets: {str: __Bucket}
const __HTTP_MOST_KEYS = 100000

# (allow's keys, fewer: those full by now are as good as gone; past half the most still, those
# full soonest go)
__http_buckets_trim = (now: f64):
    global __http_buckets
    fulls: f64[]
    loop _, b in __http_buckets:
        if b.full > now: fulls.push(b.full)
    cut = now
    if fulls.len() > __HTTP_MOST_KEYS / 2:
        fulls.sort()
        cut = fulls[fulls.len() - __HTTP_MOST_KEYS / 2]
    kept: {str: __Bucket}
    loop k, b in __http_buckets:
        if b.full > cut: kept[k] = b
    __http_buckets = kept

# ---------------- streams: server-sent events and chunks ----------------
# A handler answers stream() or events(), and keeps r.conn: the connection stays open, and the
# program sends to it later, as things happen (false once the client has gone). A client that goes
# (a page closed) is let go at once, and stream_open(conn) is false from then on, so a list of them
# loses those it has not sent to since:
#   listeners: int[]
#   http.get("/events", (r: http.Request) -> http.Response:
#       listeners = listeners.filter((c: int): http.stream_open(c))
#       listeners.push(r.conn)
#       http.events())
#   ...
#   listeners = listeners.filter((c: int): http.send_event(c, to_json(score)))
# An events() stream sent nothing for `heartbeat` seconds is sent a comment (which EventSource
# skips), so that a proxy does not take it for idle and cut it, and a client gone without a word
# (its machine off) is found. At most most_streams are open at once: one more is answered 503. A
# page's EventSource connects again by itself when its stream ends, saying the id of the last
# event it had (send_event's id) in r.headers.get("last-event-id"): what came since can go first.

# seconds an events() stream may be sent nothing before a comment goes to it (0: none go)
heartbeat = 15.0

# the most streams (stream(), events()) open at once; one more is answered 503 (on_error's). Each
# holds a connection open, and the connections a program may have are shared by all
most_streams = 1000

# whether a stream (the r.conn of a stream() or events() answer) is open: false once its client has
# gone, end_stream ended it, or the server stopped
stream_open = (conn: int) -> bool: __http_conns.has(conn) and __http_conns[conn].streaming

# an answer whose body is sent later, a chunk at a time (send_chunk, then end_stream)
stream = (type: str = "text/plain; charset=utf-8") -> Response:
    Response(headers = {"Content-Type": type}, stream = true)

# a stream of server-sent events, what a web page's EventSource reads (send_event)
events = () -> Response:
    Response(headers = {"Content-Type": "text/event-stream", "Cache-Control": "no-cache"}, stream = true)

# a chunk of a stream's body; false when the client has gone (or has 8 MB waiting for it, a reader
# that stopped: then it is let go)
send_chunk = (conn: int, b: u8[]) -> bool:
    if not __http_conns.has(conn) or not __http_conns[conn].streaming: return false
    if b.len() == 0: return true
    if __http_conns[conn].out.len() - __http_conns[conn].at > 8 << 20:
        __http_close(conn)
        return false
    if __http_conns[conn].chunked: __http_out(conn, bytes("{b.len():x}\r\n"))
    __http_out(conn, b)
    if __http_conns[conn].chunked: __http_out(conn, bytes("\r\n"))
    __http_flush(conn)
    __http_conns.has(conn)
send_chunk = (conn: int, text: str) -> bool: send_chunk(conn, bytes(text))

# an event to an events() stream: its data (lines of text: each a data: line, whether it ends in
# \n, \r\n or \r), its name when not "message" (a page's EventSource: addEventListener(event,
# ...)), and its id (what the page's next connection says it had last: Last-Event-ID). A line
# break in event or id is left out (it would start a field of its own)
send_event = (conn: int, data: str, event: str = "", id: str = "") -> bool:
    s = ""
    if len(id) > 0: s += "id: {__http_sse_field(id)}\n"
    if len(event) > 0: s += "event: {__http_sse_field(event)}\n"
    at = 0
    loop k in [0..len(data)):
        c = data[k]
        if c == '\n' or c == '\r':
            if c == '\n' and k > 0 and data[k - 1] == '\r':
                at = k + 1
                continue
            s += "data: {data[at..k)}\n"
            at = k + 1
    s += "data: {data[at..]}\n\n"
    send_chunk(conn, s)

# (an event's name or id on its line: line breaks, and the NUL that has an id ignored, left out)
__http_sse_field = (v: str) -> str:
    if find_byte(v, '\r') < 0 and find_byte(v, '\n') < 0 and find_byte(v, '\0') < 0: return v
    v.replace("\r", "").replace("\n", "").replace("\0", "")

# the end of a stream: its body is complete (the connection may carry other requests)
end_stream = (conn: int):
    if not __http_conns.has(conn) or not __http_conns[conn].streaming: return
    if __http_conns[conn].chunked: __http_out(conn, bytes("0\r\n\r\n"))
    else: __http_conns[conn].closing = true
    __http_conns[conn].streaming = false
    __http_flush(conn)

# ---------------- WebSockets ----------------
# A WebSocket on the server's own port: a handler answers websocket(r) and the connection becomes
# a peer of net's, as one that connected to net.listen (net.receive gives its joined event and
# messages; net.handshake(peer) the request's path, headers and cookies):
#   http.get("/ws", (r: http.Request) -> http.Response:
#       if r.headers.get("origin") != "https://example.com": return http.status(403)
#       http.websocket(r))

# the answer that makes the request's connection a WebSocket (a request that is not one's: 426).
# largest: the biggest message taken from it (a bigger one ends the connection, with code 1009)
websocket = (r: Request, largest: int = 16 << 20) -> Response:
    if (r.headers.get("upgrade") ?? "").lower() != "websocket" or not r.headers.has("sec-websocket-key"):
        return status(426, "426 Upgrade Required: a WebSocket's request\n")
    Response(status = 101, upgrade = true, __largest = largest)

# ---------------- every request: before and after its route ----------------
# Functions for every request, around its route's handler: what checks a sign-in, counts requests
# for a limit, adds headers or writes a log. before(f): f is given the request first, and may
# answer it itself (its route is then not called) or give none to let it go on; it may change the
# request too (as by setting r.params["user"] for the handlers). after(f): f is given each request
# and its answer, and gives the answer to send (the same, changed, or another): the server's own
# answers too (on_error's: a 404, a body too big). Each is called in the order they were made; a
# panic in one is a 500, as a handler's is. Given a path first, one is for the paths under it
# only: before("/api/", f) sees /api and /api/todos/3, not /apiary or /index.html.
#   http.before("/api/", (r: mut http.Request) -> http.Response?:
#       if r.headers.get("authorization") != "Bearer " + TOKEN: return http.json_error(401, "sign in first")
#       none)
#   http.after((r: http.Request, res: http.Response) -> http.Response:
#       let res = res
#       res.headers["X-Frame-Options"] = "DENY"
#       res)

# a function each request is given before its route
before = (f: (mut Request) -> Response?): __http_befores.push(__Before("/", f))

# a function the requests to the paths under prefix are given before their route
before = (prefix: str, f: (mut Request) -> Response?): __http_befores.push(__Before(prefix, f))

# a function each request's answer goes through after its route (a WebSocket's too, as its 101)
after = (f: (Request, Response) -> Response): __http_afters.push(__After("/", f))

# a function the answers to the paths under prefix go through after their route
after = (prefix: str, f: (Request, Response) -> Response): __http_afters.push(__After(prefix, f))

struct __Before:
    prefix: str
    f: (mut Request) -> Response?

struct __After:
    prefix: str
    f: (Request, Response) -> Response

__http_befores: __Before[]
__http_afters: __After[]

# (whether a path is under a prefix: "/api/" and "/api" have /api and /api/todos, not /apiary)
__http_under = (path: str, prefix: str) -> bool:
    n = if ends_with(prefix, "/"): len(prefix) - 1 else: len(prefix)
    if n == 0: return true
    starts_with(path, prefix[..n)) and (len(path) == n or path[n] == '/')

# ---------------- what the server answers itself ----------------
# The answers no handler made: 404 (no route has the path), 405 (routes have it for other methods:
# Allow says which), 500 (a handler panicked), and a request refused before it gets to a route
# (400 not HTTP's, 408 too slow to come, 413 its body too big, 431 its headers, 501 a
# Transfer-Encoding not taken, 503 too many streams). They are on_error's: given the request (as
# much of it as was read), the status and why ("" for 404, 405 and 500), and they go through
# after() as any answer. As text unless changed: an API answers JSON with
#   http.on_error = (r: http.Request, code: int, why: str) -> http.Response:
#       http.json_error(code, if len(why) > 0: why else: http.reason(code))
on_error: (Request, int, str) -> Response = __http_error

# (on_error's own: "404 Not Found", "413 Content Too Large: its body is bigger than ...")
__http_error = (r: Request, code: int, why: str) -> Response:
    if len(why) == 0: return status(code)
    status(code, "{code} {reason(code)}: {why}\n")

# (the server's own answer, on_error's; the plain one if that panics)
__http_own = (r: Request, code: int, why: str) -> Response:
    res = Response()
    if not __http_call((q: Request) -> Response: on_error(q, code, why), r, res): res = __http_error(r, code, why)
    res

# ---------------- CORS: requests from web pages of other sites ----------------
# A browser lets a page of another site (another origin: scheme, host and port) read this server's
# answers only when they say it may: cors(origins) says so for those sites ("*": any site), and
# answers the browser's preflight (an OPTIONS request it sends first, for a PUT, a DELETE, or a
# request with JSON or an Authorization header) before any before() or route sees it.
#   http.cors(["https://example.com", "http://localhost:5173"])
#   http.cors()                                     # any site (an open API, without cookies)
#   http.cors(["https://example.com"], prefix = "/api/")   # the paths under /api/ only
# credentials: the page's cookies (and Authorization) go along (with the sites listed only: a
# browser sends none to "*"); max_age: how many seconds a browser may keep a preflight's answer
cors = (origins: str[] = ["*"], methods: str = "GET, HEAD, POST, PUT, PATCH, DELETE", headers: str = "Content-Type, Authorization", credentials: bool = false, max_age: int = 600, prefix: str = "/"):
    global __http_cors
    __http_cors = __Cors(on = true, origins = origins, methods = methods, headers = headers, credentials = credentials, max_age = max_age, prefix = prefix)

struct __Cors:
    on = false
    origins: str[]
    methods = ""
    headers = ""
    credentials = false
    max_age = 0
    prefix = "/"

__http_cors = __Cors()

# (the origin a request's answer lets read it, "" none: the request's Origin when it is listed, or
# "*" for any)
__http_cors_origin = (r: Request) -> str:
    o = r.headers.get("origin") ?? ""
    if len(o) == 0: return ""
    if "*" in __http_cors.origins: return "*"
    if o in __http_cors.origins: o else: ""

# (CORS's headers on an answer, for the request's origin; a preflight's too. With sites listed,
# every answer says it varies by Origin, as a cache must keep one for each: the answer to a site
# not listed too, which has none of them)
__http_cors_headers = (r: Request, res: mut Response, preflight: bool):
    if not __http_cors.on or not __http_under(r.path, __http_cors.prefix): return
    if not ("*" in __http_cors.origins): res.headers["Vary"] = __http_vary(res, "Origin")
    o = __http_cors_origin(r)
    if len(o) == 0: return
    res.headers["Access-Control-Allow-Origin"] = o
    if __http_cors.credentials and o != "*": res.headers["Access-Control-Allow-Credentials"] = "true"
    if preflight:
        res.headers["Access-Control-Allow-Methods"] = __http_cors.methods
        # (the headers the page asked for, when any may be: else those listed)
        res.headers["Access-Control-Allow-Headers"] = if __http_cors.headers == "*": (r.headers.get("access-control-request-headers") ?? "") else: __http_cors.headers
        res.headers["Access-Control-Max-Age"] = "{__http_cors.max_age}"

# (a Vary header with one name more)
__http_vary = (res: Response, name: str) -> str:
    was = res.headers.get("Vary") ?? ""
    if len(was) == 0: return name
    if find(was.lower(), name.lower()) >= 0: return was
    "{was}, {name}"

# ---------------- gzip ----------------
# Answers of text (HTML, CSS, JavaScript, JSON, SVG...) and WebAssembly of 1 KB or more are sent
# gzip'd to the clients that take it (Accept-Encoding: gzip): a third or less of the bytes. A
# file's is made once, while the file is unchanged (up to 64 MB of them kept). false: none are
# (as behind a proxy that does it, Caddy's `encode gzip`)
gzip = true

const __HTTP_GZIP_LEAST = 1024
const __HTTP_GZIP_FILE_MOST = 16 << 20
const __HTTP_GZIP_KEPT_MOST = 64 << 20

struct __Gz:
    time: f64
    size: int
    gz: u8[]

__http_gz_files: {str: __Gz}
__http_gz_kept = 0

# (whether the answer is one to gzip for this request: the client takes gzip, and it is of a type
# that shrinks, big enough, and not gzip'd already)
__http_gzips = (r: Request, res: Response) -> bool:
    if not gzip or r.method == "HEAD" or res.stream or res.upgrade or res.status < 200 or res.status == 204 or res.status == 304: return false
    if res.headers.has("Content-Encoding") or res.headers.has("content-encoding"): return false
    if not __http_takes_gzip(r.headers.get("accept-encoding") ?? ""): return false
    t = (res.headers.get("Content-Type") ?? res.headers.get("content-type") ?? "").lower()
    if not (starts_with(t, "text/") or find(t, "json") >= 0 or find(t, "javascript") >= 0 or find(t, "xml") >= 0 or find(t, "wasm") >= 0): return false
    size = if len(res.file) > 0: (file_size(res.file) ?? 0) else: res.body.len()
    size >= __HTTP_GZIP_LEAST and size <= __HTTP_GZIP_FILE_MOST

# (an Accept-Encoding that has gzip, not with q=0)
__http_takes_gzip = (ae: str) -> bool:
    loop part in split(ae.lower(), ","):
        bits = split(part, ";")
        if trim(bits[0]) != "gzip": continue
        loop b in bits[1..]:
            kv = trim(b)
            if starts_with(kv, "q="): return (to_float(kv[2..]) ?? 1.0) > 0.0
        return true
    false

# (the answer gzip'd: its body, or its file's, kept while the file is unchanged)
__http_gzip_answer = (res: mut Response):
    if len(res.file) > 0:
        t = file_time(res.file) ?? 0.0
        size = file_size(res.file) ?? 0
        if let g = __http_gz_files.get(res.file) and g.time == t and g.size == size: res.body = g.gz
        else:
            b = read_bytes(res.file) ?? []
            if b.len() != size: return
            res.body = __http_gz(b)
            __http_gz_keep(res.file, __Gz(t, size, res.body))
        res.file = ""
        if let tag = res.headers.get("ETag"): res.headers["ETag"] = __http_gz_tag(tag)
    else: res.body = __http_gz(res.body)
    res.headers["Content-Encoding"] = "gzip"
    res.headers["Vary"] = __http_vary(res, "Accept-Encoding")

__http_gz_keep = (path: str, g: __Gz):
    global __http_gz_kept, __http_gz_files
    if let was = __http_gz_files.get(path): __http_gz_kept -= was.gz.len()
    if __http_gz_kept + g.gz.len() > __HTTP_GZIP_KEPT_MOST:
        __http_gz_files = {}
        __http_gz_kept = 0
    __http_gz_files[path] = g
    __http_gz_kept += g.gz.len()

# (a file's ETag for its gzip'd body: another, as its bytes are others; W/"5f3a-1c" W/"5f3a-1c-gz")
__http_gz_tag = (tag: str) -> str: if ends_with(tag, "\""): tag[..len(tag) - 1) + "-gz\"" else: tag

# (bytes in gzip's format: a header, deflate's stream, its CRC-32 and length)
__http_gz = (b: u8[]) -> u8[]:
    out: u8[] = [u8(0x1f), 0x8b, 8, 0, 0, 0, 0, 0, 0, 255]
    out.extend(deflate(b))
    c = int(crypto.crc32(b))
    n = b.len()
    loop k in [0..4): out.push(u8((c >> (8 * k)) & 255))
    loop k in [0..4): out.push(u8((n >> (8 * k)) & 255))
    out

# ---------------- serving ----------------

# answer requests on port until the program is asked to stop (ctrl-c, SIGTERM: stopping()), then
# give the handlers running up to `drain` seconds to answer (shutdown); false at once when the
# port cannot be had. host, largest, backlog: as listen's
@no_web("gives false in a web page: a page cannot listen (the server is a native program)")
serve = (port: int, host: str = "", largest: int = 1 << 20, backlog: int = 511, drain: f64 = 10.0) -> bool:
    # (already listening, by listen(): answered)
    if __http_listeners.len() == 0 and not listen(port, host, largest, backlog): return false
    loop not stopping():
        answer()
        net.wait(1.0)
    shutdown(drain)
    true

# stop serving: no more requests are taken, the handlers running are waited for (up to `wait`
# seconds) and their answers sent, and the connections are closed (streams too, ended first as
# end_stream ends one, so a client sees them complete). true when every one was answered in time
# (a handler still running then goes on, but its answer goes nowhere)
shutdown = (wait: f64 = 10.0) -> bool:
    global __http_draining
    stop_listening()
    __http_draining = true
    streams: int[]
    loop id, c in __http_conns:
        if c.streaming: streams.push(id)
    loop id in streams:
        end_stream(id)
        if __http_conns.has(id): __http_conns[id].closing = true
    end = time() + wait
    loop __http_busy() and time() < end:
        answer()
        # (what waits to go out goes as the sockets take it; the handlers end meanwhile)
        fds: int[]
        want: int[]
        loop fw in __http_wait_fds():
            fds.push(fw.0)
            want.push(fw.1)
        net.__n_wait(fds, want, min(net.__net_ms(end), 20))
    done = not __http_busy()
    ids: int[]
    loop id, _ in __http_conns: ids.push(id)
    loop id in ids: __http_close(id)
    __http_draining = false
    done

# (a handler runs, or an answer waits to go out; a stream's connection is not waited for)
__http_busy = () -> bool:
    loop _, c in __http_conns:
        if c.answering or c.sending or (c.at < c.out.len() and not c.streaming): return true
    false

# start taking requests on port (answer() answers them); false when the port cannot be had (another
# program has it). host: the address it is reached at, "" every one this machine has ("127.0.0.1":
# from this machine only, as behind a proxy on it); largest: the biggest body taken (a bigger one is
# answered 413); backlog: how many connections may wait to be taken
@no_web("gives false in a web page: a page cannot listen (the server is a native program)")
listen = (port: int, host: str = "", largest: int = 1 << 20, backlog: int = 511) -> bool:
    global __http_hooked, __http_largest
    when TARGET == "wasm":
        return false
    else:
        ip = if len(host) == 0: 0 else: net.__n_resolve(host)
        if ip < 0: return false
        net.__n_more_files()
        fd = net.__n_listen(ip, port, backlog)
        if fd < 0: return false
        __http_listeners.push(fd)
        __http_largest = largest
        if not __http_hooked:
            __http_hooked = true
            net.__net_wait_hooks.push(__http_wait_fds)
        true

# stop taking requests (those of connections open are still answered)
stop_listening = ():
    global __http_listeners
    loop fd in __http_listeners: net.__n_close(fd)
    __http_listeners = []

# answer the requests that have come, and send what waits to go out; how many were answered. It
# does not wait: net.wait does (until there is something to answer)
answer = () -> int:
    global __http_full_until, __http_t
    when TARGET == "wasm":
        return 0
    else:
        now = time()
        __http_t = now
        # new connections
        loop fd in __http_listeners:
            loop __http_conns.len() < __HTTP_MOST_CONNS and now >= __http_full_until:
                c = net.__n_accept(fd)
                # (none can be taken, as with too many open: not waited for a moment, which would
                # come at once)
                if c == -2: __http_full_until = now + 0.25
                if c < 0: break
                id = __http_next
                __http_next += 1
                __http_conns[id] = __Conn(fd = c, since = now, address = net.__n_ip_text(net.__n_from))
        # what is ready, of what each waits for
        ids: int[]
        fds: int[]
        want: int[]
        loop id, c in __http_conns:
            w = __http_want(c)
            if w == 0: continue
            ids.push(id)
            fds.push(c.fd)
            want.push(w)
        got = net.__n_wait(fds, want, 0)
        n = 0
        loop k in [0..ids.len()):
            id = ids[k]
            if not __http_conns.has(id): continue
            if got[k] & 2 != 0: __http_flush(id)
            if got[k] & 5 != 0 and __http_conns.has(id): __http_read(id)
        # requests that have come whole, answered while there is room for their answers
        loop id in ids:
            if __http_conns.has(id): n += __http_handle(id)
        # connections done with, or silent for too long; a stream's whose client has gone (or sends
        # what a stream's does not), and those quiet long enough for a heartbeat
        gone: int[]
        slow: int[]
        beat: int[]
        loop id, c in __http_conns:
            if c.answering: continue
            out_left = c.out.len() - c.at
            if c.closing and out_left == 0 and not c.sending: gone.push(id)
            else if c.eof and not c.sending and (out_left == 0 or c.streaming): gone.push(id)
            else if c.streaming and c.inbuf.len() > __HTTP_MOST_HEAD: gone.push(id)
            else if now - c.since > __HTTP_IDLE and not (c.streaming and out_left == 0): gone.push(id)
            else if c.streaming:
                if c.events and heartbeat > 0.0 and out_left == 0 and now - c.since > heartbeat: beat.push(id)
            # (a request that comes a byte at a time, so as never to be idle)
            else if c.inbuf.len() > 0 and now - c.begun > __HTTP_SLOWEST and not c.closing: slow.push(id)
        loop id in gone: __http_close(id)
        loop id in slow:
            if __http_conns.has(id): __http_refuse(id, 408, "the request did not all come in {__HTTP_SLOWEST} seconds")
        loop id in beat: send_chunk(id, ":\n\n")
        # (the handlers just started take their turns: those that do not wait have answered when
        # this returns)
        if n > 0: __task_yield()
        n

# the line a request makes in a log: who, what, the answer's status and size, how long it took
#   127.0.0.1 "GET /todos?done=true HTTP/1.1" 200 312 0.4ms
log_line = (r: Request, res: Response, seconds: f64) -> str:
    size = if len(res.file) > 0: (file_size(res.file) ?? 0) else: res.body.len()
    # (a request refused before its line was read: "-")
    line = if len(r.method) > 0: "\"{r.method} {r.target} {r.version}\"" else: "-"
    "{r.address} {line} {res.status} {size} {seconds * 1000.0:.1}ms"

# write each request's log_line to standard error
log_requests = false

# the addresses of the proxies in front of the server (Caddy on the same machine: ["127.0.0.1"]):
# a request from one of them has as r.address (log_line's, a WebSocket's handshake's) the client's,
# from X-Forwarded-For: the last address in it that is not a proxy listed (each proxy adds the one
# it was reached from at the end; what comes before is the client's to write). None unless set: a
# server reached with no proxy in front would take a client's word for where it is
#   http.trust_proxy = ["127.0.0.1"]
trust_proxy: str[]

# (where a request through the proxies of trust_proxy came from: X-Forwarded-For's last address
# not theirs, or the first in it when all are)
__http_forwarded = (r: Request) -> str:
    parts = split(r.headers.get("x-forwarded-for") ?? "", ",")
    at = r.address
    k = parts.len() - 1
    loop k >= 0:
        a = trim(parts[k])
        if len(a) > 0:
            at = a
            if not (a in trust_proxy): break
        k -= 1
    at

# a time (unix_time's seconds) as HTTP writes one: "Sun, 06 Nov 1994 08:49:37 GMT"
http_date = (t: f64) -> str:
    d = date(t, utc = true)
    "{weekday_name(d)[..3)}, {d.day:02} {month_name(d)[..3)} {d.year} {d.hour:02}:{d.minute:02}:{d.second:02} GMT"

# an HTTP date ("Sun, 06 Nov 1994 08:49:37 GMT") as unix_time's seconds; none when it is not one
from_http_date = (s: str) -> f64?:
    w = split(trim(s), " ")
    if w.len() != 6 or w[5] != "GMT": return none
    m = -1
    loop i in [0..12):
        if __HTTP_MONTHS[i] == w[2]: m = i + 1
    hms = split(w[4], ":")
    if m < 0 or hms.len() != 3: return none
    day = to_int(w[1]) ?? -1
    year = to_int(w[3]) ?? -1
    h = to_int(hms[0]) ?? -1
    mi = to_int(hms[1]) ?? -1
    sec = to_int(hms[2]) ?? -1
    if day < 1 or year < 1970 or h < 0 or mi < 0 or sec < 0: return none
    unix_time(Date(year = year, month = m, day = day, hour = h, minute = mi, second = sec))

__HTTP_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

# a status's reason: 404 "Not Found"
reason = (code: int) -> str:
    match code:
        100: "Continue"
        101: "Switching Protocols"
        200: "OK"
        201: "Created"
        202: "Accepted"
        204: "No Content"
        206: "Partial Content"
        301: "Moved Permanently"
        302: "Found"
        303: "See Other"
        304: "Not Modified"
        307: "Temporary Redirect"
        308: "Permanent Redirect"
        400: "Bad Request"
        401: "Unauthorized"
        403: "Forbidden"
        404: "Not Found"
        405: "Method Not Allowed"
        406: "Not Acceptable"
        408: "Request Timeout"
        409: "Conflict"
        410: "Gone"
        411: "Length Required"
        413: "Content Too Large"
        414: "URI Too Long"
        415: "Unsupported Media Type"
        418: "I'm a teapot"
        422: "Unprocessable Content"
        426: "Upgrade Required"
        429: "Too Many Requests"
        431: "Request Header Fields Too Large"
        500: "Internal Server Error"
        501: "Not Implemented"
        502: "Bad Gateway"
        503: "Service Unavailable"
        504: "Gateway Timeout"
        _: if code < 200: "Informational" else: if code < 300: "Success" else: if code < 400: "Redirection" else: if code < 500: "Client Error" else: "Server Error"

# the type of a file by its extension, as a Content-Type ("text/html; charset=utf-8" for .html);
# application/octet-stream for one not known
mime_type = (path: str) -> str: __HTTP_TYPES.get(extension(path).lower()) ?? "application/octet-stream"

__HTTP_TYPES = {".html": "text/html; charset=utf-8", ".htm": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8",
    ".js": "text/javascript; charset=utf-8", ".mjs": "text/javascript; charset=utf-8", ".json": "application/json",
    ".txt": "text/plain; charset=utf-8", ".md": "text/markdown; charset=utf-8", ".csv": "text/csv; charset=utf-8",
    ".xml": "application/xml", ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif", ".ico": "image/x-icon", ".bmp": "image/bmp",
    ".wasm": "application/wasm", ".pdf": "application/pdf", ".zip": "application/zip", ".gz": "application/gzip",
    ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
    ".mp3": "audio/mpeg", ".ogg": "audio/ogg", ".wav": "audio/wav", ".mp4": "video/mp4", ".webm": "video/webm",
    ".glb": "model/gltf-binary", ".gltf": "model/gltf+json", ".jo": "text/plain; charset=utf-8"}

# ---------------- connections ----------------

struct __Conn:
    fd: int
    since: f64              # (when it last sent or took something)
    begun = 0.0             # (when the request coming began to)
    address = ""
    inbuf: u8[]
    scanned = 0             # (inbuf has no head's end before this)
    out: u8[]               # (what waits to go out, from out[at])
    at = 0
    eof = false             # (the client has sent all it will)
    closing = false         # (to close once out has gone)
    file = File()           # (a file being sent, a piece at a time)
    sending = false
    streaming = false       # (a stream's: its body comes from send_chunk)
    events = false          # (an events() stream's: a comment goes as a heartbeat)
    chunked = false
    keep = true             # (the connection stays open after the answer being sent)
    continued = false       # (100 Continue sent for the request whose body is coming)
    answering = false       # (its request's handler runs, in a task of its own: the next waits)


# (what a connection waits for: 1 to read, 2 to write)
__http_want = (c: __Conn) -> int:
    w = 0
    if not c.eof and c.out.len() - c.at < __HTTP_MOST_OUT and not c.closing and c.inbuf.len() < __http_largest + __HTTP_MOST_HEAD: w |= 1
    if c.at < c.out.len(): w |= 2
    w

# (net.wait's: the sockets of the server)
__http_wait_fds = () -> (int, int)[]:
    out: (int, int)[]
    if __http_conns.len() < __HTTP_MOST_CONNS and __http_t >= __http_full_until:
        loop fd in __http_listeners: out.push((fd, 1))
    loop id, c in __http_conns:
        w = __http_want(c)
        if w != 0: out.push((c.fd, w))
    out

__http_out = (id: int, b: u8[]): __http_conns[id].out.extend(b)

# (what waits to go out: as much as the socket takes now, then more of the file being sent)
__http_flush = (id: int):
    loop true:
        c = __http_conns[id]
        loop __http_conns[id].at < __http_conns[id].out.len():
            at = __http_conns[id].at
            n = net.__n_send(c.fd, data(__http_conns[id].out) + at, __http_conns[id].out.len() - at)
            if n == -1: break
            if n < 0:
                __http_close(id)
                return
            __http_conns[id].at += n
            __http_conns[id].since = __http_t
        if __http_conns[id].at == __http_conns[id].out.len():
            __http_conns[id].out.clear()
            __http_conns[id].at = 0
        else if __http_conns[id].at > 65536 and __http_conns[id].at * 2 > __http_conns[id].out.len():
            __http_conns[id].out = __http_conns[id].out[__http_conns[id].at..]
            __http_conns[id].at = 0
        # (a file: its next piece, while little waits)
        if not __http_conns[id].sending or __http_conns[id].out.len() - __http_conns[id].at >= 1 << 18: return
        piece = __http_conns[id].file.read_bytes(1 << 16)
        if piece.len() == 0:
            __http_conns[id].file.close()
            __http_conns[id].sending = false
            return
        __http_conns[id].out.extend(piece)

__http_read = (id: int):
    net.__net_rbuf_ready()
    loop __http_conns[id].inbuf.len() < __http_largest + __HTTP_MOST_HEAD:
        n = net.__n_recv(__http_conns[id].fd, data(net.__net_rbuf), net.__net_rbuf.len())
        if n == -1: break
        if n <= 0:
            __http_conns[id].eof = true
            break
        if __http_conns[id].inbuf.len() == 0: __http_conns[id].begun = __http_t
        __http_conns[id].inbuf.extend(net.__net_rbuf[..n))
        __http_conns[id].since = __http_t
        if n < net.__net_rbuf.len(): break

__http_close = (id: int):
    if not __http_conns.has(id): return
    if __http_conns[id].sending: __http_conns[id].file.close()
    net.__n_close(__http_conns[id].fd)
    __http_conns.remove(id)

# (the requests that have come whole on a connection, answered in order; how many)
__http_handle = (id: int) -> int:
    n = 0
    loop __http_conns.has(id):
        c = __http_conns[id]
        if __http_draining or c.answering or c.closing or c.streaming or c.sending or c.out.len() - c.at >= __HTTP_MOST_OUT or c.inbuf.len() == 0: break
        b = c.inbuf
        # (empty lines before a request, as some clients send after a body's: skipped)
        k0 = 0
        loop k0 + 1 < b.len() and b[k0] == '\r' and b[k0 + 1] == '\n': k0 += 2
        if k0 > 0:
            __http_conns[id].inbuf = b[k0..]
            __http_conns[id].scanned = 0
            continue
        e = __http_head_end(b, c.scanned)
        if e == -2:
            __http_refuse(id, 400, "its lines end in \\n alone, not \\r\\n as HTTP's do")
            break
        if e < 0:
            __http_conns[id].scanned = max(b.len() - 3, 0)
            if b.len() > __HTTP_MOST_HEAD: __http_refuse(id, 431, "the request's headers are too long")
            break
        rr = __http_request(b, e)
        if rr == none:
            __http_refuse(id, 400, "that is not an HTTP request")
            break
        req = rr!
        req.address = c.address
        if trust_proxy.len() > 0 and c.address in trust_proxy: req.address = __http_forwarded(req)
        req.conn = id
        # its body: as long as Content-Length says, or in chunks. What a proxy in front could read
        # another way, and so pass on a request hidden in this one's body, is refused (the
        # connection closed): both, a Transfer-Encoding not chunked, Content-Lengths that differ
        start = e + 4
        stop = start
        if let te = req.headers.get("transfer-encoding"):
            if req.headers.has("content-length") or req.version == "HTTP/1.0":
                __http_refuse(id, 400, "it has a Transfer-Encoding and a Content-Length (or is HTTP/1.0's)", req)
                break
            if te.lower() != "chunked":
                __http_refuse(id, 501, "its Transfer-Encoding is not chunked, the one taken", req)
                break
            got, body, at = __http_unchunk(b, start, __http_largest)
            if got == -1:
                __http_refuse(id, 400, "its chunks are not as HTTP's are", req)
                break
            if got == -2:
                __http_refuse(id, 413, "its body is bigger than the {__http_largest} bytes taken", req)
                break
            if got == 0:
                __http_continue(id, req)
                break
            req.body = body
            stop = at
        else if let cl = req.headers.get("content-length"):
            k = __http_length(cl)
            if k < 0:
                __http_refuse(id, 400, if k == -1: "its Content-Length is not a number" else: "its Content-Lengths differ", req)
                break
            if k > __http_largest:
                __http_refuse(id, 413, "its body is bigger than the {__http_largest} bytes taken", req)
                break
            if b.len() < start + k:
                __http_continue(id, req)
                break
            req.body = b[start..start + k)
            stop = start + k
        if req.body.len() > 0: req.text = str_from_bytes(req.body)
        __http_conns[id].inbuf = if stop == b.len(): [] else: b[stop..]
        __http_conns[id].scanned = 0
        __http_conns[id].continued = false
        # (its handler in a task of its own, so that one that waits holds up no other; the
        # connection's next request once it is answered)
        __http_conns[id].answering = true
        spawn((): __http_answer_task(id, req))
        n += 1
        break
    n

# (a Content-Length's number: -1 not one, -2 several that differ; "5, 5", two headers the same, is 5)
__http_length = (cl: str) -> int:
    k = -1
    loop part in split(cl, ","):
        v = trim(part)
        if len(v) == 0 or len(v) > 18: return -1
        loop d in v:
            if d < '0' or d > '9': return -1
        n = to_int(v) ?? -1
        if k >= 0 and n != k: return -2
        k = n
    k

__http_answer_task = (id: int, req: Request):
    __http_answer(id, req)
    if __http_conns.has(id):
        __http_conns[id].answering = false
        __http_handle(id)

# (a request whose body has not all come, and whose client waits to be told to send it)
__http_continue = (id: int, req: Request):
    if __http_conns[id].continued or (req.headers.get("expect") ?? "").lower() != "100-continue": return
    __http_conns[id].continued = true
    __http_out(id, bytes("HTTP/1.1 100 Continue\r\n\r\n"))
    __http_flush(id)

# (a request that cannot be answered: told why (on_error's, through after's), and the connection
# closed. req: what was read of it)
__http_refuse = (id: int, code: int, why: str, req0: Request = Request()):
    req = req0
    if len(req.address) == 0: req.address = __http_conns[id].address
    res = __http_finish(req, __http_own(req, code, why))
    if not __http_conns.has(id): return
    __http_conns[id].inbuf = []
    __http_send(id, req, res, false)
    if __http_conns.has(id): __http_conns[id].closing = true
    if log_requests: eprint(log_line(req, res, 0.0))

# (a request, answered by its route's handler, with before's and after's around it)
__http_answer = (id: int, req0: Request):
    t0 = if log_requests: time() else: 0.0
    req = req0
    res = Response()
    # (a CORS preflight: answered for the browser, before any before() sees it)
    if __http_cors.on and req.method == "OPTIONS" and req.headers.has("access-control-request-method") and req.headers.has("origin") and __http_under(req.path, __http_cors.prefix):
        res = Response(status = 204)
        __http_cors_headers(req, res, true)
    else:
        if not __http_call(__http_handler, req, res): res = __http_own(req, 500, "")
        # (a stream past the most: refused, and its connection closed)
        if res.stream and req.method != "HEAD" and __http_streams() >= most_streams:
            res = __http_own(req, 503, "{most_streams} streams are open, the most taken")
            res.headers["Connection"] = "close"
        res = __http_finish(req, res)
    if not __http_conns.has(id): return
    if res.upgrade:
        __http_upgrade(id, req, res.__largest)
        return
    conn = (req.headers.get("connection") ?? "").lower()
    keep = if req.version == "HTTP/1.0": find(conn, "keep-alive") >= 0 else: find(conn, "close") < 0
    __http_send(id, req, res, keep)
    if log_requests: eprint(log_line(req, res, time() - t0))

# (the streams open)
__http_streams = () -> int:
    n = 0
    loop _, c in __http_conns:
        if c.streaming: n += 1
    n

# (an answer made: CORS's headers on it, then through the after's; a panic in one is a 500)
__http_finish = (req: Request, res0: Response) -> Response:
    res = res0
    __http_cors_headers(req, res, false)
    if __http_afters.len() == 0: return res
    done = res
    if not __http_call((r: Request) -> Response: __http_after_all(r, done), req, res):
        res = __http_error(req, 500, "")
        __http_cors_headers(req, res, false)
    res

# (the before's, then the route's handler: the answer; on_error's 404 and 405 for none)
__http_handler = (r0: Request) -> Response:
    r = r0
    loop b in __http_befores:
        if not __http_under(r.path, b.prefix): continue
        if let early = b.f(r): return early
    i = __http_route(r)
    if i == -1: return on_error(r, 404, "")
    if i == -2:
        res = on_error(r, 405, "")
        res.headers["Allow"] = __http_allowed(r.path)
        return res
    __routes[i].handler(r)

__http_after_all = (r: Request, res0: Response) -> Response:
    res = res0
    loop a in __http_afters:
        if __http_under(r.path, a.prefix): res = a.f(r, res)
    res

# (the handler called; false when it panicked, the panic caught: lib/core/rt.jo)
__http_call = (h: (Request) -> Response, r: Request, res: mut Response) -> bool:
    global __catch_jmp
    when TARGET == "wasm":
        res = h(r)
        return true
    else:
        jb = __alloc(256)
        keep = __catch_jmp
        if __setjmp(jb) == 0:
            __catch_jmp = jb
            res = h(r)
            __catch_jmp = keep
            __free(jb)
            return true
        __catch_jmp = keep
        __free(jb)
        false

# (an answer, written out: its status line and headers, then its body, its file or its stream)
__http_send = (id: int, req: Request, res0: Response, keep0: bool):
    keep = keep0
    res = res0
    if __http_gzips(req, res): __http_gzip_answer(res)
    v10 = req.version == "HTTP/1.0"
    s = "HTTP/1.1 {res.status} {reason(res.status)}\r\n"
    loop k, v in res.headers:
        lk = k.lower()
        if lk == "connection":
            if v.lower() == "close": keep = false
            continue
        if lk == "transfer-encoding" or (lk == "content-length" and len(res.file) == 0): continue
        # (a line break in a value, `%0d%0a` from a query, would start a header of its own: a
        # space instead, as Go does; a name that is not one is left out)
        if not net.__http_token(k): continue
        s += "{k}: {__http_one_line(v)}\r\n"
    loop ck in res.cookies: s += "Set-Cookie: {__http_one_line(ck)}\r\n"
    if not res.headers.has("Date"): s += "Date: {__http_now()}\r\n"
    has_body = res.status >= 200 and res.status != 204 and res.status != 304
    chunked = false
    if res.stream:
        if v10: keep = false
        else:
            chunked = true
            s += "Transfer-Encoding: chunked\r\n"
    else if len(res.file) == 0 and has_body: s += "Content-Length: {res.body.len()}\r\n"
    if not keep: s += "Connection: close\r\n"
    else if v10: s += "Connection: keep-alive\r\n"
    s += "\r\n"
    __http_out(id, bytes(s))
    if req.method != "HEAD" and has_body:
        if res.stream:
            __http_conns[id].streaming = true
            __http_conns[id].chunked = chunked
            __http_conns[id].events = starts_with((res.headers.get("Content-Type") ?? "").lower(), "text/event-stream")
        else if len(res.file) > 0:
            if let f = open_file(res.file):
                __http_conns[id].file = f
                __http_conns[id].sending = true
            else: keep = false
        else: __http_out(id, res.body)
    __http_conns[id].keep = keep
    if not keep and not res.stream: __http_conns[id].closing = true
    __http_flush(id)

# (the request's connection, a WebSocket from now on: a peer of net's)
__http_upgrade = (id: int, req: Request, largest: int):
    __http_out(id, bytes(net.__ws_accept_reply(req.headers["sec-websocket-key"])))
    hs = net.Handshake(path = req.path, query = req.query, headers = req.headers, cookies = req.cookies, origin = req.headers.get("origin") ?? "", address = req.address)
    c = __http_conns[id]
    __http_conns.remove(id)
    net.__net_adopt(c.fd, c.inbuf, c.out[c.at..], hs, largest)
    if log_requests: eprint(log_line(req, Response(status = 101), 0.0))

# (Date's text, made once a second: the wall clock looked at when the next second is due)
__http_now = () -> str:
    global __http_day, __http_day_next, __http_day_text
    if __http_t >= __http_day_next or __http_t == 0.0:
        u = unix_time()
        t = floor(u)
        if t != __http_day:
            __http_day = t
            __http_day_text = http_date(t)
        __http_day_next = __http_t + (t + 1.0 - u)
    __http_day_text

# (where the head of a request ends, its \r\n\r\n, looked for from `from` on; -1: not yet; -2: a
# line ends in \n alone, which a proxy in front may read otherwise)
__http_head_end = (b: u8[], from: int) -> int:
    loop k in [from..b.len()):
        if b[k] != '\n': continue
        if k == 0 or b[k - 1] != '\r': return -2
        if k >= 3 and b[k - 2] == '\n' and b[k - 3] == '\r': return k - 3
    -1

# (a request's head: its line and headers; none when it is not one)
__http_request = (b: u8[], e: int) -> Request?:
    # (a \r not before a \n, which some read as a line's end: not one)
    head = str_from_bytes(b[..e))
    lines = split(head, "\r\n")
    if find_byte(head, '\r') >= 0:
        loop line in lines:
            if find_byte(line, '\r') >= 0: return none
    w = split(lines[0], " ")
    if w.len() != 3 or not net.__http_token(w[0]) or not starts_with(w[2], "HTTP/1."): return none
    r = Request(method = w[0], target = w[1], version = w[2])
    target = w[1]
    # (a proxy's form: the whole address)
    if starts_with(target, "http://") or starts_with(target, "https://"):
        rest = target[find(target, "//") + 2..]
        k = find(rest, "/")
        target = if k < 0: "/" else: rest[k..]
    q = find(target, "?")
    if q >= 0:
        r.query = parse_query(target[q + 1..])
        target = target[..q)
    r.path = url_decode(target)
    if find(r.path, "\0") >= 0: return none
    if r.path != "*" and (len(r.path) == 0 or r.path[0] != '/'): return none
    loop line in lines[1..]:
        # (its name right before its colon: not "Content-Length : 5", nor a line that goes on from
        # the one before, as a proxy in front may read them otherwise)
        c = find_byte(line, ':')
        if c <= 0 or not net.__http_token(line[..c)): return none
        name = line[..c).lower()
        v = trim(line[c + 1..])
        if let was = r.headers.get(name): r.headers[name] = if name == "cookie": "{was}; {v}" else: "{was}, {v}"
        else: r.headers[name] = v
    if let ck = r.headers.get("cookie"): r.cookies = parse_cookies(ck)
    r

# (a chunked body from b[at]: 1 and it and where it ends, once it has all come; 0 not yet; -1 not
# chunks; -2 bigger than most)
__http_unchunk = (b: u8[], at0: int, most: int) -> (int, u8[], int):
    out: u8[]
    at = at0
    loop true:
        e = __http_line_end(b, at)
        if e < 0: return (if b.len() - at > 100: -1 else: 0, out, 0)
        size = 0
        digits = 0
        loop k in [at..e):
            d = __http_hex(b[k])
            if d < 0: break
            size = size * 16 + d
            digits += 1
        if digits == 0 or digits > 12: return (-1, out, 0)
        # (after its size, an extension or nothing: "5x" or a line break inside is not a chunk's)
        if at + digits < e and b[at + digits] != ';' and b[at + digits] != ' ' and b[at + digits] != '\t': return (-1, out, 0)
        loop k in [at..e):
            if b[k] == '\n' or b[k] == '\r': return (-1, out, 0)
        at = e + 2
        if size == 0:
            # (trailers, if any: lines up to an empty one)
            loop true:
                e = __http_line_end(b, at)
                if e < 0: return (0, out, 0)
                if e == at: return (1, out, e + 2)
                at = e + 2
        if out.len() + size > most: return (-2, out, 0)
        if b.len() < at + size + 2: return (0, out, 0)
        if b[at + size] != '\r' or b[at + size + 1] != '\n': return (-1, out, 0)
        out.extend(b[at..at + size))
        at += size + 2
    (0, out, 0)

__http_line_end = (b: u8[], at: int) -> int:
    k = at
    loop k + 1 < b.len():
        if b[k] == '\r' and b[k + 1] == '\n': return k
        k += 1
    -1

__http_hex = (c: u8) -> int:
    if c >= '0' and c <= '9': return int(c) - c'0'
    if c >= 'a' and c <= 'f': return int(c) - c'a' + 10
    if c >= 'A' and c <= 'F': return int(c) - c'A' + 10
    -1

# (files()'s: the file under root that the request's path names)
__http_files = (r: Request, root: str) -> Response:
    rel = r.params.get("path") ?? ""
    loop seg in split(rel, "/"):
        if seg == "..": return on_error(r, 400, "a path with .. in it")
        if len(seg) > 0 and seg[0] == '.': return on_error(r, 404, "")
    if find(rel, "\\") >= 0: return on_error(r, 400, "a path with \\ in it")
    p = if len(rel) == 0: root else: join_path(root, rel)
    if is_dir(p):
        if not ends_with(r.path, "/"):
            q = find(r.target, "?")
            return redirect(r.path + "/" + (if q >= 0: r.target[q..] else: ""), 301)
        p = join_path(p, "index.html")
    # (a file's path with a / after it, /index.html/: not the file, as a directory's is not)
    else if ends_with(r.path, "/") and len(rel) > 0: return on_error(r, 404, "")
    file(r, p)
