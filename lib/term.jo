# ---------------- decoding the terminal's input ----------------
# (one event from b at i, and how many bytes it took: 0 when the bytes end in the middle of a
# sequence (final: nothing more is coming, so they are what they are as keys); an event of none
# for a sequence that means nothing here, skipped)
__t_parse = (b: u8[], i: int, final: bool) -> (Event?, int):
    n = b.len()
    c = int(b[i])
    if c == 0x1B:
        if i + 1 >= n:
            if final: return (__t_key(.escape), 1)
            return (none, 0)
        c2 = int(b[i + 1])
        if c2 == c'[':
            e, k = __t_csi(b, i + 2, final)
            if k == 0: return (none, 0)
            if k < 0: return (__t_char(c'[', alt = true), 2)     # (not a sequence: alt+[)
            return (e, k + 2)
        if c2 == c'O':
            if i + 2 >= n:
                if final: return (__t_char(c'O', alt = true), 2)
                return (none, 0)
            k = match int(b[i + 2]):
                c'A': Key.up
                c'B': Key.down
                c'C': Key.right
                c'D': Key.left
                c'H': Key.home
                c'F': Key.end
                c'P': Key.f1
                c'Q': Key.f2
                c'R': Key.f3
                c'S': Key.f4
                c'M': Key.enter
                _: Key.char
            if k == .char: return (__t_char(c'O', alt = true), 2)
            return (__t_key(k), 3)
        if c2 == 0x1B:
            # (escape, then a sequence: that key with alt, as some terminals send it)
            if i + 2 >= n and not final: return (none, 0)
            if i + 2 < n and (b[i + 2] == '[' or b[i + 2] == 'O'):
                e, k = __t_parse(b, i + 1, final)
                if k == 0: return (none, 0)
                if let x = e: return (__t_with(x, alt = true), k + 1)
                return (none, k + 1)
            return (__t_key(.escape, alt = true), 2)
        # (escape, then a key: that key with alt)
        e, k = __t_parse(b, i + 1, final)
        if k == 0: return (none, 0)
        if let x = e: return (__t_with(x, alt = true), k + 1)
        return (none, k + 1)
    if c == 13 or c == 10: return (__t_key(.enter), 1)
    if c == 9: return (__t_key(.tab), 1)
    if c == 127: return (__t_key(.backspace), 1)
    if c == 8: return (__t_key(.backspace, ctrl = true), 1)
    if c == 0: return (__t_char(32, ctrl = true), 1)
    if c < 27: return (__t_char(c'a' + c - 1, ctrl = true), 1)
    if c < 32: return (__t_char(c'\\' + c - 28, ctrl = true), 1)      # (ctrl+\ ] ^ _)
    if c < 0x80: return (__t_char(c), 1)
    # (a character of several bytes)
    need = if c >= 0xF0: 4 else: if c >= 0xE0: 3 else: 2
    if i + need > n:
        if not final: return (none, 0)
        return (__t_char(0xFFFD), 1)
    s = str_from_bytes(b[i..i + need))
    cp, k = __t_utf8(s, 0)
    (__t_char(cp), k)

# (a CSI sequence's parameters and final byte, from j: the key it is, and the bytes it took; 0:
# not all there yet, -1: not a sequence)
__t_csi = (b: u8[], j: int, final: bool) -> (Event?, int):
    n = b.len()
    k = j
    loop k < n and b[k] >= 0x20 and b[k] <= 0x3F: k += 1
    if k >= n:
        if final: return (none, -1)
        return (none, 0)
    f = int(b[k])
    if f < 0x40 or f > 0x7E: return (none, -1)
    took = k + 1 - j
    p = str_from_bytes(b[j..k))
    # (the mouse, as xterm's SGR mode 1006 says it: <button;x;y, M pressed, m released)
    if len(p) > 0 and p[0] == '<' and (f == c'M' or f == c'm'):
        ns = __t_nums(p[1..])
        if ns.len() < 3: return (none, took)
        return (__t_mouse_event(ns[0], ns[1] - 1, ns[2] - 1, f == c'm'), took)
    # (the mouse in X10's mode, for a terminal without 1006: three bytes after it)
    if len(p) == 0 and f == c'M':
        if k + 3 >= n:
            if final: return (none, took)
            return (none, 0)
        return (__t_mouse_event(int(b[k + 1]) - 32, int(b[k + 2]) - 33, int(b[k + 3]) - 33, false), took + 3)
    ns = __t_nums(p)
    mods = if ns.len() >= 2: ns[1] else: 1
    if f == c'~':
        if ns.len() == 0: return (none, took)
        if ns[0] == 200:
            # (pasted text, up to ESC [ 201 ~)
            e = __t_find(b, k + 1, "\x1b[201~")
            if e < 0: return (none, 0)
            return (__t_paste(b[k + 1..e)), e + 6 - j)
        if ns[0] == 27 and ns.len() >= 3: return (__t_mods(__t_code_key(ns[2]), ns[1]), took)    # (xterm's modifyOtherKeys)
        key = match ns[0]:
            1, 7: Key.home
            2: Key.insert
            3: Key.delete
            4, 8: Key.end
            5: Key.page_up
            6: Key.page_down
            11: Key.f1
            12: Key.f2
            13: Key.f3
            14: Key.f4
            15: Key.f5
            17: Key.f6
            18: Key.f7
            19: Key.f8
            20: Key.f9
            21: Key.f10
            23: Key.f11
            24: Key.f12
            _: Key.char
        if key == .char: return (none, took)
        return (__t_mods(__t_key(key), mods), took)
    if f == c'u':
        # (a key as its code with its modifiers: CSI u, as kitty and foot send)
        if ns.len() == 0: return (none, took)
        return (__t_mods(__t_code_key(ns[0]), mods), took)
    if f == c'Z': return (__t_key(.tab, shift = true), took)
    if f == c'I' or f == c'O': return (none, took)                     # (focus in, out)
    key = match f:
        c'A': Key.up
        c'B': Key.down
        c'C': Key.right
        c'D': Key.left
        c'H': Key.home
        c'F': Key.end
        c'P': Key.f1
        c'Q': Key.f2
        c'R': Key.f3
        c'S': Key.f4
        _: Key.char
    # (the Linux console's F1-F5: ESC [ [ A..E)
    if len(p) == 0 and f == c'[' and k + 1 < n:
        c3 = int(b[k + 1])
        if c3 >= c'A' and c3 <= c'E': return (__t_key(Key(int(Key.f1) + c3 - c'A')), took + 1)
    if key == .char: return (none, took)
    (__t_mods(__t_key(key), mods), took)

# (a key's code, as CSI u and modifyOtherKeys give it)
__t_code_key = (code: int) -> Event:
    if code == 13: return __t_key(.enter)
    if code == 9: return __t_key(.tab)
    if code == 27: return __t_key(.escape)
    if code == 127 or code == 8: return __t_key(.backspace)
    __t_char(code)

# (the numbers of a sequence's parameters, separated by ; (a : and what follows it left out))
__t_nums = (p: str) -> int[]:
    out: int[]
    v = 0
    skip = false
    loop i in 0..len(p):
        c = p[i]
        if c == ';':
            out.push(v)
            v = 0
            skip = false
        else if c == ':': skip = true
        else if c >= '0' and c <= '9' and not skip: v = v * 10 + int(c - '0')
    if len(p) > 0: out.push(v)
    out

__t_find = (b: u8[], from: int, s: str) -> int:
    i = from
    loop i + len(s) <= b.len():
        ok = true
        loop k in 0..len(s):
            if b[i + k] != s[k]:
                ok = false
                break
        if ok: return i
        i += 1
    -1

# (pasted text: its line ends as \n)
__t_paste = (b: u8[]) -> Event:
    t = replace(replace(str_from_bytes(b), "\r\n", "\n"), "\r", "\n")
    Event(.paste, text = t)

# (xterm's modifiers parameter: 1 + shift 1, alt 2, ctrl 4, meta 8)
__t_mods = (e: Event, m: int) -> Event:
    if m <= 1: return e
    b = m - 1
    __t_with(e, shift = b & 1 != 0, alt = b & 10 != 0, ctrl = b & 4 != 0)

# (the mouse: SGR's button number, bits 4 shift, 8 alt, 16 ctrl, 32 moving, 64 the wheel)
__t_mouse_event = (bt: int, x: int, y: int, released: bool) -> Event?:
    e = Event(.mouse, x = x, y = y, shift = bt & 4 != 0, alt = bt & 8 != 0, ctrl = bt & 16 != 0)
    low = bt & 3
    if bt & 64 != 0:
        e.mouse = match low:
            0: Mouse.wheel_up
            1: Mouse.wheel_down
            2: Mouse.wheel_left
            _: Mouse.wheel_right
        return e
    btn = if low == 3: 0 else: if low == 1: 2 else: if low == 2: 3 else: 1
    if bt & 32 != 0:
        e.mouse = if btn == 0: .move else: .drag
        e.button = btn
        return e
    e.button = btn
    e.mouse = if released or btn == 0: .release else: .press
    e

__t_key = (k: Key, ctrl: bool = false, alt: bool = false, shift: bool = false) -> Event:
    e = Event(.key, key = k, ctrl = ctrl, alt = alt, shift = shift)
    e.name = __t_name(e)
    e

__t_char = (cp: int, ctrl: bool = false, alt: bool = false) -> Event:
    e = Event(.key, key = .char, text = chr(cp), ctrl = ctrl, alt = alt)
    e.name = __t_name(e)
    e

# (the event with these modifiers added, its name made again)
__t_with = (e0: Event, ctrl: bool = false, alt: bool = false, shift: bool = false) -> Event:
    e = e0
    e.ctrl = e.ctrl or ctrl
    e.alt = e.alt or alt
    if e.key != .char: e.shift = e.shift or shift
    if e.kind == .key: e.name = __t_name(e)
    e

__t_name = (e: Event) -> str:
    base = if e.key == .char: (if e.text == " ": "space" else: e.text) else: "{e.key}"
    pre = ""
    if e.ctrl: pre += "ctrl+"
    if e.alt: pre += "alt+"
    if e.shift and e.key != .char: pre += "shift+"
    pre + base

# ---------------- the terminal's settings, by system ----------------
when TARGET == "windows":
    @lib("kernel32.dll")
    @symbol("SetConsoleMode")
    extern __t_set_console_mode = (h: *u8, mode: u32) -> i32
    @lib("kernel32.dll")
    @symbol("GetConsoleScreenBufferInfo")
    extern __t_buffer_info = (h: *u8, info: *u8) -> i32
else when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("ioctl")
    @variadic(2)
    extern __t_ioctl = (fd: i32, req: u64, p: *u8) -> i32

# (standard input and output are the terminal)
__t_is_terminal = () -> bool:
    when TARGET == "windows":
        m: u32[] = [0]
        return GetConsoleMode(GetStdHandle(u32(0xFFFFFFF6)), data(m)) != 0 and GetConsoleMode(GetStdHandle(u32(0xFFFFFFF5)), data(m)) != 0
    else when TARGET == "macos":
        return __mac_isatty(i32(0)) == 1 and __mac_isatty(i32(1)) == 1
    else when TARGET == "wasm":
        return false
    else:
        t = fill(u8(0), 64)
        return syscall(16, 0, 0x5401, data(t)) == 0 and syscall(16, 1, 0x5401, data(t)) == 0

# (once: the terminal put back as the program ends (before its on_quit, which may print), and on
# a panic, a crash or a second ctrl-c (lib/std/stop.jo); SIGWINCH's handler)
__t_setup = ():
    global __t_once, __t_wake_r, __t_wake_w, __term_reset_fn
    if __t_once: return
    __t_once = true
    __end_fns.insert(0, __t_at_end)
    __term_reset_fn = __t_reset
    when TARGET != "windows" and TARGET != "wasm":
        fds = [0]
        if syscall(293, data(fds), 0x80800) == 0:               # pipe2(O_CLOEXEC | O_NONBLOCK)
            __t_wake_r = fds[0] & 0xFFFFFFFF
            __t_wake_w = fds[0] >> 32
        h: cfn(i32) = __t_on_winch
        act = [h as int, 0x10000000, 0, 0]                      # SA_RESTART
        when TARGET == "linux" and ARCH != "arm64":
            act[1] |= 0x04000000                                # SA_RESTORER
            act[2] = __stop_restorer()
        syscall(13, 28, data(act), 0, 8)                        # rt_sigaction(SIGWINCH)
        # (a second ctrl-c or SIGTERM ends the program in stop.jo's handler, which puts the terminal
        # back, rather than by the system's default)
        hs: cfn(i32) = __stop_signal
        act[0] = hs as int
        syscall(13, 2, data(act), 0, 8)                         # rt_sigaction(SIGINT)
        syscall(13, 15, data(act), 0, 8)                        # rt_sigaction(SIGTERM)

__t_at_end = (): __t_reset()

@cabi
__t_on_winch = (sig: i32):
    global __t_winch
    if __t_winch: return
    __t_winch = true
    if __t_wake_w >= 0:
        one = (1, 0)
        syscall(1, __t_wake_w, &one, 1)

# (what puts the screen back, kept where a signal's handler can write it without allocating)
__t_set_reset = (s: str):
    global __t_reset_n, __t_reset_p
    if __t_reset_p == null: __t_reset_p = __alloc(256)
    n = min(len(s), 256)
    loop i in 0..n: __t_reset_p[i] = s[i]
    __t_reset_n = n

# (the terminal put back: its screen, then its settings. It may run in a signal's handler or as a
# panic is told: it allocates nothing)
__t_reset = ():
    global __t_on
    if not __t_on: return
    __t_on = false
    when TARGET == "windows":
        __w32_write(1, __t_reset_p, __t_reset_n)
        __t_set_console_mode(GetStdHandle(u32(0xFFFFFFF6)), u32(__t_mode_in))
        __t_set_console_mode(GetStdHandle(u32(0xFFFFFFF5)), u32(__t_mode_out))
    else when TARGET == "macos":
        __c_write(1, __t_reset_p as int, __t_reset_n)
        __c_tcsetattr(0, 0, __t_saved)
    else when TARGET != "wasm":
        syscall(1, 1, __t_reset_p, __t_reset_n)
        syscall(16, 0, 0x5402, __t_saved)                      # TCSETS

# (raw mode: keys one at a time as they are typed, not shown; the terminal's settings kept, to put back)
__t_raw = (on: bool, mouse: bool, ctrl_c_key: bool) -> bool:
    global __t_mode_in, __t_mode_out, __t_saved
    when TARGET == "windows":
        hin = GetStdHandle(u32(0xFFFFFFF6))
        hout = GetStdHandle(u32(0xFFFFFFF5))
        m: u32[] = [0]
        if GetConsoleMode(hin, data(m)) == 0: return false
        __t_mode_in = int(m[0])
        GetConsoleMode(hout, data(m))
        __t_mode_out = int(m[0])
        # (window and mouse events, no line editing or echo; ctrl-c the system's unless it is a key;
        # quick edit off while the mouse is the program's)
        mode = 0x8 | 0x80
        if not ctrl_c_key: mode |= 0x1
        if mouse: mode |= 0x10
        else: mode |= __t_mode_in & 0x40
        __t_set_console_mode(hin, u32(mode))
        __t_set_console_mode(hout, u32(__t_mode_out | 0x1 | 0x4))      # VIRTUAL_TERMINAL_PROCESSING
        __w32_utf8_console()
        return true
    else when TARGET == "macos":
        # (macOS's struct termios: four u64 flags, cc[20] at 32, the speeds)
        if __t_saved == null: __t_saved = __alloc(128)
        if __c_tcgetattr(0, __t_saved) != 0: return false
        t = __alloc(128)
        mem_copy(t, __t_saved, 128)
        f = t as *int
        f[0] = f[0] & ~(0x1 | 0x2 | 0x8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x200)     # IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON
        lf = 0x8 | 0x10 | 0x100 | 0x400                                       # ECHO ECHONL ICANON IEXTEN
        if ctrl_c_key: lf |= 0x80                                             # ISIG
        f[3] = f[3] & ~lf
        cc = t + 32
        cc[16] = 1                                                            # VMIN
        cc[17] = 0                                                            # VTIME
        cc[9] = 0xFF                                                          # VQUIT, VSUSP, VDSUSP, VSTATUS: off
        cc[10] = 0xFF
        cc[11] = 0xFF
        cc[18] = 0xFF
        ok = __c_tcsetattr(0, 0, t) == 0
        __free(t)
        return ok
    else when TARGET == "wasm":
        return false
    else:
        # (Linux's struct termios: iflag, oflag, cflag, lflag (u32), line, cc[19])
        if __t_saved == null: __t_saved = __alloc(64)
        if syscall(16, 0, 0x5401, __t_saved) != 0: return false        # TCGETS
        t = fill(u8(0), 64)
        mem_copy(data(t), __t_saved, 64)
        f = data(t) as *u32
        f[0] = f[0] & u32(~(0x1 | 0x2 | 0x8 | 0x20 | 0x40 | 0x80 | 0x100 | 0x400))    # IGNBRK BRKINT PARMRK ISTRIP INLCR IGNCR ICRNL IXON
        lf = 0x8 | 0x40 | 0x2 | 0x8000                                        # ECHO ECHONL ICANON IEXTEN
        if ctrl_c_key: lf |= 0x1                                              # ISIG
        f[3] = f[3] & u32(~lf)
        t[17 + 6] = 1                                                         # VMIN
        t[17 + 5] = 0                                                         # VTIME
        t[17 + 1] = 0                                                         # VQUIT, VSUSP: off (keys)
        t[17 + 10] = 0
        return syscall(16, 0, 0x5402, data(t)) == 0                           # TCSETS

# (the terminal's columns and rows; 80 x 24 when it does not say)
__t_query_size = () -> (int, int):
    global __t_left, __t_top
    when TARGET == "windows":
        info = fill(u8(0), 24)
        if __t_buffer_info(GetStdHandle(u32(0xFFFFFFF5)), data(info)) == 0: return (80, 24)
        s = data(info) as *i16
        __t_left = int(s[5])
        __t_top = int(s[6])
        return (int(s[7]) - int(s[5]) + 1, int(s[8]) - int(s[6]) + 1)
    else when TARGET == "wasm":
        return (80, 24)
    else:
        ws: u16[] = [0, 0, 0, 0]
        r = 0
        when TARGET == "macos":
            r = int(__t_ioctl(1, u64(0x40087468), data(ws) as *u8))
        else:
            r = syscall(16, 1, 0x5413, data(ws))                # TIOCGWINSZ
        if r != 0 or ws[0] == 0 or ws[1] == 0: return (80, 24)
        return (int(ws[1]), int(ws[0]))

# ---------------- Windows's console events ----------------
when TARGET == "windows":
    # (wait for the console's events until deadline (-1: none), made into events; false: none came
    # (the time passed, the task was cancelled, or the program asked to stop))
    __t_w32_wait = (deadline: f64) -> bool:
        hin = GetStdHandle(u32(0xFFFFFFF6))
        loop true:
            n: u32[] = [0]
            GetNumberOfConsoleInputEvents(hin, data(n))
            if n[0] > 0:
                rec = fill(u8(0), 20 * 64)
                got: u32[] = [0]
                if ReadConsoleInputW(hin, data(rec), 64, data(got)) != 0:
                    loop k in 0..int(got[0]):
                        r = data(rec) + k * 20
                        if (r as *u16)[0] != 2 or __t_mouse_on: __t_w32_record(r)
                if __t_events.len() > 0: return true
                continue
            if __stop_asked:
                if __t_told_stop(): return false
            if deadline >= 0.0 and time() >= deadline: return false
            left = if deadline < 0.0: 0.1 else: min(0.1, deadline - time())
            if __tasks_on:
                __task_wait_fn([], [], min(left, 0.01))
                if __task_cancelling: return false
            else: WaitForSingleObject(hin, u32(max(int(left * 1000.0), 1)))
            __t_check_size()
            if __t_events.len() > 0: return true
        false

else:
    __t_w32_wait = (deadline: f64) -> bool: false

# (a Windows console's INPUT_RECORD made into events: its kind, then a key's, the mouse's or a
# resize's fields. Plain bytes, so that a test on any system can give it some)
__t_w32_record = (r: *u8):
    global __t_buttons, __t_high
    kind = int((r as *u16)[0])
    if kind == 1:
        down = ((r + 4) as *i32)[0] != 0
        repeat = max(int(((r + 8) as *u16)[0]), 1)
        vk = int(((r + 10) as *u16)[0])
        ch = int(((r + 14) as *u16)[0])
        st = int(((r + 16) as *u32)[0])
        # (a character made with alt and the number pad comes as alt is let go)
        if not down and not (vk == 0x12 and ch != 0): return
        ctrl = st & 0xC != 0
        alt = st & 0x3 != 0
        shift = st & 0x10 != 0
        if ch >= 32 and st & 0x1 != 0 and st & 0x8 != 0:
            # (AltGr: right alt and left ctrl together type a character)
            ctrl = false
            alt = false
        key = match vk:
            0x08: Key.backspace
            0x09: Key.tab
            0x0D: Key.enter
            0x1B: Key.escape
            0x21: Key.page_up
            0x22: Key.page_down
            0x23: Key.end
            0x24: Key.home
            0x25: Key.left
            0x26: Key.up
            0x27: Key.right
            0x28: Key.down
            0x2D: Key.insert
            0x2E: Key.delete
            [0x70..0x7B]: Key(int(Key.f1) + vk - 0x70)
            _: Key.char
        e: Event? = none
        if not down: e = __t_char(ch)
        else if key != .char: e = __t_key(key, ctrl = ctrl, alt = alt, shift = shift)
        else if vk == 0x10 or vk == 0x11 or vk == 0x12 or vk == 0x14 or vk == 0x5B or vk == 0x5C: return
        else if ch >= 0xD800 and ch < 0xDC00:
            __t_high = ch
            return
        else if ch >= 0xDC00 and ch < 0xE000:
            if __t_high == 0: return
            e = __t_char(0x10000 + ((__t_high - 0xD800) << 10) + (ch - 0xDC00), ctrl = ctrl, alt = alt)
            __t_high = 0
        else if ctrl and vk >= c'A' and vk <= c'Z': e = __t_char(vk - c'A' + c'a', ctrl = true, alt = alt)
        else if ch >= 32: e = __t_char(ch, ctrl = ctrl, alt = alt)
        else if ctrl and vk == 0x20: e = __t_char(32, ctrl = true, alt = alt)
        else if ch > 0: e = (__t_parse([u8(ch)], 0, true)).0
        else if ctrl and vk >= c'0' and vk <= c'9': e = __t_char(vk, ctrl = true, alt = alt)
        if let x = e:
            loop _ in 0..repeat: __t_events.push(x)
    else if kind == 2:
        x = int(((r + 4) as *i16)[0]) - __t_left
        y = int(((r + 6) as *i16)[0]) - __t_top
        bs = int(((r + 8) as *u32)[0])
        st = int(((r + 12) as *u32)[0])
        fl = int(((r + 16) as *u32)[0])
        e = Event(.mouse, x = x, y = y, ctrl = st & 0xC != 0, alt = st & 0x3 != 0, shift = st & 0x10 != 0)
        if fl & 4 != 0 or fl & 8 != 0:
            up = (bs >> 16) & 0xFFFF < 0x8000
            if fl & 4 != 0: e.mouse = if up: .wheel_up else: .wheel_down
            else: e.mouse = if up: .wheel_right else: .wheel_left
            __t_events.push(e)
            return
        held = bs & 7
        if fl & 1 != 0:
            if held == 0 and not __t_mouse_moves: return
            e.mouse = if held == 0: .move else: .drag
            e.button = __t_w32_button(held)
            __t_events.push(e)
            return
        # (presses and releases: the buttons that changed)
        loop bit in [1, 4, 2]:
            if held & bit != 0 and __t_buttons & bit == 0:
                e.mouse = .press
                e.button = __t_w32_button(bit)
                __t_events.push(e)
            else if held & bit == 0 and __t_buttons & bit != 0:
                e.mouse = .release
                e.button = __t_w32_button(bit)
                __t_events.push(e)
        __t_buttons = held
    else if kind == 4:
        __t_check_size()

# (the console's button bits: 1 the left, 2 the right, 4 the middle)
__t_w32_button = (bits: int) -> int:
    if bits & 1 != 0: return 1
    if bits & 4 != 0: return 2
    if bits & 2 != 0: return 3
    0
