    # A warm-up vertex skips all user code and is clipped. Normal draws retain the original
    # wrapper, selected by their nonnegative vertex stride. No uniforms or buffers are read.
    __vg_warm_vertex = (code: str) -> str:
        w = data(code) as *u32
        n = len(code) / 4
        if n < 5 or len(code) % 4 != 0 or w[0] != u32(0x07230203): return code
        main = 0
        pos = 0
        ints = 0
        floats = 0
        bools = 0
        vector = 0
        pushptr = 0
        push = 0
        push_type = 0
        i = 5
        loop i < n:
            op = int(w[i] & u32(65535))
            count = int(w[i] >> 16)
            if count <= 0 or i + count > n: return code
            if op == 15 and w[i + 1] == u32(0): main = int(w[i + 2])
            if op == 71 and count == 4 and w[i + 2] == u32(11) and w[i + 3] == u32(0): pos = int(w[i + 1])
            if op == 21 and w[i + 2] == u32(32) and w[i + 3] == u32(1): ints = int(w[i + 1])
            if op == 22 and w[i + 2] == u32(32): floats = int(w[i + 1])
