# The GPU through Vulkan 1.3, in the style of mr_gpu (codeberg.org/games-by-Mason/mr_gpu): one
# device with dynamic rendering, synchronization2, buffer device addresses and one bindless array
# of every texture; a few large memory blocks; a frame's data written into a per-frame upload
# buffer and found by its address. Each frame is drawn into an image of its own ("the screen"),
# then copied, turned over, into the window's swapchain image: so the screen, like a texture
# drawn into, has OpenGL's rows (row 0 at the bottom), and shaders need no special case for it.
#
# The library draws through it when SLOPPY_VULKAN=1 (OpenGL stays for the web, and wherever
# Vulkan 1.3 is missing). SLOPPY_VK_VALIDATE=1 asks for the Khronos validation layer.

when TARGET != "wasm":
    # ---------------- the functions (the loader exports them all) ----------------
    @lib("libvulkan.so.1")
    extern vkGetInstanceProcAddr = (inst: *u8, name: *u8) -> *u8
    @lib("libvulkan.so.1")
    extern vkEnumerateInstanceExtensionProperties = (layer: *u8, count: *u32, props: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkEnumerateInstanceLayerProperties = (count: *u32, props: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateInstance = (info: *u8, alloc: *u8, out: **u8) -> i32
    @lib("libvulkan.so.1")
    extern vkEnumeratePhysicalDevices = (inst: *u8, count: *u32, out: **u8) -> i32
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceProperties = (pd: *u8, props: *u8)
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceFeatures2 = (pd: *u8, features: *u8)
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceQueueFamilyProperties = (pd: *u8, count: *u32, props: *u8)
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceMemoryProperties = (pd: *u8, props: *u8)
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceFormatProperties = (pd: *u8, format: u32, props: *u8)
    @lib("libvulkan.so.1")
    extern vkEnumerateDeviceExtensionProperties = (pd: *u8, layer: *u8, count: *u32, props: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateDevice = (pd: *u8, info: *u8, alloc: *u8, out: **u8) -> i32
    @lib("libvulkan.so.1")
    extern vkGetDeviceQueue = (dev: *u8, family: u32, index: u32, out: **u8)
    @lib("libvulkan.so.1")
    extern vkDeviceWaitIdle = (dev: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceSurfaceSupportKHR = (pd: *u8, family: u32, surface: int, out: *u32) -> i32
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceSurfaceCapabilitiesKHR = (pd: *u8, surface: int, caps: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceSurfaceFormatsKHR = (pd: *u8, surface: int, count: *u32, formats: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkGetPhysicalDeviceSurfacePresentModesKHR = (pd: *u8, surface: int, count: *u32, modes: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateXlibSurfaceKHR = (inst: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateWaylandSurfaceKHR = (inst: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateWin32SurfaceKHR = (inst: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateSwapchainKHR = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroySwapchainKHR = (dev: *u8, sc: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkGetSwapchainImagesKHR = (dev: *u8, sc: int, count: *u32, images: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkAcquireNextImageKHR = (dev: *u8, sc: int, timeout: u64, sem: int, fence: int, index: *u32) -> i32
    @lib("libvulkan.so.1")
    extern vkQueuePresentKHR = (queue: *u8, info: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkAllocateMemory = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkFreeMemory = (dev: *u8, mem: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkMapMemory = (dev: *u8, mem: int, off: u64, size: u64, flags: u32, out: **u8) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateBuffer = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroyBuffer = (dev: *u8, b: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkGetBufferMemoryRequirements = (dev: *u8, b: int, req: *u8)
    @lib("libvulkan.so.1")
    extern vkBindBufferMemory = (dev: *u8, b: int, mem: int, off: u64) -> i32
    @lib("libvulkan.so.1")
    extern vkGetBufferDeviceAddress = (dev: *u8, info: *u8) -> u64
    @lib("libvulkan.so.1")
    extern vkCreateImage = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroyImage = (dev: *u8, img: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkGetImageMemoryRequirements = (dev: *u8, img: int, req: *u8)
    @lib("libvulkan.so.1")
    extern vkBindImageMemory = (dev: *u8, img: int, mem: int, off: u64) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateImageView = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroyImageView = (dev: *u8, v: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkCreateSampler = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateDescriptorSetLayout = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateDescriptorPool = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkAllocateDescriptorSets = (dev: *u8, info: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkUpdateDescriptorSets = (dev: *u8, nwrites: u32, writes: *u8, ncopies: u32, copies: *u8)
    @lib("libvulkan.so.1")
    extern vkCreatePipelineLayout = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateShaderModule = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroyShaderModule = (dev: *u8, m: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkCreateGraphicsPipelines = (dev: *u8, cache: int, n: u32, infos: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateFence = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkWaitForFences = (dev: *u8, n: u32, fences: *int, all: u32, timeout: u64) -> i32
    @lib("libvulkan.so.1")
    extern vkResetFences = (dev: *u8, n: u32, fences: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkCreateSemaphore = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkDestroySemaphore = (dev: *u8, s: int, alloc: *u8)
    @lib("libvulkan.so.1")
    extern vkCreateCommandPool = (dev: *u8, info: *u8, alloc: *u8, out: *int) -> i32
    @lib("libvulkan.so.1")
    extern vkResetCommandPool = (dev: *u8, pool: int, flags: u32) -> i32
    @lib("libvulkan.so.1")
    extern vkAllocateCommandBuffers = (dev: *u8, info: *u8, out: **u8) -> i32
    @lib("libvulkan.so.1")
    extern vkBeginCommandBuffer = (cb: *u8, info: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkEndCommandBuffer = (cb: *u8) -> i32
    @lib("libvulkan.so.1")
    extern vkQueueSubmit2 = (queue: *u8, n: u32, submits: *u8, fence: int) -> i32
    @lib("libvulkan.so.1")
    extern vkCmdPipelineBarrier2 = (cb: *u8, dep: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdBeginRendering = (cb: *u8, info: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdEndRendering = (cb: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdBlitImage2 = (cb: *u8, info: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdCopyBufferToImage = (cb: *u8, buf: int, img: int, layout: u32, n: u32, regions: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdCopyImageToBuffer = (cb: *u8, img: int, layout: u32, buf: int, n: u32, regions: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdClearAttachments = (cb: *u8, n: u32, atts: *u8, nrects: u32, rects: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdSetViewport = (cb: *u8, first: u32, n: u32, vps: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdSetScissor = (cb: *u8, first: u32, n: u32, rects: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdBindPipeline = (cb: *u8, point: u32, p: int)
    @lib("libvulkan.so.1")
    extern vkCmdBindDescriptorSets = (cb: *u8, point: u32, layout: int, first: u32, n: u32, sets: *int, ndyn: u32, dyn: *u32)
    @lib("libvulkan.so.1")
    extern vkCmdPushConstants = (cb: *u8, layout: int, stages: u32, off: u32, size: u32, values: *u8)
    @lib("libvulkan.so.1")
    extern vkCmdDraw = (cb: *u8, nverts: u32, ninst: u32, first_vert: u32, first_inst: u32)
    @lib("libvulkan.so.1")
    extern vkCmdDrawIndexed = (cb: *u8, nidx: u32, ninst: u32, first_idx: u32, vert_off: i32, first_inst: u32)
    @lib("libvulkan.so.1")
    extern vkCmdBindIndexBuffer = (cb: *u8, buf: int, off: u64, ty: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetCullMode = (cb: *u8, mode: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetFrontFace = (cb: *u8, face: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetPrimitiveTopology = (cb: *u8, topo: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetDepthTestEnable = (cb: *u8, on: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetDepthWriteEnable = (cb: *u8, on: u32)
    @lib("libvulkan.so.1")
    extern vkCmdSetDepthCompareOp = (cb: *u8, op: u32)
    @lib("libvulkan.so.1")
    extern vkCmdCopyBuffer = (cb: *u8, src: int, dst: int, n: u32, regions: *u8)
    @lib("libvulkan.so.1")
