# GPU programs written in Sloppy: meshes, shaders and uniform binding.
#
#   struct Vertex: pos: vec3; color: vec4          # vertex attributes
#   struct Params: mvp: mat4                        # uniforms
#   struct Out:    pos: vec4; color: vec4           # first field is the clip position
#   vs = (v: Vertex, u: Params) -> Out: Out(u.mvp * vec4(v.pos, 1), v.color)
#   fs = (i: Out, u: Params) -> vec4: i.color
#   prog = make_shader(shader(vs, fs))
#   m = mesh(vertices)
#   draw(prog, m, Params(mvp))
# Uniform fields are numbers, vectors, mat4 and Texture, or fixed-size arrays of them
# (`bones: mat4[64]`, `lights: vec4[8]`), and GPU buffers (gpubuffer.jo: `u.particles[i]`).
# Shader code can use fixed-size arrays, `loop` over them, and sample(), sample_lod(), texel(),
# texture_size(), discard() and set_depth() (fragment) and vertex_id(), instance_id() (vertex).

# produced by the compiler from shader(vs, fs)
struct ShaderSource:
    vs: str
    fs: str
    layout: str
    cpu_vs: *u8           # the shader functions, for the software renderer
    cpu_fs: *u8
    out_size: int         # bytes of the vertex function's result
    vs_args: int          # 2: vs(vertex, uniforms), 3: vs(vertex, instance, uniforms)
    flat: str             # per 4 bytes of that result: 'f' interpolated, 'i' passed on unchanged
    vs_spirv: str         # the stages as SPIR-V, for Vulkan (compiler/spirv.jo; "" on the web)
    fs_spirv: str
    where: str            # the stages' functions and where they are in the source, for error
                          # reports ("vertex: vs at src/main.jo:12:1\nfragment: ..."; the GLSL
                          # text leaves them out, so that it stays the same when code moves)
    outputs: int          # the fragment function's colors: 0 for a vec4, else a struct's fields
                          # (1 to 4), one for each color of a render target (colors = n)

struct ShaderAttrib:
    comps: int
    offset: int

struct ShaderUniform:
    loc: int              # (OpenGL; from make_shader: where the library keeps its location)
    kind: u8
    offset: int
    count: int            # an array (T[N] field): N, and the bytes per element
    stride: int
    loc2: int = -1        # a GPU buffer: its length's location (loc: its texture's)

struct Shader:
    prog: int
    stride: int
    attribs: ShaderAttrib[]
    uniforms: ShaderUniform[]
    usize: int
    istride: int
    iattribs: ShaderAttrib[]
    ibase_loc: int = -1   # (OpenGL) where instance_id() starts: see draw_indirect (as loc)
    lid: int              # (OpenGL) this shader's number (0: one made by hand, never matched;
                          # its locations are OpenGL's own)
    ucache: *u8 = null    # (OpenGL) the uniform bytes last uploaded to its program
    outputs: int          # the colors its fragment function writes past one (0: a vec4; else a
                          # struct's fields: render_target's colors)

struct Mesh:
    vao: int
    vbo: int
    ibo: int
    count: int
    index_count: int
    stride: int
    mode: int
    instances: int
    center: vec3                # a sphere around the vertices (radius < 0: not known), for
    radius: f32 = -1.0          # leaving out what the camera cannot see (draw3d.jo)
    gbuf: int                   # the vertices are a GPU buffer's (gpu_mesh): its number
    keep: u8[]                  # (and what keeps that buffer alive)

# Feature loading callbacks contain no central list of shader functions. Only a feature
# the program uses registers a callback, and each shader is translated at one call site.
__gfx_loaders: (() -> void)[]
__gfx_loaded = false
__gfx_on_load = (load: () -> void):
    when TARGET != "wasm" and TARGET != "macos":
        __gfx_loaders.push(load)
        if __gfx_loaded: load()

__warm_layout_kind = (kind: int) -> int:
    if kind == 12 or kind == 13: return 32
    if kind == 14 or kind == 15: return 64
    if kind == 16 or kind == 17: return 128
    if kind == 8 or kind == 9: return 2
    if kind == 10 or kind == 11: return 4
    if kind == 4 or kind == 5: return 8
    if kind == 6: return 16
    if kind == 2 or kind == 3 or kind == 7: return 1
    0

# Prepare what is loaded, during a loading screen: OpenGL and WebGL link every shader queued and not
# linked yet (warm_up_shaders()); Vulkan prepares the pipelines of the programs and layouts loaded.
warm_up = ():
    warm_up_shaders()
    when TARGET != "wasm" and TARGET != "macos":
        if __vk and not __soft:
            __gfx_warm_context()
            __vg_warm_loaded()

# Prepare one shader now: OpenGL and WebGL link it (one made with warm = false too); Vulkan
# prepares its pipeline for the drawing state selected now (blend, color_write, depth_test,
# depth_write, the target) and primitive `mode`.
warm_up = (sh: Shader, mode: int = GL_TRIANGLES):
    if sh.lid > 0 and sh.lid < __glp_state.len() and __glp_state[sh.lid] != 0: __glp_link(sh.lid)
    when TARGET != "wasm" and TARGET != "macos":
        if __vk and not __soft: __vg_warm_selected(sh.prog, __vg_topology(mode))

# Linking shaders when they are first drawn (OpenGL, WebGL): make_shader (and the library's own
# shaders) return at once; the program is compiled and linked at its first draw, which waits for
# it. Linking takes tens of milliseconds a program on a phone, and a game makes many before its
# first frame, most of them not needed for its title screen. warm_up_shaders links the waiting
# ones, a few at a time during frames that hide it (a loading screen, a fade) or all at once.
# Where the browser or driver has KHR_parallel_shader_compile, each program's compiling and
# linking starts when it is made and goes on beside the game; warm_up_shaders then only finishes
# the programs it says are done. Vulkan, Metal and the software renderer make their programs at
# once: nothing waits there.
# A shader made with make_shader(src, warm = false) waits for no warm-up: it is linked at its first
# draw or by warm_up(sh), or queued later with warm_up_later(sh). The library's own 3D shaders are
# queued only while their feature is on (shadows, the gradient sky, instanced or skinned meshes,
# PBR materials), and one the game replaced is not queued. Making a shader from the same source
# again gives the program made before, linked once.

# how many shaders are queued for warm-up and not linked yet (0 on Vulkan, Metal and the software
# renderer)
shaders_pending = () -> int:
    __warm_hook_run()
    __glp_waiting

# Queue a shader made with warm = false for warm_up_shaders (with parallel compiling, its linking
# starts now); one queued or linked already stays as it is.
warm_up_later = (sh: Shader):
    if sh.lid > 0 and sh.lid < __glp_state.len(): __glp_queue(sh.lid)

# Link queued shaders, oldest first: at most max_count of them (-1: no limit), starting no new
# one after max_ms milliseconds (-1: no limit; at least one is linked). With no limit, all of
# them (warm_up() does that too). Returns how many are still waiting. With parallel compiling, a
# limited call finishes only the programs whose linking is done, never waiting for one.
warm_up_shaders = (max_count: int = -1, max_ms: f64 = -1.0) -> int:
    global __glp_first
    __warm_hook_run()
    if __glp_waiting == 0 or max_count == 0: return __glp_waiting
    drain = max_count < 0 and max_ms < 0.0
    t0 = time()
    done = 0
    i = __glp_first
    loop i < __glp_state.len() and __glp_waiting > 0 and (max_count < 0 or done < max_count):
        st = __glp_state[i]
        if st == 0 or st == 3:
            if i == __glp_first: __glp_first = i + 1
            i += 1
            continue
        if st == 2 and not drain and not __gl_program_done(__glp[i].prog):
            i += 1
            continue
        if done > 0 and max_ms >= 0.0 and (time() - t0) * 1000.0 >= max_ms: break
        __glp_link(i)
        done += 1
        if i == __glp_first: __glp_first = i + 1
        i += 1
    __glp_waiting

# (a shader made through OpenGL or WebGL: what linking it needs, until it is linked)
struct __GlProg:
    prog: int
    stages: int           # (started: __gl_program_start's result)
    vs: str
    fs: str
    where: str            # (ShaderSource.where)
    names: str[]          # its uniforms' names, by location from `slot` in __gl_loc
    slot: int
__glp: __GlProg[]         # by Shader.lid (entry 0: none)
__glp_state: u8[]         # by Shader.lid: 0 linked (or not OpenGL), 1 waiting, 2 started (parallel),
                          # 3 not queued (warm = false: linked at its first draw or by warm_up(sh))
__glp_first = 1           # (none waits before this one)
__glp_waiting = 0         # (in states 1 and 2)
__gl_loc: int[]           # the shaders' uniform locations (-1 until linked, or not used)
__glp_key: u64[]          # by Shader.lid: its source's hash (__shader_key), and the shader made
__glp_sh: Shader[]

# (__warm_hook, draw2d.jo: what queues the library's shaders whose feature is on)
__warm_hook_run = ():
    if __win_open and __gl_lazy(): __warm_hook()

# OpenGL or WebGL: shaders are linked when drawn or warmed up
__gl_lazy = () -> bool:
    when TARGET == "wasm": return true
    else: return not __vk and not __soft

# compile and link the program of shader `id` (waiting for it if started), and find its uniforms
__glp_link = (id: int):
    global __glp_waiting
    g = __glp[id]
    stages = g.stages
    st = __glp_state[id]
    if st != 2: stages = __gl_program_start(g.prog, g.vs, g.fs)
    __gl_program_finish(g.prog, stages, g.vs, g.fs, g.where)
    loop i in 0.. and n in g.names: __gl_loc[g.slot + i] = gl_uniform_location(g.prog, n)
    __glp_state[id] = 0
    __glp[id] = __GlProg(prog = g.prog)
    if st != 3: __glp_waiting -= 1

# put shader `id`, made with warm = false, on the warm-up queue (with parallel compiling: started)
__glp_queue = (id: int):
    global __glp_first, __glp_waiting
    if __glp_state[id] != 3: return
    st = u8(1)
    if __gl_parallel():
        __glp[id].stages = __gl_program_start(__glp[id].prog, __glp[id].vs, __glp[id].fs)
        st = 2
    __glp_state[id] = st
    __glp_waiting += 1
    if id < __glp_first: __glp_first = id

# a shader's source as a number: the same source (stages and layout) gives the same program
__shader_key = (src: ShaderSource) -> u64:
    h = hash(src.vs)
    h = (h xor hash(src.fs)) * 1099511628211
    h = (h xor hash(src.layout)) * 1099511628211
    h xor u64(len(src.vs) * 65599 + len(src.fs))

# a uniform of a shader being made: its location now, or (lazy) where __gl_loc will hold it
__shader_loc = (prog: int, lazy: bool, names: mut str[], name: str) -> int:
    if not lazy: return gl_uniform_location(prog, name)
    names.push(name)
    __gl_loc.len() + names.len() - 1

# a shader from shader(vs, fs); on OpenGL and WebGL its program is linked at its first draw (or by
# warm_up_shaders, unless warm is false), and compile or link errors are reported there. Made
# again from the same source, it is the program made before.
make_shader = (src: ShaderSource, warm: bool = true) -> Shader:
    sh = __make_shader(src, 0, warm)
    when TARGET != "wasm" and TARGET != "macos":
        if __vk and not __soft: __vg_custom_prepare(sh.prog, sh.stride)
    sh

# (warm false: not queued for warm_up_shaders; the library's 3D shaders are queued by their feature)
__make_shader = (src: ShaderSource, warm_kind: int, warm: bool = true) -> Shader:
    global __glp_waiting
    __gfx_init_gl_only()
    prog = 0
    lazy = false
    when TARGET != "wasm":
        if __vk:
            when TARGET != "macos": prog = __vk_program(src, warm_kind, warm_kind != 0)
            else: prog = __vk_program(src)
        else if __soft: prog = gl_create_program(src.vs, src.fs)
        else: lazy = true
    else: lazy = true
    key: u64 = 0
    if lazy:
        # (the same source made before: its program, linked once)
        key = __shader_key(src)
        loop i in [1..__glp_key.len()):
            if __glp_key[i] == key:
                if warm: __glp_queue(i)
                return __glp_sh[i]
    # (OpenGL: the program made now, linked at its first draw or by warm_up_shaders)
    if lazy: prog = __gl_program_new()
    sh = Shader(prog = prog, outputs = src.outputs)
    names: str[] = []
    halves = split(src.layout, "|")
    loop part in split(halves[0], ";"):
        if starts_with(part, "A"):
            sh.stride = to_int(part[1..]) ?? 0
            continue
        f = split(part, ",")
        sh.attribs.push(ShaderAttrib(to_int(f[1]) ?? 0, to_int(f[2]) ?? 0))
    if halves.len() > 2:
        loop part in split(halves[2], ";"):
            if starts_with(part, "I"):
                sh.istride = to_int(part[1..]) ?? 0
                continue
            f = split(part, ",")
            sh.iattribs.push(ShaderAttrib(to_int(f[1]) ?? 0, to_int(f[2]) ?? 0))
    loop part in split(halves[1], ";"):
        if starts_with(part, "U"):
            sh.usize = to_int(part[1..]) ?? 0
            continue
        f = split(part, ",")
        kind = f[1][0]
        if kind == 'v': kind = f[1][1]
        if kind == 'B':
            loc = __shader_loc(prog, lazy, names, "u.{f[0]}_t_")
            sh.uniforms.push(ShaderUniform(loc, kind, to_int(f[2]) ?? 0, loc2 = __shader_loc(prog, lazy, names, "u.{f[0]}_n_")))
        else if f.len() > 3:
            loc = __shader_loc(prog, lazy, names, "u.{f[0]}_[0]")
            sh.uniforms.push(ShaderUniform(loc, kind, to_int(f[2]) ?? 0, to_int(f[3]) ?? 0, to_int(f[4]) ?? 0))
        else: sh.uniforms.push(ShaderUniform(__shader_loc(prog, lazy, names, "u.{f[0]}_"), kind, to_int(f[2]) ?? 0))
    sh.ibase_loc = __shader_loc(prog, lazy, names, "sl_ibase")
    if __soft: __sw_program_info(prog, src)
    else:
        if __glp.len() == 0:
            __glp.push(__GlProg())
            __glp_state.push(0)
            __glp_key.push(0)
            __glp_sh.push(Shader())
        sh.lid = __glp.len()
        # (a program's uniforms start at zero: so does what we remember of them)
        n = 0
        loop u in sh.uniforms: n = max(n, u.offset + __uniform_bytes(u))
        sh.ucache = __alloc(max(n, 8))
        if lazy:
            g = __GlProg(prog = prog, vs = src.vs, fs = src.fs, where = src.where, names = names, slot = __gl_loc.len())
            loop _ in names: __gl_loc.push(-1)
            st = u8(3)
            if warm:
                st = 1
                if __gl_parallel():
                    g.stages = __gl_program_start(prog, src.vs, src.fs)
                    st = 2
                __glp_waiting += 1
            __glp.push(g)
            __glp_state.push(st)
        else:
            __glp.push(__GlProg())
            __glp_state.push(0)
        __glp_key.push(key)
        __glp_sh.push(sh)
    sh

# the bytes of the uniforms struct a uniform is set from
__uniform_bytes = (u: ShaderUniform) -> int:
    if u.count > 0: return u.count * u.stride
    k = u.kind
    if k == 'b': return 1
    if k == 'f': return 4
    if k == '3': return 12
    if k == '4': return 16
    if k == 'm': return 64
    8

# upload vertices (any struct type matching the shader's vertex input) and optional indices
mesh[V] = (vertices: V[], indices: u32[] = [], mode: int = GL_TRIANGLES) -> Mesh:
    __gfx_init_gl_only()
    m = Mesh(mode = mode)
    m.vao = gl_create_vertex_array()
    glBindVertexArray(u32(m.vao))
    m.vbo = gl_create_buffer()
    glBindBuffer(GL_ARRAY_BUFFER, u32(m.vbo))
    m.stride = size_of(V)
    glBufferData(GL_ARRAY_BUFFER, vertices.len() * m.stride, data(vertices) as *u8, GL_STATIC_DRAW)
    m.count = vertices.len()
    if indices.len() > 0:
        m.ibo = gl_create_buffer()
        glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, u32(m.ibo))
        glBufferData(GL_ELEMENT_ARRAY_BUFFER, indices.len() * 4, data(indices) as *u8, GL_STATIC_DRAW)
        m.index_count = indices.len()
    glBindVertexArray(0)
    __mesh_layout_load(size_of(V), false)
    m

update_mesh[V] = (m: mut Mesh, vertices: V[]):
    glBindBuffer(GL_ARRAY_BUFFER, u32(m.vbo))
    glBufferData(GL_ARRAY_BUFFER, vertices.len() * m.stride, data(vertices) as *u8, GL_DYNAMIC_DRAW)
    m.count = vertices.len()

# A mesh's vertex arrays: up to four, each set up for one shader and buffers (the first is the
# mesh's own). Their attributes (and index buffer) are their own state, so a draw with a shader and
# buffers one was set up for binds it and sets nothing again, or re-points only the attributes
# whose offset moved (the vertices' base, the instances' first): a mesh drawn by the shadow pass's
# shader and then the lit one, or a batch at a time from one instance buffer, sets up nothing per
# draw. (On a phone these calls were a seventh of a game's frame.)
struct __VaoState:
    gl: int               # the vertex array (0: not made yet)
    epoch: int
    lid: int
    vbo: int
    stride: int
    ivbo: int
    ibo: int
    base: int
    ioff: int
    on: int               # attribute arrays enabled (0 ..< on)
    used: int             # (when it was last bound: the least recent is set up again)
__vaos: __VaoState[] = []
__vao_clock = 0

# bind mesh m's vertex array for shader sh: its vertices from vertex `base`, and the instance
# attributes from buffer ivbo at byte ioff (ivbo 0: none)
__bind_attribs = (sh: Shader, m: Mesh, base: int = 0, ivbo: int = 0, ioff: int = 0):
    global __vao_clock
    __vao_clock += 1
    v = m.vao * 4
    loop __vaos.len() < v + 4: __vaos.push(__VaoState())
    k = -1
    if sh.lid != 0:
        j = 0
        loop k < 0 and j < 4:
            st = __vaos[v + j]
            if st.gl != 0 and st.epoch == __gl_epoch and st.lid == sh.lid and st.vbo == m.vbo and st.stride == m.stride and (st.ivbo > 0) == (ivbo > 0) and st.ibo == m.ibo: k = j
            j += 1
    if k >= 0:
        st = __vaos[v + k]
        glBindVertexArray(u32(st.gl))
        if st.base != base:
            glBindBuffer(GL_ARRAY_BUFFER, u32(m.vbo))
            loop i in 0.. and a in sh.attribs: glVertexAttribPointer(u32(i), i32(a.comps), GL_FLOAT, 0, i32(m.stride), a.offset + base * m.stride)
            st.base = base
        # (another instance buffer, or another place in it: only its attributes re-pointed, the
        # arrays enabled and their divisors set stay as they are)
        if (st.ivbo != ivbo or st.ioff != ioff) and ivbo > 0:
            glBindBuffer(GL_ARRAY_BUFFER, u32(ivbo))
            n = sh.attribs.len()
            loop i in 0.. and a in sh.iattribs: glVertexAttribPointer(u32(n + i), i32(a.comps), GL_FLOAT, 0, i32(sh.istride), a.offset + ioff)
            st.ivbo = ivbo
            st.ioff = ioff
        st.used = __vao_clock
        __vaos[v + k] = st
        return
    # (set one up: one not made yet, else the least recently bound)
    k = 0
    loop j in [1..4):
        if __vaos[v + k].gl != 0 and (__vaos[v + j].gl == 0 or __vaos[v + j].used < __vaos[v + k].used): k = j
    st = __vaos[v + k]
    if st.gl == 0: st.gl = if k == 0: m.vao else: gl_create_vertex_array()
    glBindVertexArray(u32(st.gl))
    glBindBuffer(GL_ARRAY_BUFFER, u32(m.vbo))
    loop i in 0.. and a in sh.attribs:
        glEnableVertexAttribArray(u32(i))
        glVertexAttribPointer(u32(i), i32(a.comps), GL_FLOAT, 0, i32(m.stride), a.offset + base * m.stride)
        glVertexAttribDivisor(u32(i), 0)
    on = sh.attribs.len()
    if ivbo > 0:
        glBindBuffer(GL_ARRAY_BUFFER, u32(ivbo))
        loop i in 0.. and a in sh.iattribs:
            loc = u32(on + i)
            glEnableVertexAttribArray(loc)
            glVertexAttribPointer(loc, i32(a.comps), GL_FLOAT, 0, i32(sh.istride), a.offset + ioff)
            glVertexAttribDivisor(loc, 1)
        on += sh.iattribs.len()
    loop j in [on..st.on):
        glVertexAttribDivisor(u32(j), 0)
        glDisableVertexAttribArray(u32(j))
    if m.ibo > 0: glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, u32(m.ibo))
    __vaos[v + k] = __VaoState(st.gl, __gl_epoch, sh.lid, m.vbo, m.stride, ivbo, m.ibo, base, ioff, on, __vao_clock)

# The GL texture a shader samples for Texture id: no texture (0) is a white texel, as on Vulkan,
# Metal and the software renderer. (GL's texture 0 is incomplete: it samples black, or 0 with a
# warning from Apple's driver, "unit 0 GLD_TEXTURE_INDEX_2D is unloadable".) Called with the
# unit it is bound to active.
__gl_white = 0
__gl_sampled = (id: int) -> u32:
    global __gl_white
    if id != 0: return u32(id)
    when TARGET != "wasm":
        if __vk or __soft: return 0
    if __gl_white == 0:
        __gl_white = gl_create_texture()
        glBindTexture(GL_TEXTURE_2D, u32(__gl_white))
        white: u8[] = [255, 255, 255, 255]
        gl_tex_image(1, 1, GL_RGBA, GL_RGBA, GL_UNSIGNED_BYTE, data(white), 4)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, i32(GL_NEAREST))
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, i32(GL_NEAREST))
    u32(__gl_white)

# (a uniform whose bytes are those last uploaded to the program is not uploaded again: most draws
# share their frame's and camera's. Textures and buffers are bound each time: units are shared.)
__bind_uniforms = (sh: Shader, p: *u8):
    unit = 0
    c = sh.ucache
    lazy = sh.lid != 0
    loop u in sh.uniforms:
        l = u.loc
        if lazy: l = __gl_loc[l]
        if l < 0: continue
        q = p + u.offset
        loc = i32(l)
        k = u.kind
        f = q as *f32
        if c != null and k != 't' and k != 'B':
            n = __uniform_bytes(u)
            if __mem_eq(c + u.offset, q, n): continue
            mem_copy(c + u.offset, q, n)
        if u.count > 0:
            unit = __bind_uniform_array(u, loc, q, unit)
            continue
        if k == 'f': glUniform1f(loc, f[0])
        else if k == 'd': glUniform1f(loc, f32((q as *f64)[0]))
        else if k == 'i': glUniform1i(loc, i32((q as *int)[0]))
        else if k == 'b': glUniform1i(loc, i32(q[0]))
        else if k == '2': glUniform2f(loc, f[0], f[1])
        else if k == '3': glUniform3f(loc, f[0], f[1], f[2])
        else if k == '4': glUniform4f(loc, f[0], f[1], f[2], f[3])
        else if k == 'm': glUniformMatrix4fv(loc, 1, 0, q)
        else if k == 'I': glUniform2iv(loc, 1, q)
        else if k == 'B':
            l2 = u.loc2
            if lazy: l2 = __gl_loc[l2]
            unit = __gb_bind_gl(q, loc, l2, unit)
        else if k == 't':
            glActiveTexture(GL_TEXTURE0 + u32(unit))
            glBindTexture(GL_TEXTURE_2D, __gl_sampled((q as *int)[0]))
            glUniform1i(loc, i32(unit))
            unit += 1

# a uniform array (a T[N] field): returns the next free texture unit
__bind_uniform_array = (u: ShaderUniform, loc: i32, q: *u8, unit0: int) -> int:
    n = i32(u.count)
    k = u.kind
    unit = unit0
    if k == 'f': glUniform1fv(loc, n, q)
    else if k == '2': glUniform2fv(loc, n, q)
    else if k == '3': glUniform3fv(loc, n, q)
    else if k == '4': glUniform4fv(loc, n, q)
    else if k == 'm': glUniformMatrix4fv(loc, n, 0, q)
    else if k == 'I': glUniform2iv(loc, n, q)
    else if k == 'd':
        fs = fill(f32(0), u.count)
        loop j in [0..u.count): fs[j] = f32(((q + j * u.stride) as *f64)[0])
        glUniform1fv(loc, n, data(fs) as *u8)
    else if k == 'i' or k == 'b' or k == 't':
        # (ints and bools are 32-bit in GLSL; textures get a unit each)
        ints: i32[] = fill(i32(0), u.count)
        loop j in [0..u.count):
            p = q + j * u.stride
            if k == 'i': ints[j] = i32((p as *int)[0])
            else if k == 'b': ints[j] = i32(p[0])
            else:
                glActiveTexture(GL_TEXTURE0 + u32(unit))
                glBindTexture(GL_TEXTURE_2D, __gl_sampled((p as *int)[0]))
                ints[j] = i32(unit)
                unit += 1
        glUniform1iv(loc, n, data(ints) as *u8)
    unit

# draw a mesh with a shader; `params` is the uniforms struct the shader functions take
draw[U] = (sh: Shader, m0: Mesh, params: U):
    flush()
    p = params
    if sh.prog == 0: __unmade_shader()
    if __gl_fbo > 0: __feedback_uniforms(sh, (&p) as *u8)
    if __gl_fbo > 0 or sh.outputs > 1: __draw_outputs(max(sh.outputs, 1))
    when TARGET != "wasm":
        if __vk:
            __vk_draw_at(sh.prog, m0.mode, __mesh_addr(m0), m0.stride, m0.count, m0.ibo, m0.index_count, (&p) as *u8, size_of(U), 0, 0, 0)
            return
    m = __mesh_now(m0)
    when TARGET != "wasm":
        if __soft:
            __sw_draw_mesh(sh.prog, m.mode, m.vbo, m.stride, m.count, m.ibo, m.index_count, (&p) as *u8, 0, 0, 0, 0)
            return
    if sh.lid != 0 and __glp_state[sh.lid] != 0: __glp_link(sh.lid)
    glUseProgram(u32(sh.prog))
    __bind_uniforms_sized(sh, (&p) as *u8)
    __bind_attribs(sh, m)
    if m.index_count > 0:
        glDrawElements(u32(m.mode), i32(m.index_count), GL_UNSIGNED_INT, 0)
    else: glDrawArrays(u32(m.mode), 0, i32(m.count))
    glBindVertexArray(0)

# a draw with a Shader never made (a global `Shader`, or Shader(), not yet given make_shader's
# result): every renderer would draw nothing, and what shows is whatever is under it
__unmade_shader = ():
    panic("a draw with a Shader that was never made (an empty Shader: a variable of that type not yet given what make_shader returns): make it before drawing with it")

# (a draw into a render target may not sample its textures: draw2d.jo's __feedback)
__feedback_uniforms = (sh: Shader, p: *u8):
    loop u in sh.uniforms:
        if u.kind != 't': continue
        loop j in [0..max(u.count, 1)): __feedback(((p + u.offset + j * u.stride) as *int)[0])

__bind_uniforms_sized = (sh: Shader, p: *u8):
    __bind_uniforms(sh, p)

# draw many copies of a mesh in one call; `instances` holds the per-instance shader input
# (uploaded on every call: for instances that change rarely, keep them on the GPU with
# instance_buffer)
draw_instanced[U, I] = (sh: Shader, m: Mesh, instances: I[], params: U):
    global __inst_stream
    if instances.len() == 0: return
    flush()
    p = params
    # (one buffer, given each call's instances in turn: one kept in the mesh was lost with its
    # copy, as draw_mesh_instanced's is each frame, and a new one made every frame never let go)
    if __inst_stream == 0: __inst_stream = gl_create_buffer()
    glBindBuffer(GL_ARRAY_BUFFER, u32(__inst_stream))
    glBufferData(GL_ARRAY_BUFFER, instances.len() * size_of(I), data(instances) as *u8, GL_STREAM_DRAW)
    __draw_inst(sh, m, __inst_stream, size_of(I), 0, instances.len(), (&p) as *u8, size_of(U))
__inst_stream = 0

# per-instance shader input kept on the GPU: uploaded once (and again by set_instances),
# drawn any number of times with draw_instanced
struct InstanceBuffer[I]:
    vbo: int
    count: int

instance_buffer[I] = (instances: I[]) -> InstanceBuffer[I]:
    __gfx_init_gl_only()
    b = InstanceBuffer[I](vbo = gl_create_buffer())
    set_instances(b, instances)
    __mesh_layout_load(size_of(I), true)
    b

# replace what an instance buffer holds
set_instances[I] = (b: mut InstanceBuffer[I], instances: I[]):
    glBindBuffer(GL_ARRAY_BUFFER, u32(b.vbo))
    glBufferData(GL_ARRAY_BUFFER, instances.len() * size_of(I), data(instances) as *u8, GL_DYNAMIC_DRAW)
    b.count = instances.len()

# draw instances first .. first + count of a buffer (count -1: to the end)
draw_instanced[U, I] = (sh: Shader, m: Mesh, b: InstanceBuffer[I], params: U, first: int = 0, count: int = -1):
    n = count
    if n < 0: n = b.count - first
    if n <= 0 or first < 0 or first + n > b.count: return
    flush()
    p = params
    __draw_inst(sh, m, b.vbo, size_of(I), first, n, (&p) as *u8, size_of(U))

__draw_inst = (sh: Shader, m: Mesh, vbo: int, istride: int, first: int, n: int, p: *u8, usize: int, igbuf: int = 0):
    __draw_full(sh, m, vbo, istride, first, n, p, usize, igbuf, 0, -1, 0, 0)

# a draw of mesh m0 with n instances (0: not instanced) from instance `first` of buffer vbo, or of
# GPU buffer igbuf (or no instance data: vbo and igbuf 0); of its vertices (or indices) [from,
# from + count) (count -1: to the end) with base added to each index, and instance_id() counting
# from ibase. (Through Vulkan only whole meshes: draw_indirect draws parts there.)
__draw_full = (sh: Shader, m0: Mesh, vbo: int, istride: int, first: int, n: int, p: *u8, usize: int, igbuf: int, from: int, count: int, base: int, ibase: int):
    if sh.prog == 0: __unmade_shader()
    if __gl_fbo > 0: __feedback_uniforms(sh, p)
    if __gl_fbo > 0 or sh.outputs > 1: __draw_outputs(max(sh.outputs, 1))
    when TARGET != "wasm":
        if __vk:
            insts = 0
            if igbuf > 0: insts = __gb[igbuf].addr + first * istride
            else if vbo > 0: insts = __vg_buffer_addr(vbo) + first * istride
            __vk_draw_at(sh.prog, m0.mode, __mesh_addr(m0), m0.stride, m0.count, m0.ibo, m0.index_count, p, usize, insts, istride, n)
            return
    m = __mesh_now(m0)
    ivbo = vbo
    if igbuf > 0: ivbo = __gb_gl_buffer(igbuf)
    total = m.count
    if m.index_count > 0: total = m.index_count
    cnt = count
    if cnt < 0: cnt = total - from
    if cnt <= 0: return
    when TARGET != "wasm":
        if __soft:
            nidx = 0
            if m.index_count > 0: nidx = cnt
            __sw_draw_mesh(sh.prog, m.mode, m.vbo, m.stride, m.count, m.ibo, nidx, p, ivbo, istride, n, first * istride, from, cnt, base, ibase)
            return
    if sh.lid != 0 and __glp_state[sh.lid] != 0: __glp_link(sh.lid)
    glUseProgram(u32(sh.prog))
    __bind_uniforms(sh, p)
    ib = sh.ibase_loc
    if sh.lid != 0 and ib >= 0: ib = __gl_loc[ib]
    if ibase != 0 and ib >= 0: glUniform1i(i32(ib), i32(ibase))
    __bind_attribs(sh, m, base, ivbo, first * istride)
    ni = max(n, 1)
    if m.index_count > 0: glDrawElementsInstanced(u32(m.mode), i32(cnt), GL_UNSIGNED_INT, from * 4, i32(ni))
    else: glDrawArraysInstanced(u32(m.mode), i32(from), i32(cnt), i32(ni))
    if ibase != 0 and ib >= 0: glUniform1i(i32(ib), 0)
    glBindVertexArray(0)

# texture lookup inside shader functions (maps to GLSL texture()); outside the software
# renderer, calling it on the CPU returns white
sample = (t: Texture, uv: vec2) -> vec4:
    when TARGET != "wasm":
        if __soft: return __sw_sample(t.id, uv)
    vec4(1, 1, 1, 1)

# texture lookup at a given mipmap level (maps to GLSL textureLod; a texture without mipmaps:
# the full-size image. See set_mipmaps)
sample_lod = (t: Texture, uv: vec2, lod: f32) -> vec4:
    when TARGET != "wasm":
        if __soft: return __sw_sample_lod(t.id, uv, lod)
    vec4(1, 1, 1, 1)

# the texel at integer coordinates p (0 to size - 1; y = 0 is the first row of the image data):
# no filtering or wrapping (maps to GLSL texelFetch)
texel = (t: Texture, p: ivec2) -> vec4:
    when TARGET != "wasm":
        if __soft: return __sw_texel(t.id, int(p.x), int(p.y))
    vec4(1, 1, 1, 1)

# a texture's size in texels (maps to GLSL textureSize)
texture_size = (t: Texture) -> ivec2:
    ivec2(i32(t.width), i32(t.height))

# in a fragment shader: drop this fragment (no color, no depth), e.g. for alpha-tested leaves:
# `if c.a < 0.5: discard()`. The rest of the function still runs on the CPU; its result is unused.
discard = ():
    when TARGET != "wasm":
        if __sw_tls != null: __sw_tls[__tid() * 8 + 2] = 1

# in a fragment shader: write this fragment's depth (0 to 1; under reversed_depth, 1 is near)
# instead of the interpolated one, e.g. logarithmic depth for a view of hundreds of kilometres:
# `set_depth(log2(1.0 + 1.0 / i.pos.w) * k)` (i.pos.w is 1/w: 1 over the distance along the view).
# A path that does not call it keeps the interpolated depth (i.pos.z). A shader that calls it
# loses the GPU's early depth test: its fragments are all shaded before being tested.
set_depth = (d: f32):
    when TARGET != "wasm":
        if __sw_tls != null: ((__sw_tls + (__tid() * 8 + 3)) as *f32)[0] = d

# Reversed depth: depth 1 near and 0 at an infinitely far plane, in float, so that a kilometre
# and a millimetre are told apart at a million metres (with the usual depth everything past a few
# kilometres is one depth). Returns whether it is on: false where this renderer has no way to do it
# (OpenGL without glClipControl, a browser without EXT_clip_control), and then nothing changed.
# Turn it on once, before the first frame (it opens the window if none is open yet). With it:
# depth is cleared to 0; depth_test(.nearer) is GL's GREATER (the renderers' glDepthFunc
# flips LESS to GREATER and LEQUAL to GEQUAL, so a raw glDepthFunc(GL_LESS) does too); depth
# textures hold 1 near, 0 far; 3D's camera is an infinite reversed perspective
# (perspective_reversed: clip z is near, always, and w the distance); a vertex shader's clip z
# goes to the depth unit as it is, from 0 (far) to w (near), not -w to w. Shadow maps keep the
# usual depth. A sky or backdrop at the far plane: clip z far_depth() * w.
reversed_depth = (on: bool = true) -> bool:
    global __depth_reversed_on
    __gfx_init_gl_only()
    if on == __depth_reversed_on: return on
    if on and not __depth_reversed_available(): return false
    flush()
    __depth_reversed_on = on
    __depth_mode(on)
    when TARGET != "wasm":
        if __gl_screen_depth_again(): __bind_current()
    on

__depth_reversed_available = () -> bool:
    when TARGET == "wasm": return __web_depth_reversed(1) != 0
    else:
        if __vk or __soft: return true
        __gl_clip_control()

# the clip z / w of the far plane with the depth drawn with now: 0.9999 (just inside it), or 0
# with reversed depth (the infinitely far plane). For a sky or backdrop behind everything, drawn
# with depth_test(.nearer_or_equal): pass it in the uniforms and write
# `vec4(p.xy, u.far, 1)` as the clip position.
far_depth = () -> f32:
    if __depth_reversed: return 0.0
    0.9999

# in a vertex shader: the index of the vertex being shaded (GLSL gl_VertexID) and of the
# instance (gl_InstanceID: 0 for draw, the index into the instances for draw_instanced)
vertex_id = () -> int:
    when TARGET != "wasm":
        if __sw_tls != null: return __sw_tls[__tid() * 8]
    0

instance_id = () -> int:
    when TARGET != "wasm":
        if __sw_tls != null: return __sw_tls[__tid() * 8 + 1]
    0

# in a fragment shader: how much x changes from one pixel to the next (GLSL fwidth), e.g. for
# edges that stay sharp at any size; 0 on the CPU
fwidth = (x: f32) -> f32:
    0.0

fract = (v: vec2) -> vec2:
    v - floor(v)
step = (edge: f32, x: f32) -> f32:
    if x < edge: return 0.0
    1.0
