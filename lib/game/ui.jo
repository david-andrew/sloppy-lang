# Menus: a column of buttons, sliders, switches and choices, worked with the keyboard, a gamepad or the
# mouse. Immediate mode: describe the menu every frame (in draw), and each item says what was
# done to it then.
#
#   draw = ():
#       ...
#       ui_begin("title", vec2(640, 320))
#       if ui_button("Play"): start()
#       music = ui_slider("Music", music)
#       fullscreen = ui_switch("Fullscreen", fullscreen)
#       level = ui_choice("Level", ["forest", "cave", "tower"], level)
#       if ui_button("Quit"): quit()
#       ui_end()
#
# Up/down (arrows, W/S, d-pad, left stick) move between items, enter/space/A or a click choose,
# left/right change sliders, switches and choices; ui_back() is true when escape or B was pressed.
# A menu ignores input in the frame it opens (the key that opened it is still pressed then);
# ui_ready() says whether that frame is over, for a game's own keys in a menu.

struct UiStyle:
    size: f64 = 34.0                        # text size of the items
    spacing: f64 = 58.0                     # from one item to the next
    width: f64 = 440.0                      # of a slider or switch row
    color: vec4 = vec4(1, 1, 1, 0.72)
    focus_color: vec4 = vec4(1, 0.9, 0.55, 1)
    disabled_color: vec4 = vec4(1, 1, 1, 0.28)
    bar_color: vec4 = vec4(1, 1, 1, 0.2)

ui_style = UiStyle()

__ui_menu = ""
__ui_open_frame = -1            # the frame the menu opened in
__ui_drawn_frame = -10          # the last frame a menu was drawn in
__ui_focus = 0
__ui_count = 0                  # items so far in this frame's menu
__ui_last_count = 0             # in the last frame's
__ui_pos = vec2(0, 0)
__ui_frame = -1
__ui_stick_y = 0.0
__ui_stick_x = 0.0
__ui_mouse_last = vec2(-1, -1)
__ui_mouse_moved = false
__ui_nav = 0                    # -1 up, 1 down: this frame
__ui_side = 0                   # -1 left, 1 right
__ui_ok = false
__ui_typing = -1                # the text field that had the focus last frame (its letters are text)
__ui_open = false               # between ui_begin and ui_end
__ui_unended = 0                # menus begun in a row without ui_end

# start a menu: items go in a column centered on x, from y down. A new name starts with the
# first item chosen.
ui_begin = (name: str, top_center: vec2):
    f = frame_number()
    # (a menu without its ui_end, frame after frame: one skipped by an early return is fine)
    if __ui_open:
        __ui_unended += 1
        if __ui_unended >= 3: panic("the menu '{__ui_menu}' needs `ui_end()` after its items (before the next ui_begin)")
    else: __ui_unended = 0
    __ui_open = true
    # (a different menu, or this one again after frames without it: it opens now)
    if name != __ui_menu or __ui_drawn_frame < f - 1:
        __ui_menu = name
        __ui_focus = 0
        __ui_last_count = 0
        __ui_open_frame = f
    __ui_drawn_frame = f
    __ui_pos = top_center
    __ui_count = 0
    m = mouse_pos()
    # (where the pointer happens to be when the menu first shows is not a move onto an item)
    __ui_mouse_moved = m != __ui_mouse_last and __ui_mouse_last != vec2(-1, -1)
    __ui_mouse_last = m
    # (what the player did this frame, read once)
    sy = gamepad_axis(1)
    sx = gamepad_axis(0)
    __ui_nav = 0
    # (letters and space are typed into a text field that has the focus, not menu keys)
    letters = __ui_typing != __ui_focus
    __ui_typing = -1
    if key_typed(.up) or (letters and key_typed(.w)) or gamepad_pressed(.up) or (sy < -0.6 and __ui_stick_y >= -0.6): __ui_nav = -1
    if key_typed(.down) or (letters and key_typed(.s)) or gamepad_pressed(.down) or (sy > 0.6 and __ui_stick_y <= 0.6): __ui_nav = 1
    __ui_side = 0
    if key_typed(.left) or (letters and key_typed(.a)) or gamepad_pressed(.left) or (sx < -0.6 and __ui_stick_x >= -0.6): __ui_side = -1
    if key_typed(.right) or (letters and key_typed(.d)) or gamepad_pressed(.right) or (sx > 0.6 and __ui_stick_x <= 0.6): __ui_side = 1
    __ui_stick_y = sy
    __ui_stick_x = sx
    __ui_ok = key_pressed(.enter) or (letters and key_pressed(.space)) or gamepad_pressed(.a)
    # (nor while ui_controls waits for a new key: controls.jo)
    if not ui_ready() or rebinding():
        __ui_nav = 0
        __ui_side = 0
        __ui_ok = false
    if __ui_last_count > 0 and __ui_nav != 0:
        __ui_focus = (__ui_focus + __ui_nav + __ui_last_count) % __ui_last_count

ui_end = ():
    __ui_open = false
    __ui_last_count = __ui_count
    if __ui_focus >= __ui_count and __ui_count > 0: __ui_focus = __ui_count - 1

# escape or the B button: go back (close the menu)
ui_back = () -> bool: ui_ready() and not rebinding() and (key_pressed(.escape) or gamepad_pressed(.b))

# false in the frame the menu opened in: input then belongs to whatever opened it
ui_ready = () -> bool: frame_number() != __ui_open_frame

# (the next item: its row, whether it has the focus, whether the mouse is on it)
__ui_item = (w: f64) -> (int, vec2, bool):
    i = __ui_count
    __ui_count += 1
    c = __ui_pos + vec2(0, f32(f64(i) * ui_style.spacing))
    m = mouse_pos()
    over = abs(f64(m.x - c.x)) < w / 2.0 and abs(f64(m.y - c.y)) < ui_style.spacing / 2.0
    # (the mouse takes the focus when it moves onto an item)
    if over and __ui_mouse_moved: __ui_focus = i
    (i, c, __ui_focus == i)

__ui_label = (s: str, c: vec2, focused: bool, enabled: bool):
    col = ui_style.color
    if focused: col = ui_style.focus_color
    if not enabled: col = ui_style.disabled_color
    shown = s
    if focused and enabled: shown = "> {s} <"
    text_centered(shown, c, ui_style.size, col)

# a button: true in the frame it is chosen
ui_button = (label: str, enabled: bool = true) -> bool:
    w = text_width(label, ui_style.size) + 80.0
    r = __ui_item(w)
    over = abs(f64(mouse_pos().x - r.1.x)) < w / 2.0 and abs(f64(mouse_pos().y - r.1.y)) < ui_style.spacing / 2.0
    __ui_label(label, r.1, r.2, enabled)
    if not enabled: return false
    (r.2 and __ui_ok) or (over and mouse_pressed(.left) and ui_ready())

# a value from 0 to 1, changed in steps of `step` (left/right, or dragging with the mouse)
ui_slider = (label: str, value: f64, step: f64 = 0.1) -> f64:
    w = ui_style.width
    r = __ui_item(w)
    c = r.1
    v = value
    # (to the nearest step: 0.8 - 0.1 - 0.1 is 0.6, not 0.6000000000000001)
    if r.2 and __ui_side != 0: v = clamp(round((v + f64(__ui_side) * step) / step) * step, 0.0, 1.0)
    if abs(v - round(v * 1e9) / 1e9) < 1e-12: v = round(v * 1e9) / 1e9
    # the bar: right half of the row
    bx = f64(c.x) + 10.0
    bw = w / 2.0 - 10.0
    by = f64(c.y) - 4.0
    m = mouse_pos()
    if mouse_down(.left) and ui_ready() and f64(m.x) >= bx - 10.0 and f64(m.x) <= bx + bw + 10.0 and abs(f64(m.y - c.y)) < ui_style.spacing / 2.0:
        v = clamp((f64(m.x) - bx) / bw, 0.0, 1.0)
    col = ui_style.color
    if r.2: col = ui_style.focus_color
    text(label, vec2(f32(f64(c.x) - w / 2.0), f32(f64(c.y) - ui_style.size * 0.5)), ui_style.size, col)
    rect(bx, by, bw, 8, ui_style.bar_color)
    rect(bx, by, bw * v, 8, col)
    circle(vec2(f32(bx + bw * v), f32(by + 4.0)), 10, col)
    v

# on or off (left/right, enter, or a click)
ui_switch = (label: str, on: bool) -> bool:
    w = ui_style.width
    r = __ui_item(w)
    c = r.1
    v = on
    over = abs(f64(mouse_pos().x - c.x)) < w / 2.0 and abs(f64(mouse_pos().y - c.y)) < ui_style.spacing / 2.0
    if (r.2 and (__ui_ok or __ui_side != 0)) or (over and mouse_pressed(.left) and ui_ready()): v = not v
    col = ui_style.color
    if r.2: col = ui_style.focus_color
    text(label, vec2(f32(f64(c.x) - w / 2.0), f32(f64(c.y) - ui_style.size * 0.5)), ui_style.size, col)
    state = "off"
    if v: state = "on"
    text_centered(state, vec2(f32(f64(c.x) + w / 4.0), c.y), ui_style.size, col)
    v

# one of several (left/right, or a click on either side, goes to the one before or after):
# `difficulty = ui_choice("Difficulty", ["easy", "normal", "hard"], difficulty)`
ui_choice = (label: str, options: str[], index: int) -> int:
    w = ui_style.width
    r = __ui_item(w)
    c = r.1
    n = max(options.len(), 1)
    v = index
    if r.2: v += __ui_side
    if r.2 and __ui_ok: v += 1
    m = mouse_pos()
    over = abs(f64(m.x - c.x)) < w / 2.0 and abs(f64(m.y - c.y)) < ui_style.spacing / 2.0
    if over and mouse_pressed(.left) and ui_ready() and f64(m.x) > f64(c.x):
        if f64(m.x) < f64(c.x) + w / 4.0: v -= 1
        else: v += 1
    v = ((v % n) + n) % n
    col = ui_style.color
    if r.2: col = ui_style.focus_color
    text(label, vec2(f32(f64(c.x) - w / 2.0), f32(f64(c.y) - ui_style.size * 0.5)), ui_style.size, col)
    shown = ""
    if v < options.len(): shown = options[v]
    text_centered("< {shown} >", vec2(f32(f64(c.x) + w / 4.0), c.y), ui_style.size, col)
    v

# a line of text typed in, up to max_chars characters: what is typed while it has the focus is
# added, backspace takes the last character away, enter (like down) goes on to the next item;
# `name = ui_text_field("Name", name)`
ui_text_field = (label: str, value: str, max_chars: int = 24) -> str:
    w = ui_style.width
    r = __ui_item(w)
    c = r.1
    v = value
    if r.2:
        __ui_typing = r.0
        __typing_frame = frame_number()
        if ui_ready() and not rebinding():
            loop ch in chars(text_input()):
                if ch >= 32 and char_count(v) < max_chars: v += chr(ch)
            if key_typed(.backspace): v = without_last_char(v)
            if key_pressed(.enter): __ui_focus = r.0 + 1
    col = ui_style.color
    if r.2: col = ui_style.focus_color
    text(label, vec2(f32(f64(c.x) - w / 2.0), f32(f64(c.y) - ui_style.size * 0.5)), ui_style.size, col)
    # the box: right half of the row, the text in it, and where typing goes when it has the focus
    bx = f64(c.x) + 10.0
    bw = w / 2.0 - 10.0
    rect(bx, f64(c.y) + ui_style.size * 0.55, bw, 2, col)
    shown = v
    if r.2 and int(elapsed() * 2.0) % 2 == 0: shown += "|"
    # (a long text shows its end, cut at the box's left edge)
    tw = text_width(shown, ui_style.size)
    tx = bx
    if tw > bw: tx = bx + bw - tw
    clip(vec2(f32(bx), f32(f64(c.y) - ui_style.size)), vec2(f32(bw), f32(ui_style.size * 2.0)))
    text(shown, vec2(f32(tx), f32(f64(c.y) - ui_style.size * 0.5)), ui_style.size, col)
    no_clip()
    v

# whether a text field (a menu's ui_text_field with the focus, or a hud_text_field clicked into)
# takes the keyboard: the game's own letter keys are better left alone then (ImGui's
# WantCaptureKeyboard)
ui_typing = () -> bool: frame_number() - __typing_frame <= 1
__typing_frame = -10

# a line of text in the column (not an item: it cannot be chosen)
ui_text = (s: str, size: f64 = 24.0, color: vec4 = vec4(1, 1, 1, 0.6)):
    c = __ui_pos + vec2(0, f32(f64(__ui_count) * ui_style.spacing))
    text_centered(s, c, size, color)
    __ui_pos = __ui_pos + vec2(0, f32(ui_style.spacing))

# ---------------- a game's own interface: boxes placed anywhere ----------------
# Buttons, panels and bars where the game puts them (an RTS's command panel, a toolbar), worked
# with the mouse or a finger. Call them in draw, in screen units (after reset_transform() if a
# camera is set), each frame:
#
#   hud_panel(Rect(0, 600, 1280, 120))
#   if hud_button(Rect(20, 620, 160, 44), "Train worker", enabled = food >= 50): train()
#   hud_bar(Rect(20, 680, 160, 12), hp / max_hp, rgb(0.3, 0.9, 0.4))
#   ...and in update: if mouse_pressed(.left) and not hud_hovered(): give_order()
#
# (hud_hovered: whether the mouse was over any of them in the last frame drawn, so a click on
# a button is not also a click on the world behind it)

struct HudStyle:
    accent: vec4 = vec4(1, 0.82, 0.4, 1)    # a selected button's edge, a field being typed in
    panel: vec4 = vec4(0.06, 0.07, 0.09, 0.85)
    button: vec4 = vec4(0.18, 0.2, 0.24, 1)
    hover: vec4 = vec4(0.26, 0.3, 0.36, 1)
    pressed: vec4 = vec4(0.12, 0.13, 0.16, 1)
    border: vec4 = vec4(1, 1, 1, 0.18)
    text: vec4 = vec4(1, 1, 1, 0.92)
    disabled: vec4 = vec4(1, 1, 1, 0.35)
    text_size: f64 = 20.0

hud_style = HudStyle()

__hud_over = false              # the mouse over a box in this frame's drawing
__hud_over_last = false         # ... and in the last frame's
__hud_frame = -1

__hud_touch = (r: Rect) -> bool:
    if __hud_frame != frame_number():
        __hud_over_last = __hud_over
        __hud_over = false
        __hud_frame = frame_number()
    over = contains(r, mouse_pos())
    if over: __hud_over = true
    over

# whether the mouse is over the interface (any hud_ box drawn in the last frame)
hud_hovered = () -> bool:
    if __hud_frame != frame_number(): return __hud_over
    __hud_over_last or __hud_over

# a box behind other parts (it also keeps clicks on it from the world)
hud_panel = (r: Rect, color: vec4 = vec4(0, 0, 0, 0)):
    __hud_touch(r)
    c = color
    if c.w == 0.0: c = hud_style.panel
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)

# a button with a label: true in the frame it is clicked (or tapped); selected: drawn as the
# one chosen of several (a tool, a tab)
hud_button = (r: Rect, label: str, enabled: bool = true, selected: bool = false) -> bool:
    over = __hud_touch(r)
    c = hud_style.button
    if selected: c = hud_style.hover
    if enabled and over:
        c = hud_style.hover
        if mouse_down(.left): c = hud_style.pressed
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    edge = hud_style.border
    if selected: edge = hud_style.accent
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, edge)
    tc = hud_style.text
    if not enabled: tc = hud_style.disabled
    size = min(hud_style.text_size, f64(r.h) * 0.6)
    text_centered(label, center(r), size, tc)
    enabled and over and mouse_pressed(.left)

# a bar filled to `amount` (0 to 1): health, progress, a cooldown
hud_bar = (r: Rect, amount: f64, color: vec4, back: vec4 = vec4(0, 0, 0, 0.5)):
    __hud_touch(r)
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), back)
    rect(f64(r.x), f64(r.y), f64(r.w) * clamp(amount, 0.0, 1.0), f64(r.h), color)

# a box to type text in: clicking it gives it the keyboard, Enter, Escape or a click elsewhere
# takes it away; returns the text as it is now. `id` tells fields with the same place apart
# (their rectangle names them otherwise)
hud_text_field = (r: Rect, value: str, id: str = "", max_chars: int = 64) -> str:
    over = __hud_touch(r)
    key = id
    if len(key) == 0: key = "{r.x},{r.y}"
    if mouse_pressed(.left):
        if over: __hud_focus = key
        else if __hud_focus == key: __hud_focus = ""
    focused = __hud_focus == key
    v = value
    if focused:
        __typing_frame = frame_number()
        loop ch in chars(text_input()):
            if ch >= 32 and char_count(v) < max_chars: v += chr(ch)
        if key_typed(.backspace): v = without_last_char(v)
        if key_pressed(.enter) or key_pressed(.escape): __hud_focus = ""
    c = hud_style.button
    if over or focused: c = hud_style.hover
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    edge = hud_style.border
    if focused: edge = hud_style.accent
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, edge)
    size = min(hud_style.text_size, f64(r.h) * 0.6)
    shown = v
    if focused and int(elapsed() * 2.0) % 2 == 0: shown += "|"
    # (a long text shows its end, cut at the box's left edge)
    pad = 6.0
    tw = text_width(shown, size)
    tx = f64(r.x) + pad
    if tw > f64(r.w) - 2.0 * pad: tx = f64(r.x + r.w) - pad - tw
    clip(vec2(r.x, r.y), vec2(r.w, r.h))
    text(shown, vec2(f32(tx), f32(f64(r.y) + (f64(r.h) - size) / 2.0)), size, hud_style.text)
    no_clip()
    v
__hud_focus = ""

# a box ticked or not, with its label to the right: the new state (flipped in the frame it is
# clicked)
hud_checkbox = (r: Rect, label: str, on: bool) -> bool:
    over = __hud_touch(r)
    v = on
    if over and mouse_pressed(.left): v = not v
    b = f64(r.h)
    c = hud_style.button
    if over: c = hud_style.hover
    rect(f64(r.x), f64(r.y), b, b, c)
    rect_outline(f64(r.x), f64(r.y), b, b, 1.0, hud_style.border)
    if v: rect(f64(r.x) + b * 0.25, f64(r.y) + b * 0.25, b * 0.5, b * 0.5, hud_style.accent)
    size = min(hud_style.text_size, b * 0.7)
    text(label, vec2(f32(f64(r.x) + b * 1.3), f32(f64(r.y) + (b - size) / 2.0)), size, hud_style.text)
    v
