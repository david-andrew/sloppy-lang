# Menus: a column of buttons, sliders, switches and choices, worked with the keyboard, a gamepad or the
# mouse. Immediate mode: describe the menu every frame (in draw), and each item says what was
# done to it then.
#
#   draw = ():
#       ...
#       ui_begin("title", vec2(640, 320))
#       if ui_button("Play"): start()
#       music = ui_slider("Music", music)
#       fullscreen = ui_switch("Fullscreen", fullscreen)
#       level = ui_choice("Level", ["forest", "cave", "tower"], level)
#       if ui_button("Quit"): quit()
#       ui_end()
#
# Up/down (arrows, W/S, d-pad, left stick) move between items, enter/space/A or a click (a tap)
# choose, left/right change sliders, switches and choices; ui_back() is true when escape or B was
# pressed. A click acts as the button comes up on the item it went down on (a finger that slides
# away is no tap). A menu ignores input in the frame it opens (the key that opened it is still
# pressed then); ui_ready() says whether that frame is over, for a game's own keys in a menu.
# On a touch screen the items are drawn as boxes, for fingers.
#
# Menus and hud_ boxes are drawn in the units of the 2D transform drawing has (camera2d_fit,
# translate, scale) and take the mouse and fingers where they show: a column laid out at 360 x 640
# and fitted to any screen with camera2d_fit works as drawn.

# how the ui_ menus look: set ui_style's fields (ui_style.size = 28.0, ui_style.focus_color =
# rgb(0.4, 0.8, 1)), for every menu drawn after. The sizes are for a game designed at 1280 x 720:
# one at another size has them scaled (ui_scale()), as long as they are left as they are (at
# 480 x 270, text 34 high is 12.75), so a menu takes the same part of the screen at any design
# size; one set is used as it is.
struct UiStyle:
    size: f64 = 34.0                        # text size of the items
    spacing: f64 = 58.0                     # from one item to the next
    width: f64 = 440.0                      # of a slider or switch row (wider when a label needs it)
    color: vec4 = vec4(1, 1, 1, 0.72)
    focus_color: vec4 = vec4(1, 0.9, 0.55, 1)
    disabled_color: vec4 = vec4(1, 1, 1, 0.28)
    bar_color: vec4 = vec4(1, 1, 1, 0.2)
    box_color: vec4 = vec4(1, 1, 1, 0.08)   # behind each item on a touch screen
    margin: f64 = 16.0                      # kept between the rows and the screen's edges

ui_style = UiStyle()

# how much the ui_ menus' sizes are scaled: the design size's shorter side over 720 (1280 x 720:
# 1; 480 x 270: 0.375)
ui_scale = () -> f64: f64(min(__design_w, __design_h)) / 720.0

# (ui_style's sizes as used: one left at its default scaled with the design size)
__ui_size = () -> f64:
    if ui_style.size == 34.0: return 34.0 * ui_scale()
    ui_style.size
__ui_spacing = () -> f64:
    if ui_style.spacing == 58.0: return 58.0 * ui_scale()
    ui_style.spacing
__ui_width = () -> f64:
    if ui_style.width == 440.0: return 440.0 * ui_scale()
    ui_style.width
__ui_margin = () -> f64:
    if ui_style.margin == 16.0: return 16.0 * ui_scale()
    ui_style.margin

# the look for menus over a light background (dark text, a dark orange for the chosen item):
# `ui_style = ui_light_style()`
ui_light_style = () -> UiStyle:
    UiStyle(color = vec4(0.08, 0.09, 0.11, 0.88), focus_color = vec4(0.78, 0.33, 0.0, 1), disabled_color = vec4(0, 0, 0, 0.3), bar_color = vec4(0, 0, 0, 0.12), box_color = vec4(0, 0, 0, 0.07))

# (the pointer as the menus and boxes being drawn see it: through the inverse of the 2D transform
# drawing has, so what is drawn under camera2d_fit is pointed at where it shows)
__ui_local = (p: vec2) -> vec2:
    if __xform == __ui_ident: return p
    q = __ui_inverse() * vec4(p, 0, 1)
    vec2(q.x, q.y)
__ui_inverse = () -> mat4:
    global __ui_inv, __ui_inv_of
    if __xform != __ui_inv_of:
        __ui_inv_of = __xform
        __ui_inv = inverse(__xform)
    __ui_inv
__ui_ident = mat4()
__ui_inv_of = mat4()
__ui_inv = mat4()
__ui_ptr = () -> vec2: __ui_local(mouse_pos())

# (a rectangle drawn in the transform's units, on the screen; the screen's, in those units)
__ui_to_screen = (r: Rect) -> Rect:
    if __xform == __ui_ident: return r
    __xform_rect(__xform, r)
__ui_from_screen = (r: Rect) -> Rect:
    if __xform == __ui_ident: return r
    __xform_rect(__ui_inverse(), r)

# (a text field typed in: its bottom edge in the window's pixels, for the page to keep it above
# a phone's keyboard)
__ui_typing_at = (bottom: f64):
    global __typing_bottom
    p = __xform * vec4(0, f32(bottom), 0, 1)
    __screen_layout()
    __typing_bottom = f64(p.y) * __map_sy + __map_y0
__typing_bottom = 0.0

__ui_menu = ""
__ui_open_frame = -1            # the frame the menu opened in
__ui_drawn_frame = -10          # the last frame a menu was drawn in
__ui_focus = 0
__ui_count = 0                  # items so far in this frame's menu
__ui_last_count = 0             # in the last frame's
__ui_pos = vec2(0, 0)
__ui_frame = -1
__ui_stick_y = 0.0
__ui_stick_x = 0.0
__ui_mouse_last = vec2(-1, -1)
__ui_mouse_moved = false
__ui_nav = 0                    # -1 up, 1 down: this frame
__ui_side = 0                   # -1 left, 1 right
__ui_ok = false
__ui_typing = -1                # the text field that had the focus last frame (its letters are text)
__ui_open = false               # between ui_begin and ui_end
__ui_unended = 0                # menus begun in a row without ui_end
# (each menu's own: several may be drawn in a frame)
struct __UiMenu:
    focus = 0
    open_frame = -1
    drawn_frame = -10
    last_count = 0
    row_w = 0.0                 # (the widest a row needed, last frame: every row is that wide)
__ui_menus: {str: __UiMenu}
__ui_row_w = 0.0                # (this menu's rows: as wide as the widest needed, last frame or now)
__ui_row_need = 0.0
__ui_in_frame = -1              # (this frame's input, read once for all its menus)
__ui_in_nav = 0
__ui_in_side = 0
__ui_in_ok = false

# start a menu: items go in a column centered on x, from y down. A menu starts with its first
# item chosen; shown again (back from its Settings), with the item it was left on.
ui_begin = (name: str, top_center: vec2):
    global __ui_count, __ui_drawn_frame, __ui_focus, __ui_in_frame, __ui_in_nav, __ui_in_ok, __ui_in_side, __ui_last_count, __ui_menu, __ui_mouse_last, __ui_mouse_moved, __ui_nav, __ui_ok, __ui_open, __ui_open_frame, __ui_pos, __ui_row_need, __ui_row_w, __ui_side, __ui_stick_x, __ui_stick_y, __ui_typing, __ui_unended
    f = frame_number()
    # (a menu without its ui_end, frame after frame: one skipped by an early return is fine)
    if __ui_open:
        __ui_unended += 1
        if __ui_unended >= 3: panic("the menu '{__ui_menu}' needs `ui_end()` after its items (before the next ui_begin)")
    else: __ui_unended = 0
    __ui_open = true
    # (this menu's own state; shown again after frames without it, it opens now, on the item it
    # was left on)
    st = __ui_menus.get(name) ?? __UiMenu()
    if st.drawn_frame < f - 1:
        st.open_frame = f
        st.last_count = 0
    st.drawn_frame = f
    __ui_menus[name] = st
    __ui_menu = name
    __ui_focus = st.focus
    __ui_last_count = st.last_count
    __ui_open_frame = st.open_frame
    __ui_drawn_frame = f
    __ui_pos = top_center
    __ui_count = 0
    __ui_row_w = st.row_w
    __ui_row_need = 0.0
    # (what the player did this frame, read once for every menu drawn in it)
    if __ui_in_frame != f:
        __ui_in_frame = f
        m = mouse_pos()
        # (where the pointer happens to be when the menu first shows is not a move onto an item)
        __ui_mouse_moved = m != __ui_mouse_last and __ui_mouse_last != vec2(-1, -1)
        __ui_mouse_last = m
        sy = gamepad_axis(1)
        sx = gamepad_axis(0)
        # (letters and space are typed into a text field that has the focus, not menu keys)
        letters = __ui_typing != __ui_focus
        __ui_typing = -1
        __ui_in_nav = 0
        if key_typed(.up) or (letters and key_typed(.w)) or gamepad_pressed(.up) or (sy < -0.6 and __ui_stick_y >= -0.6): __ui_in_nav = -1
        if key_typed(.down) or (letters and key_typed(.s)) or gamepad_pressed(.down) or (sy > 0.6 and __ui_stick_y <= 0.6): __ui_in_nav = 1
        __ui_in_side = 0
        if key_typed(.left) or (letters and key_typed(.a)) or gamepad_pressed(.left) or (sx < -0.6 and __ui_stick_x >= -0.6): __ui_in_side = -1
        if key_typed(.right) or (letters and key_typed(.d)) or gamepad_pressed(.right) or (sx > 0.6 and __ui_stick_x <= 0.6): __ui_in_side = 1
        __ui_stick_y = sy
        __ui_stick_x = sx
        __ui_in_ok = key_pressed(.enter) or (letters and key_pressed(.space)) or gamepad_pressed(.a)
    __ui_nav = __ui_in_nav
    __ui_side = __ui_in_side
    __ui_ok = __ui_in_ok
    # (nor while ui_controls waits for a new key: controls.jo)
    if not ui_ready() or rebinding():
        __ui_nav = 0
        __ui_side = 0
        __ui_ok = false
    if __ui_last_count > 0 and __ui_nav != 0:
        __ui_focus = (__ui_focus + __ui_nav + __ui_last_count) % __ui_last_count

ui_end = ():
    global __ui_focus, __ui_last_count, __ui_open
    __ui_open = false
    __ui_last_count = __ui_count
    if __ui_focus >= __ui_count and __ui_count > 0: __ui_focus = __ui_count - 1
    st = __ui_menus.get(__ui_menu) ?? __UiMenu()
    st.focus = __ui_focus
    st.last_count = __ui_count
    st.row_w = __ui_row_need
    __ui_menus[__ui_menu] = st

# escape or the B button: go back (close the menu)
ui_back = () -> bool: ui_ready() and not rebinding() and (key_pressed(.escape) or gamepad_pressed(.b))

# false in the frame the menu opened in: input then belongs to whatever opened it
ui_ready = () -> bool: frame_number() != __ui_open_frame

# (how wide a row with this label and a value this wide is: the label in its left half, the
# value in its right; as wide as the menu's widest, so the values line up)
__ui_row = (label: str, value_w: f64) -> f64:
    global __ui_row_need, __ui_row_w
    need = max(__ui_width(), 2.0 * (max(text_width(label, __ui_size()), value_w) + 24.0 * ui_scale()))
    # (no wider than the screen leaves on both sides of the column's middle, less the margins)
    v = __ui_from_screen(visible_rect())
    room = 2.0 * (min(f64(__ui_pos.x - v.x), f64(v.x + v.w - __ui_pos.x)) - __ui_margin())
    if room > 0.0: need = min(need, max(room, __ui_width() * 0.5))
    __ui_row_need = max(__ui_row_need, need)
    __ui_row_w = max(__ui_row_w, need)
    __ui_row_w

# (the next item, `what` it is: its index, its row's middle, whether it has the focus, whether
# the pointer is on it, and whether the press now held (or just let go) went down on it)
__ui_item = (w: f64, what: str) -> (int, vec2, bool, bool, bool):
    global __tap_frame, __ui_focus
    if not __ui_open: panic("`{what}` is an item of a menu: `ui_begin(\"name\", vec2(x, y))` goes before the menu's items and `ui_end()` after them (a button placed anywhere is a hud_button)")
    i = __ui_count
    __ui_count += 1
    c = __ui_pos + vec2(0, f32(f64(i) * __ui_spacing()))
    # (a hud_panel drawn over the menu, a dialog, takes the pointer from its items)
    over = __ui_on(c, w, __ui_ptr()) and not __hud_covered(mouse_pos())
    # (the mouse takes the focus when it moves onto an item)
    if over and __ui_mouse_moved: __ui_focus = i
    # (a press from before the menu opened is not one on it)
    on = (mouse_down(.left) or mouse_released(.left)) and __press_frame > __ui_open_frame and __press_tap() and __ui_on(c, w, __ui_local(__press_pos())) and not __hud_covered(__press_pos())
    if on and mouse_down(.left): __tap_frame = frame_number()
    (i, c, __ui_focus == i, over, on)

__ui_on = (c: vec2, w: f64, p: vec2) -> bool: abs(f64(p.x - c.x)) < w / 2.0 and abs(f64(p.y - c.y)) < __ui_spacing() / 2.0

# (an item clicked or tapped: let go on it, having gone down on it)
__ui_tap = (r: (int, vec2, bool, bool, bool)) -> bool: r.3 and r.4 and mouse_released(.left) and ui_ready()

# (the frame a press last went down on a button, a switch, a field: the page runs a frame as soon
# as it lets go, while browsers still allow what a tap may do)
__tap_frame = -10

# (on a touch screen, an item is a box to tap: brighter while a finger is on it)
__ui_box = (r: (int, vec2, bool, bool, bool), w: f64):
    if not touch_input(): return
    col = ui_style.box_color
    if r.3 and r.4 and mouse_down(.left): col = with_alpha(col, min(col.w * 2.2, 1.0))
    h = __ui_spacing() - 8.0 * ui_scale()
    rect_rounded(f64(r.1.x) - w / 2.0, f64(r.1.y) - h / 2.0, w, h, min(12.0 * ui_scale(), h * 0.25), col)

# (the item chosen with keys or a pad looks chosen; with a finger, nothing is until it is tapped)
__ui_lit = (focused: bool) -> bool: focused and not touch_input()

__ui_label = (s: str, c: vec2, focused: bool, enabled: bool):
    col = ui_style.color
    if __ui_lit(focused): col = ui_style.focus_color
    if not enabled: col = ui_style.disabled_color
    shown = s
    if __ui_lit(focused) and enabled: shown = "> {s} <"
    text_centered(shown, c, __ui_size(), col)

# a button: true in the frame it is chosen (enter, or a click or tap let go on it)
ui_button = (label: str, enabled: bool = true) -> bool:
    w = text_width(label, __ui_size()) + 80.0 * ui_scale()
    # (as wide as the other rows, on a touch screen)
    if touch_input(): w = __ui_row(label, 0.0)
    r = __ui_item(w, "ui_button")
    if enabled: __ui_box(r, w)
    else: __ui_box((r.0, r.1, r.2, false, false), w)
    __ui_label(label, r.1, r.2, enabled)
    if not enabled: return false
    (r.2 and __ui_ok) or __ui_tap(r)

# a value from low to high (0 to 1 unless given), changed in steps of `step` (left/right, or
# dragging with the mouse or a finger): `angle = ui_slider("Angle {int(angle)}°", angle, 1, 5, 90)`
ui_slider = (label: str, value: f64, step: f64 = 0.1, low: f64 = 0.0, high: f64 = 1.0) -> f64:
    global __slider_drag, __ui_focus
    w = __ui_row(label, 0.0)
    r = __ui_item(w, "ui_slider")
    __ui_box(r, w)
    c = r.1
    v = clamp(value, min(low, high), max(low, high))
    if r.2 and __ui_side != 0: v = __step_to(v + f64(__ui_side) * step, step, low, high)
    # the bar: right half of the row
    bx = f64(c.x) + 10.0 * ui_scale()
    bw = w / 2.0 - 10.0 * ui_scale() - __ui_inset()
    by = f64(c.y) - 4.0 * ui_scale()
    m = __ui_ptr()
    # (pressed on its bar, it keeps the drag until let go, wherever the pointer goes meanwhile)
    key = "{__ui_menu}/{r.0}"
    if mouse_pressed(.left) and ui_ready() and f64(m.x) >= bx - 10.0 * ui_scale() and f64(m.x) <= bx + bw + 10.0 * ui_scale() and abs(f64(m.y - c.y)) < __ui_spacing() / 2.0:
        __slider_drag = key
    if __slider_drag == key:
        if mouse_down(.left):
            __ui_focus = r.0
            v = __step_to(low + (high - low) * clamp((f64(m.x) - bx) / bw, 0.0, 1.0), step, low, high)
        else: __slider_drag = ""
    col = ui_style.color
    if __ui_lit(r.2) or __slider_drag == key: col = ui_style.focus_color
    __ui_row_label(label, c, w, col)
    __slider_bar(bx, by, bw, (v - low) / max(abs(high - low), 1e-12), col)
    v

# (a row's label, at its left, inside its box)
__ui_row_label = (label: str, c: vec2, w: f64, col: vec4):
    text(label, vec2(f32(f64(c.x) - w / 2.0 + __ui_inset()), f32(f64(c.y) - __ui_size() * 0.5)), __ui_size(), col)

# (how far a row's label is in from its left end: on a touch screen, inside the row's box)
__ui_inset = () -> f64:
    if touch_input(): return 14.0 * ui_scale()
    0.0

# (the slider being dragged: its menu and item, or its hud rectangle; "" for none)
__slider_drag = ""

# (v to the nearest step from low, within low..high: 0.8 - 0.1 - 0.1 is 0.6, not 0.6000000000000001)
__step_to = (v: f64, step: f64, low: f64, high: f64) -> f64:
    r = v
    if step > 0.0: r = low + round((v - low) / step) * step
    r = clamp(r, min(low, high), max(low, high))
    if abs(r - round(r * 1e9) / 1e9) < 1e-12: r = round(r * 1e9) / 1e9
    r

# (a slider's bar: the track, edged so it shows on a light background too, filled to `amount`)
__slider_bar = (x: f64, y: f64, w: f64, amount: f64, col: vec4):
    a = clamp(amount, 0.0, 1.0)
    k = ui_scale()
    rect(x, y, w, 8.0 * k, ui_style.bar_color)
    rect_outline(x, y, w, 8.0 * k, k, with_alpha(col, col.w * 0.45))
    rect(x, y, w * a, 8.0 * k, col)
    circle(vec2(f32(x + w * a), f32(y + 4.0 * k)), 10.0 * k, col)

# on or off (left/right, enter, or a click or tap)
ui_switch = (label: str, on: bool) -> bool:
    w = __ui_row(label, text_width("off", __ui_size()))
    r = __ui_item(w, "ui_switch")
    __ui_box(r, w)
    c = r.1
    v = on
    if (r.2 and (__ui_ok or __ui_side != 0)) or __ui_tap(r): v = not v
    col = ui_style.color
    if __ui_lit(r.2): col = ui_style.focus_color
    __ui_row_label(label, c, w, col)
    state = "off"
    if v: state = "on"
    text_centered(state, vec2(f32(f64(c.x) + w / 4.0), c.y), __ui_size(), col)
    v

# one of several (left/right, or a click or tap on either side, goes to the one before or after):
# `difficulty = ui_choice("Difficulty", ["easy", "normal", "hard"], difficulty)`
ui_choice = (label: str, options: str[], index: int) -> int:
    widest = 0.0
    loop o in options: widest = max(widest, text_width("< {o} >", __ui_size()))
    w = __ui_row(label, widest)
    r = __ui_item(w, "ui_choice")
    __ui_box(r, w)
    c = r.1
    n = max(options.len(), 1)
    v = index
    if r.2: v += __ui_side
    if r.2 and __ui_ok: v += 1
    # (on the value: its left quarter goes back, the rest on)
    m = __ui_ptr()
    if __ui_tap(r) and f64(m.x) > f64(c.x):
        if f64(m.x) < f64(c.x) + w / 4.0: v -= 1
        else: v += 1
    v = ((v % n) + n) % n
    col = ui_style.color
    if __ui_lit(r.2): col = ui_style.focus_color
    __ui_row_label(label, c, w, col)
    shown = ""
    if v < options.len(): shown = options[v]
    text_centered("< {shown} >", vec2(f32(f64(c.x) + w / 4.0), c.y), __ui_size(), col)
    v

# a line of text typed in, up to max_chars characters, edited as a desktop's text boxes are
# (the keys hud_text_field takes, but up and down, which go on through the menu); enter or tab go
# on to the next item, shift+tab back; `name = ui_text_field("Name", name)`. With a finger, a tap
# on it brings up the phone's keyboard, and a Paste button at its right end, until the keyboard
# is put away
ui_text_field = (label: str, value: str, max_chars: int = 24) -> str:
    global __press_taken, __typing_frame, __ui_focus, __ui_text_on, __ui_typing
    w = __ui_row(label, 0.0)
    r = __ui_item(w, "ui_text_field")
    __ui_box(r, w)
    c = r.1
    key = "{__ui_menu}/{r.0}"
    if __ui_tap(r): __ui_text_on = key
    else if not r.2 and __ui_text_on == key: __ui_text_on = ""
    typing = r.2 and (not touch_input() or __ui_text_on == key)
    size = __ui_size()
    # the box: right half of the row, the text in it
    bx = f64(c.x) + 10.0 * ui_scale()
    bw = w / 2.0 - 10.0 * ui_scale() - __ui_inset()
    # (typed in with a finger: a Paste button at its right end, as a phone has no ctrl+V)
    pw = 0.0
    ps = size * 0.6
    if typing and touch_input():
        pw = text_width("Paste", ps) + 16.0
        bw -= pw + 6.0
    st = __text_edits.get("ui {key}") ?? __TextEdit()
    v = __te_sync(st, value)
    __te_layout(st, v, -1.0, size)
    ty = f64(c.y) - size * 0.5
    ox = bx - st.scroll
    if typing:
        __ui_typing = r.0
        __typing_frame = frame_number()
        __ui_typing_at(f64(c.y) + __ui_spacing() / 2.0)
        if ui_ready() and not rebinding():
            # (the mouse on the box: the caret where it went down, a drag selects)
            m = __ui_ptr()
            if mouse_pressed(.left) and not touch_input() and f64(m.x) >= bx - 4.0 and f64(m.x) <= bx + bw + 4.0 and abs(f64(m.y - c.y)) < __ui_spacing() / 2.0 and not __hud_covered(mouse_pos()):
                __press_taken = true
                __te_press(st, v, __te_at(st, v, m, ox, ty, size * 1.25))
            __te_drag(st, v, ox, ty, size * 1.25)
            n = max(__ui_last_count, r.0 + 1)
            if key_typed(.tab) and key_down(.shift): __ui_focus = (r.0 + n - 1) % n
            else if key_typed(.tab) or key_pressed(.enter): __ui_focus = r.0 + 1
            else: v = __te_keys(st, v, max_chars, false, false, -1.0, size, 1)
    else: st.drag = false
    col = ui_style.color
    if __ui_lit(r.2) or typing: col = ui_style.focus_color
    __ui_row_label(label, c, w, col)
    if pw > 0.0:
        was = hud_style.text_size
        hud_style.text_size = ps
        if hud_button(Rect(bx + bw + 6.0, f64(c.y) - size * 0.55, pw, size * 1.1), "Paste"): __platform_paste()
        hud_style.text_size = was
    rect(bx, f64(c.y) + size * 0.55, bw, 2.0 * ui_scale(), col)
    __te_follow_x(st, typing, bw)
    saved = __hud_clip_in(Rect(bx, f64(c.y) - size, bw, size * 2.0))
    __te_draw(st, v, bx - st.scroll, ty, size * 1.25, size, col, typing, 0, 0)
    __hud_clip_out(saved)
    st.text = v
    __text_edits["ui {key}"] = st
    v
__ui_text_on = ""               # (the field a finger tapped to type in: "menu/item")

# whether a text field (a menu's ui_text_field with the focus, or a hud_text_field clicked into)
# takes the keyboard: the game's own letter keys are better left alone then (ImGui's
# WantCaptureKeyboard)
ui_typing = () -> bool: frame_number() - __typing_frame <= 1
__typing_frame = -10

# a line of text in the column (not an item: it cannot be chosen)
ui_text = (s: str, size: f64 = 24.0 * ui_scale(), color: vec4 = vec4(1, 1, 1, 0.6)):
    global __ui_pos
    if not __ui_open: panic("`ui_text` is a line of a menu: `ui_begin(\"name\", vec2(x, y))` goes before the menu's items and `ui_end()` after them (text anywhere: text(...))")
    c = __ui_pos + vec2(0, f32(f64(__ui_count) * __ui_spacing()))
    text_centered(s, c, size, color)
    __ui_pos = __ui_pos + vec2(0, f32(__ui_spacing()))

# ---------------- a game's own interface: boxes placed anywhere ----------------
# Buttons, panels and bars where the game puts them (an RTS's command panel, a toolbar), worked
# with the mouse or a finger. Call them in draw, each frame, in screen units (after
# reset_transform() if a camera is set), or under a transform of their own (camera2d_fit of a
# phone's column: they take the pointer where they show):
#
#   hud_panel(Rect(0, 600, 1280, 120))
#   if hud_button(Rect(20, 620, 160, 44), "Train worker", enabled = food >= 50): train()
#   hud_bar(Rect(20, 680, 160, 12), hp / max_hp, rgb(0.3, 0.9, 0.4))
#   ...and in update: if mouse_pressed(.left) and not hud_hovered(): give_order()
#
# (hud_hovered: whether the mouse was over any of them in the last frame drawn, so a click on
# a button is not also a click on the world behind it)
#
# A hud_panel covers what was drawn before it: a dialog drawn last, over buttons, takes their
# clicks (and the wheel), as one over a ui_ menu does; `hud_panel(visible_rect(), rgba(0, 0, 0,
# 0.5))` under a dialog makes it modal, everything else dimmed and out of reach.

# how hud_button, hud_panel, hud_bar, hud_text_field and hud_checkbox look: set hud_style's
# fields (hud_style.text_size = 16.0, hud_style.button = rgb(0.2, 0.3, 0.5)); a change holds for
# what is drawn after it, so a game can style one button and set it back
struct HudStyle:
    accent: vec4 = vec4(1, 0.82, 0.4, 1)    # a selected button's edge, a field being typed in
    panel: vec4 = vec4(0.06, 0.07, 0.09, 0.85)
    button: vec4 = vec4(0.18, 0.2, 0.24, 1)
    hover: vec4 = vec4(0.26, 0.3, 0.36, 1)
    pressed: vec4 = vec4(0.12, 0.13, 0.16, 1)
    border: vec4 = vec4(1, 1, 1, 0.18)
    text: vec4 = vec4(1, 1, 1, 0.92)
    disabled: vec4 = vec4(1, 1, 1, 0.35)
    selection: vec4 = vec4(1, 0.82, 0.4, 0.35)     # behind text selected in a field (left as it is: the accent's)
    text_size: f64 = 20.0

hud_style = HudStyle()

__hud_boxes: Rect[]             # the boxes drawn this frame (as much of each as is not clipped away)
__hud_boxes_last: Rect[]        # ... and in the last frame
__hud_frame = -1
__hud_panels: (Rect, bool)[]    # the panels drawn this frame, on the screen, and whether a clip was on (a list's rows)
__hud_panels_last: (Rect, bool)[]

# (a box drawn: kept, on the screen, for hud_hovered; whether the pointer is on it)
__hud_touch = (r: Rect) -> bool:
    global __hud_boxes, __hud_boxes_last, __hud_frame
    if __hud_frame != frame_number():
        __hud_boxes_last = __hud_boxes
        __hud_boxes = []
        __hud_frame = frame_number()
    __hud_boxes.push(__hud_screen_box(r))
    __hud_hit(r, mouse_pos())

# (r on the screen: as much of it as is not clipped away; a row of a scrolling list out of view
# is not there to click)
__hud_screen_box = (r: Rect) -> Rect:
    box = __ui_to_screen(r)
    if __clip_on and __cur_target < 0:
        x0 = max(box.x, __clip.x)
        y0 = max(box.y, __clip.y)
        x1 = min(box.x + box.w, __clip.x + __clip.z)
        y1 = min(box.y + box.h, __clip.y + __clip.w)
        box = Rect(x0, y0, max(x1 - x0, 0), max(y1 - y0, 0))
    box

# (whether a point on the screen (2D units, as mouse_pos) is on r, drawn in the transform's
# units, not clipped away, nor under a panel drawn after it; within: a list's box on the screen,
# which the panels of its own rows do not cover)
__hud_hit = (r: Rect, p: vec2, within: Rect = Rect(0, 0, 0, 0)) -> bool:
    if __clip_on and __cur_target < 0 and not contains(Rect(__clip.x, __clip.y, __clip.z, __clip.w), p): return false
    contains(r, __ui_local(p)) and not __hud_covered(p, within)

# (whether a hud_panel drawn after what is drawn now covered p (on the screen) in the last frame:
# the panels drawn so far this frame are the ones before it)
__hud_covered = (p: vec2, within: Rect = Rect(0, 0, 0, 0)) -> bool:
    loop k in [__hud_panels.len()..__hud_panels_last.len()):
        b = __hud_panels_last[k]
        if b.1 and within.w > 0 and b.0.x >= within.x - 0.5 and b.0.y >= within.y - 0.5 and b.0.x + b.0.w <= within.x + within.w + 0.5 and b.0.y + b.0.h <= within.y + within.h + 0.5: continue
        if contains(b.0, p): return true
    false

# (whether the press now held, or just let go, went down on r and is still a tap)
__hud_press_on = (r: Rect) -> bool:
    global __tap_frame
    if not mouse_down(.left) and not mouse_released(.left): return false
    if not __press_tap() or not __hud_hit(r, __press_pos()): return false
    if mouse_down(.left): __tap_frame = frame_number()
    true

# whether the mouse (or a finger) is over the interface now: over a hud_ box drawn in the last
# frame or this one, where it is now (a tap on the world just after one on a button is the
# world's; a tap landing on a button is the button's from that frame on)
hud_hovered = () -> bool:
    m = mouse_pos()
    if __hud_frame != frame_number():
        loop b in __hud_boxes:
            if contains(b, m): return true
        return false
    loop b in __hud_boxes_last:
        if contains(b, m): return true
    loop b in __hud_boxes:
        if contains(b, m): return true
    false

# (a box under the pointer looks hovered, but not under a finger lifted away, nor one dragging)
__hud_lit = (over: bool) -> bool: over and (not touch_input() or (mouse_down(.left) and __press_tap()))

# (after draw, each frame: the lists' bars not drawn yet, and this frame's panels and text fields
# kept for the next)
__hud_frame_end = ():
    global __hud_order, __hud_order_last, __hud_panels, __hud_panels_last
    __hud_bars_draw()
    __hud_panels_last = __hud_panels
    __hud_panels = []
    __hud_order_last = __hud_order
    __hud_order = []

# a box behind other parts (it also keeps clicks on it from the world, and from the hud_ boxes
# drawn before it, under it)
hud_panel = (r: Rect, color: vec4 = vec4(0, 0, 0, 0)):
    __hud_touch(r)
    __hud_panels.push((__hud_screen_box(r), __clip_on and __cur_target < 0))
    c = color
    if c.w == 0.0: c = hud_style.panel
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)

# a button with a label: true in the frame it is clicked (or tapped): let go on it, having gone
# down on it (a finger that slides away is no tap, and a press that scrolls a list is the
# list's); selected: drawn as the one chosen of several (a tool, a tab). A label wider than the
# button is cut short with …; align = .left puts it at the left, as a list's rows have it
hud_button = (r: Rect, label: str, enabled: bool = true, selected: bool = false, align: Align = .center) -> bool:
    over = __hud_touch(r)
    on = enabled and __hud_press_on(r)
    c = hud_style.button
    if selected: c = hud_style.hover
    if enabled and __hud_lit(over):
        c = hud_style.hover
        if on and mouse_down(.left): c = hud_style.pressed
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    edge = hud_style.border
    if selected: edge = hud_style.accent
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, edge)
    tc = hud_style.text
    if not enabled: tc = hud_style.disabled
    size = min(hud_style.text_size, f64(r.h) * 0.6)
    pad = 4.0
    if align != .center: pad = max(8.0, size * 0.5)
    shown = fit_text(label, f64(r.w) - 2.0 * pad, size)
    ty = f64(r.y) + (f64(r.h) - size) / 2.0
    match align:
        center: text_centered(shown, center(r), size, tc)
        left: text(shown, vec2(f32(f64(r.x) + pad), f32(ty)), size, tc)
        right: text(shown, vec2(f32(f64(r.x + r.w) - pad - text_width(shown, size)), f32(ty)), size, tc)
    on and over and mouse_released(.left)

# a bar filled to `amount` (0 to 1): health, progress, a cooldown
hud_bar = (r: Rect, amount: f64, color: vec4, back: vec4 = vec4(0, 0, 0, 0.5)):
    __hud_touch(r)
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), back)
    rect(f64(r.x), f64(r.y), f64(r.w) * clamp(amount, 0.0, 1.0), f64(r.h), color)

# a list taller than its box: how far it is scrolled, from 0. Moved by dragging it (with a finger,
# or the mouse: a press on a row that moves is a drag, not a click on the row, and let go moving,
# the list glides on; a press claimed with claim_press(), as a row dragged to another place, does
# not move it), by the wheel over the box and by the bar at its right edge (when there is more
# than fits). The rows go at their y minus that, inside clip(r) of the box: rows scrolled out of
# it take no clicks. The bar is drawn over the rows, at the no_clip() after them (or as draw ends)
#   off = hud_scroll(r, items.len() * 44, "shop")
#   clip(r)
#   loop i in 0.. and it in items:
#       if hud_button(Rect(r.x, r.y + i * 44 - off, r.w - 10, 40), it.name): buy(i)
#   no_clip()
hud_scroll = (r: Rect, content_height: f64, id: str = "") -> f64:
    global __hud_drag, __hud_grab, __hud_pan, __hud_pan_at, __hud_panning, __press_taken
    key = id
    if len(key) == 0: key = "{r.x},{r.y}"
    st = __hud_scrolls.get(key) ?? __HudScroll(t = elapsed())
    off = st.off
    # (the time since this list was last drawn, for its gliding)
    now = elapsed()
    dt = clamp(now - st.t, 0.0, 0.1)
    st.t = now
    room = max(content_height - f64(r.h), 0.0)
    m = __ui_ptr()
    over = __hud_hit(r, mouse_pos(), __ui_to_screen(r))
    if over and mouse_wheel() != 0.0:
        off -= mouse_wheel() * 44.0
        st.speed = 0.0
    bw = 8.0
    bx = f64(r.x + r.w) - bw
    th = max(f64(r.h) * f64(r.h) / max(content_height, 1.0), 24.0)
    track = f64(r.h) - th
    if room > 0.0 and mouse_pressed(.left) and over:
        st.speed = 0.0                 # (a finger on a gliding list stops it)
        if f64(m.x) >= bx - 4.0:
            __hud_drag = key
            ty = f64(r.y) + track * off / room
            __hud_grab = f64(m.y) - ty
            if __hud_grab < 0.0 or __hud_grab > th: __hud_grab = th / 2.0     # (a click on the track: the bar's middle there)
        else:
            __hud_pan = key
            __hud_panning = false
    if __hud_drag == key:
        if mouse_down(.left) and track > 0.0: off = (f64(m.y) - __hud_grab - f64(r.y)) / track * room
        else: __hud_drag = ""
    # dragged: the press is the list's once it has gone farther than a tap does (unless a slider
    # in it took it)
    if __hud_pan == key:
        if mouse_down(.left):
            if not __hud_panning and __press_far and not __press_taken and __slider_drag == "":
                __hud_panning = true
                __press_taken = true
                __hud_pan_at = f64(m.y) + off
            if __hud_panning:
                was = off
                off = clamp(__hud_pan_at - f64(m.y), 0.0, room)
                # (how fast it moves, smoothed over the last frames: its speed as it is let go)
                if dt > 0.0: st.speed = mix(st.speed, (off - was) / dt, 0.5)
        else:
            if not __hud_panning: st.speed = 0.0
            __hud_pan = ""
    else if st.speed != 0.0:
        # (let go moving: it glides on, slowing, to a stop or an end)
        off += st.speed * dt
        st.speed *= exp(-4.0 * dt)
        if abs(st.speed) < 20.0 or off <= 0.0 or off >= room: st.speed = 0.0
    off = clamp(off, 0.0, room)
    st.off = off
    __hud_scrolls[key] = st
    if room > 0.0:
        c = hud_style.button
        if __hud_drag == key or (__hud_panning and __hud_pan == key) or (__hud_lit(over) and f64(m.x) >= bx - 4.0): c = hud_style.hover
        __hud_bars.push(__HudBar(Rect(bx, f64(r.y), bw, f64(r.h)), Rect(bx, f64(r.y) + track * off / room, bw, th), hud_style.pressed, c, __xform))
    off
struct __HudScroll:
    off = 0.0
    speed = 0.0                 # (units a second: gliding, let go moving)
    t = 0.0                     # (when it was last drawn)
__hud_scrolls: {str: __HudScroll} = {}
__hud_drag = ""                 # (the list whose bar is dragged)
__hud_grab = 0.0
__hud_pan = ""                  # (the list a press went down in, and whether it moves with it)
__hud_panning = false
__hud_pan_at = 0.0             # (where the list's top would be under the pointer)

# (the lists' bars, drawn over their rows once those are done: at no_clip(), or as draw ends)
struct __HudBar:
    track: Rect
    thumb: Rect
    back: vec4
    color: vec4
    xform: mat4
__hud_bars: __HudBar[]
__hud_bars_draw = ():
    global __hud_bars, __xform
    if __hud_bars.len() == 0: return
    bars = __hud_bars
    __hud_bars = []
    was = __xform
    loop b in bars:
        __xform = b.xform
        rect(b.track, b.back)
        rect(b.thumb, b.color)
    __xform = was

# a box of text beside the mouse, kept on the screen: what the thing under the mouse is or does.
# Draw it after the rest of the interface, so nothing covers it (`if hovered: tip = "..."`, then
# at the end of draw, `if len(tip) > 0: hud_tooltip(tip)`); lines break at "\n"
hud_tooltip = (s: str):
    size = hud_style.text_size * 0.8
    pad = 7.0
    ls = split(s, "\n")
    w = 0.0
    loop l in ls: w = max(w, text_width(l, size))
    w += pad * 2.0
    h = f64(ls.len()) * size * 1.25 + pad * 2.0
    m = __ui_ptr()
    v = __ui_from_screen(visible_rect())
    x = f64(m.x) + 16.0
    y = f64(m.y) + 18.0
    if x + w > f64(v.x + v.w): x = f64(m.x) - w - 8.0
    if y + h > f64(v.y + v.h): y = f64(m.y) - h - 8.0
    x = max(x, f64(v.x))
    y = max(y, f64(v.y))
    rect(x, y, w, h, vec4(hud_style.panel.x, hud_style.panel.y, hud_style.panel.z, 0.96))
    rect_outline(x, y, w, h, 1.0, hud_style.border)
    loop i in 0.. and l in ls: text(l, vec2(f32(x + pad), f32(y + pad + f64(i) * size * 1.25)), size, hud_style.text)

# a value from low to high, set by dragging along the box (a finger too: the slider pressed on
# keeps the drag until let go), in steps of `step` (0: any value); the label, if any, is drawn
# over the box's left part, so give it room: `g = hud_slider(Rect(20, 80, 300, 36), g, 1, 20, 0.1, "g {g:.1f} m/s²")`
hud_slider = (r: Rect, value: f64, low: f64, high: f64, step: f64 = 0.0, label: str = "") -> f64:
    global __slider_drag
    over = __hud_touch(r)
    key = "hud {r.x},{r.y},{r.w},{r.h}"
    v = clamp(value, min(low, high), max(low, high))
    if over and mouse_pressed(.left): __slider_drag = key
    lw = 0.0
    size = min(hud_style.text_size, f64(r.h) * 0.6)
    if len(label) > 0: lw = text_width(label, size) + 12.0
    tx = f64(r.x) + lw + 10.0
    tw = max(f64(r.w) - lw - 20.0, 1.0)
    if __slider_drag == key:
        if mouse_down(.left): v = __step_to(low + (high - low) * clamp((f64(__ui_ptr().x) - tx) / tw, 0.0, 1.0), step, low, high)
        else: __slider_drag = ""
    c = hud_style.button
    if __hud_lit(over) or __slider_drag == key: c = hud_style.hover
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, hud_style.border)
    if lw > 0.0: text(label, vec2(f32(f64(r.x) + 8.0), f32(f64(r.y) + (f64(r.h) - size) / 2.0)), size, hud_style.text)
    a = (v - low) / max(abs(high - low), 1e-12)
    cy = f64(r.y) + f64(r.h) / 2.0
    rect(tx, cy - 3.0, tw, 6, hud_style.pressed)
    rect(tx, cy - 3.0, tw * a, 6, hud_style.accent)
    circle(vec2(f32(tx + tw * a), f32(cy)), min(f64(r.h) * 0.3, 10.0), hud_style.accent)
    v

# a box ticked or not, with its label to the right: the new state (flipped in the frame it is
# clicked or tapped, on the box or its label). The box is as tall as r; an r wider than that
# holds the label too, cut short with … to fit it
hud_checkbox = (r: Rect, label: str, on: bool) -> bool:
    over = __hud_touch(r)
    v = on
    if over and __hud_press_on(r) and mouse_released(.left): v = not v
    b = f64(r.h)
    c = hud_style.button
    if __hud_lit(over): c = hud_style.hover
    rect(f64(r.x), f64(r.y), b, b, c)
    rect_outline(f64(r.x), f64(r.y), b, b, 1.0, hud_style.border)
    if v: rect(f64(r.x) + b * 0.25, f64(r.y) + b * 0.25, b * 0.5, b * 0.5, hud_style.accent)
    size = min(hud_style.text_size, b * 1.2)
    lx = f64(r.x) + b * 1.3
    shown = label
    if f64(r.w) > b * 1.3: shown = fit_text(label, f64(r.x + r.w) - lx, size)
    text(shown, vec2(f32(lx), f32(f64(r.y) + (b - size) / 2.0)), size, hud_style.text)
    v

# ---- text fields ----
# A box to type text in, edited as a desktop's text boxes are: a click gives it the keyboard and
# puts the caret there (a drag selects, a double click a word, three clicks all of it), left and
# right (with ctrl, alt on a Mac: by words; with shift: selecting), home and end, backspace and
# delete (with ctrl: a word), ctrl+A, ctrl+C, ctrl+X, ctrl+V, ctrl+Z, ctrl+shift+Z and ctrl+Y (cmd
# on a Mac). A long text moves to keep the caret in view. Tab and shift+tab go on to the next or
# back to the last field drawn, its text selected; Enter (hud_submitted()), Escape or a click
# elsewhere takes the keyboard away. Returns the text as it is now: `name = hud_text_field(r, name)`.
# Tapped on a phone, it brings up the phone's keyboard, and a Paste button at its right end,
# until the keyboard is put away. `id` names the field (hud_focus, hud_focused) and tells fields
# with the same place apart (their rectangle names them otherwise); `hint` is shown dimmed while
# it is empty ("Search")
hud_text_field = (r: Rect, value: str, id: str = "", max_chars: int = 64, hint: str = "") -> str:
    over = __hud_touch(r)
    key = __hud_field_key(r, id)
    size = min(hud_style.text_size, f64(r.h) * 0.6)
    pad = 6.0
    st = __text_edits.get(key) ?? __TextEdit()
    v = __te_sync(st, value)
    __te_layout(st, v, -1.0, size)
    ty = f64(r.y) + (f64(r.h) - size) / 2.0
    v = __hud_edit(st, key, v, r, over, f64(r.x) + pad - st.scroll, ty, size * 1.25, max_chars, -1.0, size, 1)
    focused = __hud_focus == key
    c = hud_style.button
    if __hud_lit(over) or focused: c = hud_style.hover
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    edge = hud_style.border
    if focused: edge = hud_style.accent
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, edge)
    # (typed in with a finger: a Paste button at its right end, as a phone has no ctrl+V)
    paste_w = 0.0
    if focused and touch_input(): paste_w = text_width("Paste", size) + 16.0
    iw = f64(r.w) - paste_w - 2.0 * pad
    __te_follow_x(st, focused, iw)
    saved = __hud_clip_in(Rect(r.x, r.y, f32(f64(r.w) - paste_w), r.h))
    # (empty: the hint, dimmed, saying what goes in it)
    if len(v) == 0 and len(hint) > 0: text(hint, vec2(f32(f64(r.x) + pad), f32(ty)), size, hud_style.disabled)
    __te_draw(st, v, f64(r.x) + pad - st.scroll, ty, size * 1.25, size, hud_style.text, focused, 0, 0)
    __hud_clip_out(saved)
    if paste_w > 0.0:
        pr = Rect(r.x + r.w - f32(paste_w) - 3, r.y + 3, f32(paste_w), r.h - 6)
        if hud_button(pr, "Paste"): __platform_paste()
    st.text = v
    __text_edits[key] = st
    v

# a box of several lines of text, edited as hud_text_field is, its lines wrapped at the box's
# width: enter starts a new line, up and down go to the line above or below, page up and page
# down a boxful, ctrl+home and ctrl+end to the start and the end; the wheel scrolls it and it
# scrolls to keep the caret in view. Ctrl+enter is hud_submitted()
#   note.body = hud_text_area(Rect(260, 50, 500, 400), note.body, id = "body")
hud_text_area = (r: Rect, value: str, id: str = "", max_chars: int = 1000000, hint: str = "") -> str:
    over = __hud_touch(r)
    key = __hud_field_key(r, id)
    size = hud_style.text_size
    lh = size * 1.25
    pad = 6.0
    bar = 6.0
    ww = max(f64(r.w) - 2.0 * pad - bar, size)
    ih = f64(r.h) - 2.0 * pad
    st = __text_edits.get(key) ?? __TextEdit()
    v = __te_sync(st, value, true)
    __te_layout(st, v, ww, size)
    if over and mouse_wheel() != 0.0: st.scroll -= mouse_wheel() * lh * 3.0
    v = __hud_edit(st, key, v, r, over, f64(r.x) + pad, f64(r.y) + pad - st.scroll, lh, max_chars, ww, size, max(int(ih / lh) - 1, 1))
    __te_layout(st, v, ww, size)
    focused = __hud_focus == key
    # (the caret moved: the lines scroll to show it)
    content = f64(st.lines.len()) * lh
    if st.follow:
        cy = f64(__te_line(st.lines, st.caret)) * lh
        if cy < st.scroll: st.scroll = cy
        if cy + lh > st.scroll + ih: st.scroll = cy + lh - ih
        st.follow = false
    st.scroll = clamp(st.scroll, 0.0, max(content - ih, 0.0))
    c = hud_style.button
    if focused: c = hud_style.hover
    rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), c)
    edge = hud_style.border
    if focused: edge = hud_style.accent
    rect_outline(f64(r.x), f64(r.y), f64(r.w), f64(r.h), 1.0, edge)
    saved = __hud_clip_in(Rect(r.x + 1, f32(f64(r.y) + 1.0), r.w - 2, r.h - 2))
    oy = f64(r.y) + pad - st.scroll
    if len(v) == 0 and len(hint) > 0: text(hint, vec2(f32(f64(r.x) + pad), f32(oy)), size, hud_style.disabled)
    first = max(int(st.scroll / lh) - 1, 0)
    last = min(int((st.scroll + ih) / lh) + 1, st.lines.len() - 1)
    __te_draw(st, v, f64(r.x) + pad, oy, lh, size, hud_style.text, focused, first, last)
    __hud_clip_out(saved)
    # (more than fits: a bar at the right edge, as long as the part shown)
    if content > ih:
        th = max(ih * ih / content, 16.0)
        y = f64(r.y) + pad + (ih - th) * st.scroll / (content - ih)
        rect(f64(r.x + r.w) - bar - 2.0, y, bar - 2.0, th, hud_style.border)
    st.text = v
    __text_edits[key] = st
    v

# give the keyboard to the hud_text_field or hud_text_area with this id, as tab does (a field's
# text selected): ctrl+F to the search box, `if key_down(.ctrl) and key_pressed(.f): hud_focus("search")`.
# hud_focus("") takes it from every field
hud_focus = (id: str):
    global __hud_focus, __hud_focus_frame, __hud_focus_new
    __hud_focus = id
    __hud_focus_frame = frame_number()
    __hud_focus_new = id
# whether the field with this id has the keyboard
hud_focused = (id: str) -> bool: len(id) > 0 and __hud_focus == id
# true in the frame enter was pressed in the text field drawn last (ctrl+enter in a text area):
#   path = hud_text_field(r, path, id = "path")
#   if hud_submitted(): open_file(path)
hud_submitted = () -> bool: __hud_submit_frame == frame_number() and __hud_submit_key == __hud_last_field

__hud_focus = ""                # (the field with the keyboard: its id, or "x,y" of its rectangle)
__hud_focus_frame = -10         # (the frame hud_focus or tab gave it: the keys of that frame are not its)
__hud_focus_new = ""            # (given by hud_focus or tab: its text is selected as it takes it)
__hud_order: str[]              # (the text fields drawn this frame, in order, for tab; and in the last)
__hud_order_last: str[]
__hud_last_field = ""
__hud_submit_key = ""
__hud_submit_frame = -10

__hud_field_key = (r: Rect, id: str) -> str:
    if len(id) > 0: return id
    "{r.x},{r.y}"

# (a field's pointer and keys: who has the keyboard, the caret and selection the mouse or a
# finger puts, and what is typed; the text as it leaves them. ox, oy: where its first line's text
# starts, as it is scrolled; w: an area's width (-1: a field's single line); page: the lines page
# up and down go)
__hud_edit = (st: mut __TextEdit, key: str, value: str, r: Rect, over: bool, ox: f64, oy: f64, lh: f64, max_chars: int, w: f64, size: f64, page: int) -> str:
    global __hud_focus, __hud_focus_new, __hud_last_field, __hud_submit_frame, __hud_submit_key, __press_taken, __typing_frame
    v = value
    multi = w > 0.0
    __hud_last_field = key
    __hud_order.push(key)
    m = __ui_ptr()
    if not touch_input() and mouse_pressed(.left) and over:
        # (the mouse: the keyboard and the caret as it goes down; the press is the field's, for
        # selecting, not a scrolling list's)
        __hud_focus = key
        __press_taken = true
        __te_press(st, v, __te_at(st, v, m, ox, oy, lh))
    else if touch_input() and over and __hud_press_on(r) and mouse_released(.left):
        __hud_focus = key
        st.caret = __te_at(st, v, m, ox, oy, lh)
        st.anchor = st.caret
        st.follow = true
    else if mouse_pressed(.left) and not over and __hud_focus == key: __hud_focus = ""
    if __hud_focus != key:
        st.drag = false
        return v
    __te_drag(st, v, ox, oy, lh)
    __typing_frame = frame_number()
    __ui_typing_at(f64(r.y + r.h))
    if __hud_focus_new == key:
        __hud_focus_new = ""
        # (a field's text selected, to be typed over; an area's caret where it was)
        if not multi:
            st.anchor = 0
            st.caret = len(v)
        st.follow = true
    # (the keys of the frame it was given the keyboard in were for what gave it)
    if __hud_focus_frame == frame_number(): return v
    if key_typed(.tab):
        __hud_tab(key, key_down(.shift))
        return v
    if key_pressed(.escape):
        __hud_focus = ""
        return v
    if key_pressed(.enter) and (not multi or __te_mod()):
        __hud_submit_key = key
        __hud_submit_frame = frame_number()
        if not multi: __hud_focus = ""
        return v
    __te_keys(st, v, max_chars, multi, true, w, size, page)

# (tab in a field: the keyboard to the next field drawn (shift: the one before), its text selected)
__hud_tab = (key: str, back: bool):
    o = __hud_order_last
    i = o.index_of(key)
    if i < 0 or o.len() < 2: return
    n = o.len()
    j = (i + 1) % n
    if back: j = (i + n - 1) % n
    hud_focus(o[j])

# (drawing clipped to r as well, in the transform's units, inside a clip already on (a scrolling
# list's); what was on before, to put back)
__hud_clip_in = (r: Rect) -> (bool, vec4):
    was = (__clip_on, __clip)
    b = __ui_to_screen(r)
    x0 = f64(b.x)
    y0 = f64(b.y)
    x1 = f64(b.x + b.w)
    y1 = f64(b.y + b.h)
    if __clip_on:
        x0 = max(x0, f64(__clip.x))
        y0 = max(y0, f64(__clip.y))
        x1 = min(x1, f64(__clip.x + __clip.z))
        y1 = min(y1, f64(__clip.y + __clip.w))
    __clip_screen(vec4(f32(x0), f32(y0), f32(max(x1 - x0, 0.0)), f32(max(y1 - y0, 0.0))))
    was
__hud_clip_out = (was: (bool, vec4)):
    if was.0: __clip_screen(was.1)
    else: __clip_none()

# (the text being edited: a field's caret, selection and undo, kept by its id)
struct __TextEdit:
    caret = 0                   # (bytes into the text, at a character's start)
    anchor = 0                  # (the selection's other end: the caret's place, for none)
    scroll = 0.0                # (a field: how far its text is moved left; an area: up)
    text = ""                   # (the text given back last frame: another, set by the program, puts the caret at its end)
    undo: __TextSnap[]
    redo: __TextSnap[]
    kind = 0                    # (the last edit: 1 typing, 2 deleting; a run of one kind, without a pause, is one undo step)
    kind_t = -10.0
    drag = false                # (the mouse went down in it and selects as it moves)
    click_t = -10.0             # (the last click, and how many came quickly: 2 a word, 3 all)
    clicks = 0
    blink_t = 0.0               # (the caret shows, steadily, for a moment after it moves)
    goal_x = -1.0               # (up and down keep to the x they started from)
    follow = false              # (the caret moved: an area scrolls to show it)
    lines: (int, int)[]         # (where each line starts and ends, wrapped)
    xs: f64[]                   # (where each byte's character starts, from the text's start)
    laid_of = ""                # (the text, width and size they are for)
    laid_w = -2.0
    laid_size = 0.0
struct __TextSnap:
    text = ""
    caret = 0
    anchor = 0
__text_edits: {str: __TextEdit} = {}

# (the text the program gives: one other than the field gave back puts the caret at its end (an
# area's at its start, scrolled to the top), and what undo would go back to is gone)
__te_sync = (st: mut __TextEdit, value: str, multi: bool = false) -> str:
    if value != st.text or st.caret > len(value) or st.anchor > len(value):
        st.text = value
        st.caret = len(value)
        if multi:
            st.caret = 0
            st.scroll = 0.0
        st.anchor = st.caret
        st.undo.clear()
        st.redo.clear()
        st.kind = 0
    value

# (its lines, wrapped at w (-1: one line), and where each character is, when the text changed)
__te_layout = (st: mut __TextEdit, v: str, w: f64, size: f64):
    if v == st.laid_of and w == st.laid_w and size == st.laid_size and st.xs.len() == len(v) + 1: return
    st.laid_of = v
    st.laid_w = w
    st.laid_size = size
    st.xs = __char_xs(v, size)
    if w < 0.0: st.lines = [(0, len(v))]
    else: st.lines = __te_wrap(v, st.xs, w)

# (lines no wider than w: each one's start, and its end, before its line break or where the next
# starts (after the spaces it broke at); a word wider than w broken where it reaches it)
__te_wrap = (s: str, xs: f64[], w: f64) -> (int, int)[]:
    out: (int, int)[]
    start = 0
    brk = -1                    # (where the line may break: after a space, or at a CJK character)
    i = 0
    loop i < len(s):
        if s[i] == '\n':
            out.push((start, i))
            start = i + 1
            brk = -1
            i += 1
            continue
        r = __next_char(s, i)
        if r.0 == c' ':
            brk = r.1
            i = r.1
            continue
        if __cjk(r.0) and i > start: brk = i
        if xs[r.1] - xs[start] > w and i > start:
            at = i
            if brk > start: at = brk
            out.push((start, at))
            start = at
            brk = -1
        if __cjk(r.0): brk = r.1
        i = r.1
    out.push((start, len(s)))
    out

# (the line the place i is on: the last starting at or before it)
__te_line = (lines: (int, int)[], i: int) -> int:
    k = 0
    loop j in 0.. and l in lines:
        if l.0 > i: break
        k = j
    k

# (where the caret goes at the end of line k: before a wrapped line's last space; a word broken
# in two, before its last character on this line)
__te_line_end = (s: str, lines: (int, int)[], k: int) -> int:
    l = lines[k]
    if k + 1 < lines.len() and lines[k + 1].0 == l.1 and l.1 > l.0:
        if s[l.1 - 1] == ' ': return l.1 - 1
        return __te_prev(s, l.1)
    l.1

# (the place nearest x (from the line's start) on line k)
__te_hit = (st: __TextEdit, s: str, k: int, x: f64) -> int:
    l = st.lines[k]
    e = __te_line_end(s, st.lines, k)
    x0 = st.xs[l.0]
    i = l.0
    loop i < e:
        j = __te_next(s, i)
        if x < (st.xs[i] + st.xs[j]) / 2.0 - x0: return i
        i = j
    e

# (the place under the point p, in the field's units; ox, oy: where the first line's text starts)
__te_at = (st: __TextEdit, v: str, p: vec2, ox: f64, oy: f64, lh: f64) -> int:
    k = 0
    if st.lines.len() > 1: k = clamp(int(floor((f64(p.y) - oy) / lh)), 0, st.lines.len() - 1)
    __te_hit(st, v, k, f64(p.x) - ox)

# (the mouse went down at `at`: the caret there (with shift, the selection to there); a second
# click soon after, the word there; a third, all of it (an area: the paragraph))
__te_press = (st: mut __TextEdit, v: str, at: int):
    now = elapsed()
    if now - st.click_t < 0.4 and st.clicks > 0 and not key_down(.shift): st.clicks += 1
    else: st.clicks = 1
    st.click_t = now
    st.caret = at
    if st.clicks == 1:
        if not key_down(.shift): st.anchor = at
        st.drag = true
    else if st.clicks == 2:
        wd = __te_word_at(v, at)
        st.anchor = wd.0
        st.caret = wd.1
    else:
        a = at
        loop a > 0 and v[a - 1] != '\n': a -= 1
        b = at
        loop b < len(v) and v[b] != '\n': b += 1
        st.anchor = a
        st.caret = b
    st.kind = 0
    st.goal_x = -1.0
    st.blink_t = now
    st.follow = true

# (the mouse held down after a press in it: the selection goes to where it is)
__te_drag = (st: mut __TextEdit, v: str, ox: f64, oy: f64, lh: f64):
    if not st.drag: return
    if not mouse_down(.left):
        st.drag = false
        return
    at = __te_at(st, v, __ui_ptr(), ox, oy, lh)
    if at != st.caret:
        st.caret = at
        st.follow = true
        st.blink_t = elapsed()

# (a field's single line: moved left as far as the caret needs to show in a box w wide, back at
# its start when it does not have the keyboard)
__te_follow_x = (st: mut __TextEdit, focused: bool, w: f64):
    if not focused:
        st.scroll = 0.0
        return
    cx = st.xs[st.caret]
    if cx - st.scroll > w - 2.0: st.scroll = cx - w + 2.0
    if cx < st.scroll: st.scroll = cx
    st.scroll = clamp(st.scroll, 0.0, max(st.xs[st.xs.len() - 1] - w + 2.0, 0.0))

# (lines first to last of the text, the first one's text at ox, oy: the selection behind them,
# and the caret, a thin bar blinking, while it has the keyboard)
__te_draw = (st: __TextEdit, v: str, ox: f64, oy: f64, lh: f64, size: f64, color: vec4, focused: bool, first: int, last: int):
    a = min(st.caret, st.anchor)
    b = max(st.caret, st.anchor)
    ck = __te_line(st.lines, st.caret)
    loop k in [first..last]:
        if k < 0 or k >= st.lines.len(): continue
        l = st.lines[k]
        y = oy + f64(k) * lh
        x0 = st.xs[l.0]
        if focused and a < b and b > l.0 and a <= l.1:
            sa = max(a, l.0)
            sb = min(b, l.1)
            sw = st.xs[sb] - st.xs[sa]
            if b > l.1 and k + 1 < st.lines.len() and st.lines[k + 1].0 > l.1: sw += size * 0.3     # (the line break, selected)
            rect(ox + st.xs[sa] - x0, y - (lh - size) * 0.5, sw, lh, __te_selection())
        if l.1 > l.0: text(v[l.0..l.1), vec2(f32(ox), f32(y)), size, color)
        if focused and k == ck and int((elapsed() - st.blink_t) * 2.0) % 2 == 0:
            cw = max(1.0, size * 0.08)
            rect(ox + st.xs[st.caret] - x0 - cw / 2.0, y - size * 0.08, cw, size * 1.16, color)

# (the selection's color: hud_style.selection, or, left as it is, the accent's, see-through)
__te_selection = () -> vec4:
    if hud_style.selection == vec4(1, 0.82, 0.4, 0.35): return with_alpha(hud_style.accent, 0.35)
    hud_style.selection

# (the place before the character before i, and after the one at i)
__te_prev = (s: str, i: int) -> int:
    j = max(i - 1, 0)
    loop j > 0 and int(s[j]) & 0xC0 == 0x80: j -= 1
    j
__te_next = (s: str, i: int) -> int:
    if i >= len(s): return len(s)
    __next_char(s, i).1

# (a byte of a word: a letter, a digit, _ or part of a character beyond ASCII)
__te_wordy = (c: u8) -> bool: c >= 128 or is_alnum(c) or c == '_'
__te_word_left = (s: str, i: int) -> int:
    j = i
    loop j > 0 and not __te_wordy(s[j - 1]): j -= 1
    loop j > 0 and __te_wordy(s[j - 1]): j -= 1
    j
__te_word_right = (s: str, i: int) -> int:
    j = i
    loop j < len(s) and not __te_wordy(s[j]): j += 1
    loop j < len(s) and __te_wordy(s[j]): j += 1
    j
# (the word at i, for a double click: or the one character there, a space or a mark)
__te_word_at = (s: str, i: int) -> (int, int):
    if (i < len(s) and __te_wordy(s[i])) or (i > 0 and __te_wordy(s[i - 1])):
        a = i
        loop a > 0 and __te_wordy(s[a - 1]): a -= 1
        b = i
        loop b < len(s) and __te_wordy(s[b]): b += 1
        return (a, b)
    (i, __te_next(s, i))

# (the keys that go with ctrl on Linux and Windows and cmd on a Mac (ctrl too, which a Mac's text
# boxes leave unused for these), either in a browser: k typed, shift held or not as asked, alt
# not held)
__te_shortcut = (k: Key, shift: bool = false) -> bool:
    key_typed(k) and __te_mod() and key_down(.shift) == shift and not key_down(.alt)
__te_mod = () -> bool:
    when TARGET == "macos" or TARGET == "wasm": return key_down(.ctrl) or key_down(.super)
    else: return key_down(.ctrl)
# (moving by words: ctrl, or alt (option) on a Mac; to the line's ends: cmd on a Mac)
__te_word_mod = () -> bool:
    when TARGET == "macos" or TARGET == "wasm": return key_down(.ctrl) or key_down(.alt)
    else: return key_down(.ctrl)
__te_line_mod = () -> bool:
    when TARGET == "macos" or TARGET == "wasm": return key_down(.super)
    else: return false

# (s as a field takes it: a line's characters, without control characters; an area's keeps its
# line breaks; tabs as four spaces)
__te_clean = (s: str, multi: bool) -> str:
    out = ""
    loop ch in chars(s):
        if ch == 10 or ch == 13:
            if not multi: break
            if ch == 10: out += "\n"
        else if ch == 9: out += "    "
        else if ch >= 32 and ch != 127: out += chr(ch)
    out

# (s, at most n characters of it)
__te_first = (s: str, n: int) -> str:
    i = 0
    k = 0
    loop i < len(s) and k < n:
        i = __te_next(s, i)
        k += 1
    s[..i)

# (the selection replaced with ins, at most max_chars in all: kind 1 typing, 2 deleting, a run of
# which is one undo step, 0 a step of its own)
__te_put = (st: mut __TextEdit, v: str, ins: str, max_chars: int, kind: int) -> str:
    a = min(st.caret, st.anchor)
    b = max(st.caret, st.anchor)
    put = __te_first(ins, max_chars - char_count(v) + char_count(v[a..b)))
    if a == b and len(put) == 0: return v
    now = elapsed()
    if kind == 0 or kind != st.kind or now - st.kind_t > 1.0:
        st.undo.push(__TextSnap(v, st.caret, st.anchor))
        if st.undo.len() > 100: st.undo.remove_at(0)
    st.redo.clear()
    st.kind = kind
    st.kind_t = now
    st.caret = a + len(put)
    st.anchor = st.caret
    st.follow = true
    st.goal_x = -1.0
    st.blink_t = now
    v[..a) + put + v[b..]

# (the caret to i, the selection kept from where it was with shift)
__te_move = (st: mut __TextEdit, i: int, select: bool, keep_x: bool = false):
    st.caret = i
    if not select: st.anchor = i
    st.kind = 0
    st.follow = true
    st.blink_t = elapsed()
    if not keep_x: st.goal_x = -1.0

# (the keys of a field with the keyboard: typing, the caret (with shift: selecting), deleting,
# the clipboard and undo; the text as they leave it. updown: up and down move the caret (a menu's
# field leaves them to the menu); w: an area's width (-1: a field's single line))
__te_keys = (st: mut __TextEdit, value: str, max_chars: int, multi: bool, updown: bool, w: f64, size: f64, page: int) -> str:
    v = value
    sh = key_down(.shift)
    word = __te_word_mod()
    typed = __te_clean(text_input(), false)
    if len(typed) > 0:
        kind = 1
        if st.caret != st.anchor: kind = 0
        v = __te_put(st, v, typed, max_chars, kind)
    if __platform_pasted(): v = __te_put(st, v, __te_clean(clipboard(), multi), max_chars, 0)
    if multi and key_typed(.enter) and not __te_mod(): v = __te_put(st, v, "\n", max_chars, 1)
    if key_typed(.backspace) or key_typed(.delete):
        if st.caret == st.anchor:
            if key_typed(.backspace) and word: st.anchor = __te_word_left(v, st.caret)
            else if key_typed(.backspace): st.anchor = __te_prev(v, st.caret)
            else if word: st.anchor = __te_word_right(v, st.caret)
            else: st.anchor = __te_next(v, st.caret)
            v = __te_put(st, v, "", max_chars, 2)
        else: v = __te_put(st, v, "", max_chars, 0)
    a = min(st.caret, st.anchor)
    b = max(st.caret, st.anchor)
    if __te_shortcut(.a):
        st.anchor = 0
        __te_move(st, len(v), true)
    if (__te_shortcut(.c) or __te_shortcut(.x)) and a < b:
        set_clipboard(v[a..b))
        if __te_shortcut(.x): v = __te_put(st, v, "", max_chars, 0)
    if __te_shortcut(.z) and st.undo.len() > 0:
        st.redo.push(__TextSnap(v, st.caret, st.anchor))
        s = st.undo.pop()
        v = s.text
        st.caret = s.caret
        st.anchor = s.anchor
        st.kind = 0
        st.follow = true
    else if (__te_shortcut(.z, true) or __te_shortcut(.y)) and st.redo.len() > 0:
        st.undo.push(__TextSnap(v, st.caret, st.anchor))
        s = st.redo.pop()
        v = s.text
        st.caret = s.caret
        st.anchor = s.anchor
        st.kind = 0
        st.follow = true
    # (the caret: left and right a character, a word or to the line's ends; with a selection and
    # no shift, to its start or end)
    __te_layout(st, v, w, size)
    k = __te_line(st.lines, st.caret)
    if key_typed(.left):
        if st.caret != st.anchor and not sh: __te_move(st, min(st.caret, st.anchor), false)
        else if __te_line_mod(): __te_move(st, st.lines[k].0, sh)
        else if word: __te_move(st, __te_word_left(v, st.caret), sh)
        else: __te_move(st, __te_prev(v, st.caret), sh)
    if key_typed(.right):
        if st.caret != st.anchor and not sh: __te_move(st, max(st.caret, st.anchor), false)
        else if __te_line_mod(): __te_move(st, __te_line_end(v, st.lines, k), sh)
        else if word: __te_move(st, __te_word_right(v, st.caret), sh)
        else: __te_move(st, __te_next(v, st.caret), sh)
    k = __te_line(st.lines, st.caret)
    if key_typed(.home):
        if key_down(.ctrl): __te_move(st, 0, sh)
        else: __te_move(st, st.lines[k].0, sh)
    if key_typed(.end):
        if key_down(.ctrl): __te_move(st, len(v), sh)
        else: __te_move(st, __te_line_end(v, st.lines, k), sh)
    if updown:
        go = 0
        if key_typed(.up): go = -1
        if key_typed(.down): go = 1
        if key_typed(.page_up): go = -page
        if key_typed(.page_down): go = page
        if go != 0 and __te_line_mod():
            # (cmd+up and cmd+down on a Mac: the start and the end)
            if go < 0: __te_move(st, 0, sh)
            else: __te_move(st, len(v), sh)
        else if go != 0:
            k = __te_line(st.lines, st.caret)
            if st.goal_x < 0.0: st.goal_x = st.xs[st.caret] - st.xs[st.lines[k].0]
            to = k + go
            if to < 0: __te_move(st, 0, sh, true)
            else if to >= st.lines.len(): __te_move(st, len(v), sh, true)
            else: __te_move(st, __te_hit(st, v, to, st.goal_x), sh, true)
    v
