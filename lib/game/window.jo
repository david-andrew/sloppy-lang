    __wayland = false            # connected through wayland.jo

    # a missing display or driver is an environment problem, not a program bug: say so and exit
    __need = (ok: bool, what: str):
        if not ok:
            eprint("error: cannot open a window: {what}")
            exit(1)

    __platform_open = ():
        global __soft, __vk, __wayland, __wm_delete, __xdpy, __xev, __xproto, __xscr, __xwin
        __soft = __soft_kept or (env("SLOPPY_SOFTWARE") ?? "") == "1"
        # (the software renderer with no display to show it on: frames drawn, no window, as for
        # a benchmark with SLOPPY_FRAMES and SLOPPY_STATS)
        no_display = env("WAYLAND_DISPLAY") == none and env("DISPLAY") == none
        headless = __soft and (env("SLOPPY_SCREENSHOT") != none or no_display)
        # (a screenshot run through Vulkan needs no display: no window, frames are only drawn)
        if not __soft and __vk_wanted() and env("SLOPPY_SCREENSHOT") != none and env("WAYLAND_DISPLAY") == none and env("DISPLAY") == none:
            why = __vk_open("", () -> int: 0)
            if len(why) == 0:
                __vk = true
                return
            __vk_note("{why}; using the software renderer")
            __soft = true
            headless = true
        # Wayland first where it is running (SLOPPY_PLATFORM=x11 or wayland chooses)
        plat = env("SLOPPY_PLATFORM") ?? ""
        if plat != "x11" and (env("WAYLAND_DISPLAY") != none or plat == "wayland") and not headless:
            why = __wl_open(__win_title, __win_w, __win_h)
            if len(why) == 0:
                __wayland = true
                if not __soft and __lw_on and __vk_wanted():
                    why2 = __vk_open("VK_KHR_wayland_surface", __vk_wayland_surface)
                    if len(why2) == 0: __vk = true
                    else: __vk_note("{why2}; using OpenGL")
                if not __soft and not __vk:
                    # (GPU arrays may have made the context already: keep it, their data lives there)
                    why2 = ""
                    if __egl_dpy == null: why2 = __egl_open_surfaceless()
                    else: __gl_screen_resize(__win_w, __win_h)
                    if len(why2) > 0:
                        eprint("note: {why2}; using the software renderer")
                        __soft = true
                if __soft: __sw_init_window(__win_w, __win_h)
                return
            if plat == "wayland": __need(false, why)
        if not lib_available("libX11.so.6") or (env("SLOPPY_X11") ?? "") == "protocol":
            # no Xlib: talk to the X server directly and render in software
            __soft = true
            why = __xp_open(__win_title, __win_w, __win_h)
            if len(why) == 0:
                __xproto = true
                # (the request must fit in the server's longest)
                icon = __icon_argb(__xp_maxreq - 8)
                if icon.len() > 0:
                    v: u8[]
                    loop x in icon: __put32(v, x)
                    __xp_property(__xp_intern("_NET_WM_ICON"), 6, 32, v)     # CARDINAL
            # a screenshot run can render without any display
            else if not headless: __need(false, "libX11 is not available and {why}")
