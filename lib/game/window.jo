# Windows, the frame loop and input. Linux: Wayland (or X11), drawn with Vulkan (or OpenGL ES 3,
# or the software renderer: SLOPPY_SOFTWARE=1); Windows: Win32 and Vulkan or OpenGL; macOS: Cocoa
# and OpenGL. The system's libraries are loaded at runtime. Web: a <canvas> with WebGL2.

enum Key:
    unknown, a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z,
    n0, n1, n2, n3, n4, n5, n6, n7, n8, n9,
    space, enter, escape, tab, backspace, delete, insert, home, end, page_up, page_down,
    left, right, up, down, shift, ctrl, alt, super,
    f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12,
    minus, equals, comma, period, slash, semicolon, quote, lbracket, rbracket, backslash, grave,
    kp0, kp1, kp2, kp3, kp4, kp5, kp6, kp7, kp8, kp9, kp_period, kp_plus, kp_minus, kp_star, kp_slash

enum Mouse: left, middle, right

const __NKEYS = 128

__win_open = false
__win_w = 1280
__win_h = 720
__win_title = ""                # "": the program's name
__win_close = false
__key_down: bool[]
__key_pressed: bool[]
__key_released: bool[]
__key_typed: bool[]             # pressed, or repeated by holding it down
__mouse_x = 0.0
__mouse_y = 0.0
__mouse_dx = 0.0
__mouse_dy = 0.0
__mouse_wheel = 0.0
__mouse_btn: bool[]
__mouse_pressed: bool[]
__mouse_released: bool[]
__text_input = ""
# (screenshot runs: the input as the last frame left it, so that only SLOPPY_INPUT changes it)
__kept_keys: bool[]
__kept_btns: bool[]
__kept_mouse = vec2(0, 0)
__time0 = time()              # (from the start; from the window opening, once it has)
__fixed_step = false          # screenshot runs advance exactly 1/60 s per frame
__pace_real_time = false      # (and at 60 frames a second, not faster: a networked game's)
# (SLOPPY_INPUT's punctuation keys: each name, then the character it types and shifted)
const __SCRIPT_PUNCT = " minus -_ equals =+ comma ,< period .> slash /? semicolon ;: quote '\" lbracket [{{ rbracket ]}} backslash \\| grave `~ "
__frame_count = 0
__dt = 0.0
__raw_dt = 0.0                # (the frame's time, time_scale or not: key_repeat's)
__fps = 0.0

__input_init = ():
    global __key_down, __key_pressed, __key_released, __key_typed, __mouse_btn, __mouse_pressed, __mouse_released
    if __key_down.len() == 0:
        __key_down = fill(false, __NKEYS)
        __key_pressed = fill(false, __NKEYS)
        __key_released = fill(false, __NKEYS)
        __key_typed = fill(false, __NKEYS)
        __mouse_btn = fill(false, 8)
        __mouse_pressed = fill(false, 8)
        __mouse_released = fill(false, 8)

# (repeat: the key was held down long enough to repeat, as in a text field)
__key_event = (k: int, down: bool, repeat: bool = false):
    if k <= 0 or k >= __NKEYS: return
    if down:
        if not __key_down[k]: __key_pressed[k] = true
        if not __key_down[k] or repeat: __key_typed[k] = true
        __key_down[k] = true
    else:
        if __key_down[k]: __key_released[k] = true
        __key_down[k] = false

__mouse_event = (b: int, down: bool):
    if b < 0 or b >= 8: return
    if down:
        if not __mouse_btn[b]: __mouse_pressed[b] = true
        __mouse_btn[b] = true
    else:
        if __mouse_btn[b]: __mouse_released[b] = true
        __mouse_btn[b] = false

__input_end_frame = ():
    global __kept_btns, __kept_keys, __kept_mouse, __mouse_dx, __mouse_dy, __mouse_wheel, __text_input
    loop mut x in __key_pressed: x = false
    loop mut x in __key_released: x = false
    loop mut x in __key_typed: x = false
    loop mut x in __mouse_pressed: x = false
    loop mut x in __mouse_released: x = false
    __mouse_dx = 0.0
    __mouse_dy = 0.0
    __mouse_wheel = 0.0
    __text_input = ""
    if __fixed_step:
        __kept_keys = __key_down
        __kept_btns = __mouse_btn
        __kept_mouse = vec2(__mouse_x, __mouse_y)

# (screenshot runs are the same each time: what the desktop sent since the last frame, keys,
# buttons, the mouse, typing, is undone; SLOPPY_INPUT's events come after)
__ignore_real_input = ():
    global __key_down, __mouse_btn, __mouse_dx, __mouse_dy, __mouse_wheel, __mouse_x, __mouse_y, __text_input
    if __kept_keys.len() == 0: return
    __key_down = __kept_keys
    __mouse_btn = __kept_btns
    __mouse_x = f64(__kept_mouse.x)
    __mouse_y = f64(__kept_mouse.y)
    loop mut x in __key_pressed: x = false
    loop mut x in __key_released: x = false
    loop mut x in __key_typed: x = false
    loop mut x in __mouse_pressed: x = false
    loop mut x in __mouse_released: x = false
    __mouse_dx = 0.0
    __mouse_dy = 0.0
    __mouse_wheel = 0.0
    __text_input = ""

# ---------------- public input API ----------------
# true while the key is held
key_down = (k: Key) -> bool:
    __input_init()
    __key_down[int(k)]
# true only in the frame the key was pressed
key_pressed = (k: Key) -> bool:
    __input_init()
    if __fx_in: return __fx_keys[int(k)]
    __key_pressed[int(k)]
key_released = (k: Key) -> bool:
    __input_init()
    if __fx_in: return __fx_keys[__NKEYS + int(k)]
    __key_released[int(k)]
# true in the frame the key was pressed, and again each time it repeats while held down, as the
# desktop repeats keys (for moving through text); characters typed arrive through text_input()
key_typed = (k: Key) -> bool:
    __input_init()
    __key_typed[int(k)]
# true in the frame Ctrl and k are pressed together, and as it repeats (on a Mac and in a browser
# Cmd too), for a tool's keys: `if shortcut(.s): save()`; shift: with Shift held too, as
# Ctrl+Shift+Z (without it, Shift must not be held). Browsers keep some for themselves (Ctrl+N,
# Ctrl+W, Ctrl+T) and the page never sees them.
shortcut = (k: Key, shift: bool = false) -> bool:
    held = key_down(.ctrl)
    when TARGET == "macos" or TARGET == "wasm": held = held or key_down(.super)
    held and key_down(.shift) == shift and not key_down(.alt) and key_typed(k)
# (in the 2D units of the screen: see screen_size and screen.jo)
mouse_pos = () -> vec2: __to_units(__mouse_x, __mouse_y)
mouse_delta = () -> vec2:
    __screen_layout()
    vec2(f32(__mouse_dx / __map_sx), f32(__mouse_dy / __map_sy))
mouse_wheel = () -> f64: __mouse_wheel
mouse_down = (b: Mouse) -> bool:
    __input_init()
    __mouse_btn[int(b)]
mouse_pressed = (b: Mouse) -> bool:
    __input_init()
    if __fx_in: return __fx_btns[int(b)]
    __mouse_pressed[int(b)]
mouse_released = (b: Mouse) -> bool:
    __input_init()
    if __fx_in: return __fx_btns[8 + int(b)]
    __mouse_released[int(b)]
# characters typed this frame
text_input = () -> str: __text_input
# the text pasted this frame (ctrl+V, cmd+V on a Mac, a web page's paste, a text field's Paste
# button on a phone): the clipboard's text then; "" in other frames. For a widget of a game's own
# (the hud_ text fields take it themselves)
pasted_text = () -> str:
    if not __platform_pasted(): return ""
    clipboard()

# ---------------- a fixed time step ----------------
# step(dt) at a fixed rate, `rate` times a second whatever the frame rate: as many times as the
# time since the last frame holds (none in some frames of a 144 Hz screen, two in some at 30), the
# rest kept for the next frame. Physics and jumps come out the same at any frame rate (Godot's
# _physics_process, Unity's FixedUpdate):
#   update = (dt: f64): fixed_update(dt, physics)
#   physics = (dt: f64):                 # dt: 1 / 60, always
#       if action_pressed("jump"): vel.y = -JUMP
#       ...
# In step, a press (key_pressed, mouse_pressed, gamepad_pressed, action_pressed, and their
# released) is seen in one step only, the first after it, even one that came in a frame with no
# step. It gives back how far the time is into the next step (0 to 1): to draw what moves
# between where the last two steps put it, `mix(prev_pos, pos, f32(k))`.
fixed_update = (dt: f64, step: (f64) -> void, rate: f64 = 60.0) -> f64:
    global __fx_acc, __fx_h, __fx_in, __fx_steps
    __input_init()
    h = 1.0 / max(rate, 1.0)
    __fx_collect()
    __fx_acc += dt
    n = 0
    loop __fx_acc >= h - 1e-9:          # (a hair under h, from rounding, is a step)
        __fx_acc -= h
        n += 1
        # (a long stall: the steps it would take are dropped, not run all at once)
        if n > 8:
            __fx_acc = 0.0
            break
        __fx_steps += 1
        __fx_h = h
        __fx_in = true
        step(h)
        __fx_in = false
        # (each press once: the steps after the first see none)
        if n == 1: __fx_clear()
    max(__fx_acc, 0.0) / h

__fx_acc = 0.0
__fx_in = false                 # (in a step: the presses below are the ones seen)
__fx_steps = 0                  # (steps so far, and how long each is: key_repeat's time in them)
__fx_h = 1.0 / 60.0
__fx_keys: bool[]               # keys pressed, then released, since the last step
__fx_btns: bool[]               # mouse buttons
__fx_pad: bool[]                # gamepad buttons pressed, then released
__fx_sticks: bool[]             # sticks pushed past halfway (pad, axis, way)

# (this frame's presses, kept until a step sees them)
__fx_collect = ():
    if __fx_keys.len() == 0: __fx_clear()
    loop i in [0..__NKEYS):
        if __key_pressed[i]: __fx_keys[i] = true
        if __key_released[i]: __fx_keys[__NKEYS + i] = true
    loop i in [0..8):
        if __mouse_pressed[i]: __fx_btns[i] = true
        if __mouse_released[i]: __fx_btns[8 + i] = true
    loop p in [0..MAX_GAMEPADS):
        loop b in [0..15):
            k = p * 15 + b
            if __pad_down[k] and not __pad_prev[k]: __fx_pad[k] = true
            if __pad_prev[k] and not __pad_down[k]: __fx_pad[MAX_GAMEPADS * 15 + k] = true
        loop a in [0..6):
            loop w in [0..2):
                d = 2 * w - 1
                if __ctl_stick(p, a, d, false) >= 0.5 and __ctl_stick(p, a, d, true) < 0.5: __fx_sticks[(p * 6 + a) * 2 + w] = true

__fx_clear = ():
    global __fx_btns, __fx_keys, __fx_pad, __fx_sticks
    __fx_keys = fill(false, 2 * __NKEYS)
    __fx_btns = fill(false, 16)
    __fx_pad = fill(false, 2 * MAX_GAMEPADS * 15)
    __fx_sticks = fill(false, MAX_GAMEPADS * 12)

# (a stick pushed past halfway one way (dir 1 or -1) in this frame, or, in a fixed step, since
# the last one)
__stick_pressed = (p: int, a: int, d: int) -> bool:
    if __fx_in:
        if p < 0 or p >= MAX_GAMEPADS or a < 0 or a >= 6: return false
        w = 0
        if d > 0: w = 1
        return __fx_sticks[(p * 6 + a) * 2 + w]
    __ctl_stick(p, a, d, false) >= 0.5 and __ctl_stick(p, a, d, true) < 0.5

# arrows/WASD (or a gamepad's left stick and d-pad) as a direction vector (y down)
input_axis = () -> vec2:
    v = vec2(0, 0)
    if key_down(.left) or key_down(.a) or gamepad_down(.left): v.x -= 1
    if key_down(.right) or key_down(.d) or gamepad_down(.right): v.x += 1
    if key_down(.up) or key_down(.w) or gamepad_down(.up): v.y -= 1
    if key_down(.down) or key_down(.s) or gamepad_down(.down): v.y += 1
    s = left_stick()
    if length(s) > length(v): v = s
    v

# The screen's size in 2D drawing units: the size given to window() (the design size),
# whatever the window's real size; screen.jo says how it maps to the window (screen_fit).
# pixel_size() is the window's real size.
screen_width = () -> int:
    __screen_layout()
    int(__units_w)
screen_height = () -> int:
    __screen_layout()
    int(__units_h)
screen_size = () -> vec2:
    __screen_layout()
    vec2(f32(__units_w), f32(__units_h))
pixel_size = () -> vec2: vec2(f32(__win_w), f32(__win_h))
# width / height of the picture 3D draws into (for a projection: perspective(fov, aspect_ratio(),
# ...)): the window's, or the design area's when the screen fit shows just that (screen.jo)
aspect_ratio = () -> f64:
    __screen_layout()
    if __canvas_on and __canvas_whole: return (__units_w * __map_sx) / max(__units_h * __map_sy, 1.0)
    f64(__win_w) / f64(max(__win_h, 1))
# the part of the 2D plane the screen shows, as a Rect (x, y, w, h): with screen_fit(.expand)
# (the default) the design area centered in a window of any shape and what is around it (draw
# backgrounds over this to fill the window); with bars, just the design area
visible_rect = () -> Rect:
    __screen_layout()
    u = __screen_units()
    Rect(u.x, u.y, u.z - u.x, u.w - u.y)

__design_w = 1280
__design_h = 720
frame_time = () -> f64: __dt
__time_scale = 1.0
# how fast the game's time runs: update gets dt times this (0.5: slow motion, 0: paused, while
# drawing, input and sound go on); frame_time() is the scaled dt, fps() and elapsed() are not
time_scale = (s: f64):
    global __time_scale
    __time_scale = max(s, 0.0)
# the scale set with time_scale (1 to start with)
time_scale = () -> f64: __time_scale
fps = () -> f64:
    # (before the first half second is measured: what the frames so far say)
    if __fps == 0.0 and __fps_n > 0 and __fps_acc > 0.0: return f64(__fps_n) / __fps_acc
    __fps
elapsed = () -> f64:
    if __fixed_step: return f64(__frame_count) / 60.0
    time() - __time0
frame_number = () -> int: __frame_count
# end the game (the window closes once this frame is done). A web page cannot close itself:
# there it does nothing (can_quit() is false, so a menu can leave its Quit button out)
quit = ():
    global __win_close
    __win_close = true
can_quit = () -> bool:
    when TARGET == "wasm": return false
    else: return true

# ---- frames drawn on demand: tools, editors, forms ----
# A game draws 60 frames a second; a tool that waits for its user need not. With
# redraw_on_input(), a frame is drawn only when something may have changed: a key, the mouse
# moving, a click or the wheel, text typed, the window resized or focused, files dropped, a file
# dialog's answer (and two frames after each, for what a frame's drawing sets off), at the time
# redraw_after asked for, or after request_redraw(). In between the program sleeps (sound still
# plays). update's dt is the time since the last frame (0.1 s at most). Something that moves on
# its own (an animation, a timer shown, a tween) calls request_redraw() in each frame it is not
# done in (tweens, hud_scroll's gliding and a text field's blinking caret do so themselves).
# While the program fetches from the network or has tasks, a frame comes at least 10 times a
# second, so that their answers are seen. Screenshot runs draw every frame as usual. On the web
# too: the page asks for no animation frames while it waits.
#   redraw_on_input()
#   draw = (): ...                      # a frame only as something happens
redraw_on_input = (on: bool = true):
    global __lazy
    __lazy = on

# draw another frame soon, even with nothing typed or moved (redraw_on_input): while an animation
# runs, once in each frame
request_redraw = ():
    global __redraw_asked
    __redraw_asked = true

# draw a frame `seconds` from now at the latest (redraw_on_input): a clock that shows the time, a
# message that goes away, a caret that blinks
redraw_after = (seconds: f64):
    global __redraw_at
    t = time() + max(seconds, 0.0)
    if __redraw_at < 0.0 or t < __redraw_at: __redraw_at = t

__lazy = false
__redraw_asked = false
__redraw_at = -1.0                  # (time(): when a frame is due; -1: none asked for)
__lazy_extra = 0                    # (frames still to draw after the last input)
__lazy_last = 0.0                   # (when the last frame began)
__lazy_mx = -1.0                    # (the pointer, the window's size and focus at the last frame)
__lazy_my = -1.0
__lazy_w = 0
__lazy_h = 0
__lazy_focus = true
__lazy_poke = false                 # (something came that is no key, nor the mouse: files dropped)

# (whether input came since the last frame)
__lazy_input = () -> bool:
    __input_init()
    if __lazy_poke or len(__text_input) > 0 or __mouse_wheel != 0.0 or __mouse_dx != 0.0 or __mouse_dy != 0.0: return true
    if __mouse_x != __lazy_mx or __mouse_y != __lazy_my or __win_w != __lazy_w or __win_h != __lazy_h or __win_focused != __lazy_focus: return true
    loop k in [0..__NKEYS):
        if __key_pressed[k] or __key_released[k] or __key_typed[k]: return true
    loop b in [0..8):
        if __mouse_pressed[b] or __mouse_released[b]: return true
    false

# (whether a frame is due now: always, but with redraw_on_input outside screenshot runs)
__lazy_due = () -> bool:
    if not __lazy or __fixed_step or __win_close or __redraw_asked or __lazy_extra > 0: return true
    if __redraw_at >= 0.0 and time() >= __redraw_at: return true
    if __lazy_input(): return true
    if __pad_moved(): return true
    # (answers on their way, tasks, a file watched: looked at 10 times a second)
    busy = __pace_real_time or __tasks_on or __dialogs.len() > 0
    when WATCH:
        busy = true
    busy and time() - __lazy_last >= 0.1

# (a frame begins: what it was due to is taken)
__lazy_begin = ():
    global __lazy_extra, __lazy_focus, __lazy_h, __lazy_last, __lazy_mx, __lazy_my, __lazy_poke, __lazy_w, __redraw_asked, __redraw_at
    if not __lazy: return
    if __lazy_input(): __lazy_extra = 2
    else if __lazy_extra > 0: __lazy_extra -= 1
    __lazy_poke = false
    __redraw_asked = false
    if __redraw_at >= 0.0 and time() >= __redraw_at: __redraw_at = -1.0
    __lazy_last = time()
    __lazy_mx = __mouse_x
    __lazy_my = __mouse_y
    __lazy_w = __win_w
    __lazy_h = __win_h
    __lazy_focus = __win_focused

# (a native loop, before each frame: asleep until one is due, the window's events read and the
# sound mixed meanwhile)
__lazy_wait = ():
    when TARGET != "wasm":
        if not __lazy_due(): __out_flush()         # (what the last frame printed, shown now)
        loop not __lazy_due():
            sleep(0.008)
            __platform_poll()
            __dialogs_poll()
            __audio_update()
    __lazy_begin()

# fill the screen with the window (and back); also in a web page
__fullscreen = false
set_fullscreen = (on: bool = true):
    global __fullscreen
    if not __win_open or on == __fullscreen: return
    __fullscreen = on
    __platform_fullscreen(on)
toggle_fullscreen = (): set_fullscreen(not __fullscreen)
is_fullscreen = () -> bool: __fullscreen
# whether set_fullscreen can fill the screen: false in an iPhone's Safari, which has no fullscreen
# for a page's canvas (a game can leave its Fullscreen button out there)
can_fullscreen = () -> bool:
    when TARGET == "wasm": return __web_can_fullscreen() != 0
    else: return true

# the text on the system clipboard ("" if none, or not text). In a web page the browser lets a
# page read it only as it is pasted: this is the text last pasted (ctrl+V, or a text field's
# Paste button on a phone) into the page.
clipboard = () -> str: __platform_clipboard()
set_clipboard = (s: str): __platform_set_clipboard(s)

# the system's menu for sending text to another app (a chat, Messages, mail), where there is one:
# a web page on a phone, and in some desktop browsers. In a page the menu opens as the tap or
# click that asked ends (browsers allow it only then)
#   if can_share() and hud_button(r, "Share"): share(invite_link)
can_share = () -> bool: __platform_can_share()
share = (text: str): __platform_share(text)

# a phone held upright, playing a game made for a screen wider than tall: a note over the game
# to turn the phone sideways (on to start with; the game goes on under it). Off for a game laid
# out for a phone either way up (visible_rect says what shows).
sideways_hint = (on: bool):
    global __sideways_on
    __sideways_on = on
__sideways_on = true

# the other way: a phone held sideways, playing a game made for a screen taller than wide (as
# window("...", 360, 640)): a note to turn the phone upright (on to start with); off for a game
# laid out for both
upright_hint = (on: bool):
    global __upright_on
    __upright_on = on
__upright_on = true

# lock the mouse pointer to the window and hide it, for mouse look: the pointer stays put and
# its motion keeps arriving through mouse_delta(). false where the platform cannot. (A web
# page gets the lock at the next click into it, as browsers require; Escape releases it there.)
mouse_lock = (on: bool = true) -> bool:
    global __mouse_lock_want
    __mouse_lock_want = on
    if not __win_open: return true
    __platform_mouse_lock(on)

# (in a screenshot run, what the game asked for: the desktop's focus coming and going would make
# the run differ from one time to the next)
is_mouse_locked = () -> bool: __mouse_lock_want and (__fixed_step or __platform_mouse_locked())

# the window (or the web page) has the keyboard's focus: false while the player is in another
# window or tab, as after a click outside an itch.io frame (a game may pause then)
window_focused = () -> bool: __fixed_step or __win_focused
__win_focused = true

# the fingers on a touch screen (a phone's, in a web page): where each is, in the screen's units
# as mouse_pos, in the order they landed. The first finger also is the mouse, its left button
# held while it is down, so a game made for the mouse works with one finger; more fingers (on
# screen buttons: left, right, jump) are only here. Empty without a touch screen.
touches = () -> vec2[]:
    out: vec2[]
    loop t in __touch_pos: out.push(__to_units(f64(t.x), f64(t.y)))
    out

# each finger's number, in the order of touches(): the same for as long as that finger stays
# down, and another for the next one to land, so a game can follow each finger from frame to
# frame (what it landed on, how far it moved since the last frame: a drag that turns a camera)
#   loop k in 0.. and id in touch_ids(): at = touches()[k]
touch_ids = () -> int[]: __touch_ids

# whether the pointer is a finger: the last pointer input was a touch, not the mouse (a finger
# lifted leaves mouse_pos where it was: hover highlights mean nothing then)
touch_input = () -> bool: __touch_last

# whether the screen is a touch screen, its main pointer a finger (a phone or a tablet: a page
# asks the browser), known before the first touch: on-screen buttons from the start, say.
# touch_input() says whether the last input was a finger
touch_device = () -> bool: __platform_finger() or __touch_env
__touch_env = false

__touch_ids: int[]
__touch_pos: vec2[]
__touch_last = false

# ---- a press of the left button (or of the first finger): taps, drags, swipes ----
__press_x = 0.0                 # where it went down (the window's pixels)
__press_y = 0.0
__press_time = -10.0
__press_frame = -10
__press_finger = false          # (it was a finger)
__press_far = false             # it went farther from there than a finger wobbles (10 points)
__press_taken = false           # a scrolling list moved with it, or it was a long press: no tap
__press_on_hud = false          # (it landed on a hud_ box)
__long_press_frame = -10

# (each frame, before update: a press starting, and how far it went)
__press_track = ():
    global __press_far, __press_finger, __press_frame, __press_on_hud, __press_taken, __press_time, __press_x, __press_y
    __input_init()
    if __mouse_pressed[0]:
        __press_x = __mouse_x
        __press_y = __mouse_y
        __press_time = elapsed()
        __press_frame = __frame_count
        __press_finger = __touch_last
        __press_far = false
        __press_taken = false
        __press_on_hud = hud_hovered()
    if (__mouse_btn[0] or __mouse_released[0]) and not __press_far:
        dx = __mouse_x - __press_x
        dy = __mouse_y - __press_y
        d = 10.0 * pixel_ratio()
        __press_far = dx * dx + dy * dy > d * d

# (where the press went down, in 2D units)
__press_pos = () -> vec2: __to_units(__press_x, __press_y)

# (whether letting go of the press is a tap, a click: a finger that moved away is a drag, and a
# press a list scrolled with is the list's)
__press_tap = () -> bool: not __press_taken and not (__press_finger and __press_far)

# the press now held (of the left button, or a finger) is the game's own, for a drag of its own:
# a hud_scroll list it went down in does not move with it, and letting go of it clicks no button.
# Call it in the frame it goes down (on mouse_pressed), as the drag starts:
#   if mouse_pressed(.left) and contains(row, mouse_pos()):
#       dragging = i
#       claim_press()
claim_press = ():
    global __press_taken
    __press_taken = true

# whether the press now held was claimed (claim_press), or moved a hud_scroll list
press_claimed = () -> bool: __press_taken

# a drag of a finger (or the mouse) that just ended, 30 points long or more: which way it went
# most, vec2(-1, 0) left, vec2(1, 0) right, vec2(0, -1) up or vec2(0, 1) down, in the frame it
# lets go; none otherwise, and for a drag begun on a hud_ box or one a scrolling list moved with
#   if let d = swipe(): slide(int(d.x), int(d.y))
swipe = () -> vec2?:
    if not mouse_released(.left) or __press_taken or __press_on_hud: return none
    dx = __mouse_x - __press_x
    dy = __mouse_y - __press_y
    d = 30.0 * pixel_ratio()
    if dx * dx + dy * dy < d * d: return none
    if abs(dx) > abs(dy): return vec2(f32(sign(dx)), 0)
    vec2(0, f32(sign(dy)))

# true once, in the frame a finger (or the left mouse button) has been held down `seconds` without
# moving: what it is on, said more about, say. Letting go after it is no tap of a button
long_press = (seconds: f64 = 0.5) -> bool:
    global __long_press_frame, __press_taken
    if __long_press_frame == __frame_count: return true
    if not mouse_down(.left) or __press_far or __press_taken or elapsed() - __press_time < seconds: return false
    __press_taken = true
    __long_press_frame = __frame_count
    true

# ---- points, a phone's notch, the design size: one layout for screens of any size ----

# how many of the window's pixels make a point (a page's CSS pixel: about 1/160 inch on a phone,
# 1/96 on a desktop screen): the page's devicePixelRatio as it is drawn, or the desktop's scale
# (Wayland's, a Retina Mac's, Windows'), 1 without one
pixel_ratio = () -> f64:
    if __pixel_ratio_env > 0.0: return __pixel_ratio_env
    max(__platform_pixel_ratio(), 0.25)
__pixel_ratio_env = -1.0

# a point's size in 2D units: what must be the same size to a finger or an eye on any screen, a
# phone's or a desktop's, is sized in these (a button 48 * css_pixel() tall fits a finger; text
# 16 * css_pixel() high reads as a page's)
css_pixel = () -> f64:
    __screen_layout()
    pixel_ratio() / __map_sy

# the part of visible_rect() clear of a phone's notch, rounded corners and home bar (in a page on
# such a phone; all of visible_rect() elsewhere): what must be seen or tapped goes inside it,
# backgrounds over all of visible_rect()
safe_rect = () -> Rect:
    v = visible_rect()
    k = pixel_ratio()
    i = __safe_insets
    a = __to_units(f64(i.w) * k, f64(i.x) * k)
    b = __to_units(f64(__win_w) - f64(i.y) * k, f64(__win_h) - f64(i.z) * k)
    x0 = max(a.x, v.x)
    y0 = max(a.y, v.y)
    x1 = min(b.x, v.x + v.w)
    y1 = min(b.y, v.y + v.h)
    Rect(x0, y0, max(x1 - x0, 0), max(y1 - y0, 0))
__safe_insets = vec4(0, 0, 0, 0)            # (top, right, bottom, left, in points)

# change the design size (the 2D units, as given to window()) while the game runs: one layout for
# a phone held upright, another for a screen wider than tall, say (the window keeps its size;
# screen_fit says how the new units fill it), at once: in update, before drawing (with a
# letterbox fit or a fixed resolution, from the next frame)
#   p = pixel_size() / f32(pixel_ratio())           # the screen in points
#   if p.y > p.x: design_size(360, 640) else: design_size(1280, 720)
design_size = (w: int, h: int):
    global __design_h, __design_w
    if max(w, 1) == __design_w and max(h, 1) == __design_h: return
    __design_w = max(w, 1)
    __design_h = max(h, 1)
    # (the frame being drawn straight to the window takes it too)
    if __win_open and __cur_target < 0 and not __canvas_active:
        __screen_layout()
        if not __canvas_on:
            flush()
            __set_screen_target()

# a finger (a web page's, or SLOPPY_INPUT's): kind 1 down, 0 moved, 2 up (or cancelled); 3: the
# mouse was used (id -1); x, y in the window's pixels
__touch_event = (id: int, kind: int, x: f32, y: f32):
    global __touch_last
    if kind == 3:
        __touch_last = false
        return
    __touch_last = true
    k = __touch_ids.index_of(id)
    if kind == 2:
        if k >= 0:
            __touch_ids.remove_at(k)
            __touch_pos.remove_at(k)
        return
    if k < 0:
        if kind != 1: return
        __touch_ids.push(id)
        __touch_pos.push(vec2(x, y))
    else: __touch_pos[k] = vec2(x, y)

__mouse_lock_want = false
__cursor_hidden = false

# show or hide the mouse pointer over the window (hidden: a game drawing its own crosshair or
# cursor); unlike mouse_lock, it still moves and mouse_pos() follows it
show_cursor = (on: bool):
    global __cursor_hidden
    __cursor_hidden = not on
    if __win_open: __platform_show_cursor(on)

# the mouse pointer's shape over the window, from the end of this frame on: .arrow (the usual),
# .ibeam over text to type in, .hand over a link, .crosshair, .move over what drags, .resize_ew,
# .resize_ns, .resize_nwse and .resize_nesw over an edge or a corner that resizes, .not_allowed,
# .wait while busy; .hidden is show_cursor(false), and any other shape shows it again. While it
# is .arrow, a hud_text_field or ui_text_field under the pointer shows an I-beam. (In a web page,
# the browser's cursors; on Wayland, where the compositor has cursor shapes)
#   over = divider.contains(mouse_pos())
#   set_cursor(if over or dragging: Cursor.resize_ew else: Cursor.arrow)
set_cursor = (c: Cursor):
    global __cursor_shape
    if c == .hidden:
        show_cursor(false)
        return
    __cursor_shape = c
    if __cursor_hidden: show_cursor(true)

enum Cursor: arrow, ibeam, hand, crosshair, move, resize_ew, resize_ns, resize_nwse, resize_nesw, not_allowed, wait, hidden

__cursor_shape = Cursor.arrow       # set_cursor's
__cursor_auto = Cursor.arrow        # (this frame's own: an I-beam over a text field)
__cursor_now = Cursor.arrow         # (the shape the window shows, unless hidden)

# (at the end of each frame: the shape for the next)
__cursor_frame_end = ():
    global __cursor_auto, __cursor_now
    c = __cursor_shape
    if c == .arrow: c = __cursor_auto
    __cursor_auto = .arrow
    if c == __cursor_now: return
    __cursor_now = c
    if __win_open and not __offscreen and not __testing: __platform_set_cursor()

# the program's name (shapes for shapes.jo, or the build block's name), for a window without a
# title of its own
__program_name = () -> str:
    if len(PROGRAM_NAME) == 0: return "sloppy"
    PROGRAM_NAME

# the program's icon (the build block's) as X11's _NET_WM_ICON has it: for each of a few sizes,
# the width, the height, then the pixels (ARGB), at most max_words of them; empty without one
__icon_argb = (max_words: int) -> int[]:
    out: int[]
    if len(PROGRAM_ICON) == 0: return out
    img = load_png(bytes(PROGRAM_ICON)) ?? image(0, 0)
    w = img.width
    if w == 0 or img.height != w: return out
    sizes: int[]
    loop s in [min(w, 128), 64, 48, 32, 16]:
        if s <= w and not sizes.contains(s): sizes.push(s)
    loop s in sizes:
        if out.len() + 2 + s * s > max_words: continue
        out.push(s)
        out.push(s)
        # (each pixel the average of the ones it covers, weighed by their alpha)
        loop y in [0..s):
            y0 = y * w / s
            y1 = max((y + 1) * w / s, y0 + 1)
            loop x in [0..s):
                x0 = x * w / s
                x1 = max((x + 1) * w / s, x0 + 1)
                r = 0
                g = 0
                b = 0
                a = 0
                loop yy in [y0..y1):
                    loop xx in [x0..x1):
                        i = (yy * w + xx) * 4
                        pa = int(img.pixels[i + 3])
                        r += int(img.pixels[i]) * pa
                        g += int(img.pixels[i + 1]) * pa
                        b += int(img.pixels[i + 2]) * pa
                        a += pa
                n = (y1 - y0) * (x1 - x0)
                v = 0
                if a > 0: v = ((a / n) << 24) | ((r / a) << 16) | ((g / a) << 8) | (b / a)
                out.push(v)
    out

__win_upscaled = false          # (opened a whole number of times larger than a small design)

# (screen_fit(.native) after window() opened a small design's window larger, as for pixel art,
# before the first frame: the window takes the design's own size)
__fit_native = ():
    global __win_h, __win_upscaled, __win_w
    if not __win_upscaled or __frame_count > 0: return
    __win_upscaled = false
    __win_w = __design_w
    __win_h = __design_h
    if __win_open and not __offscreen and not __testing: __platform_resize(__win_w, __win_h)

# (the window the game runs in: the one opened already, or one of the size given or the default)
__window_default = ():
    if not __win_open or __offscreen: window(__win_title, __win_w, __win_h)

# Open the game window (called automatically when the program defines update/draw).
window = (title: str = "", width: int = 1280, height: int = 720):
    global __design_h, __design_w, __offscreen, __pixel_ratio_env, __soft_kept, __time0, __touch_env, __touch_last, __win_h, __win_open, __win_title, __win_upscaled, __win_w
    __input_init()
    name = title
    if len(name) == 0: name = __program_name()
    if __win_open and not __offscreen:
        # already opened (by creating a mesh first, or window() called again): the new title, and
        # the new size as the design size (design_size: the window keeps its own)
        if name != __win_title:
            __win_title = name
            __platform_title()
        if width != __design_w or height != __design_h: design_size(width, height)
        return
    # (pictures drawn before it, with no window: the software renderer, which has their textures)
    if __offscreen:
        __offscreen = false
        __win_open = false
        __soft_kept = true
    __win_title = name
    __win_w = width
    __win_h = height
    __design_w = width
    __design_h = height
    # a design that small is pixel art: the window opens a whole number of times larger (not
    # with screen_fit(.native), where a unit is a pixel: a small tool's window is its own size;
    # screen_fit(.native) after this gives the window its size back, see __fit_native)
    if not __screen_env_read: __screen_env()
    __win_upscaled = false
    if width < 640 and height < 360 and width > 0 and height > 0 and __fit != .native:
        k = max(1, min(1280 / width, 720 / height))
        __win_w = width * k
        __win_h = height * k
        __win_upscaled = k > 1
    # (testing aid: SLOPPY_WINDOW=WxH opens the window at another size than the design size)
    if let ws = env("SLOPPY_WINDOW"):
        x = find(ws, "x")
        if x > 0:
            __win_w = to_int(ws[..x)) ?? width
            __win_h = to_int(ws[x + 1..]) ?? height
            __win_upscaled = false
    # (testing aids for a phone's screen: SLOPPY_TOUCH=1 is a touch screen (touch_device(), menus
    # drawn for fingers), SLOPPY_PIXEL_RATIO=3 its pixels per point)
    __touch_env = env("SLOPPY_TOUCH") == "1"
    if let pr = to_float(env("SLOPPY_PIXEL_RATIO") ?? ""): __pixel_ratio_env = pr
    # (sloppy test: the tests run with no window, and no display needed)
    if __testing: return
    __platform_open()
    __win_open = true
    # (on a phone, the pointer is a finger from the start: no keyboard focus marks in menus)
    __touch_last = touch_device()
    __time0 = time()
    if __mouse_lock_want: __platform_mouse_lock(true)
    if __cursor_hidden: __platform_show_cursor(false)

# change the window's title while the game runs (a level's name, the score); in a web page, the
# page's title
set_title = (title: str):
    global __win_title
    if title == __win_title: return
    __win_title = title
    if __win_open and not __offscreen and not __testing: __platform_title()

when TARGET == "wasm":
    extern __web_canvas_open = (title: *u8, title_len: i32, w: i32, h: i32)
    extern __web_canvas_size = (out: *i32)

    extern __web_set_title = (title: *u8, title_len: i32)
    extern __web_fullscreen = (on: i32)
    extern __web_is_fullscreen = () -> i32
    extern __web_can_fullscreen = () -> i32
    extern __web_pointer_lock = (on: i32) -> i32
    extern __web_pointer_locked = () -> i32
    extern __web_show_cursor = (on: i32)
    extern __web_set_cursor = (shape: i32)
    extern __web_clipboard_get = (out: *u8, cap: i32) -> i32
    extern __web_clipboard_set = (p: *u8, n: i32)
    extern __web_keyboard = (on: i32, bottom: f32)
    extern __web_paste = ()
    extern __web_can_share = () -> i32
    extern __web_finger = () -> i32
    extern __web_share = (p: *u8, n: i32)
    extern __web_page_color = (r: f32, g: f32, b: f32)
    extern __web_typing_at = (y: f32)

    __platform_fullscreen = (on: bool): __web_fullscreen(i32(int(on)))
    __platform_mouse_lock = (on: bool) -> bool: __web_pointer_lock(i32(int(on))) != 0
    __platform_mouse_locked = () -> bool: __web_pointer_locked() != 0
    __platform_show_cursor = (on: bool): __web_show_cursor(i32(int(on)))
    __platform_set_cursor = (): __web_set_cursor(i32(int(__cursor_now)))
    __platform_clipboard = () -> str:
        buf = fill(u8(0), 4096)
        n = int(__web_clipboard_get(data(buf), 4096))
        if n > 4096:
            buf = fill(u8(0), n)
            __web_clipboard_get(data(buf), i32(n))
        str_from_bytes(buf[..n))
    __platform_set_clipboard = (s: str): __web_clipboard_set(data(s), i32(len(s)))
    # (the browser asks the player first, and the text arrives a few frames later, as a paste)
    __platform_paste = (): __web_paste()
    __platform_pasted = () -> bool: __web_pasted_frame == frame_number()
    __platform_can_share = () -> bool: __web_can_share() != 0
    __platform_finger = () -> bool: __web_finger() != 0
    __platform_share = (s: str): __web_share(data(s), i32(len(s)))
    __platform_pixel_ratio = () -> f64: __web_ratio
    __web_ratio = 1.0
    __web_pasted_frame = -10
    __web_keyboard_on = false

    __platform_open = (): __web_canvas_open(data(__win_title), i32(len(__win_title)), i32(__win_w), i32(__win_h))
    __platform_title = (): __web_set_title(data(__win_title), i32(len(__win_title)))
    __platform_resize = (w: int, h: int): pass          # (the canvas fills the page)

    # the page calls this every animation frame
    __web_update: (f64) -> void
    __web_draw: () -> void
    __web_last = -1.0

    @export("__frame")
    __web_frame = (now_ms: f64):
        global __fullscreen, __safe_insets, __web_keyboard_on, __web_last, __web_ratio, __win_h, __win_w
        now = now_ms / 1000.0
        dt = 0.016
        if __web_last >= 0.0: dt = clamp(now - __web_last, 0.0, 0.1)
        __web_last = now
        # (the canvas's pixels, its size in points, and the safe area's insets in points)
        sz: (i32, i32, i32, i32, i32, i32, i32, i32)
        __web_canvas_size(&sz as *i32)
        __win_w = int(sz.0)
        __win_h = int(sz.1)
        if sz.2 > 0: __web_ratio = f64(sz.0) / f64(sz.2)
        __safe_insets = vec4(f32(sz.4), f32(sz.5), f32(sz.6), f32(sz.7))
        __fullscreen = __web_is_fullscreen() != 0          # (the browser leaves it on Escape)
        __lazy_begin()
        __run_frame(dt, __web_update, __web_draw)
        # a text field typed in with a finger: the phone's keyboard comes up (the page shows it
        # at the end of the touch, as browsers allow it only then), the page moved up over it as
        # far as the field needs, told where the field's bottom is each frame
        kb = ui_typing() and __touch_last
        if kb != __web_keyboard_on or kb:
            __web_keyboard_on = kb
            __web_keyboard(i32(int(kb)), f32(__typing_bottom))
        # (with a keyboard: an input method's choices shown by the field typed in)
        else if ui_typing(): __web_typing_at(f32(__typing_bottom))

    # (after a frame: -1, the next at the next animation frame; else how many milliseconds the
    # page may wait for one, unless input comes first: redraw_on_input)
    @export("__frame_wait")
    __web_frame_wait = () -> f64:
        if not __lazy or __redraw_asked or __lazy_extra > 0: return -1.0
        wait = 1e9
        if __redraw_at >= 0.0: wait = max(__redraw_at - time(), 0.0) * 1000.0
        if __pace_real_time or __tasks_on or __dialogs.len() > 0: wait = min(wait, 100.0)
        __out_flush()                       # (what the frame printed, shown now)
        wait

    # the player put the phone's keyboard away: the text field typed in lets go of it
    @export("__keyboard_closed")
    __web_keyboard_closed = ():
        global __hud_focus, __typing_frame, __ui_text_on
        __hud_focus = ""
        __ui_text_on = ""
        __typing_frame = -10

    # (whether a tap ending now may be a widget's: the page then runs a frame at once, inside the
    # touch's or click's end, where browsers allow what a button does (the keyboard, fullscreen,
    # the clipboard, sharing))
    @export("__tap_pending")
    __web_tap_pending = () -> i32: i32(int(__tap_frame >= frame_number() - 1))

    # down: 0 released, 1 pressed, 2 repeated (held down)
    @export("__key")
    __web_key = (k: i32, down: i32): __key_event(int(k), down != 0, down == 2)

    @export("__focus")
    __web_focus = (on: i32):
        global __win_focused
        __win_focused = on != 0

    @export("__quit")
    __web_quit = (): __game_quit()

    @export("__mouse")
    __web_mouse = (kind: i32, x: f32, y: f32, b: i32):
        global __mouse_x, __mouse_y
        if kind == 0:
            __mouse_dx += f64(x) - __mouse_x
            __mouse_dy += f64(y) - __mouse_y
            __mouse_x = f64(x)
            __mouse_y = f64(y)
        else if kind == 1: __mouse_event(int(b), true)
        else if kind == 2: __mouse_event(int(b), false)
        else if kind == 3: __mouse_wheel += f64(y)
        else if kind == 4:
            # motion while the pointer is locked: only how far it moved
            __mouse_dx += f64(x)
            __mouse_dy += f64(y)

    @export("__char")
    __web_char = (c: i32): __text_input += chr(int(c))

    # text was pasted into the page (it is clipboard() now): in the coming frame
    @export("__pasted")
    __web_pasted = ():
        global __web_pasted_frame
        __web_pasted_frame = frame_number()

    # a finger: kind 1 down, 0 moved, 2 up (or cancelled); 3: the mouse was used (id -1)
    @export("__touch")
    __web_touch = (id: i32, kind: i32, x: f32, y: f32): __touch_event(int(id), int(kind), x, y)

    __game_run = (update: (f64) -> void, draw: () -> void):
        global __web_draw, __web_update
        __window_default()
        __web_update = update
        __web_draw = draw
else when TARGET == "windows":
    # ---------------- Windows: a Win32 window (lib/core/windows.jo has the rest) ----------------
    # Frames are drawn by the software renderer and shown with StretchDIBits.
    @lib("kernel32.dll")
    extern GetModuleHandleW = (name: *u16) -> *u8
    @lib("user32.dll")
    extern RegisterClassExW = (wc: *u8) -> u16
    @lib("user32.dll")
    extern CreateWindowExW = (exstyle: u32, cls: *u16, title: *u16, style: u32, x: i32, y: i32, w: i32, h: i32, parent: *u8, menu: *u8, inst: *u8, param: *u8) -> *u8
    @lib("user32.dll")
    extern DefWindowProcW = (hwnd: *u8, msg: u32, wp: int, lp: int) -> int
    @lib("user32.dll")
    extern PeekMessageW = (msg: *u8, hwnd: *u8, lo: u32, hi: u32, remove: u32) -> i32
    @lib("user32.dll")
    extern TranslateMessage = (msg: *u8) -> i32
    @lib("user32.dll")
    extern DispatchMessageW = (msg: *u8) -> int
    @lib("user32.dll")
    extern ShowWindow = (hwnd: *u8, cmd: i32) -> i32
    @lib("user32.dll")
    extern SetWindowTextW = (hwnd: *u8, text: *u16) -> i32
    @lib("user32.dll")
    extern AdjustWindowRect = (rect: *i32, style: u32, menu: i32) -> i32
    @lib("user32.dll")
    extern GetClientRect = (hwnd: *u8, rect: *i32) -> i32
    @lib("user32.dll")
    extern GetWindowRect = (hwnd: *u8, rect: *i32) -> i32
    @lib("user32.dll")
    extern LoadCursorW = (inst: *u8, name: int) -> *u8
    @lib("user32.dll")
    extern LoadIconW = (inst: *u8, name: int) -> *u8
    @lib("user32.dll")
    extern GetDC = (hwnd: *u8) -> *u8
    @lib("user32.dll")
    extern SetProcessDPIAware = () -> i32
    @lib("user32.dll")
    extern GetWindowLongPtrW = (hwnd: *u8, index: i32) -> int
    @lib("user32.dll")
    extern SetWindowLongPtrW = (hwnd: *u8, index: i32, v: int) -> int
    @lib("user32.dll")
    extern SetWindowPos = (hwnd: *u8, after: *u8, x: i32, y: i32, w: i32, h: i32, flags: u32) -> i32
    @lib("user32.dll")
    extern MonitorFromWindow = (hwnd: *u8, flags: u32) -> *u8
    @lib("user32.dll")
    extern GetMonitorInfoW = (mon: *u8, info: *u8) -> i32
    @lib("user32.dll")
    extern ClientToScreen = (hwnd: *u8, pt: *i32) -> i32
    @lib("user32.dll")
    extern ClipCursor = (rect: *i32) -> i32
    @lib("user32.dll")
    extern ShowCursor = (show: i32) -> i32
    @lib("user32.dll")
    extern SetCursor = (c: *u8) -> *u8
    @lib("shell32.dll")
    extern DragAcceptFiles = (hwnd: *u8, accept: i32)
    @lib("shell32.dll")
    extern DragQueryFileW = (drop: *u8, i: u32, out: *u16, n: u32) -> u32
    @lib("shell32.dll")
    extern DragFinish = (drop: *u8)
    @lib("user32.dll")
    extern RegisterRawInputDevices = (devs: *u8, n: u32, size: u32) -> i32
    @lib("user32.dll")
    extern GetRawInputData = (h: *u8, cmd: u32, data: *u8, size: *u32, header: u32) -> u32
    @lib("user32.dll")
    extern OpenClipboard = (hwnd: *u8) -> i32
    @lib("user32.dll")
    extern CloseClipboard = () -> i32
    @lib("user32.dll")
    extern EmptyClipboard = () -> i32
    @lib("user32.dll")
    extern GetClipboardData = (format: u32) -> *u8
    @lib("user32.dll")
    extern SetClipboardData = (format: u32, h: *u8) -> *u8
    @lib("kernel32.dll")
    extern GlobalAlloc = (flags: u32, size: int) -> *u8
    @lib("kernel32.dll")
    extern GlobalLock = (h: *u8) -> *u8
    @lib("kernel32.dll")
    extern GlobalUnlock = (h: *u8) -> i32
    @lib("gdi32.dll")
    extern GetDeviceCaps = (hdc: *u8, index: i32) -> i32
    @lib("gdi32.dll")
    extern StretchDIBits = (hdc: *u8, x: i32, y: i32, w: i32, h: i32, sx: i32, sy: i32, sw: i32, sh: i32, bits: *u8, info: *u8, usage: u32, rop: u32) -> i32

    @lib("opengl32.dll")
    extern wglCreateContext = (dc: *u8) -> *u8
    @lib("opengl32.dll")
    extern wglMakeCurrent = (dc: *u8, ctx: *u8) -> i32
    @lib("opengl32.dll")
    extern wglDeleteContext = (ctx: *u8) -> i32
    @lib("opengl32.dll")
    extern wglGetProcAddress = (name: *u8) -> *u8
    @lib("gdi32.dll")
    extern ChoosePixelFormat = (dc: *u8, pfd: *u8) -> i32
    @lib("gdi32.dll")
    extern SetPixelFormat = (dc: *u8, fmt: i32, pfd: *u8) -> i32
    @lib("gdi32.dll")
    extern SwapBuffers = (dc: *u8) -> i32

    __w32_hwnd: *u8 = null
    __w32_dc: *u8 = null
    __w32_gl: *u8 = null
    __w32_msg: u8[]
    __w32_pixels: u8[]
    __w32_bmi: u8[]
    __w32_locked = false
    __w32_saved_style = 0
    __w32_saved_rect: i32[] = [0, 0, 0, 0]
    __w32_surrogate = 0

    const __WS_OVERLAPPEDWINDOW = 0x00CF0000
    const __WS_POPUP = 0x80000000
    const __WS_VISIBLE = 0x10000000

    __platform_open = ():
        global __soft, __vk, __w32_any_size, __w32_dc, __w32_hwnd, __w32_msg, __win_h, __win_w
        __soft = __soft_kept or (env("SLOPPY_SOFTWARE") ?? "") == "1"
        __w32_any_size = env("SLOPPY_SCREENSHOT") != none
        # (a screenshot run through Vulkan with SLOPPY_HEADLESS=1, as over ssh, where there is no
        # desktop to show a window on: no window, frames are only drawn)
        if not __soft and __vk_wanted() and __w32_any_size and env("SLOPPY_HEADLESS") != none:
            why = __vk_open("", () -> int: 0)
            if len(why) == 0:
                __vk = true
                return
            __vk_note("{why}; using a window")
        SetProcessDPIAware()
        inst = GetModuleHandleW(null)
        cls = __wide("SloppyWindow")
        wc = fill(u8(0), 80)
        p = data(wc)
        (p as *u32)[0] = 80                                     # cbSize
        (p as *u32)[1] = 0x23                                   # CS_OWNDC | CS_HREDRAW | CS_VREDRAW
        wp: cfn(*u8, u32, int, int) -> int = __w32_wndproc
        ((p + 8) as **u8)[0] = wp as *u8
        ((p + 24) as **u8)[0] = inst
        ((p + 32) as **u8)[0] = LoadIconW(inst, 1)              # the build block's icon (compiler/pe.jo), if any
        ((p + 40) as **u8)[0] = LoadCursorW(null, 32512)        # IDC_ARROW
        ((p + 64) as **u16)[0] = data(cls)
        RegisterClassExW(p)
        # the window's outer size for a client area of the size asked for
        r: i32[] = [0, 0, i32(__win_w), i32(__win_h)]
        AdjustWindowRect(data(r), u32(__WS_OVERLAPPEDWINDOW), 0)
        title = __wide(__win_title)
        cw = i32(0x80000000 as int)                             # CW_USEDEFAULT
        __w32_hwnd = CreateWindowExW(0, data(cls), data(title), u32(__WS_OVERLAPPEDWINDOW | __WS_VISIBLE), cw, cw, r[2] - r[0], r[3] - r[1], null, null, inst, null)
        __need(__w32_hwnd != null, "CreateWindowExW failed")
        DragAcceptFiles(__w32_hwnd, 1)                         # (files dropped on it: WM_DROPFILES)
        ShowWindow(__w32_hwnd, 1)
        __w32_dc = GetDC(__w32_hwnd)
        __w32_msg = fill(u8(0), 48)
        cr: i32[] = [0, 0, 0, 0]
        GetClientRect(__w32_hwnd, data(cr))
        if cr[2] > 0 and cr[3] > 0 and not __w32_any_size:
            __win_w = int(cr[2])
            __win_h = int(cr[3])
        if not __soft and __vk_wanted():
            why = __vk_open("VK_KHR_win32_surface", __vk_win32_surface)
            if len(why) == 0: __vk = true
            else: __vk_note("{why}; using OpenGL")
        if not __soft and not __vk:
            why = __w32_gl_open()
            if len(why) > 0:
                eprint("note: {why}; using the software renderer")
                __soft = true
        if __soft: __sw_init_window(__win_w, __win_h)

    __vk_win32_surface = () -> int:
        info = VkWin32SurfaceCreateInfo(stype = 1000009000, hinstance = GetModuleHandleW(null), hwnd = __w32_hwnd)
        s = 0
        if vkCreateWin32SurfaceKHR(__vk_inst, (&info) as *u8, null, &s) != 0: return 0
        s

    # an OpenGL 4.3 core context (it takes the library's GLSL ES 3.00 shaders), with vsync
    __w32_gl_open = () -> str:
        global __w32_gl
        pfd = fill(u8(0), 40)
        p = data(pfd)
        (p as *u16)[0] = 40
        (p as *u16)[1] = 1
        ((p + 4) as *u32)[0] = 0x25                             # draw to window, OpenGL, double buffered
        p[9] = 32                                               # color bits
        p[16] = 8                                               # alpha
        p[23] = 24                                              # depth
        p[24] = 8                                               # stencil
        fmt = ChoosePixelFormat(__w32_dc, p)
        if fmt == 0 or SetPixelFormat(__w32_dc, fmt, p) == 0: return "no OpenGL pixel format"
        tmp = wglCreateContext(__w32_dc)
        if tmp == null or wglMakeCurrent(__w32_dc, tmp) == 0: return "no OpenGL driver"
        create = wglGetProcAddress(data("wglCreateContextAttribsARB"))
        ctx: *u8 = null
        if create != null:
            f = create as cfn(*u8, *u8, *i32) -> *u8
            attribs: i32[] = [0x2091, 4, 0x2092, 3, 0x9126, 1, 0]           # 4.3, core profile
            ctx = f(__w32_dc, null, data(attribs))
        if ctx == null:
            wglDeleteContext(tmp)
            return "OpenGL 4.3 is not available"
        wglMakeCurrent(__w32_dc, ctx)
        wglDeleteContext(tmp)
        __w32_gl = ctx
        swap = wglGetProcAddress(data("wglSwapIntervalEXT"))
        if swap != null:
            sf = swap as cfn(i32) -> i32
            sf(1)
        ""

    # (lib/core/windows.jo: the GL functions gl.jo declares as libGLESv2's come from here)
    __w32_gl_proc = (name: str) -> *u8:
        p = wglGetProcAddress(data(__zstr(name)))
        v = p as int
        if v >= -1 and v <= 3: p = GetProcAddress(__w32_lib("opengl32.dll"), data(__zstr(name)))
        p

    __need = (ok: bool, what: str):
        if not ok:
            eprint("error: cannot open a window: {what}")
            exit(1)

    __platform_title = ():
        if __w32_hwnd != null:
            t = __wide(__win_title)
            SetWindowTextW(__w32_hwnd, data(t))

    # (a client area of w x h, the window where it is)
    __platform_resize = (w: int, h: int):
        if __w32_hwnd == null: return
        r: i32[] = [0, 0, i32(w), i32(h)]
        AdjustWindowRect(data(r), u32(__WS_OVERLAPPEDWINDOW), 0)
        SetWindowPos(__w32_hwnd, null, 0, 0, r[2] - r[0], r[3] - r[1], u32(0x16))     # NOMOVE, NOZORDER, NOACTIVATE

    __platform_poll = ():
        if __w32_hwnd == null: return
        m = data(__w32_msg)
        loop PeekMessageW(m, null, 0, 0, 1) != 0:          # PM_REMOVE
            TranslateMessage(m)
            DispatchMessageW(m)

    # (signed 16-bit parts of a message's parameter)
    __w32_lo = (v: int) -> int: int(i16(v & 0xFFFF))
    __w32_hi = (v: int) -> int: int(i16((v >> 16) & 0xFFFF))

    __w32_any_size = false

    @cabi
    __w32_wndproc = (hwnd: *u8, msg: u32, wp: int, lp: int) -> int:
        global __mouse_x, __mouse_y, __w32_in_client, __w32_surrogate, __win_close, __win_focused, __win_h, __win_w
        m = int(msg)
        if m == 0x10:                                           # WM_CLOSE
            __win_close = true
            return 0
        if m == 0x5:                                            # WM_SIZE
            w = lp & 0xFFFF
            h = (lp >> 16) & 0xFFFF
            # (screenshots keep the size asked for: Windows shrinks a window to fit the screen)
            if w > 0 and h > 0 and not __w32_any_size:
                __win_w = w
                __win_h = h
            return 0
        if m == 0x100 or m == 0x104 or m == 0x101 or m == 0x105:     # WM_(SYS)KEYDOWN / UP
            down = m == 0x100 or m == 0x104
            k = __w32_key(int(wp))
            # (the number pad with NumLock off: Home and the arrows without the extended bit)
            if (lp >> 24) & 1 == 0:
                vk = int(wp)
                if vk == 0x24: k = int(Key.kp7)
                else if vk == 0x26: k = int(Key.kp8)
                else if vk == 0x21: k = int(Key.kp9)
                else if vk == 0x25: k = int(Key.kp4)
                else if vk == 0x0C: k = int(Key.kp5)
                else if vk == 0x27: k = int(Key.kp6)
                else if vk == 0x23: k = int(Key.kp1)
                else if vk == 0x28: k = int(Key.kp2)
                else if vk == 0x22: k = int(Key.kp3)
                else if vk == 0x2D: k = int(Key.kp0)
                else if vk == 0x2E: k = int(Key.kp_period)
            if k > 0: __key_event(k, down, down and (lp >> 30) & 1 == 1)
            # (alt+F4 still closes; other system keys are the game's)
            if m == 0x104 and int(wp) == 0x73: return DefWindowProcW(hwnd, msg, wp, lp)
            return 0
        if m == 0x102:                                          # WM_CHAR (UTF-16)
            c = int(wp)
            if c >= 0xD800 and c < 0xDC00:
                __w32_surrogate = c
                return 0
            if c >= 0xDC00 and c < 0xE000 and __w32_surrogate != 0:
                c = 0x10000 + ((__w32_surrogate - 0xD800) << 10) + (c - 0xDC00)
                __w32_surrogate = 0
            if c >= 32 and c != 127: __text_input += __w32_utf8(c)
            return 0
        if m == 0x200:                                          # WM_MOUSEMOVE
            x = f64(__w32_lo(lp))
            y = f64(__w32_hi(lp))
            if not __w32_locked:
                __mouse_dx += x - __mouse_x
                __mouse_dy += y - __mouse_y
            __mouse_x = x
            __mouse_y = y
            return 0
        if m == 0x201 or m == 0x202:
            __mouse_event(0, m == 0x201)
            return 0
        if m == 0x207 or m == 0x208:
            __mouse_event(1, m == 0x207)
            return 0
        if m == 0x204 or m == 0x205:
            __mouse_event(2, m == 0x204)
            return 0
        if m == 0x20A:                                          # WM_MOUSEWHEEL
            __mouse_wheel += f64(__w32_hi(wp)) / 120.0
            return 0
        if m == 0xFF:                                           # WM_INPUT: raw mouse motion
            if __w32_locked:
                buf = fill(u8(0), 64)
                size: u32[] = [64]
                if int(GetRawInputData(lp as *u8, u32(0x10000003), data(buf), data(size), 24)) > 0:
                    if (data(buf) as *u32)[0] == 0 and (data(buf) + 24)[0] & 1 == 0:    # a mouse, relative
                        __mouse_dx += f64(((data(buf) + 36) as *i32)[0])
                        __mouse_dy += f64(((data(buf) + 40) as *i32)[0])
            return DefWindowProcW(hwnd, msg, wp, lp)
        if m == 0x8:                                            # WM_KILLFOCUS
            __win_focused = false
            loop mut kd in __key_down: kd = false
            if __w32_locked: __w32_lock(false)
            return 0
        if m == 0x7:                                            # WM_SETFOCUS
            __win_focused = true
            if __mouse_lock_want: __w32_lock(true)
            return 0
        if m == 0x14: return 1                                  # WM_ERASEBKGND: drawn whole anyway
        if m == 0x233:                                          # WM_DROPFILES: their paths
            h = wp as *u8
            paths: str[]
            loop i in [0..int(DragQueryFileW(h, u32(0xFFFFFFFF), null, 0))):
                n = int(DragQueryFileW(h, u32(i), null, 0))
                buf = fill(u16(0), n + 1)
                DragQueryFileW(h, u32(i), data(buf), u32(n + 1))
                paths.push(__narrow(data(buf), n))
            DragFinish(h)
            __drop_add(paths)
            return 0
        if m == 0x20:                                           # WM_SETCURSOR: set_cursor's, in the client area
            __w32_in_client = lp & 0xFFFF == 1
            if __w32_in_client:
                SetCursor(__w32_cursor())
                return 1
        DefWindowProcW(hwnd, msg, wp, lp)

    __w32_utf8 = (c: int) -> str:
        b: u8[]
        if c < 0x80: b.push(u8(c))
        else if c < 0x800:
            b.push(u8(0xC0 | (c >> 6)))
            b.push(u8(0x80 | (c & 63)))
        else if c < 0x10000:
            b.push(u8(0xE0 | (c >> 12)))
            b.push(u8(0x80 | ((c >> 6) & 63)))
            b.push(u8(0x80 | (c & 63)))
        else:
            b.push(u8(0xF0 | (c >> 18)))
            b.push(u8(0x80 | ((c >> 12) & 63)))
            b.push(u8(0x80 | ((c >> 6) & 63)))
            b.push(u8(0x80 | (c & 63)))
        str_from_bytes(b)

    # virtual-key code -> Key
    __w32_key = (vk: int) -> int:
        if vk >= 0x41 and vk <= 0x5A: return int(Key.a) + vk - 0x41
        if vk >= 0x30 and vk <= 0x39: return int(Key.n0) + vk - 0x30
        if vk >= 0x70 and vk <= 0x7B: return int(Key.f1) + vk - 0x70
        if vk >= 0x60 and vk <= 0x69: return int(Key.kp0) + vk - 0x60
        match vk:
            0x6E: int(Key.kp_period)
            0x6B: int(Key.kp_plus)
            0x6D: int(Key.kp_minus)
            0x6A: int(Key.kp_star)
            0x6F: int(Key.kp_slash)
            0x20: int(Key.space)
            0x0D: int(Key.enter)
            0x1B: int(Key.escape)
            0x09: int(Key.tab)
            0x08: int(Key.backspace)
            0x2E: int(Key.delete)
            0x2D: int(Key.insert)
            0x24: int(Key.home)
            0x23: int(Key.end)
            0x21: int(Key.page_up)
            0x22: int(Key.page_down)
            0x25: int(Key.left)
            0x26: int(Key.up)
            0x27: int(Key.right)
            0x28: int(Key.down)
            0x10: int(Key.shift)
            0x11: int(Key.ctrl)
            0x12: int(Key.alt)
            0x5B, 0x5C: int(Key.super)
            0xBD: int(Key.minus)
            0xBB: int(Key.equals)
            0xBC: int(Key.comma)
            0xBE: int(Key.period)
            0xBF: int(Key.slash)
            0xBA: int(Key.semicolon)
            0xDE: int(Key.quote)
            0xDB: int(Key.lbracket)
            0xDD: int(Key.rbracket)
            0xDC: int(Key.backslash)
            0xC0: int(Key.grave)
            _: 0

    __platform_present = ():
        global __w32_bmi, __w32_pixels
        if __w32_dc == null: return
        if __vk:
            __vk_present()
            return
        if not __soft:
            SwapBuffers(__w32_dc)
            return
        w = __win_w
        h = __win_h
        if __w32_pixels.len() != w * h * 4: __w32_pixels = fill(u8(0), w * h * 4)
        __sw_present_pixels(data(__w32_pixels), w, h)
        if __w32_bmi.len() == 0: __w32_bmi = fill(u8(0), 44)
        b = data(__w32_bmi)
        (b as *u32)[0] = 40                                     # BITMAPINFOHEADER
        (b as *i32)[1] = i32(w)
        (b as *i32)[2] = i32(-h)                                # (top row first)
        ((b + 12) as *u16)[0] = 1
        ((b + 14) as *u16)[0] = 32
        StretchDIBits(__w32_dc, 0, 0, i32(w), i32(h), 0, 0, i32(w), i32(h), data(__w32_pixels), b, 0, u32(0x00CC0020))     # SRCCOPY

    # borderless, over the whole monitor (and back)
    __platform_fullscreen = (on: bool):
        global __w32_saved_style
        if __w32_hwnd == null: return
        if on:
            __w32_saved_style = GetWindowLongPtrW(__w32_hwnd, -16)
            GetWindowRect(__w32_hwnd, data(__w32_saved_rect))
            info = fill(u8(0), 40)
            (data(info) as *u32)[0] = 40
            GetMonitorInfoW(MonitorFromWindow(__w32_hwnd, 2), data(info))
            r = (data(info) + 4) as *i32
            SetWindowLongPtrW(__w32_hwnd, -16, __WS_POPUP | __WS_VISIBLE)
            SetWindowPos(__w32_hwnd, null, r[0], r[1], r[2] - r[0], r[3] - r[1], u32(0x220))     # FRAMECHANGED, NOOWNERZORDER
        else if __w32_saved_style != 0:
            r = __w32_saved_rect
            SetWindowLongPtrW(__w32_hwnd, -16, __w32_saved_style)
            SetWindowPos(__w32_hwnd, null, r[0], r[1], r[2] - r[0], r[3] - r[1], u32(0x220))

    # mouse look: the pointer hidden and kept in the window, motion from raw input
    __w32_lock = (on: bool) -> bool:
        global __w32_locked
        if __w32_hwnd == null: return false
        if on == __w32_locked: return true
        if on:
            dev = fill(u8(0), 16)
            ((data(dev)) as *u16)[0] = 1                        # generic desktop controls
            ((data(dev) + 2) as *u16)[0] = 2                    # mouse
            ((data(dev) + 8) as **u8)[0] = __w32_hwnd
            RegisterRawInputDevices(data(dev), 1, 16)
            cr: i32[] = [0, 0, 0, 0]
            GetClientRect(__w32_hwnd, data(cr))
            ClientToScreen(__w32_hwnd, data(cr))
            ClientToScreen(__w32_hwnd, data(cr) + 2)
            ClipCursor(data(cr))
        else: ClipCursor(null)
        __w32_locked = on
        __w32_cursor_update()
        true

    # (ShowCursor counts: called only when what is wanted changes)
    __w32_cursor_shown = true
    __w32_cursor_update = ():
        global __w32_cursor_shown
        v = not __w32_locked and not __cursor_hidden
        if v == __w32_cursor_shown: return
        ShowCursor(i32(int(v)))
        __w32_cursor_shown = v

    __platform_mouse_lock = (on: bool) -> bool: __w32_lock(on)
    __platform_mouse_locked = () -> bool: __w32_locked
    __platform_show_cursor = (on: bool): __w32_cursor_update()
    __platform_set_cursor = ():
        if __w32_in_client: SetCursor(__w32_cursor())

    # (the pointer is over the client area: the last WM_SETCURSOR's hit test said so)
    __w32_in_client = false
    # set_cursor's shape: the system's cursor (IDC_ARROW, IDC_IBEAM, IDC_HAND...)
    __w32_cursor = () -> *u8:
        ids = [32512, 32513, 32649, 32515, 32646, 32644, 32645, 32642, 32643, 32648, 32514, 32512]
        LoadCursorW(null, ids[int(__cursor_now)])

    __platform_clipboard = () -> str:
        if OpenClipboard(__w32_hwnd) == 0: return ""
        s = ""
        h = GetClipboardData(13)                                # CF_UNICODETEXT
        if h != null:
            p = GlobalLock(h)
            if p != null:
                s = __narrow(p as *u16, -1)
                GlobalUnlock(h)
        CloseClipboard()
        s

    __platform_set_clipboard = (s: str):
        if OpenClipboard(__w32_hwnd) == 0: return
        EmptyClipboard()
        w = __wide(s)
        h = GlobalAlloc(2, w.len() * 2)                         # GMEM_MOVEABLE
        if h != null:
            p = GlobalLock(h)
            mem_copy(p, data(w) as *u8, w.len() * 2)
            GlobalUnlock(h)
            SetClipboardData(13, h)
        CloseClipboard()
    __platform_paste = (): pass
    __platform_pasted = () -> bool: (key_down(.ctrl) or key_down(.super)) and key_pressed(.v)
    __platform_can_share = () -> bool: false
    __platform_share = (s: str): pass
    __platform_finger = () -> bool: false
    # (Windows' display scale: the program is DPI-aware, its window in the screen's pixels)
    __platform_pixel_ratio = () -> f64:
        if __w32_dc == null: return 1.0
        f64(GetDeviceCaps(__w32_dc, 88)) / 96.0       # LOGPIXELSX

    __game_run = (update: (f64) -> void, draw: () -> void):
        global __fixed_step, __last_present
        __window_default()
        __fixed_step = env("SLOPPY_SCREENSHOT") != none
        when WATCH:
            __watch_init()
        last = time()
        loop not __win_close and not __stop_asked:
            when WATCH:
                __watch_frame()
            __platform_poll()
            __lazy_wait()                   # (redraw_on_input: until a frame is due)
            now = time()
            dt = clamp(now - last, 0.0, 0.1)
            last = now
            if __fixed_step: dt = 1.0 / 60.0
            if __soft: __sw_init_window(__win_w, __win_h)
            __run_frame(dt, update, draw)
            t0 = time()
            __platform_present()
            __last_present = time() - t0
            __frame_present += __last_present
            # (without vsync, software frames are paced to 60 per second)
            if (__soft and not __fixed_step) or (__fixed_step and __pace_real_time):
                left = 1.0 / 60.0 - (time() - now)
                if left > 0.0: sleep(left)
        __game_quit()
        exit(0)
