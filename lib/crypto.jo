# Cryptography: hashes (SHA-1, SHA-256, SHA-384, SHA-512), HMAC, HKDF, TLS 1.2's PRF, AES-128-GCM,
# the P-256 curve (ECDH keys and ECDSA signatures), X25519 keys, P-384 and RSA signatures checked, a
# self-signed certificate, and random bytes from the operating system. It is what the library's
# WebRTC (lib/rtc.jo) and TLS (lib/tls.jo) are made of, and a program may use it too: `import crypto`.
#
#   key = crypto.random_bytes(16)
#   sealed = crypto.aes_gcm_seal(key, nonce12, aad, message)        # the message and a 16-byte tag
#   opened = crypto.aes_gcm_open(key, nonce12, aad, sealed)         # none when it was changed
#   pk = crypto.p256_key()                                          # a private key and its public point
#   sig = crypto.p256_sign(pk, crypto.sha256(msg))
#   ok = crypto.p256_verify(pk.public, crypto.sha256(msg), sig)
#
# (P-256's arithmetic does not take the same time whatever the key: fine for keys made for a
# session, as WebRTC's are; not for long-lived keys on shared machines. X25519's does.)

# ---------------- random bytes ----------------
when TARGET == "macos":
    @lib("/usr/lib/libSystem.B.dylib")
    @symbol("getentropy")
    extern __cr_getentropy = (p: *u8, n: int) -> i32
when TARGET == "windows":
    @lib("advapi32.dll")
    @symbol("SystemFunction036")
    extern __cr_rtlgenrandom = (p: *u8, n: u32) -> u8
when TARGET == "wasm":
    extern __wasm_random = (p: *u8, n: int)

# n bytes from the operating system's random source (for keys and nonces: not seeded, not repeatable)
random_bytes = (n: int) -> u8[]:
    b = fill(u8(0), n)
    if n == 0: return b
    when TARGET == "linux":
        got = 0
        loop got < n:
            r = syscall(318, data(b) + got, n - got, 0)            # getrandom
            if r <= 0: panic("random_bytes: the system gave no random bytes")
            got += r
    else when TARGET == "macos":
        got = 0
        loop got < n:
            k = min(n - got, 256)
            if int(__cr_getentropy(data(b) + got, k)) != 0: panic("random_bytes: the system gave no random bytes")
            got += k
    else when TARGET == "windows":
        if int(__cr_rtlgenrandom(data(b), u32(n))) == 0: panic("random_bytes: the system gave no random bytes")
    else:
        __wasm_random(data(b), n)
    b

# ---------------- bytes ----------------
# bytes as lowercase hex ("a9993e...")
hex_text = (b: u8[]) -> str:
    d = "0123456789abcdef"
    out: u8[]
    loop x in b:
        out.push(d[int(x >> 4)])
        out.push(d[int(x & 15)])
    str_from_bytes(out)

# "a9993e..." as bytes (none when it is not hex)
hex_bytes = (s: str) -> u8[]?:
    if len(s) % 2 != 0: return none
    out: u8[]
    i = 0
    loop i < len(s):
        h = __cr_hexval(s[i])
        l = __cr_hexval(s[i + 1])
        if h < 0 or l < 0: return none
        out.push(u8(h * 16 + l))
        i += 2
    out

__cr_hexval = (c: u8) -> int:
    if c >= '0' and c <= '9': return int(c) - 48
    if c >= 'a' and c <= 'f': return int(c) - 87
    if c >= 'A' and c <= 'F': return int(c) - 55
    -1

__rotl = (x: u32, n: int) -> u32: (x << u32(n)) | (x >> u32(32 - n))
__rotr = (x: u32, n: int) -> u32: (x >> u32(n)) | (x << u32(32 - n))
__be32 = (b: u8[], i: int) -> u32: (u32(b[i]) << 24) | (u32(b[i + 1]) << 16) | (u32(b[i + 2]) << 8) | u32(b[i + 3])
__put32 = (out: mut u8[], v: u32):
    out.push(u8(v >> 24))
    out.push(u8((v >> 16) & 255))
    out.push(u8((v >> 8) & 255))
    out.push(u8(v & 255))

# the message, padded as SHA-1 and SHA-256 take it: 0x80, zeros, its length in bits (64, big-endian)
__md_pad = (m: u8[]) -> u8[]:
    b = m
    b.push(0x80)
    loop b.len() % 64 != 56: b.push(0)
    bits = m.len() * 8
    loop k in [0..8): b.push(u8((bits >> (56 - k * 8)) & 255))
    b

# ---------------- MD5 ----------------
# MD5 of the bytes (16 bytes): for TURN's long-term credentials, which use it; not for anything new
__md5_k: u32[] = [
    0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE, 0xF57C0FAF, 0x4787C62A, 0xA8304613, 0xFD469501,
    0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE, 0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821,
    0xF61E2562, 0xC040B340, 0x265E5A51, 0xE9B6C7AA, 0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,
    0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED, 0xA9E3E905, 0xFCEFA3F8, 0x676F02D9, 0x8D2A4C8A,
    0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C, 0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70,
    0x289B7EC6, 0xEAA127FA, 0xD4EF3085, 0x04881D05, 0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,
    0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039, 0x655B59C3, 0x8F0CCC92, 0xFFEFF47D, 0x85845DD1,
    0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1, 0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391]
__md5_s: int[] = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]

md5 = (m: u8[]) -> u8[]:
    h: u32[4] = [u32(0x67452301), u32(0xEFCDAB89), u32(0x98BADCFE), u32(0x10325476)]
    b = m
    b.push(0x80)
    loop b.len() % 64 != 56: b.push(0)
    bits = m.len() * 8
    loop k in [0..8): b.push(u8((bits >> (k * 8)) & 255))
    w: u32[16]
    off = 0
    loop off < b.len():
        loop t in [0..16):
            o = off + t * 4
            w[t] = u32(b[o]) | (u32(b[o + 1]) << 8) | (u32(b[o + 2]) << 16) | (u32(b[o + 3]) << 24)
        a = h[0]
        bb = h[1]
        c = h[2]
        d = h[3]
        loop i in [0..64):
            f = u32(0)
            g = 0
            if i < 16:
                f = (bb & c) | ((~bb) & d)
                g = i
            else if i < 32:
                f = (d & bb) | ((~d) & c)
                g = (5 * i + 1) % 16
            else if i < 48:
                f = bb xor c xor d
                g = (3 * i + 5) % 16
            else:
                f = c xor (bb | (~d))
                g = (7 * i) % 16
            f = f + a + __md5_k[i] + w[g]
            a = d
            d = c
            c = bb
            bb = bb + __rotl(f, __md5_s[i])
        h[0] += a
        h[1] += bb
        h[2] += c
        h[3] += d
        off += 64
    out: u8[]
    loop x in h:
        loop k in [0..4): out.push(u8((x >> u32(k * 8)) & 255))
    out

# ---------------- SHA-1 ----------------
# SHA-1 of the bytes (20 bytes); for HMAC-SHA1, which STUN uses, not for anything new
sha1 = (m: u8[]) -> u8[]:
    h: u32[5] = [u32(0x67452301), u32(0xEFCDAB89), u32(0x98BADCFE), u32(0x10325476), u32(0xC3D2E1F0)]
    b = __md_pad(m)
    w: u32[80]
    off = 0
    loop off < b.len():
        loop t in [0..16): w[t] = __be32(b, off + t * 4)
        loop t in [16..80): w[t] = __rotl(w[t - 3] xor w[t - 8] xor w[t - 14] xor w[t - 16], 1)
        a = h[0]
        bb = h[1]
        c = h[2]
        d = h[3]
        e = h[4]
        loop t in [0..80):
            f = u32(0)
            k = u32(0)
            if t < 20:
                f = (bb & c) | ((~bb) & d)
                k = 0x5A827999
            else if t < 40:
                f = bb xor c xor d
                k = 0x6ED9EBA1
            else if t < 60:
                f = (bb & c) | (bb & d) | (c & d)
                k = 0x8F1BBCDC
            else:
                f = bb xor c xor d
                k = 0xCA62C1D6
            tmp = __rotl(a, 5) + f + e + k + w[t]
            e = d
            d = c
            c = __rotl(bb, 30)
            bb = a
            a = tmp
        h[0] += a
        h[1] += bb
        h[2] += c
        h[3] += d
        h[4] += e
        off += 64
    out: u8[]
    loop v in h: __put32(out, v)
    out

# ---------------- SHA-256 ----------------
__SHA256_K: u32[64] = [u32(0x428a2f98), 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

# SHA-256 of the bytes (32 bytes; std/hash's sha256 gives them as hex)
sha256 = (m: u8[]) -> u8[]:
    h: u32[8] = [u32(0x6a09e667), 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    b = __md_pad(m)
    w: u32[64]
    off = 0
    loop off < b.len():
        loop t in [0..16): w[t] = __be32(b, off + t * 4)
        __sha256_block(h, w)
        off += 64
    out: u8[]
    loop v in h: __put32(out, v)
    out

# (one 64-byte block, its words in w[0..16), into the state h; w[16..64) are the block's schedule.
# Its rotations written out and its arrays read through pointers: three times as fast in a debug
# build, which password hashing feels)
__sha256_block = (h: mut u32[8], w: mut u32[64]):
    pw = &w as *u32
    pk = &__SHA256_K as *u32
    loop t in [16..64):
        x = pw[t - 15]
        y = pw[t - 2]
        s0 = ((x >> 7) | (x << 25)) xor ((x >> 18) | (x << 14)) xor (x >> 3)
        s1 = ((y >> 17) | (y << 15)) xor ((y >> 19) | (y << 13)) xor (y >> 10)
        pw[t] = pw[t - 16] + s0 + pw[t - 7] + s1
    a = h[0]
    bb = h[1]
    c = h[2]
    d = h[3]
    e = h[4]
    f = h[5]
    g = h[6]
    hh = h[7]
    loop t in [0..64):
        S1 = ((e >> 6) | (e << 26)) xor ((e >> 11) | (e << 21)) xor ((e >> 25) | (e << 7))
        ch = (e & f) xor ((~e) & g)
        t1 = hh + S1 + ch + pk[t] + pw[t]
        S0 = ((a >> 2) | (a << 30)) xor ((a >> 13) | (a << 19)) xor ((a >> 22) | (a << 10))
        mj = (a & bb) xor (a & c) xor (bb & c)
        t2 = S0 + mj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = bb
        bb = a
        a = t1 + t2
    h[0] += a
    h[1] += bb
    h[2] += c
    h[3] += d
    h[4] += e
    h[5] += f
    h[6] += g
    h[7] += hh

# ---------------- SHA-512, SHA-384 ----------------
__SHA512_K: u64[80] = [u64(0x428a2f98d728ae22), 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817]

# SHA-512 of the bytes (64 bytes)
sha512 = (m: u8[]) -> u8[]:
    __sha512_with(m, [u64(0x6a09e667f3bcc908), 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179], 64)

# SHA-384 of the bytes (48 bytes: SHA-512 started elsewhere, cut short)
sha384 = (m: u8[]) -> u8[]:
    __sha512_with(m, [u64(0xcbbb9d5dc1059ed8), 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
        0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4], 48)

__rotr64 = (x: u64, n: int) -> u64: (x >> u64(n)) | (x << u64(64 - n))

__sha512_with = (m: u8[], h0: u64[8], size: int) -> u8[]:
    h = h0
    # (padded: 0x80, zeros, the length in bits as 128 bits)
    b = m
    b.push(0x80)
    loop b.len() % 128 != 112: b.push(0)
    loop _ in [0..8): b.push(0)
    bits = m.len() * 8
    loop k in [0..8): b.push(u8((bits >> (56 - k * 8)) & 255))
    w: u64[80]
    off = 0
    loop off < b.len():
        loop t in [0..16):
            v = u64(0)
            loop k in [0..8): v = (v << 8) | u64(b[off + t * 8 + k])
            w[t] = v
        loop t in [16..80):
            s0 = __rotr64(w[t - 15], 1) xor __rotr64(w[t - 15], 8) xor (w[t - 15] >> 7)
            s1 = __rotr64(w[t - 2], 19) xor __rotr64(w[t - 2], 61) xor (w[t - 2] >> 6)
            w[t] = w[t - 16] + s0 + w[t - 7] + s1
        a = h[0]
        bb = h[1]
        c = h[2]
        d = h[3]
        e = h[4]
        f = h[5]
        g = h[6]
        hh = h[7]
        loop t in [0..80):
            S1 = __rotr64(e, 14) xor __rotr64(e, 18) xor __rotr64(e, 41)
            ch = (e & f) xor ((~e) & g)
            t1 = hh + S1 + ch + __SHA512_K[t] + w[t]
            S0 = __rotr64(a, 28) xor __rotr64(a, 34) xor __rotr64(a, 39)
            mj = (a & bb) xor (a & c) xor (bb & c)
            t2 = S0 + mj
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = bb
            bb = a
            a = t1 + t2
        h[0] += a
        h[1] += bb
        h[2] += c
        h[3] += d
        h[4] += e
        h[5] += f
        h[6] += g
        h[7] += hh
        off += 128
    out: u8[]
    loop v in h:
        loop k in [0..8): out.push(u8((v >> u64(56 - k * 8)) & 255))
    out[..size)

# ---------------- HMAC ----------------
hmac_sha256 = (key: u8[], msg: u8[]) -> u8[]: __hmac(key, msg, false)
hmac_sha1 = (key: u8[], msg: u8[]) -> u8[]: __hmac(key, msg, true)

__hmac = (key0: u8[], msg: u8[], one: bool) -> u8[]:
    key = key0
    if key.len() > 64:
        if one: key = sha1(key)
        else: key = sha256(key)
    loop key.len() < 64: key.push(0)
    inner: u8[]
    outer: u8[]
    loop k in key:
        inner.push(k xor 0x36)
        outer.push(k xor 0x5c)
    inner.extend(msg)
    if one:
        outer.extend(sha1(inner))
        return sha1(outer)
    outer.extend(sha256(inner))
    sha256(outer)

# ---------------- HKDF (RFC 5869, with SHA-256) ----------------
# a key of 32 bytes made from input keying material and a salt (empty: as 32 zeros)
hkdf_extract = (salt: u8[], ikm: u8[]) -> u8[]: hmac_sha256(salt, ikm)

# n bytes of keys made from such a key, for a purpose (info)
hkdf_expand = (prk: u8[], info: u8[], n: int) -> u8[]:
    out: u8[]
    t: u8[]
    i = 1
    loop out.len() < n:
        m = t
        m.extend(info)
        m.push(u8(i))
        t = hmac_sha256(prk, m)
        out.extend(t)
        i += 1
    out[..n)

# ---------------- passwords: PBKDF2 (RFC 8018, with HMAC-SHA256) ----------------
# A password kept as a hash that is slow to make, so that one who takes the stored hashes cannot
# try many passwords against them quickly; a salt of its own for each, so that the same password
# gives another hash for each user. hash_password and check_password are a ready pair:
#   user.hash = crypto.hash_password(password)                 # stored, as text
#   if crypto.check_password(attempt, user.hash): ...           # signed in
# The text says how it was made ("pbkdf2-sha256$100000$<salt>$<hash>", base64), so hashes made
# with more iterations later (as computers get faster) are checked alongside the old ones. A hash
# takes the program's one thread while it is made: a server's other tasks wait meanwhile.

# n bytes of key from a password and a salt, by `iterations` rounds of HMAC-SHA256
pbkdf2_sha256 = (password: u8[], salt: u8[], iterations: int, n: int = 32) -> u8[]:
    # (the HMAC's inner and outer states after the key's block, made once: each round is then
    # two of SHA-256's blocks)
    key = if password.len() > 64: sha256(password) else: password
    inner: u32[8] = [u32(0x6a09e667), 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    outer = inner
    w: u32[64]
    loop t in [0..16): w[t] = __pbkdf2_key_word(key, t) xor 0x36363636
    __sha256_block(inner, w)
    loop t in [0..16): w[t] = __pbkdf2_key_word(key, t) xor 0x5c5c5c5c
    __sha256_block(outer, w)
    out: u8[]
    i = 1
    loop out.len() < n:
        m = salt
        __put32(m, u32(i))
        u0 = hmac_sha256(password, m)
        u: u32[8]
        loop t in [0..8): u[t] = __be32(u0, t * 4)
        acc = u
        loop _ in [1..max(iterations, 1)):
            # (a 32-byte message after the 64-byte key's block: its padding, and its length in bits)
            h = inner
            loop t in [0..8): w[t] = u[t]
            w[8] = 0x80000000
            loop t in [9..15): w[t] = 0
            w[15] = 768
            __sha256_block(h, w)
            u = outer
            loop t in [0..8): w[t] = h[t]
            w[8] = 0x80000000
            loop t in [9..15): w[t] = 0
            w[15] = 768
            __sha256_block(u, w)
            loop t in [0..8): acc[t] = acc[t] xor u[t]
        loop v in acc: __put32(out, v)
        i += 1
    out[..n)

# (the key's word t, as HMAC pads it: zeros past its end)
__pbkdf2_key_word = (key: u8[], t: int) -> u32:
    v = u32(0)
    loop k in [0..4):
        j = t * 4 + k
        v = (v << 8) | (if j < key.len(): u32(key[j]) else: u32(0))
    v

# a password as text to store: a new random salt, and PBKDF2-HMAC-SHA256's hash of it with that
# many iterations. 100000 takes about a sixth of a second in a release build (a third in a debug
# one); OWASP asks for 600000 of programs whose SHA-256 is faster (OpenSSL's): more where sign-ins
# are few, as an admin's
hash_password = (password: str, iterations: int = 100000) -> str:
    salt = random_bytes(16)
    h = pbkdf2_sha256(bytes(password), salt, iterations)
    "pbkdf2-sha256${iterations}${base64_encode(salt)}${base64_encode(h)}"

# whether the password is the one stored by hash_password (false too for text that is not such a
# hash); it takes as long whichever bytes differ
check_password = (password: str, stored: str) -> bool:
    parts = split(stored, "$")
    if parts.len() != 4 or parts[0] != "pbkdf2-sha256": return false
    iterations = to_int(parts[1]) ?? 0
    if iterations < 1: return false
    salt = base64_decode(parts[2]) ?? []
    want = base64_decode(parts[3]) ?? []
    if want.len() == 0: return false
    constant_time_equal(pbkdf2_sha256(bytes(password), salt, iterations, want.len()), want)

# whether a and b are the same bytes, taking as long whichever bytes differ (a secret compared with
# what a client sent: a token, a signature, an HMAC), so that the time taken tells nothing about
# where they differ. Their lengths are not secret: different lengths are false at once
constant_time_equal = (a: u8[], b: u8[]) -> bool:
    if a.len() != b.len(): return false
    d = 0
    loop k in [0..a.len()): d = d | (int(a[k]) xor int(b[k]))
    d == 0
constant_time_equal = (a: str, b: str) -> bool: constant_time_equal(bytes(a), bytes(b))

# ---------------- TLS 1.2's PRF (RFC 5246 5, P_SHA256) ----------------
# n bytes of keys made from a secret, for a purpose (label) and a seed
tls12_prf = (secret: u8[], label: str, seed: u8[], n: int) -> u8[]:
    s = bytes(label)
    s.extend(seed)
    out: u8[]
    a = s
    loop out.len() < n:
        a = hmac_sha256(secret, a)
        x = a
        x.extend(s)
        out.extend(hmac_sha256(secret, x))
    out[..n)

# ---------------- AES-128 ----------------
__AES_SBOX: u8[256] = [u8(0x63), 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16]

# an AES-128 key, expanded: the 11 round keys, 176 bytes (and as 44 big-endian words)
struct AesKey:
    w: u8[176]
    rk: u32[44]

aes_key = (key: u8[]) -> AesKey:
    if key.len() != 16: panic("aes_key: an AES-128 key is 16 bytes, not {key.len()}")
    k = AesKey()
    loop i in [0..16): k.w[i] = key[i]
    rcon = u8(1)
    i = 16
    loop i < 176:
        t0 = k.w[i - 4]
        t1 = k.w[i - 3]
        t2 = k.w[i - 2]
        t3 = k.w[i - 1]
        if i % 16 == 0:
            u = t0
            t0 = __AES_SBOX[int(t1)] xor rcon
            t1 = __AES_SBOX[int(t2)]
            t2 = __AES_SBOX[int(t3)]
            t3 = __AES_SBOX[int(u)]
            rcon = __xtime(rcon)
        k.w[i] = k.w[i - 16] xor t0
        k.w[i + 1] = k.w[i - 15] xor t1
        k.w[i + 2] = k.w[i - 14] xor t2
        k.w[i + 3] = k.w[i - 13] xor t3
        i += 4
    loop j in [0..44): k.rk[j] = (u32(k.w[j * 4]) << 24) | (u32(k.w[j * 4 + 1]) << 16) | (u32(k.w[j * 4 + 2]) << 8) | u32(k.w[j * 4 + 3])
    k

# (SubBytes, ShiftRows and MixColumns as four tables of 256 words, made once: a round is 16
# lookups. Not constant-time, as the bytes-wise way was not either)
__aes_te: u32[]
__aes_tables = ():
    if __aes_te.len() > 0: return
    loop t in [0..4):
        loop x in [0..256):
            s = __AES_SBOX[x]
            s2 = __xtime(s)
            s3 = s2 xor s
            w = (u32(s2) << 24) | (u32(s) << 16) | (u32(s) << 8) | u32(s3)
            # (table t: the word rotated right by 8 t bits)
            if t > 0: w = (w >> u32(8 * t)) | (w << u32(32 - 8 * t))
            __aes_te.push(w)

__xtime = (x: u8) -> u8:
    if x & 0x80 != 0: return (x << 1) xor 0x1b
    x << 1

# one 16-byte block encrypted
aes_encrypt_block = (k: AesKey, block: u8[16]) -> u8[16]:
    w = __aes_words(k, __be32(block, 0), __be32(block, 4), __be32(block, 8), __be32(block, 12))
    out: u8[16]
    loop c in [0..4):
        v = if c == 0: w.0 else: if c == 1: w.1 else: if c == 2: w.2 else: w.3
        loop row in [0..4): out[c * 4 + row] = u8((v >> u32(24 - row * 8)) & 255)
    out

# a block as four big-endian words, encrypted
__aes_words = (k: AesKey, b0: u32, b1: u32, b2: u32, b3: u32) -> (u32, u32, u32, u32):
    __aes_tables()
    te = __aes_te
    rk = k.rk
    s0 = b0 xor rk[0]
    s1 = b1 xor rk[1]
    s2 = b2 xor rk[2]
    s3 = b3 xor rk[3]
    loop r in [1..10):
        t0 = te[int(s0 >> 24)] xor te[256 + int((s1 >> 16) & 255)] xor te[512 + int((s2 >> 8) & 255)] xor te[768 + int(s3 & 255)] xor rk[r * 4]
        t1 = te[int(s1 >> 24)] xor te[256 + int((s2 >> 16) & 255)] xor te[512 + int((s3 >> 8) & 255)] xor te[768 + int(s0 & 255)] xor rk[r * 4 + 1]
        t2 = te[int(s2 >> 24)] xor te[256 + int((s3 >> 16) & 255)] xor te[512 + int((s0 >> 8) & 255)] xor te[768 + int(s1 & 255)] xor rk[r * 4 + 2]
        t3 = te[int(s3 >> 24)] xor te[256 + int((s0 >> 16) & 255)] xor te[512 + int((s1 >> 8) & 255)] xor te[768 + int(s2 & 255)] xor rk[r * 4 + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
    # (the last round: no MixColumns)
    sb = __AES_SBOX
    last = (a: u32, b: u32, c: u32, d: u32, key: u32) -> u32: ((u32(sb[int(a >> 24)]) << 24) | (u32(sb[int((b >> 16) & 255)]) << 16) | (u32(sb[int((c >> 8) & 255)]) << 8) | u32(sb[int(d & 255)])) xor key
    (last(s0, s1, s2, s3, rk[40]), last(s1, s2, s3, s0, rk[41]), last(s2, s3, s0, s1, rk[42]), last(s3, s0, s1, s2, rk[43]))

# ---------------- AES-GCM ----------------
# ---- GHASH, constant-time ----
__be64 = (b: u8[16], i: int) -> u64:
    v = u64(0)
    loop k in [0..8): v = (v << 8) | u64(b[i + k])
    v

# (carry-less multiplication of 64-bit numbers, the low 64 bits, by integer multiplication: each
# number's bits split four ways, so that the carries fall in the gaps between them; the same steps
# whatever the numbers, as BearSSL's ghash_ctmul64)
__bmul64 = (x: u64, y: u64) -> u64:
    m0 = u64(0x1111111111111111)
    m1 = u64(0x2222222222222222)
    m2 = u64(0x4444444444444444)
    m3 = u64(0x8888888888888888)
    x0 = x & m0
    x1 = x & m1
    x2 = x & m2
    x3 = x & m3
    y0 = y & m0
    y1 = y & m1
    y2 = y & m2
    y3 = y & m3
    z0 = (x0 * y0) xor (x1 * y3) xor (x2 * y2) xor (x3 * y1)
    z1 = (x0 * y1) xor (x1 * y0) xor (x2 * y3) xor (x3 * y2)
    z2 = (x0 * y2) xor (x1 * y1) xor (x2 * y0) xor (x3 * y3)
    z3 = (x0 * y3) xor (x1 * y2) xor (x2 * y1) xor (x3 * y0)
    (z0 & m0) | (z1 & m1) | (z2 & m2) | (z3 & m3)

__rev64 = (x0: u64) -> u64:
    x = ((x0 & 0x5555555555555555) << 1) | ((x0 >> 1) & 0x5555555555555555)
    x = ((x & 0x3333333333333333) << 2) | ((x >> 2) & 0x3333333333333333)
    x = ((x & 0x0F0F0F0F0F0F0F0F) << 4) | ((x >> 4) & 0x0F0F0F0F0F0F0F0F)
    x = ((x & 0x00FF00FF00FF00FF) << 8) | ((x >> 8) & 0x00FF00FF00FF00FF)
    x = ((x & 0x0000FFFF0000FFFF) << 16) | ((x >> 16) & 0x0000FFFF0000FFFF)
    (x << 32) | (x >> 32)

__be64_at = (b: u8[], i: int) -> u64:
    v = u64(0)
    loop k in [0..8): v = (v << 8) | (if i + k < b.len(): u64(b[i + k]) else: u64(0))
    v

# GHASH of aad and c under h: a block at a time, y = (y xor block) * h in GF(2^128) (GCM's bit
# order), each product from three 64-bit carry-less ones on the bits as they are and three on them
# reversed (Karatsuba), then reduced
__ghash = (hb: u8[16], aad: u8[], c: u8[]) -> u8[16]:
    h1 = __be64(hb, 0)
    h0 = __be64(hb, 8)
    h0r = __rev64(h0)
    h1r = __rev64(h1)
    h2 = h0 xor h1
    h2r = h0r xor h1r
    y1 = u64(0)
    y0 = u64(0)
    lens: u8[] = []
    loop k in [0..8): lens.push(u8(((aad.len() * 8) >> (56 - k * 8)) & 255))
    loop k in [0..8): lens.push(u8(((c.len() * 8) >> (56 - k * 8)) & 255))
    loop part in [aad, c, lens]:
        i = 0
        loop i < part.len():
            y1 = y1 xor __be64_at(part, i)
            y0 = y0 xor __be64_at(part, i + 8)
            y0r = __rev64(y0)
            y1r = __rev64(y1)
            y2 = y0 xor y1
            y2r = y0r xor y1r
            z0 = __bmul64(y0, h0)
            z1 = __bmul64(y1, h1)
            z2 = __bmul64(y2, h2)
            zh0 = __bmul64(y0r, h0r)
            zh1 = __bmul64(y1r, h1r)
            zh2 = __bmul64(y2r, h2r)
            z2 = z2 xor z0 xor z1
            zh2 = zh2 xor zh0 xor zh1
            zh0 = __rev64(zh0) >> 1
            zh1 = __rev64(zh1) >> 1
            zh2 = __rev64(zh2) >> 1
            v0 = z0
            v1 = zh0 xor z2
            v2 = z1 xor zh2
            v3 = zh1
            v3 = (v3 << 1) | (v2 >> 63)
            v2 = (v2 << 1) | (v1 >> 63)
            v1 = (v1 << 1) | (v0 >> 63)
            v0 = v0 << 1
            v2 = v2 xor v0 xor (v0 >> 1) xor (v0 >> 2) xor (v0 >> 7)
            v1 = v1 xor (v0 << 63) xor (v0 << 62) xor (v0 << 57)
            v3 = v3 xor v1 xor (v1 >> 1) xor (v1 >> 2) xor (v1 >> 7)
            v2 = v2 xor (v1 << 63) xor (v1 << 62) xor (v1 << 57)
            y0 = v2
            y1 = v3
            i += 16
    out: u8[16]
    loop k in [0..8):
        out[k] = u8((y1 >> u64(56 - k * 8)) & 255)
        out[8 + k] = u8((y0 >> u64(56 - k * 8)) & 255)
    out

# the CTR keystream from counter block j0 + 1 on, applied to src
__gcm_ctr = (k: AesKey, j0: u8[16], src: u8[]) -> u8[]:
    out = src
    c0 = __be32(j0, 0)
    c1 = __be32(j0, 4)
    c2 = __be32(j0, 8)
    # (the last 4 bytes count, big-endian)
    n = __be32(j0, 12)
    i = 0
    loop i < src.len():
        n += 1
        w = __aes_words(k, c0, c1, c2, n)
        if i + 16 <= src.len():
            loop c in [0..4):
                v = if c == 0: w.0 else: if c == 1: w.1 else: if c == 2: w.2 else: w.3
                at = i + c * 4
                out[at] = out[at] xor u8(v >> 24)
                out[at + 1] = out[at + 1] xor u8((v >> 16) & 255)
                out[at + 2] = out[at + 2] xor u8((v >> 8) & 255)
                out[at + 3] = out[at + 3] xor u8(v & 255)
        else:
            loop j in [0..src.len() - i):
                v = if j < 4: w.0 else: if j < 8: w.1 else: if j < 12: w.2 else: w.3
                out[i + j] = out[i + j] xor u8((v >> u32(24 - (j % 4) * 8)) & 255)
        i += 16
    out

__gcm_j0 = (nonce: u8[]) -> u8[16]:
    if nonce.len() != 12: panic("aes_gcm: the nonce is 12 bytes, not {nonce.len()}")
    j0: u8[16]
    loop i in [0..12): j0[i] = nonce[i]
    j0[15] = 1
    j0

# the message encrypted, then its 16-byte tag: nonce (12 bytes) must never repeat for one key;
# aad is bytes the tag covers that travel unencrypted
aes_gcm_seal = (key: AesKey, nonce: u8[], aad: u8[], message: u8[]) -> u8[]:
    zero: u8[16]
    h = aes_encrypt_block(key, zero)
    j0 = __gcm_j0(nonce)
    c = __gcm_ctr(key, j0, message)
    s = __ghash(h, aad, c)
    t = aes_encrypt_block(key, j0)
    out = c
    loop j in [0..16): out.push(t[j] xor s[j])
    out

# the message back from aes_gcm_seal's bytes, or none when they (or aad) were changed
aes_gcm_open = (key: AesKey, nonce: u8[], aad: u8[], sealed: u8[]) -> u8[]?:
    if sealed.len() < 16: return none
    c = sealed[..sealed.len() - 16)
    zero: u8[16]
    h = aes_encrypt_block(key, zero)
    j0 = __gcm_j0(nonce)
    s = __ghash(h, aad, c)
    t = aes_encrypt_block(key, j0)
    diff = u8(0)
    loop j in [0..16): diff = diff | (sealed[c.len() + j] xor t[j] xor s[j])
    if diff != 0: return none
    __gcm_ctr(key, j0, c)

# ---------------- 256-bit numbers ----------------
# (eight 32-bit limbs, the lowest first)
__u256_be = (b: u8[], off: int) -> u32[8]:
    r: u32[8]
    loop i in [0..8): r[7 - i] = __be32(b, off + i * 4)
    r

__u256_bytes = (a: u32[8]) -> u8[]:
    out: u8[]
    i = 7
    loop i >= 0:
        __put32(out, a[i])
        i -= 1
    out

__u256_hex = (s: str) -> u32[8]: __u256_be(hex_bytes(s)!, 0)

__u256_cmp = (a: u32[8], b: u32[8]) -> int:
    i = 7
    loop i >= 0:
        if a[i] != b[i]: return if a[i] < b[i]: -1 else: 1
        i -= 1
    0

__u256_is_zero = (a: u32[8]) -> bool:
    loop x in a:
        if x != 0: return false
    true

# a + b, and the carry out
__u256_add = (a: u32[8], b: u32[8]) -> (u32[8], u64):
    r: u32[8]
    c = u64(0)
    loop i in [0..8):
        s = u64(a[i]) + u64(b[i]) + c
        r[i] = u32(s & 0xFFFFFFFF)
        c = s >> 32
    (r, c)

# a - b, and the borrow out (1 when b > a)
__u256_sub = (a: u32[8], b: u32[8]) -> (u32[8], u64):
    r: u32[8]
    bw = u64(0)
    loop i in [0..8):
        s = u64(a[i]) - u64(b[i]) - bw
        r[i] = u32(s & 0xFFFFFFFF)
        bw = (s >> 63) & 1
    (r, bw)

# a modulus and what its Montgomery arithmetic needs
struct __Mod:
    m: u32[8]
    minv: u32               # -m^-1 mod 2^32
    r2: u32[8]              # 2^512 mod m (to Montgomery form)
    one: u32[8]             # 2^256 mod m (1 in Montgomery form)

__mod_new = (m: u32[8]) -> __Mod:
    inv = u32(1)
    loop _ in [0..5): inv = inv * (u32(2) - m[0] * inv)
    md = __Mod(m, u32(0) - inv)
    # (2^256 mod m, then doubled 256 times more)
    x: u32[8]
    x[0] = 1
    loop _ in [0..512): x = __add_mod(x, x, m)
    md.r2 = x
    md.one = __mont(md, x, [u32(1), 0, 0, 0, 0, 0, 0, 0])
    md

# (the field's arithmetic takes as long whatever the numbers: no branch on them, so its time
# says nothing of a key)

# a when bit is 1, else b (bit 0 or 1), with no branch
__u256_pick = (bit: u64, a: u32[8], b: u32[8]) -> u32[8]:
    mask = u32(0) - u32(bit)
    r: u32[8]
    loop i in [0..8): r[i] = (a[i] & mask) | (b[i] & ~mask)
    r

__add_mod = (a: u32[8], b: u32[8], m: u32[8]) -> u32[8]:
    s, c = __u256_add(a, b)
    t, bw = __u256_sub(s, m)
    # (s - m when the sum carried out, or is m or more)
    __u256_pick(c | (bw xor 1), t, s)

__sub_mod = (a: u32[8], b: u32[8], m: u32[8]) -> u32[8]:
    d, bw = __u256_sub(a, b)
    t, _ = __u256_add(d, m)
    __u256_pick(bw, t, d)

# a * b * 2^-256 mod m (Montgomery multiplication, operand-scanning)
__mont = (md: __Mod, a: u32[8], b: u32[8]) -> u32[8]:
    t: u64[10]
    loop i in [0..8):
        c = u64(0)
        bi = u64(b[i])
        loop j in [0..8):
            s = t[j] + u64(a[j]) * bi + c
            t[j] = s & 0xFFFFFFFF
            c = s >> 32
        s = t[8] + c
        t[8] = s & 0xFFFFFFFF
        t[9] = s >> 32
        q = (t[0] * u64(md.minv)) & 0xFFFFFFFF
        s = t[0] + q * u64(md.m[0])
        c = s >> 32
        loop j in [1..8):
            s = t[j] + q * u64(md.m[j]) + c
            t[j - 1] = s & 0xFFFFFFFF
            c = s >> 32
        s = t[8] + c
        t[7] = s & 0xFFFFFFFF
        t[8] = t[9] + (s >> 32)
        t[9] = 0
    r: u32[8]
    loop i in [0..8): r[i] = u32(t[i])
    r2, bw = __u256_sub(r, md.m)
    __u256_pick(t[8] | (bw xor 1), r2, r)

__to_mont = (md: __Mod, a: u32[8]) -> u32[8]: __mont(md, a, md.r2)
__from_mont = (md: __Mod, a: u32[8]) -> u32[8]: __mont(md, a, [u32(1), 0, 0, 0, 0, 0, 0, 0])

# a^e (a in Montgomery form, and the result)
__mont_pow = (md: __Mod, a: u32[8], e: u32[8]) -> u32[8]:
    r = md.one
    i = 255
    loop i >= 0:
        r = __mont(md, r, r)
        if (e[i >> 5] >> u32(i & 31)) & 1 != 0: r = __mont(md, r, a)
        i -= 1
    r

# a^-1 (Montgomery form in and out; m prime: a^(m-2))
__mont_inv = (md: __Mod, a: u32[8]) -> u32[8]:
    e, _ = __u256_sub(md.m, [u32(2), 0, 0, 0, 0, 0, 0, 0])
    __mont_pow(md, a, e)

# ---------------- P-256 ----------------
__p256_ready = false
__P: __Mod
__N: __Mod
__B: u32[8]                 # (Montgomery form)
__GX: u32[8]
__GY: u32[8]

__p256_init = ():
    global __B, __GX, __GY, __N, __P, __p256_ready
    if __p256_ready: return
    __p256_ready = true
    __P = __mod_new(__u256_hex("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"))
    __N = __mod_new(__u256_hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"))
    __B = __to_mont(__P, __u256_hex("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"))
    __GX = __to_mont(__P, __u256_hex("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"))
    __GY = __to_mont(__P, __u256_hex("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"))

# a point in projective coordinates (x / z, y / z), Montgomery form; (0, 1, 0): the point at infinity
struct __Pt:
    x: u32[8]
    y: u32[8]
    z: u32[8]

__fadd = (a: u32[8], b: u32[8]) -> u32[8]: __add_mod(a, b, __P.m)
__fsub = (a: u32[8], b: u32[8]) -> u32[8]: __sub_mod(a, b, __P.m)
__fmul = (a: u32[8], b: u32[8]) -> u32[8]: __mont(__P, a, b)

__pt_zero = () -> __Pt: __Pt([u32(0), 0, 0, 0, 0, 0, 0, 0], __P.one, [u32(0), 0, 0, 0, 0, 0, 0, 0])

# p + q, for any two points (the same, each other's negatives, infinity): Renes, Costello and
# Batina's complete formula for a = -3 (2015/1060, algorithm 4), the same steps whatever they are
__pt_add = (p: __Pt, q: __Pt) -> __Pt:
    t0 = __fmul(p.x, q.x)
    t1 = __fmul(p.y, q.y)
    t2 = __fmul(p.z, q.z)
    t3 = __fmul(__fadd(p.x, p.y), __fadd(q.x, q.y))
    t3 = __fsub(t3, __fadd(t0, t1))
    t4 = __fmul(__fadd(p.y, p.z), __fadd(q.y, q.z))
    t4 = __fsub(t4, __fadd(t1, t2))
    y3 = __fmul(__fadd(p.x, p.z), __fadd(q.x, q.z))
    y3 = __fsub(y3, __fadd(t0, t2))
    z3 = __fmul(__B, t2)
    x3 = __fsub(y3, z3)
    x3 = __fadd(x3, __fadd(x3, x3))
    z3 = __fsub(t1, x3)
    x3 = __fadd(t1, x3)
    y3 = __fmul(__B, y3)
    t1 = __fadd(t2, t2)
    t2 = __fadd(t1, t2)
    y3 = __fsub(__fsub(y3, t2), t0)
    y3 = __fadd(y3, __fadd(y3, y3))
    t1 = __fadd(t0, t0)
    t0 = __fsub(__fadd(t1, t0), t2)
    t1 = __fmul(t4, y3)
    t2 = __fmul(t0, y3)
    y3 = __fadd(__fmul(x3, z3), t2)
    x3 = __fsub(__fmul(t3, x3), t1)
    z3 = __fadd(__fmul(t4, z3), __fmul(t3, t0))
    __Pt(x3, y3, z3)

# 0, p, 2p .. 15p: what __pt_muls takes four bits of a scalar at a time from
__pt_table = (p: __Pt) -> __Pt[]:
    table = [__pt_zero(), p]
    loop i in [2..16): table.push(__pt_add(table[i - 1], p))
    table

# the sum of each k * p (each p as its table): four bits at a time, each multiple taken from its
# table by reading all of it, so that neither the steps nor what is read depends on a k. (The
# doublings are shared: two products cost little more than one.)
__pt_muls = (tables: __Pt[][], ks: u32[8][]) -> __Pt:
    r = __pt_zero()
    w = 63
    loop w >= 0:
        loop _ in [0..4): r = __pt_add(r, r)
        loop j in [0..tables.len()):
            t = tables[j]
            bits = (ks[j][w >> 3] >> u32((w & 7) * 4)) & 15
            e = t[0]
            loop i in [1..16):
                d = u32(i) xor bits
                same = u64(((d | (u32(0) - d)) >> 31) xor 1)
                e = __Pt(__u256_pick(same, t[i].x, e.x), __u256_pick(same, t[i].y, e.y), __u256_pick(same, t[i].z, e.z))
            r = __pt_add(r, e)
        w -= 1
    r

# (the generator's table, made once)
__g_table: __Pt[] = []
__pt_mul_g = (k: u32[8]) -> __Pt:
    global __g_table
    if __g_table.len() == 0: __g_table = __pt_table(__p256_g())
    __pt_muls([__g_table], [k])

# the affine x and y (not Montgomery form), or none at infinity
__pt_affine = (p: __Pt) -> (u32[8], u32[8])?:
    if __u256_is_zero(p.z): return none
    zi = __mont_inv(__P, p.z)
    (__from_mont(__P, __fmul(p.x, zi)), __from_mont(__P, __fmul(p.y, zi)))

__p256_g = () -> __Pt: __Pt(__GX, __GY, __P.one)

# a P-256 key: the private scalar and the public point (65 bytes: 0x04, x, y)
struct P256Key:
    private: u8[]
    public: u8[]

# a new key, from the system's random bytes
p256_key = () -> P256Key:
    __p256_init()
    loop true:
        d = random_bytes(32)
        k = __u256_be(d, 0)
        if __u256_is_zero(k) or __u256_cmp(k, __N.m) >= 0: continue
        return P256Key(d, __p256_point_bytes(__pt_mul_g(k)))

__p256_point_bytes = (p: __Pt) -> u8[]:
    out: u8[] = [u8(4)]
    if let xy = __pt_affine(p):
        out.extend(__u256_bytes(xy.0))
        out.extend(__u256_bytes(xy.1))
    out

# a public point's 65 bytes as a point, when it is one on the curve (else none)
__p256_point = (b: u8[]) -> __Pt?:
    __p256_init()
    if b.len() != 65 or b[0] != 4: return none
    x = __u256_be(b, 1)
    y = __u256_be(b, 33)
    if __u256_cmp(x, __P.m) >= 0 or __u256_cmp(y, __P.m) >= 0: return none
    xm = __to_mont(__P, x)
    ym = __to_mont(__P, y)
    # y^2 == x^3 - 3x + b
    lhs = __fmul(ym, ym)
    x3 = __fmul(__fmul(xm, xm), xm)
    rhs = __fadd(__fsub(__fsub(__fsub(x3, xm), xm), xm), __B)
    if __u256_cmp(lhs, rhs) != 0: return none
    __Pt(xm, ym, __P.one)

# the shared secret of a key and another's public point (its x, 32 bytes), or none when that is no
# point on the curve
p256_ecdh = (k: P256Key, other: u8[]) -> u8[]?:
    if let q = __p256_point(other):
        if let xy = __pt_affine(__pt_muls([__pt_table(q)], [__u256_be(k.private, 0)])): return __u256_bytes(xy.0)
    none

# a hash's integer, reduced mod n
__hash_int = (h: u8[]) -> u32[8]:
    e = __u256_be(h, 0)
    if __u256_cmp(e, __N.m) >= 0:
        r, _ = __u256_sub(e, __N.m)
        return r
    e

# an ECDSA signature of a 32-byte hash: r and s, 32 bytes each
p256_sign = (k: P256Key, hash: u8[]) -> u8[]:
    __p256_init()
    d = __to_mont(__N, __u256_be(k.private, 0))
    e = __to_mont(__N, __hash_int(hash))
    loop true:
        kb = __u256_be(random_bytes(32), 0)
        if __u256_is_zero(kb) or __u256_cmp(kb, __N.m) >= 0: continue
        if let xy = __pt_affine(__pt_mul_g(kb)):
            r = xy.0
            if __u256_cmp(r, __N.m) >= 0:
                rr, _ = __u256_sub(r, __N.m)
                r = rr
            if __u256_is_zero(r): continue
            rm = __to_mont(__N, r)
            kinv = __mont_inv(__N, __to_mont(__N, kb))
            s = __from_mont(__N, __mont(__N, kinv, __add_mod(e, __mont(__N, rm, d), __N.m)))
            if __u256_is_zero(s): continue
            out = __u256_bytes(r)
            out.extend(__u256_bytes(s))
            return out

# whether sig (r and s, 32 bytes each) signs the 32-byte hash for the public point
p256_verify = (public: u8[], hash: u8[], sig: u8[]) -> bool:
    global __g_table
    __p256_init()
    if sig.len() != 64: return false
    qq = __p256_point(public)
    if qq == none: return false
    q = qq!
    r = __u256_be(sig, 0)
    s = __u256_be(sig, 32)
    if __u256_is_zero(r) or __u256_is_zero(s) or __u256_cmp(r, __N.m) >= 0 or __u256_cmp(s, __N.m) >= 0: return false
    w = __mont_inv(__N, __to_mont(__N, s))
    u1 = __from_mont(__N, __mont(__N, __to_mont(__N, __hash_int(hash)), w))
    u2 = __from_mont(__N, __mont(__N, __to_mont(__N, r), w))
    if __g_table.len() == 0: __g_table = __pt_table(__p256_g())
    p = __pt_muls([__g_table, __pt_table(q)], [u1, u2])
    pa = __pt_affine(p)
    if pa == none: return false
    x = pa!.0
    if __u256_cmp(x, __N.m) >= 0:
        xx, _ = __u256_sub(x, __N.m)
        x = xx
    __u256_cmp(x, r) == 0

# ---------------- X25519 (RFC 7748) ----------------
# (numbers mod 2^255 - 19 as 16 limbs of 16 bits, the lowest first, which may run over between
# steps; the ladder swaps by masks and never branches on the key, so it takes the same time
# whatever the key)

# carry each limb's overflow into the next (the top one's, times 38, into the first)
__fe_carry = (o: mut int[16]):
    loop i in [0..16):
        o[i] += 1 << 16
        c = o[i] >> 16
        if i < 15: o[i + 1] += c - 1
        else: o[0] += 38 * (c - 1)
        o[i] -= c << 16

# p and q swapped when bit is 1, left when 0 (with no branch)
__fe_swap = (p: mut int[16], q: mut int[16], bit: int):
    mask = -bit
    loop i in [0..16):
        t = mask & (p[i] xor q[i])
        p[i] = p[i] xor t
        q[i] = q[i] xor t

__fe_add = (a: int[16], b: int[16]) -> int[16]:
    o: int[16]
    loop i in [0..16): o[i] = a[i] + b[i]
    o

__fe_sub = (a: int[16], b: int[16]) -> int[16]:
    o: int[16]
    loop i in [0..16): o[i] = a[i] - b[i]
    o

__fe_mul = (a: int[16], b: int[16]) -> int[16]:
    t: int[31]
    loop i in [0..16):
        ai = a[i]
        loop j in [0..16): t[i + j] += ai * b[j]
    o: int[16]
    loop i in [0..15): t[i] += 38 * t[i + 16]
    loop i in [0..16): o[i] = t[i]
    __fe_carry(o)
    __fe_carry(o)
    o

# a^-1 (a^(p-2))
__fe_inv = (a: int[16]) -> int[16]:
    c = a
    k = 253
    loop k >= 0:
        c = __fe_mul(c, c)
        if k != 2 and k != 4: c = __fe_mul(c, a)
        k -= 1
    c

__fe_bytes = (a: int[16]) -> u8[]:
    t = a
    __fe_carry(t)
    __fe_carry(t)
    __fe_carry(t)
    # (less p, twice, kept when that did not go below zero)
    loop _ in [0..2):
        m: int[16]
        m[0] = t[0] - 0xffed
        loop i in [1..15):
            m[i] = t[i] - 0xffff - ((m[i - 1] >> 16) & 1)
            m[i - 1] = m[i - 1] & 0xffff
        m[15] = t[15] - 0x7fff - ((m[14] >> 16) & 1)
        borrow = (m[15] >> 16) & 1
        m[14] = m[14] & 0xffff
        __fe_swap(t, m, 1 - borrow)
    out: u8[]
    loop i in [0..16):
        out.push(u8(t[i] & 255))
        out.push(u8((t[i] >> 8) & 255))
    out

__fe_from = (b: u8[]) -> int[16]:
    o: int[16]
    loop i in [0..16): o[i] = int(b[2 * i]) + (int(b[2 * i + 1]) << 8)
    o[15] = o[15] & 0x7fff
    o

# scalar times the point whose u is given (32 bytes each, little-endian)
__x25519 = (scalar: u8[], u: u8[]) -> u8[]:
    z = scalar
    z[31] = (z[31] & 127) | 64
    z[0] = z[0] & 248
    x = __fe_from(u)
    a: int[16]
    b = x
    c: int[16]
    d: int[16]
    a[0] = 1
    d[0] = 1
    k121665: int[16]
    k121665[0] = 0xDB41
    k121665[1] = 1
    i = 254
    loop i >= 0:
        r = int((z[i >> 3] >> u8(i & 7)) & 1)
        __fe_swap(a, b, r)
        __fe_swap(c, d, r)
        e = __fe_add(a, c)
        a = __fe_sub(a, c)
        c = __fe_add(b, d)
        b = __fe_sub(b, d)
        d = __fe_mul(e, e)
        f = __fe_mul(a, a)
        a = __fe_mul(c, a)
        c = __fe_mul(b, e)
        e = __fe_add(a, c)
        a = __fe_sub(a, c)
        b = __fe_mul(a, a)
        c = __fe_sub(d, f)
        a = __fe_mul(c, k121665)
        a = __fe_add(a, d)
        c = __fe_mul(c, a)
        a = __fe_mul(d, f)
        d = __fe_mul(b, x)
        b = __fe_mul(e, e)
        __fe_swap(a, b, r)
        __fe_swap(c, d, r)
        i -= 1
    __fe_bytes(__fe_mul(a, __fe_inv(c)))

# an X25519 key: the private scalar and the public value, 32 bytes each
struct X25519Key:
    private: u8[]
    public: u8[]

# a new key, from the system's random bytes
x25519_key = () -> X25519Key:
    d = random_bytes(32)
    base = fill(u8(0), 32)
    base[0] = 9
    X25519Key(d, __x25519(d, base))

# the shared secret of a key and another's public value (32 bytes), or none when it comes out all
# zeros (the other's value was one of the few that make it so)
x25519_ecdh = (k: X25519Key, other: u8[]) -> u8[]?:
    if other.len() != 32: return none
    s = __x25519(k.private, other)
    acc = u8(0)
    loop v in s: acc = acc | v
    if acc == 0: return none
    s

# ---------------- big numbers (RSA, P-384) ----------------
# (32-bit limbs, the lowest first; all the numbers of one modulus have its count of limbs)
__bn_be = (b: u8[], n: int) -> u32[]:
    r = fill(u32(0), n)
    loop i in [0..b.len()):
        k = b.len() - 1 - i
        if k / 4 < n: r[k / 4] = r[k / 4] | (u32(b[i]) << u32((k % 4) * 8))
    r

# a as nbytes big-endian bytes
__bn_bytes = (a: u32[], nbytes: int) -> u8[]:
    out = fill(u8(0), nbytes)
    loop k in [0..nbytes):
        if k / 4 < a.len(): out[nbytes - 1 - k] = u8((a[k / 4] >> u32((k % 4) * 8)) & 255)
    out

__bn_cmp = (a: u32[], b: u32[]) -> int:
    i = a.len() - 1
    loop i >= 0:
        if a[i] != b[i]: return if a[i] < b[i]: -1 else: 1
        i -= 1
    0

__bn_is_zero = (a: u32[]) -> bool:
    loop x in a:
        if x != 0: return false
    true

# a - b (when b > a: wrapped around 2^(32 limbs)), and the borrow
__bn_sub = (a: u32[], b: u32[]) -> (u32[], u64):
    r = fill(u32(0), a.len())
    bw = u64(0)
    loop i in [0..a.len()):
        s = u64(a[i]) - u64(b[i]) - bw
        r[i] = u32(s & 0xFFFFFFFF)
        bw = (s >> 63) & 1
    (r, bw)

__bn_add = (a: u32[], b: u32[]) -> (u32[], u64):
    r = fill(u32(0), a.len())
    c = u64(0)
    loop i in [0..a.len()):
        s = u64(a[i]) + u64(b[i]) + c
        r[i] = u32(s & 0xFFFFFFFF)
        c = s >> 32
    (r, c)

# an odd modulus and what its Montgomery arithmetic needs (as __Mod, any size)
struct __BnMod:
    m: u32[]
    minv: u32               # -m^-1 mod 2^32
    r2: u32[]               # R^2 mod m (R: 2^(32 limbs))
    one: u32[]              # R mod m

__bn_mod = (m: u32[]) -> __BnMod:
    inv = u32(1)
    loop _ in [0..5): inv = inv * (u32(2) - m[0] * inv)
    md = __BnMod(m, u32(0) - inv)
    x = fill(u32(0), m.len())
    x[0] = 1
    loop _ in [0..64 * m.len()): x = __bn_addm(md, x, x)
    md.r2 = x
    one = fill(u32(0), m.len())
    one[0] = 1
    md.one = __bn_mont(md, x, one)
    md

__bn_addm = (md: __BnMod, a: u32[], b: u32[]) -> u32[]:
    s, c = __bn_add(a, b)
    if c != 0 or __bn_cmp(s, md.m) >= 0:
        t, _ = __bn_sub(s, md.m)
        return t
    s

__bn_subm = (md: __BnMod, a: u32[], b: u32[]) -> u32[]:
    d, bw = __bn_sub(a, b)
    if bw != 0:
        t, _ = __bn_add(d, md.m)
        return t
    d

# a * b / R mod m (operand-scanning, as __mont; through pointers, its loops are twice as fast
# as with indexes checked, in a debug build)
__bn_mont = (md: __BnMod, a: u32[], b: u32[]) -> u32[]:
    m = md.m
    n = m.len()
    if a.len() != n or b.len() != n: panic("__bn_mont: numbers of {a.len()} and {b.len()} limbs, mod one of {n}")
    minv = u64(md.minv)
    tt = fill(u64(0), n + 2)
    t = data(tt)
    pa = data(a)
    pm = data(m)
    loop i in [0..n):
        c = u64(0)
        bi = u64(b[i])
        loop j in [0..n):
            s = t[j] + u64(pa[j]) * bi + c
            t[j] = s & 0xFFFFFFFF
            c = s >> 32
        s = t[n] + c
        t[n] = s & 0xFFFFFFFF
        t[n + 1] = s >> 32
        q = (t[0] * minv) & 0xFFFFFFFF
        s = t[0] + q * u64(pm[0])
        c = s >> 32
        loop j in [1..n):
            s = t[j] + q * u64(pm[j]) + c
            t[j - 1] = s & 0xFFFFFFFF
            c = s >> 32
        s = t[n] + c
        t[n - 1] = s & 0xFFFFFFFF
        t[n] = t[n + 1] + (s >> 32)
        t[n + 1] = 0
    r = fill(u32(0), n)
    loop i in [0..n): r[i] = u32(t[i])
    if t[n] != 0 or __bn_cmp(r, m) >= 0:
        r2, _ = __bn_sub(r, m)
        return r2
    r

__bn_to_mont = (md: __BnMod, a: u32[]) -> u32[]: __bn_mont(md, a, md.r2)
__bn_from_mont = (md: __BnMod, a: u32[]) -> u32[]:
    one = fill(u32(0), md.m.len())
    one[0] = 1
    __bn_mont(md, a, one)

# a^e, e given as big-endian bytes (a in Montgomery form, and the result; for public exponents
# and for inverses mod a prime: it branches on e's bits)
__bn_pow = (md: __BnMod, a: u32[], e: u8[]) -> u32[]:
    r = md.one
    loop byte in e:
        k = 7
        loop k >= 0:
            r = __bn_mont(md, r, r)
            if (byte >> u8(k)) & 1 != 0: r = __bn_mont(md, r, a)
            k -= 1
    r

# a^-1 for a prime modulus (Montgomery form in and out)
__bn_inv = (md: __BnMod, a: u32[]) -> u32[]:
    two = fill(u32(0), md.m.len())
    two[0] = 2
    e, _ = __bn_sub(md.m, two)
    __bn_pow(md, a, __bn_bytes(e, md.m.len() * 4))

# ---------------- RSA signatures (checking only) ----------------
# A public key is its modulus n and exponent e, as big-endian bytes (as a certificate holds
# them). The hash says which hash was used by its length: SHA-256, SHA-384 or SHA-512.

# sig^e mod n, as many bytes as n has; none when sig is not a number below n
__rsa_open = (n0: u8[], e: u8[], sig: u8[]) -> u8[]?:
    n = n0
    loop n.len() > 0 and n[0] == 0: n = n[1..]
    if n.len() < 128 or n.len() > 1024 or n[n.len() - 1] & 1 == 0 or sig.len() != n.len(): return none
    limbs = (n.len() + 3) / 4
    md = __bn_mod(__bn_be(n, limbs))
    s = __bn_be(sig, limbs)
    if __bn_cmp(s, md.m) >= 0: return none
    m = __bn_from_mont(md, __bn_pow(md, __bn_to_mont(md, s), e))
    __bn_bytes(m, n.len())

__hash_of = (size: int, m: u8[]) -> u8[]:
    if size == 48: return sha384(m)
    if size == 64: return sha512(m)
    sha256(m)

# whether sig is an RSASSA-PKCS1-v1_5 signature of the hash (as certificates are signed)
rsa_verify_pkcs1 = (n: u8[], e: u8[], hash: u8[], sig: u8[]) -> bool:
    em = __rsa_open(n, e, sig)
    if em == none: return false
    # (DigestInfo: the hash's algorithm, then the hash)
    prefix: u8[] = []
    if hash.len() == 32: prefix = [u8(0x30), 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20]
    else if hash.len() == 48: prefix = [u8(0x30), 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30]
    else if hash.len() == 64: prefix = [u8(0x30), 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40]
    else: return false
    k = em!.len()
    want: u8[] = [u8(0), 1]
    loop want.len() < k - prefix.len() - hash.len() - 1: want.push(0xff)
    want.push(0)
    want.extend(prefix)
    want.extend(hash)
    want.len() == k and want == em!

# whether sig is an RSASSA-PSS signature of the hash, with MGF1 of the same hash and a salt as
# long as the hash (as TLS 1.3 signs)
rsa_verify_pss = (n: u8[], e: u8[], hash: u8[], sig: u8[]) -> bool:
    hl = hash.len()
    if hl != 32 and hl != 48 and hl != 64: return false
    k = 0
    loop k < n.len() and n[k] == 0: k += 1
    if k == n.len(): return false
    opened = __rsa_open(n, e, sig)
    if opened == none: return false
    # (emBits: one less than n's bits; EM is that many bits, in as few bytes)
    top = 0
    loop (int(n[k]) >> top) > 0: top += 1
    em_bits = (n.len() - k - 1) * 8 + top - 1
    em_len = (em_bits + 7) / 8
    full = opened!
    if full.len() > em_len:
        if full[0] != 0: return false
        full = full[1..]
    em = full
    if em_len < 2 * hl + 2 or em[em_len - 1] != 0xbc: return false
    db_len = em_len - hl - 1
    h = em[db_len..db_len + hl)
    zero_bits = 8 * em_len - em_bits
    if zero_bits > 0 and (int(em[0]) >> (8 - zero_bits)) != 0: return false
    mask = __mgf1(h, db_len)
    db = em[..db_len)
    loop i in [0..db_len): db[i] = db[i] xor mask[i]
    if zero_bits > 0: db[0] = db[0] & u8(255 >> zero_bits)
    # (DB: zeros, a 1, the salt)
    ps = db_len - hl - 1
    loop i in [0..ps):
        if db[i] != 0: return false
    if db[ps] != 1: return false
    mp = fill(u8(0), 8)
    mp.extend(hash)
    mp.extend(db[ps + 1..])
    __hash_of(hl, mp) == h

# MGF1 with the hash whose output is as long as seed
__mgf1 = (seed: u8[], n: int) -> u8[]:
    out: u8[]
    c = 0
    loop out.len() < n:
        m = seed
        __put32(m, u32(c))
        out.extend(__hash_of(seed.len(), m))
        c += 1
    out[..n)

# ---------------- P-384 (ECDSA signatures, checking only) ----------------
__p384_ready = false
__P384: __BnMod
__N384: __BnMod
__B384: u32[]               # (Montgomery form)
__G384: __BnJac

# a point in Jacobian coordinates, Montgomery form, as __Jac for any size (z all zeros: infinity)
struct __BnJac:
    x: u32[]
    y: u32[]
    z: u32[]

__p384_init = ():
    global __B384, __G384, __N384, __P384, __p384_ready
    if __p384_ready: return
    __p384_ready = true
    __P384 = __bn_mod(__bn_be(hex_bytes("fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff")!, 12))
    __N384 = __bn_mod(__bn_be(hex_bytes("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973")!, 12))
    __B384 = __bn_to_mont(__P384, __bn_be(hex_bytes("b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef")!, 12))
    gx = __bn_to_mont(__P384, __bn_be(hex_bytes("aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7")!, 12))
    gy = __bn_to_mont(__P384, __bn_be(hex_bytes("3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")!, 12))
    __G384 = __BnJac(gx, gy, __P384.one)

# (curves with a = -3: Jacobian coordinates, doubling and adding; only for checking signatures,
# where every number is public, so these may branch on them)
__bj_double = (md: __BnMod, p: __BnJac) -> __BnJac:
    if __bn_is_zero(p.z) or __bn_is_zero(p.y): return __BnJac(p.x, p.y, fill(u32(0), p.x.len()))
    zz = __bn_mont(md, p.z, p.z)
    t = __bn_mont(md, __bn_subm(md, p.x, zz), __bn_addm(md, p.x, zz))
    m = __bn_addm(md, __bn_addm(md, t, t), t)
    yy = __bn_mont(md, p.y, p.y)
    s = __bn_mont(md, p.x, yy)
    s = __bn_addm(md, s, s)
    s = __bn_addm(md, s, s)
    x3 = __bn_subm(md, __bn_subm(md, __bn_mont(md, m, m), s), s)
    y4 = __bn_mont(md, yy, yy)
    y4 = __bn_addm(md, y4, y4)
    y4 = __bn_addm(md, y4, y4)
    y4 = __bn_addm(md, y4, y4)
    y3 = __bn_subm(md, __bn_mont(md, m, __bn_subm(md, s, x3)), y4)
    z3 = __bn_mont(md, p.y, p.z)
    z3 = __bn_addm(md, z3, z3)
    __BnJac(x3, y3, z3)

__bj_add = (md: __BnMod, p: __BnJac, q: __BnJac) -> __BnJac:
    if __bn_is_zero(p.z): return q
    if __bn_is_zero(q.z): return p
    z1z1 = __bn_mont(md, p.z, p.z)
    u2 = __bn_mont(md, q.x, z1z1)
    s2 = __bn_mont(md, q.y, __bn_mont(md, p.z, z1z1))
    # (q with z = 1, as the points multiplied are: four multiplications fewer)
    u1 = p.x
    s1 = p.y
    if q.z != md.one:
        z2z2 = __bn_mont(md, q.z, q.z)
        u1 = __bn_mont(md, p.x, z2z2)
        s1 = __bn_mont(md, p.y, __bn_mont(md, q.z, z2z2))
    if __bn_cmp(u1, u2) == 0:
        if __bn_cmp(s1, s2) == 0: return __bj_double(md, p)
        return __BnJac(p.x, p.y, fill(u32(0), p.x.len()))
    h = __bn_subm(md, u2, u1)
    r = __bn_subm(md, s2, s1)
    hh = __bn_mont(md, h, h)
    hhh = __bn_mont(md, hh, h)
    v = __bn_mont(md, u1, hh)
    x3 = __bn_subm(md, __bn_subm(md, __bn_mont(md, r, r), hhh), __bn_addm(md, v, v))
    y3 = __bn_subm(md, __bn_mont(md, r, __bn_subm(md, v, x3)), __bn_mont(md, s1, hhh))
    z3 = if q.z != md.one: __bn_mont(md, __bn_mont(md, p.z, q.z), h) else: __bn_mont(md, p.z, h)
    __BnJac(x3, y3, z3)

# a * p + b * q (both at once: one doubling a bit; public numbers only, it branches on them)
__bj_mul2 = (md: __BnMod, p: __BnJac, a: u32[], q: __BnJac, b: u32[]) -> __BnJac:
    pq = __bj_add(md, p, q)
    r = __BnJac(p.x, p.y, fill(u32(0), p.x.len()))
    i = a.len() * 32 - 1
    loop i >= 0:
        r = __bj_double(md, r)
        ba = (a[i >> 5] >> u32(i & 31)) & 1
        bb = (b[i >> 5] >> u32(i & 31)) & 1
        if ba != 0 and bb != 0: r = __bj_add(md, r, pq)
        else if ba != 0: r = __bj_add(md, r, p)
        else if bb != 0: r = __bj_add(md, r, q)
        i -= 1
    r

# whether sig (r and s, 48 bytes each) signs the hash for the P-384 public point (97 bytes:
# 0x04, x, y); a hash longer than 48 bytes is cut to its first 48, as ECDSA does
p384_verify = (public: u8[], hash: u8[], sig: u8[]) -> bool:
    __p384_init()
    md = __P384
    nd = __N384
    if public.len() != 97 or public[0] != 4 or sig.len() != 96: return false
    x = __bn_be(public[1..49), 12)
    y = __bn_be(public[49..97), 12)
    if __bn_cmp(x, md.m) >= 0 or __bn_cmp(y, md.m) >= 0: return false
    xm = __bn_to_mont(md, x)
    ym = __bn_to_mont(md, y)
    # y^2 == x^3 - 3x + b
    rhs = __bn_mont(md, __bn_mont(md, xm, xm), xm)
    rhs = __bn_addm(md, __bn_subm(md, __bn_subm(md, __bn_subm(md, rhs, xm), xm), xm), __B384)
    if __bn_cmp(__bn_mont(md, ym, ym), rhs) != 0: return false
    r = __bn_be(sig[..48), 12)
    s = __bn_be(sig[48..), 12)
    if __bn_is_zero(r) or __bn_is_zero(s) or __bn_cmp(r, nd.m) >= 0 or __bn_cmp(s, nd.m) >= 0: return false
    e = __bn_be(hash[..min(hash.len(), 48)), 12)
    if __bn_cmp(e, nd.m) >= 0:
        ee, _ = __bn_sub(e, nd.m)
        e = ee
    w = __bn_inv(nd, __bn_to_mont(nd, s))
    u1 = __bn_from_mont(nd, __bn_mont(nd, __bn_to_mont(nd, e), w))
    u2 = __bn_from_mont(nd, __bn_mont(nd, __bn_to_mont(nd, r), w))
    p = __bj_mul2(md, __G384, u1, __BnJac(xm, ym, md.one), u2)
    if __bn_is_zero(p.z): return false
    zi = __bn_inv(md, p.z)
    ax = __bn_from_mont(md, __bn_mont(md, p.x, __bn_mont(md, zi, zi)))
    if __bn_cmp(ax, nd.m) >= 0:
        xx, _ = __bn_sub(ax, nd.m)
        ax = xx
    __bn_cmp(ax, r) == 0

# ---------------- DER ----------------
# r and s (32 bytes each) as an ECDSA signature in DER (as TLS and certificates carry it)
der_signature = (sig: u8[]) -> u8[]:
    body: u8[]
    loop part in [sig[..32), sig[32..64)]:
        v = part
        loop v.len() > 1 and v[0] == 0 and v[1] < 0x80: v = v[1..]
        if v[0] >= 0x80: v.insert(0, 0)
        body.push(2)
        body.push(u8(v.len()))
        body.extend(v)
    __der(0x30, body)

# a DER ECDSA signature as r and s (32 bytes each), or none when it is not one
der_signature_parts = (der: u8[]) -> u8[]?:
    if der.len() < 8 or der[0] != 0x30: return none
    out: u8[]
    i = 2
    loop _ in [0..2):
        if i + 2 > der.len() or der[i] != 2: return none
        n = int(der[i + 1])
        if i + 2 + n > der.len() or n > 33: return none
        v = der[i + 2..i + 2 + n)
        loop v.len() > 32 and v[0] == 0: v = v[1..]
        if v.len() > 32: return none
        loop v.len() < 32: v.insert(0, 0)
        out.extend(v)
        i += 2 + n
    out

# a DER element: its tag, length and contents
__der = (tag: int, body: u8[]) -> u8[]:
    out: u8[] = [u8(tag)]
    n = body.len()
    if n < 128: out.push(u8(n))
    else if n < 256:
        out.push(0x81)
        out.push(u8(n))
    else:
        out.push(0x82)
        out.push(u8(n >> 8))
        out.push(u8(n & 255))
    out.extend(body)
    out

__OID_ECDSA_SHA256: u8[] = [u8(6), 8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x02]
__OID_EC_PUBLIC: u8[] = [u8(6), 7, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01]
__OID_P256: u8[] = [u8(6), 8, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07]

# a self-signed X.509 certificate for the key (DER), named name: what DTLS (WebRTC's) shows the
# other side, which knows it by its SHA-256 fingerprint
self_signed_certificate = (k: P256Key, name: str) -> u8[]:
    alg = __der(0x30, __OID_ECDSA_SHA256)
    cn: u8[] = [u8(6), 3, 0x55, 0x04, 0x03]
    cn.extend(__der(0x0c, bytes(name)))
    dn = __der(0x30, __der(0x31, __der(0x30, cn)))
    validity: u8[]
    validity.extend(__der(0x17, bytes("250101000000Z")))
    validity.extend(__der(0x17, bytes("491231235959Z")))
    spki_alg: u8[]
    spki_alg.extend(__OID_EC_PUBLIC)
    spki_alg.extend(__OID_P256)
    key_bits: u8[] = [u8(0)]
    key_bits.extend(k.public)
    spki: u8[]
    spki.extend(__der(0x30, spki_alg))
    spki.extend(__der(0x03, key_bits))
    serial = random_bytes(8)
    serial[0] = serial[0] & 0x7f
    tbs: u8[]
    tbs.extend(__der(0xa0, __der(2, [u8(2)])))
    tbs.extend(__der(2, serial))
    tbs.extend(alg)
    tbs.extend(dn)
    tbs.extend(__der(0x30, validity))
    tbs.extend(dn)
    tbs.extend(__der(0x30, spki))
    tbs_der = __der(0x30, tbs)
    sig: u8[] = [u8(0)]
    sig.extend(der_signature(p256_sign(k, sha256(tbs_der))))
    cert: u8[]
    cert.extend(tbs_der)
    cert.extend(alg)
    cert.extend(__der(0x03, sig))
    __der(0x30, cert)

# the P-256 public point (65 bytes) a certificate holds, or none when it holds none
certificate_p256_key = (cert: u8[]) -> u8[]?:
    i = 0
    loop i + __OID_P256.len() + 4 + 65 <= cert.len():
        if cert[i..i + __OID_P256.len()) == __OID_P256:
            j = i + __OID_P256.len()
            if cert[j] == 3 and cert[j + 1] == 66 and cert[j + 2] == 0 and cert[j + 3] == 4: return cert[j + 3..j + 3 + 65)
        i += 1
    none

# ---------------- CRC-32 ----------------
__crc_tab: u32[]
__crcc_tab: u32[]

# CRC-32 (zip's, PNG's, STUN's) of the bytes
crc32 = (b: u8[]) -> u32: __crc_with(b, false)
# CRC-32C (Castagnoli: SCTP's, iSCSI's) of the bytes
crc32c = (b: u8[]) -> u32: __crc_with(b, true)

__crc_with = (b: u8[], c32c: bool) -> u32:
    global __crc_tab, __crcc_tab
    if __crc_tab.len() == 0:
        loop poly in [u32(0xEDB88320), u32(0x82F63B78)]:
            t: u32[]
            loop n in [0..256):
                c = u32(n)
                loop k in [0..8):
                    if c & 1 == 1: c = poly xor (c >> 1)
                    else: c = c >> 1
                t.push(c)
            if __crc_tab.len() == 0: __crc_tab = t
            else: __crcc_tab = t
    c = u32(0xFFFFFFFF)
    if c32c:
        loop x in b: c = __crcc_tab[int((c xor u32(x)) & 255)] xor (c >> 8)
    else:
        loop x in b: c = __crc_tab[int((c xor u32(x)) & 255)] xor (c >> 8)
    c xor u32(0xFFFFFFFF)
