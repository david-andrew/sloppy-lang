# example: SQLite databases
# a shop's orders kept in shop.db: one added each run, then all of them, newest first
import sqlite

struct Order:
    id = 0
    item = ""
    qty = 0
    paid = false

main = ():
    db = unwrap(sqlite.open("shop.db"))
    if let e = db.exec("CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY, item TEXT NOT NULL, qty INT, paid BOOL)"): panic(e.message)
    r = db.run("INSERT INTO orders (item, qty, paid) VALUES (?, ?, ?)", ["rope", 2, false])
    if r is sqlite.SqlError: panic(r.message)
    print("order {r.last_id} added")
    loop o in unwrap(db.query[Order]("SELECT * FROM orders ORDER BY id DESC LIMIT ?", [10])): print(o)
    print("{db.value("SELECT sum(qty) FROM orders").as_int() ?? 0} items ordered in all")
