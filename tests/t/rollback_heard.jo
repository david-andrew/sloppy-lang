# requires: sloppy
# Initial session clocks are not evidence of contact, including sources forwarded by a host.
import netplay
struct Game: x = 0
struct Pad: x = 0
step = (g: Game, pads: Pad[]) -> Game: g
netplay.clock(0.0)
a = netplay.session(Game(), step, players = 3, me = 0)
b = netplay.session(Game(), step, players = 3, me = 1)
c = netplay.session(Game(), step, players = 3, me = 2)
b.__hub = 0
c.__hub = 0
pump = ():
    a.play(Pad())
    b.play(Pad())
    loop o in b.outgoing(): a.receive(o.1)
    loop o in a.outgoing(): if o.0 == 1: b.receive(o.1)
loop f in [0..240):
    netplay.clock(f64(f) / 60.0)
    pump()
print("own", a.heard(0), "invalid", a.heard(-1), a.heard(3))
print("loading: host", a.heard(2), "forwarded", b.heard(2), "silent", a.silent(2) > 3.0)
if a.heard(2) and a.silent(2) > 3.0: a.stand_in(2, Pad())
print("loading keeps its place", not a.stands_in(2))
# The late player's first real packet, and its clock forwarded to the other guest.
netplay.clock(4.0)
c.play(Pad())
loop o in c.outgoing(): a.receive(o.1)
pump()
print("contact: host", a.heard(2), "forwarded", b.heard(2))
print("since packet", a.silent(2) == 0.0, b.silent(2) == 0.0)
netplay.clock(7.5)
pump()
print("quiet source stays quiet", a.silent(2) == 3.5, b.silent(2) == 3.5)
if a.heard(2) and a.silent(2) > 3.0: a.stand_in(2, Pad())
print("now stands in", a.stands_in(2))
assert(a.problem == "" and b.problem == "")
