# requires: sloppy
# 2D overlaps: a circle, a box (turned), sensors too, and bodies_at
import physics
w = physics.World()
ball = w.add_circle(vec2(100, 100), 20)
crate = w.add_box(vec2(200, 100), vec2(40, 40), angle = 0.5)
zone = w.add_box(vec2(300, 100), vec2(100, 100), kind = .fixed, sensor = true)
print(w.bodies_at(vec2(105, 95)) == [ball], w.bodies_at(vec2(200, 100)) == [crate], w.bodies_at(vec2(0, 0)).len())
print(w.overlap_circle(vec2(150, 100), 40).len(), w.overlap_box(vec2(300, 100), vec2(10, 10)) == [zone], w.overlap_box(vec2(150, 100), vec2(150, 10)).len())
