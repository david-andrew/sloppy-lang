# requires: sloppy
# a tuple literal converts each element where a tuple type is expected
g = (p: (int?, str?)) -> str: "{p}"
print(g((1, "x")))
v = ivec2(3, 4)
q: (int, int)[] = []
q.push((v.x, v.y))
print(q)
r: (f64, int) = (1, v.x)
print(r)
h = (t: (int, f64)) -> f64: f64(t.0) + t.1
print(h((v.x, v.y)))
