# requires: sloppy
# URLs taken apart and put back, links followed from a page (RFC 3986's examples), url_encode's safe
show = (s: str):
    r = parse_url(s)
    if r is UrlError: print("error: {r.message}")
    else: print("{r.scheme}|{r.user}|{r.host}|{r.port}|{r.path}|{r.query}|{r.fragment} -> {r}")
loop s in ["https://ann@Example.com:8443/search?q=sloppy#top", "http://[::1]:8000/a/b", "file:///etc/hosts",
        "/just/a/path?x", "rel/path", "mailto:x@y.z", "HTTP://X.ORG", "  https://trim.me/  ", "http://host:/p",
        "http://h:99999/", "http://h:8o/", "http://[::1/", "http://h/a\r\nX-Evil: 1", "http://[::1]x/"]:
    show(s)
u = parse_url("https://example.com/a?b=1")
if u is Url:
    u.port = 8080
    u.path = "/" + url_encode("a b/c", safe = "/")
    print(u, parse_query(u.query))
base = "http://a/b/c/d;p?q"
loop l in ["g:h", "g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", ";x", "g;x?y#s", "", ".", "./", "..",
        "../", "../g", "../..", "../../g", "../../../g", "/./g", "/../g", "g.", ".g", "..g", "./../g", "./g/.", "g/./h",
        "g/../h", "g;x=1/./y", "g;x=1/../y", "g?y/./x", "g#s/../x", "http:g", "?", "#"]:
    print("{l} -> {url_join(base, l)}")
print(url_join("https://example.com/a/b/page.html", "  ../c.html\n"), url_join("https://example.com", "x"), url_join("https://Example.com/a/", "HTTPS://other.org/x/../y"))
