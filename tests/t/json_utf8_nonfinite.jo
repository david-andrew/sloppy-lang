# requires: sloppy
# JSON has no infinity or NaN (null is written, as JSON.stringify does), and its text is UTF-8:
# bytes that are not are refused when read and written as U+FFFD
struct P:
    x = 1.5
    name = ""

inf = 1.0 / 0.0
nan = 0.0 / 0.0
print(to_json(P(x = inf)), to_json(P(x = -inf)), to_json(P(x = nan)))
print(to_json([inf, 2.5, nan, -0.0]), to_json([inf, 2.5], indent = 2))
j: Json = {"a": nan, "b": -inf, "c": 1}
print(j, to_json(j))

# reading: Infinity and NaN as Python's json writes them, and null in a float as NaN (what to_json
# wrote for it)
pj = (s: str) -> Json?:
    match parse_json(s):
        Json as v: return v
        JsonError as e: return none
px = (s: str) -> str:
    match from_json[P](s):
        P as p: return "{p.x}"
        TextError as e: return e.message
print(px("\{\"x\": Infinity}"), px("\{\"x\": -Infinity}"), px("\{\"x\": NaN}"))
print(px("\{\"x\": null}"), px(to_json(P(x = inf))))
print(from_json[f64[]]("[1, null, 2.5]"))
print(pj("[Infinity, -Infinity, NaN]").at(0).as_num(), pj("[Infinity, -Infinity, NaN]").at(2).as_num())
print(px("\{\"x\": nul}"))

# UTF-8 in strings: kept as it is
ok = "\{\"name\": \"caf\xC3\xA9 \xF0\x9F\x98\x80 \xE2\x82\xAC\"}"
match from_json[P](ok):
    P as p: print(p.name, pj(ok).get("name").as_str() ?? "?", to_json(p))
    TextError as e: print(e.message)

# bytes that are not UTF-8: an error at the byte
bad: str[] = ["\"\xFF\xFE\"", "\"ab\xC0\x80\"", "\"\xED\xA0\x80\"", "\"x\xF4\x90\x80\x80\"", "\"\xE2\x82\"", "\"a\\n\xE2\x82(\"", "[\"ok\",\n \"\x80\"]"]
loop s in bad:
    match parse_json(s):
        JsonError as e: print("parse_json: {e.line}:{e.column} {e.message}")
        Json as v: print("parse_json read it: {v}")
    fr = from_json[str[]]("[" + s + "]")
    if fr is TextError: print("from_json: {fr.line}:{fr.column} {fr.message}")
    else: print("from_json read it")

# \u escapes: a pair is one character, half of one alone is U+FFFD
print(pj("\"\\ud83d\\ude00 \\ud800 \\udc00x \\ud800\\u0041\"").as_str() ?? "?")
print(from_json[str]("\"\\ud83d\\ude00 \\ud800 \\udc00x \\ud800\\u0041\""))

# writing: bytes that are not UTF-8 become U+FFFD (one for each piece that could start a
# character), so the text written is always UTF-8
w: str[] = ["\xFF\xFEok", "a\xC0\x80b", "\xE2\x82", "\xE2\x82\xAC\xF0\x9F\x98", "\xED\xA0\x80", "plain \"q\" \x01"]
loop s in w:
    t = to_json(s)
    print(t, bytes(t).len(), pj(t).as_str() ?? "?")
print(to_json(P(name = "\xFFx")), to_json({"\xFF": 1}))
r: Json = {"k": "\xC3"}
print(r)
