# swizzles whose components are out of order (.zx, .wy) or repeated (.xxy) read and write the
# components they name, as operands too; in order (.xy, .yzw) they are places of their own
# requires: sloppy
v = vec3(1, 2, 3)
v.zx = vec2(10, 20)
print(v)
v.zx += vec2(1, 1)
print(v)
w = vec4(1, 2, 3, 4)
w.wy -= vec2(1, 1)
print(w)
print(w.wx + w.yz, w.zy * f32(2), -w.yx, w.yx == vec2(1, 3), w.xxy)
f = f32(-1349.5)
u = vec3(f, f32(-7.75), f32(0))
print(u.zx * f32(0.5), ivec2(u.zx * f32(1.5)))
w.yzw = vec3(7, 8, 9)
w.xy *= f32(2)
print(w)
bump = (p: mut vec2): p.x += 1
bump(w.zw)
print(w)
iv = ivec2(i32(3), i32(4))
iv.yx = ivec2(i32(1), i32(2))
print(iv, iv.yx + iv)
