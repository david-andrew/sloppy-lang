# requires: sloppy
# floats printed as the shortest digits that read back (Ryu): on random numbers, short decimals,
# whole numbers, powers of two and the numbers next to powers of ten, each printed one reads back
# as itself, and one digit fewer (either way) does not
bad = 0
digits = (d: u64) -> int: len("{d}")
check = (y: f64):
    global bad
    d, e = __shortest(y, false)
    n = digits(d)
    if to_float("{d}e{e - n + 1}") != y: bad += 1
    if n > 1:
        loop c in [d / 10, d / 10 + 1]:
            if to_float("{c}e{e - n + 2}") == y: bad += 1
    if to_float(str(y)) != y: bad += 1
check32 = (y: f32):
    global bad
    d, e = __shortest(f64(y), true)
    n = digits(d)
    if f32(to_float("{d}e{e - n + 1}") ?? 0.0) != y: bad += 1
    if n > 1:
        loop c in [d / 10, d / 10 + 1]:
            if f32(to_float("{c}e{e - n + 2}") ?? 0.0) == y: bad += 1
seed = u64(12345)
loop i in [0..20000):
    seed = seed * 6364136223846793005 + 1442695040888963407
    y = f64(seed >> 11) / f64(u64(1) << 53) * __pow10(int(seed % 20) - 5)
    if i % 4 == 0:
        mant = (seed >> 7) % 1000000000000000
        s = "{mant}"
        n = int((seed >> 33) % 15) + 1
        if len(s) > n: s = s[..n)
        y = to_float("0.{s}e{int((seed >> 50) % 30) - 15}") ?? 1.0
    else if i % 4 == 1: y = f64_from_bits(seed >> 1)
    else if i % 4 == 2: y = f64(seed >> int(seed % 60))
    if y <= 0.0 or y - y != 0.0: continue
    check(y)
    if y < 3.4e38: check32(f32(y))
k = -30
loop k <= 30:
    p = if k < 0: 1.0 / __pow10(-k) else: __pow10(k)
    loop v in [p, f64_from_bits(f64_bits(p) - 1), f64_from_bits(f64_bits(p) + 1), f64_from_bits(f64_bits(p) - 2)]: check(v)
    k += 1
loop k in [-1074..1024): check(f64_from_bits(if k >= -1022: u64(k + 1023) << 52 else: u64(1) << u64(k + 1074)))
check(5e-324)
check(1.7976931348623157e308)
print("bad: {bad}")
print(0.9999999999999999, 0.1 + 0.2, 1e-5 * 3.0, 123456.78901234567, 9.999999999999999e-5)
print(1e16, 1e15, 123456789012345680.0, 0.00001, 0.000001, 5e-324, 2.0 ^ 60, 1.5e300, -2.5)
# (an f32 halfway between two shortest ones: the even one, as C's printf and Python write it;
# 2^87 with 8 digits, not the nearest 9)
print(f32(432.640625), f32(5292.65625), f32(1.5474250491067253e26), f32(0.1), f32(16777216.0))
