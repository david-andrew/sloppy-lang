# requires: sloppy
# floats printed as the shortest digits that read back: the quick ways (15 digits by one float
# operation, 16 and 17 in 128-bit whole numbers) against the exact one, on random numbers, short
# decimals, and the numbers next to powers of ten
differ = 0
seed = u64(12345)
loop i in [0..20000):
    seed = seed * 6364136223846793005 + 1442695040888963407
    y = f64(seed >> 11) / f64(u64(1) << 53) * __pow10(int(seed % 20) - 5)
    if i % 2 == 0:
        mant = (seed >> 7) % 1000000000000000
        s = "{mant}"
        n = int((seed >> 33) % 15) + 1
        if len(s) > n: s = s[..n)
        y = to_float("0.{s}e{int((seed >> 50) % 30) - 15}") ?? 1.0
    if y <= 0.0: continue
    d1, e1 = __shortest(y, false)
    d2, e2 = __shortest_exact(y, false)
    if d1 != d2 or e1 != e2: differ += 1
k = -30
loop k <= 30:
    p = if k < 0: 1.0 / __pow10(-k) else: __pow10(k)
    loop v in [p, f64_from_bits(f64_bits(p) - 1), f64_from_bits(f64_bits(p) + 1), f64_from_bits(f64_bits(p) - 2)]:
        d1, e1 = __shortest(v, false)
        d2, e2 = __shortest_exact(v, false)
        if d1 != d2 or e1 != e2: differ += 1
    k += 1
print("differ: {differ}")
print(0.9999999999999999, 0.1 + 0.2, 1e-5 * 3.0, 123456.78901234567, 9.999999999999999e-5)
