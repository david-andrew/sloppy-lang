# requires: sloppy
# requires: native
# structs passed to and given back by C by value (tests/t/c_structs.c, built by runtests into
# the library loaded here), in each target's convention: small ones in registers, large ones
# copied (onto the stack, or as a pointer to a copy) or given back through memory
when TARGET == "windows":
    const LIB = "c_structs.dll"
else:
    const LIB = "./libc_structs.so"

struct V2:
    x: f32
    y: f32
struct Rect:
    x: f32
    y: f32
    w: f32
    h: f32
struct Color:
    r: u8
    g: u8
    b: u8
    a: u8
struct D2:
    x: f64
    y: f64
struct IF:
    n: i32
    f: f32
struct DN:
    d: f64
    n: int
struct Big:
    a: int
    b: int
    c: int
struct Tex:
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    format: i32
struct Mat:
    m: f32[16]
struct Small:
    a: u8
    b: u16
struct Mixed:
    pos: V2
    r: f32
    tag: u8[4]
struct I2:
    a: int
    b: int
struct D3:
    x: f64
    y: f64
    z: f64
struct Three:
    a: u8
    b: u8
    c: u8

@lib(LIB)
extern v2_add = (a: V2, b: V2) -> V2
@lib(LIB)
@symbol("v2_add")
extern vec2_add = (a: vec2, b: vec2) -> vec2
@lib(LIB)
extern v2_dot = (a: vec2, b: vec2) -> f32
@lib(LIB)
extern v3_cross = (a: vec3, b: vec3) -> vec3
@lib(LIB)
extern rect_grow = (r: Rect, by: f32) -> Rect
@lib(LIB)
@symbol("rect_grow")
extern vec4_grow = (r: vec4, by: f32) -> vec4
@lib(LIB)
extern rect_area = (r: Rect) -> f32
@lib(LIB)
extern color_mix = (a: Color, b: Color) -> Color
@lib(LIB)
extern color_pack = (c: Color) -> u32
@lib(LIB)
extern d2_scale = (a: D2, k: f64) -> D2
@lib(LIB)
extern if_swap = (a: IF) -> IF
@lib(LIB)
extern dn_next = (a: DN) -> DN
@lib(LIB)
extern big_sum = (a: Big, b: Big) -> Big
@lib(LIB)
extern big_clobber = (a: Big) -> int
@lib(LIB)
extern tex_make = (id: u32, w: i32, h: i32) -> Tex
@lib(LIB)
extern tex_pixels = (t: Tex, scale: i32) -> int
@lib(LIB)
extern mat_trace = (m: Mat) -> f32
@lib(LIB)
@symbol("mat_trace")
extern mat4_trace = (m: mat4) -> f32
@lib(LIB)
extern mat_scale = (k: f32) -> Mat
@lib(LIB)
extern small_inc = (s: Small) -> Small
@lib(LIB)
extern mixed_move = (m: Mixed, by: V2) -> Mixed
@lib(LIB)
extern d3_add = (a: D3, b: D3) -> D3
@lib(LIB)
extern three_rev = (t: Three) -> Three
@lib(LIB)
extern many_ints = (a: int, b: int, c: int, d: int, e: int, s: I2, g: int) -> int
@lib(LIB)
extern interleave = (i: i32, a: V2, d: f64, c: Color, big: Big, f: f32, r: Rect) -> f64
@lib(LIB)
extern get_v2_add = () -> cfn(V2, V2) -> V2

print(v2_add(V2(1, 2), V2(10, 20)), vec2_add(vec2(0.5, 1.5), vec2(2, 3)), v2_dot(vec2(1, 2), vec2(3, 4)))
print(v3_cross(vec3(1, 0, 0), vec3(0, 1, 0)), v3_cross(vec3(1, 2, 3), vec3(4, 5, 6)))
print(rect_grow(Rect(10, 20, 30, 40), 5), vec4_grow(vec4(1, 2, 3, 4), 1), rect_area(Rect(0, 0, 3, 4)))
c = color_mix(Color(255, 0, 100, 255), Color(1, 50, 0, 1))
print(c, color_pack(Color(0x12, 0x34, 0x56, 0x78)) == 0x12345678)
print(d2_scale(D2(1.5, -2), 3), if_swap(IF(7, 2.5)), dn_next(DN(1.25, 41)))
b = Big(1, 2, 3)
print(big_sum(b, Big(10, 20, 30)), big_clobber(b), b)
t = tex_make(5, 640, 480)
print(t, tex_pixels(t, 2))
m = Mat()
loop i in 0..16: m.m[i] = f32(i)
print(mat_trace(m), mat4_trace(mat4(2.0)), mat_trace(mat_scale(3)))
print(small_inc(Small(254, 64000)), three_rev(Three(1, 2, 3)))
print(mixed_move(Mixed(V2(1, 1), 1.5, [3, 4, 0, 0]), V2(0.5, -1)))
print(d3_add(D3(1, 2, 3), D3(0.5, 0.25, 0.125)))
print(many_ints(1, 2, 3, 4, 5, I2(6, 7), 8))
print(interleave(1, V2(2, 3), 4, Color(5, 0, 0, 6), Big(7, 0, 8), 9, Rect(10, 0, 0, 11)))
add = get_v2_add()
print(add(V2(1, 1), V2(2, 3)))
# (in a loop and through a variable, as a game calls a drawing function: values kept)
s = V2(0, 0)
loop i in 0..1000: s = v2_add(s, V2(1, 0.5))
print(s)

# (registers run out before a struct: where it goes then, and the arguments after it)
@lib(LIB)
extern many_floats = (a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, v: vec3, h: f64) -> f64
@lib(LIB)
extern many_ints8 = (a: int, b: int, c: int, d: int, e: int, f: int, g: int, s: I2, h: int) -> int
@lib(LIB)
extern d3_late = (a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, v: D3, g: f32, n: i32) -> f64
print(many_floats(1, 1, 1, 1, 1, 1, 1, vec3(1, 2, 3), 4), many_ints8(1, 1, 1, 1, 1, 1, 1, I2(2, 3), 4))
print(d3_late(1, 1, 1, 1, 1, 1, D3(1, 2, 3), 4, 5))
