# requires: sloppy
# @inline: copied into its callers in release builds, the same results
@inline
big = (x: int) -> int:
    a = x * 3 + 1
    b = a ^ 2 % 7
    c = (a + b) * (a - b)
    d = c % 1000 + a * b
    e = d / 3 + c / 7 + b * 11
    f = e % 97 + d % 89 + c % 83
    if f == 123456789: print("x")
    if f > 50: return f + e
    f - e
s = 0
loop i in 0..1000000: s += big(i)
print(s)
