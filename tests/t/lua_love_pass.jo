# requires: sloppy
# update with an untyped dt (the game loop gives it f64), an if-expression in an interpolation,
# an enum array literal typed by its first element (also as a generic argument)
enum Kind: potion, gold, key
ks = [Kind.potion, .gold, .key]
print(ks, random_item([Kind.potion, .potion]))
w = true
print("{if w: 'x' else: 'y'} and {if not w: 'x' else: 'y'}")
