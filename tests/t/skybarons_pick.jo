# requires: sloppy
# Sky Barons: the craft switcher on death. In The Boss, an attacker who is a player and dies may choose the
# kind of craft they come back in (the pad's pick), among those the fight allows, within its limits (one
# rocketeer a side); chosen nothing, they come back in the same kind; a defender still comes back in the
# castle's seats; a fight whose rules do not say so ignores the choice
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

# (the first player's craft, a Boss attacker's, 12 a side so that the computer's rocketeer is among the others)
kind_of = (g: Game, i: int) -> str:
    p = g.people[i]
    if p.state == SEATED: return KIND_NAMES[g.crafts[p.craft].kind]
    "state {p.state}"

# (killed, then back after the wait with `pad` held)
back = (g0: Game, i: int, pad: Pad) -> Game:
    let g = g0
    kill(g, i, -1)
    loop t in 0..(RESPAWN + 60): g = tick(g, [pad])
    g

pilots = fill(-1, 24)
pilots[0] = 0
let boss = new_game(pilots, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 4), [])
loop t in 0..60: boss = tick(boss, [Pad()])
print("the attacker starts in: {kind_of(boss, 0)}, the kinds offered: {pick_kinds(boss).len()}, may switch {can_switch(boss, boss.people[0])}")
print("nothing chosen, comes back in: {kind_of(back(boss, 0, Pad()), 0)}")
loop k in [SCOUT, BOMBER, ORNITHOPTER, CARCOPTER]:
    print("chooses the {KIND_NAMES[k]}: {kind_of(back(boss, 0, Pad(pick = k)), 0)}")
# (limits: the computer's rocketeer is on the side, so no second; the cat is not among the kinds; a castle neither)
print("chooses a rocketeer, one being on the side: {kind_of(back(boss, 0, Pad(pick = ROCKETEER)), 0)}")
print("chooses the cat: {kind_of(back(boss, 0, Pad(pick = CAT)), 0)}")
print("chooses the castle: {kind_of(back(boss, 0, Pad(pick = CASTLE)), 0)}")
print("chooses nonsense: {kind_of(back(boss, 0, Pad(pick = 999)), 0)}")

# (a defender, a player: back in the castle or a balloon, whatever they choose)
dp = fill(-1, 24)
dp[1] = 0
let dboss = new_game(dp, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 4), [])
loop t in 0..60: dboss = tick(dboss, [Pad()])
print("a defender may switch: {can_switch(dboss, dboss.people[1])}; chooses the scout: {kind_of(back(dboss, 1, Pad(pick = SCOUT)), 1)}")

# (fights whose rules say nothing: the choice is ignored)
loop m in [DOGFIGHT, THUNDERDOME, BROOMS, TURNCOATS]:
    set_map(FARMLAND, 0)
    let o = new_game([0, -1, -1, -1], 0.65, Rules(mode = m, ground_start = false), [])
    loop t in 0..60: o = tick(o, [Pad()])
    before = o.people[0].kind
    o = back(o, 0, Pad(pick = SCOUT))
    print("{MODE_NAMES[m]}: may switch {can_switch(o, o.people[0])}, kind {if o.people[0].kind == before: "unchanged" else: "CHANGED"}")
