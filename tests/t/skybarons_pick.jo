# requires: sloppy
# Sky Barons: the craft switcher on death. In The Boss, an attacker who is a player and dies may choose the
# kind of craft they come back in (the pad's pick), among those the fight allows, within its limits (one
# rocketeer a side); chosen nothing, they come back in the same kind; a defender still comes back in the
# castle's seats; a fight whose rules do not say so ignores the choice
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

# (the first player's craft, a Boss attacker's, 12 a side so that the computer's rocketeer is among the others)
kind_of = (g: Game, i: int) -> str:
    p = g.people[i]
    if p.state == SEATED: return KIND_NAMES[g.crafts[p.craft].kind]
    "state {p.state}"

# (killed, then back after the wait with `pad` held)
back = (g0: Game, i: int, pad: Pad) -> Game:
    let g = g0
    kill(g, i, -1)
    loop t in 0..(RESPAWN + PICK_EXTRA + 60): g = tick(g, [pad])
    g

pilots = fill(-1, 24)
pilots[0] = 0
let boss = new_game(pilots, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 4), [])
loop t in 0..60: boss = tick(boss, [Pad()])
print("the attacker starts in: {kind_of(boss, 0)}, the kinds offered: {pick_kinds(boss).len()}, may switch {can_switch(boss, boss.people[0])}")
print("nothing chosen, comes back in: {kind_of(back(boss, 0, Pad()), 0)}")
loop k in [SCOUT, BOMBER, ORNITHOPTER, CARCOPTER]:
    print("chooses the {KIND_NAMES[k]}: {kind_of(back(boss, 0, Pad(pick = k)), 0)}")
# (limits: the computer's rocketeer is on the side, so no second; the cat is not among the kinds; a castle neither)
print("chooses a rocketeer, one being on the side: {kind_of(back(boss, 0, Pad(pick = ROCKETEER)), 0)}")
print("chooses the cat: {kind_of(back(boss, 0, Pad(pick = CAT)), 0)}")
print("chooses the castle: {kind_of(back(boss, 0, Pad(pick = CASTLE)), 0)}")
print("chooses nonsense: {kind_of(back(boss, 0, Pad(pick = 999)), 0)}")

# (a defender, a player: back in the castle or a balloon, whatever they choose)
dp = fill(-1, 24)
dp[1] = 0
let dboss = new_game(dp, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 4), [])
loop t in 0..60: dboss = tick(dboss, [Pad()])
print("a defender may switch: {can_switch(dboss, dboss.people[1])}; chooses the scout: {kind_of(back(dboss, 1, Pad(pick = SCOUT)), 1)}")

# (fights whose rules say nothing: the choice is ignored)
loop m in [DOGFIGHT, THUNDERDOME, BROOMS, TURNCOATS]:
    set_map(FARMLAND, 0)
    let o = new_game([0, -1, -1, -1], 0.65, Rules(mode = m, ground_start = false), [])
    loop t in 0..60: o = tick(o, [Pad()])
    before = o.people[0].kind
    o = back(o, 0, Pad(pick = SCOUT))
    print("{MODE_NAMES[m]}: may switch {can_switch(o, o.people[0])}, kind {if o.people[0].kind == before: "unchanged" else: "CHANGED"}")

# (the time: the wait RESPAWN as ever; where one may choose, PICK_EXTRA ticks more to confirm in, a
# confirmation at any moment of them (the first too) bringing one back at once in that craft, none
# bringing one back as one was at the end of them)
ticks_back = (g0: Game, i: int, pick_from: int, k: int) -> (int, str):
    let g = g0
    kill(g, i, -1)
    loop t in 0..(RESPAWN + PICK_EXTRA + 60):
        g = tick(g, [if t >= pick_from: Pad(pick = k) else: Pad()])
        if g.people[i].state != DEAD: return (t + 1, kind_of(g, i))
    (-1, "still dead")
print("no choice: back after {ticks_back(boss, 0, 100000, SCOUT).0} ticks (the wait {RESPAWN}, the extra {PICK_EXTRA}), as {ticks_back(boss, 0, 100000, SCOUT).1}")
print("chosen from the start: {ticks_back(boss, 0, 0, SCOUT)}")
print("chosen as the wait ends: {ticks_back(boss, 0, RESPAWN, SCOUT)}")
print("chosen as the wait ends (the first tick of the extra): {ticks_back(boss, 0, RESPAWN - 1, BOMBER)}")
print("chosen 3 s into the extra: {ticks_back(boss, 0, RESPAWN + 180, ORNITHOPTER)}")
print("chosen in the last tick of the extra: {ticks_back(boss, 0, RESPAWN + PICK_EXTRA - 1, CARCOPTER)}")
print("a defender, choosing or not: {ticks_back(dboss, 1, 0, SCOUT).0} and {ticks_back(dboss, 1, 100000, SCOUT).0} ticks")
let dog = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false), [])
loop t in 0..60: dog = tick(dog, [Pad()])
print("a fight without the switcher: {ticks_back(dog, 0, 0, SCOUT).0} and {ticks_back(dog, 0, 100000, SCOUT).0} ticks")

# (T to fly again, after bailing out or on foot, in a fight that starts in the air: where the switcher is on, not
# back at once but through the choosing wait, as after dying; elsewhere back at once)
bail_and_fly_again = (g0: Game, i: int, pick: int, wait: int) -> (str, str):
    let g = g0
    g = tick(g, [Pad(leave = true)])
    loop t in 0..140: g = tick(g, [Pad()])
    g = tick(g, [Pad(leave = true)])
    state2 = if g.people[i].state == DEAD: "waiting to choose" else: if g.people[i].state == SEATED: "back at once" else: "state {g.people[i].state}"
    loop t in 0..wait: g = tick(g, [if pick >= 0: Pad(pick = pick) else: Pad()])
    (state2, kind_of(g, i))
print("Boss, fly again after a bail-out: {bail_and_fly_again(boss, 0, -1, 1)}")
print("... choosing the scout: {bail_and_fly_again(boss, 0, SCOUT, 3)}")
print("... nothing chosen, after the wait: {bail_and_fly_again(boss, 0, -1, PICK_EXTRA + 5)}")
print("... nothing chosen, before it ends: {bail_and_fly_again(boss, 0, -1, PICK_EXTRA - 20)}")
let onfoot = boss
onfoot.crafts[onfoot.people[0].craft].seats[onfoot.people[0].seat] = -1
onfoot.people[0].state = WALK
onfoot.people[0].craft = -1
onfoot.people[0].pos = vec3(0, 900, 0)
onfoot = tick(onfoot, [Pad()])
onfoot = tick(onfoot, [Pad(leave = true)])
print("Boss, T on foot: {if onfoot.people[0].state == DEAD: "waiting to choose" else: "state " + str(onfoot.people[0].state)}")
loop t in 0..3: onfoot = tick(onfoot, [Pad(pick = BOMBER)])
print("... choosing the light bomber: {kind_of(onfoot, 0)}")
print("Dogfight, fly again after a bail-out: {bail_and_fly_again(dog, 0, -1, 1)}")

# (the picker's mark moved by the keys: along the kinds offered, round, the first if it was none of them)
ks = pick_kinds(boss)
print("the mark steps: {pick_step(ks, ks[0], 1) == ks[1]}, back {pick_step(ks, ks[1], -1) == ks[0]}, round forward {pick_step(ks, ks[ks.len() - 1], 1) == ks[0]}, round back {pick_step(ks, ks[0], -1) == ks[ks.len() - 1]}, from none {pick_step(ks, 99, 1) == ks[0]}, none offered {pick_step([], 3, 1)}")
