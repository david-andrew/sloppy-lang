# requires: native
# requires: sloppy
# menus and hud_ buttons drawn under a 2D transform take clicks where they show: a phone's column,
# laid out at 360 x 640, fitted to a 1280 x 720 screen with camera2d_fit (1.125 times as large, in
# the middle); a click where the column's units would be without the transform does nothing
# env: SLOPPY_SCREENSHOT=$TMP/ui_transform.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=24
# env: SLOPPY_INPUT=3:mouse=640x225 4:mouse_left+ 5:mouse_left- 7:mouse=640x290 8:mouse_left+ 9:mouse_left- 11:mouse=640x664 12:mouse_left+ 13:mouse_left- 15:mouse=180x590 16:mouse_left+ 17:mouse_left- 19:mouse=700x225 20:mouse_left+ 21:mouse_left-
draw = ():
    clear(rgb(0.1, 0.1, 0.15))
    camera2d_fit(Rect(0, 0, 360, 640), visible_rect())
    rect(0, 0, 360, 640, rgb(0.15, 0.15, 0.2))
    ui_begin("title", vec2(180, 200))
    if ui_button("Play"): print("frame {frame_number()}: Play")
    if ui_button("Shop"): print("frame {frame_number()}: Shop")
    ui_end()
    if hud_button(Rect(20, 560, 320, 60), "Back"): print("frame {frame_number()}: Back")
    if frame_number() == 12 or frame_number() == 16: print("frame {frame_number()}: over the interface {hud_hovered()}")
