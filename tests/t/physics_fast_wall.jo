# requires: sloppy
# a fast body meets a wall at any speed: it stops there with a contact (it was held off the wall, its speed kept, at some speeds)
import physics
loop sp in [800, 1500, 2800, 3000, 3200, 3500, 3700, 4000, 8000, 20000]:
    w = physics.World()
    w.gravity = vec2(0, 0)
    w.add_box(vec2(1000, 400), vec2(10, 600), kind = .fixed)
    b = w.add_circle(vec2(800, 400), 10)
    w.set_velocity(b, vec2(f32(sp), 0))
    hit = false
    loop f in [0..120):
        w.step(1.0 / 60.0)
        if w.contacts(b).len() > 0: hit = true
    print(sp, w.pos(b).x < 990.0, hit, abs(f64(w.velocity(b).x)) < 50.0)
