# requires: sloppy
# arrays for numeric work: dotted (elementwise, broadcasting) operators, f.(xs), 2-D arrays
main = ():
    a = [1.0 2.0 3.0]
    b = [10.0, 20.0, 30.0]
    print(a .+ b, a .* b .+ 1.0, a .^ 2, b ./ a)
    print(a .< 2.5, 2.0 .* a)
    sq = (x: f64): x * x
    print(sq.(a), sqrt.(b), abs.(a .- 2.0))
    m = [1 2; 3 4]
    print(m, m[1, 0], m.shape)
    m[0, 1] = 20
    print(m)
    f = [1.0 2.0
         3.0 4.0]
    print(f .* 10.0, f .+ [100.0 200.0], f * f, f * [1.0, 1.0])
    g: f32[,] = [1 2; 3 4]
    print(g .* 2.0)
    print(zeros(2, 3), ones(3), eye(2), linspace(0.0, 1.0, 5))
    rows = [a; b]
    print(rows, transpose(rows))
    col = [1.0; 2.0]
    print(col .+ [10.0 20.0 30.0])
    xs = [1 2 3]
    print(xs .* 2, -xs[0], sum(xs .* xs))

dotted_compound = ():
    xs = [1.0 2.0 3.0]
    xs .+= 1.0
    xs .*= xs
    print(xs, 2.0 .* [1.0 2.0] .^ 2, [2.0] .^ [3.0] .^ [2.0])
dotted_compound()

nd_demo = ():
    m = [1 2; 3 4]
    print(m, m.shape, m[1, 0], len(m), ndim(m))
    a = [m; m .* 10]
    print(a, a.shape, a[1, 0, 1])
    a[0, 1, 1] = 99
    print(a)
    v = zeros(2, 3, 4)
    print(v.shape, size(v))
    w = v .+ [1.0 2.0 3.0 4.0]
    print(w[1, 2, 3], w[0, 0, 0])
    col = reshape([1.0, 2.0, 3.0], 3, 1)
    print(col .* [10.0 20.0], transpose(col))
    t = reshape([1 2 3 4 5 6 7 8], 2, 2, 2)
    print(t .+ t, transpose(t)[1, 0, 0], sum(t))
    print([1.0 2.0; 3.0 4.0] * [1.0 0.0; 0.0 1.0], eye(2) * [5.0, 6.0])
    f: f32[,] = [1 2; 3 4]
    print(f .* 2.0, sqrt.(f))
nd_demo()
# a product big enough to be shared among threads matches the sum it stands for
big_product = ():
    seed_random(3)
    a = rand(130, 70)
    b = rand(70, 90)
    c = a * b
    err = 0.0
    loop i in [0..130):
        loop j in [0..90):
            s = 0.0
            loop k in [0..70): s += a[i, k] * b[k, j]
            err = max(err, abs(s - c[i, j]))
    print(err < 1e-9, c.shape)
big_product()
