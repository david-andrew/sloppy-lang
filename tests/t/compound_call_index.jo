# x op= y where x is a vector (or has an overloaded operator) at an index that is a call: the
# index is computed once
# requires: sloppy
struct P:
    v = vec2(0, 0)
calls = 0
f = (i: int) -> int:
    calls += 1
    i
g = (ps: mut P[]):
    ps[f(0)].v += vec2(1, 2)
    ps[f(1)].v *= 2.0
qs = [P(), P(vec2(3, 3))]
g(qs)
print(qs, calls)
