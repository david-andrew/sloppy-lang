# requires: sloppy
# type parameters in a union: those other arguments decide name members, the one left takes the rest
struct E: m: str
f = (x: int) -> int | E:
    if x < 0: return E("neg")
    x
unwrap_or[T, X] = (r: T | X, d: T) -> T:
    if r is X: return d
    r
print(unwrap_or(f(-1), 0), unwrap_or(f(5), 0))
print(unwrap_or[int, E](f(-2), 7), unwrap_or(f(9), 1))
value_or[T] = (r: T | E, d: T) -> T:
    if r is E: return d
    r
g = (x: int) -> int | str | E:
    if x == 0: return "zero"
    if x < 0: return E("n")
    x
print(value_or(g(0), 1), value_or(g(-1), "d"))
expect[T, X] = (r: T | X, msg: str) -> T:
    if r is X: panic("{msg}: {r}")
    r
print(expect[int, E](f(3), "f"))
