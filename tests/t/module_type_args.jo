# requires: sloppy
# m.f[T](...): a module's generic function with its type arguments written at the call
import 'mods/generic.jo' as g
struct Point:
    x: int
    y: int
xs = g.none_of[str]()
xs.push("a")
print(xs, g.first_or[f64]([], 2), g.first_or[int]([7], 0))
p = g.parse[Point]("\{\"x\": 1, \"y\": 2}")
if p is Point: print(p.x + p.y)
q = g.parse[Point]("[1]")
if q is TextError: print("not a Point")
