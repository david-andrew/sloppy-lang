# requires: native
# requires: sloppy
# hud_text_area: lines wrapped at the box's width, down to the next line as wrapped, ctrl+end to
# the end, up keeping to the x, enter a new line, shift+up selecting across lines, backspace
# taking the selection away, ctrl+Z bringing it back, ctrl+enter hud_submitted()
# env: SLOPPY_SCREENSHOT=$TMP/hud_text_area.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=34
# env: SLOPPY_INPUT=3:down+ 4:down- 5:text=[ 7:ctrl+ 8:end+ 9:end- 10:ctrl- 11:up+ 12:up- 13:text=_ 15:enter+ 16:enter- 17:shift+ 18:up+ 19:up- 20:shift- 21:backspace+ 22:backspace- 24:ctrl+ 25:z+ 26:z- 27:ctrl- 28:ctrl+ 29:enter+ 30:enter- 31:ctrl-
body = "alpha beta gamma delta epsilon zeta eta theta\nsecond\nthird"
last = ""
draw = ():
    global body, last
    clear(rgb(0.15, 0.15, 0.2))
    if frame_number() == 1: hud_focus("body")
    body = hud_text_area(Rect(20, 20, 200, 160), body, id = "body")
    if hud_submitted(): print("{frame_number()}: submitted")
    if body != last: print("{frame_number()}: {body.replace("\n", "|")}")
    last = body
