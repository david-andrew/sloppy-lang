# requires: sloppy
# integer sums over a loop (and &, |, xor): release builds keep partial sums in a vector; the
# results are the same as one at a time, for lengths around the vector widths, and a running
# sum that is also stored (a prefix sum) is left as it is
loop n in [0, 1, 2, 3, 4, 5, 7, 8, 9, 16, 17, 33]:
    xs = [loop i in [0..n): (i * 7919) % 1009 - 500]
    s = 0
    a = -1
    o = 0
    x = 0
    loop i in [0..xs.len()):
        s += xs[i]
        a = a & (xs[i] | 0x7F00)
        o = o | xs[i]
        x = x xor xs[i]
    t = 100
    loop v in xs: t += v
    pre = fill(0, n)
    r = 0
    loop i in [0..n):
        r += xs[i]
        pre[i] = r
    print(n, s, a, o, x, t, pre.len() > 0 and pre[n - 1] == s)
big = [loop i in [0..100003): i * 3 - 7]
tot = 0
loop v in big: tot += v
print(tot)
