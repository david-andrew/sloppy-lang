# requires: sloppy
# a soa array indexed with a mask or an array of indexes: a soa array of those elements (and set through a mask)
struct Row:
    a: int
    b: f64
t: soa Row[] = [Row(1, 1.0), Row(2, 5.0), Row(3, 9.0)]
big = t[t.b .> 2.0]
print(big, big.len())
print(t[[0, 2]], t[1], t[[2]].a)
t[t.b .> 2.0] = Row(0, 0.0)
print(t)
