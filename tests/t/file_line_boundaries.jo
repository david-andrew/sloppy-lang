# requires: sloppy
# requires: native
# CR and LF split across the 64 KB buffer, then bytes read after an unterminated line.
p = join_path(temp_dir(), "sloppy_line_boundaries.txt")
write_file(p, "x" * 65535 + "\r\n\nlast")
f = open_file(p)!
print(f.read_line()!.len(), f.read_line()!, f.read_line()!)
print(f.read_line() == none, f.read_bytes(4).len(), f.read_line() == none)
f.close()
f.close()
write_file(p, "")
f = open_file(p)!
print(f.read_line() == none, f.read_bytes(4).len())
f.close()
delete_file(p)
