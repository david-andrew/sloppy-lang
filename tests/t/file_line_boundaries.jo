# requires: sloppy
# requires: native
# CR and LF split across the 64 KB buffer, then bytes read after an unterminated line.
p = join_path(temp_dir(), "sloppy_line_boundaries.txt")
write_file(p, "x" * 65535 + "\r\n\nlast")
f = open_file(p)!
print(next_line(f)!.len(), next_line(f)!, next_line(f)!)
print(next_line(f) == none, f.read_bytes(4).unwrap().len(), next_line(f) == none)
f.close()
f.close()
write_file(p, "")
f = open_file(p)!
print(next_line(f) == none, f.read_bytes(4).unwrap().len())
f.close()
delete_file(p)

next_line = (f: mut File) -> str?:
    r = f.read_line()
    if r is FileError: panic(r.message)
    r
