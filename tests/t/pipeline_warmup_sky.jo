# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_sky.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
window("Sky prepared while loading", 160, 90)
tex = texture(image(16, 8, vec4(0.3, 0.4, 0.7, 1)))
ball = sphere_mesh(0.5)
# Preserve an unusual state and an existing upload while baking the sky.
rt = render_target(32, 32)
draw_to(rt)
glEnable(GL_BLEND)
glEnable(GL_DEPTH_TEST)
glDepthMask(0)
glEnable(GL_CULL_FACE)
glColorMask(1, 0, 1, 0)
glScissor(2, 2, 1, 1)
glEnable(GL_SCISSOR_TEST)
sky_image(tex)
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        assert(__sky_cached.id == tex.id)
        assert(__vg_fb == rt.fbo and __vg_blend and __vg_depth and __vg_cull and not __vg_depth_write)
        assert(__vg_cmask == 5 and __vg_scissor_on and __vg_scissor == (2, 2, 1, 1))
draw_to_screen()
glDepthMask(1)
glColorMask(1, 1, 1, 1)
glDisable(GL_SCISSOR_TEST)
loaded = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk: loaded = __vg_pipeline_creations
update = (dt: f64):
    when TARGET != "wasm" and TARGET != "macos":
        if __vk: assert(__vg_pipeline_creations == loaded)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    if frame_number() >= 4:
        sky_image(tex)
        draw_mesh(ball)
on_quit = (): print("sky filtering ready before drawing")
