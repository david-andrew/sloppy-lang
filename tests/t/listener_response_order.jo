# requires: sloppy
# requires: native
import net
import http
assert(net.listen(0, "127.0.0.1", largest = 4096))
assert(net.port() > 0)
net.stop_listening()
r = http.binary([u8(1)], 201, "image/test")
print(r.status, r.headers.get("Content-Type")!, r.body)
r = http.binary([], type = "custom/test", status = 202)
print(r.status, r.headers.get("Content-Type")!)
