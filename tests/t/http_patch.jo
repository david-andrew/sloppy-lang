# requires: sloppy
# requires: native
# http.read_json changes what it is given (a PATCH: the fields the body has, the rest as they were;
# a body that does not read leaves it as it was), and a server tried from its own program, as
# lib/http.jo's docs show
import http
import net

struct Todo:
    title = ""
    done = false
    tags: str[]
    due: Due

struct Due:
    day = 0
    hour = 9

todos = {1: Todo("milk", false, ["shop"], Due(3, 18))}

http.patch("/todos/:id", (r: http.Request) -> http.Response:
    id = to_int(r.params["id"]) ?? -1
    if not todos.has(id): return http.status(404)
    t = todos[id]
    if let bad = http.read_json(r, t): return bad
    todos[id] = t
    http.json(t))

http.listen(19431, host = "127.0.0.1")
ask = (path: str, body: str) -> net.HttpReply:
    f = net.fetch_start("http://127.0.0.1:19431{path}", method = "PATCH", body = body, wait = 5.0)
    loop true:
        http.answer()
        if let res = net.fetch_result(f): return res
        net.wait(0.1)
    net.HttpReply(0, [])

print(ask("/todos/1", "{{\"done\": true}").text)
print(ask("/todos/1", "{{\"due\": {{\"day\": 5}, \"tags\": []}").text)
r = ask("/todos/1", "{{\"title\": \"eggs\", \"done\": 3}")
print(r.status, todos[1])
print(ask("/todos/2", "{{}").status)
