# Compute functions do every compound assignment, shift and vector conversion as the CPU does:
# %= >>= <<= &= xor= |=, shifts by 32 or more, ivec2(vec2) truncating and saturating
# requires: sloppy
struct P:
    a: GpuBuffer[u32]
    f: GpuBuffer[vec2]
    o: GpuBuffer[i32]
    u: GpuBuffer[u32]
    v: GpuBuffer[ivec2]
k = (id: int, p: P):
    a: u8 = u8(243)
    a %= u8(7)
    p.o[0] = i32(a)
    b = u32(240)
    b >>= u32(4)
    p.o[1] = i32(b)
    c: u8 = u8(200)
    c <<= u8(3)
    p.o[2] = i32(c)
    d = i32(6)
    d &= i32(3)
    p.o[3] = d
    e = u32(6)
    e xor= u32(3)
    p.o[4] = i32(e)
    f = i32(4)
    f |= i32(2)
    p.o[5] = f
    s = i32(-243)
    p.o[6] = s >> i32(p.a[1])
    p.u[0] = p.a[0] >> p.a[1]
    p.u[1] = p.a[0] << p.a[1]
    p.u[2] = p.a[0] << u32(4)
    p.v[0] = ivec2(p.f[0])
    p.v[1] = ivec2(p.f[1])
main = ():
    p = P(gpu_buffer([u32(243), u32(36)]), gpu_buffer([vec2(3.9, -3.9), vec2(1e10, -1e10)]),
          gpu_buffer([loop i in [0..7): i32(0)]), gpu_buffer([loop i in [0..3): u32(0)]), gpu_buffer([ivec2(0, 0), ivec2(0, 0)]))
    dispatch(compute(k), 1, p)
    print(cpu(p.o))
    print(cpu(p.u))
    print(cpu(p.v))
    print(ivec2(vec2(2.5, -7.9)), vec2(ivec2(3, -4)))
