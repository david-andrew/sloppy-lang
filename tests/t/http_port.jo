# requires: sloppy
# requires: native
# known: macos hangs in CI (nothing printed: where is not known yet), to look into
# a test's server on a port the system chooses (listen(0), then port()), and net.fetch told not to
# follow a redirect: the 303 itself, its Location and Set-Cookie
import http
import net

http.post("/login", (r: http.Request) -> http.Response:
    res = http.redirect("/me", 303)
    http.set_cookie(res, "user", http.form(r).get("user") ?? "?")
    res)
http.get("/me", (r: http.Request) -> http.Response: http.text("you are {r.cookies.get("user") ?? "nobody"}"))

print(http.port())
if not http.listen(0, host = "127.0.0.1"): panic("cannot listen")
port = http.port()
print(port > 0 and port < 65536)
spawn((): http.serve(port), background = true)
at = "http://127.0.0.1:{port}"
form = {"Content-Type": "application/x-www-form-urlencoded"}
r = net.fetch(at + "/login", method = "POST", body = "user=ann", headers = form, follow = false)
print(r.status, r.headers.get("location") ?? "-", net.header_values(r, "set-cookie"), r.text)
r = net.fetch(at + "/login", method = "POST", body = "user=ann", headers = form)
print(r.status, r.text)
