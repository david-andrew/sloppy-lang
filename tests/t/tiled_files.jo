# requires: native
# requires: sloppy
# load_tiled(path, files): a Tiled map in XML (.tmx) with a tileset in a file of its own (.tsx,
# one directory over), found next to the map, its image found next to the tileset; CSV, XML and
# base64 layer data, groups, objects with properties, and what is missing said by name
# env: SLOPPY_SCREENSHOT=$TMP/tiled_files.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=1
TMX = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<map version=\"1.10\" orientation=\"orthogonal\" renderorder=\"right-down\" width=\"3\" height=\"2\" tilewidth=\"16\" tileheight=\"16\" infinite=\"0\">
 <!-- the tileset is in its own file -->
 <tileset firstgid=\"1\" source=\"../tiles/forest.tsx\"/>
 <layer id=\"1\" name=\"ground\" width=\"3\" height=\"2\">
  <data encoding=\"csv\">
1,0,2,
3,3,4
</data>
 </layer>
 <group id=\"4\" name=\"deco\">
  <layer id=\"2\" name=\"b64\" width=\"3\" height=\"2\" visible=\"0\">
   <data encoding=\"base64\">
   AQAAAAAAAAACAAAAAwAAAAMAAAADAAAA
   </data>
  </layer>
  <layer id=\"5\" name=\"xml\" width=\"3\" height=\"2\">
   <data><tile gid=\"2\"/><tile/><tile/><tile/><tile/><tile gid=\"1\"/></data>
  </layer>
 </group>
 <objectgroup id=\"3\" name=\"things\">
  <object id=\"1\" name=\"start\" type=\"spawn\" x=\"8\" y=\"20.5\">
   <properties>
    <property name=\"hp\" type=\"int\" value=\"3\"/>
    <property name=\"boss\" type=\"bool\" value=\"true\"/>
    <property name=\"says\" value=\"a &amp; b\"/>
   </properties>
   <point/>
  </object>
 </objectgroup>
</map>"
TSX = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<tileset version=\"1.10\" name=\"forest\" tilewidth=\"16\" tileheight=\"16\" tilecount=\"8\" columns=\"4\">
 <image source=\"forest.png\" width=\"64\" height=\"32\"/>
 <tile id=\"1\">
  <properties>
   <property name=\"shape\" value=\"platform\"/>
  </properties>
 </tile>
</tileset>"
png = encode_png(image(64, 32, rgb(0.2, 0.5, 0.3)))
files = {"maps/level.tmx": bytes(TMX), "tiles/forest.tsx": bytes(TSX), "tiles/forest.png": png}
m = load_tiled("maps/level.tmx", files)
if m is JsonError: print(m.message)
else:
    print(m.width, m.height, m.tile_w, m.tilesets.len(), m.tilesets[0].columns, m.tilesets[0].texture.width)
    loop l in m.layers: print(l.name, l.visible, l.tiles)
    o = m.objects[0]
    print(o.name, o.kind, o.layer, o.rect.x, o.rect.y, o.props["hp"], o.props["boss"], o.props["says"])
    print(tile_shape(m, 2))
# what is missing, by name
files.remove("tiles/forest.png")
e = load_tiled("maps/level.tmx", files)
if e is JsonError: print(e.message)
e2 = load_tiled("level.tmx", files)
if e2 is JsonError: print(e2.message)
files["maps/bad.tmx"] = bytes("<map width=\"1\"><layer></map>")
e3 = load_tiled("maps/bad.tmx", files)
if e3 is JsonError: print(e3.message)
draw = (): clear(rgb(0, 0, 0))
