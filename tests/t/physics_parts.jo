# requires: sloppy (bodies of several parts: add_body, and add_polygon cutting a concave polygon into
# convex parts; contacts, rays, casts, overlaps and points against each part; masses)
import physics
w = physics.World()
floor = w.add_box(vec2(400, 500), vec2(800, 40), kind = .fixed)
# an L (concave): a ball dropped into its corner rests in the corner, not on the hull's slope
l = w.add_polygon(vec2(400, 400), [vec2(-100, -100), vec2(-60, -100), vec2(-60, 40), vec2(100, 40), vec2(100, 80), vec2(-100, 80)], kind = .fixed)
print(w.outlines(l).len(), w.outline(l).len())
ball = w.add_circle(vec2(420, 300), 10)
# a dumbbell: two circles and a bar
db = w.add_body(vec2(200, 200), [.circle(vec2(-40, 0), 15), .circle(vec2(40, 0), 15), physics.box_part(vec2(0, 0), vec2(80, 8))])
print("{w.mass(db):.2}", w.pos(db), w.outlines(db).len())
loop _ in [0..240): w.step(1.0 / 60.0)
b = w.pos(ball)
print("ball {b.x:.0} {b.y:.0}", "dumbbell {w.pos(db).y:.1} {w.angle(db):.2}")
h = w.raycast(vec2(160, 0), vec2(160, 600))
if let hh = h: print("ray hits", hh.body == db, "{hh.point.y:.1}")
print(w.bodies_at(vec2(240, w.pos(db).y)).len(), w.bodies_at(vec2(310, 330)).len())
print(w.overlap_circle(vec2(200, w.pos(db).y), 5).len())
c = w.circle_cast(vec2(-50, w.pos(db).y), vec2(400, w.pos(db).y), 2)
if let cc = c: print("cast hits", cc.body == db, "{cc.point.x:.1}")
# a U falling and coming to rest on its two legs; its mass is its area (no part counted twice)
u = w.add_polygon(vec2(600, 100), [vec2(-50, -40), vec2(-30, -40), vec2(-30, 20), vec2(30, 20), vec2(30, -40), vec2(50, -40), vec2(50, 40), vec2(-50, 40)], angle = 3.14159)
print("U mass {w.mass(u):.2} parts {w.outlines(u).len()}")
loop _ in [0..300): w.step(1.0 / 60.0)
print("U {w.pos(u).x:.1} {w.pos(u).y:.1} {w.angle(u):.2} asleep {w.sleeping(u)}")
star: vec2[]
loop k in [0..10):
    r = 40.0
    if k % 2 == 1: r = 18.0
    star.push(rotate(vec2(f32(r), 0), f64(k) * PI / 5.0))
s = w.add_polygon(vec2(100, 100), star)
print("star parts {w.outlines(s).len()} mass {w.mass(s):.2}")
