# requires: native
# requires: sloppy
# line breaks in addresses and headers: refused by net.fetch, kept on one line by http's answers
import net
import http
r = net.fetch("http://127.0.0.1:9/x\r\nX-Injected: yes", wait = 1.0)
print(r.status, r.why)
r2 = net.fetch("http://127.0.0.1:9/h", headers = {"X-A": "1\r\nX-B: 2"}, wait = 1.0)
print(r2.status, r2.why)
r3 = net.fetch("http://127.0.0.1:9/h", headers = {"Bad Name": "1"}, wait = 1.0)
print(r3.status, r3.why)
res = http.redirect("/x\r\nSet-Cookie: evil=1 é")
print(res.headers["Location"])
c = http.text("hi")
http.set_cookie(c, "name", "a; Domain=evil.com\r\nX: 1")
http.set_cookie(c, "n2", "hello world")
print(c.cookies)
