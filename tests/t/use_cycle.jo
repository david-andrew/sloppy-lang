# requires: sloppy
# two files that use each other: the program is one module, whose globals and types the other
# file shares (the file is not read a second time as a module of its own)
use 'mods/cycle_b.jo'

struct Wall:
    hp: int

count = 0
bump = ():
    count += 1

w = Wall(hp = 5)
hit(w)
print("main sees {count}")
