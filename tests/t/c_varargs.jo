# A float given to a C function taking varargs (sprintf): on Windows also in the integer register,
# on macOS on the stack (@variadic: after the two fixed parameters)
# requires: sloppy
# requires: native
when TARGET == "windows":
    @lib("msvcrt.dll")
    @variadic(2)
    extern sprintf = (buf: *u8, fmt: *u8, x: f64) -> i32
else:
    @lib("libc.so.6")
    @variadic(2)
    extern sprintf = (buf: *u8, fmt: *u8, x: f64) -> i32
b = fill(u8(0), 100)
sprintf(data(b), data("%.1f\0"), 12.5)
print(str_from_bytes(b[..4)))
