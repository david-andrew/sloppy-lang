# requires: sloppy
# the program's own function, named as a value, where the library has one of that name too
# (move and grow for a Rect)
struct P:
    x = 0
move = (p: mut P, by: int): p.x += by
grow = (p: mut P): p.x *= 2
p = P()
p.move(3)
p.grow()
fs = [grow, grow]
loop f in fs: f(p)
print(p.x)
apply = (f: (mut P) -> void, q: mut P): f(q)
apply(grow, p)
print(p.x)
