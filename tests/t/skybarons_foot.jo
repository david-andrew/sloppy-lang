# requires: sloppy
# Sky Barons: on foot, a player's pistol fires (the pad's fire: Space or the mouse) and jumps (the pad's
# throttle -1: Z), both on the ground and on a craft's deck; a jump goes up and comes down again, and
# not from the air or when swimming
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

# (a lone player on foot on the ground)
let g = new_game([0, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = true), [])
loop t in 0..180: g = tick(g, [Pad()])
p = g.people[0]
print("on the ground: state {p.state}, craft {p.craft}")
gy = f64(p.pos.y)
shots = g.bullets.len()
g = tick(g, [Pad(fire = true)])
print("fires the pistol on the ground: {g.bullets.len() > shots}")
peak = 0.0
loop t in 0..60:
    g = tick(g, [Pad(throttle = if t == 0: -1 else: 0)])
    peak = max(peak, f64(g.people[0].pos.y) - gy)
print("jumps from the ground: {peak > 0.5 and peak < 2.0}, down again: {f64(g.people[0].pos.y) - gy < 0.05}")
# (not again in the air)
g = tick(g, [Pad(throttle = -1)])
g = tick(g, [Pad(throttle = -1)])
mid = f64(g.people[0].pos.y)
loop t in 0..5: g = tick(g, [Pad(throttle = -1)])
print("held, it jumps once and comes down in turn: {f64(g.people[0].pos.y) < mid + 3.0}")

# (on a craft's deck)
pilots = fill(-1, 6)
pilots[1] = 0
let h = new_game(pilots, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..120: h = tick(h, [Pad()])
ci = h.people[1].craft
h = tick(h, [Pad(stand = true)])
h = tick(h, [Pad()])
q = h.people[1]
print("on the deck: state {q.state}")
deck0 = f64(q.deck.y)
shots = h.bullets.len()
h = tick(h, [Pad(fire = true)])
print("fires the pistol on the deck: {h.bullets.len() > shots}")
dpeak = 0.0
loop t in 0..60:
    h = tick(h, [Pad(throttle = if t == 0: -1 else: 0)])
    dpeak = max(dpeak, f64(h.people[1].deck.y) - deck0)
print("jumps on the deck: {dpeak > 0.5}")
