# requires: sloppy
# requires: unix
# run_program and run_shell in a task let the others take their turns while the command runs, and
# a task cancelled meanwhile ends the command
main = ():
    ticks = 0
    spawn(():
        loop _ in 0..40:
            sleep(0.01)
            ticks += 1
    , background = true)
    code, out = run_shell("sleep 0.2; echo done")
    print(code, trim(out), ticks >= 5)
    code2, _ = run_shell("sleep 0.2", show = true)
    print(code2, ticks >= 15)
    t = spawn((): run_shell("sleep 10; echo never"))
    sleep(0.05)
    t0 = time()
    t.cancel()
    k, o = t.wait()
    print(k, o, time() - t0 < 2.0)
