# requires: sloppy
# a narrowed variable given another value in a branch that does not come back (a return, or a
# break or continue of a loop the narrowing is inside) is still narrowed after that branch
struct T:
    v: int
    nx: T?

f = (n: mut T?) -> bool:
    if n is T:
        if n.v == 0:
            n = n.nx
            return true
        print(n.v)
    false
x: T? = T(1)
print(f(x))
z: T? = T(0, T(5))
print(f(z), z)

g = (n: mut T?) -> int:
    if n is T:
        if n.v > 10:
            n = none
            return -1
        else if n.v < 0:
            n = T(0)
            return -2
        else:
            print("small")
        return n.v
    0
a: T? = T(3)
b: T? = T(30)
print(g(a), g(b), b)

# (break in a loop the narrowing is inside: the name's scope ends there)
h = (xs: T?[]) -> int:
    s = 0
    loop x0 in xs:
        n = x0
        if n is T:
            if n.v == 0:
                n = none
                break
            s += n.v
    s
ts: T?[] = [T(1), T(2), T(0), T(9)]
print(h(ts))
