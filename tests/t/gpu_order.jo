# Compute functions evaluate compound assignments in the CPU's order (the target, its value, then
# the right side), and build a matrix from integer and float vectors
# requires: sloppy
struct P:
    o: GpuBuffer[vec4]
    m: GpuBuffer[vec4]
bump = (i: mut int) -> int:
    old = i
    i += 1
    old
k = (id: int, p: P):
    i = 0
    xs: vec2[4] = [vec2(10,20),vec2(30,40),vec2(50,60),vec2(70,80)]
    xs[bump(i)].x %= 7.0
    p.o[0] = vec4(f32(i),xs[0].x,xs[1].x,xs[2].x)
    i = 0
    a: u8[2] = [u8(10),u8(20)]
    a[i] += u8(bump(i)+1)
    p.o[1] = vec4(f32(i),f32(a[0]),f32(a[1]),0)
    i = 0
    b: u8[4] = [u8(10),u8(20),u8(30),u8(40)]
    b[bump(i)] += u8(bump(i)+1)
    p.o[2] = vec4(f32(i),f32(b[0]),f32(b[1]),f32(b[2]))
    mm = mat4(ivec2(1,2),vec2(3,4),vec4(5,6,7,8),vec4(9,10,11,12),vec4(13,14,15,16))
    p.m[0] = mm[0]
    p.m[1] = mm[3]
main = ():
    p = P(gpu_buffer([vec4(),vec4(),vec4()]), gpu_buffer([vec4(),vec4()]))
    dispatch(compute(k), 1, p)
    print(cpu(p.o))
    print(cpu(p.m))
