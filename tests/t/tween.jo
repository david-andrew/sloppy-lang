# requires: sloppy
# tweens (a number, a position, a color; delay, repeat, pingpong, retarget), the easing curves,
# follow and Shake (lib/game/gameutil.jo)
a = tween(0.0, 10.0, 2.0, linear)
a.update(0.5)
print(a.value(), a.progress(), a.done())
a.update(2.0)
print(a.value(), a.done())
b = tween(vec2(0, 0), vec2(100, 50), 1.0, ease_out, delay = 0.5)
b.update(0.5)
print(b.value())
b.update(0.5)
print(b.value())
c = tween(rgb(0, 0, 0), rgb(1, 1, 1), 1.0, mode = .pingpong)
c.update(1.5)
print(c.value())
d = tween(1.0, 2.0, 1.0, mode = .repeat)
d.update(2.25)
print(d.progress(), d.done())
d.retarget(5.0)
print(d.value(), d.from, d.to)
d.restart()
print(d.t)
curves = [linear, ease_in, ease_out, ease_in_out, ease_in_cubic, ease_out_cubic, ease_in_out_cubic, ease_in_sine, ease_out_sine, ease_in_out_sine, ease_in_back, ease_out_back, ease_out_elastic, ease_out_bounce]
loop e in curves: print("{e(0.0):.3} {e(0.25):.3} {e(0.5):.3} {e(0.75):.3} {e(1.0):.3}")
cam = follow(vec2(0, 0), vec2(100, 0), 0.1, 8.0, vec2(20, 20))
print(cam.x > 0.0 and cam.x < 80.0, cam.y)
s = Shake()
s.add(0.5)
s.update(0.1)
print(s.trauma, length(s.offset()) <= 24.0)
