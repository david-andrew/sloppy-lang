# requires: sloppy
# to_json and from_json of any value; CSV rows; statistics; pow within an ulp
enum Mode: easy, hard
struct Item:
    name: str
    count = 1
struct Save:
    player = "ann"
    level = 3
    hp = 97.5
    mode = Mode.hard
    pos = vec2(1.5, -2.0)
    items: Item[] = [Item("key"), Item("gem", 4)]
    best: int? = none
    scores: {str: int} = {"a": 1}
    pair = (1, "x")
s = Save()
j = to_json(s)
print(j)
back = from_json[Save](j)
if back is Save: print("round trip:", back == s)
print(from_json[Save](r'{"level": 9, "mode": "easy", "unknown": [1, {"a": 2}], "best": 5}'))
print(from_json[Save](r'{"level": "x"}'))
print(from_json[str](r'"café \"q\""'), to_json([1, 2]), to_json("hi"), to_json(Json.number(3)))

rows = csv_rows("name,region,units\r\nAda,\"north, east\",3\nBob,\"say \"\"hi\"\"\",4\n")
print(rows, csv_rows(to_csv(rows)) == rows, csv_rows("a;b\n1;2", ';'))

print(mean([1, 2, 4]), median([3, 1, 2]), median([4.0, 1.0, 3.0, 2.0]), std_dev([2, 4, 4, 4, 5, 5, 7, 9]))
print(unique([3, 1, 3, 2, 1]), group_by(["apple", "avocado", "bean"], (w: str): byte_str(w[0])))

print(pow(2.0, 0.5) == sqrt(2.0), pow(10.0, 15.5), pow(-2.0, 3.0), pow(0.0, -1.0), pow(-8.0, 1.0 / 3.0) != pow(-8.0, 1.0 / 3.0))
