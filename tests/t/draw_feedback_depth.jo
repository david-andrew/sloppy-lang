# requires: native
# requires: sloppy
# A draw that samples the depth texture of the render target it draws into panics, saying so
# (WebGL forbids it; elsewhere what it draws is undefined). Sampling it from another target is
# fine.
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
struct V:
    pos: vec2
struct U:
    t: Texture
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1))
fs = (i: O, u: U) -> vec4: sample(u.t, i.pos.xy)
sh = make_shader(shader(vs, fs))
tri = mesh([V(vec2(-1, -1)), V(vec2(3, -1)), V(vec2(-1, 3))])
a = render_target(64, 64, depth_texture = true)
b = render_target(64, 64)
draw = ():
    draw_to(b)
    draw(sh, tri, U(a.depth_texture))
    print("sampled from another target")
    draw_to(a)
    draw(sh, tri, U(a.depth_texture))
    print("not reached")
    draw_to_screen()
