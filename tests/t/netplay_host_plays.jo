# requires: sloppy
# requires: native
# a listening server whose host plays too: the host's own player is a number below 0, fed by hand
# (srv.receive, srv.outgoing), beside a player over the network
import netplay
import net

struct Pad:
    dx = 0
struct World:
    pos: {int: int}

apply = (w: World, player: int, p: Pad, seen: World) -> World:
    out = w
    out.pos[player] += p.dx
    out
step = (w: World) -> World: w

main = ():
    srv = netplay.server(World(), apply, step)
    srv.listen(0).unwrap()
    srv.join(-1)
    host = netplay.client(World(), apply)
    guest = netplay.client(World(), apply)
    guest.connect("127.0.0.1", net.port())
    end = time() + 5.0
    loop time() < end and not (host.connected() and guest.connected() and host.state.pos.len() == 2 and host.state.pos[-1] >= 5 and guest.server.pos.get(-1) ?? 0 >= 5):
        srv.update()
        loop p in srv.joined: srv.world.pos[p] = 0
        loop o in srv.outgoing():
            if o.0 == -1: host.receive(o.1)
        if host.connected(): host.play(Pad(dx = 1))
        loop b in host.outgoing(): srv.receive(-1, b)
        guest.play(Pad(dx = 2))
        sleep(1.0 / 60.0)
    print(host.connected(), guest.connected(), host.me, guest.me > 0)
    print(host.state.pos.len(), host.state.pos[-1] >= 5, guest.server.pos.get(-1) ?? 0 >= 5)
