# requires: sloppy
# an enum's variants with fields go to JSON as {"name": [fields]} and come back from it
enum Shape:
    circle(r: f64)
    rect(w: f64, h: f64)
    dot
struct Scene:
    name: str
    shapes: Shape[]
s = Scene("a", [Shape.circle(1.5), Shape.rect(2, 3), Shape.dot])
j = to_json(s)
print(j)
print(from_json[Scene](j))
print(from_json[Shape](" \{ \"rect\" : [1, 2] } "))
print(from_json[Shape]("\{\"rect\": [1, 2]"))
print(from_json[Shape]("\{\"square\": [1]}"))
# in a union with no str or map member: "dot" and {"rect": ...} are the enum's
type Item = Shape | int
xs: Item[] = [Shape.rect(1, 2), 3, Shape.dot]
print(from_json[Item[]](to_json(xs)))
