# requires: native
# requires: sloppy
# hud_nav with a layout root: the keys go to whichever was drawn last. hud_ boxes drawn before the
# root leave them to the layout's navigation; a hud_ dialog drawn after it takes them (its first box
# focused), and the layout's controls do not move or click meanwhile
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=40
# env: SLOPPY_INPUT=5:down+ 6:down- 10:enter+ 11:enter- 25:right+ 26:right- 28:enter+ 29:enter- 31:left+ 32:left- 33:pad_a+ 34:pad_a-
import layout as ui
window("hud nav layout", 1280, 720)
dialog = false
draw = ():
    global dialog
    clear(rgb(0.1, 0.12, 0.16))
    hud_nav(true)
    if hud_button(Rect(900, 20, 100, 40), "Map"): print("{frame_number()}: hud Map")
    if hud_button(Rect(900, 70, 100, 40), "Bag"): print("{frame_number()}: hud Bag")
    ui.screen(pad = 40, gap = 10, ():
        if ui.button("One", key = "one"): print("{frame_number()}: layout One")
        if ui.button("Two", key = "two"): print("{frame_number()}: layout Two")
    )
    if frame_number() == 20: dialog = true
    if dialog:
        hud_panel(Rect(400, 250, 400, 160))
        if hud_button(Rect(420, 340, 170, 44), "Yes"): print("{frame_number()}: hud Yes")
        if hud_button(Rect(610, 340, 170, 44), "No"): print("{frame_number()}: hud No")
    if frame_number() == 15 or frame_number() == 35:
        two = ui.get("two") ?? ui.State()
        print("{frame_number()}: layout Two focused {two.focused}")
