# requires: sloppy
# requires: native
# Animator: plays by name, loops, a once animation finishes and holds, passed() once per loop, fades
robot = load_model(embed("../../examples/breakwater/warden.glb"))
print([loop x in robot.animations: x.name])
a: Animator
a.play(robot, robot.animations[0].name)
steps = 0
loop i in [0..120):
    a.update(robot, 1.0 / 60.0)
    if a.passed(robot, 0.1): steps += 1
print(a.current, a.time, steps, animation_length(robot, 0))
a.play(robot, robot.animations[1].name, looped = false)
print(a.prev >= 0)
loop i in [0..600): a.update(robot, 1.0 / 60.0)
print(a.finished, a.prev, a.time == animation_length(robot, a.current))
p = a.pose(robot)
print(p.t.len() > 0)
