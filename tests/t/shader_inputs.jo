# requires: sloppy
# A stage reads its input where it is, never through a struct holding a copy of it (Adreno 650
# under ANGLE read such copies wrong: terrain noise in a radial fan, woods gone): a fragment
# function's fields from their varyings (v_world) and the position as gl_FragCoord; a vertex
# function's vertex from its attributes (a_pos) and its instance from its own (i_model). So also in
# a helper given the input (at any depth: it becomes the helper's own, with the input no
# parameter), and through a variable given it and never changed. A struct is made only where the
# input is needed as a value (returned, changed): there. A stage reading none of its input is as
# before.
struct InV:
    pos: vec3
    tint: vec4
struct InI:
    model: mat4
    shade: f32
struct InU:
    view_proj: mat4
    k: f32
struct InO:
    pos: vec4
    world: vec3
    tint: vec4
# (vertex: the attributes read directly, in the function and in a helper given the vertex)
in_lift = (v: InV, u: InU) -> vec3: v.pos + vec3(0, u.k, 0)
in_vs = (v: InV, inst: InI, u: InU) -> InO:
    w = inst.model * vec4(in_lift(v, u), 1)
    InO(u.view_proj * w, w.xyz, v.tint * inst.shade)
# (fragment: a direct read; helpers 1 and 2 deep; a variable given the input)
in_fog = (i: InO, u: InU) -> f32: length(i.world) * u.k + i.pos.w
in_shade = (i: InO, u: InU) -> vec4: i.tint * in_fog(i, u)
in_fs = (i: InO, u: InU) -> vec4:
    j = i
    in_shade(i, u) + vec4(j.world, 1) + vec4(i.pos.xy, 0, 0)
# (fragment: a variable given the input and then changed is a value of its own, made from it)
in_changed = (i: InO, u: InU) -> vec4:
    j = i
    j.tint = vec4(1, 0, 0, 1)
    j.tint + i.tint
# (fragment: the input returned whole from a helper is made there)
in_same = (i: InO) -> InO: i
in_whole = (i: InO, u: InU) -> vec4: in_same(i).tint
# (fragment: reading none of its input)
in_none = (i: InO, u: InU) -> vec4: vec4(u.k, 0, 0, 1)
in_lines = (src: str) -> str[]:
    out: str[]
    loop l in split(src, "\n"):
        t = trim(l)
        if "a_" in t or "i_" in t or "v_" in t or "gl_FragCoord" in t or "l_j" in t or " vin" in t or " iin" in t or " i = " in t or "o = f_" in t:
            if not starts_with(t, "layout") and not starts_with(t, "in ") and not starts_with(t, "out ") and not starts_with(t, "flat "): out.push(t)
    out
first = shader(in_vs, in_fs)
print("vertex:")
loop l in in_lines(first.vs): print(l)
loop src in [first, shader(in_vs, in_changed), shader(in_vs, in_whole), shader(in_vs, in_none)]:
    print("fragment:")
    loop l in in_lines(src.fs): print(l)
