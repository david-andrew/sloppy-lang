# retain keeps the elements a test passes, in place and in order (removing while looping over
# them is refused in a `loop mut`)
struct Bullet:
    x = 0.0
    alive = true
bs = [Bullet(1.0), Bullet(2.0, false), Bullet(3.0), Bullet(4.0, false)]
loop mut b in bs: b.x += 10.0
bs.retain((b): b.alive)
print(bs)
ns = [5, 1, 4, 2, 3]
ns.retain((n): n > 2)
print(ns, [1].len())
e: int[]
e.retain((n): true)
print(e)
