# requires: sloppy
# fades: fade_volume glides, fade_out stops at the end, crossfade swaps one loop for another
# (the mixer run by hand: __mix, with no device)
__audio_state = 2
a = tone(440.0, 0.5, .sine, 0.5)
b = tone(660.0, 0.5, .sine, 0.5)
x = play(a, looping = true)
fade_volume(x, 0.2, 0.5)
loop _ in [0..15): __mix(800)
print("{__voices[0].volume:.2} after 0.25 s")
loop _ in [0..30): __mix(800)
print("{__voices[0].volume:.2} after 0.75 s")
y = crossfade(x, b, 0.5)
__mix(800)
print(is_playing(x), is_playing(y), __voices[0].volume < 0.2, __voices[1].volume > 0.0)
loop _ in [0..40): __mix(800)
print(is_playing(x), is_playing(y), "{__voices[0].volume:.2}")
fade_out(y, 0.1)
loop _ in [0..10): __mix(800)
print(is_playing(y), __voices.len())
