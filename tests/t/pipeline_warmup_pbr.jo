# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_pbr.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
window("PBR loading", 160, 90)
# Merely compiling a material draw prepares regular PBR, but never the skin variants.
box = cube_mesh()
loaded = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        assert(__warm_pbr_needed)
        assert(__pbr_ready)
        loaded = __vg_pipeline_creations
update = (dt: f64):
    when TARGET != "wasm" and TARGET != "macos":
        if __vk:
            assert(__vg_pipeline_creations == loaded)
            loop p in __vgp:
                if p.warm_layout == 4 or p.warm_layout == 64:
                    assert(p.vs == 0 and p.fs == 0 and p.pipelines.len() == 0)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    if frame_number() >= 4:
        draw_mesh(box, mat4(), material = Material(metallic = 0.3, roughness = 0.4, alpha_mode = if frame_number() < 6: .mask else: .blend, base_color = vec4(1, 0.3, 0.1, 0.6)))
on_quit = (): print("PBR ready before material draw")
