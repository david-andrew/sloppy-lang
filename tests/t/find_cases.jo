# find and find_byte (eight bytes at a time) at the edges: the same places as Python's str.find; and
# repeating a one-character string ("-" * 10 is ten dashes, not a character code times 10)
# requires: sloppy
xs = ["", "a", "ab", "abc", "hello world", "aaaaaaaaaaaaab", "xyzxyzxyzxyzxyzxyz"]
subs = ["", "a", "b", "ab", "ba", "world", "o w", "aab", "zx", "xyzxyzxyzxyzxyzxyz", "q"]
loop s in xs:
    loop t in subs: write("{find(s, t)} ")
    print("")
print(find("abcab", "ab", 1), find("aaa", "aa", 1), find("hello", "lo", 4))
print(find_byte("hello world, hello", u8(119)), find_byte("abc", u8(122)), find_byte("aaaaaaaaaaaaaaaaab", u8(98), 3), find("xz" * 50 + "needle" + "yz" * 25, "needle"))
print("-" * 10, 3 * "=", "ab" * 2, "x" * 0 == "")
