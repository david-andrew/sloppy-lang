# find and find_byte (eight bytes at a time) at the edges: the same places as Python's str.find; and
# repeating a one-character string ("-" * 10 is ten dashes, not a character code times 10)
# requires: sloppy
xs = ["", "a", "ab", "abc", "hello world", "aaaaaaaaaaaaab", "xyzxyzxyzxyzxyzxyz"]
subs = ["", "a", "b", "ab", "ba", "world", "o w", "aab", "zx", "xyzxyzxyzxyzxyzxyz", "q"]
loop s in xs:
    loop t in subs: write("{(index_of(s, t) ?? -1)} ")
    print("")
print((index_of("abcab", "ab", 1) ?? -1), (index_of("aaa", "aa", 1) ?? -1), (index_of("hello", "lo", 4) ?? -1))
print((index_of("hello world, hello", u8(119)) ?? -1), (index_of("abc", u8(122)) ?? -1), (index_of("aaaaaaaaaaaaaaaaab", u8(98), 3) ?? -1), (index_of("xz" * 50 + "needle" + "yz" * 25, "needle") ?? -1))
print("-" * 10, 3 * "=", "ab" * 2, "x" * 0 == "")
