# requires: sloppy
# requires: native
# Query ports while listeners remain bound: no check/close/rebind race, even across suites.
import net
import http
assert(net.port() == -1)
assert(net.listen(0, host = "127.0.0.1"))
a = net.port()
assert(a > 0 and a < 65536)
s = net.tcp_listen(0, host = "127.0.0.1")
b = net.tcp_port(s)
assert(b > 0 and b < 65536 and b != a)
assert(http.listen(0, host = "127.0.0.1"))
assert(http.listen(0, host = "127.0.0.1"))
c = http.port()
d = http.port(1)
assert(c > 0 and d > 0 and a != c and a != d and b != c and b != d and c != d)
assert(http.port(-1) == -1 and http.port(2) == -1)
net.stop_listening()
net.tcp_close(s)
http.stop_listening()
assert(net.port() == -1 and net.tcp_port(s) == -1 and http.port() == -1)
assert(net.tcp_port(-1) == -1)
print("OS-assigned WebSocket, TCP and multiple HTTP listener ports")
