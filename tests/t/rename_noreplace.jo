# requires: sloppy
# requires: native
# rename_file(replace = false): it fails, and keeps what is there, when the name is taken
d = temp_dir()
a = join_path(d, "sloppy_rn_a")
b = join_path(d, "sloppy_rn_b")
write_file(a, "A")
write_file(b, "B")
print(rename_file(a, b, replace = false), file_error(), read_file(b) ?? "")
delete_file(b)
print(rename_file(a, b, replace = false), read_file(b) ?? "", file_exists(a))
delete_file(b)
