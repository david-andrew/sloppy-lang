# requires: native
# requires: sloppy
# hud_text_field takes the keyboard once clicked (ui_typing: the game leaves letters alone then),
# Enter gives it back; hud_checkbox flips on a click; hud_button selected
# env: SLOPPY_SCREENSHOT=$TMP/hud2.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=42
# env: SLOPPY_INPUT=2:b+ 3:b- 4:mouse=100x38 5:mouse_left+ 6:mouse_left- 8:backspace+ 9:backspace- 10:text=s 12:b+ 13:b- 14:enter+ 15:enter- 16:b+ 17:b- 20:mouse=30x84 21:mouse_left+ 22:mouse_left- 24:mouse=250x138 25:mouse_left+ 26:mouse_left-
name = "goblin"
solid = false
tool = 0
update = (dt: f64):
    if key_pressed(.b) and not ui_typing(): print("{frame_number()}: brush shortcut")
draw = ():
    clear(rgb(0.15, 0.15, 0.2))
    name = hud_text_field(Rect(20, 20, 240, 36), name)
    solid = hud_checkbox(Rect(20, 70, 200, 28), "solid", solid)
    loop i in 0.. and t in ["paint", "fill", "erase"]:
        if hud_button(Rect(f32(20 + i * 110), 120, 100, 36), t, selected = tool == i): tool = i
    if frame_number() == 40: print("name '{name}' solid {solid} tool {tool}")
