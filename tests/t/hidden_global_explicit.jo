# requires: sloppy
# no warnings
import 'mods/hidden_globals.jo' as settings
use 'mods/hidden_globals.jo'
import 'mods/hidden_global_indirect.jo' as indirect
indirect_count = 8
assert(indirect.read_count() == 7 and indirect_count == 8)
# Explicit declarations intentionally make this file's own variables.
let _hidden_count = 10
let __B64 = "ours"
__audio_state: int = 99
# Public names brought in by use change that module's variable.
visible_count = 4
assert(settings.visible_count == 4)
settings.visible_count = 5
# A function's local variable is independent, without a top-level warning.
local_count = () -> int:
    _hidden_count = 20
    _hidden_count
# Tests can still change unsupported library internals explicitly.
hold_clock = ():
    global __fixed_step
    __fixed_step = true
hold_clock()
assert(__fixed_step)
print(_hidden_count, settings.read_hidden(), visible_count, local_count(), __B64, __audio_state)
