# requires: sloppy
# from m import names (renamed with as), import m (m.name), use m (no _ names: they stay in their file)
from 'mods/physics.jo' import Body, step, gravity as g
from 'mods/physics.jo' import (
    describe as desc,
)
import 'mods/physics.jo' as ph
b = Body(vec2(0, 0), vec2(1, 0))
step(b, 0.5)
bs = [b, ph.Body(vec2(5, 5), vec2(0, 0))]
step(bs, 0.5)
print(g, b.pos, bs[1].pos, desc(b), ph.gravity)
# a function of this module with an imported function's name: overloads
step = (n: int) -> int: n + 1
print(step(41))
# `from` is still a name
from = 3
print(from + 1)
# a module's function named as a library one (step), given where a function goes
apply_all = (bs: mut Body[], f: (mut Body[], f64) -> void): f(bs, 0.5)
apply_all(bs, ph.step)
show = (f: (Body) -> str) -> str: f(b)
print(bs[0].pos, show(ph.describe))
