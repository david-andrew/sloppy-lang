# requires: sloppy
# sample() in a vertex shader reads the full-size image, written as textureLod(..., 0.0) in the
# GLSL as the SPIR-V does (an implicit level outside the fragment stage is what some phone drivers
# got wrong); in the fragment shader it stays texture()
struct VsV:
    pos: vec2
struct VsU:
    t: Texture
struct VsO:
    pos: vec4
    c: vec4
vs_lift = (t: Texture, p: vec2) -> f32: sample(t, p).x
vs_vs = (v: VsV, u: VsU) -> VsO: VsO(vec4(v.pos, vs_lift(u.t, v.pos), 1), sample(u.t, v.pos))
vs_fs = (i: VsO, u: VsU) -> vec4: i.c * sample(u.t, i.c.xy)
src = shader(vs_vs, vs_fs)
loop text in [src.vs, src.fs]:
    loop l in split(text, "\n"):
        if "texture" in l and "(" in l and not ("uniform" in l): print(trim(l))
    print("--")
