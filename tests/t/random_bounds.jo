# requires: sloppy
r = rng(42)
print(r.next_int(7, 7))
a = r.next_u64()
r = rng(42)
print(a == r.next_u64())
seed_random(42)
print(random(3.0, 3.0), random_int(8, 8))
x = random()
seed_random(42)
_ = random()    # float equal-bound calls keep their established draw; integer ones do not draw
print(x == random())
