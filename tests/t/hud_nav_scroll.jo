# requires: native
# requires: sloppy
# hud_nav in a hud_scroll list: the d-pad held goes on a row at a time (after a quarter second, 15
# times a second), the list scrolls to show the focused row, down at its last row leaves it for the
# button under it, and up from there comes back to the row it shows last
# env: SLOPPY_SCREENSHOT=$TMP/hud_nav_scroll.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=175
# env: SLOPPY_INPUT=3:pad_down+ 4:pad_down- 6:pad_down+ 66:pad_down- 70:pad_a+ 71:pad_a- 74:pad_down+ 160:pad_down- 162:pad_a+ 163:pad_a- 165:up+ 166:up- 168:enter+ 169:enter-
window("hud nav scroll", 1280, 720)
draw = ():
    clear(rgb(0.1, 0.12, 0.16))
    hud_nav(true)
    hud_panel(Rect(440, 80, 400, 560))
    if hud_button(Rect(460, 100, 360, 40), "Filter"): print("{frame_number()}: Filter")
    r = Rect(460, 150, 360, 400)
    off = hud_scroll(r, 30.0 * 44.0, "slots")
    clip(r)
    loop i in [0..30):
        if hud_button(Rect(r.x, r.y + f32(f64(i) * 44.0 - off), r.w - 12, 40), "Slot {i + 1}", align = .left): print("{frame_number()}: slot {i + 1}, scrolled {off}")
    no_clip()
    if hud_button(Rect(460, 570, 360, 44), "Back"): print("{frame_number()}: Back")
    if frame_number() == 66 or frame_number() == 160: print("{frame_number()}: scrolled {off}")
