# requires: sloppy
# An already enqueued unbuffered send is not withdrawn by cancellation.
c = channel[int]()
t = spawn((): c.send(42))
yield_now()
assert(c.len() == 1)
t.cancel()
t.wait()
print(c.receive(wait = 0.0), c.len())
# Cancellation before enqueueing on a full channel leaves its previous item alone.
b = channel[int](1)
b.send(7)
u = spawn(():
    b.send(8)
    b.send(9, wait = 10.0)
)
u.cancel()
print(u.wait(), b.receive(wait = 0.0), b.len())
# A cancelled sender can still accept into an available buffer; cancellation is not rollback.
v = spawn(():
    b.send(10)
    b.send(11, wait = 10.0)
)
v.cancel()
print(v.wait(), b.receive(wait = 0.0), b.len())
