# requires: sloppy
# All camera overloads preserve degrees; perspective consumes radians.
p = vec3(2, 3, 4)
camera3d(p, vec3(0, 0, 0), fov_degrees = 90)
print(abs(__fov - PI / 2) < 1e-10)
a = orbit_camera()
camera3d(a, fov_degrees = 75)
print(abs(__fov - radians(75.0)) < 1e-10)
b = follow_camera()
camera3d(b, fov_degrees = 45)
print(abs(__fov - radians(45.0)) < 1e-10)
c = fly_camera(p)
camera3d(c, fov_degrees = 80)
print(abs(__fov - radians(80.0)) < 1e-10)
