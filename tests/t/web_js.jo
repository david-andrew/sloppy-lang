# requires: sloppy
# a web build's extern functions come from the build block's js file (sloppy.env), text read with
# sloppy.text; natively the same function is written in Sloppy
build:
    js = "data/web_glue.js"
when TARGET == "wasm":
    extern js_double_len = (p: *u8, n: int, k: int) -> int
    double_len = (s: str, k: int) -> int: js_double_len(data(s), len(s), k)
else:
    double_len = (s: str, k: int) -> int: (len(s) + k) * 2
print(double_len("hello", 1), double_len("", 10))
