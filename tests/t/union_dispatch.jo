# requires: sloppy
# a union passed where each member has an overload calls the one for what it holds (mut ones change it in place), and a field every member has is read from whichever it is
struct Walker:
    pos = vec2(0, 0)
    speed = 10.0
struct Flyer:
    pos = vec2(0, 0)
    height = 5.0
type Mob = Walker | Flyer
step = (w: mut Walker, dt: f64): w.pos.x += f32(w.speed * dt)
step = (f: mut Flyer, dt: f64): f.height += dt
describe = (w: Walker) -> str: "walker at {w.pos.x}"
describe = (f: Flyer) -> str: "flyer {f.height} up"
mobs: Mob[] = [Walker(), Flyer()]
loop mut m in mobs: step(m, 0.5)
loop m in mobs: print(describe(m), m.describe())
one: Mob = Flyer()
one.step(1.0)
print(describe(one))
print([loop m in mobs: describe(m)])
loop m in mobs: print(m.pos, m.pos.x + 1.0)
far = [loop m in mobs if m.pos.x > 1.0: m.describe()]
print(far, one.pos)
