# requires: sloppy
import physics as p
w: p.World
b = w.add_box(vec2(0, 0), vec2(10, 10))
h = w.hinge(p.ground, b, vec2(0, 0))
s = w.slider(p.ground, b, vec2(0, 0), vec2(1, 0))
w.set_motor(h, speed = 2, limit = 30)
w.set_motor(s, speed = 4, limit = 50)
print(w.joints[0].max_torque, w.joints[0].motor_speed)
print(w.joints[1].max_force, w.joints[1].motor_speed)
