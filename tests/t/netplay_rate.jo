# requires: sloppy
# requires: native
# netplay at 20 ticks a second: the client learns the server's rate from its worlds, and c.view(),
# drawn each frame (60 a second), moves each frame, between whole ticks, about interpolation
# seconds behind the server
import netplay

struct Pad:
    dx = 0
struct World:
    x = 0.0

apply = (w: World, player: int, p: Pad, seen: World) -> World: w
step = (w: World) -> World: World(w.x + 1.0)

const PORT = 9535

main = ():
    srv = netplay.server(World(), apply, step)
    srv.ticks_per_second = 20.0
    srv.send_every = 1
    srv.listen(PORT)
    c = netplay.client(World(), apply)
    c.connect("127.0.0.1", PORT)
    frames = 0
    moved = 0
    between = 0
    backwards = 0
    behind: f64[]
    last = -1.0
    start = time()
    shown_at = -1.0
    ticks = 0
    loop f in 0..240:
        # (a tick each 50 ms of the clock, on both sides, as a game plays them: a frame late
        # does not make the ticks late too)
        loop time() - start >= f64(ticks) * 0.05:
            srv.update()
            c.play(Pad())
            ticks += 1
        if c.connected() and f >= 60:
            a, b, t = c.view()
            x = f64(mix(f32(a.x), f32(b.x), t))
            if x < last - 0.01: backwards += 1
            # (counted, the frames that came on time: a sleep that ran long, or the frames
            # run at once to catch up after it, are not the frames a game shows)
            now = time()
            gap = now - shown_at
            shown_at = now
            if gap > 0.008 and gap < 0.03:
                frames += 1
                if x > last: moved += 1
                if t > 0.05 and t < 0.95: between += 1
                behind.push(srv.world.x - x)
            last = x
        # (on time: each frame's start from the first)
        wait = start + f64(f + 1) / 60.0 - time()
        if wait > 0.0: sleep(wait)
    print("rate learned:", c.ticks_per_second)
    # (said with the counts when one is not so: to see how a runner missed)
    moved_ok = moved * 10 > frames * 6 and frames >= 60
    between_ok = between * 2 > frames
    counts = if moved_ok and between_ok: "" else: " (of {frames} frames on time: moved {moved}, between ticks {between})"
    print("moved on most frames: {moved_ok} between ticks on many: {between_ok} never back: {backwards == 0}{counts}")
    avg = 0.0
    loop d in behind: avg += d
    avg /= f64(max(behind.len(), 1))
    # (0.1 s at 20 a second: 2 ticks, less the time since the tick, a third of one on average;
    # more on a busy machine, whose sleeps run long)
    ok = avg > 1.2 and avg < 3.2
    print("behind the server by about the interpolation: {ok}{if ok: "" else: " ({avg:.2})"}")
