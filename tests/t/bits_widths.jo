# requires: sloppy
# bit helpers count and turn a number's own bits (a u32's 32, a u8's 8); get_le of 3 bytes;
# to_int in other bases; set_env and env_all
x: u32 = 0x80000001
print(rotate_left(x, 1), rotate_right(x, 1), rotate_left(u8(0x81), 1), rotate_left(i32(-2), 1), rotate_left(5, 1))
print(leading_zeros(u32(1)), leading_zeros(u8(0x80)), leading_zeros(u16(1)), leading_zeros(u64(1)), leading_zeros(1))
print(popcount(i32(-1)), popcount(u8(255)), popcount(-1), popcount(i8(-1)))
print(trailing_zeros(u32(0)), trailing_zeros(u8(8)), trailing_zeros(0))
b: u8[] = [1, 2, 3, 4]
print(get_le(b, 0, 3), get_be(b, 1, 3), get_le_signed([u8(0xFF), 0xFF, 0xFF], 0, 3))
print(to_int("ff", 16), to_int("0xff"), to_int("0b101"), to_int("0o17"), to_int("z", 36), to_int("ff"), to_int("101", 2), to_int("2", 2), to_int(" -7f ", 16))
set_env("SLOPPY_TEST_VAR", "yes")
print(env("SLOPPY_TEST_VAR") ?? "-", env_all().get("SLOPPY_TEST_VAR") ?? "-")
unset_env("SLOPPY_TEST_VAR")
print(env("SLOPPY_TEST_VAR") ?? "gone")
