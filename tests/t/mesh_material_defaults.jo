# requires: sloppy
# requires: native
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=3
# env: SLOPPY_SCREENSHOT=$TMP/mesh_material_defaults.png
# Both instancing forms must render exactly like the same ordinary default-material draw.
window("material defaults", 160, 120)
m = sphere_mesh(1)
xs = [instance(mat4())]
kept = instance_buffer(xs)
previous: Image
draw = ():
    global previous
    clear(BLACK)
    camera3d(vec3(0, 1, 4), vec3(0, 0, 0))
    if frame_number() == 0: draw_mesh(m, cast_shadow = false)
    else if frame_number() == 1: draw_mesh_instanced(m, xs, cast_shadow = false)
    else: draw_mesh_instanced(m, kept, cast_shadow = false)
    assert(__draws[0].specular == f32(0.3))
    img = screenshot()
    if frame_number() == 0: previous = img
    else: print(img.pixels == previous.pixels)
