# requires: sloppy
# requires: native
# requires: unix
# Library declarations nested in when/else, with multiline headers and strings.
lib = env("SLOPPY_LIB") ?? "{cwd()}/lib"
compiler = "{lib}/../bin/sloppy"
scratch = "{temp_dir()}/lazy-library-{time_ns()}"
make_dirs(scratch)
rc, copied = run_program("cp", ["-R", lib, "{scratch}/lib"])
assert(rc == 0, copied)
probe = join([
    r'when TARGET == "linux":',
    r'    when true:',
    r'        lazy_probe = (',
    r'            x: int',
    r'        ) -> str: # header comment, skipped before the lazy body starts',
    '            # documentation-sized comment ' + repeat('x', 160),
    '        \t# tab after two space groups, with the same indentation',
    '            ',
    r'            prefix = """a',
    r'not_a_declaration = ():',
    r'"""',
    r'            if x == 0: return prefix',
    r'            "{if x > 0: "ok" else: "bad"}:{lazy_twice(x)}"',
    r'',
    r'        lazy_unused = () -> str:',
    r'            """# a comment and quotes inside a multiline string',
    r'unindented text',
    r'"""',
    r'    else:',
    r'        lazy_probe = (x: int) -> str:',
    r'            "unselected:{x}"',
    r'else:',
    r'    lazy_probe = (x: int) -> str:',
    r'        "ok:{lazy_twice(x)}"',
    r'',
    r'lazy_twice = (x: int) -> int:',
    r'    x * 2',
    r'',
], "\n") + "    # final comment without a newline"
assert(write_file("{scratch}/lib/std/zz_lazy_probe.jo", probe))
assert(write_file("{scratch}/main.jo", "print(lazy_probe(2))\n"))
set_env("SLOPPY_LIB", "{scratch}/lib")
loop debug in [false, true]:
    flags = ["build", "{scratch}/main.jo", "-o", "{scratch}/program"]
    if debug: flags.push("-g")
    built, diagnostic = run_program(compiler, flags)
    assert(built == 0, diagnostic)
    ran, output = run_program("{scratch}/program")
    assert(ran == 0 and output == "ok:4\n", output)
set_env("SLOPPY_LIB", lib)
removed, cleanup = run_program("rm", ["-rf", scratch])
assert(removed == 0, cleanup)
print("lazy library declarations ok")
