struct Left: value: int
struct Right: value: int
choose = (n: int) -> (Left | Right)?:
    if n == 0: return none
    Left(n)
make_union = (n: int) -> Left | str:
    if n == 0: return "zero"
    Left(n)
make_fields = (n: int) -> Left | Right:
    if n == 0: return Right(n)
    Left(n)
score = (v: Left) -> int: v.value
score = (v: str) -> int: len(v)
empty = (xs: mut int?[]): xs[0] = none
narrow = ():
    x: int? = 3
    flip = (): x = none
    if x != none:
        flip()
        print(x + 1)
loop_alias = ():
    slots: int?[] = [4]
    loop i in 0.. and mut v in slots:
        if v != none:
            empty(slots)
            print(v + 1)
explicit_name = ():
    let __user_optional: int? = none
    print(__user_optional!)
struct Callback: run: () -> void
loop_callback = ():
    callbacks = [Callback()]
    loop i in 0.. and cb in callbacks:
        cb.run()
mode = if args().len() > 1: args()[1] else: "safe"
if mode == "safe":
    n = args().len() - 1
    print(choose(n) is Left, score(make_union(n)), make_fields(n).value)
else if mode == "narrow": narrow()
else if mode == "loop": loop_alias()
else if mode == "explicit": explicit_name()
else: loop_callback()
