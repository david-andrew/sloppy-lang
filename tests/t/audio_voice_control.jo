# requires: sloppy
# env: SLOPPY_NO_AUDIO=1
# where voices start and where they are: a negative delay starts that far in, `at` on the audio
# clock (ahead, or past: as far in as it would be by then), pitch and looping; pause, resume,
# seek and voice_time, for sounds and for music decoded as it plays (the mixer run by hand)
__audio_state = 2
master_volume(1.0)
# (frame i of the sound is i / 2000: where it is shows in what it gives)
ramp: f32[]
loop i in [0..1000):
    ramp.push(f32(i) / 2000.0)
    ramp.push(f32(i) / 2000.0)
s = Sound(ramp)
first = (id: int) -> str:
    __mix(1)
    stop(id)
    "{__mix_buf[0] * 2000.0:.0}"
r = 48000.0
print("delay -100 frames: starts at frame", first(play(s, delay = -100.0 / r)))
print("pitch 2, delay -10: frame", first(play(s, pitch = 2.0, delay = -10.0 / r)))
print("looping, delay -1005: frame", first(play(s, looping = true, delay = -1005.0 / r)))
w = f64(__mixed)
print("at 30 frames ago: frame", first(play(s, at = (w - 30.0) / r)))
id = play(s, at = (f64(__mixed) + 50.0) / r)
print("at 50 frames ahead: voice_time {voice_time(id) * r:.0} frames")
__mix(52)
print("  frames 49, 50, 51 of the mix: {__mix_buf[98] * 2000.0:.0} {__mix_buf[100] * 2000.0:.0} {__mix_buf[102] * 2000.0:.0}")
stop(id)
# pause, resume, seek
id = play(s)
__mix(10)
pause(id)
__mix(10)
print("paused: silent {__mix_buf[0] == 0.0 and __mix_buf[18] == 0.0}, still playing {is_playing(id)}, at {voice_time(id) * r:.0}")
resume(id)
print("resumed: frame", first(id))
id = play(s)
seek(id, 480.0 / r)
print("seek to frame 480: voice_time {voice_time(id) * r:.0}, frame", first(id))
print("delay 0.5: voice_time {voice_time(play(s, delay = 0.5)):.2}")
stop_all()
# music
file = embed("data/sweep.ogg")
whole = load_ogg(file)
m = load_music(file)
id = play_music(m, delay = -0.5)
print("music, delay -0.5: voice_time {voice_time(id):.3}")
__mix(4800)
print("  after 0.1 s: {voice_time(id):.3}")
seek(id, 2.0)
__mix(100)
worst = 0.0
loop k in [0..100): worst = max(worst, abs(f64(__mix_buf[k * 2]) - f64(whole.samples[(96000 + k) * 2])))
print("  seek to 2 s: voice_time {voice_time(id):.4}, the samples load_ogg has there: {worst < 1e-5}")
pause(id)
__mix(4800)
print("  paused: {voice_time(id):.4}")
stop(id)
id = play_music(m, at = audio_time() + 0.25)
print("music at 0.25 s from now: voice_time {voice_time(id):.3}")
__mix(12000 + 10)
print("  started on time: {voice_time(id) * r:.0} frames in")
