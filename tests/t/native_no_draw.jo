# requires: native
# requires: sloppy
# env: SLOPPY_NO_DRAW=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=4
# env: SLOPPY_INPUT=1:right+ 2:text=hello 3:right-
# No renderer or display is needed; update, clocks, input and on_quit still run.
window("logic test", 640, 360)
window("renamed logic test", 640, 360)
assert(mouse_lock() and is_mouse_locked())
show_cursor(false)
set_fullscreen()
assert(is_fullscreen())
updates = 0
draws = 0
update = (dt: f64):
    global updates
    updates += 1
    assert(dt == 1.0 / 60.0)
    assert(abs(elapsed() - f64(frame_number()) / 60.0) < 0.000001)
    if key_pressed(.right): print("pressed {frame_number()}")
    if len(text_input()) > 0: print("typed {text_input()}")
    if key_released(.right): print("released {frame_number()}")
draw = ():
    global draws
    draws += 1
    clear()
on_quit = ():
    print("updates {updates}, draws {draws}")
