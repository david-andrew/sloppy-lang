# requires: native
# requires: sloppy
# hud_nav and a dialog: boxes under a hud_panel drawn after them cannot have the focus, so it goes
# to the dialog's first box and stays among its boxes; as the dialog goes, the focus goes back to
# the box it was on. A menu that slides keeps the focus on its box
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=56
# env: SLOPPY_INPUT=3:pad_down+ 4:pad_down- 8:pad_a+ 9:pad_a- 14:pad_right+ 15:pad_right- 18:pad_up+ 19:pad_up- 21:pad_left+ 22:pad_left- 24:pad_a+ 25:pad_a- 30:pad_down+ 31:pad_down- 40:pad_up+ 41:pad_up- 44:pad_up+ 45:pad_up- 47:pad_down+ 48:pad_down- 50:enter+ 51:enter-
window("hud nav dialog", 1280, 720)
asking = false
draw = ():
    global asking
    clear(rgb(0.1, 0.12, 0.16))
    hud_nav(true)
    # (from frame 35 the menu slides right, 7 units a frame)
    x = 100.0 + 7.0 * f64(max(frame_number() - 35, 0))
    if hud_button(Rect(x, 100, 200, 40), "New"): print("{frame_number()}: New")
    if hud_button(Rect(x, 150, 200, 40), "Delete"):
        print("{frame_number()}: Delete")
        asking = true
    if hud_button(Rect(x, 200, 200, 40), "Copy"): print("{frame_number()}: Copy")
    if asking:
        hud_panel(visible_rect(), rgba(0, 0, 0, 0.5))
        hud_panel(Rect(400, 250, 400, 160))
        if hud_button(Rect(420, 340, 170, 44), "Delete it"):
            print("{frame_number()}: Delete it")
            asking = false
        if hud_button(Rect(610, 340, 170, 44), "Keep it"):
            print("{frame_number()}: Keep it")
            asking = false
