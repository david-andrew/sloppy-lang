# requires: native
# requires: sloppy
# screen_ray and world_to_screen in a window wider than the design area: 3D fills the window, so
# the design area's left edge is inside the picture, and a point there maps back to it
# env: SLOPPY_SCREENSHOT=$TMP/ray.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
# env: SLOPPY_WINDOW=1600x600
draw = ():
    camera3d(vec3(0, 0, 0), vec3(0, 0, -1))
    if frame_number() != 1: return
    o, d = screen_ray(vec2(0, 360))
    print("slope {d.x / -d.z:.3f}")
    back = world_to_screen(o + d * 5.0)!
    print("back at {back.x:.1}, {back.y:.1}")
