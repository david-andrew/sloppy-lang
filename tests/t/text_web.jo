# requires: sloppy
# text cut by characters (a precision on a string, first and last), URLs' encoding and queries,
# HTML's entities
s = "café au lait"
print("[{s:.4}] [{s:<14.14}] [{s:>6.3}] [{s:.0}] [{s:.60}] [{"😀😀x":.2}]")
print(first(s, 4), "|", last(s, 4), "|", first("é", 3), "|", last("", 2), "|", first(s, -1), "|", last("naïve", 3))
print(url_encode("café au lait/&=?~-_."), url_decode("caf%C3%A9+x%2"), url_decode("a+b%20c", plus = true), url_decode(url_encode("ж 100%")))
print(url_query({"q": "x y", "n": "5"}), url_query({"page": 2}))
print(html_unescape("Tom &amp; Jerry &#8212; &lt;b&gt; &eacute;t&eacute; &#xE9;&#x1F600; &unknown; & &amp &#0; &nbsp;|&copy;&hellip;&yuml;&#39;"))
print(html_escape("<a href=\"x\">'&'</a>"), html_unescape(html_escape("<'&\">")))
