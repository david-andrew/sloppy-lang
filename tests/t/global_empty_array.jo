# requires: sloppy
# a top-level array made empty takes the type of what a function pushes into it (as a local does),
# also where it is read before that function is called or checked
enemies = []
names: {str: int} = {}
scores = []
count = () -> int: enemies.len()
show = ():
    loop e in enemies: print(e)
    loop k, v in names: print(k, v)
    print(scores.sum(), count())
add = (p: vec2):
    enemies.push(p)
    names["a{enemies.len()}"] = enemies.len()
show()
add(vec2(1, 2))
add(vec2(3, 4))
scores.push(2.5)
scores.push(1.0)
show()
print(enemies, names, scores)
