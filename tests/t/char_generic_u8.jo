# requires: sloppy
# a character literal where a generic parameter is bound to u8
f = (c: u8) -> int: int(c)
print(f('#'))                  # ok (non-generic)
xs = bytes("a#b")
print(xs.index_of('#'))        # error: found str
grid: {int: u8} = {}
grid[0] = '#'                  # error: found str
s: Set[u8] = {}
s.add('x')                     # error: found str
print(grid, s)
