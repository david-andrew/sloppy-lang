# requires: sloppy
# Heap: smallest priority first, push and pop in any order
h: Heap[str]
loop w in ["d", "a", "c", "e", "b"]: h.push(w, f64(int(w[0])))
print(h.len(), h.peek(), h.peek_priority())
out: str[]
loop h.len() > 0: out.push(h.pop())
print(out)
g: Heap[int]
loop i in [0..1000): g.push(i, f64((i * 7919) % 1000))
ok = true
last = -1.0
loop g.len() > 0:
    p = g.peek_priority()
    if p < last: ok = false
    last = p
    g.pop()
print(ok)
