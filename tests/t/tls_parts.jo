    "FOp1y/kRFtuOAK4LLhFJN8vSp5WeMAoGCCqGSM49BAMCA0gAMEUCIFz2unL8gqW0HOcXEUtrsjxfhjDJNDmM2SUs+BbSKbZP" +
    "AiEAofeUppJGmV2uR5QiC0SSkLdVRwJMMJgvyii09BvIbSw=")!
ok = (chain: u8[][], host: str, at: int) -> str:
    w = tls.__tls_verify(chain, host, at).0
    if len(w) == 0: "good" else: w
print(tls.__tls_trust("-----BEGIN CERTIFICATE-----\n{base64_encode(root)}\n-----END CERTIFICATE-----\n"))
day = tls.__tls_cert(root)!.not_before + 86400
print(ok([leaf, inter], "localhost", day), ok([leaf, inter], "a.wild.test", day), ok([leaf, inter], "127.0.0.1", day), ok([leaf, inter], "LocalHost.", day))
print(ok([leaf, root, inter], "localhost", day))
print(ok([leaf, inter], "wild.test", day))
print(ok([leaf, inter], "a.b.wild.test", day))
print(ok([leaf, inter], "localhost", day - 2 * 86400))
print(ok([leaf, inter], "localhost", day + 101 * 365 * 86400))
print(ok([leaf], "localhost", day))
print(ok([ncok, nc], "a.allowed.test", day))
print(ok([ncbad, nc], "a.allowed.test", day))
print(ok([sha1, inter], "localhost", day))
print(ok([client, inter], "localhost", day))
print(ok([byleaf, leaf, inter], "localhost", day))

# TLS 1.3's key schedule, with RFC 8448's simple handshake: its x25519 keys, ClientHello and
# ServerHello
ch = x("")
sh = x("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")
ck = crypto.X25519Key(x("49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005"), [])
shared = crypto.x25519_ecdh(ck, x("c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"))!
print(h(shared))
zero = fill(u8(0), 32)
early = crypto.hkdf_extract(zero, zero)
print(h(early))
hs = crypto.hkdf_extract(tls.__tls_derive(early, "derived", []), shared)
print(h(hs))
transcript = ch
transcript.extend(sh)
print(h(tls.__tls_derive(hs, "c hs traffic", transcript)))
s_hs = tls.__tls_derive(hs, "s hs traffic", transcript)
print(h(s_hs))
print(h(tls.__tls_label(s_hs, "key", [], 16)), h(tls.__tls_label(s_hs, "iv", [], 12)))
print(h(crypto.hkdf_extract(tls.__tls_derive(hs, "derived", []), zero)))
