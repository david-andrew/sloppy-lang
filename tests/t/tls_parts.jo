# requires: sloppy
# requires: native (the system's certificate authorities are read)
# lib/tls.jo's parts: names against a certificate's (RFC 6125's wildcards), name constraints, dates,
# a certificate read and its signature checked, and TLS 1.3's keys against RFC 8448's trace
import tls
import crypto
x = (s: str) -> u8[]: crypto.hex_bytes(s)!
h = (b: u8[]) -> str: crypto.hex_text(b)

# names
print(tls.__tls_name_match("example.com", "example.com"), tls.__tls_name_match("*.example.com", "a.example.com"))
print(tls.__tls_name_match("*.example.com", "example.com"), tls.__tls_name_match("*.example.com", "a.b.example.com"),
    tls.__tls_name_match("*.com", "a.com"), tls.__tls_name_match("a*.example.com", "ab.example.com"),
    tls.__tls_name_match("*.*.example.com", "a.b.example.com"), tls.__tls_name_match("*.example.com", ".example.com"))
print(tls.__tls_dns_within("a.example.com", "example.com"), tls.__tls_dns_within("example.com", "example.com"),
    tls.__tls_dns_within("a.example.com", ".example.com"), tls.__tls_dns_within("*.example.com", ".example.com"))
print(tls.__tls_dns_within("badexample.com", "example.com"), tls.__tls_dns_within("example.com", ".example.com"),
    tls.__tls_dns_within("example.org", "example.com"))
ex = tls.__TlsCert(constrained = true, exclude_dns = ["a.example.com"])
print(tls.__tls_names_allowed(ex, tls.__TlsCert(dns = ["*.example.com"])), tls.__tls_names_allowed(ex, tls.__TlsCert(dns = ["b.example.com"])),
    tls.__tls_names_allowed(ex, tls.__TlsCert(dns = ["*.b.example.com"])), tls.__tls_names_allowed(ex, tls.__TlsCert(dns = ["x.a.example.com"])))
print(tls.__tls_ip_within([u8(10), 1, 2, 3], [u8(10), 0, 0, 0, 255, 0, 0, 0]), tls.__tls_ip_within([u8(11), 1, 2, 3], [u8(10), 0, 0, 0, 255, 0, 0, 0]))
print(tls.__tls_ip4("127.0.0.1")!, tls.__tls_ip4("localhost") == none, tls.__tls_ip4("1.2.3.256") == none)

# dates: UTCTime (to 2049) and GeneralizedTime
utc = (s: str) -> int?: tls.__tls_time(bytes(s), (0x17, 0, len(s)))
gen = (s: str) -> int?: tls.__tls_time(bytes(s), (0x18, 0, len(s)))
print(utc("700101000000Z")!, utc("491231235959Z")!, gen("20500101000000Z")!, utc("500101000000Z")!)
print(utc("491231235959") == none, utc("4912312359a9Z") == none, gen("2050010100000Z") == none, utc("491331235959Z") == none)

# a certificate (crypto's self-signed one) read, its signature checked, then changed
k = crypto.p256_key()
der = crypto.self_signed_certificate(k, "tls test")
c = tls.__tls_cert(der)!
print(tls.__tls_name_text(c.subject), c.key_kind == tls.__TLS_KEY_P256, c.key == k.public, c.v3, c.not_after)
print(tls.__tls_check_sig(c, c.sig_kind, c.sig_hash, c.tbs, c.sig))
bad = der
bad[bad.len() - 80] = bad[bad.len() - 80] xor 1
print(tls.__tls_cert(bad) == none or not tls.__tls_check_sig(c, c.sig_kind, c.sig_hash, bad, c.sig))
# (cut short anywhere: not a certificate)
cut = 0
loop n in [0..der.len()):
    if tls.__tls_cert(der[..n)) != none: cut += 1
print(cut)
# not trusted, then trusted (as net.trust_certificate does); it names no server, though
pem = "-----BEGIN CERTIFICATE-----\n{base64_encode(der)}\n-----END CERTIFICATE-----\n"
now = int(unix_time())
print(tls.__tls_verify([der], "tls.test", now).0)
print(tls.__tls_trust(pem))
print(tls.__tls_verify([der], "tls.test", now).0)

# chains, checked on a day within their dates: an authority (P-256), an intermediate (P-384) and
# a leaf for localhost, *.wild.test and 127.0.0.1; one constrained to names under allowed.test, and
# two leaves of it; a leaf signed with SHA-1, one for clients only, and one signed by a leaf
# (made by OpenSSL, good for a hundred years)
