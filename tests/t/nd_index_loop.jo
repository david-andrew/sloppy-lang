# requires: sloppy
# rows of a T[,] (1-D arrays) read element by element in loops, as the elements of T[] rows are;
# a function of the program's own that never returns, as a check in a loop
M = reshape([loop i in 0..60: f64(i % 13) * 0.5], 6, 10)
rows_nd = [loop i in 0..6: M[i, ..]]
rows_flat = [loop i in 0..6: row(M, i)]

sum_nd = () -> f64:
    s = 0.0
    loop i in 0..6:
        r = rows_nd[i]
        loop j in 0..10: s += r[j]
    s

sum_flat = () -> f64:
    s = 0.0
    loop i in 0..6:
        r = rows_flat[i]
        loop j in 0..10: s += r[j]
    s

too_big = (x: f64, limit: f64):
    panic("{x} is over {limit}")

checked_total = (xs: f64[], limit: f64) -> f64:
    t = 0.0
    loop i in 0..xs.len():
        if xs[i] > limit: too_big(xs[i], limit)
        t += xs[i]
    t

print(sum_nd(), sum_flat(), sum_nd() == sum(M))
print(checked_total(row(M, 2), 10.0))
v = M[3, ..]
v[2] = 100.0
print(v[2], M[3, 2], v.shape)
print(checked_total(row(M, 1), 5.0))
