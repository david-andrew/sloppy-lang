# requires: sloppy
# a tuple type as a type argument of a call: id[(int, str)](...), and inside other types
id[T] = (x: T) -> T: x
first[T] = (xs: T[]) -> T: xs[0]
print(id[(int, str)]((1, "a")))
print(first[(int, (str, bool))]([(2, ("b", true))]))
print(id[(int, str)[]]([(3, "c"), (4, "d")]))
print(id[(f64, int)?](none))
