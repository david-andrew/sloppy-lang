# requires: sloppy
# an expression evaluator (tokenizer, parser, evaluator) passing its errors on with `?`

enum Kind: num, ident, op, lparen, rparen, comma, eof

struct Token:
    kind: Kind
    text: str
    pos: int          # byte offset
    num = 0.0

error struct Error:
    msg: str
    pos: int

tokenize = (src: str) -> Token[] | Error:
    toks: Token[]
    i = 0
    n = len(src)
    loop i < n:
        c = src[i]
        if c == ' ' or c == '\t' or c == '\n':
            i += 1
            continue
        start = i
        if c >= '0' and c <= '9' or c == '.':
            loop i < n and (src[i] >= '0' and src[i] <= '9' or src[i] == '.'): i += 1
            text = src[start..i)
            v = to_float(text)
            if v == none: return Error("bad number '{text}'", start)
            toks.push(Token(.num, text, start, v!))
            continue
        if c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_':
            loop i < n and (src[i] >= 'a' and src[i] <= 'z' or src[i] >= 'A' and src[i] <= 'Z' or src[i] == '_' or src[i] >= '0' and src[i] <= '9'): i += 1
            toks.push(Token(.ident, src[start..i), start))
            continue
        if c == '(':
            toks.push(Token(.lparen, "(", start))
        else if c == ')':
            toks.push(Token(.rparen, ")", start))
        else if c == ',':
            toks.push(Token(.comma, ",", start))
        else if c in "+-*/^=<>":
            # two-char ops
            if i + 1 < n and src[i + 1] == '=' and (c == '=' or c == '<' or c == '>'):
                toks.push(Token(.op, src[i..i + 2), start))
                i += 2
                continue
            toks.push(Token(.op, byte_str(c), start))
        else:
            return Error("unexpected character '{byte_str(c)}'", start)
        i += 1
    toks.push(Token(.eof, "", n))
    toks

enum Expr:
    num(v: f64, pos: int)
    var(name: str, pos: int)
    unary(op: str, kids: Expr[], pos: int)
    binary(op: str, kids: Expr[], pos: int)
    call(name: str, args: Expr[], pos: int)
    let_in(name: str, kids: Expr[], pos: int)      # kids: [value, body]
    lambda(params: str[], kids: Expr[], pos: int)  # kids: [body]

struct Parser:
    toks: Token[]
    at = 0

peek = (p: Parser) -> Token: p.toks[p.at]
advance = (p: mut Parser) -> Token:
    t = p.toks[p.at]
    if t.kind != .eof: p.at += 1
    t

expect = (p: mut Parser, k: Kind, what: str) -> Token | Error:
    t = p.peek()
    if t.kind != k: return Error("expected {what}, found '{t.text}'", t.pos)
    p.advance()

prec = (op: str) -> int:
    match op:
        "==", "<", ">", "<=", ">=": 1
        "+", "-": 2
        "*", "/": 3
        "^": 4
        _: -1

parse_expr = (p: mut Parser, min_prec: int) -> Expr | Error:
    lhs = parse_unary(p)?
    loop:
        t = p.peek()
        if t.kind != .op: break
        pr = prec(t.text)
        if pr < min_prec: break
        p.advance()
        next_min = if t.text == "^": pr else: pr + 1
        rhs = parse_expr(p, next_min)?
        lhs = Expr.binary(t.text, [lhs, rhs], t.pos)
    lhs

parse_unary = (p: mut Parser) -> Expr | Error:
    t = p.peek()
    if t.kind == .op and t.text == "-":
        p.advance()
        e = parse_expr(p, 4)?    # binds looser than ^
        return Expr.unary("-", [e], t.pos)
    parse_primary(p)

parse_primary = (p: mut Parser) -> Expr | Error:
    t = p.advance()
    match t.kind:
        .num: Expr.num(t.num, t.pos)
        .lparen:
            e = parse_expr(p, 0)?
            p.expect(.rparen, "')'")?
            e
        .ident:
            if t.text == "let":
                name = p.expect(.ident, "a name after let")?
                p.expect(.op, "'='")?
                v = parse_expr(p, 0)?
                kw = p.peek()
                if kw.kind != .ident or kw.text != "in": return Error("expected 'in', found '{kw.text}'", kw.pos)
                p.advance()
                body = parse_expr(p, 0)?
                return Expr.let_in(name.text, [v, body], t.pos)
            if t.text == "fn":
                p.expect(.lparen, "'('")?
                params: str[]
                loop p.peek().kind != .rparen:
                    params.push(p.expect(.ident, "a parameter name")?.text)
                    if p.peek().kind == .comma: p.advance()
                p.advance()
                body = parse_expr(p, 0)?
                return Expr.lambda(params, [body], t.pos)
            if p.peek().kind == .lparen:
                p.advance()
                args: Expr[]
                loop p.peek().kind != .rparen:
                    args.push(parse_expr(p, 0)?)
                    if p.peek().kind == .comma: p.advance()
                    else if p.peek().kind != .rparen: return Error("expected ',' or ')' in call", p.peek().pos)
                p.advance()
                return Expr.call(t.text, args, t.pos)
            Expr.var(t.text, t.pos)
        .eof: Error("unexpected end of input", t.pos)
        _: Error("unexpected '{t.text}'", t.pos)

parse = (src: str) -> Expr | Error:
    toks = tokenize(src)?
    p = Parser(toks)
    e = parse_expr(p, 0)?
    t = p.peek()
    if t.kind != .eof: return Error("unexpected '{t.text}' after expression", t.pos)
    e

# ---- values and evaluation ----

struct Closure:
    params: str[]
    body: Expr[]     # one element
    env: Env

struct Env:
    names: str[]
    vals: Value[]

type Value = f64 | Closure

lookup = (env: Env, name: str) -> Value?:
    loop i in [env.names.len() - 1, env.names.len() - 2..0]:
        if env.names[i] == name: return env.vals[i]
    none

bind = (env: Env, name: str, v: Value) -> Env:
    e = env
    e.names.push(name)
    e.vals.push(v)
    e

num_of = (v: Value, pos: int) -> f64 | Error:
    if v is f64: return v
    Error("expected a number, got a function", pos)

eval = (e: Expr, env: Env) -> Value | Error:
    match e:
        .num(v, _): v
        .var(name, pos):
            if let v = lookup(env, name): return v
            Error("unknown variable '{name}'", pos)
        .unary(op, kids, pos):
            -num_of(eval(kids[0], env)?, pos)?
        .binary(op, kids, pos):
            x = num_of(eval(kids[0], env)?, pos)?
            y = num_of(eval(kids[1], env)?, pos)?
            r: Value | Error = match op:
                "+": x + y
                "-": x - y
                "*": x * y
                "/":
                    if y == 0.0: return Error("division by zero", pos)
                    x / y
                "^": x ^ y
                "==": if x == y: 1.0 else: 0.0
                "<": if x < y: 1.0 else: 0.0
                ">": if x > y: 1.0 else: 0.0
                "<=": if x <= y: 1.0 else: 0.0
                ">=": if x >= y: 1.0 else: 0.0
                _: Error("unknown operator {op}", pos)
            r
        .let_in(name, kids, pos):
            eval(kids[1], bind(env, name, eval(kids[0], env)?))
        .lambda(params, kids, pos):
            Closure(params, kids, env)
        .call(name, args, pos):
            if name == "if":
                if args.len() != 3: return Error("if takes 3 arguments", pos)
                c = num_of(eval(args[0], env)?, pos)?
                return eval(if c != 0.0: args[1] else: args[2], env)
            vals: Value[]
            loop a in args:
                vals.push(eval(a, env)?)
            if name == "if":
                if vals.len() != 3: return Error("if takes 3 arguments", pos)
                c = num_of(vals[0], pos)?
                return if c != 0.0: vals[1] else: vals[2]
            if let b = builtin_call(name, vals, pos): return b
            f = lookup(env, name)
            if f == none: return Error("unknown function '{name}'", pos)
            fv = f!
            if fv is f64: return Error("'{name}' is a number, not a function", pos)
            if fv.params.len() != vals.len():
                return Error("'{name}' takes {fv.params.len()} arguments, got {vals.len()}", pos)
            inner = fv.env
            inner = bind(inner, name, fv)     # allow recursion by name
            loop i in 0.. and pn in fv.params: inner = bind(inner, pn, vals[i])
            eval(fv.body[0], inner)

builtin_call = (name: str, vals: Value[], pos: int) -> (Value | Error)?:
    one = (f: (f64) -> f64) -> Value | Error:
        if vals.len() != 1: return Error("{name} takes 1 argument", pos)
        f(num_of(vals[0], pos)?)
    match name:
        "sin": one((x): sin(x))
        "cos": one((x): cos(x))
        "sqrt": one((x): sqrt(x))
        "abs": one((x): abs(x))
        _: none

# ---- error display ----

line_col = (src: str, pos: int) -> (int, int):
    line = 1
    col = 1
    loop i in [0..min(pos, len(src))):
        if src[i] == '\n':
            line += 1
            col = 1
        else: col += 1
    (line, col)

report = (src: str, err: Error) -> str:
    lc = line_col(src, err.pos)
    lines = split(src, "\n")
    text = lines[lc.0 - 1]
    "{lc.0}:{lc.1}: error: {err.msg}\n    {text}\n    {" " * (lc.1 - 1)}^"

run = (src: str) -> str:
    e = parse(src)
    if e is Error: return report(src, e)
    v = eval(e, Env())
    if v is Error: return report(src, v)
    if v is Closure: return "<function>"
    "{v}"

loop src in ["1 + 2 * 3", "(1 + 2) * 3", "2 ^ 3 ^ 2", "-2 ^ 2", "10 / 4", "let x = 5 in x * x",
        "let sq = fn(x) x * x in sq(7)", "let fact = fn(n) if(n < 1, 1, n * fact(n - 1)) in fact(5)",
        "sqrt(16) + abs(-2)", "let k = 3 in let add = fn(x) x + k in let k = 100 in add(1)",
        "1 + * 2", "1 / 0", "foo + 1", "1 $ 2", "(1 + 2", "let = 3", "fn(x x", "sqrt(1, 2)", "let f = 2 in f(1)"]:
    print(run(src))
