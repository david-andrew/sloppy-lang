# requires: native
# requires: sloppy
# two menus in one frame (an empty one, then another): the second takes the keys too
# env: SLOPPY_SCREENSHOT=$TMP/menus.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=30
# env: SLOPPY_INPUT=10:down+,11:down-,20:enter+,21:enter-
choice = 0
draw = ():
    global choice
    clear()
    ui_begin("first", vec2(640, 100))
    ui_end()
    ui_begin("second", vec2(640, 200))
    if ui_button("One"): choice = 1
    if ui_button("Two"): choice = 2
    ui_end()
    if frame_number() == 29: print("chose {choice}")
