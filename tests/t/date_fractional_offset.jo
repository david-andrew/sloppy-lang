# A negative fractional epoch uses floor, including at a timezone transition.
t = unix_time(Date(2026, 3, 8, 7, 0, 0))
print(utc_offset(t - 0.5) == utc_offset(t - 1), utc_offset(t - 0.5) != utc_offset(t))
print(utc_offset(-0.5) == date(-0.5).offset)
d = parse_date("2026-11-12T12:34:56+0530")!
print(parse_date(date_text(d, "%Y-%m-%dT%H:%M:%S%z")) == d)
import http
print(http.parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT"), http.parse_http_date("bad"))
