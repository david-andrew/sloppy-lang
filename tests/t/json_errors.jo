# requires: sloppy
# from_json's errors in JSON's words: what was expected, what was found, the field's path, and
# where (line:column)
enum Mode: easy, hard
struct Todo:
    id = 0
    title = ""
    done = false
struct TodoIn:
    title: str? = none
    done: bool? = none
struct Board:
    items: Todo[] = []
    tags: {str: int} = {}
    pair: (int, str) = (0, "")
    mode = Mode.easy
    pos = vec2(0.0, 0.0)
    small: i32 = 0
    u: u64 = 0
    any: int | str = 0
    f = 0.0
    fixed: int[2] = [0, 0]
    sub: Todo? = none
struct Pair[T]:
    a: T
    b: T

show[T] = (s: str, r: T | TextError):
    if r is TextError: print("{s}  ->  {r.message} @{r.line}:{r.column} [{r.path}]")
    else: print("{s}  ->  ok {r}")

# objects: their start, end, commas, field names
loop s in [r'{"title":"a"', r'[1,2]', "", "  ", "null", "not json", r'"hi"', "5", "true", "<html><body>", r'{', r'{"title":"a" "id":1}', r'{"title":"a"]', r'{"title" "a"}', r'{"title":"a",}', r'{title: "a"}', r'{"title":"a"} x', "\{\n  \"id\": 1,\n  \"title\": \"a\"\n  \"done\": true\n}"]:
    show(s, from_json[Todo](s))
# the text ending before a value; unknown fields are skipped, but need a value
loop s in [r'{"title":', r'{"id": ', r'{"x":', r'{"x": , "id": 1}', r'{"x": [1, {"y": 2}], "id": 1}', r'{"title":"abc']:
    show(s, from_json[Todo](s))
# wrong types for fields, and numbers out of range
loop s in [r'{"id":99999999999999999999}', r'{"id":-99999999999999999999}', r'{"title":5}', r'{"title":null}', r'{"id":1.5}', r'{"id":"abc"}', r'{"id":true}', r'{"done":"yes"}', r'{"done":1}']:
    show(s, from_json[Todo](s))
loop s in [r'{"title":5}', r'{"title":null, "done":true}', r'[]']:
    show(s, from_json[TodoIn](s))
# lists, maps, tuples, enums, vectors, unions, fixed-size arrays, nested structs
loop s in [r'{"items":[{"title":"a"},[1]]}', r'{"items":[{"title":"a"}', r'{"items":[{"title":"a"} {"id":2}]}', r'{"items":[{"title":"a"},]}', r'{"items":{}}', r'{"items":[', r'{"items":[{"title":', r'{"tags":{"a":"x"}}', r'{"tags":{"a" 1}}', r'{"tags":{"a":1', r'{"tags":[]}', r'{"tags":{5:1}}', r'{"pair":[1]}', r'{"pair":[1,"a",3]}', r'{"pair":{}}', r'{"pair":5}', r'{"mode":"medium"}', r'{"mode":5}', r'{"pos":5}', r'{"pos":[1]}', r'{"small":3000000000}', r'{"small":-3000000000}', r'{"u":-1}', r'{"u":99999999999999999999}', r'{"any":[1]}', r'{"f":"x"}', r'{"f":[1]}', r'{"fixed":[1]}', r'{"fixed":[1,2,3]}', r'{"sub":[1]}', r'{"sub":{"id":"a"}}']:
    show(s, from_json[Board](s))
show(r'[1,2', from_json[int[]](r'[1,2'))
show(r'[1 2]', from_json[int[]](r'[1 2]'))
show(r'{}', from_json[int[]](r'{}'))
show(r'[]', from_json[str](r'[]'))
show("", from_json[int](""))
show(r'[1]', from_json[Pair[int]](r'[1]'))
# and what reads still reads
show(r'{"items": [{"id": 1, "title": "a", "done": true}], "tags": {"x": 1}, "pair": [2, "b"], "mode": "hard", "pos": [1, 2], "u": 18446744073709551615, "any": "s", "fixed": [3, 4], "sub": null, "extra": {"a": [1, "]"]}}', from_json[Board](r'{"items": [{"id": 1, "title": "a", "done": true}], "tags": {"x": 1}, "pair": [2, "b"], "mode": "hard", "pos": [1, 2], "u": 18446744073709551615, "any": "s", "fixed": [3, 4], "sub": null, "extra": {"a": [1, "]"]}}'))
# from_text's own messages stay its own
show("Todo(id=1", from_text[Todo]("Todo(id=1"))
show("[1, x]", from_text[int[]]("[1, x]"))
