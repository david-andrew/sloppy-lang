# requires: sloppy
__audio_state = 2
m = load_music(embed("data/sweep.ogg")).unwrap()
s = Sound([f32(0), 0])
a = play(s, 0.4, -0.5, looping = true)
b = play_music(m, 0.4, -0.5, looping = true)
print(__voices[0].volume == __voices[1].volume, __voices[0].pan == __voices[1].pan)
