# requires: sloppy
# no warnings
# env: SLOPPY_NO_AUDIO=1
# Keep the mixer under this test's control, without opening a sound device.
manual_audio = ():
    global __audio_state
    __audio_state = 2
manual_audio()
assert(__audio_state == 2)
m = load_music(embed("data/sweep.ogg")).unwrap()
s = Sound([f32(0), 0])
a = play(s, 0.4, -0.5, looping = true)
b = play_music(m, 0.4, -0.5, looping = true)
print(__voices[0].volume == __voices[1].volume, __voices[0].pan == __voices[1].pan)
print(__voices[0].looping, __voices[1].looping)
stop_all()
a = play(s)
b = play_music(m)
print(__voices[0].looping, __voices[1].looping)
c = crossfade(b, m, looping = false)
print(__voices[2].looping)
