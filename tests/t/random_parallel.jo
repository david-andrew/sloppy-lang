# requires: sloppy
# random() in parallel code: each worker its own generator (it raced on one, giving numbers
# that were not random); an estimate of pi from many threads is close
seed_random(123)
count_hits = (k: int) -> int:
    hits = 0
    loop i in [0..200000):
        x = random()
        y = random()
        if x * x + y * y < 1.0: hits += 1
    hits
est = 4.0 * f64(sum(parallel_range(32, count_hits))) / f64(32 * 200000)
print(abs(est - PI) < 0.005)
