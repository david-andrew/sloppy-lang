# requires: sloppy
# requires: native
p = join_path(temp_dir(), "sloppy_checked_reads")
make_dirs(p)
a = read_file(p + "/missing")
b = read_file(p)
ls = list_dir(p + "/missing")
print(a is FileError, b is FileError, ls is FileError)
if a is FileError: print(a.path == p + "/missing", a.operation, a.message)
if b is FileError: print(b.operation, b.message)
print(list_dir(p).unwrap())
# A successful listing does not erase the last writer/open error, and carries no stale read error.
assert(not write_file(p + "/missing/child", "x"))
why = file_error()
assert(list_dir(p).unwrap().len() == 0)
assert(file_error() == why)
assert(write_file(p + "/bom", "\xEF\xBB\xBFhello"))
print(read_file(p + "/bom").unwrap(), read_bytes(p + "/bom").unwrap().first(3))
f = open_file(p + "/bom")!
print(f.read_bytes(99).unwrap().len(), f.read_bytes(1).unwrap())
r = f.read_line()
print(r == none)
f.close()
delete_file(p + "/bom")
delete_dir(p)
