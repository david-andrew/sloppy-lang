# requires: sloppy
# requires: native
# env: SLOPPY_NO_DRAW=1
# Test the actual starter's deterministic tick and player counts without contacting a server.
use '../../lib/new/room.jo'
loop n in [2..5):
    g = new_game(n)
    assert(g.players.len() == n)
    pads = fill(Pad(1, -1), n)
    first = tick(g, pads)
    assert(first == tick(g, pads))
    assert(first.players[0].pos == g.players[0].pos + vec2(5, -5))
    loop _ in [0..400): g = tick(g, pads)
    loop p in g.players: assert(p.pos == vec2(1256, 100))
g = new_game(4)
g.players[0].pos = g.coin
g.players[0].score = WIN - 1
g = tick(g, fill(Pad(), 4))
assert(g.winner == 0 and g.players[0].score == WIN and g.taken == 1)
assert(tick(g, fill(Pad(-1, 1), 4)) == g)
print("room starter: 2-4 players, movement, bounds, coins and winning")
exit(0)
