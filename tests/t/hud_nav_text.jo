# requires: native
# requires: sloppy
# hud_nav and a text field: Enter or A gives it the keyboard (its text selected, as tab does); while
# typing, the arrow keys move the caret, not the focus, and Enter submits without choosing it again;
# the d-pad leaves it, taking the keyboard away
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=34
# env: SLOPPY_INPUT=3:enter+ 4:enter- 5:text=Bo 7:left+ 8:left- 9:text=x 11:enter+ 12:enter- 14:down+ 15:down- 17:enter+ 18:enter- 20:up+ 21:up- 23:pad_a+ 24:pad_a- 26:text=! 27:pad_down+ 28:pad_down- 30:text=z
window("hud nav text", 1280, 720)
name = "Ann"
draw = ():
    global name
    clear(rgb(0.1, 0.12, 0.16))
    hud_nav(true)
    n = hud_text_field(Rect(480, 160, 320, 40), name, id = "name")
    if n != name: print("{frame_number()}: name {n}")
    name = n
    if hud_submitted(): print("{frame_number()}: submitted {name}")
    if hud_button(Rect(480, 220, 320, 44), "OK"): print("{frame_number()}: OK")
    if frame_number() == 6 or frame_number() == 13 or frame_number() == 25 or frame_number() == 29: print("{frame_number()}: typing {hud_focused("name")}")
