# requires: native
# requires: sloppy
# ui_text_field: typed text goes into the field with the focus (letters are not menu keys there),
# backspace takes a whole character away, up to max_chars; down moves on to the next item; the
# pointer resting on an item when the menu opens does not take the focus
# env: SLOPPY_SCREENSHOT=$TMP/ui_text_field.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=45
# env: SLOPPY_INPUT=0:mouse=640x290,5:text=Ada Lovelace,8:backspace+,9:backspace-,12:text=sw,15:down+,16:down-,20:text=sé,22:backspace+,23:backspace-
name = ""
team = "red"
volume = 0.5
draw = ():
    clear(rgb(0.1, 0.1, 0.15))
    ui_begin("setup", vec2(640, 200))
    name = ui_text_field("Name", name, 12)
    team = ui_text_field("Team", team)
    volume = ui_slider("Volume", volume)
    ui_end()
    if frame_number() == 40: print(name, team, volume, without_last_char("aé"), without_last_char(""))
