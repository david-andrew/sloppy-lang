# requires: sloppy
# a sensor keeps a body that falls asleep in it (and does not wake it); overlaps: what a character
# walks into, a sphere and a box; a character carried by a platform that slides and one that lifts
import physics3d

sensor_sleep = ():
    w = physics3d.World()
    w.add_box(vec3(0, -0.5, 0), vec3(20, 1, 20), kind = .fixed)
    zone = w.add_box(vec3(0, 1, 0), vec3(2, 2, 2), kind = .fixed, sensor = true)
    ball = w.add_sphere(vec3(0, 5, 0), 0.3)
    loop i in [0..200): w.step(1.0 / 60.0)
    print("in the zone: {w.contacts(zone).len()}, asleep: {w.sleeping(ball)}")

walk_through = ():
    w = physics3d.World()
    w.add_box(vec3(0, -0.5, 0), vec3(20, 1, 20), kind = .fixed)
    zone = w.add_box(vec3(0, 1, 0), vec3(2, 2, 2), kind = .fixed, sensor = true)
    coin = w.add_sphere(vec3(4, 0.5, 0), 0.3, kind = .fixed, sensor = true)
    hero = w.character(vec3(-5, 0, 0))
    seen = ""
    loop i in [0..300):
        w.walk(hero, vec3(3, 0, 0), 1.0 / 60.0)
        w.step(1.0 / 60.0)
        now = ""
        loop b in w.overlaps(hero):
            if b == zone: now += "zone "
            if b == coin: now += "coin "
        if now != seen:
            print("{hero.feet.x:.1}: {now}")
            seen = now
    print(w.overlap_sphere(vec3(0, 1, 0), 0.5).len(), w.overlap_box(vec3(4, 0.5, 0), vec3(1, 1, 1)).len(), w.overlap_sphere(vec3(0, 10, 0), 1).len())

platforms = ():
    w = physics3d.World()
    w.add_box(vec3(0, -0.5, 0), vec3(40, 1, 40), kind = .fixed)
    lift = w.add_box(vec3(0, 0.25, 0), vec3(3, 0.5, 3), kind = .moving)
    hero = w.character(vec3(0, 0.6, 0))
    dt = 1.0 / 60.0
    loop i in [0..120):
        w.set_velocity(lift, vec3(2, 0, 0))
        w.walk(hero, vec3(0, 0, 0), dt)
        w.step(dt)
    print("slid: lift x {w.pos(lift).x:.2}, hero x {hero.feet.x:.2}, on the ground {hero.on_ground}")
    up = w.add_box(vec3(-10, 0.25, 0), vec3(3, 0.5, 3), kind = .moving)
    h2 = w.character(vec3(-10, 0.6, 0))
    loop i in [0..120):
        w.set_velocity(up, vec3(0, 1, 0))
        w.walk(h2, vec3(0, 0, 0), dt)
        w.step(dt)
    print("lifted: top {w.pos(up).y + 0.25:.2}, hero {h2.feet.y:.2}")

sensor_sleep()
walk_through()
platforms()
# a mass given instead of the density's; contacts forget a body removed after the step
w4 = physics3d.World()
w4.add_box(vec3(0, -0.5, 0), vec3(10, 1, 10), kind = .fixed)
rball = w4.add_sphere(vec3(0, 2, 0), 0.5)
rgem = w4.add_box(vec3(0, 0.5, 0), vec3(2, 2, 2), sensor = true, kind = .fixed)
w4.set_tag(rgem, 7)
loop _ in [0..30): w4.step(1.0 / 60.0)
print(w4.contacts(rball).len())
loop ct in w4.contacts(rball):
    if w4.tag(ct.b) == 7: w4.remove(ct.b)
print(w4.contacts(rball).len())
loop ct in w4.contacts(rball): print(w4.tag(ct.b))
mb = w4.add_sphere(vec3(5, 2, 0), 0.5, mass = 1)
print("{w4.mass(mb):.2} {w4.mass(rball):.1}")
w4.set_mass(rball, 2)
print("{w4.mass(rball):.2}")
