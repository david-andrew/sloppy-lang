# requires: native
# requires: sloppy
# hud_text_field edits as a desktop's text boxes do: hud_focus selects its text, typing replaces a
# selection, ctrl+Z undoes, a double click selects a word, ctrl+right moves by a word, ctrl+backspace
# takes a word away, delete the character after the caret, shift+end selects, ctrl+X and ctrl+V cut
# and paste, tab and shift+tab go between fields, escape lets go, enter is hud_submitted()
# env: SLOPPY_SCREENSHOT=$TMP/hud_text_edit.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=70
# env: SLOPPY_INPUT=3:text=Hi 5:ctrl+ 6:z+ 7:z- 8:ctrl- 10:mouse=101x38 11:mouse_left+ 12:mouse_left- 13:mouse_left+ 14:mouse_left- 15:text=there 17:home+ 18:home- 19:ctrl+ 20:right+ 21:right- 22:ctrl- 23:text=X 24:end+ 25:end- 26:ctrl+ 27:backspace+ 28:backspace- 29:ctrl- 30:backspace+ 31:backspace- 32:home+ 33:home- 34:delete+ 35:delete- 36:shift+ 37:end+ 38:end- 39:shift- 40:ctrl+ 41:x+ 42:x- 43:ctrl- 44:ctrl+ 45:v+ 46:v- 47:v+ 48:v- 49:ctrl- 50:tab+ 51:tab- 52:text=abc 53:shift+ 54:tab+ 55:tab- 56:shift- 57:escape+ 58:escape- 60:mouse=200x88 61:mouse_left+ 62:mouse_left- 63:enter+ 64:enter-
a = "hello world"
b = ""
last = ""
draw = ():
    global a, b, last
    clear(rgb(0.15, 0.15, 0.2))
    if frame_number() == 1: hud_focus("a")
    a = hud_text_field(Rect(20, 20, 300, 36), a, id = "a")
    if hud_submitted(): print("{frame_number()}: a submitted")
    b = hud_text_field(Rect(20, 70, 300, 36), b, id = "b", hint = "second")
    if hud_submitted(): print("{frame_number()}: b submitted")
    s = "a '{a}' b '{b}' focus a {hud_focused("a")} b {hud_focused("b")}"
    if s != last: print("{frame_number()}: {s}")
    last = s
