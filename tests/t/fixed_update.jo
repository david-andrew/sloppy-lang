# requires: native
# requires: sloppy
# fixed_update: steps at a fixed rate whatever the frames' (here 1/60 s each): at 25 a second
# some frames have none, at 150 some have three. A press is seen in one step only, the first
# after it, even one pressed in a frame with no step; outside the steps, in the frame it came.
# env: SLOPPY_SCREENSHOT=$TMP/fixed_update.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=20
# env: SLOPPY_INPUT=3:space+,5:space-,14:space+,15:space-,16:z+
action("Jump", [.key(.space)])
n = 0
rate = 25.0
step = (dt: f64):
    n += 1
    f = frame_number()
    if action_pressed("Jump"): print("frame {f}, step {n}: pressed (dt {dt:.4})")
    if key_released(.space): print("frame {f}, step {n}: released")
    if key_pressed(.z): print("frame {f}, step {n}: z")
update = (dt: f64):
    global rate
    f = frame_number()
    if f == 12: rate = 150.0
    before = n
    k = fixed_update(dt, step, rate)
    if key_pressed(.space): print("frame {f}: pressed (outside the steps)")
    if f == 2 or f == 13 or f == 19: print("frame {f}: {n - before} steps, {k:.2} into the next")
draw = (): clear(BLACK)
