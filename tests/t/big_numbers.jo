# requires: sloppy
# numbers past 1e308 (lib/big.jo): arithmetic, comparison, display, and saving
use big
dust = big(0)
rate = big(1.5, 120)
loop i in [0..10): dust += rate * 2.0
print(dust, rate, big(1234567), big(5), big(0))
cost = big(10)
loop i in [0..3000): cost = cost * 1.15
print(cost, log10(cost), cost > dust, cost < dust, max(cost, dust), [big(3), big(1)].sorted())
print(pow(big(2), 4000.0), big(1, 400) - big(1, 400), big(7) / big(2), -big(3))
print("{dust}", to_text(dust), from_text[Big](to_text(dust)))
s = big(1, 50) + big(1, 10)
print(s, to_f64(big(3, 5)), big(1, 400) == big(1, 400))
n = 3
print(big(n), big(n) * 2.0 >= big(6), big(5) < 7.0)
