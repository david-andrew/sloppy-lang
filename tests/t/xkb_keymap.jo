# requires: native
# requires: sloppy
# Wayland's keymap read: what each key types on the keyboard's own layout (French here):
# shift, caps lock on letters, AltGr, keysym names and U+ code points, aliases skipped
KM = r"""
xkb_keymap {
xkb_keycodes "evdev+aliases(azerty)" {
	<AE01>               = 10;
	<AE02>               = 11;
	<AD01>               = 24;
	<AD11>               = 34;
	<AC01>               = 38;
	alias <LatQ>         = <AC01>;
};
xkb_symbols "pc+fr+inet(evdev)" {
	key <AE01>               {	[       ampersand,               1,     onesuperior,      exclamdown ] };
	key <AE02>               {	[          eacute,               2,      asciitilde,       U20AC ] };
	key <AD01>               {	[               a,               A,              ae,              AE ] };
	key <AD11>               {	[ dead_circumflex,  dead_diaeresis ] };
	key <AC01>               {
		type= "FOUR_LEVEL_SEMIALPHABETIC",
		symbols[1]= [               q,               Q,              at,     Udiaeresis ]
	};
};
};
"""
when TARGET == "linux":
    __wl_read_keymap(KM)
    out = ""
    loop shift in [false, true]:
        loop altgr in [false, true]:
            __wl_shift = shift
            __wl_altgr = altgr
            loop code in [2, 3, 16, 26, 30]:
                c = __wl_km_char(code)
                if c > 0: out += chr(c)
                else: out += "_"
            out += " "
    __wl_shift = false
    __wl_altgr = false
    __wl_caps = true
    out += chr(__wl_km_char(16)) + chr(__wl_km_char(2))
    print(out)
else:
    print("&éa_q ¹~æ_@ 12A_Q ¡€Æ_Ü A&")
