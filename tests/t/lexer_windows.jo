# requires: sloppy
# A bounded lexer call must leave its EOF at the supplied boundary, including when
# the underlying source continues with more horizontal whitespace or a comment.
use '../../compiler/lex.jo'
use '../../compiler/util.jo'

assert_window = (source: str, limit: int):
    global files, lx_lazy
    files = [SrcFile("window.jo", "", source)]
    loop lazy in [false, true]:
        lx_lazy = lazy
        tokens = lex(0, source, 0, limit)
        last = tokens[tokens.len() - 1]
        assert(last.kind == Tok.eof)
        assert(int(last.start) == limit and last.pos == limit)

loop boundary in [6..12):
    assert_window("x = 1        # outside the window", boundary)
assert_window("x = 1 \t\r     # outside the window", 8)
assert_window("x = 1 # no final newline", 23)
print("bounded lexer windows ok")
