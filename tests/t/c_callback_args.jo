# A @cabi function called through a C function pointer with more than four arguments (on
# Windows, the fifth and later come on the stack), ints and floats mixed
# requires: sloppy
# requires: native
@cabi
calc = (a: f64, b: i32, c: f32, d: int, e: f64) -> f64:
    print(a, b, c, d, e)
    a + f64(b) + f64(c) + f64(d) + e
@cabi
six = (a: int, b: int, c: f64, d: int, e: int, f: int) -> int:
    print(a, b, c, d, e, f)
    a + b + d + e + f
main = ():
    cb: cfn(f64, i32, f32, int, f64) -> f64 = calc
    print(cb(1.5, i32(2), f32(3.5), 4, 5.5))
    s: cfn(int, int, f64, int, int, int) -> int = six
    print(s(1, 2, 0.5, 4, 5, 6))
    # (given straight to a function taking a C function pointer)
    print(call_with(six))

call_with = (f: cfn(int, int, f64, int, int, int) -> int) -> int: f(10, 20, 0.0, 1, 2, 3)
