# requires: sloppy
# arms of several patterns: .num(_) names nothing, and variants naming alike fields share their names
enum E:
    num(v: f64)
    var(n: str)
    zero
    add(a: E, b: E)
    mul(a: E, b: E)
size = (e: E) -> int:
    match e:
        .num(_), .var(_), .zero: 1
        .add(a, b), .mul(a, b): 1 + size(a) + size(b)
print(size(E.mul(E.add(E.num(1.0), E.var("x")), E.zero)))
