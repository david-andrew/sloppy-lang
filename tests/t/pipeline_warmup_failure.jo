# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_failure.png
# env: SLOPPY_FRAMES=5
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
# A driver error during optional preparation must be reported without terminating startup.
# No null pipeline enters the cache; the first real draw retries and succeeds.
window("Warm-up failure", 160, 90)
prog = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        prog = __vk_program(shader(lit_vs_inst, lit_fs), 8)
        assert(__vgp[prog].vs == 0)
        ok = __vg_try_warm(prog, (): __vk_check(-13, "injected unsupported warm-up pipeline"))
        assert(not ok and __vk_warm_jmp == null)
        assert(__vgp[prog].vs == 0 and __vgp[prog].pipelines.len() == 0)
box = cube_mesh()
loaded = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        assert(__vgp[prog].vs == 0)
        loaded = __vg_pipeline_creations
update = (dt: f64):
    when TARGET != "wasm" and TARGET != "macos":
        if __vk and frame_number() > 0: assert(__vg_pipeline_creations == loaded + 1)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    draw_mesh_instanced(box, [Instance3D(mat4(), WHITE)], cast_shadow = false)
on_quit = ():
    when TARGET != "wasm" and TARGET != "macos":
        if __vk: assert(__vgp[prog].vs != 0 and __vgp[prog].pipelines.len() == 1)
    print("warm-up failure retried on draw")
