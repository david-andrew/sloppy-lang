# requires: sloppy
# requires: native
# the program's own insert/len (an array or string first) are its, not the built-in ones; push on
# a struct of its own; a str passed to C is a char * (the empty one too); printf's output reaches a pipe
insert = (xs: mut int[], x: int):
    i = 0
    loop i < xs.len() and xs[i] < x: i += 1
    xs.insert(i, x)
xs: int[]
xs.insert(5)
xs.insert(2)
xs.insert(9)
print(xs, xs.len())
len = (s: str, unit: int) -> int: s.len() * unit
print(len("abc", 2), "abc".len())
struct Stack:
    items: int[]
push = (s: mut Stack, x: int): s.items.push(x)
st = Stack([])
st.push(4)
ys = [1]
ys.push(2)
print(st, ys)
when TARGET == "windows":
    @lib("msvcrt.dll")
    extern strlen = (s: str) -> int
else:
    @lib("libc.so.6")
    extern strlen = (s: str) -> int
    @lib("libc.so.6")
    @variadic(1)
    extern printf = (fmt: str, x: int) -> i32
print(strlen("hello"), strlen(""))
# (C's stdio, written out at the end: Linux and macOS)
when TARGET == "windows":
    print("from printf 42")
else:
    printf("from printf %d\n", 42)
