# requires: sloppy
# requires: native
# A panic in a group's task ends that task only (told on standard error), cancels the group's
# others, and the group's wait() gives false, why() the panic's message; the program goes on
main = ():
    g = task_group()
    ok = g.spawn(():
        sleep(5.0)
        "slept, cancelled: {cancelled()}"
    )
    bad = g.spawn(() -> str:
        sleep(0.01)
        panic("something broke")
    )
    print(g.wait(), g.why())
    print(ok.wait(), bad.done(), bad.wait(wait = 0.0))
    h = task_group()
    t = h.spawn((): 6 * 7)
    print(h.wait(), h.why() == "", t.wait())
