# requires: sloppy
# requires: native
# requires: sqlite
# lib/sqlite.jo: a table made, rows inserted with values for the ?s (text that looks like SQL is
# only text), a transaction, rows read into a struct (a BOOL column a bool), and its errors
import sqlite

struct Booking:
    id = 0
    name = ""
    spots = 0
    paid = false
    note = ""

main = ():
    db = unwrap(sqlite.open(":memory:"))
    if let e = db.exec("CREATE TABLE bookings (id INTEGER PRIMARY KEY, name TEXT NOT NULL, spots INT, paid BOOL)"): panic(e.message)
    r = unwrap(db.run("INSERT INTO bookings (name, spots, paid) VALUES (?, ?, ?)", ["ann", 3, true]))
    print(r)
    unwrap(db.run("INSERT INTO bookings (name, spots, paid) VALUES (?, ?, ?)", ["x'); DROP TABLE bookings; --", 1, false]))
    _ = db.begin()
    loop i in 0..1000: unwrap(db.run("INSERT INTO bookings (name, spots, paid) VALUES (?, ?, ?)", ["n{i}", i % 5, i % 2 == 0]))
    _ = db.commit()
    bs = unwrap(db.query[Booking]("SELECT * FROM bookings WHERE spots > ? ORDER BY id LIMIT 3", [2]))
    loop b in bs: print(b)
    print(db.value("SELECT count(*) FROM bookings").as_int() ?? 0)
    print(unwrap(db.query_json("SELECT name, spots FROM bookings WHERE id <= ?", [2])))
    bad = db.run("INSERT INTO bookings (name) VALUES (?)", [none])
    if bad is sqlite.SqlError: print("error {bad.code}: {bad.message}")
    wrong = db.run("INSERT INTO bookings (name) VALUES (?)", ["a", "b"])
    if wrong is sqlite.SqlError: print(wrong.message)
    nosuch = db.query_json("SELECT * FROM nope")
    if nosuch is sqlite.SqlError: print(nosuch.message)
