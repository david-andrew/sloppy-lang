# reverse keeps characters whole; to_int is none for what does not fit in an int
# requires: sloppy
print(reverse("héllo wörld 😀!"), bytes(reverse("é")), reverse(""), reverse("a"))
print(to_int("9223372036854775807"), to_int("9223372036854775808"))
print(to_int("-9223372036854775808"), to_int("-9223372036854775809"))
print(to_int("18446744073709551616"), to_int("0x7fffffffffffffff"), to_int("0x8000000000000000"))
print(to_int("-42"), to_int("1_000"), to_int("0x1F"), to_int(""), to_int("-"), to_int("12a"))
# upper/lower: eight ASCII bytes at a time, two-byte letters, longer characters and stray bytes kept
print(upper("@AZ[`az{{ hello world, HELLO WORLD! 0123456789"), lower("@AZ[`az{{ HELLO WORLD, hello world! 0123456789"))
print(upper("Straße ÿ àéîõü ÷ αβγ ς абв ѐџ ĳ ĺ ž 日本 😀 abcdefghijklmnop"), lower("ŸÀÉÎÕÜ × ΑΒΓ АБВ ЀЏ Ĳ Ĺ Ž 日本 😀 ABCDEFGHIJKLMNOP"))
print(bytes(lower("A\xC3\x80\x80\xC3Z\xFF")), bytes(upper("é\xE9a")))
