# requires: sloppy
# (an element passed as `mut` that a function value the call runs changes too: one write would be lost)
struct E:
    name: str
    hp: int
es = [E("a", 10), E("b", 20)]
hit = (e: mut E, f: () -> void):
    e.hp -= 1
    f()
    e.hp -= 1
hit(es[0], (): es[1].hp = 5)
print(es)
k = (): es[0].hp = 99
hit(es[0], k)
