# requires: sloppy
# requires: unix
# ctrl-c in a program with tasks: the sleep of a task that looks at stopping() ends at once, and a
# select's stopping() arm is taken. A task that never looks keeps the program going after main has
# ended: it is told, after a second, with where it waits, and a second signal (here SIGTERM after
# SIGINT) ends the program
main = ():
    stopping()                  # (from here on, ctrl-c asks; it does not end the program)
    watcher = spawn(():
        t0 = time()
        loop not stopping(): sleep(10.0)
        time() - t0 < 2.0
    )
    selector = spawn(():
        jobs = channel[int]()
        what = ""
        select:
            jobs.receive() as j: what = "job {j}"
            stopping(): what = "asked to stop"
            after 10.0: what = "nothing in 10 s"
        what
    )
    sleep(0.05)
    t0 = time()
    run_shell("kill -INT $PPID")
    loop not stopping(): sleep(10.0)
    print("main noticed at once:", time() - t0 < 2.0)
    print("the watcher too:", watcher.wait())
    print("the select:", selector.wait())
    spawn(():
        loop: sleep(10.0)
    )
    run_shell("(sleep 2.5; kill -TERM $PPID) > /dev/null 2>&1 &")
    print("main ends")
