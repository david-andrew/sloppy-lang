# Overloads a call cannot match leave the choice to the others: a literal that does not fit a
# requires: sloppy
# parameter's type, a lambda whose parameter types differ
f = (x: i8): print("i8", x)
f = (x: i16): print("i16", x)
f(300)
g = (h: (int) -> int): print("int", h(1))
g = (h: (f64) -> f64): print("f64", h(1.5))
g((x: int): x + 1)
g((x: f64): x * 2)
