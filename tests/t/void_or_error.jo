# requires: sloppy
# -> void | E: nothing, or an error; a bare return and the end give the void
error struct E:
    m: str
f = (x: int) -> void | E:
    if x == 0: return
    if x < 0: return E("neg")
    print("ok {x}")
loop x in [1 0 (-1)]:
    r = f(x)
    if r is E: print("failed: {r.m}")
    else: print("fine")
print(f(-2))
print(f(3))
_ = f(5)
