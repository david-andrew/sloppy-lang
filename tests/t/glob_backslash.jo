# requires: sloppy
# on Windows a glob pattern's \ is a /; embed takes either too
dir = "{temp_dir()}/globbs"
make_dirs("{dir}/data")
assert(write_file("{dir}/data/a.txt", "1"))
assert(write_file("{dir}/data/b.txt", "2"))
sep = "/"
when TARGET == "windows":
    sep = "\\"
print(glob("{dir}{sep}data{sep}*.txt").len())
