# requires: sloppy
# numbers in byte arrays (both orders, signed), bit counting and turning, bytes from C; map reserve
b: u8[]
append_le(b, 0x46464952, 4)
append_be(b, 0x1234, 2)
append_le(b, -2, 2)
put_le(b, 10, 4, 7)
print(b, get_le(b, 0, 4) == 0x46464952, get_be(b, 4, 2), get_le(b, 6, 2), get_le_signed(b, 6, 2), get_le(b, 10, 4), b.len())
print(popcount(0xFF), popcount(-1), leading_zeros(1), leading_zeros(0), trailing_zeros(8), trailing_zeros(0), leading_zeros(-1))
print(rotate_left(1, 63) == (1 << 63), rotate_right(1, 1) == (1 << 63), rotate_left(0x12, 4), byte_swap(0x1234, 2), byte_swap(0x11223344, 4))
f = f32(1.5)
fb: u8[]
append_le(fb, int(f32_bits(f)), 4)
print(f32_from_bits(u32(get_le(fb, 0, 4))))
print(bytes_from(data(b), 3), str_from_c(data("hello")))
m: {int: int}
m.reserve(100)
loop i in [0..100): m[i] = i * i
print(m.len(), m[9])
