# requires: sloppy
# requires: native
# A task waiting for a line of input lets the others run meanwhile
main = ():
    ticks = 0
    lines = channel[str]()
    spawn(():
        loop let l = read_line(): lines.send(l)
        lines.close()
    )
    tk = spawn(():
        loop i in 0..3:
            ticks += 1
            sleep(0.01)
    )
    loop l in lines: print("line:", l)
    tk.wait()
    print("ticks", ticks)
