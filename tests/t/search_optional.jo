# requires: sloppy
print(index_of("abc", "a"), index_of("abc", "z"))
print(index_of("abc", "", start = 3), index_of("abc", "", start = 4), index_of("abc", "", start = -1))
print(index_of("abc", 'a', start = -1), index_of("abc", 'c', start = 2), index_of("abc", 'c', start = 3))
print(last_index_of("banana", "an"), last_index_of("", ""), last_index_of("abc", "longer"))
print([1, 2, 3].find_index((x): x == 2), [1, 2, 3].find_index((x): x == 8))
r = regex("").unwrap()
print("abc".find(r, start = -1) == none, "abc".find(r, start = 4) == none, "abc".find(r, start = 3)!.start)
