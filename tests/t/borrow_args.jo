# An argument read from a global (or a variable closures share, a capture) stays alive through
# the call even when the callee or a later argument gives that variable another value
# requires: sloppy
g = [1, 2, 3]
h: () -> void = (): pass
read_after_replace = (xs: int[]):
    g = [7, 8]
    s = "overwrite {123456}"
    print(xs)
replace = () -> int:
    g = [4, 5]
    0
read_later = (xs: int[], ignored: int): print(xs)
show = (s: str):
    h = (): pass
    t = "overwrite {1234567}"
    print(s)
call = (xs: int[], f: () -> void):
    f()
    print(xs)
main = ():
    g[0] = 1
    read_after_replace(g)
    print(g)
    g = [1, 2, 3]
    g[0] = 1
    read_later(g, replace())
    print(g)
    loop x in g:
        g = [7, 8, 9, 10]
        print(x)
    msg = "hello {len(g)}"
    h = (): show(msg)
    h()
    ys = [1, 2, 3]
    call(ys, ():
        ys = [99]
    )
    print(ys)
