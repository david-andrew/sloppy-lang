# An argument read from a global (or a variable closures share, a capture) stays alive through
# the call even when the callee or a later argument gives that variable another value; so do
# operands, string parts, unwrapped values and closures read from globals
# requires: sloppy
g = [1, 2, 3]
h: () -> void = (): pass
read_after_replace = (xs: int[]):
    global g
    g = [7, 8]
    s = "overwrite {123456}"
    print(xs)
replace = () -> int:
    global g
    g = [4, 5]
    0
read_later = (xs: int[], ignored: int): print(xs)
show = (s: str):
    global h
    h = (): pass
    t = "overwrite {1234567}"
    print(s)
call = (xs: int[], f: () -> void):
    f()
    print(xs)
gs = ""
change_gs = () -> str:
    global gs
    gs = "NEW {222}"
    "!"
ga = [1, 2, 3]
change_ga = () -> int[]:
    global ga
    ga = [7, 8, 9]
    [1, 2, 3]
struct GB:
    s: str
gb = GB("box {1}")
__fmt = (b: mut u8[], x: GB):
    global gb
    gb = GB("NEW {2}")
    __fmt(b, x.s)
go: int[]? = none
drop_go = (xs: int[]):
    global go
    go = none
    junk = [loop i in [7..10): i]
    print(xs, junk)
hh: () -> void = (): pass
main = ():
    global g, go, gs, h, hh
    g[0] = 1
    read_after_replace(g)
    print(g)
    g = [1, 2, 3]
    g[0] = 1
    read_later(g, replace())
    print(g)
    loop x in g:
        g = [7, 8, 9, 10]
        print(x)
    msg = "hello {len(g)}"
    h = (): show(msg)
    h()
    ys = [1, 2, 3]
    call(ys, ():
        ys = [99]
    )
    print(ys)
    gs = "old {111}"
    print(gs + change_gs())
    ga[0] = 1
    print(ga == change_ga())
    print("{gb}")
    go = [loop i in [1..4): i]
    drop_go(go!)
    msg2 = "kept {222}"
    hh = ():
        hh = (): pass
        junk = "NEW {333}"
        print(msg2)
    hh()
