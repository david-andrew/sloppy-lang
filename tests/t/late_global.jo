# requires: sloppy
# a top-level `k = 0` runs where it is, after a function used a k of its own (`let`: a global
# declared below the function would be changed otherwise, which is an error:
# tests/errors/hint_global_below.jo)
f = () -> int:
    let k = 0
    loop k < 3: k += 1
    k
print(f())
xs: f64[] = [1.0, 2.0]
k = 0
loop k < xs.len():
    xs[k] = 9.0
    k += 1
print(xs, k)
