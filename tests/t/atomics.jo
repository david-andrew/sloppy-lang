# requires: sloppy
# Atomic: a number parallel code changes together (counts, a found flag, a maximum); copies are the same number
done = atomic()
total = sum(parallel_range(1000, (i: int) -> int:
    add(done, 1)
    i
))
print(done.get(), total)
found = atomic(-1)
parallel_range(100000, (i: int) -> int:
    if found.get() >= 0: return 0
    if i * i == 49284: found.compare_swap(-1, i)
    0
)
print(found.get())
best = atomic(0)
parallel_range(5000, (i: int) -> int:
    best.set_max((i * 7919) % 5003)
    0
)
print(best.get())
c = done
c.add(5)
print(done.get())
