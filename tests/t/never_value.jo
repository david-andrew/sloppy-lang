# requires: sloppy
# what never comes back (panic) taken as a value: "a" + panic(...), {panic(...)} in a string, a branch of if
f = (n: int) -> str:
    if n > 3: return "a" + panic("big")
    "ok"
g = (n: int) -> str:
    if n > 3: print("{panic("big")}")
    "fine"
h = (n: int) -> int:
    x = if n > 3: panic("big") else: n
    x
print(f(2), g(1), h(2))
