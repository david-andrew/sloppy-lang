# requires: sloppy
# Debug helper specialization: ordered f32 arithmetic and exact comparison semantics.
struct MathCell:
    v: vec3
    sentinel: f32

show = (x: f32):
    if is_nan(f64(x)): print("nan")
    else: print(f32_bits(x))
show = (v: vec2):
    show(v.x)
    show(v.y)
show = (v: vec3):
    show(v.x)
    show(v.y)
    show(v.z)
show = (v: vec4):
    show(v.x)
    show(v.y)
    show(v.z)
    show(v.w)

@noinline
math2 = (a: vec2, b: vec2, k: f32):
    show(a + b * k)
    show(dot(a, b))
    show(length(a))
    show(length_sq(a))
    show(distance(a, b))
    show(normalize(a))
    show(cross(a, b))
    show(mix(a, b, k))
    show(mix(a, b, b))
    show(min(a, b))
    show(max(a, b))
    show(abs(a))
    show(clamp(a, b, -b))
    show(a.yx)
    show(a.x)

@noinline
math3 = (a: vec3, b: vec3, k: f32):
    show(a + b * k)
    show(dot(a, b))
    show(length(a))
    show(length_sq(a))
    show(distance(a, b))
    show(normalize(a))
    show(cross(a, b))
    show(mix(a, b, k))
    show(mix(a, b, b))
    show(min(a, b))
    show(max(a, b))
    show(abs(a))
    show(clamp(a, b, -b))
    show(clamp(a, k, -k))
    show(a.zyx)
    show(a.x)

@noinline
math4 = (a: vec4, b: vec4, k: f32):
    show(a + b * k)
    show(dot(a, b))
    show(length(a))
    show(normalize(a))
    show(mix(a, b, k))
    show(lerp(a, b, k))
    show(mix(a, b, b))
    show(min(a, b))
    show(max(a, b))
    show(abs(a))
    show(a.wzyx)
    show(a.x)

@noinline
scalar = (x: f32, lo: f32, hi: f32):
    show(min(x, lo))
    show(max(x, lo))
    show(abs(x))
    show(clamp(x, lo, hi))
    show(mix(x, lo, hi))
    show(lerp(x, lo, hi))

main = ():
    nz = f32_from_bits(0x80000000)
    inf = f32_from_bits(0x7f800000)
    nan = f32_from_bits(0xffc12345)
    print("nan bits", f32_bits(abs(nan)), f32_bits(min(f32(1), nan)), f32_bits(max(f32(1), nan)), f32_bits(clamp(nan, -1, 1)))
    scalar(nz, 0, nz)
    scalar(0, nz, 0)
    show(min(vec4(nz, 0, nan, nz), vec4(0, nz, 0, nan)))
    show(max(vec4(nz, 0, nan, nz), vec4(0, nz, 0, nan)))
    xs = [f32(0), nz, 1, -2, inf, -inf, nan, f32_from_bits(1), f32_from_bits(0x7f7fffff)]
    loop x in xs:
        math2(vec2(x, nz), vec2(-1, 2), 0.375)
        math3(vec3(x, nz, 3), vec3(-1, 2, nan), 0.375)
        math4(vec4(x, nz, 3, 4), vec4(-1, 2, nan, inf), 0.375)
        scalar(x, -1, 1)
        scalar(x, 2, -2)
        scalar(x, nan, 1)
        scalar(x, -1, nan)
    show(normalize(vec2(nz)))
    show(normalize(vec3(nz)))
    show(normalize(vec4(nz)))
    show(dot(vec4(1e20, -1e20, 3, 4), vec4(1)))
    show(dot(vec3(1e20, -1e20, 3), vec3(1)))
    # Function values use the same helper body as direct calls.
    norm: (vec3) -> vec3 = normalize
    show(norm(vec3(0, 3, 4)))
    # vec3's next word must never be read as a dot lane or overwritten by its result.
    cells = [MathCell(vec3(0, 3, 4), nan), MathCell(vec3(nz), 123)]
    loop i in [0..cells.len()): cells[i].v = normalize(cells[i].v)
    loop cell in cells:
        show(cell.v)
        show(cell.sentinel)
    packed = [vec3(1, 2, 3), vec3(4, 5, 6)]
    loop i in [0..packed.len()): packed[i] = cross(packed[i], vec3(3, 2, 1))
    loop v in packed: show(v)
    m = mat4(vec4(1, 2, 3, 0), vec4(2, 1, 0, 0), vec4(0, 0, 1, 0), vec4(3, 2, 1, 1))
    loop x in xs: show(m * vec4(x, nz, 3, 4))
    mm = m * m
    loop i in [0..4): show(mm[i])
    zeros = mat4(vec4(nz), vec4(nz), vec4(nz), vec4(nz))
    show(zeros * vec4(1))
    # Both internal pointer helpers retain their column-at-a-time behavior under aliases.
    __mat4_mul((&m) as *f32, (&m) as *f32, (&m) as *f32)
    loop i in [0..4): show(m[i])
    v = vec4(1, 2, 3, 4)
    __mat4_mul_vec4((&v) as *f32, (&m) as *f32, (&v) as *f32)
    show(v)

main()
