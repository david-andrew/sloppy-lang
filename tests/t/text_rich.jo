# requires: native
# requires: sloppy
# text_rich: [color=...], [b], [i] where they are, [[ for a bracket; wrapped to a width; chars
plain, styles = __rich_parse("a [color=#ff0000]red[/color] [b]bold [i]both[/i][/b] [[x] [nope]", WHITE)
print(plain)
print([loop s in styles: (if s.color.y < 0.5: "r" else if s.bold and s.italic: "B" else if s.bold: "b" else: ".")])
yellow = 0
h = 0.0
img = render_image(200, 80, ():
    clear(BLACK)
    h = text_rich("one [color=yellow]two three[/color] four five six", vec2(5, 5), 20, WHITE, width = 150))
loop y in [0..80):
    loop x in [0..200):
        p = img.get(x, y)
        if p.x > 0.7 and p.y > 0.6 and p.z < 0.4: yellow += 1
print(h, yellow > 20)
