# requires: native
# requires: sloppy
# under pixel_art(), lines, circles, rings, arcs and ellipses are whole pixels in exactly their
# color (a line a pixel wide is Bresenham's), text is in pixel_font() at whole-number scales,
# palette_swap draws one color as another, and pixel_image makes a picture from text
PAL = [hex(0x000000), hex(0x1d2b53), hex(0x7e2553), hex(0x008751), hex(0xab5236), hex(0x5f574f), hex(0xc2c3c7), hex(0xfff1e8),
       hex(0xff004d), hex(0xffa300), hex(0xffec27), hex(0x00e436), hex(0x29adff), hex(0x83769c), hex(0xff77a8), hex(0xffccaa)]
pixel_art()

# (each pixel as the hex digit of its color in PAL, "." for black, "?" for any other)
show = (img: Image):
    loop y in 0..img.height:
        row = ""
        loop x in 0..img.width:
            c = img.get(x, y)
            ch = "?"
            loop i in 0.. and p in PAL:
                if length(c - p) < 0.002: ch = if i == 0: "." else: "{i:x}"
            row += ch
        print(row)
    print()

show(render_image(24, 12, ():
    clear(PAL[0])
    line(vec2(1, 1), vec2(22, 5), 1, PAL[8])
    line(vec2(2, 10), vec2(5, 7), 1, PAL[9])
    circle(vec2(14, 9), 2.5, PAL[12])
    ring(vec2(20, 8), 3, 1, PAL[11])))

show(render_image(24, 10, ():
    clear(PAL[0])
    polyline([vec2(1, 1), vec2(6, 1), vec2(6, 6)], 1, PAL[10])
    arc(vec2(14, 5), 3.5, 1, 0.0, PI, PAL[14])
    ellipse(vec2(20, 5), vec2(3, 2), PAL[7])
    circle(vec2(9.3, 8.6), 0.2, PAL[6])))

# text: size 6 is 1:1 (3 x 5 letters, 4 apart), 12 twice that; lowercase as capitals
show(render_image(26, 18, ():
    clear(PAL[0])
    text("Hi 42", vec2(1, 1), 6, PAL[7])
    text("OK", vec2(1, 7), 12, PAL[10])))
print(text_width("Hi 42", 6), text_width("OK", 12), text_height("A\nB", 6))

# palette swaps: of drawing (a sprite and a shape), kept until palette_reset
dot = texture(pixel_image("
    .8.
    888
    .8.", PAL), false)
show(render_image(14, 3, ():
    clear(PAL[0])
    sprite(dot, vec2(0, 0))
    palette_swap(PAL[8], PAL[11])
    sprite(dot, vec2(4, 0))
    rect(8, 0, 2, 3, PAL[8])
    palette_reset()
    rect(11, 0, 2, 3, PAL[8])))

# particles with colors: each a solid dot, in the color its age is at
sparks = Particles(colors = [PAL[7], PAL[10], PAL[9], PAL[8]])
loop i in 0..4: sparks.items.push(Particle(vec2(f32(1.5 + f64(i) * 3.0), 1.5), vec2(0, 0), f32(0.9 - f64(i) * 0.25), 1.0, 0.5, PAL[7]))
show(render_image(13, 3, ():
    clear(PAL[0])
    sparks.draw()))
