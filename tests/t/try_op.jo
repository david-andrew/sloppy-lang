# requires: sloppy
# e?: a none or an error (an `error struct`) returned from the function; the value otherwise
error struct ParseError:
    msg: str
    line: int

error enum IoError: missing, denied

struct Item:
    name: str
    n: int

trace: str[]

num = (s: str) -> int | ParseError:
    trace.push("num({s})")
    if let n = to_int(s): return n
    ParseError("not a number: '{s}'", 0)

opt = (s: str) -> int?:
    trace.push("opt({s})")
    to_int(s)

open_file = (name: str) -> str | IoError:
    if name == "": return IoError.missing
    if name == "root": return .denied
    "contents of {name}"

word = (s: str) -> str: "w{s}"
add = (a: int, b: int) -> int: a + b
cat = (a: str, b: int) -> str: "{a}{b}"

# arguments, left to right: the second is not evaluated when the first fails
args = (a: str, b: str) -> int | ParseError: add(num(a)?, num(b)?)

# a value held for a call (a string made first) when a later argument fails
held = (a: str, b: str) -> str | ParseError: cat(word(a) + "!", num(b)?)

# a struct, an array, a tuple, a map and a text with values put in, half built
ctor = (a: str, b: str) -> Item | ParseError: Item(word(a), num(b)?)
arr = (a: str, b: str) -> str[] | ParseError: [word(a), word(b), "{num(b)?}"]
tup = (a: str, b: str) -> (str, int) | ParseError: (word(a), num(b)?)
mp = (a: str, b: str) -> {str: int} | ParseError: {word(a): 1, word(b): num(b)?}
interp = (a: str, b: str) -> str | ParseError: "{word(a)} and {num(b)?}"

# conditions, checked each time
count = (xs: str[]) -> int | ParseError:
    i = 0
    total = 0
    loop i < xs.len() and num(xs[i])? >= 0:
        total += num(xs[i])?
        i += 1
    if num(xs[0])? > 100: return -1
    else if num(xs[1])? > 100: return -2
    total

# deferred code runs, and locals holding heap values are released
with_defer = (s: str) -> int | ParseError:
    keep = [word("a"), word("b")]
    defer trace.push("deferred {keep.len()}")
    v = num(s)?
    v * 2

# an optional, and a union with none in it
both = (a: str, b: str) -> (int | ParseError)?:
    x = opt(a)?
    y = num(b)?
    x + y

# an error enum
size = (name: str) -> int | IoError: len(open_file(name)?)

# chained: a field, a method, an index
first_char = (name: str) -> str | IoError: open_file(name)?[0..1)
item_name = (a: str, b: str) -> int | ParseError: ctor(a, b)?.name.len()

# inside match arms and if-expressions, and as a return
pick = (k: int, s: str) -> int | ParseError:
    r = match k:
        0: num(s)? + 1
        _: if k > 5: num(s)? * 2 else: 0
    return add(r, num(s)?)

# in a lambda: passes on from the lambda
lam = (xs: str[]) -> (int | ParseError)[]:
    f = (s: str) -> int | ParseError: num(s)? + 1
    out: (int | ParseError)[]
    loop x in xs: out.push(f(x))
    out

# a generic function: the members sorted out for the types given
twice[T] = (r: T | ParseError) -> T[] | ParseError:
    v = r?
    [v, v]

base = alloc_count()
print(args("1", "2"), args("x", "2"), args("1", "y"))
print(trace)
trace = []
print(held("a", "1"), held("a", "q"))
print(ctor("a", "1"), ctor("a", "q"))
print(arr("a", "1"), arr("a", "q"))
print(tup("a", "1"), tup("a", "q"))
print(mp("a", "1"), mp("a", "q"))
print(interp("a", "1"), interp("a", "q"))
print(count(["1", "2", "3"]), count(["1", "x"]), count(["200", "1"]), count(["1", "200"]))
trace = []
print(with_defer("4"), with_defer("z"))
print(trace)
print(both("1", "2"), both("x", "2"), both("1", "y"))
print(size("a.txt"), size(""), size("root"))
print(first_char("b"), first_char(""))
print(item_name("abc", "1"), item_name("abc", "x"))
print(pick(0, "3"), pick(7, "3"), pick(1, "3"), pick(0, "x"), pick(7, "x"))
print(lam(["1", "x", "3"]))
print(twice[str]("s"), twice[int](ParseError("no", 3)))
trace = []
print(alloc_count() - base)
