# requires: sloppy
# characters as numbers: 'a' + i in either order, c in "aeiou" for a byte; if let with a
# condition on what it binds
slot = 2
print(chr(u8(c'a' + slot)), chr(slot + c'a'), c'b' + 1)
c: u8 = 'q'
print(c - 'a', 'z' - c)
name = "orc"
print(name[0] in "aeiou", name[1] in "aeiou", "rc" in name)
f = (x: str?) -> str:
    if let t = x and t != "" and len(t) < 5: return "short {t}"
    else: return "other"
print(f("abc"), f(""), f(none), f("abcdefg"))
g = (x: int?) -> int: if let v = x and v > 0: v * 2 else: -1
print(g(3), g(-3), g(none))
