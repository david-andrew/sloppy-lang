# requires: sloppy
# a str of the program's own for its type: how it shows everywhere; to_text and to_json still
# write its fields, which read back
struct Big:
    m: f64
    e: int
str = (b: Big) -> str: "{b.m:.2f}e{b.e}"
struct Wallet:
    dust: Big
    clicks: int
enum Suit: hearts, spades
str = (s: Suit) -> str: if s == .hearts: "H" else: "S"
x = Big(1.5, 300)
print(x, [x, x], Wallet(x, 3), "{x:>10}|")
print(str(x), str(5), str(2.5), "{Suit.hearts}{Suit.spades}")
t = to_text(Wallet(x, 3))
print(t)
print(from_text[Wallet](t))
print(to_json(x))
loop v in [0.0, 12.5, 999.0, 1234.0, 45600.0, 7.89e11, 2.5e14, 1.234e15, -5432.0]: print(short_number(v))
