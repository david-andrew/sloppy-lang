# requires: native
# set_wheel_scale scales mouse_wheel, and with it everything that scrolls by the wheel
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=8
# env: SLOPPY_INPUT=2:wheel=1 4:wheel=-2
window("wheel scale", 320, 180)
draw = ():
    clear(rgb(0, 0, 0))
    if frame_number() == 3: set_wheel_scale(0.5)
    if mouse_wheel() != 0.0: print("{frame_number()}: {mouse_wheel()} (scale {wheel_scale()})")
