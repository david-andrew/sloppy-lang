# requires: sloppy
c = channel[int](1)
copy = c
copy.send(9)
print(c.receive(), copy.len())
copy.close()
print(c.closed())
a = atomic(1)
b = a
b.set(3)
print(a.get())
t = spawn((): 17)
u = t
print(t.wait(), u.wait())
m = {"x": 1}
n = m
n["x"] = 2
s = set([1])
r = s
r.add(2)
print(m["x"], n["x"], s.len(), r.len())
