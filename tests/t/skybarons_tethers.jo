# requires: sloppy
# Sky Barons' flying castle's tethered screws: four little screws docked on pads, each a seat of
# the castle (after its bombards); F lifts one off on its cable, its seat gone and its player
# flying it; never further than its tether from its pad, however it is flown; down slowly onto
# its pad, docked, the seat back, the screw as it was; too fast, not; the computer's lifting off
# with the other side near, its airmen flying them close round the castle, back down on their
# pads when the fight is gone; through their own castle unharmed; the crew call never putting
# anyone in one; the castle downed, the cables snapping and the screws flying on, one docked with
# the computer's in it lifting off as it falls, those with no one in them lost with it
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
fresh = () -> Game:
    let g = new_game([0, 1, -1, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT), [])
    loop i in 0..g.people.len():
        g.people[i].state = DEAD
        g.people[i].timer = 1000000
    g
sit = (g: mut Game, i: int, j: int, s: int):
    g.crafts[j].seats[s] = i
    g.people[i].state = SEATED
    g.people[i].craft = j
    g.people[i].seat = s
open_seats = (g: Game, j: int) -> int: g.crafts[j].seats.filter((k): k != SHUT).len()
docked = (g: Game, j: int) -> int: g.crafts[j].hung.filter((k): k >= 0).len()
pads = (a: Pad = Pad(), b: Pad = Pad()) -> Pad[]: [a, b]
# (how far screw k's cable is out: under its deck to the eye in its pad)
out_of = (g: Game, k: int) -> f64: f64(length(point_of(g.crafts[k], TETHER_UNDER) - point_of(g.crafts[g.crafts[k].mother], tether_eye(g.crafts[k].tether))))
screws = (g: Game, m: int) -> int[]:
    l: int[]
    loop j in 0.. and d in g.crafts:
        if not d.free and d.kind == SCREW and d.mother == m and alive(d): l.push(j)
    l

# (the castle's seats, by number as the seat keys and the seat map have them)
k = KINDS[CASTLE]
names = ["pilot", "battery", "twins", "mg", "flak", "flame", "hook", "broadside", "bombard"]
row: str[] = []
loop s in 0.. and st in k.seats:
    w = if s == 0: "pilot" else: if st.weapon == HOOK: "screw" else: ["mg", "ballista", "launcher", "mg2", "flak", "twins", "siphon", "screw", "battery", "bombard"][st.weapon]
    row.push("{s + 1} {w}")
print("castle seats ({k.seats.len()}): {join(row, ", ")}")
print("screw seats {TETHER0 + 1}..{TETHER0 + TETHERS}; crew call fills {crew_seats(CASTLE)}; a crew seat: 23 {crew_seat(CASTLE, 22)}, 24 {crew_seat(CASTLE, TETHER0)}")
print("tether {TETHER_LEN} m; pads on the floor {CASTLE_TIERS[1].2}: {TETHER_PADS.map((p): castle_walk_height(f64(p.x), f64(p.z)) == f64(p.y))}")

let g = fresh()
g.crafts.push(flying_craft(CASTLE, 0, vec3(0, 600, 0), vec3(1, 0, 0)))
j = g.crafts.len() - 1
print("castle: {open_seats(g, j)} seats there, {docked(g, j)} screws docked")
sit(g, 2, j, 0)
sit(g, 0, j, TETHER0)
g.crafts[j].hhealth[0] = 500
# (player 0 lifts the port fore screw off: in it, flying, on its cable)
g = tick(g, pads(Pad(enter = true)))
s = g.people[0].craft
d = g.crafts[s]
print("lift off: player 0 in craft {s} ({KIND_NAMES[d.kind]}), seat {g.people[0].seat}, health {d.health}, tether {d.tether} of {d.mother}; its seat {g.crafts[j].seats[TETHER0]}, {open_seats(g, j)} seats there, {docked(g, j)} docked")
print("  over its pad {f64(length(d.pos - point_of(g.crafts[j], tether_dock(0)))) < 1.0}, going up {d.vel.y > 0.0}")
# (a seat not there: not taken)
sit(g, 1, j, 1)
g = tick(g, pads(Pad(), Pad(seat = TETHER0 + 1)))
print("a seat not there: player 1 still in seat {g.people[1].seat}")
g.people[1].state = DEAD
g.crafts[j].seats[1] = -1
# (flown straight out, full lean, 50 s: held at its cable's end, the castle flying on)
far = 0.0
loop t in 0..60 * 50:
    g = tick(g, pads(Pad(pitch = -100, roll = -100, throttle = 1)))
    far = max(far, out_of(g, s))
print("flown out 50 s: the cable out at most {far:.1} m, now {out_of(g, s):.1}, still tied {g.crafts[s].tether == 0}")
# (onto its pad too fast: not docked; slowly: docked, the seat back, the screw as it was)
c = g.crafts[j]
g.crafts[s].pos = point_of(c, tether_dock(0) + vec3(0, 1, 0))
g.crafts[s].rot = c.rot
g.crafts[s].vel = c.vel + vec3(0, -12, 0)
g.crafts[s].health = 430
g = tick(g, pads())
print("too fast: {docked(g, j)} docked, player 0 in craft {g.people[0].craft}")
c = g.crafts[j]
g.crafts[s].pos = point_of(c, tether_dock(0) + vec3(0, 1, 0))
g.crafts[s].vel = c.vel
g = tick(g, pads())
print("hovering over it, not coming down: {docked(g, j)} docked, player 0 in craft {g.people[0].craft}")
c = g.crafts[j]
g.crafts[s].pos = point_of(c, tether_dock(0) + vec3(0, 1, 0))
g.crafts[s].vel = c.vel + vec3(0, -1.5, 0)
g = tick(g, pads())
print("slowly: {docked(g, j)} docked, player 0 in craft {g.people[0].craft} seat {g.people[0].seat}, its health {g.crafts[j].hhealth[0]}, its slot free {g.crafts[s].free}")
loop t in 0..60 * 10: g = tick(g, pads())
print("10 s on its pad: mended to {g.crafts[j].hhealth[0]}")
# (a crew call: the castle's on the ground; those who answer, never into a screw)
g.people[0].state = DEAD
g.crafts[j].seats[TETHER0] = -1
loop q in 1..g.crafts[j].seats.len():
    if g.crafts[j].seats[q] >= 0: g.crafts[j].seats[q] = -1
g.people[3].team = 0
g.people[3].state = WALK
g.people[3].craft = -1
g.people[3].joining = j
g.people[3].join_seat = -1
g.people[3].join_at = g.tick
loop q in 1..TETHER0: g.crafts[j].seats[q] = 2
g = tick(g, pads())
print("crew call, every gun manned: the joiner in craft {g.people[3].craft} seat {g.people[3].seat} (screws still free {[0..TETHERS).map((h): g.crafts[j].seats[TETHER0 + h])})")
loop q in 1..TETHER0: g.crafts[j].seats[q] = -1
g.people[3].team = 1
g.people[3].state = DEAD

# the computer's: the castle in the air, the other side's fighter near; its screws lift off one at
# a time, its airmen flying them, kept on their cables; through the castle unharmed
let a = fresh()
a.crafts.push(flying_craft(CASTLE, 0, vec3(0, 600, 0), vec3(1, 0, 0)))
m = a.crafts.len() - 1
sit(a, 2, m, 0)
a.crafts.push(flying_craft(FIGHTER, 1, vec3(500, 640, 300), vec3(0, 0, 1)))
e = a.crafts.len() - 1
sit(a, 3, e, 0)
a.crafts[e].safe = 1 << 30
up = [0, 0, 0, 0, 0]
loop t in 0..60 * 8:
    a.crafts[e].pos = vec3(a.crafts[m].pos.x + 500.0, 640, a.crafts[m].pos.z + 300.0)
    a.crafts[e].vel = a.crafts[m].vel
    a.crafts[e].safe = 0
    a = tick(a, pads())
    if t % 120 == 119: up[t / 120] = TETHERS - docked(a, m)
print("the other side near: screws up by the second 2, 4, 6, 8: {up[0]} {up[1]} {up[2]} {up[3]}")
l = screws(a, m)
print("  {l.len()} away, airmen {l.map((x): a.crafts[x].airman)}, tied {l.map((x): a.crafts[x].tether)}")
worst = 0.0
health0 = a.crafts[m].health
loop t in 0..60 * 30:
    a.crafts[e].pos = vec3(a.crafts[m].pos.x + 260.0, 620, a.crafts[m].pos.z + 120.0)
    a.crafts[e].vel = a.crafts[m].vel
    a.crafts[e].safe = 0
    a.crafts[e].health = KINDS[FIGHTER].health
    a = tick(a, pads())
    loop x in screws(a, m):
        if a.crafts[x].tether >= 0: worst = max(worst, out_of(a, x))
print("30 s fighting it: cables out at most {worst:.1} m; screws' health {screws(a, m).map((x): a.crafts[x].health)}")
# (one of them flown through the castle's rock: no harm to either)
x = screws(a, m)[0]
hx = a.crafts[x].health
hc = a.crafts[m].health
a.crafts[x].pos = point_of(a.crafts[m], vec3(0, -20, 0))
a.crafts[x].vel = a.crafts[m].vel + vec3(0, 0, 10)
loop t in 0..30: a = tick(a, pads())
print("a screw through the rock: its health {hx} -> {a.crafts[x].health}, the castle's lost {hc - a.crafts[m].health}")
# (the fight gone: back down on their pads, a minute on)
a.crafts[e].free = true
a.people[3].state = DEAD
a.people[3].timer = 1 << 30
a.people[3].craft = -1
loop t in 0..60 * 60: a = tick(a, pads())
print("the fight gone, a minute on: {docked(a, m)} docked, {screws(a, m).len()} away, {open_seats(a, m)} seats there")

# the castle downed with two screws away and one docked with the computer's in it: the cables
# snap, those away flying free; the docked one with the computer's lifts off as it falls
let b = fresh()
b.crafts.push(flying_craft(CASTLE, 0, vec3(0, 900, 0), vec3(1, 0, 0)))
n = b.crafts.len() - 1
sit(b, 2, n, 0)
sit(b, 4, n, TETHER0 + 2)
launch_hook(b, n, 0)
launch_hook(b, n, 1)
loop t in 0..200: b = tick(b, pads())
b.crafts[n].down = 1
b.crafts[n].by = -1
snaps = 0
loop t in 0..60 * 4:
    b = tick(b, pads())
    loop bo in b.booms:
        if bo.tick == b.tick and bo.kind == SNAPPED: snaps += 1
l = screws(b, n)
print("downed: {snaps} cables snapped; screws off it {l.len()}: tied {l.map((x): b.crafts[x].tether)}, flying {l.map((x): flying(b.crafts[x]))}, person 4 in craft {b.people[4].craft} ({KIND_NAMES[b.crafts[b.people[4].craft].kind]})")
print("  still on its pads: {docked(b, n)}")
