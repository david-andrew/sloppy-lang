# requires: sloppy
# the game's own messages beside the worlds, both ways, on a server and client with no network
import netplay
struct World:
    n = 0
struct Pad:
    x = 0
apply = (w: World, p: int, pad: Pad, seen: World) -> World: w
srv = netplay.server(World(), apply, (w: World): w)
c = netplay.client(World(), apply)
srv.join(7)
srv.update()
srv.update()
loop o in srv.outgoing(): c.receive(o.1)
srv.say(7, "round over")
srv.say_all("red wins")
loop o in srv.outgoing(): c.receive(o.1)
print(c.connected(), c.messages)
c.say("gg")
loop b in c.outgoing(): srv.receive(7, b)
srv.update()
print(srv.messages)
srv.update()
print(srv.messages.len())
