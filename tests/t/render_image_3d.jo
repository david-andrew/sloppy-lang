# requires: sloppy
# requires: native
# env: SLOPPY_SOFTWARE=1
# render_image draws the 3D queued inside it, with no 2D after it to set it off; two pictures in
# a row are alike (the second gets the sky and clear depth of a first pass, though its render
# target may have the number the first one's had).
__fixed_step = true
box = cube_mesh(1.5)
scene = () -> Image:
    render_image(32, 24, ():
        camera3d(vec3(0, 1, 4), vec3(0, 0, 0), 60)
        sky(vec3(0.2, 0.3, 0.8), vec3(0.7, 0.8, 0.9), vec3(0.3, 0.3, 0.3))
        sun(vec3(-1, 2, 1))
        shadows(false)
        draw_mesh(box, color = rgb(0.9, 0.2, 0.1)))
px = (img: Image, x: int, y: int) -> (int, int, int):
    k = (y * img.width + x) * 4
    (int(img.pixels[k]), int(img.pixels[k + 1]), int(img.pixels[k + 2]))
a = scene()
middle = px(a, 16, 12)
corner = px(a, 0, 0)
assert(middle.0 > 80 and middle.0 > middle.2 * 2)       # (the red box)
assert(corner.2 > corner.0)                              # (the blue sky, not black)
b = scene()
assert(a.pixels == b.pixels)
print("render_image draws 3D")
