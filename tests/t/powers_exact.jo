# requires: sloppy
# log10 and log2 are exact at powers of ten and two; JSON keeps infinities; min and max of a
# type with its own <
bad = 0
loop k in [-307..308]:
    if log10(to_float("1e{k}")!) != f64(k): bad += 1
print("log10 wrong at {bad} powers of ten")
print(log10(2.0), log10(999.9999999999999), log2(8.0), log2(0.125))
print("{1e6:g} {1000.0:.3g}")
print(remap(640, 0, 1280, -1, 1), inverse_lerp(10, 20, 15))
print(is_finite(INF), is_inf(-INF), is_finite(3.0), is_nan(NAN))
struct Save:
    dust = 0.0
    low = 0.0
    odd = 0.0
# (JSON has no infinity or NaN: null, read back as NaN)
j = to_json(Save(INF, -INF, NAN))
print(j)
print(from_json[Save](j))
struct Big:
    m: f64
    e: int
(<) = (a: Big, b: Big) -> bool: a.e < b.e or a.e == b.e and a.m < b.m
print(max(Big(5, 0), Big(1, 50)), min(Big(5, 0), Big(1, 50)))
print(max(1, 2.5), min(3, 2))
