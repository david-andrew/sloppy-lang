# a Deflater stepped a little at a time gives deflate's bytes, which inflate reads back
# requires: sloppy
txt = ""
loop i in [0..6000): txt += "Person(id={i}, name=\"p{i % 37}\", gold={(i * 7919) % 5000}, alive=true)\n"
src = bytes(txt)
whole = deflate(src)
d = deflater(src)
print(d.progress())
steps = 0
half = false
loop not d.step(0.0):
    steps += 1
    if d.progress() >= 0.5: half = true
z = d.result()
print(steps > 10, half, d.progress(), z == whole, z.len() < src.len() / 4, (inflate(z) ?? []) == src)
# (result finishes one that is not done; one of nothing)
e = deflater(src)
e.step(0.0)
print(e.result() == whole)
empty = deflater([])
print(empty.step(1.0), empty.result() == deflate([]), (inflate(empty.result()) ?? [u8(1)]).len())
