# requires: sloppy
# Sky Barons' one-person flyers (the rocketeer, as a witch too, and the cat): upright when they
# come into the air, upright when launched from the ground, and with the stick let go, rolled
# upright again from a bank or from flying upside down
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
# (one person, side 0, in a craft of the kind: in the air or standing on the ground)
seated = (kind: int, air: bool, witch: bool) -> Game:
    let g = new_game([0, -1], 0.65, Rules(mode = THUNDERDOME), [kind])
    g.people[0].witch = witch
    p = g.people[0]
    c = if air: flying_craft(kind, 0, vec3(0, 700, 0), vec3(1, 0, 0)) else: parked(kind, 0, vec3(p.pos.x, f32(ground(f64(p.pos.x), f64(p.pos.z))), p.pos.z), 0.3)
    g.crafts.push(c)
    j = g.crafts.len() - 1
    g.crafts[j].seats[0] = 0
    g.people[0].state = SEATED
    g.people[0].craft = j
    g.people[0].seat = 0
    g.people[1].state = DEAD
    g.people[1].timer = 100000
    g
flown = (g: Game) -> Craft: g.crafts[g.people[0].craft]
# (the right way up, its wings level: climbing or diving as it may)
upright = (c: Craft) -> bool: f64(up_of(c).y) > 0.5 and abs(f64(right_of(c).y)) < 0.1

loop kind in [ROCKETEER, CAT]:
    loop witch in (if kind == ROCKETEER: [false, true] else: [false]):
        name = if witch: "witch" else: KIND_NAMES[kind]
        let g = seated(kind, true, witch)
        print("{name}: into the air upright: {upright(flown(g))}")
        # (launched from standing: the throttle, then the stick let go for 2 s)
        let h = seated(kind, false, witch)
        loop k in 0..120: h = tick(h, [Pad(throttle = 1)])
        print("{name}: launched upright: {not flown(h).landed and upright(flown(h))}")
        # (rolled into a steep bank, and nearly upside down: the stick let go, 3 s)
        loop roll in [2.2, 3.0]:
            let a = seated(kind, true, witch)
            j = a.people[0].craft
            a.crafts[j].rot = quat_mul(a.crafts[j].rot, quat_axis_angle(vec3(0, 0, 1), roll))
            was = f64(up_of(a.crafts[j]).y)
            loop k in 0..180: a = tick(a, [Pad(throttle = 1)])
            print("{name}: rolled to up.y {was:.1}, let go, upright again: {upright(flown(a))}")
        # (steered as the mouse steers, toward a way behind it and up: there, the right way up)
        let b = seated(kind, true, witch)
        aim = normalize(vec3(-0.98, 0.4, 0.17))
        stick = vec3(0, 0, 0)
        loop k in 0..360:
            t = steer(flown(b), aim)
            stick = approach(stick, vec3(f32(f64(t.pitch) / 100.0), f32(f64(t.roll) / 100.0), f32(f64(t.yaw) / 100.0)), 30.0, DT)
            b = tick(b, [Pad(int(round(f64(stick.x) * 100.0)), int(round(f64(stick.y) * 100.0)), int(round(f64(stick.z) * 100.0)), 1)])
        q = flown(b)
        print("{name}: steered round to a way behind: on it {f64(dot(fwd_of(q), aim)) > 0.99}, the right way up {f64(up_of(q).y) > 0.5}")
