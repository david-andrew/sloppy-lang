# requires: sloppy
# removing from a map: what is left keeps its order, lookups, len, keys, loops (read and mut),
# adding again, removing nearly all, a counter removed and counted again; many removals fast
m: {int: str}
loop i in [0..10): m[i] = "v{i}"
m.remove(3)
m.remove(7)
print(m, m.len(), m.has(3), m.get(7), m[8], m.keys(), m.values().len())
loop k, v in m: print(k, v)
loop mut k, v in m: v = v + "!"
print(m)
m[3] = "back"
print(m)
loop i in [0..8): m.remove(i)
print(m, m.len())
cnt: {str: int}
cnt["a"] += 1
cnt.remove("a")
cnt["a"] += 5
print(cnt, cnt.len(), cnt.is_empty())
big: {int: int}
loop i in [0..100000): big[i] = i
t0 = time()
loop i in [0..50000): big.remove(i * 2)
print(big.len(), big[1], time() - t0 < 1.0)
