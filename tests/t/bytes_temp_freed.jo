# requires: sloppy
# bytes() of a text made for it (an interpolation, a call's result) gives that memory back with the
# bytes (it was never freed)
make = (i: int) -> str: "hello {i}"
m0 = memory_in_use()
total = 0
loop i in 0..100000:
    total += bytes("hello {i}").len()
    total += bytes(make(i)).len()
b = bytes("abc{total % 10}")
b[0] = c'x'
print(memory_in_use() - m0 < 100000, total > 0, str_from_bytes(b)[..3])
