# requires: sloppy
# x ?? return v, ?? break, ?? continue: the value, or leave
error struct E:
    m: str
f = (s: str) -> int | E:
    n = to_int(s) ?? return E("not a number: {s}")
    n * 2
g = (xs: str[]) -> int:
    total = 0
    loop x in xs:
        n = to_int(x) ?? continue
        if n < 0: break
        total += n
    total
h = (s: str) -> int:
    to_int(s) ?? return -1
print(f("4"), f("x"), g(["1" "a" "2" "-3" "9"]), h("z"), h("5"))
xs: int[] = []
print(xs.max(default = 0), [3 1 2].max(default = 0), [3 1 2].min(0), max(1, 2), max([1 2]))
