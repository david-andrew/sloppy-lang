# requires: sloppy
# assert(a == b) and the other comparisons tell the values compared when they fail; each side
# is worked out once (a literal is in the text already)
struct P:
    x: int
    y: int
calls = 0
next_id = () -> int:
    calls += 1
    calls
total = 9
x = 4.5
xs = [1, 2]
assert(total == 9)
assert(x == 4.5)
assert(x > 4)
assert(P(1, 2) == P(1, 2))
assert(xs != [1, 3])
assert(len(xs) <= 2)
assert(next_id() == 1)
print(calls)
c: str? = none
assert(c == none)
f = (n: int) -> int:
    assert(n * 2 == n + n)
    n
print(f(4))
ys = [1, 3]
assert(xs == ys)
