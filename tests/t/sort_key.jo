# requires: sloppy
# sorted(xs, key = f) and xs.sort(key = f), as Python; len as a function value
xs = ["bb" "a" "ccc"]
print(sorted(xs, key = len), sorted(xs), sorted(xs, true), sorted(xs, key = (s): s, descending = true))
xs.sort(key = (s): len(s))
print(xs)
ys = [3 1 2]
ys.sort()
ys.sort(true)
print(ys)
zs = [(1, "b") (1, "a")]
print(sorted(zs), sorted(zs, (p): p.1))
print(sorted_by(xs, len))
print(xs.map(len))
print(max(["bb" "a" "ccc"], key = len), min(["bb" "a"], key = len), max([1 5 2]), max(2, 3), max([3 1], default = 0))
