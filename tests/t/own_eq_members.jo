# requires: sloppy
# == on a struct, tuple, array, fixed array, optional or enum holding a type with an == of its
# own (a map, a set, the program's): that ==; as a map's key, it is hashed by its own hash
use big

struct S:
    m: {str: int}
a: {str: int} = {}
a["x"] = 1
a["y"] = 2
b: {str: int} = {}
b["y"] = 2
b["x"] = 1
print(a == b, S(a) == S(b), [a] == [b])
c = b
c["x"] = 5
print(a == c, S(a) == S(c), [a] == [c], S(a) != S(c))

struct V:
    x: int
(==) = (p: V, q: V) -> bool: p.x % 10 == q.x % 10
hash = (v: V) -> u64: hash(v.x % 10)
print(V(3) == V(13), [V(3)] == [V(13)], [V(3)] == [V(4)])
print((V(3), 1) == (V(13), 1), [V(3)].contains(V(23)), V(33) in [V(3)])
o1: V? = V(3)
o2: V? = V(13)
print(o1 == o2)
f1: V[2] = [V(1), V(2)]
f2: V[2] = [V(11), V(22)]
print(f1 == f2)

enum E:
    one(v: V)
    two(s: str)
print(E.one(V(1)) == E.one(V(21)), E.one(V(1)) == E.two("a"))

# maps as keys and values: the same entries in any order
seen: {{str: int}: str} = {}
seen[a] = "first"
print(seen.get(b) ?? "none", seen.get(c) ?? "none")
ms: {str: {str: int}} = {}
ms["k"] = a
ms2: {str: {str: int}} = {}
ms2["k"] = b
print(ms == ms2)

# a struct holding a V as a key: V's own == and hash
struct K:
    v: V
    n: int
ks: {K: int} = {}
ks[K(V(3), 1)] = 7
print(ks.get(K(V(13), 1)) ?? -1, ks.get(K(V(4), 1)) ?? -1)

# a list whose nodes hold V
struct Node:
    v: V
    next: Node?
n1 = Node(V(1), Node(V(2), none))
n2 = Node(V(11), Node(V(12), none))
n3 = Node(V(11), Node(V(13), none))
print(n1 == n2, n1 == n3)

# sets and deques, inside other values and as keys
struct P:
    s: Set[int]
x = set([1, 2, 3])
y = set([3, 2, 1])
print(x == y, P(x) == P(y), [x] == [y])
groups: {Set[int]: str} = {}
groups[x] = "abc"
print(groups.get(y) ?? "none")
ss: Set[Set[int]]
ss.add(x)
print(y in ss, set([1]) in ss)
d1: Deque[int]
d1.push(1)
d1.push(2)
d2: Deque[int]
d2.push(2)
d2.push_front(1)
print(d1 == d2, [d1] == [d2])
dk: {Deque[int]: int} = {}
dk[d1] = 4
print(dk.get(d2) ?? 0)

# the library's Big: every zero the same
bm: {Big: str} = {}
bm[big(0)] = "zero"
bm[big(5, 100)] = "big"
print(bm.get(Big(0.0, 7)) ?? "?", bm.get(big(5, 100)) ?? "?", [big(1)] == [big(1)])

# bools: &= and |=
ok = true
ok &= false
print(ok, ok == false)
ok |= true
print(ok, ok == true)
