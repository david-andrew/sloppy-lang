# requires: sloppy
# requires: native
# the main thread's stack holds millions of calls: recursion a million deep, through a
# function, a list's own operations (printing, ==, hashing) and a `mut` walk down a list
struct Node:
    value: int
    next: Node?
depth = (n: int) -> int:
    if n == 0: return 0
    1 + depth(n - 1)
print(depth(1000000))
append = (n: mut Node?, v: int):
    if n == none: n = Node(v)
    else: append(n!.next, v)
a: Node? = none
loop i in 0..300000: a = Node(i, a)
append(a, -1)
b = a
print(a == b, len("{a}") > 0, hash(a) == hash(b))
count = (n: Node?) -> int:
    if let c = n: return 1 + count(c.next)
    0
print(count(a))
