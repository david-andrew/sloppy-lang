# requires: sloppy
# requires: native
# A netplay client with reconnect = true: its connection closed by the server as it restarts
# (1012) is made again by itself, and the server sees a new player with the same hello; one
# closed on purpose (4001, the game's own code) is not, and its problem says the server's reason
import net
import netplay

struct Pad:
    dx = 0
struct World:
    n = 0

apply = (w: World, player: int, p: Pad, seen: World) -> World: w
step = (w: World) -> World: w

const PORT = 9534

main = ():
    srv = netplay.server(World(), apply, step)
    srv.listen(PORT)
    c = netplay.client(World(), apply)
    c.reconnect = true
    c.connect("127.0.0.1", PORT, hello = "ann")
    players: int[]
    joins = 0
    closed = false
    end = time() + 20.0
    loop time() < end and not (closed and len(c.problem) > 0):
        srv.update()
        loop p in srv.joined:
            joins += 1
            players.push(p)
            print("joined: player {joins}")
        # (the first player sent away as by a restart, once it has said hello; the second for good)
        if players.len() > 0 and len(srv.hello(players[0])) > 0:
            p = players.pop()
            print("hello: {srv.hello(p)}")
            if joins == 1: net.close(p, 1012, "restarting")
            else:
                net.close(p, 4001, "the room is full")
                closed = true
        c.play(Pad(1))
        sleep(1.0 / 60.0)
    # (no third try: given a while to make one, it does not)
    loop _ in 0..150:
        srv.update()
        c.play(Pad(1))
        sleep(1.0 / 60.0)
    print("joins: {joins}")
    print("problem: {c.problem}")
    print("connected: {c.connected()}")
