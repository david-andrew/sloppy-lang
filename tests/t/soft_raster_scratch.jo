# requires: sloppy
# requires: native
# Repeated batches grow and shrink the software rasterizer's scratch buffers;
# empty and offscreen batches must not reuse triangles from an earlier draw.
check = (w: int, h: int):
    img = render_image(w, h, ():
        clear(BLACK)
        loop i in [0..200): rect(i % w, i % h, 4, 4, RED)
        flush()
        clear(BLACK)
        rect(-100, -100, 10, 10, RED)
        flush()
        rect(4, 4, 8, 8, WHITE)
        rect(-100, -100, 10, 10, RED)
        flush()
        rect(0, 0, 2, 2, rgb(0, 0, 1))
        flush())
    loop y in [0..h):
        loop x in [0..w):
            p = (y * w + x) * 4
            white = x >= 4 and x < 12 and y >= 4 and y < 12
            blue = x < 2 and y < 2
            assert(img.pixels[p] == (if white: u8(255) else: u8(0)))
            assert(img.pixels[p + 1] == (if white: u8(255) else: u8(0)))
            assert(img.pixels[p + 2] == (if white or blue: u8(255) else: u8(0)))
            assert(img.pixels[p + 3] == 255)
check(96, 80)
check(16, 16)
check(128, 96)
check(16, 16)
print("raster scratch reuse ok")
