# requires: sloppy
# Sky Barons' game (examples/skybarons): the computer against itself in five fights, the same
# hash wherever it runs (natively and in a web page: rollback netplay needs every machine to
# play the same ticks the same way)
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

loop m in [DOGFIGHT, BASES, TRENCH, THUNDERDOME, BROOMS]:
    set_map(if m == TRENCH: GORGE else: FARMLAND)
    let g = new_game(fill(-1, 4), 0.65, Rules(mode = m), [])
    loop k in 0..60 * 40: g = tick(g, [])
    boarded = 0
    loop c in g.crafts:
        if not c.free and manned(c): boarded += 1
    print("{MODE_NAMES[m]}: tick {g.tick}, {boarded} crafts manned, hash {hash(g)}")
print("version {version_print()}")
# (Bikes & Brooms: the balls shot, a gun's bullet, the long gun's, a rocket, off-centre: knocked off
# from where they are struck, the harder the stronger the shot; the same ticks everywhere)
let g = new_game(fill(-1, 2), 0.65, Rules(mode = BROOMS), [])
g.people = []
g.crafts = []
loop k in 0..60: g = tick(g, [])
shots = [(4, 0.0, false), (4, 0.0, true), (5, 1.5, false), (0, 0.0, true)]
loop sh in shots:
    o = g.balls[sh.0]
    bl = Bullet(o.pos + vec3(f32(sh.1), 0, 60), vec3(0, 0, f32(-BULLET_SPEED)), -1, -1, 0, 120)
    if sh.2:
        bl.damage = SNIPE_DAMAGE
        bl.snipe = true
    v0 = o.vel
    g.bullets.push(bl)
    loop t in 0..12: g = tick(g, [])
    dv = g.balls[sh.0].vel - v0
    print("{BALL_NAMES[o.kind]}, {if sh.2: "the long gun" else: "a bullet"} {sh.1} m off: {if dv.z < -0.5: "knocked on" else: "not on"}, {if dv.x < -0.3: "aside" else: "not aside"}")
g.shots.push(Shot(ROCKET, g.balls[2].pos + vec3(0, 0, 60), vec3(0, 0, -300), -1, -1, 0, 300))
loop t in 0..30: g = tick(g, [])
print("balls shot: hash {hash(g)}")
