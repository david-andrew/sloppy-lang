# requires: sloppy
# requires: native
caught = (f: () -> int) -> str:
    global __catch_jmp
    jb = __alloc(256)
    keep = __catch_jmp
    if __setjmp(jb) == 0:
        __catch_jmp = jb
        f()
        __catch_jmp = keep
        __free(jb)
        return "ok"
    __catch_jmp = keep
    __free(jb)
    __caught

hist = (x: int[], h: mut int[], n: int):
    loop i in [0..n): h[x[i]] += 1

# A changed input array must not retain an old cached length or pointer.
changing = (x: mut int[], h: mut int[], n: int) -> int:
    loop i in [0..n):
        if i == 1: x = [2]
        h[x[i]] += 1
    0

x = [1 2 1 0 3 1]
h = fill(0, 4)
keep = h
hist(x, h, 6)
print(h, keep)
# Reading and writing the same array: ordinary element aliasing is preserved.
a = [1 0 1 0]
hist(a, a, 4)
print(a)
# Full width, wraparound integer updates and both immediate encodings.
update = (a: mut int[], i: int):
    a[i] += 1
    a[i] += -2
    a[i] += 1000000
    a[i] += -1000000
    a[i] += -2147483648
    a[i] += 2147483647
z = [9223372036854775807]
update(z, 0)
print(z)
hist([], h, 0)
hist([], h, -1)
print(h)
print(caught(():
    hist(x, h, 7)
    0))
print(caught(():
    hist([0, -1], h, 2)
    0))
print(caught(():
    hist([0 4], h, 2)
    0))
empty: int[]
print(caught(():
    hist([0], empty, 1)
    0))
print(caught((): changing(x, h, 2)))

# Scalar global destinations use RIP-relative addresses in the IR.
g = 5
bump = ():
    global g
    g += 1
    g += 1000000
bump()
print(g)
