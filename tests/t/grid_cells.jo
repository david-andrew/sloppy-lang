# requires: sloppy
# field_of_view, line_cells, and paths in cells (a roguelike's): next cell, distance, taken cells
m = [
    "##########",
    "#........#",
    "#..#.....#",
    "#........#",
    "#.....####",
    "#.....#..#",
    "##########"]
w = len(m[0])
h = m.len()
g = path_grid(w, h)
loop y in [0..h):
    loop x in [0..w):
        if m[y][x] == '#': set_open(g, x, y, false)
v = field_of_view(g, ivec2(2, 2), 8)
loop y in [0..h):
    row = ""
    loop x in [0..w):
        if x == 2 and y == 2: row += "@"
        else if v[x + y * w]: row += chr(m[y][x])
        else: row += " "
    print(row)
print(line_cells(ivec2(0, 0), ivec2(5, 2)))
print(line_cells(ivec2(3, 3), ivec2(3, 3)), line_cells(ivec2(2, 0), ivec2(0, 2)))
g2 = path_grid(6, 4)
loop y in [0..3): set_open(g2, 2, y, false)      # a wall with a gap at the bottom
a = ivec2(0, 0)
b = ivec2(5, 0)
print(path_distance(g2, a, b), path_step(g2, a, b), path_step(g2, ivec2(4, 0), b), path_step(g2, b, b))
print(path_step(g2, ivec2(1, 3), b), path_step(g2, ivec2(1, 3), b, taken = [ivec2(2, 3)]))
print(path_distance(g2, a, ivec2(2, 0)), path_field(g2, b)[0])
