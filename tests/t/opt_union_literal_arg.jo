# requires: sloppy
# a number written as the argument for an optional union parameter: the member it fits
error struct E:
    msg: str
mixed = (v: (int | E)?) -> str:
    if v == none: return "none"
    if v is int: return "int {v}"
    "error"
n = 7
print(mixed(5), mixed(n), mixed(none), mixed(E("a")))
f = (v: (f64 | str)?) -> str: "{v}"
print(f(2), f(2.5), f("s"))
g = (v: (u8 | str)?) -> str: "{v}"
print(g(200))
