# requires: sloppy
# one-character text where a byte goes ("a" and 'a' alike), c'a' wherever an integer does
s = "hello"
print(s[0] == "h", s[1] == 'e')
c: u8 = 43
print(c == "+", c in "+-", c'a' + 1)
buf: u8[]
buf.push("a")
buf.push('b')
print(buf)
n = 5
print(n == c'5')
match s[0]:
    "h": print("h")
    _: print("other")
loop ch in chars("ab"):
    match ch:
        c'a': print("a")
        _: print("not a")
xs: u8[] = ["x", 'y']
print(xs, u8(c'A'), int(c'0'))
