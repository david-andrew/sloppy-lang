# requires: sloppy
# a struct with no fields (`pass`): a message that is only its name, in a union; from_text says
# what it found when it is none of them; zeros of another type
struct Rematch: pass
struct Move:
    col: int
type Msg = Move | Rematch
ms: Msg[] = [Rematch(), Move(3)]
loop m in ms: print(to_text(m))
r = from_text[Msg]("Rematch()")
if r is Rematch: print("a rematch")
bad = from_text[Msg]("Mvoe(col=1)")
if bad is TextError: print(bad.message)
b: int[,] = zeros[int](2, 3)
b[1, 2] = 7
print(b)
