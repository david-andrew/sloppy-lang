# requires: sloppy
api = str_from_bytes(embed("../../docs/API.md"))
assert(not api.contains("`struct Voice`"))
assert(not api.contains("`struct Draw3D`"))
assert(not api.contains("hud_layout_"))
assert(not api.contains("keys: K[]"))
assert(not api.contains("arbs: __Arb"))
assert(api.contains("explicit import"))
assert(api.contains("`align_of(T) -> int`: the alignment"))
assert(api.contains("`hex = (c: int) -> vec4`: a color from the low 24 bits"))
assert(api.contains("`hex = (s: str) -> vec4?`: a color from CSS"))
assert(api.contains("Sensors are excluded"))
assert(api.contains("Optional element types are rejected"))
assert(api.contains("on Windows it holds them up"))
print("API contracts documented")
