# requires: sloppy
# PBKDF2-HMAC-SHA256 against RFC 7914's vectors and Python's hashlib.pbkdf2_hmac (a key longer than
# a block, zero bytes in the password and salt, more than one block of output), the password pair
# hash_password / check_password, and constant_time_equal
import crypto
h = (b: u8[]) -> str: crypto.hex_text(b)
print(h(crypto.pbkdf2_sha256(bytes("passwd"), bytes("salt"), 1, 64)))
print(h(crypto.pbkdf2_sha256(bytes("Password"), bytes("NaCl"), 80000, 64)))
print(h(crypto.pbkdf2_sha256(bytes("password"), bytes("salt"), 4096)))
print(h(crypto.pbkdf2_sha256(bytes("pass\0word"), bytes("sa\0lt"), 4096, 16)))
print(h(crypto.pbkdf2_sha256(bytes("x" * 100), bytes("salt"), 3)))
# (a SHA-256 of more than one block, after its block function changed)
print(h(crypto.sha256(bytes("abc" * 100))))

stored = crypto.hash_password("correct horse", iterations = 1000)
parts = split(stored, "$")
print(parts[0], parts[1], len(base64_decode(parts[2]) ?? []), len(base64_decode(parts[3]) ?? []))
print(crypto.check_password("correct horse", stored), crypto.check_password("correct horsf", stored), crypto.check_password("", stored))
# (another salt each time: the same password, another hash)
print(crypto.hash_password("correct horse", iterations = 1000) != stored)
# (one made elsewhere, by Python's hashlib with this salt; and texts that are not such a hash)
py = "pbkdf2-sha256$1000$c2FsdHNhbHRzYWx0c2FsdA==$RilxBxnvGa3JIyaXwlUUKmvuPzxjHerJeqIuhiIvKNU="
print(crypto.check_password("hunter2", py))
print(crypto.check_password("hunter2", "hunter2"), crypto.check_password("x", "pbkdf2-sha256$0$AA==$AA=="), crypto.check_password("x", "bcrypt$10$a$b"))
print(crypto.constant_time_equal("token-1", "token-1"), crypto.constant_time_equal("token-1", "token-2"), crypto.constant_time_equal("abc", "abcd"))
print(crypto.constant_time_equal([u8(1), 2], [u8(1), 2]), crypto.constant_time_equal([u8(1), 2], [u8(1), 3]))
