# Map keys of every kind hash like they compare: unions, optionals, arrays (by their elements),
# requires: sloppy
# structs holding arrays, vectors, -0.0 and 0.0; removing a key keeps the others in order
struct P:
    name: str
    tags: int[]
u: {(int | str): int} = {}
u[1] = 10
u["1"] = 11
print(u[1], u["1"], u.len())
o: {int?: str} = {}
o[none] = "none"
o[3] = "three"
print(o[none], o[3])
a: {int[]: int} = {}
loop i in [0..100): a[[i, i + 1]] = i
print(a.len(), a[[41, 42]], a.get([42, 41]))
s: {P: int} = {}
s[P("a", [1])] = 1
s[P("a", [2])] = 2
print(s[P("a", [2])], s.len())
v: {vec2: int} = {}
v[vec2(0, 1)] = 7
print(v[vec2(-0.0, 1)])
f: {f64: int} = {}
f[0.0] = 42
f[-0.0] = 9
print(f.len(), f[0.0])
m = {"a": 1, "b": 2, "c": 3, "d": 4}
m.remove("b")
print(m.keys(), m.values(), m["d"])
print(hash([1, 2, 3]) == hash([1, 2, 3]), hash([1]) == hash([2]))
