# requires: sloppy
# inputs made while a session waits are played after, in turn (a tap is not lost), and delay
# changed after the session is made, longer or shorter, still plays
import netplay

struct Pad:
    x = 0
    p = false
struct G:
    x = 0
    taps = 0
    held = false

tick = (g: G, pads: Pad[]) -> G:
    let g = g
    g.x += pads[0].x + pads[1].x
    if pads[0].p and not g.held: g.taps += 1
    g.held = pads[0].p
    g

run = (delay: int, stall: bool) -> (G, G, int):
    a = netplay.session(G(), tick, players = 2, me = 0)
    b = netplay.session(G(), tick, players = 2, me = 1)
    a.delay = delay
    b.delay = delay
    link = netplay.Link(latency = 0.03)
    now = 0.0
    taps = 0
    loop frame in 0..300:
        now += 1.0 / 60.0
        frozen = stall and frame >= 100 and frame < 116
        pa = Pad(x = 1)
        if frame >= 100 and frame < 116 and frame % 4 == 0:
            pa.p = true
            taps += 1
        a.play(pa)
        if not frozen: b.play(Pad(x = 1))
        loop o in a.outgoing(): link.send(o.0, o.1, now)
        loop o in b.outgoing(): link.send(o.0, o.1, now)
        loop d in link.deliver(now):
            if d.0 == 0: a.receive(d.1)
            else if not frozen: b.receive(d.1)
            else: link.send(d.0, d.1, now)
    (a.state, b.state, taps)

r = run(2, true)
print("taps made {r.2}, played {r.0.taps} and {r.1.taps}")
loop d in [4, 1, 0]:
    q = run(d, false)
    print("delay {d}: moving {q.0.x > 400}, the same {q.0.x == q.1.x or abs(q.0.x - q.1.x) < 10}")

# a replay from inputs_at gives the same game as was played
a = netplay.session(G(), tick, players = 2, me = 0)
b = netplay.session(G(), tick, players = 2, me = 1)
link = netplay.Link(latency = 0.05, jitter = 0.02)
now = 0.0
saved = 0
replay: Pad[][]
loop frame in 0..200:
    now += 1.0 / 60.0
    a.play(Pad(x = frame % 3, p = frame % 7 == 0))
    b.play(Pad(x = frame % 5))
    loop o in a.outgoing(): link.send(o.0, o.1, now)
    loop o in b.outgoing(): link.send(o.0, o.1, now)
    loop d in link.deliver(now):
        if d.0 == 0: a.receive(d.1)
        else: b.receive(d.1)
    loop saved < a.confirmed():
        replay.push(a.inputs_at(saved))
        saved += 1
# (the inputs that came last are played again at the next play)
a.play(Pad())
g = G()
loop pads in replay: g = tick(g, pads)
c = saved
print("replayed {replay.len()} ticks, confirmed {c}: the same {g == a.__states[c % 128]}")
