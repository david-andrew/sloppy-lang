# requires: sloppy
# lib/term.jo: a terminal's input bytes made into events (keys, modifiers, the mouse, pastes)
import term

show = (s: str):
    print(join([loop e in term.decode(bytes(s)): str(e)], ", "))

show("ab Zé日😀")
show("\r\t\x7f\x08\x1b[Z\x1b[3~\x1b[2~")
show("\x1b[A\x1b[B\x1b[C\x1b[D\x1bOA\x1b[H\x1b[F\x1b[1~\x1b[4~\x1b[7~\x1b[8~\x1b[5~\x1b[6~")
show("\x1bOP\x1bOQ\x1bOR\x1bOS\x1b[15~\x1b[17~\x1b[18~\x1b[19~\x1b[20~\x1b[21~\x1b[23~\x1b[24~\x1b[[A\x1b[[E")
show("\x01\x03\x1a\x00\x1c\x1d\x1e\x1f")
show("\x1bx\x1bX\x1b\x01\x1b\r\x1b\x7f\x1b\x1b")
show("\x1b[1;5A\x1b[1;2B\x1b[1;3C\x1b[1;4D\x1b[1;6H\x1b[1;7F\x1b[1;5P\x1b[1;2S\x1b[5;5~\x1b[3;3~\x1b[15;2~\x1b\x1b[A")
show("\x1b[13;2u\x1b[97;5u\x1b[27;5;105~\x1b[9;2u")
show("\x1b[<0;1;1M\x1b[<0;1;1m\x1b[<1;5;7M\x1b[<2;5;7M\x1b[<34;9;9M\x1b[<35;3;4M\x1b[<64;2;2M\x1b[<65;2;2M\x1b[<66;2;2M\x1b[<20;8;8M")
show("\x1b[M !!\x1b[M#!!")
show("\x1b[200~line one\r\nline two\rthree\x1b[201~z")
show("\x1b[I\x1b[O\x1b[99zq")
show("\x1b")
show("\x1b[")
show("\x1b[1;5")

# the fields of one
e = term.decode(bytes("\x1b[1;5A"))[0]
print(e.kind, e.key, e.ctrl, e.alt, e.shift, e.name)
c = term.decode(bytes("\x03"))[0]
print(c.key, c.text, c.ctrl, c.name)
m = term.decode(bytes("\x1b[<2;11;21M"))[0]
print(m.kind, m.mouse, m.button, m.x, m.y)
p = term.decode(bytes("\x1b[200~a\r\nb\x1b[201~"))[0]
print(p.kind, to_json(p.text))
