# division and remainder by constants (release builds multiply by a magic number instead), for
# signed values at the edges
ds = [3, 5, 7, 10, 12, 1000, 2000000, 641, 1000000007, 9223372036854775807]
ns = [0, 1, -1, 2, -2, 99, -99, 1000001, -1000001, 9223372036854775807, -9223372036854775807 - 1, 123456789123, -987654321987]
bad = 0
check = (n: int, q: int, r: int, d: int):
    if q * d + r != n or (r != 0 and (r < 0) != (n < 0)) or abs(r) >= abs(d): print("BAD", n, d, q, r)
loop n in ns:
    check(n, n / 3, n % 3, 3)
    check(n, n / 5, n % 5, 5)
    check(n, n / 7, n % 7, 7)
    check(n, n / 10, n % 10, 10)
    check(n, n / 12, n % 12, 12)
    check(n, n / 1000, n % 1000, 1000)
    check(n, n / 2000000, n % 2000000, 2000000)
    check(n, n / 641, n % 641, 641)
    check(n, n / 1000000007, n % 1000000007, 1000000007)
    check(n, n / 9223372036854775807, n % 9223372036854775807, 9223372036854775807)
loop n in ns: print(n / 7, n % 7, n / 1000000007)
