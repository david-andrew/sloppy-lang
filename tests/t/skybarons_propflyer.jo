# requires: sloppy
# Sky Barons: the propeller pack, a person flying on a propeller on their back (kind PROPPACK): slower and
# more fragile than the rocketeer but quicker to turn, a pistol and no rockets; offered by the lobby in the
# fights with the usual craft; flown by a player and by the computer; standing on the ground as the
# rocketeer does; its first-pick start in the air or on the field
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

# (its numbers against the rocketeer's: the top speed is what its thrust and drag come to)
top = (k: int) -> int: int(sqrt(KINDS[k].thrust / KINDS[k].drag))
print("{KIND_NAMES[PROPPACK]}: top speed {top(PROPPACK)} m/s (the rocketeer's {top(ROCKETEER)}), hull {KINDS[PROPPACK].health} ({KINDS[ROCKETEER].health}), turns {KINDS[PROPPACK].roll_rate} ({KINDS[ROCKETEER].roll_rate}), rockets {KINDS[PROPPACK].rockets}, one seat {KINDS[PROPPACK].seats.len()}")

# (where it is offered)
let dg = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false), [])
let bs = new_game([0, -1, -1, -1], 0.65, Rules(mode = BOSS, attackers = 0, defenders = 1), [])
print("offered in a dogfight: {PROPPACK in pick_kinds(dg)}; in The Boss, as ever its own list: {PROPPACK in pick_kinds(bs)}")

# (a player flies it, in the air: flat out in a few seconds, never past its top speed; the stick let go, level)
let air = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false), [PROPPACK])
loop t in 0..60: air = tick(air, [Pad()])
p = air.people[0]
print("the player starts in the air as a {KIND_NAMES[air.crafts[p.craft].kind]}: {p.state == SEATED}")
fast = 0.0
loop t in 0..600:
    air = tick(air, [Pad(throttle = 1)])
    fast = max(fast, f64(length(air.crafts[air.people[0].craft].vel)))
print("flat out for 10 s: top {int(fast)} m/s, within its top speed {fast <= f64(top(PROPPACK)) + 1.0}")
# (rolled over, the stick let go: upright again, as a rocketeer's)
let tilted = air
c = tilted.crafts[tilted.people[0].craft]
tilted.crafts[tilted.people[0].craft].rot = quat_mul(c.rot, quat_axis_angle(vec3(0, 0, -1), 2.2))
before = f64(up_of(tilted.crafts[tilted.people[0].craft]).y)
loop t in 0..300: tilted = tick(tilted, [Pad(throttle = 1)])
print("on its side then upright again: {before < 0.0}, {f64(up_of(tilted.crafts[tilted.people[0].craft]).y) > 0.6}")
# (its pistol: a bullet or more with the trigger held, no rockets)
shots = air.bullets.len() + air.shots.len()
let fire = air
loop t in 0..40: fire = tick(fire, [Pad(throttle = 1, fire = true)])
print("held the trigger: bullets {fire.bullets.len() > 0}, rockets {fire.crafts[fire.people[0].craft].rockets}")

# (on the field: it stands there, upright as the rocketeer does; a player in it takes off along the strip)
let gr = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = true), [PROPPACK])
loop t in 0..120: gr = tick(gr, [Pad()])
gk = -1
loop j in 0.. and c in gr.crafts:
    if gk < 0 and c.kind == PROPPACK and c.landed and not c.free: gk = j
print("on the field: a propeller pack stands there {gk >= 0}")
gr.crafts[gk].seats[0] = 0
gr.people[0].state = SEATED
gr.people[0].craft = gk
gr.people[0].seat = 0
loop t in 0..420: gr = tick(gr, [Pad(throttle = 1, pitch = 40)])
gq = gr.crafts[gk]
print("after a take-off run: flying {not gq.landed}, the way it was pointing kept up in the air {f64(gq.pos.y) > f64(ground(f64(gq.pos.x), f64(gq.pos.z))) + 3.0}")

# (the computer's: six a side with nothing else, three minutes, nobody crashing the game)
let cf = new_game(fill(-1, 12), 0.65, Rules(mode = DOGFIGHT, crafts = 1 << PROPPACK, ground_start = false), [])
loop t in 0..60 * 120: cf = tick(cf, [])
n = 0
loop c in cf.crafts:
    if not c.free and c.kind == PROPPACK: n += 1
print("computer's packs after two minutes: some flying {n > 0}, shot down so far {cf.scores[0] + cf.scores[1] > 0}")
