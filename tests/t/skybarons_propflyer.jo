# requires: sloppy
# Sky Barons: the propeller pack, a person lying flat in the air on a steam engine and a disc of blades on their
# back (kind PROPPACK): a helicopter, holding where it is, leaning to go, the back's way the lift's; small and
# fragile, a pistol and no rockets; offered by the lobby in the fights with the usual craft; flown by a player
# and by the computer; standing upright on the ground as the rocketeer does
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

# (its numbers against the rocketeer's: a helicopter, so no top speed of its own but its lean)
print("{KIND_NAMES[PROPPACK]}: hull {KINDS[PROPPACK].health} ({KINDS[ROCKETEER].health}), a helicopter {KINDS[PROPPACK].heli}, rockets {KINDS[PROPPACK].rockets}, one seat {KINDS[PROPPACK].seats.len()}, lifts off at {int(10.3 / KINDS[PROPPACK].thrust * 100.0)} percent power, holds itself up at {int(9.8 / KINDS[PROPPACK].thrust * 100.0)} percent")

# (where it is offered)
let dg = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false), [])
let bs = new_game([0, -1, -1, -1], 0.65, Rules(mode = BOSS, attackers = 0, defenders = 1), [])
print("offered in a dogfight: {PROPPACK in pick_kinds(dg)}; in The Boss, as ever its own list: {PROPPACK in pick_kinds(bs)}")

# (a player flies it, in the air: held where it is with the controls let go, it stays within a few meters)
let air = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false), [PROPPACK])
loop t in 0..60: air = tick(air, [Pad()])
p = air.people[0]
print("the player starts in the air as a {KIND_NAMES[air.crafts[p.craft].kind]}: {p.state == SEATED}")
hold = (g: Game, face: vec3, want: vec3) -> Pad: heli_vel(g.crafts[g.people[0].craft], want, 0.0, face)
let h0 = air
y0 = f64(h0.crafts[h0.people[0].craft].pos.y)
loop t in 0..600:
    c0 = h0.crafts[h0.people[0].craft]
    h0 = tick(h0, [hold(h0, fwd_of(c0), vec3(0, 0, 0))])
c1 = h0.crafts[h0.people[0].craft]
print("held in the air for 10 s: still {f64(length(c1.vel)) < 3.0}, height kept {abs(f64(c1.pos.y) - y0) < 12.0}, flat on its front, its back up {f64(up_of(c1).y) > 0.9}")
# (it goes the way it leans: 30 m/s ahead, the fan tipped forward with it, the body still more or less flat to the way it goes)
let go = air
loop t in 0..600:
    c0 = go.crafts[go.people[0].craft]
    nf = vec3(fwd_of(c0).x, 0, fwd_of(c0).z)
    go = tick(go, [hold(go, nf, normalize(nf) * 30.0)])
c2 = go.crafts[go.people[0].craft]
sp = f64(length(vec3(c2.vel.x, 0, c2.vel.z)))
print("sent ahead at 30 m/s: {int(sp)} m/s, its back tipped {f64(up_of(c2).y) < 0.95 and f64(up_of(c2).y) > 0.6}")
# (the stick let go, it levels itself and holds: the lean runs out)
let rest = go
loop t in 0..600:
    c0 = rest.crafts[rest.people[0].craft]
    rest = tick(rest, [hold(rest, fwd_of(c0), vec3(0, 0, 0))])
c3 = rest.crafts[rest.people[0].craft]
print("let go: still again {f64(length(c3.vel)) < 3.0}, level again {f64(up_of(c3).y) > 0.97}")
# (its pistol: a bullet or more with the trigger held, no rockets)
let fire = air
loop t in 0..40: fire = tick(fire, [Pad(fire = true)])
print("held the trigger: bullets {fire.bullets.len() > 0}, rockets {fire.crafts[fire.people[0].craft].rockets}")

# (on the field: it stands there, upright as the rocketeer does; a player in it takes off along the strip)
let gr = new_game([0, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = true), [PROPPACK])
loop t in 0..120: gr = tick(gr, [Pad()])
gk = -1
loop j in 0.. and c in gr.crafts:
    if gk < 0 and c.kind == PROPPACK and c.landed and not c.free: gk = j
print("on the field: a propeller pack stands there, upright {gk >= 0 and abs(f64(up_of(gr.crafts[gk]).y)) < 0.2}")
gr.crafts[gk].seats[0] = 0
gr.people[0].state = SEATED
gr.people[0].craft = gk
gr.people[0].seat = 0
loop t in 0..420: gr = tick(gr, [Pad(throttle = 1)])
gq = gr.crafts[gk]
print("after 7 s at full power: flying {not gq.landed}, up in the air {f64(gq.pos.y) > f64(ground(f64(gq.pos.x), f64(gq.pos.z))) + 3.0}, lying flat on its front {f64(up_of(gq).y) > 0.9}")

# (the computer's: six a side with nothing else, three minutes, nobody crashing the game)
let cf = new_game(fill(-1, 12), 0.65, Rules(mode = DOGFIGHT, crafts = 1 << PROPPACK, ground_start = false), [])
loop t in 0..60 * 120: cf = tick(cf, [])
n = 0
loop c in cf.crafts:
    if not c.free and c.kind == PROPPACK: n += 1
print("computer's packs after two minutes: some flying {n > 0}, shot down so far {cf.scores[0] + cf.scores[1] > 0}")
