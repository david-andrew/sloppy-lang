# requires: sloppy
# text(..., mono = true): every character in a cell of one width, so formatted columns line up
print(text_width("abc", 20, mono = true) == text_width("MW.", 20, mono = true))
print(text_width("ab\ncde", 20, mono = true) == text_width("xyz", 20, mono = true), text_width("Zoë", 20, mono = true) == text_width("Zoe", 20, mono = true))
print(text_width("iii", 20) < text_width("iii", 20, mono = true), text_width("", 20, mono = true))
