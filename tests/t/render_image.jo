# requires: native
# requires: sloppy
# render_image: a picture drawn by a function, with no window (the software renderer), at
# exactly its size; a game's window opened after it still works
img = render_image(40, 30, ():
    clear(WHITE)
    rect(10, 10, 20, 10, rgb(1, 0, 0)))
px = (x: int, y: int) -> str:
    i = (y * img.width + x) * 4
    "{img.pixels[i]},{img.pixels[i + 1]},{img.pixels[i + 2]},{img.pixels[i + 3]}"
print(img.width, img.height, px(0, 0), px(15, 15), px(35, 25))
