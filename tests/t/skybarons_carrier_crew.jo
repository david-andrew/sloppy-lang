# requires: sloppy
# Sky Barons' flying carrier and the crew call: its pilot sat down on the field calls its side for
# its gun seats alone (thirteen, not its hooks' sixteen craft, its airmen's); J puts one at a gun,
# never in a hook's craft nor a hook with none on it; the call full when its guns are
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
fresh = () -> Game:
    let g = new_game([0, 1, -1, -1, 2, -1, 3, -1] + fill(-1, 24), 0.65, Rules(mode = DOGFIGHT, crafts = DEFAULT_CRAFTS | (1 << CARRIER)), [])
    loop i in 0..g.people.len():
        g.people[i].state = DEAD
        g.people[i].timer = 1000000
    g
first = (g: Game, kind: int, team: int) -> int:
    loop j in 0.. and c in g.crafts:
        if c.kind == kind and c.team == team and not c.free: return j
    -1
sit = (g: mut Game, i: int, j: int, s: int):
    g.crafts[j].seats[s] = i
    g.people[i].state = SEATED
    g.people[i].craft = j
    g.people[i].seat = s
stand = (g: mut Game, i: int, at: vec3):
    g.people[i].state = WALK
    g.people[i].craft = -1
    g.people[i].pos = vec3(at.x, f32(ground(f64(at.x), f64(at.z))), at.z)
pads = (a: Pad = Pad(), b: Pad = Pad(), c: Pad = Pad(), d: Pad = Pad()) -> Pad[]: [a, b, c, d]

let g = fresh()
fk = first(g, CARRIER, 0)
print("red's carrier parked: crewed {crewed(CARRIER)}, {crew_seats(CARRIER)} seats called for, {room(g.crafts[fk])} free, crew of the computer's {call_crew(g, CARRIER)}")
# (all its gun seats but one taken, the last hook shut: player 2 answers into that gun, not a hook)
sit(g, 0, fk, 0)
loop s in 1..HOOK0 - 1: sit(g, 6 + 2 * s, fk, s)
g.crafts[fk].hung[15] = -1
g.crafts[fk].seats[HOOK0 + 15] = SHUT
g = tick(g, pads())
print("its pilot sat: calling {calling(g, fk)}, {room(g.crafts[fk])} gun seat free")
stand(g, 4, foot_spawn(0, 3))
g = tick(g, pads(Pad(), Pad(), Pad(join = true)))
loop k in 0..CALL_FADE + 1: g = tick(g, pads())
print("J: player 2 in seat {g.people[4].seat} ({if g.people[4].seat >= HOOK0: "a hook" else: "a gun"}); room {room(g.crafts[fk])}; calling {calling(g, fk)}")
# (the guns full, its hooks' craft empty: no more answer)
stand(g, 6, foot_spawn(0, 4))
g = tick(g, pads(Pad(), Pad(), Pad(), Pad(join = true)))
loop k in 0..CALL_FADE + 1: g = tick(g, pads())
print("another J, the guns full: player 3 joining {g.people[6].joining}, state {g.people[6].state}; hook seat 15 {g.crafts[fk].seats[HOOK0 + 15]}")
