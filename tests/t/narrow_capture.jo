# A closure using a name narrowed by `is` captures the variable itself: it sees later changes
# requires: sloppy
f = ():
    x: int | str = 7
    if x is int:
        g = (): print(x + 1)
        x = 10
        g()
    y: int | str | f64 = 3
    if y is int or y is str:
        if y is int:
            h = (): print(y * 2)
            y = 21
            h()
    w: int | str = 1
    if w is int:
        m = (): print(w)
        m()
f()
