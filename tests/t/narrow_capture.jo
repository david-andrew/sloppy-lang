# A closure using a name narrowed by `is` captures the variable itself: it sees later changes
# requires: sloppy
f = ():
    x: int | str = 7
    if x is int:
        g = (): print(x + 1)
        x = 10
        g()
    y: int | str | f64 = 3
    if y is int or y is str:
        if y is int:
            h = (): print(y * 2)
            y = 21
            h()
    w: int | str = 1
    if w is int:
        m = (): print(w)
        m()
    v: int | str = 1
    if v is int:
        set4 = (): v = 4
        set4()
        print(v)
        outer = ():
            v = 5
            inner = ():
                v += 1
                v
            inner
        gi = outer()
        print(gi(), v, gi(), v)
f()
