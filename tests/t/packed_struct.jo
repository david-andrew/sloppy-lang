# requires: sloppy
# @packed: fields one right after another, as C's __attribute__((packed)) (epoll_event is one)
@packed
struct EpollEvent:
    events: u32
    data: u64

struct Pair:
    a: u8
    b: f64

@packed
struct Odd:
    tag: u8
    x: f64
    y: i16
    z: f32
    p: Pair
    w: i32

print(size_of(EpollEvent), size_of(Odd), size_of(Pair))
e = EpollEvent(1, 0x1122334455667788)
print(e.events, e.data)
e.data += 1
print(e.data)

# an array of them: each 12 bytes after the one before, its u64 at 4 bytes past a multiple of 4
evs = [loop i in [0..5): EpollEvent(u32(i), u64(i) * 1000000000000)]
evs[3].data = 7
total: u64 = 0
loop ev in evs: total += ev.data + u64(ev.events)
print(total, evs[4].data)

# read from bytes as C would have written them
b = fill(u8(0), 24)
b[0] = 5
b[4] = 0xEF
b[11] = 0x01
b[12] = 9
b[16] = 0x10
p = data(b) as *EpollEvent
print(p[0].events, p[0].data, p[1].events, p[1].data)
p[1].data = 0xAABB
print(b[16], b[17], b[18])

o = Odd(1, 2.5, -3, 1.5, Pair(4, 0.25), -77)
o.x *= 2.0
o.p.b += 1.0
o.y -= 1
print(o.tag, o.x, o.y, o.z, o.p.a, o.p.b, o.w)
os = [o, o]
os[1].w = 123
print(os[0].w, os[1].w, os[1].p.b)
