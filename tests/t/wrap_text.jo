# requires: sloppy
# text measured before there is a window: the widest line, the height of lines, wrapping at spaces
print(text_width("ab\nabcd") == text_width("abcd"))
print(text_height("a"), text_height("a\nb\nc"))
print(wrap_text("the quick brown fox jumps over the lazy dog", text_width("the quick brown"), 20.0))
print(wrap_text("one\n\ntwo  three", 1000.0))
print(wrap_text("supercalifragilistic word", 30.0))
