# requires: native
# requires: sloppy
# env: SLOPPY_NO_DRAW=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=7
# env: SLOPPY_INPUT=1:pad1_name=Thrustmaster T.16000M, 2:pad1_axis0=0.25 2:pad1_axis3=-0.4 3:pad1_button0+ 4:pad1_button7+ 5:pad1_button0- 5:pad1_axis0=1 2:pad_axis1=0.5 3:pad_button2+ 2:pad3_button0+ 3:pad3_button1+ 4:pad3_button2+ 4:pad3_axis2=-1 1:pad4_name=Pedals 1:pad4_standard=1
# SLOPPY_INPUT's raw joystick: a flight stick (pad 1, named, with its own axes and buttons), pad 0
# by the short names, pad 3 counting up to the highest axis and button used (only frame 4's
# button pressed then), and pad 4 named but said to be standard
update = (dt: f64):
    f = frame_number()
    if f == 0: print("before: connected {gamepad_connected(1)}, axes {joystick_axes(1)}, standard {gamepad_standard(1)}, name '{gamepad_name(1)}'")
    if f >= 1 and f <= 5:
        print("{f}: '{gamepad_name(1)}' standard {gamepad_standard(1)}, {joystick_axes(1)} axes {joystick_buttons(1)} buttons: axis0 {joystick_axis(1, 0):.2} axis3 {joystick_axis(1, 3):.2} button0 {joystick_button(1, 0)} pressed0 {joystick_pressed(1, 0)} button7 {joystick_button(1, 7)}")
    if f == 3: print("pad 0: '{gamepad_name(0)}' standard {gamepad_standard(0)}, {joystick_axes(0)} axes {joystick_buttons(0)} buttons, axis1 {joystick_axis(0, 1):.2} button2 {joystick_button(0, 2)}")
    if f == 4:
        print("pad 3: {joystick_axes(3)} axes {joystick_buttons(3)} buttons, axis2 {joystick_axis(3, 2):.2}")
        loop i in [0..3): print("pad 3 button{i}: down {joystick_button(3, i)} pressed {joystick_pressed(3, i)}")
        print("pad 4: '{gamepad_name(4)}' standard {gamepad_standard(4)}, {joystick_axes(4)} axes {joystick_buttons(4)} buttons, axis2 {joystick_axis(4, 2):.2}")
    # (the standard readers do not see a joystick's own controls)
    if f == 5: print("standard: axis0 {gamepad_axis(1, 0):.2}, a {gamepad_down(1, .a)}")
    if f == 6: print("gone: standard {gamepad_standard(6)}, name '{gamepad_name(6)}', axes {joystick_axes(6)}")
