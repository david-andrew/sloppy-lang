# Signed division and remainder wrap: the smallest integer / -1 is itself, % -1 is 0, on every target
# requires: sloppy
r = (a: int, b: int): a % b
q = (a: int, b: int): a / b
q32 = (a: i32, b: i32): a / b
r32 = (a: i32, b: i32): a % b
main = ():
    m = -9223372036854775807 - 1
    print(r(m, -1), q(m, -1), q(7, -1), r(7, -1), q(-7, 2), r(-7, 2))
    print(q32(-2147483647 - 1, -1), r32(-2147483647 - 1, -1))
    x = m
    x /= -1
    y = m
    y %= -1
    print(x, y)
    print(m / -1, m % -1)
