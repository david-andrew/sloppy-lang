# requires: sloppy
# (x is E ruled out on an x: (A | E)?: x is an A?, whichever test comes first)
struct E: m = ""
struct F: k = 0
f = (x: int) -> (str, int)? | E:
    if x == 1: return E("bad")
    if x == 2: return none
    ("a", x)
g = (i: int):
    p = f(i)
    if p is E: return
    q: (str, int)? = p
    print("q", q)
    if p == none: return
    a, b = p
    print(a, b)
g(1); g(2); g(3)
h = (i: int):
    p = f(i)
    if p is E: return
    if p is none: return
    a, b = p
    print(a, b)
h(4)
k = (i: int) -> (int | E | F)?:
    if i == 0: return E("e")
    if i == 1: return F(1)
    if i == 2: return none
    i
loop i in [0..4):
    v = k(i)
    if v is E or v is F:
        print("err")
        continue
    if let n = v: print(n + 1)
    else: print("none")
loop i in [0..4):
    v = k(i)
    if v is E: continue
    if v is F: continue
    print(v ?? -1)
struct Box: r: (int | E)?
bx = Box(E("x"))
loop i in [0..3):
    if i == 1: bx.r = none
    if i == 2: bx.r = 7
    if bx.r is E: continue
    w: int? = bx.r
    print("box", w)
