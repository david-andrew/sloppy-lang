# requires: sloppy
# unwrap of an error result stops the program, telling the error
error struct BadNumber:
    text: str
num = (s: str) -> int | BadNumber:
    if let n = to_int(s): return n
    BadNumber(s)
print(num("4").unwrap())
m = {"a": 1}
print(m.get("a").unwrap(), m.get("a").expect("a is in the map"))
print(num("four").unwrap())
