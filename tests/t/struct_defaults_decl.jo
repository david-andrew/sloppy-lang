# requires: sloppy
# x: T for a struct with default field values starts with them (locals, globals, a field left
# out whose struct has defaults, array and map elements made from them)
struct A:
    x = 5
    name = "a"
    y: int
struct B:
    a: A
    k = 2
struct C:
    v: int
g: A
f = ():
    l: A
    b: B
    c: C
    print(l, b, c)
    bb = B(k = 3)
    print(bb)
f()
print(g)
xs: A[]
xs.push(A(y = 1))
print(xs)
m: {str: A}
m["q"].y += 1
print(m)
