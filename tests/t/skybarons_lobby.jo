# requires: sloppy
# Sky Barons' lobby: what its choices can hand the rules. Every fight is set out and run a few ticks
# with every side-size, every side that may attack (the two sides; and the values a lobby's list
# could wrongly offer), the Boss's every defender choice, a spread of the wins and minutes the lists
# offer, the ground or the air, friendly fire, markers; none of them may panic, and each fight's
# tables (names, kinds it can have and must, its own win and minutes) must have an entry
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

# (the choices the lobby's lists offer, as skybarons.jo has them)
DEFENDERS = [-3, -4, -2, 1, 2, 3, 4, 6, 8]
WINS = [0, 1, 3, 5, 10, 60, 200, 600]
MINUTES = [0, 3, 5, 6, 8, 10, 15, 40]

print("fights {MODE_NAMES.len()}, can {MODE_CAN.len()}, must {MODE_MUST.len()}")
runs = 0
loop m in 0..MODE_NAMES.len():
    if MODE_CAN.len() <= m or MODE_MUST.len() <= m: print("fight {m} has no table entry")
    set_map(if m == TRENCH: GORGE else: FARMLAND, 0)
    loop size in [1, 3, 8, 24]:
        loop att in [0, 1, 2, -1, 7]:
            loop def in (if m == BOSS: DEFENDERS else: [0]):
                d = if def < 0: (size - def - 1) / (-def) else: def
                loop ground in [false, true]:
                    loop ff in [false, true]:
                        w = WINS[(runs + att + 3) % WINS.len()]
                        t = MINUTES[(runs + size) % MINUTES.len()]
                        r = Rules(mode = m, friendly_fire = ff, ground_start = ground, win = w, time_limit = t,
                                  attackers = att, crafts = 0, plain = ff, defenders = clamp(d, 1, size))
                        let g = new_game(fill(-1, 2 * size), 0.65, r, [])
                        loop k in 0..20: g = tick(g, [])
                        runs += 1
print("{runs} fights set out and run")

# (every fight's every lobby choice for its crafts: each kind it lists, alone)
loop m in 0..MODE_NAMES.len():
    set_map(if m == TRENCH: GORGE else: FARMLAND, 0)
    loop k in 0..CHOOSABLE:
        if MODE_CAN[m] & (1 << k) == 0: continue
        let g = new_game(fill(-1, 6), 0.65, Rules(mode = m, crafts = (1 << k) | MODE_MUST[m]), [])
        loop t in 0..10: g = tick(g, [])
print("each kind alone in each fight: ran")
