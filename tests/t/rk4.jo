# rk4: a number, a vector, an f64[], a struct with its own + and *
# y' = -y from 1: e^-t
y = 1.0
t = 0.0
loop _ in [0..10):
    y = rk4(y, t, 0.1, (y: f64, t: f64) -> f64: -y)
    t += 0.1
print("decay: {y:.7} (e^-1 = {exp(-1.0):.7})")
# a spring, (position, speed): after a whole period, back where it began
s = vec2(1, 0)
w = 2.0 * PI
loop _ in [0..100): s = rk4(s, 0.0, 0.01, (s: vec2, t: f64) -> vec2: vec2(s.y, f32(-w * w) * s.x))
print("spring: {s.x:.3} {s.y:.3}")
# an orbit, [x, y, vx, vy] round a sun at the origin (GM = 1): a circle stays one
o = [1.0, 0.0, 0.0, 1.0]
loop _ in [0..628): o = rk4(o, 0.0, 0.01, (o: f64[], t: f64) -> f64[]:
    r3 = pow(o[0] * o[0] + o[1] * o[1], 1.5)
    [o[2], o[3], -o[0] / r3, -o[1] / r3])
print("orbit: r = {sqrt(o[0] * o[0] + o[1] * o[1]):.5}")
# a falling ball with drag: a struct with + and * of its own
struct Ball:
    h: f64
    v: f64
(+) = (a: Ball, b: Ball) -> Ball: Ball(a.h + b.h, a.v + b.v)
(*) = (a: Ball, k: f64) -> Ball: Ball(a.h * k, a.v * k)
b = Ball(100.0, 0.0)
loop _ in [0..1000): b = rk4(b, 0.0, 0.01, (b: Ball, t: f64) -> Ball: Ball(b.v, -9.81 - 0.1 * b.v))
print("ball: speed {b.v:.3} (worked out: {-98.1 * (1.0 - exp(-1.0)):.3})")
