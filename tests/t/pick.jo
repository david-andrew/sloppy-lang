# requires: sloppy
# xs[mask] (a bool[]) and xs[idxs] (an int[]) pick elements; xs[mask] = v and xs[idxs] = vs set them
a = [1.0, -2.0, 3.0, -4.0]
print(a[a .> 0.0])
print(a[[3, 0]])
print(a[argsort(a)])
a[a .< 0.0] = 0.0
print(a)
b = [5, 6, 7]
b[[0, 2]] = [50, 70]
print(b)
names = ["x", "y", "z"]
keep = [true, false, true]
print(names[keep])
i = 1
print(a[i], a[1..])
s = 0.0
m = a .> 0.5
loop x in a[m]: s += x
print(s)
