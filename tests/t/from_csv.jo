# requires: sloppy
# from_csv: rows as structs, columns by the header's names (empty or NA: NaN or none), numbers checked; blank lines skipped
enum Region: north, south
struct Sale:
    date = ""
    region = Region.north
    unit_price = 0.0
    units = 0
    discount: f64? = none
    note: str? = none
text = "Date,Region,Unit Price,Units,Discount,Extra\n2026-01-02,north,9.5,3,,x\n2026-01-03,south,NA,4,0.25,y\n\n2026-01-04,south,1000.5,,0.1,z\n"
r = from_csv[Sale](text)
if r is TextError: print("error:", r.message)
else:
    loop s in r: print(s)
bad = from_csv[Sale]("units,unit_price\n2,abc\n")
if bad is TextError: print(bad.message)
bad2 = from_csv[Sale]("region\neast\n")
if bad2 is TextError: print(bad2.message)
print(csv_rows("a,b\n\n1,2\n\n"))
