# requires: sloppy
# dates from unix time (UTC, before 1970, a leap day), back again, POSIX time zone rules (both
# hemispheres, half hours, <+03>); path parts and joining; is_symlink of a missing file
u = date(0.0, utc = true)
print(date_text(u), weekday_name(u), month_name(u))
print(date_text(date(1700000000.0, utc = true)), date_text(date(-1.0, utc = true)), date_text(date(951782400.0, utc = true)))
print(unix_time(date(1700000000.0, utc = true)), unix_time(Date(2024, 13, 1, 0, 0, 0, 0, 0)))
print(__tz_posix("EST5EDT,M3.2.0,M11.1.0", 1689000000), __tz_posix("EST5EDT,M3.2.0,M11.1.0", 1700000000))
print(__tz_posix("CET-1CEST,M3.5.0,M10.5.0/3", 1689000000), __tz_posix("AEST-10AEDT,M10.1.0,M4.1.0/3", 1689000000), __tz_posix("AEST-10AEDT,M10.1.0,M4.1.0/3", 1700000000), __tz_posix("IST-5:30", 0), __tz_posix("<+03>-3", 0))
d = now()
print(d.month >= 1 and d.month <= 12, d.year >= 2024)
loop p in ["art/hero.png", "/abs/x.tar.gz", ".bashrc", "dir/", "/x", "a\\b\\c.txt"]:
    print("[{file_name(p)}] [{dir_name(p)}] [{extension(p)}] [{without_extension(p)}]")
print(join_path("art", "hero.png"), join_path("art/", "x"), join_path("a", "/abs"), is_symlink("no such file"))
