# requires: sloppy
# f32 overloads agree with f64 evaluation to f32 rounding tolerance across shader-sized inputs.
worst = 0.0
loop i in -1000..1001:
    x = f32(i) / 13.0
    worst = max(worst, abs(f64(sin(x)) - sin(f64(x))))
    worst = max(worst, abs(f64(cos(x)) - cos(f64(x))))
print(worst < 1e-6)
