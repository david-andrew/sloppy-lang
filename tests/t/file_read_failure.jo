# requires: sloppy
# requires: unix
# Force EBADF after buffering part of a line. Neither line nor byte reads may return a partial success.
p = join_path(temp_dir(), "sloppy_checked_failure")
assert(write_file(p, "line"))
f = open_file(p)!
syscall(3, f.handle)
f.buf = bytes("partial")
r = f.read_line()
print(r is FileError)
if r is FileError: print(r.operation, r.path == p, len(r.message) > 0)
assert(write_file(p, "ok"))
print(read_file(p).unwrap())
r2 = f.read_bytes(1)
print(r2 is FileError)
if r2 is FileError: print(r2.operation, len(r2.message) > 0)
f.handle = -1
f.close()
delete_file(p)

when TARGET == "linux":
    # procfs reports a zero file size, but must still be read until EOF.
    assert(len(read_file("/proc/self/statm").unwrap()) > 0)
    # A whole-file read can open this procfs file, then fail its actual read with EIO.
    assert(read_file("/proc/self/mem") is FileError)
