# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_particles.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
# No regular mesh is loaded by the game. The first late particle still needs no pipeline.
window("Particles prepared before emission", 160, 90)
ps: Particles3D
loaded = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk: loaded = __vg_pipeline_creations
update = (dt: f64):
    if frame_number() == 4: emit(ps, vec3(0, 0, 0), 4, 0.5, WHITE, life = 10.0)
    when TARGET != "wasm" and TARGET != "macos":
        if __vk:
            assert(__vg_pipeline_creations == loaded)
            loop p in __vgp:
                if p.warm_kind == 8 or p.warm_kind == 9 or p.warm_kind == 10 or p.warm_kind == 11:
                    assert(p.vs == 0 and p.fs == 0 and p.pipelines.len() == 0)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    ps.draw(glow = frame_number() < 6)
on_quit = ():
    when TARGET != "wasm" and TARGET != "macos":
        if __vk: assert(__vg_pipeline_creations == loaded)
    print("particles ready before emission")
