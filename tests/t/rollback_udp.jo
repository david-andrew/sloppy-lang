# requires: native (rollback netplay over UDP: two sessions in one program, on this machine)
# requires: sloppy (lib/netplay.jo)
import netplay

struct Pad:
    dx = 0
struct Game:
    pos: int[] = [0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

addrs = [("127.0.0.1", 47311), ("127.0.0.1", 47312)]
a = netplay.session(Game(), step, players = 2, me = 0)
b = netplay.session(Game(), step, players = 2, me = 1)
a.udp(47311, addrs)
b.udp(47312, addrs)
b.lag(40, 20, 0.1)                      # (b's packets: later, uneven, some lost)
loop _ in [0..300):
    a.play(pad(0, a.tick + a.delay))
    b.play(pad(1, b.tick + b.delay))
    sleep(1.0 / 240.0)
c = min(min(a.confirmed(), b.confirmed()), min(a.tick, b.tick)) - 1        # (simulated by both, with every input)
print("played", a.tick > 200, b.tick > 200, "confirmed", c > 150)
print("same game:", a.__states[c % 128] == b.__states[c % 128], "desync", a.desync, b.desync)
