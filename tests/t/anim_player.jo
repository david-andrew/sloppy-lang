# requires: native
# requires: sloppy
# AnimPlayer: a sheet's animations by name, each played from its first frame when it changes to
# it (the same one again goes on); draw_anim with a name; a non-looping one's end. Frames of
# exactly 1/60 s, so elapsed() is the frame number over 60.
# env: SLOPPY_SCREENSHOT=$TMP/anim_player.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=40
img = image(64, 16, WHITE)
hero = sprite_sheet(texture(img), 16, 16)
hero.anims["idle"] = animation(0, 1, 2.0)
hero.anims["run"] = animation([1, 2, 3], 20.0)
hero.anims["jump"] = animation([3], 10.0, false)
anim = anim_player(hero, "idle")
shown: int[]
update = (dt: f64):
    f = frame_number()
    if f >= 10 and f < 25: anim.play("run")
    if f >= 25: anim.play("jump")
    shown.push(anim.anim_frame())
    if f == 12 or f == 26 or f == 39: print("frame {f}: {anim.name}, {anim.anim_time():.3} s, frame {anim.anim_frame()}, done {anim.anim_done()}")
    if f == 39: print(shown)
draw = ():
    clear(BLACK)
    anim.draw(vec2(100, 100), 2.0, origin = vec2(0.5, 1))
    draw_anim(hero, "run", elapsed(), vec2(200, 100))
