# requires: native
# requires: sloppy
# hud_nav_focus: where the focus goes, as a screen opens (its first box inside the page, not the tab
# row above it) and as its page turns (asked after hud_nav in the frame: no focus for the rest of
# it, then on the new page's first line); a rectangle that is a box's takes the focus to that box
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=30
# env: SLOPPY_INPUT=8:enter+ 9:enter- 10:down+ 11:down- 12:pad_rb+ 13:pad_rb- 15:enter+ 16:enter- 18:n1+ 19:n1- 21:enter+ 22:enter- 24:enter+ 25:enter-
window("hud nav focus", 1280, 720)
screen = "title"
page = 0
was = "-"
tab = (i: int) -> Rect: Rect(100 + 220 * f32(i), 60, 200, 44)
page_rect = Rect(100, 140, 640, 500)
line = (k: int) -> Rect: Rect(120, 160 + 70 * f32(k), 600, 56)
draw = ():
    global page, screen, was
    clear(rgb(0.1, 0.12, 0.16))
    f = frame_number()
    # (the paper opens at frame 5, its focus on the page)
    if f == 5:
        screen = "paper"
        hud_nav_focus(page_rect)
    if key_pressed(.n1): hud_nav_focus(tab(2))
    hud_nav(true, screen)
    now = "-"
    if screen == "title":
        if hud_button(Rect(480, 300, 320, 44), "Play"): print("{f}: Play")
        if hud_nav_focused(Rect(480, 300, 320, 44)): now = "Play"
    else:
        loop i in [0..3):
            if hud_button(tab(i), "Page {i}", selected = i == page):
                print("{f}: tab {i}")
                page = i
            if hud_nav_focused(tab(i)): now = "tab {i}"
        loop k in [0..3):
            r = line(k)
            rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), rgb(0.9, 0.9, 0.85))
            if hud_nav_box(r): print("{f}: page {page} line {k}")
            if hud_nav_focused(r): now = "line {k}"
        if gamepad_pressed(.rb):
            page = (page + 1) % 3
            hud_nav_focus(page_rect)
            print("{f}: turned to page {page}")
    if now != was: print("{f}: focus {now}")
    was = now
