# Integer and conversion rules in compute functions, the same on the GPU and the CPU: unsigned
# division, remainder, shifts and comparisons; narrow types wrap; float to integer truncates
# and saturates (NaN to 0); bools convert to 0 and 1
# requires: sloppy
struct P:
    u: GpuBuffer[u32]
    f: GpuBuffer[f32]
    out_u: GpuBuffer[u32]
    out_i: GpuBuffer[i32]

kern = (id: int, p: P):
    x = p.u[0]
    y = p.u[1]
    p.out_u[0] = x / y
    p.out_u[1] = x % y
    p.out_u[2] = x >> u32(4)
    p.out_u[3] = u32(x > y)
    p.out_u[4] = u32(x < y)
    p.out_u[5] = u32(x >= u32(0x80000000))
    p.out_u[6] = u32(u8(x))
    p.out_u[7] = u32(u16(x))
    a: u8 = u8(200)
    a += u8(100)
    p.out_u[8] = u32(a)
    b: u8 = u8(3)
    p.out_u[9] = u32(b - u8(5))
    p.out_u[10] = u32(~b)
    p.out_u[11] = u32(p.f[0])
    p.out_u[12] = u32(p.f[1])
    p.out_u[13] = u32(u8(p.f[2]))
    p.out_u[14] = u32(f32(x))
    p.out_i[0] = i32(i8(x))
    p.out_i[1] = i32(i16(x))
    c: i8 = i8(100)
    c += i8(100)
    p.out_i[2] = i32(c)
    p.out_i[3] = i32(p.f[0])
    p.out_i[4] = i32(p.f[1])
    p.out_i[5] = i32(p.f[3])
    p.out_i[6] = i32(i8(p.f[2]))
    p.out_i[7] = i32(id == 0)
    p.out_i[8] = i32(-p.f[2])
    p.out_i[9] = i32(p.f[4])
    p.out_i[10] = i32(u16(p.f[4]))

main = ():
    nan = f32(0.0) / f32(0.0)
    p = P(gpu_buffer([u32(0xFFFFFFF3), u32(7)]), gpu_buffer([f32(1e10), f32(-5.0), f32(300.7), nan, f32(-7.9)]),
          gpu_buffer([loop i in [0..15): u32(0)]), gpu_buffer([loop i in [0..11): i32(0)]))
    dispatch(compute(kern), 1, p)
    print(cpu(p.out_u))
    print(cpu(p.out_i))
