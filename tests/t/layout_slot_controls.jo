# requires: sloppy
# requires: native
# The guide's slot recipe: explicit keyboard/gamepad handling plus the HUD's pointer input.
# env: SLOPPY_SCREENSHOT=$TMP/layout_slot_controls.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=32
# env: SLOPPY_INPUT=3:right+ 4:right- 6:down+ 7:down- 8:enter+ 9:enter- 12:pad_up+ 13:pad_up- 14:pad_left+ 15:pad_left- 18:pad_down+ 19:pad_down- 20:pad_a+ 21:pad_a- 24:mouse=230x38 25:mouse_left+ 26:mouse_left- 27:mouse=80x85 28:mouse_left+ 29:mouse_left-
import layout as ui

window("slot controls", 320, 240)
volume = 0.5
hints = true
draw = ():
    global volume, hints
    clear()
    ui.at(Rect(20, 20, 280, 200), ():
        ui.column(width = ui.grow(), gap = 12, ():
            ui.slot(width = ui.grow(), height = 36, focusable = true, key = "volume", (r: Rect):
                st = ui.get("volume") ?? ui.State()
                if st.focused:
                    if key_repeat(.left) or gamepad_repeat(.left): volume = max(0.0, volume - 0.05)
                    if key_repeat(.right) or gamepad_repeat(.right): volume = min(1.0, volume + 0.05)
                volume = hud_slider(r, volume, 0.0, 1.0)
            )
            ui.slot(width = ui.grow(), height = 36, focusable = true, key = "hints", (r: Rect):
                st = ui.get("hints") ?? ui.State()
                if st.focused and (key_pressed(.enter) or key_pressed(.space) or gamepad_pressed(.a)):
                    hints = not hints
                hints = hud_checkbox(r, "Show hints", hints)
            )
        )
    )
    if frame_number() == 10:
        assert(abs(volume - 0.55) < 0.00001 and not hints)
        print("keyboard adjusts focused slider and toggles checkbox")
    if frame_number() == 22:
        assert(abs(volume - 0.5) < 0.00001 and hints)
        print("gamepad adjusts focused slider and toggles checkbox")
    if frame_number() == 30:
        assert(volume > 0.7 and volume < 0.8 and not hints)
        print("pointer still adjusts slider and toggles checkbox")
