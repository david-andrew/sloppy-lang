# Reverse copies and two loop-carried memory-generation checks.
@noinline
reverse_case = (s: mut Cell, take: bool):
    local: mat4 = mat4(3)
    before = s.v[0].x
    s.v = local
    after = s.v[0].x
    if take: local = mat4(9)
    saved = s.v
    total = 0.0
    loop i in 0..3:
        old = s.v
        s.v[0].x += 1
        now = s.v
        total += f64(now[0].x) - f64(old[0].x)
    print("reverse", take, before, after, total, local[0].x, local[0].y, local[0].z, local[0].w, local[1].x, local[1].y, local[1].z, local[1].w, local[2].x, local[2].y, local[2].z, local[2].w, local[3].x, local[3].y, local[3].z, local[3].w, saved[0].x, saved[0].y, saved[0].z, saved[0].w, saved[1].x, saved[1].y, saved[1].z, saved[1].w, saved[2].x, saved[2].y, saved[2].z, saved[2].w, saved[3].x, saved[3].y, saved[3].z, saved[3].w, s.v[0].x, s.v[0].y, s.v[0].z, s.v[0].w, s.v[1].x, s.v[1].y, s.v[1].z, s.v[1].w, s.v[2].x, s.v[2].y, s.v[2].z, s.v[2].w, s.v[3].x, s.v[3].y, s.v[3].z, s.v[3].w)
    replacement: mat4 = mat4(9)
    sum = 0.0
    loop i in 0..3:
        sum += f64(s.v[0].x)
        s.v = replacement
    print("bit stores", sum, replacement[0].x, replacement[0].y, replacement[0].z, replacement[0].w, replacement[1].x, replacement[1].y, replacement[1].z, replacement[1].w, replacement[2].x, replacement[2].y, replacement[2].z, replacement[2].w, replacement[3].x, replacement[3].y, replacement[3].z, replacement[3].w, s.v[0].x, s.v[0].y, s.v[0].z, s.v[0].w, s.v[1].x, s.v[1].y, s.v[1].z, s.v[1].w, s.v[2].x, s.v[2].y, s.v[2].z, s.v[2].w, s.v[3].x, s.v[3].y, s.v[3].z, s.v[3].w)

# Runtime parameters keep both control-flow paths in the non-inlined cases.
loop mode in 0..10:
    loop take in [false, true]:
        s = Cell(mat4(3))
        param_case(s, mode, take)
        global_case(mode, take)
        local_case(mode, take)
        xs = [Cell(mat4(9)), Cell(mat4(3))]
        element_case(xs, 1, mode, take)
        o = Outer(Cell(mat4(3)))
        nested_case(o, mode, take)
# Aggregate return snapshots and an argument aliased by a mut argument.
loop take in [false, true]:
    rev = Cell(mat4(9))
    reverse_case(rev, take)
s_in = Cell(mat4(3))
r_in = saved_in(s_in)
print("return in", r_in[0].x, r_in[0].y, r_in[0].z, r_in[0].w, r_in[1].x, r_in[1].y, r_in[1].z, r_in[1].w, r_in[2].x, r_in[2].y, r_in[2].z, r_in[2].w, r_in[3].x, r_in[3].y, r_in[3].z, r_in[3].w, s_in.v[0].x, s_in.v[0].y, s_in.v[0].z, s_in.v[0].w, s_in.v[1].x, s_in.v[1].y, s_in.v[1].z, s_in.v[1].w, s_in.v[2].x, s_in.v[2].y, s_in.v[2].z, s_in.v[2].w, s_in.v[3].x, s_in.v[3].y, s_in.v[3].z, s_in.v[3].w)
a_in = argument_in(s_in, s_in.v)
print("argument in", a_in[0].x, a_in[0].y, a_in[0].z, a_in[0].w, a_in[1].x, a_in[1].y, a_in[1].z, a_in[1].w, a_in[2].x, a_in[2].y, a_in[2].z, a_in[2].w, a_in[3].x, a_in[3].y, a_in[3].z, a_in[3].w, s_in.v[0].x, s_in.v[0].y, s_in.v[0].z, s_in.v[0].w, s_in.v[1].x, s_in.v[1].y, s_in.v[1].z, s_in.v[1].w, s_in.v[2].x, s_in.v[2].y, s_in.v[2].z, s_in.v[2].w, s_in.v[3].x, s_in.v[3].y, s_in.v[3].z, s_in.v[3].w)
s_out = Cell(mat4(3))
r_out = saved_out(s_out)
print("return out", r_out[0].x, r_out[0].y, r_out[0].z, r_out[0].w, r_out[1].x, r_out[1].y, r_out[1].z, r_out[1].w, r_out[2].x, r_out[2].y, r_out[2].z, r_out[2].w, r_out[3].x, r_out[3].y, r_out[3].z, r_out[3].w, s_out.v[0].x, s_out.v[0].y, s_out.v[0].z, s_out.v[0].w, s_out.v[1].x, s_out.v[1].y, s_out.v[1].z, s_out.v[1].w, s_out.v[2].x, s_out.v[2].y, s_out.v[2].z, s_out.v[2].w, s_out.v[3].x, s_out.v[3].y, s_out.v[3].z, s_out.v[3].w)
a_out = argument_out(s_out, s_out.v)
print("argument out", a_out[0].x, a_out[0].y, a_out[0].z, a_out[0].w, a_out[1].x, a_out[1].y, a_out[1].z, a_out[1].w, a_out[2].x, a_out[2].y, a_out[2].z, a_out[2].w, a_out[3].x, a_out[3].y, a_out[3].z, a_out[3].w, s_out.v[0].x, s_out.v[0].y, s_out.v[0].z, s_out.v[0].w, s_out.v[1].x, s_out.v[1].y, s_out.v[1].z, s_out.v[1].w, s_out.v[2].x, s_out.v[2].y, s_out.v[2].z, s_out.v[2].w, s_out.v[3].x, s_out.v[3].y, s_out.v[3].z, s_out.v[3].w)
