    print("tuple", tuple_element.v[0].x, tuple_element.v[0].y, tuple_element.v[0].z, tuple_element.v[0].w, tuple_element.v[1].x, tuple_element.v[1].y, tuple_element.v[1].z, tuple_element.v[1].w, tuple_element.v[2].x, tuple_element.v[2].y, tuple_element.v[2].z, tuple_element.v[2].w, tuple_element.v[3].x, tuple_element.v[3].y, tuple_element.v[3].z, tuple_element.v[3].w)
    print("observed", observed[0].x, observed[0].y, observed[0].z, observed[0].w, observed[1].x, observed[1].y, observed[1].z, observed[1].w, observed[2].x, observed[2].y, observed[2].z, observed[2].w, observed[3].x, observed[3].y, observed[3].z, observed[3].w)
    print("original", xs[i].v[0].x, xs[i].v[0].y, xs[i].v[0].z, xs[i].v[0].w, xs[i].v[1].x, xs[i].v[1].y, xs[i].v[1].z, xs[i].v[1].w, xs[i].v[2].x, xs[i].v[2].y, xs[i].v[2].z, xs[i].v[2].w, xs[i].v[3].x, xs[i].v[3].y, xs[i].v[3].z, xs[i].v[3].w)
