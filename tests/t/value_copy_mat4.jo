element_case = (xs: mut Cell[], i: int, mode: int, take: bool):
    whole = xs[i]
    field = Cell(mat4(9))
    elements = [xs[i]]
    element = elements[0]
    pair = (xs[i], 97)
    tuple_element = pair.0
    relay = xs[i].v
    first = relay
    field.v = first
    before = xs[i].v[0].x
    match mode:
        0: xs[i].v = mat4(9)
        1: xs[i].v[0].x += 2
        2: xs[i].v[0].x *= 2
        3: change_in(xs[i].v)
        4: change_out(xs[i].v)
        5:
            if take: xs[i].v = mat4(9)
        6:
            if take: pass
            else: xs[i].v = mat4(9)
        7:
            match take:
                true: xs[i].v = mat4(9)
                false: pass
        8:
            loop j in 0..(if take: 3 else: 0): xs[i].v[0].x += 1
        _:
            if take:
                xs[i].v = mat4(9)
                observed_relay = xs[i].v
                observed = observed_relay
                check = f64(first[0].x) + f64(xs[i].v[0].x) - f64(observed[0].x)
                print("element", mode, take, "before", before, "check", check)
