                print("observed", observed[0].x, observed[0].y, observed[0].z, observed[0].w, observed[1].x, observed[1].y, observed[1].z, observed[1].w, observed[2].x, observed[2].y, observed[2].z, observed[2].w, observed[3].x, observed[3].y, observed[3].z, observed[3].w)
                print("original", xs[i].v[0].x, xs[i].v[0].y, xs[i].v[0].z, xs[i].v[0].w, xs[i].v[1].x, xs[i].v[1].y, xs[i].v[1].z, xs[i].v[1].w, xs[i].v[2].x, xs[i].v[2].y, xs[i].v[2].z, xs[i].v[2].w, xs[i].v[3].x, xs[i].v[3].y, xs[i].v[3].z, xs[i].v[3].w)
                return
    observed_relay = xs[i].v
    observed = observed_relay
    check = f64(first[0].x) + f64(xs[i].v[0].x) - f64(observed[0].x)
    print("element", mode, take, "before", before, "check", check)
    print("local", first[0].x, first[0].y, first[0].z, first[0].w, first[1].x, first[1].y, first[1].z, first[1].w, first[2].x, first[2].y, first[2].z, first[2].w, first[3].x, first[3].y, first[3].z, first[3].w)
    print("whole", whole.v[0].x, whole.v[0].y, whole.v[0].z, whole.v[0].w, whole.v[1].x, whole.v[1].y, whole.v[1].z, whole.v[1].w, whole.v[2].x, whole.v[2].y, whole.v[2].z, whole.v[2].w, whole.v[3].x, whole.v[3].y, whole.v[3].z, whole.v[3].w)
