# requires: sloppy
# Conservative boxes must contain the actual f32 matrix products, even with shear,
# reflection, cancellation, large translations, and very small scales.
seed_random(7)
loop trial in [0..400):
    s = if trial % 3 == 0: 0.00000001 else: if trial % 3 == 1: 100000000.0 else: 1.0
    m = mat4()
    loop col in [0..4):
        loop row in [0..4): m[col][row] = f32(random(-4.0, 4.0) * s)
    box = (-3.0, -2.0, -1.0, 1.0, 3.0, 2.0, 1.0, 1.0)
    out = box
    __sw_box_transform(m, &box.0, &out.0)
    op = &out.0
    loop corner in [0..8):
        p = vec4(if corner & 1 == 0: -3.0 else: 3.0, if corner & 2 == 0: -2.0 else: 2.0, if corner & 4 == 0: -1.0 else: 1.0, 1)
        q = m * p
        loop row in [0..4): assert(op[row] <= f64(q[row]) and f64(q[row]) <= op[4 + row])
vp = perspective(60, 1, 0.1, 100)
assert(__sw_instance_visible(translation(vec3(0, 0, -5)), vp, vec3(0, 0, 0), 1))
assert(not __sw_instance_visible(translation(vec3(100, 0, -5)), vp, vec3(0, 0, 0), 1))
assert(not __sw_instance_visible(translation(vec3(0, 100, -5)), vp, vec3(0, 0, 0), 1))
assert(not __sw_instance_visible(translation(vec3(0, 0, 5)), vp, vec3(0, 0, 0), 1))
# A box crossing w=0 is kept; side rejection cannot use its inverted projection.
assert(__sw_instance_visible(translation(vec3(0, 0, -0.1)), vp, vec3(0, 0, 0), 1))
# Do not tighten bounds against a side-plane tie or omit a shear's contribution.
assert(__sw_instance_visible(translation(vec3(2, 0, 0)), mat4(), vec3(0, 0, 0), 1))
shear = translation(vec3(3, 0, -5))
shear[1].x = 10
assert(__sw_instance_visible(shear, vp, vec3(0, 0, 0), 1))
print("software instance bounds ok")
