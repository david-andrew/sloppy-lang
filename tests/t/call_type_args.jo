# Type arguments written at a call: f[T](...), for what the arguments alone do not say
# requires: sloppy
first[T] = (xs: T[]) -> T: xs[0]
zero[T] = () -> T:
    x: T
    x
pair[A, B] = (a: A, b: B) -> (A, B): (a, b)
struct Bug:
    pos: vec2
    hp: i32
main = ():
    print(zero[int](), zero[str]().len(), zero[f64](), first[f64]([1.5, 2.0]))
    print(pair[i8, str](5, "x"))
    print(zero[Bug]())
    xs = zero[int[]]()
    xs.push(3)
    print(xs)
