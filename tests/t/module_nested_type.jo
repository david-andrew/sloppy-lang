# requires: sloppy
# a type through a module's module: board.grid.Grid[int], as board.grid.make_grid(...) is called
import 'mods/board.jo'
g: board.grid.Grid[int] = board.grid.make_grid(2, 7)
b: board.grid.Grid[bool] = board.empty_board()
gs: board.grid.Grid[int][] = [g]
print(g.cells, b.w, gs.len())
show = (x: board.grid.Grid[int]) -> str: "{x.w} {x.cells}"
print(show(g))
print(from_json[board.grid.Grid[int]]("\{\"w\": 1, \"cells\": [5]}"))
