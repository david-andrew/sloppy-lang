# requires: sloppy
# Heap with int priorities: exact order past 2^53 (as f64s 2^53 and 2^53 + 1 are equal); heapify
h: Heap[str]
h.push("b", 9007199254740993)
h.push("a", 9007199254740992)
h.push("c", MAX_INT)
h.push("d", MAX_INT - 1)
h.push("e", MIN_INT)
h.push("f", 2.5)
h.push("g", 3)
print(h.peek(), h.peek_int_priority())
loop h.len() > 0:
    x, p = h.pop_with_int_priority()
    print(x, p)
xs = [5 3 8 1 9 2 7]
xs.heapify()
out: int[]
loop xs.len() > 0: out.push(xs.heap_pop())
print(out)
e: int[]
e.heapify()
print(e)
g: Heap[int]
loop i in [0..1000): g.push(i, (i * 7919) % 1000)
ok = true
last = -1
loop g.len() > 0:
    p = g.peek_int_priority()
    if p < last: ok = false
    last = p
    g.pop()
print(ok)
