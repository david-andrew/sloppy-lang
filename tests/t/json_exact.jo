# requires: sloppy
# JSON's whole numbers exactly (beyond 2^53 too), a Json printed as JSON, HTML where JSON was
# expected, and to_json of any value written straight from its text
struct Repo:
    id: int
    name = "x"
    stars: u64 = 18446744073709551615
    score = 2.0
    note = "tab\there \x01"
print(to_json(Repo(1234567890123456789)))
back = from_json[Repo](to_json(Repo(1234567890123456789)))
if back is Repo: print(back.id, back.note == Repo(0).note)

j = parse_json(r'{"id": 1234567890123456789, "min": -9223372036854775808, "u": 18446744073709551615, "f": 1.5e3, "g": 0.1, "a": [1, "b", null, true, -0.0]}')
print(j)
if j is Json:
    print(j.get("id").as_int(), j.get("min").as_int(), j.get("u").as_num(), j.get("f").as_int(), j.get("g").as_num(), j.get("id").as_num())
    print("{j.get("a")!}", [j.get("f")!, Json.text("q\"")])
    print(to_text(j.get("a")!))
    print(to_json(j) == to_json(json_value(j)))
print(parse_json("[0.1, 1e22, 1e-22, 3.14159, 123456.789e-3, 2.5E+2, 9007199254740993, 123456789012345678901234567890, 1e400]"))
loop bad in ["<!DOCTYPE html><html><body>502 Bad Gateway</body></html>", "\n  <html>", "[1, <b>]", "1.", "-", "1e", "01x"]:
    r = parse_json(bad)
    if r is JsonError: print("{r.line}:{r.column} {r.message}")
