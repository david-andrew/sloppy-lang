# requires: sloppy
# requires: native
# A program with on_quit that does not look at stopping(): SIGTERM (here sent to itself) ends it at
# its next wait, sleep, with 128 + 15, on_quit running first
on_quit = (): print("on_quit ran")

n = 0
loop n < 100:
    n += 1
    if n == 2:
        when TARGET == "windows":
            __stop_asked = true
            __stop_sig = 15
        else:
            syscall(62, syscall(39), 15)              # kill(getpid(), SIGTERM)
    sleep(0.01)
print("not reached: {n}")
