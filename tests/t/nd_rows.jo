# requires: sloppy
# a row or column of a T[,] (1-D) goes where a T[] is expected: the program's own functions and
# the library's (argmax, variance, percentile ...)
m = [1.0 5.0 2.0; 4.0 3.0 6.0]
avg = (xs: f64[]) -> f64: sum(xs) / f64(xs.len())
print(avg(m[.., 1]), sum(m[0, ..]), mean(m[1, ..]))
xs: f64[] = m[1, ..]
print(xs)
r = m[0, ..]
print(argmax(r), percentile(r, 50.0), median(r), sorted(r), cumsum(r), dot(r, r), max(r))
