# requires: native
# requires: sloppy
# A draw into a render target of several colors that samples any of them panics, saying which
# (WebGL forbids it; elsewhere what it draws is undefined). Sampling another target's is fine.
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
struct V:
    pos: vec2
struct U:
    t: Texture
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1))
fs = (i: O, u: U) -> vec4: sample(u.t, i.pos.xy)
sh = make_shader(shader(vs, fs))
tri = mesh([V(vec2(-1, -1)), V(vec2(3, -1)), V(vec2(-1, 3))])
a = render_target(32, 32, colors = 3)
b = render_target(32, 32, colors = 3)
draw = ():
    draw_to(b)
    draw(sh, tri, U(a.colors[2]))
    print("sampled from another target")
    draw_to(a)
    draw(sh, tri, U(a.colors[2]))
    print("not reached")
    draw_to_screen()
