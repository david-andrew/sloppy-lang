# requires: native
# requires: sloppy
# redraw_on_input: with nothing happening, frames come only when redraw_after asks (some 7 in
# half a second, not 30); request_redraw() in each frame keeps them coming (an animation: six
# in a row, before 10 s)
# env: SLOPPY_SOFTWARE=1
redraw_on_input()
t0 = time()
idle = 0
busy = 0
draw = ():
    global busy, idle
    clear()
    t = time() - t0
    if t < 0.5:
        idle += 1
        redraw_after(0.1)
    else if busy < 6 and t < 10.0:
        # (six frames asked for one after another, however slow the machine draws them)
        busy += 1
        request_redraw()
    else:
        print("a few idle frames: {idle >= 4 and idle <= 12} ({if idle < 4 or idle > 12: idle else: 0})")
        print("animating: {busy >= 6} ({if busy < 6: busy else: 0})")
        quit()
