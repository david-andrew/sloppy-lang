# requires: sloppy
# requires: native
# The real example, unchanged: its Settings page on a phone, with a gamepad connected.
# env: SLOPPY_SCREENSHOT=$TMP/layout_example_settings.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_WINDOW=390x844
# env: SLOPPY_FRAMES=82
# env: SLOPPY_INPUT=1:lstick=0x0 3:escape+ 4:escape- 5:down+ 6:down- 7:down+ 8:down- 9:down+ 10:down- 11:down+ 12:down- 13:down+ 14:down- 15:down+ 16:down- 17:down+ 18:down- 19:down+ 20:down- 21:down+ 22:down- 23:down+ 24:down- 25:down+ 26:down- 27:tab+ 28:tab- 29:tab+ 30:tab- 31:tab+ 32:tab- 33:tab+ 34:tab- 35:tab+ 36:tab- 37:tab+ 38:tab- 39:tab+ 40:tab- 41:tab+ 42:tab- 43:tab+ 44:tab- 45:tab+ 46:tab- 47:tab+ 48:tab- 49:tab+ 50:tab- 51:tab+ 52:tab- 53:tab+ 54:tab- 55:shift+ 56:tab+ 57:tab- 57:shift- 58:pad_lb+ 59:pad_lb- 60:pad_rb+ 61:pad_rb- 62:up+ 63:up- 64:up+ 65:up- 66:up+ 67:up- 68:up+ 69:up- 70:up+ 71:up- 72:up+ 73:up- 74:up+ 75:up- 76:up+ 77:up- 78:up+ 79:up- 80:up+ 81:up-
import '../../examples/layout.jo' as inventory
import layout as ui

update = (dt: f64): inventory.update(dt)
draw = ():
    inventory.draw()
    f = frame_number()
    keys = ["volume", "music", "effects", "mute", "size", "wear", "marks", "name", "hints", "stick", "vibration"]
    key = ""
    if f >= 5 and f <= 25 and f % 2 == 1: key = keys[(f - 5) / 2]
    if f >= 31 and f <= 51 and f % 2 == 1: key = keys[(f - 31) / 2]
    if f == 27 or f == 53: key = "back"
    if f == 29: key = "defaults"
    if f == 56 or f == 60: key = "vibration"
    if f == 58: key = "stick"
    if f >= 62 and f <= 80 and f % 2 == 0: key = keys[9 - (f - 62) / 2]
    if len(key) > 0:
        assert(ui.get(key, root = "settings")!.focused, "frame {f}: {key} focused")
        r = ui.bounds(key, root = "settings")!
        assert(r.y >= 0 and r.y + r.h <= 844, "frame {f}: {key} in view: {r}")
    if f == 82:
        assert(visible_rect().w == 390 and visible_rect().h == 844)
        print("example Settings at 390x844: last control reachable by Down and Tab, back by Up and Shift+Tab/LB/RB")
