# requires: native
# requires: sloppy
# hud_hovered with a finger: a tap on the map just after one on a button is the map's (the
# lifted finger leaves the pointer on the button), and a tap landing on a button is the button's
# env: SLOPPY_SCREENSHOT=$TMP/hover.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=20
# env: SLOPPY_INPUT=5:touch1=1170x90 7:touch1- 10:touch1=350x320 12:touch1-
window("hover", 1280, 720)
update = (dt: f64):
    if mouse_pressed(.left): print("frame {frame_number()}: on the interface {hud_hovered()}")
draw = ():
    clear()
    if hud_button(Rect(1100, 60, 140, 60), "Gun"): print("frame {frame_number()}: the button")
