# requires: native
# requires: sloppy
# the number pad's keys: their own Key variants (and a name to show for them)
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=10
# env: SLOPPY_INPUT=2:kp7+,3:kp7-,4:kp_plus+,5:kp_plus-,6:left+,7:left-
draw = ():
    clear(BLACK)
    loop k in [Key.kp7, Key.kp8, Key.kp_plus, Key.left]:
        if key_pressed(k): print(frame_number(), k)
