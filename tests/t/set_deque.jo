# requires: sloppy
# Set[T]: values without repeats; Deque[T]: both ends in O(1); an array kept as a heap
seen: Set[int]
print(seen, seen.len(), seen.is_empty())
print(seen.add(3), seen.add(1), seen.add(3), seen.add(2))
print(seen, seen.len(), 3 in seen, 5 in seen, 5 not in seen, seen.has(1))
print(seen.remove(1), seen.remove(1), seen)
words = set(split("the cat saw the other cat", " "))
print(words, words.len())
loop w in words: write("{w}.")
print()
loop i, w in words:
    if i == 1: print(i, w)
a = set([1, 2, 3, 4])
b = set([3, 4, 5])
print(a.union(b), a.intersection(b), a.difference(b), b.difference(a))
print(set([4, 3]).is_subset(a), b.is_subset(a), a == set([4, 3, 2, 1]), a == b)
names = set(["bo", "al"])
print(names, names.items())
c = a
c.add(9)
print(a.len(), c.len())
# (a struct as a value)
struct P:
    x: int
    y: int
ps: Set[P]
ps.add(P(1, 2))
ps.add(P(1, 2))
ps.add(P(2, 1))
print(ps, P(2, 1) in ps)

# breadth-first search with a Deque as the frontier
q: Deque[int]
print(q, q.len())
q.push(1)
q.push(2)
q.push_front(0)
print(q, q.first(), q.last(), q[1])
print(q.pop_front(), q.pop(), q, q.len())
loop i in 0..20: q.push(i)
loop i in 0..15: q.pop_front()
loop i in 0..5: q.push_front(-i)
print(q, q.len())
q[0] = 100
print(q[0], q == q, q.items().len())
total = 0
loop x in q: total += x
print(total)
graph = {1: [2, 3], 2: [4], 3: [4], 4: [5], 5: []}
dist = {1: 0}
frontier: Deque[int]
frontier.push(1)
loop frontier.len() > 0:
    u = frontier.pop_front()
    loop v in graph[u]:
        if not dist.has(v):
            dist[v] = dist[u] + 1
            frontier.push(v)
print(dist)
ds: Deque[str]
loop k in 0..1000:
    ds.push("s{k}")
    if k % 3 == 0: ds.pop_front()
print(ds.len(), ds.first(), ds.last())

# heapq's way: an array kept as a heap, tuples compared by their first element, then the next
pq: (int, str)[]
loop t in [(5, "e"), (1, "a"), (3, "c"), (1, "b"), (4, "d")]: pq.heap_push(t)
print(pq[0])
order: str[]
loop pq.len() > 0:
    d, s = pq.heap_pop()
    order.push("{s}{d}")
print(order)
h: Heap[str]
h.push("far", 9.0)
h.push("near", 1.5)
v, pri = h.pop_with_priority()
print(v, pri, h.len(), h.peek(), h.peek_priority())

# unwrap and expect: the value, or a stop that says why
error struct BadNumber:
    text: str
num = (s: str) -> int | BadNumber:
    if let n = to_int(s): return n
    BadNumber(s)
m = {"a": 1}
print(unwrap(m.get("a")), m.get("a").expect("a is there"), num("41").unwrap() + 1, expect(num("7"), "a number") * 2)
