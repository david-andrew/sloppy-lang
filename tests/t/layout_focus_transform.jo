# requires: sloppy
# requires: native
# Scroll content coordinates still follow screen directions under a transformed root.
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_SCREENSHOT=$TMP/layout_focus_transform.png
# env: SLOPPY_FRAMES=7
import layout as ui
window("Rotated scroll focus", 500, 250)
draw = ():
    clear()
    f = frame_number()
    push_transform()
    translate(450, 50)
    rotate(PI / 2.0)
    direction = if f == 3: vec2(-1, 0) else: if f == 5: vec2(1, 0) else: vec2()
    ui.at(Rect(0, 0, 100, 100), key = "rotated", input = ui.Input(nav = direction), ():
        ui.scroll(width = 100, height = 100, ():
            ui.button("First", width = 80, height = 40, key = "first")
            ui.space(height = 400)
            ui.button("Last", width = 80, height = 40, key = "last")
        )
    )
    pop_transform()
    if f == 3 or f == 5:
        key = if f == 3: "last" else: "first"
        assert(ui.get(key, root = "rotated")!.focused)
        r = ui.bounds(key, root = "rotated")!
        assert(r.y >= 0 and r.y + r.h <= 100)
    if f == 7: print("rotated scroll follows screen arrows and reveals clipped controls")
