# requires: native
# requires: sloppy
# hud_scroll with a finger: a tap on a row's button acts as the finger lifts, one that wobbles a
# little is still a tap, a drag begun on a button scrolls the list and buys nothing, the list
# glides on after it and stops, and the mouse drags it the same way
# env: SLOPPY_SCREENSHOT=$TMP/hud_touch_scroll.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=70
# env: SLOPPY_INPUT=3:touch1=150x60 5:touch1- 8:touch1=150x150 9:touch1=150x140 10:touch1=150x120 11:touch1=150x100 12:touch1=150x80 13:touch1- 45:mouse=150x200 46:mouse_left+ 47:mouse=150x190 48:mouse=150x170 49:mouse=150x150 50:mouse_left- 60:touch1=150x200 61:touch1=153x204 62:touch1-
window("shop", 640, 400)
items = [loop i in [0..30): "item {i}"]
draw = ():
    clear(rgb(0.1, 0.1, 0.12))
    r = Rect(40, 40, 300, 300)
    off = hud_scroll(r, items.len() * 44, "shop")
    if [10, 12, 13, 20, 44, 46, 49, 59, 61].contains(frame_number()): print("frame {frame_number()}: scrolled to {off:.1}")
    clip(r)
    loop i in 0.. and it in items:
        if hud_button(Rect(r.x, r.y + i * 44 - off, r.w - 14, 40), it): print("frame {frame_number()}: bought {i}")
    no_clip()
