# requires: sloppy
# `pattern as name` in a match arm: the value matched, named (narrowed to the union member matched)
struct Circle:
    r = 0.0
struct Rect:
    w = 0.0
    h = 0.0
enum Shape: circle(r: f64), rect(w: f64, h: f64)
area = (s: Circle | Rect) -> f64:
    match s:
        Circle as c: 3.0 * c.r * c.r
        Rect as q: q.w * q.h
describe = (x: int) -> str:
    match x:
        0: "zero"
        1..10 as d: "digit {d}"
        _ as n if n > 100: "big {n}"
        _ as n: "other {n}"
kind = (s: Shape) -> str:
    match s:
        .rect(w, h) as r if w == h: "square {r}"
        .rect(w, h): "rect {w}x{h}"
        _ as other: "{other}"
main = ():
    print(area(Circle(2.0)), area(Rect(2.0, 3.0)))
    loop x in [0, 5, 150, 50]: print(describe(x))
    print(kind(.rect(2.0, 2.0)), kind(.rect(1.0, 2.0)), kind(.circle(1.0)))
