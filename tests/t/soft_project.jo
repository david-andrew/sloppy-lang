# requires: sloppy
# Packed projection must handle every tail length and retain flat integer bits.
loop nf in [4..38):
    loop tagged in [false, true]:
        q: f32[]
        loop f in [0..nf): q.push(f32(f - 7) * 0.071)
        q[3] = 1.37
        flat = fill(false, nf)
        if tagged and nf > 4:
            flat[nf - 1] = true
            (data(q) as *u32)[nf - 1] = 0xabcdef01
        out = fill(f32(-99), nf + 4)
        fp: *bool = null
        if tagged: fp = data(flat)
        __sw_project(data(q), data(out), nf, 3, 7, 127, 83, fp)
        iw: f32 = 1.0 / q[3]
        assert(out[0] == f32(3.0 + (f64(q[0] * iw) * 0.5 + 0.5) * 127.0))
        assert(out[1] == f32(7.0 + (f64(q[1] * iw) * 0.5 + 0.5) * 83.0))
        assert(out[2] == q[2] * iw * 0.5 + 0.5 and out[3] == iw)
        loop f in [4..nf):
            if flat[f]: assert((data(out) as *u32)[4 + f] == (data(q) as *u32)[f])
            else: assert(out[4 + f] == q[f] * iw)
print("software projection tails ok")
