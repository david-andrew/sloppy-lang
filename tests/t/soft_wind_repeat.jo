# requires: sloppy
# requires: native
# requires: unix
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_THREADS=4
# A swaying (wind) instanced scene drawn again with the clock held is the same picture, byte for
# byte, with the vertex stage and the raster bands split among threads, shadows on and off.
# (In a function with `global`: a top-level `__fixed_step = true` would make the program's own
# variable, and leave the library's clock running.)
hold_clock = ():
    global __fixed_step
    __fixed_step = true
hold_clock()
ball = sphere_mesh(0.3, 12, 6)
insts: Instance3D[]
loop i in [0..160):
    x = f32(i % 16) * 0.5 - 3.75
    z = f32(i / 16) * -0.6 + 1.0
    insts.push(instance(transform(vec3(x, f32(i % 3) * 0.2, z), f64(i) * 0.4), vec4(0.3 + f32(i % 7) * 0.1, 0.8, 0.5, 1)))
kept = instance_buffer(insts)
# (enough vertices for the vertex stage to run on the threads too)
assert(ball.count * insts.len() >= 4096)
capture = (wind: f64, shadow: bool, buffered: bool) -> Image:
    render_image(64, 48, ():
        clear(BLACK)
        camera3d(vec3(0, 2, 5), vec3(0, 0, -1.5), 60)
        shadows(shadow, area = 10)
        sun(vec3(-1, 2, 1))
        draw_mesh(plane_mesh(12.0), color = rgb(0.4, 0.5, 0.3))
        if buffered: draw_mesh_instanced(ball, kept, wind = wind)
        else: draw_mesh_instanced(ball, insts, wind = wind))
loop shadow in [false, true]:
    loop buffered in [false, true]:
        first = capture(0.4, shadow, buffered)
        loop r in [0..4):
            again = capture(0.4, shadow, buffered)
            assert(again.pixels == first.pixels)
        # (the wind does sway the scene: the comparison is not of a still one)
        still = capture(0.0, shadow, buffered)
        assert(still.pixels != first.pixels)
print("wind repeats")
