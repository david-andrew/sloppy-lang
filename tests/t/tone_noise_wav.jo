# requires: sloppy
rough = (s: Sound) -> f64:
    d = 0.0
    loop i in [1..s.samples.len() / 2): d += abs(f64(s.samples[i * 2] - s.samples[i * 2 - 2]))
    d / f64(s.samples.len() / 2)
peak = (s: Sound) -> f64:
    m = 0.0
    loop x in s.samples: m = max(m, abs(f64(x)))
    m
lo = tone(60.0, 0.5, .noise)
hi = tone(5000.0, 0.5, .noise)
print(rough(lo) < 0.05, rough(hi) > 0.2)
b = tone(1200.0, 0.05, .square, 0.12)
print("{peak(b):.3}")
w = encode_wav(b)
back = load_wav(w)
print("{w.len()} {back.samples.len()} {b.samples.len()} {abs(f64(back.samples[500] - b.samples[500])) < 0.0001}")
print(save_wav(b, temp_dir() + "/tone_test.wav"))
