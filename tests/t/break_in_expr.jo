# requires: sloppy
# break and continue from inside an expression (an if-expression's or a match arm's block): what
# the statement holds so far, and values half built, are dropped as its end would drop them
struct P:
    name: str
    tags: str[]

word = (i: int) -> str: "w{i}"

base = alloc_count()

# in a struct being built, after a text made for it
ps: P[]
loop i in [0..6):
    p = P(word(i), [word(i), if i == 2: continue else: word(i + 1)])
    if i == 4:
        q = P(word(i), [if i == 4: break else: "x"])
        ps.push(q)
    ps.push(p)
print(ps.len(), ps[2].tags)

# in a text, and in an array literal, from a match arm
out: str[]
loop i in [0..5):
    s = "{word(i)}-{if i == 3: break else: word(i)}"
    xs = [word(i), word(i), match i:
        0: continue
        _: s]
    out.push(xs[2])
print(out)

# a while loop, a map being built, a temporary held by the statement
n = 0
loop n < 4:
    n += 1
    m = {word(n): 1, word(n + 1): if n == 3: break else: 2}
    t = word(n).len() + (if n == 1: continue else: m.len())
    print(t)

# an array whose later elements are not stored yet
loop i in [0..5):
    s = word(i)
    xs = [word(i), word(i), if i == 0: continue else: s, word(i)]
    if i == 3: print(xs)

# the same left by a return (`?`)
error struct Bad:
    why: str
num = (s: str) -> int | Bad:
    if s == "x": return Bad("not a number")
    s.len()
three = (s: str) -> str[] | Bad: [word(1), word(2), "{num(s)?}", word(4)]
print(three("ab"), three("x"))

# nested loops: break leaves the inner one only
loop i in [0..3):
    loop j in [0..3):
        v = [word(i), if j == 1: break else: word(j)]
        print(v)

ps = []
out = []
print(alloc_count() - base)
