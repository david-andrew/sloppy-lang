# requires: sloppy
# lib/crypto.jo against published test vectors (FIPS 180, RFC 4231, RFC 2202, FIPS 197, GCM's, RFC 6979, RFC 1321,
# RFC 5869, RFC 7748, Wycheproof's)
import crypto
h = (b: u8[]) -> str: crypto.hex_text(b)
x = (s: str) -> u8[]: crypto.hex_bytes(s)!
print(h(crypto.sha1(bytes("abc"))))
print(h(crypto.sha256(bytes("abc"))))
print(h(crypto.sha256(bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))))
k20: u8[] = fill(u8(0x0b), 20)
print(h(crypto.hmac_sha256(k20, bytes("Hi There"))))
print(h(crypto.hmac_sha1(k20, bytes("Hi There"))))
ak = crypto.aes_key(x("000102030405060708090a0b0c0d0e0f"))
blk: u8[16]
loop i in [0..16): blk[i] = x("00112233445566778899aabbccddeeff")[i]
o = crypto.aes_encrypt_block(ak, blk)
print(h([loop b in o: b]))
z = crypto.aes_key(fill(u8(0), 16))
print(h(crypto.aes_gcm_seal(z, fill(u8(0), 12), [], fill(u8(0), 16))))
# GCM test case 4 (McGrew & Viega)
k4 = crypto.aes_key(x("feffe9928665731c6d6a8f9467308308"))
p4 = x("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
a4 = x("feedfacedeadbeeffeedfacedeadbeefabaddad2")
s4 = crypto.aes_gcm_seal(k4, x("cafebabefacedbaddecaf888"), a4, p4)
print(h(s4))
print(crypto.aes_gcm_open(k4, x("cafebabefacedbaddecaf888"), a4, s4)! == p4)
s4[3] = s4[3] xor 1
print(crypto.aes_gcm_open(k4, x("cafebabefacedbaddecaf888"), a4, s4) == none)
# RFC 6979 A.2.5's P-256 key and its "sample" signature (SHA-256)
pub = x("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299")
sig = x("efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8")
print(crypto.p256_verify(pub, crypto.sha256(bytes("sample")), sig))
print(crypto.p256_verify(pub, crypto.sha256(bytes("samplf")), sig))
# keys made here: ECDH agrees, signatures verify (and fail for another key), DER and the
# certificate carry them back
a = crypto.p256_key()
b = crypto.p256_key()
print(crypto.p256_ecdh(a, b.public)! == crypto.p256_ecdh(b, a.public)!)
m = crypto.sha256(bytes("hello"))
sg = crypto.p256_sign(a, m)
print(crypto.p256_verify(a.public, m, sg), crypto.p256_verify(b.public, m, sg))
print(crypto.der_signature_parts(crypto.der_signature(sg))! == sg)
print(crypto.certificate_p256_key(crypto.self_signed_certificate(a, "x"))! == a.public)
# MD5 (RFC 1321's)
print(h(crypto.md5(bytes(""))))
print(h(crypto.md5(bytes("message digest"))))
print(h(crypto.md5(bytes("12345678901234567890123456789012345678901234567890123456789012345678901234567890"))))
# SHA-384 and SHA-512 (FIPS 180-2's examples)
print(h(crypto.sha384(bytes("abc"))))
print(h(crypto.sha512(bytes("abc"))))
two = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
print(h(crypto.sha384(bytes(two))))
print(h(crypto.sha512(bytes(two))))
# HKDF (RFC 5869 A.1)
prk = crypto.hkdf_extract(x("000102030405060708090a0b0c"), fill(u8(0x0b), 22))
print(h(prk))
print(h(crypto.hkdf_expand(prk, x("f0f1f2f3f4f5f6f7f8f9"), 42)))
# X25519 (RFC 7748 6.1): each side's public value, and the secret they share
alice = crypto.X25519Key(x("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"), [])
bob = crypto.X25519Key(x("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"), [])
nine = fill(u8(0), 32)
nine[0] = 9
print(h(crypto.x25519_ecdh(alice, nine)!))
print(h(crypto.x25519_ecdh(bob, nine)!))
print(h(crypto.x25519_ecdh(alice, x("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"))!))
print(crypto.x25519_ecdh(alice, fill(u8(0), 32)) == none)
k1 = crypto.x25519_key()
k2 = crypto.x25519_key()
print(crypto.x25519_ecdh(k1, k2.public)! == crypto.x25519_ecdh(k2, k1.public)!)
# P-384 ECDSA (RFC 6979 A.2.6: SHA-384 and SHA-256 of "sample", SHA-512 of "test"), and changed
p384 = x("04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13" +
    "8015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720")
s384 = x("94edbb92a5ecb8aad4736e56c691916b3f88140666ce9fa73d64c4ea95ad133c81a648152e44acf96e36dd1e80fabe46" +
    "99ef4aeb15f178cea1fe40db2603138f130e740a19624526203b6351d0a3a94fa329c145786e679e7b82c71a38628ac8")
s256 = x("21b13d1e013c7fa1392d03c5f99af8b30c570c6f98d4ea8e354b63a21d3daa33bde1e888e63355d92fa2b3c36d8fb2cd" +
    "f3aa443fb107745bf4bd77cb3891674632068a10ca67e3d45db2266fa7d1feebefdc63eccd1ac42ec0cb8668a4fa0ab0")
s512 = x("a0d5d090c9980faf3c2ce57b7ae951d31977dd11c775d314af55f76c676447d06fb6495cd21b4b6e340fc236584fb277" +
    "976984e59b4c77b0e8e4460dca3d9f20e07b9bb1f63beefaf576f6b2e8b224634a2092cd3792e0159ad9cee37659c736")
print(crypto.p384_verify(p384, crypto.sha384(bytes("sample")), s384), crypto.p384_verify(p384, crypto.sha256(bytes("sample")), s256),
    crypto.p384_verify(p384, crypto.sha512(bytes("test")), s512))
print(crypto.p384_verify(p384, crypto.sha384(bytes("samplf")), s384), crypto.p384_verify(p384, crypto.sha256(bytes("sample")), s384))
# RSA-2048 with SHA-256 (Wycheproof's rsa_pss_2048_sha256_mgf1_32 and rsa_signature_2048_sha256, tcIds 4: valid;
# 62: the hash's first byte changed; 9: DigestInfo's length written the long way)
rn = x("00a2b451a07d0aa5f96e455671513550514a8a5b462ebef717094fa1fee82224e637f9746d3f7cafd31878d80325b6ef5a17" +
    "00f65903b469429e89d6eac8845097b5ab393189db92512ed8a7711a1253facd20f79c15e8247f3d3e42e46e48c98e254a2f" +
    "e9765313a03eff8f17e1a029397a1fa26a8dce26f490ed81299615d9814c22da610428e09c7d9658594266f5c021d0fceca0" +
    "8d945a12be82de4d1ece6b4c03145b5d3495d4ed5411eb878daf05fd7afc3e09ada0f1126422f590975a1969816f48698bcb" +
    "ba1b4d9cae79d460d8f9f85e7975005d9bc22c4e5ac0f7c1a45d12569a62807d3b9a02e5a530e773066f453d1f5b4c2e9cf7" +
    "820283f742b9d5")
re: u8[] = [u8(1), 0, 1]
mh = crypto.sha256(x("313233343030"))
print(crypto.rsa_verify_pss(rn, re, mh, x("68caf07e71ee654ffabf07d342fc4059deb4f7e5970746c423b1e8f668d5332275cc35eb61270aebd27855b1e80d59def47f" +
    "e8882867fd33c2308c91976baa0b1df952caa78db4828ab81e79949bf145cbdfd1c4987ed036f81e8442081016f20fa4b587" +
    "574884ca6f6045959ce3501ae7c02b1902ec1d241ef28dee356c0d30d28a950f1fbc683ee7d9aad26b048c13426fe3975d56" +
    "38afeb5b9c1a99d162d3a5810e8b074d7a2eae2be52b577151f76e1f734b0a956ef4f22be64dc20a81ad1316e4f79dff5fc4" +
    "1fc08a20bc612283a88415d41595bfea66d59de7ac12e230f72244ad9905aef0ead3fa41ed70bf4218863d5f041292f2d14c" +
    "e0a7271c6d36")))
print(crypto.rsa_verify_pss(rn, re, mh, x("67d1d1c0a398148625317c3f5e44b738bdf461c27a59594b39ebb2aebef233c7809379e54411411b82d2e7ac88f989b58373" +
    "d532c758baea121878ce9759441738d121881c1fa2d04421f02dd565b12770d844611ed1873a0b64d822709a6b78d6d3892b" +
    "294404bce6711001d6c3a54546c76a1d17819674b0be904497a233b466fe4becc832dee740f9ab79e5b9f5db0b0f9aac0084" +
    "ba05cebf42303b5ca2ad95e3d61b29ed6475545c02e93e7b0e118af92f5cddb1faeb2cbc23c9e69c120e29df7fe31991e887" +
    "b3b29e77688c60e80be65cccf3d7861a7a14c39e6a6e5645568e2cc5e4a17b75db1dd415aadb45e112a9b582b2ff6e82a43d" +
    "7a7347b7b56d")))
print(crypto.rsa_verify_pkcs1(rn, re, mh, x("1758eb94588e6fc4f50c1be1afcaa41027869f304cad513b1fb12c2f446d63cdc05c4830a7e3e630da7b2da4f7867cc173bf" +
    "6420f9732277282596de41ded32e21d0cc31441174da8765f57419c7764ea758f55bc17646eb100c435d1ac0eed6fc7ba6de" +
    "5f832094ee2f479979765e05ac9976788db3c241a9e32a0da864f0019a87646ba623d63f4411af5dee1be9ec488c7e3e1b23" +
    "1479de70b9ac5f78a17b1f4120aece45f26c07e7bb345fdfeb05e14bcaacc614672a465fc523624cb19f66f9c6c3f642b832" +
    "ca44cb25176d679f0e05606c3fed022cac24c2bf960a406d48818e3eb7ed53b0446032469047dfed95fc18088c92d91d9372" +
    "2c47f88163a8")))
print(crypto.rsa_verify_pkcs1(rn, re, mh, x("8a0e82d4f334aca72a718b6f8f643f69c6048d619d5eba71263a5d2d3ac7a7af133b780c7595ca2c982c006e861948f543cd" +
    "0210c758691f9626842c25de2843ea314ca8eff285d47e0cffa54180af416004017034962a80a5959c3d3f1bfc154a482446" +
    "2a93c014f6dfe920824f414a6e30e0e5944d480b99949ec7bf64c4a7461575933b17d7d6b0178b5192392ace3ed8469e8ac1" +
    "dacae51ad5d3ad73dcb213e056d04596e64d8c0703def3110c7cecc93ba8ac8059f0f3d66b89d8712c62b41d407e4b4a104f" +
    "4569558b0290c213cad6d0653898b9df8f4a453ab07d13bfb7598d505abbd0c4987e4f1ac66e1a523e113e370ab7cf990f0c" +
    "c63f50f4f0a4")))
print(crypto.rsa_verify_pkcs1(rn, re, crypto.sha256(bytes("other")), x("1758eb94588e6fc4f50c1be1afcaa41027869f304cad513b1fb12c2f446d63cdc05c4830a7e3e630da7b2da4f7867cc173bf" +
    "6420f9732277282596de41ded32e21d0cc31441174da8765f57419c7764ea758f55bc17646eb100c435d1ac0eed6fc7ba6de" +
    "5f832094ee2f479979765e05ac9976788db3c241a9e32a0da864f0019a87646ba623d63f4411af5dee1be9ec488c7e3e1b23" +
    "1479de70b9ac5f78a17b1f4120aece45f26c07e7bb345fdfeb05e14bcaacc614672a465fc523624cb19f66f9c6c3f642b832" +
    "ca44cb25176d679f0e05606c3fed022cac24c2bf960a406d48818e3eb7ed53b0446032469047dfed95fc18088c92d91d9372" +
    "2c47f88163a8")))
