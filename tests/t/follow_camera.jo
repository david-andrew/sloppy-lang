# requires: sloppy
# the follow camera: behind its target looking along -z at yaw 0, turning left as yaw grows,
# and walking directions along the ground (no window: no input, so it only follows)
cam = follow_camera(distance = 5.0, pitch = 0.0, height = 1.0)
update(cam, vec3(2, 0, 3), 1.0 / 60.0)
print(aim(cam), position(cam))
print(flat_forward(cam), flat_right(cam))
cam.yaw = PI / 2.0
print(round(f64(flat_forward(cam).x)), round(f64(flat_right(cam).z)))
pull_in(cam, 0.5)
p = position(cam)
print(round(f64(length(p - aim(cam))) * 10.0) / 10.0)
