# requires: sloppy
# Sky Barons' seats: a seat taken from one of the computer's of one's own side (they move over, or
# out), never from a player or the other side; landing aboard a craft by parachute, either side's
# for a player, one's own side's for the computer, and not put out by the other side; each gunner
# fighting for their own side; the craft's side when it is shot down its pilot's
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
# (people 0 and 4 red players 0 and 2, 1 a blue player 1; the rest the computer's; all dead for
# good till put somewhere)
fresh = () -> Game:
    let g = new_game([0, 1, -1, -1, 2, -1], 0.65, Rules(mode = DOGFIGHT), [])
    loop i in 0..g.people.len():
        g.people[i].state = DEAD
        g.people[i].timer = 1000000
    g
craft = (g: mut Game, kind: int, team: int, at: vec3) -> int:
    g.crafts.push(flying_craft(kind, team, at, vec3(1, 0, 0)))
    g.crafts.len() - 1
sit = (g: mut Game, i: int, j: int, s: int):
    g.crafts[j].seats[s] = i
    g.people[i].state = SEATED
    g.people[i].craft = j
    g.people[i].seat = s
# (person i falling just above seat s of craft j, as fast as it goes)
above = (g: mut Game, i: int, j: int, s: int):
    c = g.crafts[j]
    g.people[i].state = FALL
    g.people[i].timer = 200
    g.people[i].pos = point_of(c, KINDS[c.kind].seats[s].at) + vec3(0, 1.5, 0)
    g.people[i].vel = c.vel
seats = (g: Game, j: int) -> str: g.crafts[j].seats.map((k): "{k}").join(" ")
pads = (a: Pad = Pad(), b: Pad = Pad(), c: Pad = Pad()) -> Pad[]: [a, b, c]

# a red bomber: player 0 a gunner, red's computer 2 its pilot: 1 takes the pilot's seat, 2 to the
# gunner's left free
let g = fresh()
j = craft(g, BOMBER, 0, vec3(0, 600, 0))
sit(g, 2, j, 0)
sit(g, 0, j, 1)
print("bomber seats {seats(g, j)}")
g = tick(g, pads(Pad(seat = 1)))
print("took the pilot's seat from the computer: seats {seats(g, j)}, 2 in seat {g.people[2].seat}")
# (2, a gunner's seat, the computer's: they move to the pilot's, free)
g = tick(g, pads())
g = tick(g, pads(Pad(seat = 2)))
print("and back: seats {seats(g, j)}")
# (a player, red's player 2, in the pilot's seat: not moved)
g.crafts[j].seats[0] = 4
g.people[2].state = DEAD
g.crafts[j].seats[1] = 0
g.people[0].seat = 1
sit(g, 4, j, 0)
g = tick(g, pads())
g = tick(g, pads(Pad(seat = 1)))
print("a player's seat not taken: seats {seats(g, j)}")

# a parked red fighter, red's computer 2 at its controls: player 0 on foot beside it, 1: in, 2 out
# beside it
let h = fresh()
f = h.crafts.len()
spot = vec3(300, f32(ground(300.0, 300.0)), 300)
h.crafts.push(parked(FIGHTER, 0, spot, 0.0))
sit(h, 2, f, 0)
h.people[0].state = WALK
h.people[0].pos = point_of(h.crafts[f], KINDS[FIGHTER].seats[0].at) + vec3(-2, -1, 0)
h = tick(h, pads())
h = tick(h, pads(Pad(seat = 1)))
print("by a parked fighter, 1: player 0 {if h.people[0].state == SEATED: "in" else: "not in"}, the computer's {if h.people[2].state == WALK: "out beside it" else: "still in"}")

# landing aboard: player 0 onto a blue zeppelin, its pilot blue's player 1
let z = fresh()
k = craft(z, ZEPPELIN, 1, vec3(0, 600, 0))
sit(z, 1, k, 0)
above(z, 0, k, 2)
z = tick(z, pads())
print("red player onto a blue zeppelin: {if z.people[0].state == SEATED: "aboard, seat {z.people[0].seat}" else: "not aboard"}")
z = tick(z, pads(Pad(), Pad(kick = true)))
z = tick(z, pads(Pad(seat = 1), Pad()))
print("blue's pilot kicks: red still aboard {z.people[0].state == SEATED and z.people[0].craft == k}; red asks for the pilot's seat: seats {seats(z, k)}")
print("the zeppelin's side {crew_at(z, k)}, its colors {z.crafts[k].team}")
# (the blue pilot gone: red flies it)
z.crafts[k].seats[0] = -1
z.people[1].state = DEAD
z = tick(z, pads())
z = tick(z, pads(Pad(seat = 1)))
print("alone aboard, to the pilot's seat: seat {z.people[0].seat}, the zeppelin's side now {crew_at(z, k)}")
# (blue's computer 3 falling onto it: the other side's crew now, not landed on)
above(z, 3, k, 3)
z = tick(z, pads())
print("blue's computer onto it, red flying it: {if z.people[3].state == SEATED: "aboard" else: "not aboard"}")

# blue's computer onto a blue balloon, and onto a red one; a red bomber going down; the craft one
# bailed out of a moment ago
let b = fresh()
bb = craft(b, BALLOON, 1, vec3(0, 600, 0))
rb = craft(b, BALLOON, 0, vec3(400, 600, 0))
db = craft(b, BOMBER, 0, vec3(800, 600, 0))
b.crafts[db].down = 1
above(b, 3, bb, 1)
above(b, 5, rb, 1)
above(b, 0, db, 1)
b = tick(b, pads())
print("blue's computer onto blue's balloon {b.people[3].state == SEATED}, onto red's {b.people[5].state == SEATED}; player onto a bomber going down {b.people[0].state == SEATED}")
sit(b, 0, rb, 1)
b = tick(b, pads())
b = tick(b, pads(Pad(leave = true)))
b = tick(b, pads())
print("bailed out of red's balloon: not back in it at once {b.people[0].state == FALL}")

# shot down with both sides aboard: a blue bomber, blue's computer its pilot, red's player 0 a
# gunner, shot down by red's player 2: red's point, 2's kill
let d = fresh()
q = craft(d, BOMBER, 1, vec3(0, 600, 0))
sit(d, 3, q, 0)
sit(d, 0, q, 1)
d.people[4].state = WALK
hurt_craft(d, q, 4, 0, 100000, d.crafts[q].pos)
print("shot down with red aboard: scores {d.scores[0]} {d.scores[1]}, red's player 2 kills {d.people[4].kills}")

# onto the middle of a red galleass's deck, its pilot red's computer: player 0 in the nearest
# ballista; red's player 2 high over a red zeppelin, then down onto its back
let v = fresh()
gv = craft(v, DAVINCI, 0, vec3(0, 600, 0))
sit(v, 2, gv, 0)
v.people[0].state = FALL
v.people[0].timer = 200
v.people[0].pos = point_of(v.crafts[gv], vec3(0, DV_BALLISTAS[0].y + 1.0, 0))
v.people[0].vel = v.crafts[gv].vel
v = tick(v, pads())
print("onto the galleass's deck: {if v.people[0].state == SEATED: "aboard, seat {v.people[0].seat}" else: "not aboard"}")
zz = craft(v, ZEPPELIN, 0, vec3(600, 600, 0))
v.people[4].state = CHUTE
v.people[4].timer = 200
v.people[4].opened = 100
v.people[4].pos = point_of(v.crafts[zz], vec3(0, 20, -10))
v.people[4].vel = v.crafts[zz].vel
v = tick(v, pads())
was = v.people[4].state == SEATED
loop n in 0..120: v = tick(v, pads())
print("over the zeppelin, 20 m up: aboard at once {was}; under the canopy a while: {if v.people[4].state == SEATED: "aboard, seat {v.people[4].seat}" else: "not aboard"}")
