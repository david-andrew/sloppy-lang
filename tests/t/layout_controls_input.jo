# requires: sloppy
# Previous-box input, directional ownership, keyed capture/focus, disabled controls and sizing.
import layout as ui

v = 0.5
on = false
index = 0
name = "Ada"
order = ["slider", "switch", "choice", "text"]
enabled = true
build = (input: ui.Input):
    global v, on, index, name
    ui.at(Rect(0, 0, 640, 240), render = false, input = input, ():
        ui.row(gap = 10, ():
            loop key in order:
                match key:
                    "slider": v = ui.slider(v, 0.0, 1.0, 0.1, width = 140, height = 40, enabled = enabled, key = key)
                    "switch": on = ui.switch(on, width = 140, height = 40, enabled = enabled, key = key)
                    "choice": index = ui.choice(["Easy", "Normal", "Hard"], index, width = 140, height = 40, enabled = enabled, key = key)
                    _: name = ui.text_field(name, width = 140, height = 40, enabled = enabled, key = key)
        )
        ui.button("Below", width = 140, height = 40, key = "below")
    )
near = (a: f64, b: f64): assert(abs(a - b) < 0.00001, "{a} != {b}")
build(ui.Input(activate = true, nav = vec2(1, 0)))
near(v, 0.5)
assert(not on and index == 0 and not ui.get("text")!.editing)
build(ui.Input(nav = vec2(1, 0)))
near(v, 0.6)
assert(ui.get("slider")!.focused)
# At an endpoint Left/Right still belongs to the slider, never to its neighbor.
v = 1.0
build(ui.Input(nav = vec2(1, 0)))
near(v, 1.0)
assert(ui.get("slider")!.focused)
build(ui.Input(next = 1))
assert(ui.get("switch")!.focused)
build(ui.Input(nav = vec2(1, 0)))
assert(not on and ui.get("switch")!.focused)
build(ui.Input(activate = true))
assert(on)
build(ui.Input(next = 1))
build(ui.Input(nav = vec2(-1, 0)))
assert(index == 2 and ui.get("choice")!.focused)
build(ui.Input(activate = true))
assert(index == 0)
build(ui.Input(next = 1))
build(ui.Input(activate = true))
assert(ui.get("text")!.editing)
build(ui.Input(nav = vec2(-1, 0)))
assert(ui.get("text")!.focused and ui.get("text")!.editing)
build(ui.Input(activate = true))
assert(ui.get("text")!.submitted and not ui.get("text")!.editing)
build(ui.Input())
assert(not ui.get("text")!.submitted)
build(ui.Input(activate = true))
build(ui.Input(next = -1))
assert(not ui.get("text")!.editing and ui.get("choice")!.focused)
# Mouse choice halves, tap a switch, and drag slider outside its old box.
build(ui.Input(pointer = vec2(330, 20), pressed = true, down = true))
build(ui.Input(pointer = vec2(330, 20), released = true))
assert(index == 2)
build(ui.Input(pointer = vec2(420, 20), pressed = true, down = true))
build(ui.Input(pointer = vec2(420, 20), released = true))
assert(index == 0)
build(ui.Input(pointer = vec2(170, 20), pressed = true, down = true))
build(ui.Input(pointer = vec2(170, 20), released = true))
assert(not on)
build(ui.Input(pointer = vec2(70, 20), pressed = true, down = true))
near(v, 0.5)
# Move the row order during the drag: this frame still uses slider's previous box.
order = ["switch", "slider", "choice", "text"]
build(ui.Input(pointer = vec2(128, 20), down = true))
near(v, 1.0)
assert(ui.get("slider")!.focused)
build(ui.Input(pointer = vec2(162, 20), down = true))
near(v, 0.0)
build(ui.Input(pointer = vec2(900, 20), released = true))
near(v, 1.0)
# Changing keyed order preserves keyboard focus too.
order = ["text", "choice", "switch", "slider"]
build(ui.Input(nav = vec2(-1, 0)))
near(v, 0.9)
assert(ui.get("slider")!.focused)
# Up/Down still navigate away from a value control.
build(ui.Input(nav = vec2(0, 1)))
assert(ui.get("below")!.focused)
# Disabled controls neither edit nor react, even on the frame they become disabled.
enabled = false
build(ui.Input(pointer = vec2(520, 20), pressed = true, down = true, nav = vec2(-1, 0), activate = true))
build(ui.Input(pointer = vec2(520, 20), released = true, activate = true))
near(v, 0.9)
assert(not on and index == 0)
loop x in [20, 170, 320]:
    build(ui.Input(pointer = vec2(x, 20), pressed = true, down = true))
    build(ui.Input(pointer = vec2(x, 20), released = true, activate = true))
assert(not on and index == 0 and not ui.get("text")!.editing)
# A slider drag owns the gesture inside scrolling content; touch taps still toggle.
ui.reset()
scroll_value = 0.5
scroll_on = false
listing = (input: ui.Input):
    global scroll_value, scroll_on
    ui.at(Rect(0, 0, 200, 80), render = false, input = input, ():
        ui.scroll(width = 200, height = 80, key = "list", ():
            scroll_value = ui.slider(scroll_value, 0.0, 1.0, width = 200, height = 40, key = "drag")
            scroll_on = ui.switch(scroll_on, width = 200, height = 40, key = "tap")
            ui.space(height = 160)
        )
    )
listing(ui.Input())
listing(ui.Input(pointer = vec2(100, 20), touch = true, pressed = true, down = true))
listing(ui.Input(pointer = vec2(188, 70), touch = true, down = true, tap = false))
near(scroll_value, 1.0)
assert(ui.bounds("drag")!.y == 0)
listing(ui.Input(pointer = vec2(188, 70), touch = true, released = true, tap = false))
listing(ui.Input(pointer = vec2(100, 60), touch = true, pressed = true, down = true))
listing(ui.Input(pointer = vec2(100, 60), touch = true, released = true))
assert(scroll_on)
# Empty choices, reversed ranges, equal endpoints, continuous step and all sizing forms.
ui.reset()
ui.at(Rect(0, 0, 400, 200), render = false, ():
    near(ui.slider(9.0, 2.0, 2.0, width = ui.percent(0.5), height = 30, key = "equal"), 2.0)
    near(ui.slider(3.0, 1.0, -1.0, width = ui.fixed(80)), 1.0)
    assert(ui.choice([], -8, width = ui.fit()) == 0)
    ui.text_field("", hint = "Name", width = ui.grow(), key = "sized")
)
assert(ui.bounds("equal")!.w == 200 and ui.bounds("sized")!.w == 400)
print("layout value control input ok")
