# requires: native
# requires: sloppy
# hud_scroll: the wheel and the bar move a list, a click buys the row under it, rows scrolled out
# of the box take no clicks
# env: SLOPPY_SCREENSHOT=$TMP/hud_scroll.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=30
# env: SLOPPY_INPUT=2:mouse=150x200,3:wheel=-1,4:wheel=-1,5:wheel=-1,8:mouse_left+,9:mouse_left-,12:mouse=330x300,14:mouse_left+,16:mouse=330x330,18:mouse_left-,22:mouse=150x360,23:mouse_left+,24:mouse_left-
window("shop", 640, 400)
items = [loop i in [0..30): "item {i}"]
bought: int[]
last_off = 0.0
draw = ():
    global last_off
    clear(rgb(0.1, 0.1, 0.12))
    r = Rect(40, 40, 300, 300)
    off = hud_scroll(r, f64(items.len()) * 44.0, "shop")
    if off != last_off: print("scrolled to {off}")
    last_off = off
    clip(vec2(r.x, r.y), vec2(r.w, r.h))
    loop i in 0.. and it in items:
        if hud_button(Rect(r.x, r.y + f32(f64(i) * 44.0 - off), r.w - 14, 40), it):
            bought.push(i)
            print("bought {i}")
    no_clip()
    if frame_number() == 28: print("bought {bought}")
