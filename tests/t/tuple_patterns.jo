# requires: sloppy
# tuple patterns: each part a value, a range, .variant or _
enum St:
    idle
    run
enum Key:
    space
    left
step = (s: St, k: Key) -> St:
    match (s, k):
        (.idle, .space): .run
        (.run, .left), (.run, .space): .idle
        _: s
print(step(.idle, .space), step(.run, .left), step(.idle, .left))
loop p in [(1, (2, 3)) (5, (0, 0)) (7, (9, 1))]:
    d = match p:
        (1, (2, _)): "one-two"
        (5..10, (0, 0)): "five+ zeros"
        (_, (_, _)) if p.0 > 6: "big {p.1.0}"
        _: "other"
    print(d)
match (true, 3):
    (true, 0..5): print("low true")
    _: print("else")
MAX = 3
f = (a: int, b: int) -> str:
    match (a, b):
        (MAX, _): "max"
        _: "no"
print(f(3, 1), f(2, 1))
loop p in [(1, 2) (3, 4)]:
    match p:
        (1, _): print("one")
        (_, 4): print("four")
loop i in [1..15]:
    print(match (i % 3, i % 5):
        (0, 0): "FizzBuzz"
        (0, _): "Fizz"
        (_, 0): "Buzz"
        _: "{i}")
