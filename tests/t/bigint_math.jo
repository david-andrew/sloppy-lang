# requires: sloppy (lib/std/bigint.jo)
# exact big integers at work: Project Euler's sums of digits, factorials, Fibonacci, number theory,
# RSA, and the long-division and printing paths of large numbers

print(digits(bigint(2) ^ 1000).sum())               # 1366
f = bigint(1)
loop i in [1..100]: f *= i
print(digits(f).sum(), len(str(f)))                 # 648 158

# the first Fibonacci number with 1000 digits (Euler 25: 4782)
a = bigint(1)
b = bigint(1)
n = 2
loop len(str(b)) < 1000:
    c = a + b
    a = b
    b = c
    n += 1
print(n, str(b)[0..20])

# 2^100000: its digits, printed by halves, and back
p = bigint(2) ^ 100000
s = str(p)
print(len(s), s[0..12], s[len(s) - 12..], bigint(s) == p, digits(p).sum())

# number theory
print(gcd(bigint(2) ^ 100 * 3 ^ 5, bigint(6) ^ 50), lcm(bigint(4), bigint(-6)), gcd(bigint(0), bigint(0)))
print(isqrt(bigint(10) ^ 100), isqrt(bigint(10) ^ 101), isqrt(bigint(15)), isqrt(bigint(0)))
r = isqrt(bigint(2) * bigint(10) ^ 200)
print(str(r)[0..30], r * r <= bigint(2) * bigint(10) ^ 200, (r + 1) * (r + 1) > bigint(2) * bigint(10) ^ 200)
print(pow_mod(bigint(3), bigint(10) ^ 30, bigint(1_000_000_007)), pow_mod(bigint(2), -1, bigint(7)), pow_mod(bigint(-2), 3, bigint(5)))
print(inv_mod(bigint(3), bigint(7)), inv_mod(bigint(2), bigint(4)), mod(bigint(-7), 3), mod(bigint(7), -3))

# RSA with two Mersenne primes: what is encrypted with e decrypts with d
p1 = bigint(2) ^ 127 - 1
p2 = bigint(2) ^ 89 - 1
nn = p1 * p2
phi = (p1 - 1) * (p2 - 1)
e = bigint(65537)
d = inv_mod(e, phi)!
msg = bigint("424242424242424242424242424242")
c = pow_mod(msg, e, nn)
print(c)
print(pow_mod(c, d, nn) == msg, e * d % phi)

# Fermat's little theorem for the 521-bit prime 2^521 - 1
mp = bigint(2) ^ 521 - 1
print(pow_mod(bigint(3), mp - 1, mp), pow_mod(bigint(3), mp, mp) == 3)

# long division: a quotient digit guessed one too large, so the divisor is added back (Hacker's
# Delight's cases, with 32-bit and with 64-bit digits), and large operands
one = bigint(1)
loop w in [32, 64]:
    h = one << (w - 1)
    u1 = 3 + (h << (2 * w))
    v1 = 1 + ((one << (w - 3)) << (2 * w))
    u2 = (h << (2 * w)) + ((h - 1) << (3 * w))
    v2 = 1 + (h << (2 * w))
    print(u1 / v1, u1 % v1, u2 / v2, u2 % v2)
y = bigint(3) ^ 5000
z = y * y + 12345
print(z / y == y, z % y, (z / (y + 1)) * (y + 1) + z % (y + 1) == z)

# factorial of 1000 by a product tree (Karatsuba) and by a loop agree
prod_range = (lo: int, hi: int) -> BigInt:
    if hi - lo < 8:
        let acc = bigint(1)
        loop i in lo..hi: acc *= i
        return acc
    mid = (lo + hi) / 2
    prod_range(lo, mid) * prod_range(mid, hi)
g = bigint(1)
loop i in [1..1000]: g *= i
print(prod_range(1, 1001) == g, len(str(g)), digits(g).sum())
