# requires: native
# requires: sloppy
# a SLOPPY_INPUT finger tap presses a hud_button as a real one does (and as a scripted click
# does), with hud_nav on or off; a finger that slides off before it lifts presses nothing
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_TOUCH=1
# env: SLOPPY_WINDOW=844x390
# env: SLOPPY_FRAMES=40
# env: SLOPPY_INPUT=5:touch1=688x140 8:touch1- 15:touch1=688x140 18:touch1- 25:touch1=688x140 27:touch1=688x300 29:touch1-
window("hud tap", 844, 390)
draw = ():
    clear(rgb(0, 0, 0))
    f = frame_number()
    hud_nav(f >= 12 and f < 20)
    if hud_button(Rect(600, 120, 176, 40), "New game"): print("{f}: New game, touch {touch_input()}")
