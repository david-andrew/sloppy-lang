# requires: native
# requires: sloppy
# hud_nav: the arrows, the d-pad and the stick move a focus among hud_ boxes by where they are; Enter
# and A choose (a button clicks, a checkbox flips), left and right step a slider; the ring shows
# in hud_style.focus until the mouse moves, which takes the focus to the box it moves onto
# env: SLOPPY_SCREENSHOT=$TMP/hud_nav.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=70
# env: SLOPPY_INPUT=3:down+ 4:down- 6:enter+ 7:enter- 9:right+ 10:right- 12:pad_a+ 13:pad_a- 15:pad_down+ 16:pad_down- 18:pad_right+ 19:pad_right- 20:right+ 21:right- 23:lstick=0x1 24:lstick=0x0 26:pad_left+ 27:pad_left- 29:space+ 30:space- 32:down+ 33:down- 35:enter+ 36:enter- 38:down+ 39:down- 40:enter+ 41:enter- 42:mouse=650x235 45:enter+ 46:enter- 48:down+ 49:down- 51:down+ 52:down- 54:up+ 55:up- 57:up+ 58:up- 60:up+ 61:up- 63:enter+ 64:enter-
window("hud nav", 1280, 720)
vol = 0.5
pan = 0.0
music = true
draw = ():
    global music, pan, vol
    clear(rgb(0.1, 0.12, 0.16))
    hud_style.focus = rgb(1, 0, 0)
    hud_nav(true)
    hud_panel(Rect(440, 120, 400, 440))
    if hud_button(Rect(480, 160, 320, 44), "Resume"): print("{frame_number()}: Resume")
    if hud_button(Rect(480, 214, 155, 44), "Load"): print("{frame_number()}: Load")
    if hud_button(Rect(645, 214, 155, 44), "Save"): print("{frame_number()}: Save")
    v = hud_slider(Rect(480, 268, 320, 40), vol, 0, 1, 0.1, "Volume")
    if v != vol: print("{frame_number()}: volume {v}")
    vol = v
    p = hud_slider(Rect(480, 318, 320, 40), pan, -1, 1, label = "Pan")
    if p != pan: print("{frame_number()}: pan {p}")
    pan = p
    m = hud_checkbox(Rect(480, 368, 320, 32), "Music", music)
    if m != music: print("{frame_number()}: music {m}")
    music = m
    if hud_button(Rect(480, 500, 320, 44), "Quit", enabled = false): print("a disabled button clicked")
    if frame_number() == 8 or frame_number() == 41 or frame_number() == 44 or frame_number() == 47: print("{frame_number()}: active {hud_nav_active()}")
    # (the ring: red just outside Load's left edge, none around Resume)
    if frame_number() == 8:
        img = screenshot()
        k = f64(img.width) / 1280.0
        red = (x: int, y: int) -> bool:
            q = (int(f64(y) * k) * img.width + int(f64(x) * k)) * 4
            int(img.pixels[q]) - int(img.pixels[q + 1]) > 100
        ring = false
        loop x in [474..480):
            if red(x, 236): ring = true
        bare = true
        loop x in [474..480):
            if red(x, 182): bare = false
        print("ring around Load {ring}, none around Resume {bare}")
