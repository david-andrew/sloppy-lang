# requires: native
# requires: sloppy
# hud_button, hud_panel, hud_bar: clicks on a button act once each, a disabled one does not,
# and hud_hovered keeps a click on the interface from counting as one on the world
# env: SLOPPY_SCREENSHOT=$TMP/hud.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=42
# env: SLOPPY_INPUT=2:mouse=100x640 3:mouse_left+ 4:mouse_left- 6:mouse_left+ 7:mouse_left- 9:mouse_left+ 10:mouse_left- 12:mouse=640x300 13:mouse_left+ 14:mouse_left- 20:mouse=300x640 21:mouse_left+ 22:mouse_left-
food = 120
workers = 0
orders = 0
update = (dt: f64):
    if mouse_pressed(.left) and not hud_hovered(): orders += 1
draw = ():
    clear(rgb(0.2, 0.35, 0.2))
    hud_panel(Rect(0, 600, 1280, 120))
    if hud_button(Rect(20, 620, 200, 44), "Train worker", enabled = food >= 50):
        food -= 50
        workers += 1
    hud_button(Rect(240, 620, 200, 44), "Build farm", enabled = false)
    hud_bar(Rect(20, 680, 200, 12), f64(food) / 200.0, rgb(0.9, 0.8, 0.3))
    text("food {food} workers {workers} orders {orders}", vec2(20, 20), 28)
    if frame_number() == 40: print("food {food} workers {workers} orders {orders}")
