# requires: sloppy
# requires: native
# A scripting workflow: propagate read/parse errors once; keep EOF local to the loop.
read_numbers = (path: str) -> int[] | FileError | ParseError:
    text = read_file(path)?
    ints(text)?

count_lines = (f: mut File) -> int | FileError:
    n = 0
    loop:
        line = f.read_line()
        if line is FileError: return line
        if line == none: break
        n += 1
    n

p = join_path(temp_dir(), "sloppy_newcomer_checked_workflow")
assert(write_file(p, "x=3\r\ny=-4\n\nlast=5"))
assert(read_numbers(p).unwrap() == [3, -4, 5])
f = open_file(p)!
assert(count_lines(f).unwrap() == 4)
f.close()
assert(write_file(p, "n=9223372036854775808"))
bad = read_numbers(p)
assert(bad is ParseError)
if bad is ParseError:
    assert(bad.start == 2 and bad.end == 21 and bad.message.len() > 0)
assert(delete_file(p))
missing = read_numbers(p)
assert(missing is FileError)
if missing is FileError:
    assert(missing.path == p and missing.operation == "read_file" and missing.message.len() > 0)
pattern = regex("[")
assert(pattern is RegexError)
if pattern is RegexError: assert(pattern.position > 0 and pattern.message.len() > 0)
j = parse_json(r'{"quantity":2.9,"items":[{"name":"tea"}]}').unwrap()
assert(j.get("items").get(0).get("name").as_str() == "tea")
assert(j.get("items").get(3).get("name").as_str() == none)
assert(j.get("quantity").as_int() == 2)
assert(parse_json("9223372036854775808").unwrap().as_int() == none)
assert(parse_json("{") is JsonError)
j.put("quantity", 5)
assert(from_json[int](to_json(j.get("quantity")!)).unwrap() == 5)
print("newcomer checked workflow ok")

