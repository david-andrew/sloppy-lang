# requires: sloppy
# no warnings
# changes to a copy that are read after (given back, stored, passed on, read in the next round of
# a loop, after a break or a continue, by a function made after, after either branch): no warning
struct P:
    x = 0
    y = 0
struct Node:
    value: int
    next: Node?
struct World:
    ps: P[]
    best: P

# built in a local and given back
make = (w: World) -> P:
    p = w.best
    p.x += 1
    p

# a copy made on purpose, changed, given back
moved = (g: P) -> P:
    let g = g
    g.x = 5
    g.y = 6
    g

# changed, then stored back
bump = (w: mut World, i: int):
    p = w.ps[i]
    p.x += 1
    w.ps[i] = p

# changed in a loop, read on the next round
sums = (w: World) -> int:
    acc = w.best
    t = 0
    loop q in w.ps:
        t += acc.x
        acc.x = q.x
    t

# changed, then passed on
show = (w: World):
    p = w.best
    p.y = 3
    print(p)

# changed in a loop, read after a break
find_x = (w: World) -> int:
    p = w.best
    loop q in w.ps:
        if q.x > 2:
            p.x = q.x
            break
    p.x

# changed, then continue to a round that reads it
cont = (w: World) -> int:
    p = w.best
    n = 0
    loop q in w.ps:
        n += p.x
        if q.x > 0:
            p.x = q.x
            continue
        n += 1
    n

# loop let walking with a copy changed and read in the condition
walk = (l: Node) -> int:
    cur = l
    n = 0
    loop cur.next != none:
        cur.value += 1
        n += cur.value
        cur = cur.next!
    n

# a change read by a lambda made after
lam = (w: World) -> int:
    p = w.best
    p.x = 4
    f = (): p.x
    f()

# a change in one branch, read in the code after both
br = (w: World, c: bool) -> int:
    p = w.best
    if c: p.x = 1
    else: p.y = 2
    p.x + p.y

# match arms reading after
enum Sh:
    a
    b
mt = (w: World, s: Sh) -> int:
    p = w.best
    match s:
        .a: p.x = 1
        .b: p.x = 2
    p.x

# `loop mut` over a copy's array, read after
lm = (w: World) -> P[]:
    ps = w.ps
    loop mut q in ps: q.x += 1
    ps

# a global copy changed and read (top level, no function)
w0 = World([P(1, 1)], P())
print(make(w0), moved(P()), sums(w0), find_x(w0), cont(w0), walk(Node(1, Node(2))), lam(w0), br(w0, true), mt(w0, .a), lm(w0))
bump(w0, 0)
show(w0)
