# min, max, clamp and abs keep an integer type (min(x, 5) with x: i32 is an i32); mixed types
# still take int's; negating an integer vector wraps as its components do; the same in compute
# functions (unsigned ones compared as unsigned)
# requires: sloppy
ty = (x: i32) -> str: "i32"
ty = (x: int) -> str: "int"
ty = (x: u8) -> str: "u8"
ty = (x: u32) -> str: "u32"
ty = (x: i8) -> str: "i8"
x: i32 = 5
print(ty(min(x, 3)), ty(max(x, 3)), ty(min(i8(1), u8(2))), ty(max(u8(3), 300)), ty(min(2, 3)), ty(clamp(u8(9), u8(1), u8(5))))
print(clamp(u32(4000000000), u32(0), u32(4100000000)), max(u32(4000000000), u32(5)), abs(i8(-128)), abs(i8(-5)), abs(i32(-7)))
v = ivec2(i32(-1865371549), i32(2038070033))
print(-v, -ivec2(i32(-2147483648), i32(3)), -vec2(1.5, -2))

struct P:
    out: GpuBuffer[u32]
    neg: GpuBuffer[ivec2]
k = (id: int, u: P):
    a = u32(4000000000) + u32(id)
    u.out[id * 4] = max(a, u32(7))
    u.out[id * 4 + 1] = min(a, u32(3000000000))
    u.out[id * 4 + 2] = clamp(a, u32(100), u32(4000000001))
    u.out[id * 4 + 3] = u32(i32(abs(i8(-128 + id))))
    u.neg[id] = -ivec2(i32(-1865371549) + i32(id), i32(2038070033))
p = P(gpu_buffer[u32](8), gpu_buffer[ivec2](2))
dispatch(compute(k), 2, p)
print(cpu(p.out))
print(cpu(p.neg))
