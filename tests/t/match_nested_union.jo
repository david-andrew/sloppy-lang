# requires: sloppy
# the result type of a function reaches every arm of the match on its last line, and the arms of a match or if among them
struct E: m: str
h = (e: int, op: str) -> f64 | E:
    match e:
        0: 1.0
        _:
            match op:
                "+": 2.0
                _: E("bad")
print(h(0, ""), h(1, "+"), h(1, "-"))
k = (e: int, op: str) -> f64 | E:
    match e:
        0: 1.0
        _: if op == "+": 2.0 else: E("bad")
print(k(0, ""), k(1, "+"), k(1, "-"))
enum X:
    a(v: f64)
    b(op: str)
h7 = (e: X) -> f64 | E:
    match e:
        .a(v): v
        .b(op):
            x = 1.0
            match op:
                "+": x + 1.0
                _: E("bad")
print(h7(X.a(1.0)), h7(X.b("+")), h7(X.b("-")))
