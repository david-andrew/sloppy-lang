# b[i].f = v (and +=) for types that define [] and []=, a GpuBuffer among them: the element is
# read, changed and written back, its index computed once; in compute functions too
# requires: sloppy
struct Bug:
    pos: vec2
    vel: vec2
    hp: i32
struct Grid:
    cells: Bug[]
([]) = (g: Grid, i: int) -> Bug: g.cells[i]
([]=) = (g: mut Grid, i: int, v: Bug): g.cells[i] = v
struct Step:
    bugs: GpuBuffer[Bug]
    dt: f32
step = (id: int, u: Step):
    u.bugs[id].pos += u.bugs[id].vel * u.dt
    u.bugs[id].hp -= i32(1)
calls = 0
pick = (i: int) -> int:
    calls += 1
    i
main = ():
    b: GpuBuffer[Bug] = gpu_buffer(3)
    b[1].hp = 7
    b[pick(2)].pos.x += 1.5
    b[pick(2)].pos.y = 2
    print(cpu(b), calls)
    g = Grid([Bug(vec2(0, 0), vec2(0, 0), 1), Bug(vec2(0, 0), vec2(0, 0), 2)])
    g[pick(1)].hp += i32(40)
    g[0].vel = vec2(3, 4)
    print(g.cells, calls)
    n: GpuBuffer[i32] = gpu_buffer(2)
    n[pick(1)] += i32(5)
    print(cpu(n), calls)
    bugs = gpu_buffer([Bug(vec2(0, 0), vec2(1, 2), 10), Bug(vec2(5, 5), vec2(-1, 0), 3)])
    dispatch(compute(step), len(bugs), Step(bugs, 0.5))
    print(cpu(bugs))
