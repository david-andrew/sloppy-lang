# requires: sloppy
# Read-only aggregate parameters specialize by uniform path, including nested helpers.
# Ordinary copies and mutable parameters retain their by-value / inout semantics.
struct UniformVertex:
    pos: vec3
struct UniformOut:
    pos: vec4
struct UniformLarge:
    color: vec4
    unused: vec4[240]
uniform_color = (p: UniformLarge) -> vec4: p.color
uniform_forward = (p: UniformLarge) -> vec4: uniform_color(p)
uniform_vs = (v: UniformVertex, p: UniformLarge) -> UniformOut: UniformOut(vec4(v.pos, 1))
uniform_fs = (v: UniformOut, p: UniformLarge) -> vec4: uniform_forward(p)
s = shader(uniform_vs, uniform_fs)
assert((index_of(s.fs, "uniform vec4 sl_u_0;") ?? -1) >= 0)
assert((index_of(s.vs, "uniform vec4") ?? -1) < 0)
assert((index_of(s.vs, "[240]") ?? -1) < 0 and (index_of(s.fs, "[240]") ?? -1) < 0)
assert((index_of(s.layout, ";sl_u_0,v4,0") ?? -1) >= 0)
assert(__gl_uniform_name("u.sl_u_1_0_") == "sl_u_1_0")
assert(__gl_uniform_name("u.sl_u_1_[0]") == "sl_u_1[0]")
assert(__gl_uniform_name("u.sl_u_2_.t_") == "sl_u_2.t_")
assert(__gl_uniform_name("u.sl_u_2_.n_") == "sl_u_2.n_")
assert(__gl_uniform_name("u_proj") == "u_proj")
struct UniformPart:
    color: vec4
    weights: f32[2]
struct UniformNested:
    left: UniformPart
    right: UniformPart
    matrix: mat4
part_color = (p: UniformPart) -> vec4: p.color * p.weights[1]
part_copy = (p: UniformPart) -> vec4:
    c = p
    c.color *= 0.5
    part_color(c)
part_mutate = (p: mut UniformPart): p.color *= 0.5
nested_vs = (v: UniformVertex, p: UniformNested) -> UniformOut: UniformOut(p.matrix * vec4(v.pos, 1))
nested_fs = (v: UniformOut, p: UniformNested) -> vec4:
    local = UniformPart(vec4(1, 1, 1, 1), [0.0, 1.0])
    part_mutate(local)
    part_color(p.left) + part_color(p.right) + part_color(local) + part_copy(p.left)
n = shader(nested_vs, nested_fs)
assert((index_of(n.fs, "uniform vec4 sl_u_0_0;") ?? -1) >= 0 and (index_of(n.fs, "uniform vec4 sl_u_1_0;") ?? -1) >= 0)
assert((index_of(n.fs, "uniform float[2] sl_u_0_1;") ?? -1) >= 0 and (index_of(n.fs, "uniform float[2] sl_u_1_1;") ?? -1) >= 0)
assert((index_of(n.fs, "uniform mat4") ?? -1) < 0 and (index_of(n.vs, "uniform mat4 sl_u_2;") ?? -1) >= 0)
assert((index_of(n.fs, "inout S_UniformPart") ?? -1) >= 0)
# A mutable entry parameter receives a private copy, never a writable global uniform.
mutable_fs = (v: UniformOut, p: mut UniformNested) -> vec4:
    part_mutate(p.left)
    p.left.color
m = shader(nested_vs, mutable_fs)
assert((index_of(m.fs, "inout S_UniformNested") ?? -1) >= 0)
assert((index_of(m.fs, " u = S_UniformNested") ?? -1) >= 0)
print("uniform specialization ok")
