# requires: sloppy
# from_json with a map type argument, and an error that says where it is
struct Item:
    name = ""
    count = 0
struct P:
    a = 1
print(from_json[{str: P}](r'{"x": {"a": 5}}'))
struct Save:
    items: Item[] = []
r = from_json[Save](r'{"items": [{"name": "a", "count": 3.5}]}')
if r is TextError: print(r.message, r.path)
