# requires: native
# run_program and run_shell: output returned or shown as it runs (after what was printed
# before it), the exit code, and the directory it runs in
print("first")
when TARGET == "windows":
    code, out = run_shell("echo shown", show = true)
    print(code, len(out))
    c2, o2 = run_shell("echo kept & exit 3")
    print(c2, trim(o2))
    c3, o3 = run_shell("cd", cwd = temp_dir())
    print(c3, trim(o3) == temp_dir() or len(o3) > 0)
else:
    code, out = run_shell("echo shown", show = true)
    print(code, len(out))
    c2, o2 = run_shell("echo kept; exit 3")
    print(c2, trim(o2))
    c3, o3 = run_shell("pwd", cwd = "/")
    print(c3, trim(o3) == "/" or len(o3) > 0)
c4, _ = run_program("sloppy-no-such-program")
print(c4)
