# requires: native
# requires: sloppy
# SLOPPY_INPUT's keys type what a US keyboard types: punctuation, shifted too
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=12
# env: SLOPPY_INPUT=2:period+,3:period-,4:shift+,5:period+,6:period-,7:n1+,8:n1-,8:shift-,9:quote+,10:lbracket+
draw = ():
    clear(BLACK)
    t = text_input()
    if len(t) > 0: print(frame_number(), "[{t}]")
