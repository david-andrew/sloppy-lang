# requires: sloppy
# requires: native
# env: T=$TMP
# env: XDG_CONFIG_HOME=$TMP/xdg-config
# The same output on every system: what differs (Windows' \ and letters in either case) is
# worked out here
win = false
when TARGET == "windows":
    win = true
t = env("T") ?? "."

# join_path: \ after a path written with \ (on Windows)
sep = "/"
if win: sep = "\\"
print(join_path(r"C:\Users\Sam\Documents", "report.txt") == r"C:\Users\Sam\Documents" + sep + "report.txt")
print(join_path("art", "hero.png"), join_path("art/", "hero.png"), join_path("", "x"))

# glob: on Windows "*.TXT" is notes.txt too, as Windows' file names are
d = "{t}/globcase"
make_dirs(d)
write_file("{d}/notes.txt", "x")
want = 0
if win: want = 1
print(glob("{d}/*.TXT").len() == want, glob("{d}/*.txt").len())
delete_file("{d}/notes.txt")
delete_dir(d)

# names Windows does not allow are refused for saving on every system, with why
print(save_data("con", "x"), file_error())
print(save_data("high*score", "x"), file_error())
print(save_data("best.", "1"), file_error())
print(save_data("best", "1"), load_data("best") ?? "")

# home and Documents
print(len(home_dir()) > 0)
when TARGET == "windows":
    print(len(documents_dir()) > 0)
    print(is_dir(documents_dir()))
else when TARGET == "linux":
    # (XDG_DOCUMENTS_DIR, from user-dirs.dirs)
    conf = env("XDG_CONFIG_HOME") ?? ""
    make_dirs(conf)
    write_file("{conf}/user-dirs.dirs", "# a comment\nXDG_DESKTOP_DIR=\"$HOME/Desktop\"\nXDG_DOCUMENTS_DIR=\"$HOME/Papers\"\n")
    print(documents_dir() == home_dir() + "/Papers")
    write_file("{conf}/user-dirs.dirs", "XDG_DOCUMENTS_DIR=\"$HOME/\"\n")
    print(documents_dir() == home_dir() + "/Documents")
    delete_file("{conf}/user-dirs.dirs")
else:
    print(true)
    print(true)
