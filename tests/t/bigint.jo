# requires: sloppy (lib/std/bigint.jo)
# exact big integers: making them, operators, mixing with ints, printing, conversions

x = bigint("123456789012345678901234567890")
print(x, -x, x + 1, 1 + x, x - x, x * x)
print(x * -3, -3 * x, x / 7, x % 7, x - 1, 1 - x)

# carries and borrows across 32-bit digits
m = bigint(2) ^ 64 - 1
print(m, m + 1, (m + 1) - 1, m * m, bigint(2) ^ 128 - m * m)

# division truncates toward zero and % keeps the left side's sign, as for ints; mod is from 0
loop a in [7, -7]:
    loop b in [2, -2, 3, -3]:
        print(a, b, bigint(a) / bigint(b), bigint(a) % bigint(b), a / b, a % b, mod(bigint(a), bigint(b)))
q = bigint(10) ^ 40
d = bigint(3) ^ 30 + 5
print(q / d, q % d, q / d * d + q % d == q)

# powers, shifts
print(bigint(2) ^ 100, bigint(-3) ^ 5, bigint(7) ^ 0, bigint(2) ^ -1, bigint(-1) ^ -3)
print(bigint(1) << 100, (bigint(1) << 100) >> 99, bigint(-7) >> 1, bigint(-8) >> 2, bigint(5) << -1)

# comparisons, with ints too
a = bigint(2) ^ 70
print(a > 5, a < 5, 5 < a, a == a, a != a + 1, bigint(5) == 5, 5 == bigint(5), bigint(-5) < -4)
print(min(a, -a), max(a, bigint(3)), [bigint(3), -a, bigint(0), a].sorted())

# compound assignment
z = a
z += 1
z -= 2
z *= 3
z /= 4
z %= 1000
print(z)

# as map keys and in sets: equal values hash alike, however they were made
counts: {BigInt: int}
counts[bigint(2) ^ 80] += 1
counts[bigint("1208925819614629174706176")] += 1
counts[bigint(1) << 80] += 1
print(counts)
seen: Set[BigInt] = {bigint(0), bigint(-0), bigint(0) * -5}
print(seen.len())

# text: decimal, other bases, prefixes, signs, underscores, spaces; none for what is not a number
print(to_bigint("  -00042 "), to_bigint("+17"), to_bigint("1_000_000"), to_bigint("0xff"), to_bigint("0b1011"), to_bigint("0o17"))
print(to_bigint("ff", 16), to_bigint("zz", 36), to_bigint("-0"), to_bigint(""), to_bigint("-"), to_bigint("12a"), to_bigint("0x"))
print(str(bigint(255), 16), str(bigint(-255), 2), str(bigint(0), 7), str(bigint(2) ^ 100, 36))
print(digits(bigint(2) ^ 10), digits(bigint(0)), bit_length(bigint(255)), bit_length(bigint(256)), bit_length(bigint(0)))
print(sign(bigint(-3)), sign(bigint(0)), sign(bigint(3)), abs(bigint(-3)))

# back to ints and floats
print(int(bigint(MIN_INT)), int(bigint(MAX_INT)), to_int(bigint(MAX_INT) + 1), to_int(bigint(MIN_INT) - 1))
print(bigint(MIN_INT), bigint(MAX_INT) + 1, bigint(u64(18446744073709551615)), to_u64(bigint(2) ^ 64 - 1), to_u64(bigint(2) ^ 64))
print(f64(bigint(2) ^ 100), f64(-(bigint(10) ^ 30)), f64(bigint(10) ^ 400), f64(bigint(2) ^ 53 + 1))

# shown in strings, arrays, structs; to_text and JSON read back
struct Account:
    name: str
    balance: BigInt
acc = Account("x", bigint(10) ^ 25)
print("{a}", "[{a:>25}]", [a, -a], acc)
t = to_text(acc)
back = from_text[Account](t)
if back is Account: print(back.balance == acc.balance)
j = to_json([a, -a])
print(from_json[BigInt[]](j))
zero: BigInt
print(zero, zero == 0, BigInt() + 5)
