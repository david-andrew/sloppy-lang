# requires: sloppy
# env: SLOPPY_THREADS=4
@noinline
double = (i: int) -> int: i * 2

factorial = (i: int) -> int:
    if i < 2: return 1
    i * factorial(i - 1)

struct ParallelItem:
    label: str
    index: int

# Each thread writes a distinct element of storage made unique before the job starts.
write_indices = (xs: mut int[], factor: int):
    xs.reserve(xs.len())
    p = data(xs)
    parallel_range(xs.len(), (i): p[i] = i * factor)

main = ():
    source = [3, 5, 7, 11]
    loop bias in [1..4):
        ys = parallel_range(513, (i): source[i % 4] + bias * i)
        loop i in [0..ys.len()): assert(ys[i] == source[i % 4] + bias * i)
    xs = fill(0, 513)
    old = xs
    write_indices(xs, 7)
    loop i in [0..xs.len()): assert(xs[i] == i * 7 and old[i] == 0)
    assert(parallel_range(0, double).len() == 0)
    assert(parallel_range(1, double) == [0])
    assert(parallel_range(5, double) == [0, 2, 4, 6, 8])
    assert(parallel_range(6, factorial) == [1, 1, 2, 6, 24, 120])
    factor = 3
    pairs = parallel_range(17, (i): (i, i * factor))
    assert(pairs[16] == (16, 48))
    items = parallel_range(17, (i): ParallelItem("v{i}", i))
    assert(items[16].label == "v16" and items[16].index == 16)
    nested = parallel_range(4, (i): parallel_range(3, (j): i * 10 + j))
    assert(nested == [[0, 1, 2], [10, 11, 12], [20, 21, 22], [30, 31, 32]])
    # A callback can construct another lambda with its own per-call capture.
    strings = parallel_range(9, (i): [1, 2].map((x): "{i}:{x}"))
    assert(strings[8] == ["8:1", "8:2"])
    before = alloc_count()
    loop bias in [0..10):
        ys = parallel_range(100, (i): "{bias}:{source[i % 4]}")
        assert(ys[99] == "{bias}:11")
    assert(alloc_count() == before)
    print("parallel callbacks ok")
