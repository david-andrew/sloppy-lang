# requires: sloppy
# unsigned division and remainder by constants (release builds multiply by a magic number):
# the same as dividing, for edge values and many divisors, in loops after other loops
xs = [u64(0), 1, 2, 9, 10, 11, 99, 1000, 123456789, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFE, 0x8000000000000000, 0x7FFFFFFFFFFFFFFF, 18446744073709551000, 9999999999999999999, 4294967296, 4294967295]
h: u64 = 0
loop x in xs:
    h = h * 31 + x / 3 + (x % 3) * 7
    h = h * 31 + x / 5 + (x % 5) * 7
    h = h * 31 + x / 6 + (x % 6) * 7
    h = h * 31 + x / 7 + (x % 7) * 7
    h = h * 31 + x / 9 + (x % 9) * 7
    h = h * 31 + x / 10 + (x % 10) * 7
    h = h * 31 + x / 11 + (x % 11) * 7
    h = h * 31 + x / 12 + (x % 12) * 7
    h = h * 31 + x / 13 + (x % 13) * 7
    h = h * 31 + x / 25 + (x % 25) * 7
    h = h * 31 + x / 60 + (x % 60) * 7
    h = h * 31 + x / 100 + (x % 100) * 7
    h = h * 31 + x / 641 + (x % 641) * 7
    h = h * 31 + x / 1000 + (x % 1000) * 7
    h = h * 31 + x / 1000000007 + (x % 1000000007) * 7
    h = h * 31 + x / 1000000000039 + (x % 1000000000039) * 7
    h = h * 31 + x / 8589934591 + (x % 8589934591) * 7
    h = h * 31 + x / 4611686018427387909 + (x % 4611686018427387909) * 7
    h = h * 31 + x / 9223372036854775809 + (x % 9223372036854775809) * 7
    print(x / 10, x % 10, x / 7, x % 1000)
print(h)
s: u64 = 0
loop i in [0..2000000):
    v = u64(i) * 2654435761
    s += v / 10 + v % 10 + v / 3 + v / 1000000007
print(s, str(12345678901234567890), "{u64(18446744073709551615)}")

g = (v: u64, neg: bool, minw: int) -> int:
    ndig = 1
    t = v
    loop t >= 10:
        t = t / 10
        ndig += 1
    width = ndig
    if neg: width += 1
    if width < minw: width = minw
    k = width - 1
    t = v
    acc = 0
    loop k >= 0:
        acc = acc * 10 + int(t % 10)
        t = t / 10
        k -= 1
    ndig * 1000000 + acc
print(g(1000, false, 0), g(65, false, 0))
