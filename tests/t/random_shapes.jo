# random directions, points and colors stay where they should
# requires: sloppy
seed_random(3)
d = random_direction()
print(abs(length(d) - 1.0) < 0.001, abs(length(random_direction_3d()) - 1.0) < 0.001)
p = random_point(vec2(10, 20), vec2(30, 40))
print(p.x >= 10.0 and p.x < 30.0 and p.y >= 20.0 and p.y < 40.0)
c = random_in_circle(vec2(100, 100), 5)
print(length(c - vec2(100, 100)) <= 5.0, random_color().w)
