# requires: sloppy
# requires: native
import net

loop host in ["127.0.0.1", ""]:
    # Closing only the listener permits an immediate rebind, including on Windows.
    s = net.tcp_listen(0, host = host)
    assert(s >= 0)
    p = net.tcp_port(s)
    net.tcp_close(s)
    again = net.tcp_listen(p, host = host)
    assert(again >= 0)
    net.tcp_close(again)
    assert(net.listen(p, host = host))
    net.stop_listening()
    assert(net.listen(p, host = host))
    net.stop_listening()

    # Accepted connections actively closed by the server leave its port in TIME_WAIT.
    # Linux/macOS reuse it; Windows' exclusive listener may wait for TIME_WAIT to end.
    when TARGET != "windows":
        s = net.tcp_listen(0, host = host)
        assert(s >= 0)
        p = net.tcp_port(s)
        c = net.tcp_connect("127.0.0.1", p).unwrap()
        a = net.tcp_accept(s, wait = 1.0)
        assert(c >= 0 and a >= 0)
        net.tcp_close(a)
        assert(net.tcp_receive(c, wait = 1.0).len() == 0 and net.tcp_closed(c))
        net.tcp_close(c)
        net.tcp_close(s)
        again = net.tcp_listen(p, host = host)
        assert(again >= 0)
        net.tcp_close(again)
        assert(net.listen(p, host = host))
        net.stop_listening()
print("listeners restart immediately; TIME_WAIT follows the platform's reuse rules")
