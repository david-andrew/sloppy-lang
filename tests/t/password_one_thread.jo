# requires: native
# requires: sloppy
# env: SLOPPY_THREADS=1
# SLOPPY_THREADS=1: no helper thread, the hashes are made on the program's thread (the task that
# asks holds up the others while it hashes), and are the same
import crypto

h = crypto.hash_password("secret", iterations = 2000)
print(crypto.check_password("secret", h), crypto.check_password("nope", h))

# a task that looks while others hash: none of it runs until a hash ends
hashing = 0
seen = false
watch = spawn(():
    loop _ in [0..100000):
        if hashing > 0: seen = true
        if seen: return
        sleep(0.0)
)
checks = [loop i in [0..4): spawn(():
    hashing += 1
    ok = crypto.check_password(if i % 2 == 0: "secret" else: "wrong", h)
    hashing -= 1
    ok
)]
print(wait_all(checks), seen)
watch.wait()

k1 = crypto.pbkdf2_sha256(bytes("password"), bytes("salt"), 4096)
k2 = spawn((): crypto.pbkdf2_sha256(bytes("password"), bytes("salt"), 4096)).wait()
print(crypto.hex_text(k1), k1 == k2)

t = spawn((): crypto.check_password("secret", h))
sleep(0.0)
t.cancel()
print(t.wait())
