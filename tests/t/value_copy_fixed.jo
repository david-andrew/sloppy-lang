# Reverse copies and two loop-carried memory-generation checks.
@noinline
reverse_case = (s: mut Cell, take: bool):
    local: Fixed = Fixed([f32(3), f32(6), f32(9)], [12, 15])
    before = s.v.a[0]
    s.v = local
    after = s.v.a[0]
    if take: local = Fixed([f32(18), f32(21), f32(24)], [27, 30])
    saved = s.v
    total = 0.0
    loop i in 0..3:
        old = s.v
        s.v.a[0] += 1
        now = s.v
        total += f64(now.a[0]) - f64(old.a[0])
    print("reverse", take, before, after, total, local.a[0], local.a[1], local.a[2], local.b[0], local.b[1], saved.a[0], saved.a[1], saved.a[2], saved.b[0], saved.b[1], s.v.a[0], s.v.a[1], s.v.a[2], s.v.b[0], s.v.b[1])
    replacement: Fixed = Fixed([f32(18), f32(21), f32(24)], [27, 30])
    sum = 0.0
    loop i in 0..3:
        sum += f64(s.v.a[0])
        s.v = replacement
    print("bit stores", sum, replacement.a[0], replacement.a[1], replacement.a[2], replacement.b[0], replacement.b[1], s.v.a[0], s.v.a[1], s.v.a[2], s.v.b[0], s.v.b[1])

# Runtime parameters keep both control-flow paths in the non-inlined cases.
loop mode in 0..10:
    loop take in [false, true]:
        s = Cell(Fixed([f32(3), f32(6), f32(9)], [12, 15]))
        param_case(s, mode, take)
        global_case(mode, take)
        local_case(mode, take)
        xs = [Cell(Fixed([f32(18), f32(21), f32(24)], [27, 30])), Cell(Fixed([f32(3), f32(6), f32(9)], [12, 15]))]
        element_case(xs, 1, mode, take)
        o = Outer(Cell(Fixed([f32(3), f32(6), f32(9)], [12, 15])))
        nested_case(o, mode, take)
# Aggregate return snapshots and an argument aliased by a mut argument.
loop take in [false, true]:
    rev = Cell(Fixed([f32(18), f32(21), f32(24)], [27, 30]))
    reverse_case(rev, take)
s_in = Cell(Fixed([f32(3), f32(6), f32(9)], [12, 15]))
r_in = saved_in(s_in)
