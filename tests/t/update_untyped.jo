# requires: native
# requires: sloppy
# update = (dt): with dt untyped: the seconds the game loop gives it (the compiler panicked)
# env: SLOPPY_SCREENSHOT=$TMP/update_untyped.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=3
t = 0.0
update = (dt):
    t += dt
    if frame_number() == 2: print("{t:.4}")
draw = (): clear(BLACK)
