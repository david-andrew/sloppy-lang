# requires: sloppy
# requires: native
# Range guards must preserve the first failing index and its source message.
caught = (f: () -> int) -> str:
    global __catch_jmp
    jb = __alloc(256)
    keep = __catch_jmp
    if __setjmp(jb) == 0:
        __catch_jmp = jb
        f()
        __catch_jmp = keep
        __free(jb)
        return "ok"
    __catch_jmp = keep
    __free(jb)
    __caught

scan = (a: int[], start: int, end: int, s: int, c: int) -> int:
    total = 0
    loop i in [start..end): total += a[i * s + c]
    total

unsigned_scan = (a: int[], start: u64, end: u64, s: int, c: int) -> int:
    total = 0
    loop i in [start..end): total += a[int(i) * s + c]
    total

local_scale = (a: int[], n: int, width: int, c: int) -> int:
    s = width * 3 - 1
    total = 0
    loop i in [0..n): total += a[c + s * i]
    total

strided = (a: int[], start: int, end: int, s: int, c: int) -> int:
    total = 0
    loop i in start, start + 3..end: total += a[i * s + c]
    total

descending = (a: int[], start: int, end: int, s: int, c: int) -> int:
    total = 0
    loop i in start, start - 2..end: total += a[i * s + c]
    total

negative_one = (a: int[], n: int, c: int) -> int:
    s = -1
    total = 0
    loop i in [0..n): total += a[i * s + c]
    total

zero_scale = (a: int[], n: int, c: int) -> int:
    s = 0
    total = 0
    loop i in [0..n): total += a[i * s + c]
    total

unit_offset = (a: int[], start: int, end: int) -> int:
    total = 0
    loop i in [start..end): total += a[i - 1]
    total

# Constant powers of two are strength-reduced to shifts before versioning.
shifted = (a: int[], n: int) -> int:
    total = 0
    loop i in [0..n): total += a[i * 4 + 1]
    total

subtracted = (a: int[], n: int, s: int, c: int) -> int:
    total = 0
    loop i in [0..n): total += a[c - i * s]
    total

matrix = (a: int[], b: int[], c: mut int[], n: int):
    loop i in [0..n):
        loop j in [0..n):
            loop k in [0..n):
                c[i * n + j] += a[i * n + k] * b[k * n + j]

# Replaced/resized arrays are not invariant, even with an affine index.
changed = (a: mut int[], n: int, s: int) -> int:
    total = 0
    loop i in [0..n):
        if i == 1: a = [30]
        total += a[i * s]
    total

resized = (a: mut int[], n: int, s: int) -> int:
    total = 0
    loop i in [0..n):
        if i == 1: a.truncate(1)
        total += a[i * s]
    total

# An unknown step retains the checked loop.
dynamic_step = (a: int[], start: int, next: int, end: int, s: int) -> int:
    total = 0
    loop i in start, next..end: total += a[i * s]
    total

xs = [loop i in [0..24): i + 1]
print(scan(xs, 0, 8, 3, 1), scan(xs, -3, 3, 2, 6))
print(scan(xs, 0, 8, -3, 23), scan(xs, 0, 8, 0, 7))
print(negative_one(xs, 8, 7), zero_scale(xs, 8, 7))
print(local_scale(xs, 8, 1, 2), shifted(xs, 6), subtracted(xs, 8, 3, 23))
print(strided(xs, 1, 12, 2, 0), descending(xs, 11, -1, 2, 0))
print(strided(xs, 0, 8, -2, 20), descending(xs, 11, -1, -2, 22))
print(dynamic_step(xs, 0, 3, 10, 2))
print(scan([], 5, 5, 9223372036854775807, -1), scan([], 6, 1, 3, -1))
print(strided([], 5, 5, 3, -1), descending([], 1, 5, 3, -1))
print(caught((): scan(xs, 0, 9, 3, 1)))
print(caught((): scan(xs, 0, 9, -3, 23)))
print(caught((): scan(xs, 0, 3, 0, -1)))
print(caught((): local_scale(xs, 8, 2, 0)))
print(caught((): negative_one(xs, 9, 7)))
print(caught((): zero_scale(xs, 8, 24)))
print(caught((): strided(xs, 0, 14, 2, 0)))
print(caught((): descending(xs, 11, -3, 2, 0)))
print(unsigned_scan(xs, u64(18446744073709551610), u64(18446744073709551614), 1, 6))
print(caught((): unsigned_scan(xs, u64(0), u64(18446744073709551614), 1, 10)))
# Wrapped endpoints can both be zero while intermediate indexes are invalid.
print(caught((): scan(xs, 0, 3, -9223372036854775807 - 1, 0)))
print(caught((): scan(xs, 0, 5, 1 << 62, 0)))
print(caught((): unit_offset(xs, -9223372036854775807 - 1, -9223372036854775806)))
# Valid wrapped arithmetic is still valid in the fallback, including negative ivs.
print(scan(xs, -9223372036854775807 - 1, -9223372036854775805, 2, 0))
print(caught((): scan(xs, 0, 3, 1, 9223372036854775807)))
print(caught((): scan(xs, 0, 3, 1, -9223372036854775807 - 1)))
a = [1 2 3 4]
b = [5 6 7 8]
c = fill(0, 4)
keep = c
matrix(a, b, c, 2)
print(c, keep)
print(caught(():
    matrix(a, [5 6 7], c, 2)
    0))
print(caught(():
    matrix([1 2 3], b, c, 2)
    0))
print(caught((): changed(xs, 3, 1)))
print(caught((): resized(xs, 3, 1)))
print(xs.len(), xs[0])
