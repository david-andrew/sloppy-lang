# requires: sloppy
# where `?` can stand: an index, a type argument, a chained field and method, a condition, an interpolation
error struct E:
    msg: str

struct Box:
    items: int[]

load = (ok: bool) -> Box | E:
    if ok: return Box([4, 5, 6])
    E("no box")

gen[T] = (x: T) -> T: x

xs = [1, 2, 3]
get = (i: int?) -> int?:
    v = xs[i?]
    w = gen[int?](i)?
    v + w

f = (ok: bool, i: int) -> int | E:
    n = load(ok)?.items[i]
    m = load(ok)?.items.len()
    n + m

g = (o: int?) -> int?:
    k = o?
    # a `?` starting the next line is not this line's
    k + 1

flag = (o: bool?) -> bool?:
    if o?: return true
    false

print(get(1), get(none))
print(f(true, 0), f(false, 0))
print(g(3), g(none))
print(flag(true), flag(false), flag(none))
print("{f(true, 2)} and {gen[int?](none) ?? 7}")
