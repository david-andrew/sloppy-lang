# requires: sloppy
# is: a member of an optional union ((A | B)?), a union of some members (r is AB, also narrowing),
# r is A or r is B narrowing to A | B; globals narrowed at the top level after a panic
struct A:
    x: int
struct B:
    y: int
struct C:
    z: int
type AB = A | B
f = (n: int) -> A | B | none:
    if n == 0: return none
    if n == 1: return A(1)
    B(2)
g = (n: int) -> int | A | B:
    if n == 0: return 5
    if n == 1: return A(3)
    B(4)
struct Holder:
    v: A | B | C
run = ():
    print(f(1) is A, f(2) is A, f(0) is A, f(2) is B)
    e = f(1)
    if e is A: print("A with", e.x)
    loop k in [0..3):
        r = g(k)
        if r is AB: print("AB", r)
        else: print("int", r + 1)
        if r is A or r is B: print("either", r)
    h = Holder(C(9))
    print(h.v is AB, Holder(B(1)).v is AB)
    hb = Holder(B(7))
    if hb.v is AB: print("field narrowed", hb.v)
    o = f(2)
    if o is AB: print("opt is AB", o)
maybe = (k: int) -> str?:
    if k > 0: return "text"
    none
top = maybe(1)
if top == none: panic("none")
whole: str = top
more = top + "!"
print(whole, more, 2 ^ -1, 1 ^ -5, (-1) ^ -3, "{7:>05}|{7:<05}|{-7:05}|{7:*>05}")
run()
