# requires: sloppy (client and server netcode: a server ticking slower than its client, 59 to
# 60 a second, does not let the client's inputs pile up and lag; a client disconnects and
# its state starts again)
import netplay

struct Pad:
    dx = 0
struct World:
    pos: {int: int}

apply = (w: World, player: int, p: Pad, seen: World) -> World:
    let w = w
    if w.pos.has(player): w.pos[player] += p.dx
    w
step = (w: World) -> World: w

srv = netplay.server(World(), apply, step)
c = netplay.client(World(), apply)
srv.join(1)
most = 0
loop f in [0..3600):
    # (the server misses one tick in 60)
    if f % 60 != 59:
        srv.update()
        loop p in srv.joined: srv.world.pos[p] = 0
    c.play(Pad(1))
    loop o in srv.outgoing(): c.receive(o.1)
    loop x in c.outgoing(): srv.receive(1, x)
    if f > 600: most = max(most, srv.waiting(1))
print("connected", c.connected(), "inputs waiting at most", most, most <= 4)
c.disconnect()
print("after disconnect", c.connected(), c.me)
