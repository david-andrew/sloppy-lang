# requires: native
# requires: sloppy
# presses counted and timed within a frame: two taps of a key in one frame are two key_presses
# (key_pressed says only that it was), each with its time; SLOPPY_INPUT's 7.25 comes a quarter
# of the way through frame 7, seen in frame 8; mouse buttons and actions alike. In a screenshot
# run the audio clock is the frames' (1/60 s each from its start), and audio_time_at gives the
# music's time at a press
# env: SLOPPY_SCREENSHOT=$TMP/key_presses.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=12
# env: SLOPPY_INPUT=5:d+ 5:d- 5:d+ 5:d- 7.25:d+ 7.5:f+ 9.5:d- 9.5:mouse_left+ 9.75:mouse_left- 9.8:mouse_left+
action("hit", [.key(.d), .key(.f), .mouse(.left)])
t0 = 0.0
update = (dt: f64):
    global t0
    f = frame_number()
    if f == 2: t0 = audio_time()            # (the clock starts with the sound: here)
    if f == 3: print("frame 3: audio_time {audio_time() * 60.0:.3} frames from its start")
    if key_presses(.d) > 0 or key_released(.d) or mouse_presses(.left) > 0:
        print("frame {f}: d pressed {key_presses(.d)} at {key_press_time(.d) * 60.0:.2} and {key_press_time(.d, 1) * 60.0:.2}; released at {key_release_time(.d) * 60.0:.2}")
        print("  mouse {mouse_presses(.left)} at {mouse_press_time(.left, 0) * 60.0:.2}, {mouse_press_time(.left, 1) * 60.0:.2}; key_pressed {key_pressed(.d)}")
        print("  hit {action_presses("hit")}: {action_press_time("hit") * 60.0:.2}, {action_press_time("hit", 1) * 60.0:.2}")
        if key_presses(.d) > 0: print("  by the music: {audio_time_at(key_press_time(.d)) * 60.0:.2} frames (now {audio_time() * 60.0:.2})")
draw = (): clear(BLACK)
