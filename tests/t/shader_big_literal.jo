# requires: sloppy
# An integer literal above 2147483647 (a hash constant) is written as the uint it is, int(...u),
# not a decimal int literal too large for int, which some GLSL compilers read differently
struct BlV:
    pos: vec2
struct BlU:
    k: f32
struct BlO:
    pos: vec4
    h: f32
bl_hash = (x: int) -> f32:
    h = x * 2376512323
    h = (h xor (h >> 15)) * 2146121005
    f32(h & 16777215) / 16777216.0
bl_vs = (v: BlV, u: BlU) -> BlO: BlO(vec4(v.pos, 0, 1), bl_hash(int(floor(v.pos.x * -300.0))))
bl_fs = (i: BlO, u: BlU) -> vec4: vec4(i.h, bl_hash(-304), 0, 1)
src = shader(bl_vs, bl_fs)
loop text in [src.vs, src.fs]:
    loop l in split(text, "\n"):
        if "2376512323" in l or "2146121005" in l: print(trim(l))
    print("--")
