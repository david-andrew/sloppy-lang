# requires: sloppy
# Sky Barons' Turncoats (examples/skybarons): everyone a holdout but one turncoat; a holdout back
# from being shot down (or bailing out, or on foot) is back a turncoat; no holdout left, the
# turncoats win; the time up, the holdouts. The computer against itself, the same ticks everywhere
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

sides = (g: Game) -> str: "{holdouts_left(g)} holdouts, {g.people.len() - holdouts_left(g)} turncoats"

set_map(FARMLAND, 0)
# (the first turncoat as Rules.zero says)
let g = new_game(fill(-1, 8), 0.65, Rules(mode = TURNCOATS, zero = 5, time_limit = 3, ground_start = false), [])
first: int[]
loop i in 0.. and p in g.people:
    if p.team == TURNED_SIDE: first.push(i)
print("from the air: {not g.rules.ground_start}; first turncoat {first}; {sides(g)}")
turned = 0
last = -1
loop k in 0..60 * 60 * 3 + 30:
    g = tick(g, [])
    loop b in g.booms:
        if b.tick == g.tick and b.kind == TURNED: turned += 1
        if b.tick == g.tick and b.kind == LAST_HOLDOUT: last = b.who
    if g.winner >= 0: break
    if k % 3600 == 0: print("{k / 60} s: {sides(g)}")
print("turned {turned}; last holdout {last}; {if g.winner == HOLDOUTS: "the holdouts" else: if g.winner == TURNED_SIDE: "the turncoats" else: "no one"} won at {g.tick / 60} s; hash {hash(g)}")

# (a player who claimed it starts the turncoat: an extra person, last; the rest all holdouts)
let h = new_game([0, -1, -1, -1, 1], 0.65, Rules(mode = TURNCOATS, ground_start = false), [FIGHTER, SCOUT])
print("claimed: {h.people.len()} people, the last a turncoat {h.people[4].team == TURNED_SIDE}, player {h.people[4].player}; {sides(h)}")
h = tick(h, [Pad(computer = true), Pad(computer = true)])
print("after one tick: the first turncoat in its craft {h.people[4].state == SEATED}, the other player {h.people[0].state == SEATED}")
# (the first turncoat, one against four, starts far over the holdouts: as the sides' numbers say)
loop k in 0..10: h = tick(h, [Pad(computer = true), Pad(computer = true)])
print("the first turncoat {int(h.crafts[h.people[4].craft].pos.y - h.crafts[h.people[0].craft].pos.y)} m over a holdout")
loop k in 0..30: h = tick(h, [Pad(computer = true), Pad(computer = true)])
# (a holdout bailing out: under a parachute still holding out; T, back at base, a turncoat)
p0 = h.people[0]
print("player 0: {if p0.team == HOLDOUTS: "a holdout" else: "a turncoat"}, seated {p0.state == SEATED}")
h.people[0] = bail_out(h, 0, h.people[0])
loop k in 0..15: h = tick(h, [Pad(), Pad(computer = true)])
loop k in 0..2: h = tick(h, [Pad(leave = k == 0), Pad(computer = true)])
p0 = h.people[0]
print("bailed out, T: under a parachute {p0.state == CHUTE}, {if p0.team == HOLDOUTS: "a holdout" else: "a turncoat"}, holding out {holding_out(p0)}; {sides(h)}")
loop k in 0..70: h = tick(h, [Pad(), Pad(computer = true)])
loop k in 0..2: h = tick(h, [Pad(leave = k == 0), Pad(computer = true)])
p0 = h.people[0]
print("T again: {if p0.team == HOLDOUTS: "a holdout" else: "a turncoat"}, seated {p0.state == SEATED}, in its own colors {h.crafts[p0.craft].team == TURNED_SIDE}; {sides(h)}")
# (a holdout on foot on the ground holds out still, as long as it likes; T, back at base, a
# turncoat. The computer's holdout on foot takes a craft standing near, else goes back)
let w = new_game([0, -1, -1, -1], 0.65, Rules(mode = TURNCOATS, zero = 1, ground_start = false), [])
loop k in 0..30: w = tick(w, [Pad(computer = true)])
w.crafts[w.people[0].craft].seats[0] = -1
w.people[0].state = WALK
w.people[0].craft = -1
w.people[0].pos = vec3(0, f32(ground(0.0, 0.0)), 0)
loop k in 0..600: w = tick(w, [Pad()])
print("on foot 10 s: {if w.people[0].team == HOLDOUTS: "a holdout" else: "a turncoat"}, on foot {w.people[0].state == WALK}; {sides(w)}")
loop k in 0..2: w = tick(w, [Pad(leave = k == 0)])
print("T on foot: {if w.people[0].team == HOLDOUTS: "a holdout" else: "a turncoat"}, seated {w.people[0].state == SEATED}")
kill(h, 1, 4)
print("one killed: {sides(h)}, its wait {h.people[1].timer}")
loop k in 0..RESPAWN + 2: h = tick(h, [Pad(computer = true), Pad(computer = true)])
print("back: {if h.people[1].team == HOLDOUTS: "a holdout" else: "a turncoat"}; {sides(h)}")
# (a turncoat coming back with no holdout shot down: in a fury, its craft stronger; one shot down, none)
loop round in 0..4:
    kill(h, 1, -1)
    loop k in 0..TURNCOAT_BACK + 2: h = tick(h, [Pad(computer = true), Pad(computer = true)])
    q = h.people[1]
    c = h.crafts[q.craft]
    print("a turncoat back again: its wait {TURNCOAT_BACK}, fury {q.fury}, its craft's hull {c.health} of its kind's {KINDS[c.kind].health}, a bullet's harm {gun_harm(h, q.craft, c, DAMAGE)} (a holdout's {DAMAGE}), its engine's pull {pull_of(h, q.craft, c):.2} of its kind's")
h.people[1].kills += 1
kill(h, 1, -1)
loop k in 0..TURNCOAT_BACK + 2: h = tick(h, [Pad(computer = true), Pad(computer = true)])
print("and back after shooting one down: fury {h.people[1].fury}")

# (starting on the ground: everyone on foot at their field. A player's first turncoat bailing out
# and pressing T, back at their field on foot, in a fury; the craft they take there the stronger)
let f = new_game([-1, -1, -1, -1, 0], 0.65, Rules(mode = TURNCOATS, ground_start = true), [])
loop k in 0..20: f = tick(f, [Pad()])
walking = 0
loop p in f.people:
    if p.state == WALK: walking += 1
home = (q: Person) -> bool: f64(length(q.pos - fields()[TURNED_SIDE].at)) < STRIP_LONG + 400.0
print("on the ground: {walking} of {f.people.len()} on foot, the turncoat at its field {home(f.people[4])}")
# (a craft of its side standing at its field, the nth free one)
free_at = (g: Game, nth: int) -> int:
    n = 0
    loop j in 0.. and c in g.crafts:
        if c.team == TURNED_SIDE and c.landed and c.home >= 0 and c.kind == FIGHTER and not manned(c):
            if n == nth: return j
            n += 1
    -1
sit = (g: mut Game, i: int, k: int):
    g.crafts[k].seats[0] = i
    g.people[i].state = SEATED
    g.people[i].craft = k
    g.people[i].seat = 0
k1 = free_at(f, 0)
sit(f, 4, k1)
f.people[4] = bail_out(f, 4, f.people[4])
f.people[4].pos.y += 300.0
loop k in 0..15: f = tick(f, [Pad()])
loop k in 0..2: f = tick(f, [Pad(leave = k == 0)])
loop k in 0..70: f = tick(f, [Pad()])
loop k in 0..2: f = tick(f, [Pad(leave = k == 0)])
loop k in 0..RESPAWN: f = tick(f, [Pad()])
q = f.people[4]
print("bailed out, T, T: on foot {q.state == WALK and q.craft < 0}, at its field {home(q)}, fury {q.fury}")
k2 = free_at(f, 0)
sit(f, 4, k2)
f = tick(f, [Pad()])
c2 = f.crafts[k2]
print("in a craft at its field: its fury {c2.fury}, its hull {c2.health} of its kind's {KINDS[c2.kind].health}")

# (the lobby's seat for the first turncoat left empty (the seats one more than the people): every
# stand on both fields filled again once its craft's wreck is cleared)
let e = new_game(fill(-1, 17), 0.65, Rules(mode = TURNCOATS, zero = 2, ground_start = true, crafts = 1 << FIGHTER), [])
stands_n = 0
loop j in 0..e.crafts.len():
    if e.crafts[j].home >= 0:
        e.crafts[j].gone = 1
        stands_n += 1
e = tick(e, [])
whole_n = 0
loop c in e.crafts:
    if c.home >= 0 and c.gone == 0 and not c.free: whole_n += 1
print("an empty first turncoat's seat: {e.people.len()} people, {stands_n} stands, {whole_n} filled again")

# (a turncoat's guns: three bullets a shot, the rest nudged about the first, going twice as far,
# hitting what they pass the wider; a holdout's one)
let v = new_game([0, 1], 0.65, Rules(mode = TURNCOATS, zero = 0, ground_start = false), [FIGHTER, FIGHTER])
loop k in 0..40: v = tick(v, [Pad(), Pad()])
loop who in 0..2:
    n0 = v.bullets.len()
    v = tick(v, if who == 0: [Pad(fire = true), Pad()] else: [Pad(), Pad(fire = true)])
    fresh = v.bullets[n0..]
    spread = 0.0
    loop b in fresh: spread = max(spread, f64(1.0 - dot(normalize(b.vel - fresh[0].vel + fresh[0].vel), normalize(fresh[0].vel))))
    print("{if v.people[who].team == TURNED_SIDE: "a turncoat" else: "a holdout"} fires: {fresh.len()} bullets, going {fresh[0].life + 1} ticks, {fresh[0].wide} m wide, nudged {spread > 0.0}")
    loop k in 0..10: v = tick(v, [Pad(), Pad()])
