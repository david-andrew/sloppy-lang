# requires: sloppy
# a fixed-size array made from a comprehension (a table worked out), numbers and strings
struct C:
    pop: u8[256]
    names: str[3]
pc = (x: int) -> u8:
    n = 0
    v = x
    loop v > 0:
        n += v & 1
        v >>= 1
    u8(n)
c = C([loop i in 0..256: pc(i)], [loop i in 0..3: "n{i}"])
print(c.pop[255], c.pop[7], c.names)
d = c
d.names[0] = "x"
print(c.names, d.names)
