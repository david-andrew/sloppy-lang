# requires: sloppy
# (a function the compiler makes, as sqrt, given where a function is wanted)
one = (f: (f64) -> f64) -> f64: f(16.0)
print(one(sqrt), one(abs), one(floor))
xs = [4.0, 9.0]
print(xs.map(sqrt), sqrt.(xs))
h: (f32) -> f32 = sqrt
print(h(25))
c: u8 = 43
print(c in ['+', '-'], c in ["*", "/"])
