# requires: sloppy
# the built-in font has accented letters and common punctuation (not shown as ?)
print(text_width("é") == text_width("e"))
print(text_width("Ñ") == text_width("N"))
print(text_width("€") != text_width("?"))
print(text_width("—") > text_width("-"))
print(text_width("“hi”") > text_width("hi"))
