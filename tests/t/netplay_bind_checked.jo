# requires: sloppy
# requires: native
import net
import netplay
step = (w: int) -> int: w
srv = netplay.server(0, (w: int, p: int, i: int, prior: int) -> int: w, step)
# New status fields must not shift the old positional constructor's version argument.
positional: netplay.Server[int, int] = netplay.Server(0, (w: int, p: int, i: int, prior: int) -> int: w, step, 0, "keep-version")
assert(positional.version == "keep-version" and positional.problem == "")
# macOS permits wildcard/specific overlaps; exact-address conflicts fail on every platform.
loop host in ["127.0.0.1", ""]:
    held = net.tcp_listen(0, host = host)
    assert(held >= 0)
    p = net.tcp_port(held)
    loop other in ["127.0.0.1", ""]:
        if TARGET != "macos" or host == other:
            assert(net.tcp_listen(p, host = other) < 0)
            assert(not net.listen(p, host = other))
    net.tcp_close(held)
# Netplay listens on every interface, so hold that exact address too.
held = net.tcp_listen(0)
assert(held >= 0)
p = net.tcp_port(held)
r = srv.listen(p)
print(r is net.NetError, len(srv.problem) > 0)
assert(r is net.NetError)
r = netplay.relay(p)
print(r is net.NetError)
# If a bind regression let the relay start, fail here instead of serving forever below.
assert(r is net.NetError)
r = netplay.relay_forever(p)
print(r is net.NetError)
net.tcp_close(held)
srv.listen(0).unwrap()
print(srv.problem == "")
net.stop_listening()
s = netplay.session(0, (w: int, ins: int[]) -> int: w, players = 1, me = 0)
u = net.udp(0)
assert(u >= 0)
r = s.udp(net.udp_port(u), [])
print(r is net.NetError, len(s.problem) > 0)
net.udp_close(u)
s.udp(0, []).unwrap()
print(s.problem == "")
