# requires: sloppy
# Sky Barons: a craft flown by a carrier's airman, with no one at its gun seats, fires them by
# itself at an enemy in range ahead; and one with no enemy near does not
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)

# (a light bomber of side 0 flown by its airman, level at 900 m heading -z, no one in any seat;
# an enemy scout of side 1 `gap` m ahead, standing in the air, flown by its own airman)
fired = (gap: f64) -> bool:
    let g = new_game(fill(-1, 2), 0.65, Rules(mode = DOGFIGHT), [])
    g.people = []
    g.crafts = []
    at = vec3(4000, 900, 0)
    b = flying_craft(BOMBER, 0, at, vec3(0, 0, -1))
    b.vel = vec3(0, 0, 0)
    b.airman = true
    g.crafts.push(b)
    if gap > 0.0:
        e = flying_craft(SCOUT, 1, at + vec3(0, 0, f32(-gap)), vec3(0, 0, -1))
        e.vel = vec3(0, 0, 0)
        e.airman = true
        g.crafts.push(e)
    shot = false
    loop k in 0..180:
        g = tick(g, [])
        loop bl in g.bullets:
            if bl.craft == 0: shot = true
    shot

print("enemy 300 m ahead: its empty seats fire {fired(300.0)}")
print("no enemy: they fire {fired(0.0)}")
