# requires: sloppy
struct Item:
    key: int
    serial: int

main = ():
    xs: Item[]
    loop i in [0..100): xs.push(Item((i * 37) % 7, i))
    original = xs
    calls = 0
    xs.sort((x):
        calls += 1
        x.key)
    assert(calls == 100)
    loop i in [1..xs.len()):
        assert(xs[i - 1].key <= xs[i].key)
        if xs[i - 1].key == xs[i].key: assert(xs[i - 1].serial < xs[i].serial)
    xs = original
    xs.sort((x): x.key, descending = true)
    loop i in [1..xs.len()):
        assert(xs[i - 1].key >= xs[i].key)
        if xs[i - 1].key == xs[i].key: assert(xs[i - 1].serial < xs[i].serial)
    assert(original[0].serial == 0 and original[99].serial == 99)
    # No key calls on an empty or single-element array.
    empty: int[]
    single = [42]
    empty.sort((x):
        calls += 1
        x)
    single.sort((x):
        calls += 1
        x)
    assert(calls == 100 and single == [42])
    # Managed keys and captured read-only values keep their ordinary ownership.
    names = ["bb", "a", "cc", "ddd"]
    prefix = "!"
    names.sort((s): prefix + s)
    assert(names == ["a", "bb", "cc", "ddd"])
    print("keyed sort ok")
