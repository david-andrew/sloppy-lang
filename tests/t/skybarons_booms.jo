# requires: sloppy
# Sky Barons: every kind of event (Boom.kind) has a number of its own: two sharing one showed the
# castle batteries' firing as a craft passing too fast through a carrier's window
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

kinds = [("GOLD_OUT", GOLD_OUT), ("SWAPPED", SWAPPED), ("ABOARD", ABOARD), ("SCORCHED", SCORCHED), ("CALLED", CALLED), ("JOINED", JOINED),
         ("BAG_BURST", BAG_BURST), ("LOOSED", LOOSED), ("HOOKED", HOOKED), ("PASSED", PASSED), ("BROADSIDE_FIRED", BROADSIDE_FIRED),
         ("BOMBARD_FIRED", BOMBARD_FIRED), ("BOMBARD_HIT", BOMBARD_HIT), ("GROUNDED", GROUNDED), ("SNAPPED", SNAPPED), ("KILLED", KILLED),
         ("BURST", BURST), ("STRUCK", STRUCK), ("CAUGHT", CAUGHT), ("GOAL", GOAL), ("BALL_BACK", BALL_BACK), ("HEALED", HEALED), ("GOLD_WON", GOLD_WON)]
clash = 0
loop i in 0.. and a in kinds:
    loop j in i + 1..kinds.len():
        if a.1 == kinds[j].1:
            clash += 1
            print("{a.0} and {kinds[j].0} are both {a.1}")
print("{kinds.len()} event kinds, {clash} sharing a number")
