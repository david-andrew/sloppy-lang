# requires: sloppy
# requires: native
# helpers for scripts: sha256, abs_path, glob without hidden names, a CSV byte order mark,
# if let in a comprehension, a lone brace, an untyped parameter's type from its default
print(sha256("abc"))
print(sha256(""))
print(sha256("a" * 1000))
print(sha256(bytes("hello")) == sha256("hello"))
slash = (p: str) -> str: replace(p, "\\", "/")
print(slash(abs_path("/a/b/../c/./d")), slash(abs_path("/x/..")), slash(abs_path("rel/x")) == slash(join_path(cwd(), "rel/x")))
d = join_path(temp_dir(), "sloppy_glob_test")
make_dirs(join_path(d, "sub/.git"))
make_dirs(join_path(d, ".hidden"))
loop f in ["a.jo", ".env", "sub/b.jo", "sub/.git/c.jo", ".hidden/d.jo", "sub/.e.jo"]: write_file(join_path(d, f), "")
show = (xs: str[]) -> str[]: [loop x in xs: x[len(d) + 1..]]
print(show(glob("{d}/*")), show(glob("{d}/**/*.jo")), show(glob("{d}/.*")), show(glob("{d}/**/.e.jo")))
loop f in walk_dir(d): delete_file(join_path(d, f))
print(csv_rows("\xef\xbb\xbfid,name\n1,x\n")[0])
rows = [["1"], ["x"], ["2.5"]]
print([loop r in rows: if let n = to_float(r[0]): n * 2.0], {loop r in rows: if let n = to_int(r[0]): r[0]: n})
c: u8 = '{'
print(c, "{", "a{{b}}")
f = (a: int, loud = false, tag = "", k = 2) -> str:
    if loud: return "{tag}{a * k}!"
    "{tag}{a}"
print(f(1), f(2, true), f(3, tag = "n=", loud = true), f(4, k = 0.5))
