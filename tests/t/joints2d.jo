# requires: sloppy (2D physics)
# weld, slider and wheel joints
import physics

near = (a: f64, b: f64, tol: f64) -> bool: abs(a - b) <= tol

w = physics.World()
floor = w.add_box(vec2(2000, 700), vec2(4000, 40), kind = .fixed)

# two welded boxes fall, land on a corner and tumble as one: their distance and angle stay
a = w.add_box(vec2(200, 300), vec2(40, 40))
b = w.add_box(vec2(240, 300), vec2(40, 40))
w.weld(a, b, vec2(220, 300))
w.set_velocity(a, vec2(50, 0))
w.set_spin(a, 3.0)
worst = 0.0
worst_turn = 0.0
loop _ in [0..300):
    w.step(1.0 / 60.0)
    worst = max(worst, abs(f64(length(w.pos(b) - w.pos(a))) - 40.0))
    worst_turn = max(worst_turn, abs(f64(w.angle(b) - w.angle(a))))
print("welded boxes stay one:", worst < 1.0, worst_turn < 0.02, "came to rest:", length(w.velocity(a)) < 5.0)

# a slider along x through a fixed post: gravity cannot pull it down, a motor drives it, a limit stops it
cart = w.add_box(vec2(600, 200), vec2(60, 20))
rail = w.slider(physics.ground, cart, vec2(600, 200), vec2(1, 0), lower = -50, upper = 150, motor_speed = 100, max_force = 1e6)
loop _ in [0..60): w.step(1.0 / 60.0)
p = w.pos(cart)
print("slider holds its line:", near(f64(p.y), 200, 0.5), abs(w.angle(cart)) < 0.01, "moved by the motor:", near(f64(p.x), 700, 3.0), near(w.joint_translation(rail), 100, 3.0))
loop _ in [0..120): w.step(1.0 / 60.0)
print("stopped at its limit:", near(w.joint_translation(rail), 150, 1.0))
w.set_motor(rail, -300, 1e6)
loop _ in [0..120): w.step(1.0 / 60.0)
print("and at the other:", near(w.joint_translation(rail), -50, 1.0))

# a car: a body on two sprung wheels with motors drives along the floor
body = w.add_box(vec2(1000, 600), vec2(120, 20))
wa = w.add_circle(vec2(960, 640), 20, friction = 1.0)
wb = w.add_circle(vec2(1040, 640), 20, friction = 1.0)
ja = w.wheel(body, wa, vec2(960, 640), motor_speed = 10, max_torque = 1e7)
jb = w.wheel(body, wb, vec2(1040, 640), motor_speed = 10, max_torque = 1e7)
start = w.pos(body).x
loop _ in [0..120): w.step(1.0 / 60.0)
q = w.pos(body)
print("car drives:", q.x - start > 200.0, "upright:", abs(w.angle(body)) < 0.1, "wheels under it:", near(f64(w.pos(wa).x - q.x), -40, 2.0), near(f64(w.pos(wb).x - q.x), 40, 2.0))
print("suspension sags under the weight:", w.joint_translation(ja) < 0.0, w.joint_translation(ja) > -20.0)
