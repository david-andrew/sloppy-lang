# requires: native
# requires: sloppy
# env: SLOPPY_NO_DRAW=1
# env: SLOPPY_FRAMES=3
# No-draw alone keeps the ordinary real-time clock and software frame pacing.
updates = 0
update = (dt: f64):
    global updates
    assert(not __fixed_step)
    assert(dt >= 0.0 and dt <= 0.1)
    updates += 1
draw = (): panic("no-draw called draw")
on_quit = (): print("real-time updates {updates}")
