# requires: sloppy
# if let and loop let on a variant and conditions on arms, in generic functions, lambdas and
# with narrowing (a condition narrows what it tests; a field path matched narrows too)
enum Tree[T]:
    leaf
    node(v: T, l: Tree[T], r: Tree[T])

insert[T] = (t: Tree[T], x: T) -> Tree[T]:
    match t:
        .node(v, l, r) if x < v: Tree.node(v, insert(l, x), r)
        .node(v, l, r): Tree.node(v, l, insert(r, x))
        .leaf: Tree.node(x, Tree[T].leaf, Tree[T].leaf)

items[T] = (t: Tree[T], out: mut T[]):
    if let .node(v, l, r) = t:
        items(l, out)
        out.push(v)
        items(r, out)

smallest[T] = (t: Tree[T]) -> T?:
    cur = t
    best: T? = none
    loop let .node(v, l, _) = cur:
        best = v
        cur = l
    best

t = Tree[int].leaf
loop x in [5, 2, 8, 1, 9, 3]: t = insert(t, x)
xs: int[]
items(t, xs)
print(xs, smallest(t), t is .node)
ws = Tree[str].leaf
loop w in ["pear", "apple", "fig"]: ws = insert(ws, w)
names: str[]
items(ws, names)
print(names, smallest(ws))

# a lambda: the condition and the arm see what it captures
limit = 4
pick = (t: Tree[int]) -> str:
    match t:
        .node(v, _, _) if v > limit: "big {v}"
        .node(v, _, _): "small {v}"
        _: "leaf"
f = (n: int) -> str: pick(Tree.node(n, Tree[int].leaf, Tree[int].leaf))
g = (n: int) -> str:
    match n:
        _ if n > limit: "over"
        _: "under"
print(f(3), f(7), g(3), g(9))

# a condition narrows the names it tests
enum Cell:
    val(x: int | str)
    empty
show = (c: Cell) -> str:
    match c:
        .val(x) if x is int: "the number {x + 1}"
        .val(x) if x is str and x.len() > 2: "long text {x.upper()}"
        .val(x): "{x}"
        .empty: "-"
print(show(Cell.val(4)), show(Cell.val("hello")), show(Cell.val("hi")), show(Cell.empty))

# a field path in a match narrows in the condition and the arm
struct Box: item: int | str
b = Box("crate")
match b.item:
    str if b.item.len() > 3: print("long", b.item.upper())
    _: print("other")

# match statement that returns from every arm
first_word = (c: Cell) -> str:
    match c:
        .val(x) if x is str: return x
        _: return "?"
print(first_word(Cell.val("w")), first_word(Cell.empty))

# if let on a function's result and on a boxed field
root = (t: Tree[int]) -> Tree[int]: t
if let .node(v, l, r) = root(t):
    if let .node(lv, _, _) = l: print("root", v, "left", lv)
    print(l is .node, r is .leaf, root(t) is .node)
