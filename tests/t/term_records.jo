# requires: sloppy
# lib/term.jo: a Windows console's input records (keys, the mouse) made into the same events as a
# terminal's bytes (fed here as bytes, on any system)
import term

# KEY_EVENT_RECORD: down, repeat, virtual key, scan code, the character (UTF-16), the modifiers
key = (vk: int, ch: int, mods: int = 0, down: bool = true, repeat: int = 1):
    r = fill(u8(0), 20)
    p = data(r)
    (p as *u16)[0] = 1
    ((p + 4) as *i32)[0] = if down: 1 else: 0
    ((p + 8) as *u16)[0] = u16(repeat)
    ((p + 10) as *u16)[0] = u16(vk)
    ((p + 14) as *u16)[0] = u16(ch)
    ((p + 16) as *u32)[0] = u32(mods)
    term.__t_w32_record(p)

# MOUSE_EVENT_RECORD: where, the buttons held, the modifiers, what kind (1 moved, 4 the wheel)
mouse = (x: int, y: int, buttons: int, flags: int = 0, mods: int = 0):
    r = fill(u8(0), 20)
    p = data(r)
    (p as *u16)[0] = 2
    ((p + 4) as *i16)[0] = i16(x)
    ((p + 6) as *i16)[0] = i16(y)
    ((p + 8) as *u32)[0] = u32(buttons)
    ((p + 12) as *u32)[0] = u32(mods)
    ((p + 16) as *u32)[0] = u32(flags)
    term.__t_w32_record(p)

const SHIFT = 0x10
const CTRL = 0x8
const ALT = 0x2
const RIGHT_ALT = 0x1

key(0x41, c'a')
key(0x41, c'A', SHIFT)
key(0x41, c'a', down = false)                       # (let go: nothing)
key(0x41, 1, CTRL)                                  # ctrl+a
key(0x43, 3, CTRL)                                  # ctrl+c, with ctrl-c a key
key(0x58, c'x', ALT)
key(0x45, 0x20AC, CTRL | RIGHT_ALT)                 # AltGr+e: €
key(0x31, c'1', CTRL)
key(0x20, c' ', CTRL)
key(0x10, 0, SHIFT)                                 # (shift alone: nothing)
key(0x0D, 13)
key(0x0D, 13, ALT)
key(0x09, 9, SHIFT)
key(0x08, 8)
key(0x1B, 27)
key(0x26, 0)
key(0x25, 0, CTRL)
key(0x27, 0, SHIFT | CTRL)
key(0x24, 0)
key(0x23, 0)
key(0x21, 0)
key(0x22, 0)
key(0x2D, 0)
key(0x2E, 0)
key(0x70, 0)
key(0x7B, 0, ALT)
key(0x28, 0, repeat = 3)
key(0, 0xD83D)                                      # 😀: two halves
key(0, 0xDE00)
key(0x12, 0xE9, down = false)                       # alt and the number pad: é, as alt is let go
key(0x55, 0x65E5)                                   # 日
mouse(10, 5, 1)
mouse(11, 5, 1, flags = 1)
mouse(11, 5, 0)
mouse(3, 4, 2)
mouse(3, 4, 0)
mouse(3, 4, 4, mods = CTRL)
mouse(3, 4, 0)
mouse(7, 8, 0, flags = 1)
mouse(7, 8, 120 << 16, flags = 4)
mouse(7, 8, 0xFF88 << 16, flags = 4)
mouse(7, 8, 120 << 16, flags = 8)
loop e in term.__t_events: print(e, e.ctrl, e.alt, e.shift)
