# requires: sloppy
# Sky Barons: a player takes a seat one of the computer's of their side has, in The Boss: from
# another seat of the castle by its number (the helm, a gun), standing on its deck by the seat's
# number (the map) and by F beside it; and from a gun seat of the attackers' bomber to its pilot's
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)
who = (g: Game, i: int) -> str:
    p = g.people[i]
    if p.state == SEATED: return "seated, {KIND_NAMES[g.crafts[p.craft].kind]} seat {p.seat}"
    "on foot, state {p.state}"

# (the defenders' side, person 1 a player; the castle's seats filled by the computer's)
pilots = fill(-1, 6)
pilots[1] = 0
let g = new_game(pilots, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..120: g = tick(g, [Pad()])
ci = g.people[1].craft
print("the player: {who(g, 1)}")

# (from another seat by its number: the helm, held by the computer's)
loop s in 0..g.crafts[ci].seats.len():
    o = g.crafts[ci].seats[s]
    if o < 0 or o == 1: continue
    let h = g
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..3: h = tick(h, [Pad()])
    print("by number, seat {s} of the castle, held by the computer's: {if h.crafts[ci].seats[s] == 1: "taken" else: "NOT taken"}")

# (standing on the castle's deck, no seat: by the number, and by F beside the seat)
os = g.people[1].seat
g.crafts[ci].seats[os] = -1
g.people[1].state = WALK
g.people[1].deck = vec3(0, 41.0, 20)
g.people[1].pos = point_of(g.crafts[ci], g.people[1].deck)
loop t in 0..10: g = tick(g, [Pad()])
loop s in 0..g.crafts[ci].seats.len():
    o = g.crafts[ci].seats[s]
    if o < 0: continue
    let h = g
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..(CALL_FADE + 30): h = tick(h, [Pad()])
    print("on the deck, by number, seat {s} held by the computer's: {if h.crafts[ci].seats[s] == 1: "taken" else: "NOT taken"}")
    let f = g
    at = KINDS[CASTLE].seats[s].at
    f.people[1].deck = vec3(at.x, at.y - 1.0, at.z)
    f.people[1].pos = point_of(f.crafts[ci], f.people[1].deck)
    f = tick(f, [Pad()])
    f = tick(f, [Pad(enter = true)])
    loop t in 0..(CALL_FADE + 30): f = tick(f, [Pad()])
    print("on the deck, F beside seat {s} held by the computer's: {if f.crafts[ci].seats[s] == 1: "taken" else: "NOT taken"}")

# (an attacker, in a gun seat of the attackers' bomber, the pilot's seat the computer's)
let a = new_game([0, -1, -1, -1, -1, -1], 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..30: a = tick(a, [Pad()])
bk = a.people[2].craft
a.crafts[a.people[0].craft].seats[a.people[0].seat] = -1
a.crafts[bk].seats[1] = 0
a.people[0].craft = bk
a.people[0].seat = 1
a = tick(a, [Pad(seat = 1)])
loop t in 0..3: a = tick(a, [Pad()])
print("the attackers' {KIND_NAMES[a.crafts[bk].kind]}, pilot's seat: {if a.crafts[bk].seats[0] == 0: "taken" else: "NOT taken"}")
