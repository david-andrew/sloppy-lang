# requires: sloppy
# Sky Barons: a player takes a seat one of the computer's of their side has, in The Boss: from
# another seat of the castle by its number (the helm, a gun), standing on its deck by the seat's
# number (the map); and from a gun seat of the attackers' bomber to its pilot's
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)
who = (g: Game, i: int) -> str:
    p = g.people[i]
    if p.state == SEATED: return "seated, {KIND_NAMES[g.crafts[p.craft].kind]} seat {p.seat}"
    "on foot, state {p.state}"

# (the defenders' side, person 1 a player; the castle's seats filled by the computer's)
pilots = fill(-1, 6)
pilots[1] = 0
let g = new_game(pilots, 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..120: g = tick(g, [Pad()])
ci = g.people[1].craft
print("the player: {who(g, 1)}")

# (from another seat by its number: the helm, held by the computer's)
loop s in 0..g.crafts[ci].seats.len():
    o = g.crafts[ci].seats[s]
    if o < 0 or o == 1: continue
    let h = g
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..3: h = tick(h, [Pad()])
    print("by number, seat {s} of the castle, held by the computer's: {if h.crafts[ci].seats[s] == 1: "taken" else: "NOT taken"}")

# (standing on the castle's deck, no seat: by the number)
os = g.people[1].seat
g.crafts[ci].seats[os] = -1
g.people[1].state = WALK
g.people[1].deck = vec3(0, 41.0, 20)
g.people[1].pos = point_of(g.crafts[ci], g.people[1].deck)
loop t in 0..10: g = tick(g, [Pad()])
loop s in 0..g.crafts[ci].seats.len():
    o = g.crafts[ci].seats[s]
    if o < 0: continue
    let h = g
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..(CALL_FADE + 30): h = tick(h, [Pad()])
    print("on the deck, by number, seat {s} held by the computer's: {if h.crafts[ci].seats[s] == 1: "taken" else: "NOT taken"}")

# (an attacker, in a gun seat of the attackers' bomber, the pilot's seat the computer's)
let a = new_game([0, -1, -1, -1, -1, -1], 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..30: a = tick(a, [Pad()])
bk = a.people[2].craft
a.crafts[a.people[0].craft].seats[a.people[0].seat] = -1
a.crafts[bk].seats[1] = 0
a.people[0].craft = bk
a.people[0].seat = 1
a = tick(a, [Pad(seat = 1)])
loop t in 0..3: a = tick(a, [Pad()])
print("the attackers' {KIND_NAMES[a.crafts[bk].kind]}, pilot's seat: {if a.crafts[bk].seats[0] == 0: "taken" else: "NOT taken"}")

# (the defender on the castle's deck: every empty seat, by number and by F beside it)
let e = g
tried = 0
by_number = 0
by_f = 0
loop s in 0..e.crafts[ci].seats.len():
    if e.crafts[ci].seats[s] != -1: continue
    tried += 1
    let h = e
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..(CALL_FADE + 30): h = tick(h, [Pad()])
    if h.crafts[ci].seats[s] == 1: by_number += 1
    let f = e
    at = KINDS[CASTLE].seats[s].at
    f.people[1].deck = vec3(at.x, at.y - 1.0, at.z)
    f.people[1].pos = point_of(f.crafts[ci], f.people[1].deck)
    f = tick(f, [Pad()])
    f = tick(f, [Pad(enter = true)])
    loop t in 0..(CALL_FADE + 30): f = tick(f, [Pad()])
    if f.crafts[ci].seats[s] == 1: by_f += 1
print("the defender, empty seats of the castle: {tried}, taken by number {by_number}, by F {by_f}")

# (an attacker on the defenders' castle: its seats are not theirs to man, by the rules of the fight)
let b = new_game([0, -1, -1, -1, -1, -1], 0.65, Rules(mode = BOSS, attackers = 0, defenders = 3), [])
loop t in 0..30: b = tick(b, [Pad()])
bc = boss_castle(b)
q = b.people[0]
b.crafts[q.craft].seats[q.seat] = -1
q.state = WALK
q.craft = bc
q.deck = vec3(0, 41.0, 20)
q.pos = point_of(b.crafts[bc], q.deck)
b.people[0] = q
loop t in 0..10: b = tick(b, [Pad()])
print("the attacker on the castle: shut to them {boss_shut(b, bc, b.people[0].team)}")
free = 0
loop s in 0..b.crafts[bc].seats.len():
    if b.crafts[bc].seats[s] != -1: continue
    let h = b
    h = tick(h, [Pad(seat = s + 1)])
    loop t in 0..(CALL_FADE + 30): h = tick(h, [Pad()])
    if h.crafts[bc].seats[s] == 0: free += 1
print("the attacker on the castle, empty seats taken: {free}")

# (never an enemy's seat: the attacker may not take one of the defenders' computer gunners' either, shut or not)
enemy = b.crafts[bc].seats[1]
print("the attacker may take the enemy gunner's seat: {can_take(b, 0, enemy, bc)}")
let bf = b
at = KINDS[CASTLE].seats[1].at
bf.people[0].deck = vec3(at.x, at.y - 1.0, at.z)
bf.people[0].pos = point_of(bf.crafts[bc], bf.people[0].deck)
bf = tick(bf, [Pad()])
bf = tick(bf, [Pad(enter = true)])
loop t in 0..(CALL_FADE + 30): bf = tick(bf, [Pad()])
print("F beside it: the seat is still the enemy gunner's {bf.crafts[bc].seats[1] == enemy}")
