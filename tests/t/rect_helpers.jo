# requires: sloppy
# Rect's edges, moved, grown, kept inside another, the union of two, the first it overlaps
r = Rect(10, 20, 30, 40)
print(r.right(), r.bottom(), center(r))
print(r.move(vec2(5, -5)))
print(r.grow(2), r.grow(-20))
print(r.clamp(Rect(0, 0, 35, 100)), r.clamp(Rect(50, 50, 100, 100)))
print(Rect(0, 0, 50, 10).clamp(Rect(0, 0, 30, 30)))
print(union(r, Rect(0, 0, 5, 5)), union(r, r))
walls = [Rect(100, 100, 10, 10), Rect(15, 25, 5, 5), Rect(0, 0, 100, 100)]
print(r.first_overlap(walls), Rect(500, 500, 1, 1).first_overlap(walls), r.first_overlap([]))
# (the numbers' clamp, beside Rect's)
print(clamp(5, 0, 3), clamp(2.5, 0.0, 1.0))
