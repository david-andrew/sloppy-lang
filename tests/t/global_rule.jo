# requires: sloppy
# In a function, `x = v` makes x its own unless `global x`; `x += 1`, `x.f = v` and `xs[i] = v`
# change the global without it; a lambda in top-level code changes the globals around it
struct P:
    x = 0
count = 10
best = 0
p = P()
grid = [0, 0, 0]
on_click: () -> void = (): pass

helper = (xs: int[]) -> int:
    best = 0                    # its own: the global best stays 0
    count = 0
    loop x in xs:
        count += 1
        if x > best: best = x
    best * 100 + count

start = ():
    global count
    count = 1

bump = ():
    count += 5
    p.x = 7
    grid[1] = 9

print(helper([3, 9, 4]), best, count)
start()
bump()
print(count, p.x, grid)
on_click = (): best = 42        # (top-level code: changes the global)
on_click()
print(best)
nested = ():
    global best
    f = (): best = 77           # (a lambda in a function: as the function does)
    f()
nested()
print(best)
