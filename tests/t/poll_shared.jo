# requires: sloppy
# requires: unix
# Multiple task waiters can ask for the same descriptor. Darwin's kqueue-backed poll
# only reports the last registration unless the platform adapter merges and fans out.
fds = [0]
assert(syscall(293, data(fds), 0x80800) == 0)
r = fds[0] & 0xFFFFFFFF
w = fds[0] >> 32
one = [1]
assert(syscall(1, w, data(one), 1) == 1)
p = [r | (1 << 32), r | (1 << 32), w | (4 << 32), r | (4 << 32), 0xFFFFFFFF | (1 << 32)]
print(syscall(7, data(p), p.len(), 0))
print([loop fd in p: (fd >> 48) & 0xFFFF])
buf = [0]
assert(syscall(0, r, data(buf), 1) == 1)
print(syscall(7, data(p), 2, 0), (p[0] >> 48) & 0xFFFF, (p[1] >> 48) & 0xFFFF)
syscall(3, r)
syscall(3, w)
