# requires: native
# known: macos hangs in CI (the helper threads' wake does not reach the waiting task), to look into
# requires: sloppy
# where tasks run, password hashes are made on helper threads: the task that asks waits, and the
# others take their turns meanwhile (a server's other requests); without tasks, as before
import crypto

h = crypto.hash_password("secret", iterations = 20000)
print(crypto.check_password("secret", h), crypto.check_password("nope", h))
# (RFC 7914's test vector for PBKDF2-HMAC-SHA256)
print(crypto.hex_text(crypto.pbkdf2_sha256(bytes("passwd"), bytes("salt"), 1, 64)))

# a task that looks while another waits for its hash: it sees it waiting (a hash made on the
# program's thread would let no other run until it ended)
hashing = 0
seen = false
watch = spawn(():
    loop _ in [0..100000):
        if hashing > 0: seen = true
        if seen: return
        sleep(0.0)
)
checks = [loop i in [0..6): spawn(():
    hashing += 1
    ok = crypto.check_password(if i % 3 == 0: "secret" else: "wrong", h)
    hashing -= 1
    ok
)]
print(wait_all(checks), seen)
watch.wait()

# the key, as made on the program's thread
k1 = crypto.pbkdf2_sha256(bytes("password"), bytes("salt"), 4096)
k2 = spawn((): crypto.pbkdf2_sha256(bytes("password"), bytes("salt"), 4096)).wait()
print(crypto.hex_text(k1), k1 == k2)
# (empty password and salt, and a key longer than a block)
print(crypto.hex_text(spawn((): crypto.pbkdf2_sha256([], [], 2000, 40)).wait()) == crypto.hex_text(crypto.__pbkdf2([], [], 2000, 40)))

# a task cancelled while it waits for its hash: the hash still ends, and is right
t = spawn((): crypto.check_password("secret", h))
sleep(0.0)
t.cancel()
print(t.wait())
