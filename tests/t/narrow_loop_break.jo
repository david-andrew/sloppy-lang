# requires: sloppy
# a narrowed variable given another type in a loop that then ends: fine
struct A: v: int
struct B: s: str
main = ():
    x: A | B = A(1)
    if x is A:
        loop i in [0..3):
            print(x.v)
            if i == 1:
                x = B("b")
                break
    print(x)
    y: A | B = A(2)
    if y is A:
        print(y.v)
        loop i in [0..2):
            y = B("c")
        print(y)
    z: int? = 5
    if z != none:
        loop i in [0..3):
            print(z + 1)
            if i == 1:
                z = none
                return
