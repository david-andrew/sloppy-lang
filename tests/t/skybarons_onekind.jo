# requires: sloppy
# Sky Barons: a fight with one kind of craft allowed has only that kind on each side's field, enough of them
# to seat everyone and some to spare, the one-a-side kinds (the castle, the carrier, the cat, the rocketeer)
# included: where they are all there is, they are not limited
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND, 0)

count_of = (ks: int[], k: int) -> int: ks.filter((x): x == k).len()
seats_in = (ks: int[]) -> int:
    s = 0
    loop x in ks: s += field_seats(x)
    s

# (a field of n a side, with only one kind allowed)
loop k in [ROCKETEER, PROPPACK, CASTLE, CARRIER, ZEPPELIN, FIGHTER, BOMBER]:
    loop n in [4, 10]:
        ks = field_kinds(n, DOGFIGHT, 1 << k)
        print("only the {KIND_NAMES[k]}, {n} a side: {ks.len()} on the field, all of it {count_of(ks, k) == ks.len()}, seats {seats_in(ks) >= n + 1}")

# (and a fight started so: everyone flies it, however many of them)
loop k in [CASTLE, CARRIER, ROCKETEER]:
    g = new_game([-1, -1, -1, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false, crafts = 1 << k), [])
    kinds = g.people.map((p): p.kind)
    print("only the {KIND_NAMES[k]}, in the air, three a side: {kinds.filter((x): x == k).len()} of {kinds.len()}, cap {kind_cap(g, k)}")

# (with anything else allowed, the one-a-side kinds still are)
g2 = new_game([-1, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT, ground_start = false, crafts = (1 << FIGHTER) | (1 << CASTLE)), [])
print("a fighter and a castle: castle cap {kind_cap(g2, CASTLE)}")

# (the usual mix, untouched: a craft for each and one more, no spare seats over; the fights' default kinds on)
loop n in [4, 16]:
    d = field_kinds(n, DOGFIGHT, DEFAULT_CRAFTS)
    print("the usual kinds, {n} a side: {d.len()} on the field, restricted {restricted(DOGFIGHT, DEFAULT_CRAFTS)}")
