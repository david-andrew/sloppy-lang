# requires: sloppy
# `?` on an error or nothing (E?, as db.exec gives): the error is passed on, and none, all went
# well, goes on, with no value
error struct ParseError: msg: str
check = (n: int) -> ParseError?:
    if n < 0: return ParseError("{n} is below 0")
    none
run = (n: int) -> int | ParseError:
    check(n)?
    n * 2
main = ():
    print(run(4))
    print(run(-1))
