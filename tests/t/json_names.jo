# requires: sloppy
# A field whose name ends in _ is the name without it in JSON: keywords as JSON names ("when",
# "in"), written by to_json and json_value and read by from_json (a mistake in one named as JSON
# names it); to_text and from_text keep the field's own name
struct Event:
    when_: f64
    in_ = "lobby"
    type = "join"
    id = 0
    x_y = 1
    last_ = [1, 2]
e = Event(when_ = 1.5, id = 3)
print(to_json(e))
print(to_json(e, indent = 2))
print(json_value(e).get("when").as_num() ?? -1.0)
print(from_json[Event]("\{\"when\": 2.5, \"in\": \"arena\", \"id\": 4, \"last\": [7]}"))
print(from_json[Event[]]("[\{\"when\": 1}, \{\"when_\": 2}]"))
print(to_text(e))
print(from_text[Event](to_text(e)))
print(from_json[Event]("\{\"when\": \"soon\"}"))
rt = from_json[Event](to_json(e))
print(rt is Event and rt == e)
