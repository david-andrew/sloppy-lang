# compute functions over a grid: f(id: ivec2, params) runs once per cell, id from (0, 0) to
# size - 1 (in groups of 8 by 8 on the GPU: the edges past the grid are left out)
# requires: sloppy
struct Img:
    px: GpuBuffer[i32]
    w: int
    hits: GpuBuffer[u32]

paint = (id: ivec2, u: Img):
    atomic_add(u.hits, 0, u32(1))
    u.px[int(id.y) * u.w + int(id.x)] = id.x + id.y * i32(1000)

w = 13
h = 5
img = Img(gpu_buffer[i32](w * h + 3), w, gpu_buffer[u32](1))
dispatch(compute(paint), ivec2(i32(w), i32(h)), img)
px = cpu(img.px)
ok = true
loop y in [0..h):
    loop x in [0..w):
        if px[y * w + x] != i32(x + y * 1000): ok = false
print(ok, px[w * h], px[w * h + 2], cpu(img.hits)[0])
print(px[w + 2], px[(h - 1) * w + w - 1])
dispatch(compute(paint), ivec2(0, 7), img)
print(cpu(img.hits)[0])
