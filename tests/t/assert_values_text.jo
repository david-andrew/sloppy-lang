# requires: sloppy
# assert's values: text in quotes, a call's result, a struct's fields
struct P:
    x: int
    y: int
name = "bo"
assert(name != "bob")
double = (n: int) -> int: n * 2
assert(double(3) == 6)
p = P(1, 2)
assert(p == P(1, 2) and true)
assert(double(2) == 5 or name == "bo")
assert(p != P(2, 1))
assert(name == "al")
