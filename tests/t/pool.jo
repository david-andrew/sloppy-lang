# requires: sloppy
# Pool: things that come and go, found again by handles that stay their own
struct Enemy:
    name = ""
    hp = 10
enemies: Pool[Enemy]
a = enemies.add(Enemy("a"))
b = enemies.add(Enemy("b"))
c = enemies.add(Enemy("c"))
enemies[b].hp -= 3
print(enemies.len(), enemies[b].hp)
enemies.remove(a)
print(enemies.has(a), enemies.has(b), enemies[c].name, enemies.index_of(c))
loop mut e in enemies.items: e.hp += 1
enemies.retain((e): e.name != "c")
print(enemies.has(c), enemies.len(), enemies[b].hp)
d = enemies.add(Enemy("d"))
print(d.slot == a.slot or d.slot == c.slot, enemies.has(a), enemies.has(c), enemies.get(c) == none, enemies[d].name)
enemies.clear()
print(enemies.len(), enemies.has(b))
none_h = Handle()
print(enemies.has(none_h))
