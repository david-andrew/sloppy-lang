# requires: sloppy
# c'a' is a character's code (a number); quoted text is text, and stands for a byte only where
# one is expected (s[i] == "a", a match on a byte, c in "+-")
s = "Hello, wörld!"
print(c'a', c'A' + 1, c'\n', c'\'', c'\\', c'é', c'\x41')
caesar = (t: str, k: int) -> str:
    out: u8[]
    loop b in bytes(t):
        if b >= c'a' and b <= c'z': out.push(u8((int(b) - c'a' + k) % 26 + c'a'))
        else: out.push(b)
    str_from_bytes(out)
print(caesar("hello", 3))
print(s[0] == "H", s[1] == 'e', s[5] in ",.", s[0] - 'A')
count = 0
loop b in bytes(s):
    match b:
        [c'a'..c'z']: count += 1
        _: pass
print(count, 'x' + "y", 'ab')
digits = [loop ch in "2024": int(ch - c'0')]
print(digits)
