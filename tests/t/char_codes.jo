# requires: sloppy
# one-character literals as character codes: 'a' wherever an integer goes, "a" where a byte does
s = "hello"
print(s[0] == "h", s[1] == 'e')
c: u8 = 43
print(c == "+", c in "+-", 'a' + 1)
buf: u8[]
buf.push("a")
buf.push('b')
print(buf)
n = 5
print(n == '5')
match s[0]:
    "h": print("h")
    _: print("other")
loop ch in chars("ab"):
    match ch:
        'a': print("a")
        _: print("not a")
xs: u8[] = ["x", 'y']
print(xs, u8('A'), int('0'))
