# requires: sloppy
# a lambda's parameter without a type takes it from how its body uses it
compose = (f, g): (x): f(g(x))
main = ():
    inc = (x): x + 1
    half = (x): x / 2.0
    g = (n: int): n * 10
    h = (y): g(y) + 1
    print(inc(2), half(3.0), h(4))
    twice = compose((x: int): x * 2, (x: int): x + 1)
    print(twice(5))
main()
