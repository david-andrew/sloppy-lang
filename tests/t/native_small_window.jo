# requires: native
# requires: sloppy
# a window for a design smaller than 640 x 360 opens a whole number of times larger (pixel art),
# but not with screen_fit(.native), even called after window(): a small tool's window is its size
# env: SLOPPY_SCREENSHOT=$TMP/native_small_window.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
window("small tool", 400, 120)
print("opened at {pixel_size()}")
screen_fit(.native)
print("native: {pixel_size()} screen {screen_size()} visible {visible_rect()}")
draw = ():
    clear()
    if frame_number() == 1: print("frame 1: {pixel_size()}")
