# requires: sloppy
# make_dirs makes the directories (a wasm program run by node too: mkdir there once did nothing and
# said it had, so a file written into one failed unless a native run had made it first); is_dir
# tells a directory from a file
base = "{temp_dir()}/mkd_{TARGET}"
print(make_dirs("{base}/a/b"))
print(is_dir("{base}/a"), is_dir("{base}/a/b"))
print(write_file("{base}/a/b/c.txt", "hi"))
print(read_file("{base}/a/b/c.txt"), is_dir("{base}/a/b/c.txt"), is_dir("{base}/none"))
