# requires: sloppy
# requires: native
# A route returns a raw stream before its producer task sends the first chunk.
# Fetch waits for end_stream; a second request still works on the same server.
import http
import net

http.get("/count", (r: http.Request) -> http.Response:
    conn = r.conn
    spawn(():
        loop i in [1..3]:
            assert(http.send_chunk(conn, "{i}\n"))
            sleep(0.005)
        http.end_stream(conn)
        assert(not http.stream_open(conn))
    , background = true)
    http.stream())

assert(http.listen(0, host = "127.0.0.1"))
spawn((): http.serve(http.port()), background = true)
main = ():
    url = "http://127.0.0.1:{http.port()}/count"
    loop _ in 0..2:
        r = net.fetch(url, wait = 5.0)
        assert(r.status == 200 and r.text == "1\n2\n3\n")
        assert(r.headers.get("transfer-encoding") == "chunked")
    http.shutdown(0.0)
    print("route task streams chunks and ends; fetch collects complete body")
