# requires: native
# requires: sloppy
# a hud_panel drawn over buttons (a dialog) takes their clicks, and a ui_ menu's, until it is gone;
# panels that are a list's own rows do not keep the wheel from it; a press claimed with
# claim_press() does not move the list; a list's bar is drawn over full-width rows; a
# hud_text_field drawn under scale() shows its text (its clip in the transform's units)
# env: SLOPPY_SCREENSHOT=$TMP/hud_layers.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=32
# env: SLOPPY_INPUT=2:mouse=150x100 3:wheel=-1 6:mouse_left+ 7:mouse=150x160 9:mouse=150x260 11:mouse_left- 16:mouse=60x78 17:mouse_left+ 18:mouse_left- 19:mouse=480x60 20:mouse_left+ 21:mouse_left- 22:mouse=330x220 23:mouse_left+ 24:mouse_left- 25:mouse=60x78 26:mouse_left+ 27:mouse_left- 28:mouse=480x60 29:mouse_left+ 30:mouse_left-
window("layers", 640, 400)
dialog = false
name = "visible"
dragging = -1
draw = ():
    global dialog, dragging, name
    clear(rgb(0.1, 0.1, 0.12))
    r = Rect(20, 20, 200, 300)
    off = hud_scroll(r, 20.0 * 40.0, "rows")
    clip(r)
    loop i in [0..20):
        y = r.y + f32(i) * 40 - f32(off)
        hud_panel(Rect(r.x, y, r.w, 36), rgb(0.9, 0.2, 0.2))
        if hud_button(Rect(r.x + 10, y + 4, 100, 28), "row {i}"): print("{frame_number()}: row {i}")
        if mouse_pressed(.left) and contains(Rect(r.x + 120, y, 80, 36), mouse_pos()):
            dragging = i
            claim_press()
    no_clip()
    if not mouse_down(.left): dragging = -1
    ui_begin("menu", vec2(480, 60))
    if ui_button("Menu"): print("{frame_number()}: menu")
    ui_end()
    push_transform()
    scale(2, 2)
    name = hud_text_field(Rect(150, 150, 140, 20), name, id = "scaled")
    pop_transform()
    if frame_number() == 14: dialog = true
    if dialog:
        hud_panel(visible_rect(), rgba(0, 0, 0, 0.5))
        hud_panel(Rect(240, 160, 180, 100))
        if hud_button(Rect(270, 200, 120, 40), "OK"): dialog = false
    if frame_number() == 2:
        img = screenshot()
        k = f64(img.width) / 640.0
        print("text in the scaled field: {bright(img, 300.0 * k, 300.0 * k, 280.0 * k, 40.0 * k)}")
        # (the bar's track, at the list's right edge, over the red rows)
        p = (int(70.0 * k) * img.width + int(216.0 * k)) * 4
        print("bar over the rows: {img.pixels[p] < 100}")
    if frame_number() == 5 or frame_number() == 10: print("{frame_number()}: scrolled {off:.0} dragging {dragging}")

# (whether any pixel in the box is near white)
bright = (img: Image, x: f64, y: f64, w: f64, h: f64) -> bool:
    loop yy in [int(y)..int(y + h)):
        loop xx in [int(x)..int(x + w)):
            p = (yy * img.width + xx) * 4
            if img.pixels[p] > 200 and img.pixels[p + 1] > 200 and img.pixels[p + 2] > 200: return true
    false
