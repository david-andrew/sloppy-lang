# requires: sloppy
# Sky Barons' decks: up out of a gunner's seat (or the pilot's) with U, standing on the craft
# there, riding with it in its frame as it goes; walking it, stopped by what is too tall to step
# onto, back into a free seat in reach with F; off its edge falling, the parachute as ever, onto a
# deck coming down standing on it; the craft shot down, falling with it; its crew still those
# seated; down beside a craft on the ground with T
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
# (people 0 and 4 red players 0 and 2, 1 a blue player 1; the rest the computer's; all dead for
# good till put somewhere)
fresh = () -> Game:
    let g = new_game([0, 1, -1, -1, 2, -1], 0.65, Rules(mode = DOGFIGHT), [])
    loop i in 0..g.people.len():
        g.people[i].state = DEAD
        g.people[i].timer = 1000000
    g
craft = (g: mut Game, kind: int, team: int, at: vec3) -> int:
    g.crafts.push(flying_craft(kind, team, at, vec3(1, 0, 0)))
    g.crafts.len() - 1
sit = (g: mut Game, i: int, j: int, s: int):
    g.crafts[j].seats[s] = i
    g.people[i].state = SEATED
    g.people[i].craft = j
    g.people[i].seat = s
pads = (a: Pad = Pad(), b: Pad = Pad(), c: Pad = Pad()) -> Pad[]: [a, b, c]
# (a pad walking the way `way` is in craft j's frame, Shift running if `run`)
walk = (g: Game, j: int, way: vec3, run: bool = false, pace: int = 100) -> Pad:
    w = quat_rotate(g.crafts[j].rot, way)
    Pad(pitch = -pace, throttle = if run: 1 else: 0, aim_yaw = int(atan2(-f64(w.x), -f64(w.z)) * 1000.0))
state = (p: Person) -> str: ["walking", "seated", "falling", "under the canopy", "dead", "at a gun"][p.state]
r1 = (x: f32) -> str: "{round(f64(x) * 10.0) / 10.0}"
spot = (v: vec3) -> str: "{r1(v.x)} {r1(v.y)} {r1(v.z)}"
# (where person i is against where its deck spot is on its craft now)
off_by = (g: Game, i: int) -> f64: f64(length(g.people[i].pos - point_of(g.crafts[g.people[i].craft], g.people[i].deck)))

# a red castle in the air, red's computer 2 its pilot, player 0 at a wall's machine gun (seat 14)
let g = fresh()
j = craft(g, CASTLE, 0, vec3(0, 500, 0))
sit(g, 2, j, 0)
sit(g, 0, j, 14)
g = tick(g, pads(Pad(stand = true)))
p = g.people[0]
print("U at the castle's machine gun: {state(p)}, on craft {p.craft} at {spot(p.deck)}, seat free {g.crafts[j].seats[14] < 0}, its side {crew_at(g, j)}")
# (along the wall walk ahead, riding with it as it flies: the castle turned under them)
g.crafts[j].vel = vec3(6, 2, 0)
loop n in 0..120: g = tick(g, pads(walk(g, j, vec3(0, 0, -1))))
p = g.people[0]
print("2 s along the wall: at {spot(p.deck)}, on its frame's spot {off_by(g, 0) < 0.01}, the castle moved {r1(length(g.crafts[j].pos - vec3(0, 500, 0)))} m")
# (the castle turned a third of a right angle and tipped: still on the same spot of its wall)
spot0 = g.people[0].deck
g.crafts[j].rot = quat_mul(quat_axis_angle(vec3(0, 1, 0), 0.5), quat_axis_angle(vec3(1, 0, 0), 0.05))
g = tick(g, pads())
print("the castle turned: on its frame's spot {off_by(g, 0) < 0.01}, the spot moved {r1(length(g.people[0].deck - spot0))} m")
# (into the corner tower: stopped at it)
loop n in 0..300: g = tick(g, pads(walk(g, j, vec3(0, 0, -1), true)))
print("on into the corner tower: stopped at z {r1(g.people[0].deck.z)}, still on the walk {r1(g.people[0].deck.y)}")
# (back to the gun, F: in it)
loop n in 0..400:
    if f64(g.people[0].deck.z) < -87.0: g = tick(g, pads(walk(g, j, vec3(0, 0, 1))))
g = tick(g, pads())
g = tick(g, pads())
g = tick(g, pads(Pad(enter = true)))
print("back at the gun, F: {state(g.people[0])}, seat {g.people[0].seat}")
# (the pilot, red's player 2, up off the bridge: the castle's side still red, its gunner's)
g = tick(g, pads())
sit(g, 4, j, 1)
g.people[2].state = DEAD
g.crafts[j].seats[0] = -1
sit(g, 4, j, 0)
g.crafts[j].seats[1] = -1
g = tick(g, pads(Pad(), Pad(), Pad(stand = true)))
print("the pilot, U: {state(g.people[4])} on the bridge at {spot(g.people[4].deck)}, the castle's side {crew_at(g, j)}")
# (the pilot back into the pilot's seat with its number, on the bridge)
g = tick(g, pads(Pad(), Pad(), Pad(seat = 1)))
print("then 1: {state(g.people[4])}, seat {g.people[4].seat}")
# (the gunner up, the merlon by the gun in the way; off the wall's outer edge between two of them:
# falling, then T, the canopy)
g = tick(g, pads(Pad(stand = true)))
g = tick(g, pads())
loop n in 0..60: g = tick(g, pads(walk(g, j, vec3(1, 0, 0))))
print("out toward the merlon by the gun: stopped at x {r1(g.people[0].deck.x)}")
loop n in 0..22: g = tick(g, pads(walk(g, j, vec3(0, 0, -1))))
loop n in 0..90:
    if g.people[0].state == WALK: g = tick(g, pads(walk(g, j, vec3(1, 0, 0))))
was = state(g.people[0])
loop n in 0..15: g = tick(g, pads())
g = tick(g, pads(Pad(leave = true)))
loop n in 0..15: g = tick(g, pads())
print("off the wall's outer edge: {was}; T: {state(g.people[0])}")
# (the other way, into the courtyard, 18 m down: the canopy opening on its own, down on it standing)
let h = fresh()
k = craft(h, CASTLE, 0, vec3(0, 500, 0))
sit(h, 2, k, 0)
sit(h, 0, k, 14)
h = tick(h, pads(Pad(stand = true)))
h.people[0].deck = vec3(65.3, 4, -110)
loop n in 0..400:
    if not (h.people[0].state == WALK and f64(h.people[0].deck.y) < -10.0): h = tick(h, pads(walk(h, k, vec3(-1, 0, 0))))
p = h.people[0]
print("off the wall into the courtyard: {state(p)}, on craft {p.craft}, at y {r1(p.deck.y)}")
# (down the stair inside the wall from the walk: to the courtyard)
let st = fresh()
sk = craft(st, CASTLE, 0, vec3(0, 500, 0))
sit(st, 2, sk, 0)
sit(st, 0, sk, 14)
st = tick(st, pads(Pad(stand = true)))
loop n in 0..60:
    if f64(st.people[0].deck.x) > 60.5: st = tick(st, pads(walk(st, sk, vec3(-1, 0, 0))))
loop n in 0..20: st = tick(st, pads())
top = st.people[0].deck
loop n in 0..480:
    if f64(st.people[0].deck.z) < -40.0: st = tick(st, pads(walk(st, sk, vec3(0, 0, 1))))
p = st.people[0]
print("onto the stair at y {r1(top.y)}, down it: {state(p)} at {spot(p.deck)}")
# (it shot down: one standing on it falls)
hurt_craft(h, k, 1, 1, 100000, h.crafts[k].pos)
h = tick(h, pads())
print("the castle shot down: {state(h.people[0])}, on craft {h.people[0].craft}")

# da Vinci's galleass, red's computer 2 flying it: player 0 at a ballista on the fighting top, up,
# off it down to the deck; the gunwale too tall to walk over, jumped; off the side
let v = fresh()
gv = craft(v, DAVINCI, 0, vec3(0, 600, 0))
sit(v, 2, gv, 0)
sit(v, 0, gv, 2)
v = tick(v, pads(Pad(stand = true)))
print("U at the fighting top's ballista: {state(v.people[0])} at {spot(v.people[0].deck)}")
loop n in 0..200:
    if not (v.people[0].state == WALK and f64(v.people[0].deck.y) < -3.0): v = tick(v, pads(walk(v, gv, vec3(-1, 0, 0), pace = 30)))
print("off the top: {state(v.people[0])} on the deck at y {r1(v.people[0].deck.y)}")
loop n in 0..120: v = tick(v, pads(walk(v, gv, vec3(-1, 0, 0))))
print("at the gunwale: stopped at x {r1(v.people[0].deck.x)}")
jp = walk(v, gv, vec3(-1, 0, 0))
jp.throttle = -1
v = tick(v, pads(jp))
loop n in 0..90:
    if v.people[0].state == WALK: v = tick(v, pads(walk(v, gv, vec3(-1, 0, 0))))
print("Ctrl, a jump over it: {state(v.people[0])}")
# (the computer's ballista taken from the deck with its number: they move over)
let w = fresh()
gw = craft(w, DAVINCI, 0, vec3(0, 600, 0))
sit(w, 2, gw, 4)
sit(w, 0, gw, 1)
w = tick(w, pads(Pad(stand = true)))
w.people[0].deck = vec3(0, -1.4, 34.5)
w = tick(w, pads())
w = tick(w, pads(Pad(seat = 5)))
print("on the stern deck, 5: {state(w.people[0])} seat {w.people[0].seat}; the computer's to seat {w.people[2].seat}")
# (and from a fighter's seat, nowhere to stand: still in it)
fj = craft(w, FIGHTER, 0, vec3(500, 600, 0))
sit(w, 4, fj, 0)
w = tick(w, pads(Pad(), Pad(), Pad(stand = true)))
print("U in a fighter: {state(w.people[4])}")
# (the galleass down on the ground: T on its deck, down by its ladder)
let l = fresh()
f = l.crafts.len()
at = vec3(300, f32(ground(300.0, 300.0)), 300)
l.crafts.push(parked(DAVINCI, 0, at, 0.0))
sit(l, 0, f, 1)
l = tick(l, pads(Pad(stand = true)))
l = tick(l, pads())
l = tick(l, pads(Pad(leave = true)))
p = l.people[0]
print("on a galleass on the ground, T: {state(p)}, on craft {p.craft}, by its ladder {f64(length(vec2(p.pos.x, p.pos.z) - vec2(point_of(l.crafts[f], DV_LADDER).x, point_of(l.crafts[f], DV_LADDER).z))) < 0.5}")

# the zeppelin: its tail gunner up onto the tail, then forward along its back, up its hull
let z = fresh()
zj = craft(z, ZEPPELIN, 0, vec3(0, 600, 0))
sit(z, 2, zj, 0)
sit(z, 0, zj, 4)
z = tick(z, pads(Pad(stand = true)))
print("U at the tail gun: {state(z.people[0])} at {spot(z.people[0].deck)}")
loop n in 0..180: z = tick(z, pads(walk(z, zj, vec3(0, 0, -1))))
print("3 s forward along its back: {state(z.people[0])} at {spot(z.people[0].deck)}")
loop n in 0..120:
    if f64(z.people[0].deck.z) > 21.0: z = tick(z, pads(walk(z, zj, vec3(0, 0, -1))))
z = tick(z, pads())
z = tick(z, pads(Pad(seat = 3)))
print("by the back gun, 3: {state(z.people[0])} seat {z.people[0].seat}")
# (a player parachuting onto a full zeppelin's back: standing on it)
loop s in 1..5: z.crafts[zj].seats[s] = 5
z.people[4].state = CHUTE
z.people[4].timer = 200
z.people[4].opened = 100
z.people[4].pos = point_of(z.crafts[zj], vec3(0, 12, 0))
z.people[4].vel = z.crafts[zj].vel
loop n in 0..120: z = tick(z, pads())
print("down on the full zeppelin's back: {state(z.people[4])}, on craft {z.people[4].craft}, at y {r1(z.people[4].deck.y)}")
