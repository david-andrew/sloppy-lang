# requires: sloppy
# numbers written out in an array literal take the parameter's element type, as in `x: u8[] = [...]`
mean_of = (xs: f64[]) -> f64: sum(xs) / f64(xs.len())
size_of_bytes = (b: u8[]) -> int: b.len()
first[T] = (b: u8[], x: T) -> int: int(b[0])
pick = (xs: int[]) -> str: "int"
pick = (xs: u8[]) -> str: "u8"
print(mean_of([1, 2, 3]), size_of_bytes([0x89, 0x50, 0x4E, 0x47]), first([7, 8], "x"), pick([1, 2]))
