# requires: sloppy
# Direction mapping is shared by the backdrop and ambient reflection. No window needed.
near = (a: vec2, b: vec2): assert(length(a - b) < 0.00001)
near(__sky_uv(vec3(1, 0, 0), 0), vec2(0.5, 0.5))
near(__sky_uv(vec3(0, 0, 1), 0), vec2(0.75, 0.5))
near(__sky_uv(vec3(0, 0, -1), 0), vec2(0.25, 0.5))
assert(abs(__sky_uv(vec3(0, 1, 0), 0).y) < 0.00001)
assert(abs(__sky_uv(vec3(0, -1, 0), 0).y - 1.0) < 0.00001)
near(__sky_uv(vec3(1, 0, 0), f32(PI / 2.0)), vec2(0.75, 0.5))
near(__sky_uv(vec3(1, 0, 0), f32(-TAU)), vec2(0.5, 0.5))
print("equirectangular axes, poles and rotation ok")
sky_image(Texture(42, 64, 32), 2.0, 0.7)
assert(__sky_image.id == 42 and __sky_on and __sky_intensity == 2.0)
hide_sky()
assert(not __sky_on and __sky_image.id == 42)
sky(vec3(0.1, 0.2, 0.3), vec3(0.4, 0.5, 0.6))
assert(__sky_image.id == 0 and __sky_on)
sky_image(Texture(42, 64, 32), -2.0)
assert(__sky_intensity == 0.0)
check_refresh = ():
    global __sky_cached
    __sky_cached = Texture(42, 64, 32)
    sky_image(Texture(42, 64, 32), refresh = true)
    assert(__sky_cached.id == 0)
check_refresh()
print("image, gradient, cache and hidden-background state ok")
