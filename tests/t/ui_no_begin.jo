# requires: native
# requires: sloppy
# a menu's button with no ui_begin before it stops the game with what it needs, rather than
# drawing a button half off the screen
# env: SLOPPY_SCREENSHOT=$TMP/ui_no_begin.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=3
draw = ():
    clear()
    if ui_button("Play"): print("play")
