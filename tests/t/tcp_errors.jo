# requires: sloppy
# requires: native
import net
# A refused connection's error remains owned by that result after yielding and other calls.
a = net.tcp_connect("127.0.0.1", 0, timeout = 0.05)
if a is net.NetError:
    saved = a.message
    sleep(0.0)
    b = net.tcp_connect("127.0.0.1", 0, timeout = 0.05)
    print(a.message == saved, a.message.contains("127.0.0.1:0"), b is net.NetError)
# A plain TCP server closing during the TLS handshake returns a detailed error and frees handles.
s = net.tcp_listen(0, "127.0.0.1")
closer = spawn(():
    c = net.tcp_accept(s, wait = 1.0)
    net.tcp_close(c)
)
r = net.tls_connect("127.0.0.1", net.tcp_port(s), timeout = 1.0)
print(r is net.NetError)
if r is net.NetError: print(r.message.contains("TLS 127.0.0.1:"), r.message.contains("handshake"))
closer.wait()
net.tcp_close(s)
print(net.__tcps.len())
