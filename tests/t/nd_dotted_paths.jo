# requires: sloppy
# dotted expressions on n-dimensional arrays: operands of the result's shape (one loop over all),
# a row stretched down the rows (a loop per row), a column stretched across (each element its
# own place), numbers, 1-D arrays and 3-D ones: the same as element by element, at every size
h = (m: f64[,]) -> str:
    s = 0.0
    loop i in 0.. and x in m.data: s += x * f64(i % 7 + 1)
    "{m.shape} {s}"

loop n in [1, 2, 3, 5, 8, 17]:
    a = reshape([loop i in 0..3 * n: f64(i) * 0.5], 3, n)
    b = reshape([loop i in 0..3 * n: f64(3 * n - i)], 3, n)
    row = reshape([loop j in 0..n: f64(j) + 0.25], 1, n)
    v = [loop j in 0..n: f64(j) - 1.0]
    col = reshape([1.0, 2.0, 3.0], 3, 1)
    print(h(a .+ b), h(a .* 2.0 .- b ./ 4.0), h(a .+ row), h(a .* v), h(a .- col), h(col .* row), h(sqrt.(a) .+ b .^ 2))
    c = reshape([loop i in 0..2 * 3 * n: f64(i % 11)], 2, 3, n)
    print(h(c .+ a), h(c .* row), h(c .- reshape([1.0, -1.0], 2, 1, 1)), h(max.(c, 3.0)))
    w = a
    w = w .- 0.001 .* b
    print(h(w), h(a))
