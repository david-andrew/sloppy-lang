# requires: native
# requires: sloppy
# hud_nav_input: a flight stick's hat and trigger, read raw, work hud_nav: held, the hat repeats
# as the d-pad does, the trigger chooses as it goes down, and the first of them after the mouse
# shows the focus. What gamepad_axis and gamepad_down read from the stick (not a standard gamepad)
# moves nothing; a standard gamepad still works alongside it
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=62
# env: SLOPPY_INPUT=1:pad1_name=T.16000M 2:pad1_lstick=0x1 2:pad1_rt=1 2:pad1_a+ 3:pad1_lt=0.7 6:pad1_a- 6:pad1_lstick=0x0 8:mouse=10x10 10:pad1_axis5=1 36:pad1_axis5=0 40:pad1_button0+ 46:pad1_button0- 50:pad1_axis5=-1 51:pad1_axis5=0 54:pad_up+ 55:pad_up- 57:pad_a+ 58:pad_a-
window("hud nav input", 1280, 720)
was = "-"
draw = ():
    global was
    clear(rgb(0.1, 0.12, 0.16))
    f = frame_number()
    # (pad 1, a flight stick: its hat is raw axes 4 and 5, its trigger raw button 0)
    if gamepad_connected(1) and not gamepad_standard(1):
        hud_nav_input(int(round(joystick_axis(1, 4))), int(round(joystick_axis(1, 5))), joystick_button(1, 0))
    hud_nav(true)
    now = "-"
    loop i in [0..5):
        r = Rect(480, 100 + 60 * f32(i), 320, 44)
        if hud_button(r, "B{i}"): print("{f}: B{i}")
        if hud_nav_focused(r): now = "B{i}"
    if now != was: print("{f}: focus {now}")
    was = now
    if f == 4: print("{f}: pad 1 standard {gamepad_standard(1)}, stick y {gamepad_axis(1, 1)}, triggers {gamepad_axis(1, 4)} {gamepad_axis(1, 5)}, a {gamepad_down(1, .a)}")
    if f == 9 or f == 12: print("{f}: active {hud_nav_active()}")
