# requires: native
# requires: sloppy
# Draw state setters and depth targets: what a render target made with depth_texture has, what
# copy_depth checks, scene_depth with and without post effects. (tests/render/draw_state.jo,
# depth_texture.jo, copy_depth.jo and scene_depth.jo draw them)
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
plain = render_target(32, 16)
deep = render_target(32, 16, depth_texture = true)
deep2 = render_target(32, 16, depth_texture = true)
small = render_target(8, 8, depth_texture = true)
print("plain: depth texture {plain.depth_texture.id != 0}, renderbuffer {plain.depth != 0}")
print("deep: depth texture {deep.depth_texture.id != 0} {deep.depth_texture.width}x{deep.depth_texture.height}, renderbuffer {deep.depth != 0}")
# (a RenderTarget put together by hand, as before depth textures: none)
by_hand = RenderTarget(plain.texture, plain.fbo, 0)
print("by hand: depth texture {by_hand.depth_texture.id}")
print("scene_depth before post effects: {scene_depth().id}")
frame = 0
draw = ():
    global frame
    frame += 1
    if frame == 1:
        blend(.screen)
        blend(.none)
        depth_test(.nearer_or_equal)
        depth_write(false)
        cull(.front)
        color_write(false)
        rect(0, 0, 10, 10, RED)
        copy_depth(deep, deep2)
        copy_depth(deep.depth_texture, deep2)
        print("copied")
        return
    post_effects(scene_depth = true)
    print("frame 2")
    copy_depth(deep, small)
