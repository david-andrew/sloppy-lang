# requires: sloppy
# Focus moved by keys into a scroll container brings the focused card into view, with the next
# one showing in part; a focusable panel activates; over(clip = true) stays in the list's clip.
import layout as ui

clicked: int[]
list = (input: ui.Input):
    ui.at(Rect(0, 0, 200, 100), render = false, input = input, ():
        ui.scroll(width = 200, height = 100, gap = 10, key = "list", ():
            loop i in [0..10):
                if ui.panel(width = 200, height = 40, pad = 0, focusable = true, key = "card {i}", ():
                    ui.over(anchor = .top_right, at = .center, width = 10, height = 10, clip = i > 0, key = "badge {i}", (): pass)
                ).clicked: clicked.push(i)
        )
    )
list(ui.Input())
list(ui.Input())
assert(ui.get("card 0")!.focused)
loop k in [1..7):
    list(ui.Input(nav = vec2(0, 1)))
    list(ui.Input())
    assert(ui.get("card {k}")!.focused, "down {k} reaches card {k}")
    r = ui.bounds("card {k}")!
    assert(r.y >= 0 and r.y + r.h <= 100, "card {k} is in view: {r}")
    nxt = ui.bounds("card {k + 1}")!
    assert(nxt.y < 100, "the next card shows in part: {nxt}")
# Going back up follows again; Enter activates the focused card.
list(ui.Input(nav = vec2(0, -1)))
list(ui.Input())
assert(ui.get("card 5")!.focused and ui.bounds("card 5")!.y >= 0)
list(ui.Input(activate = true))
assert(clicked == [5])
# A badge escapes the list's clip unless it is kept in it.
assert(ui.clip_bounds("badge 0")!.w > 1e19)
c = ui.clip_bounds("badge 3")!
assert(c.x == 0 and c.y == 0 and c.w == 200 and c.h == 100, "{c}")
print("layout focus ok")
