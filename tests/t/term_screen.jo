# requires: sloppy
# lib/term.jo: the screen of cells, and what a flush writes (only the cells changed since the last)
import term

shown = (s: str): print(to_json(s))

term.set_size(16, 4)
term.box(0, 0, 16, 4, title = "files")
term.put(1, 1, "a.txt", fg = term.YELLOW, style = term.BOLD)
term.put(1, 2, "日本 é", bg = term.color(236))
print(term.screen_text())
shown(term.render())
shown(term.render())                        # nothing changed: nothing written
term.put(3, 1, "x")
shown(term.render())                        # one cell
term.put(1, 1, "ab")
term.put(8, 1, "cd")
shown(term.render())                        # two runs on a row: the cells between written again
term.put(13, 2, "zz")
term.put(1, 2, "q", fg = term.color(rgb(1, 0.5, 0)))
shown(term.render())

# a wide character written over: its other half blank
term.set_size(8, 1)
term.clear()
term.put(0, 0, "日本語")
print(term.screen_text())
term.put(1, 0, "x")
print(term.screen_text())
term.put(4, 0, "y")
print(term.screen_text())
term.put(6, 0, "日本")                      # (the second does not fit)
print(term.screen_text())
print(term.text_width("日本語 and é"), term.text_width("é"), term.text_width("👍🏽"), term.fit("hello world", 8), term.fit("日本語です", 5))

# marks on a character, and what is off the screen
term.set_size(10, 2)
term.clear()
term.put(0, 0, "éx")
term.put(-2, 1, "abcdef")
term.put(7, 1, "日本")
print(term.screen_text())
print(term.put(0, 5, "off the screen"))
shown(term.render())

# colors and styles
term.set_size(6, 1)
term.clear()
term.put(0, 0, "a", fg = term.RED, bg = term.BRIGHT_BLUE)
term.put(1, 0, "b", fg = term.color(200), bg = term.color(rgb(0, 0.5, 1)))
term.put(2, 0, "c", style = term.UNDERLINE | term.ITALIC | term.REVERSE)
term.put(3, 0, "d", style = term.DIM | term.STRIKE, fg = term.GRAY)
term.fill_rect(4, 0, 2, 1, ch = "#", bg = term.GREEN)
shown(term.render())

# the cursor shown after a flush, then hidden
term.set_cursor(2, 0)
shown(term.render())
term.hide_cursor()
shown(term.render())
term.redraw()
shown(term.render())

# box lines
term.set_size(12, 3)
term.clear()
term.box(0, 0, 4, 3, lines = .double)
term.box(4, 0, 4, 3, lines = .rounded)
term.box(8, 0, 4, 3, lines = .heavy)
print(term.screen_text())
term.hline(0, 1, 12)
term.vline(5, 0, 3, ch = "|")
print(term.screen_text())
print(term.size())
