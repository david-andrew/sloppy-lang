# requires: sloppy
# T? is T | none, so a T?? is a T?: map.get on a map of optionals gives none for a missing key
# and for a none kept alike (m.has(k) tells them apart)
m: {str: int?} = {"x": none, "y": 1}
print(m.get("x"), m.get("y"), m.get("z"), m.has("x"), m.has("z"))
if let v = m.get("y"): print(v + 1)
gen[T] = (x: T) -> T?: x
print(gen[int?](none), gen[int?](5), gen[str?]("s"))
type OptInt = int?
q = gen[OptInt](none)
print(q, q == none)
x: int?? = 3
print(x ?? 0)
lst: (int?)[] = [none, 1]
print(lst.pop(), lst.pop())
