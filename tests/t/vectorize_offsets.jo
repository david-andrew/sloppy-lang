# requires: sloppy
# loops over c[r * n + j] (a row of a flat matrix) and over raw pointers, which release builds
# run several elements at a time: the same results as one at a time, for every length, and for
# rows of one array that overlap
axpy_rows = (c: mut f64[], b: f64[], x: f64, r: int, p: int, n: int):
    loop j in 0..n: c[r * n + j] += x * b[p * n + j]

axpy_ptr = (c: *f64, b: *f64, x: f64, r: int, p: int, n: int):
    loop j in 0..n: c[r * n + j] = c[r * n + j] + x * b[p * n + j]

# row r of xs from row r - 1 of the same array, each element from its neighbor's place
shift_rows = (xs: mut f32[], r: int, n: int, k: int):
    loop j in 0..n: xs[r * n + j] = xs[(r - 1) * n + j + k] * 2.0 + 1.0

ints = (ys: mut int[], xs: int[], r: int, n: int):
    loop j in 0..n: ys[r * n + j] = ys[r * n + j] + xs[r * n + j] - 3

h = (xs: f64[]) -> str:
    s = 0.0
    loop i in 0.. and x in xs: s += x * f64(i % 7 + 1)
    "{s}"

hf = (xs: f32[]) -> str:
    s: f32 = 0.0
    loop i in 0.. and x in xs: s += x * f32(i % 7 + 1)
    "{s}"

main = ():
    loop n in [1, 3, 4, 5, 7, 8, 9, 16, 17, 33]:
        c = [loop i in 0..3 * n: f64(i) * 0.5]
        b = [loop i in 0..3 * n: f64(3 * n - i) + 0.25]
        loop r in 0..3:
            loop p in 0..3: axpy_rows(c, b, f64(r + p) * 0.1, r, p, n)
        d = [loop i in 0..3 * n: f64(i) * 0.5]
        loop r in 0..3:
            loop p in 0..3: axpy_ptr(data(d), data(b), f64(r + p) * 0.1, r, p, n)
        # (the same array read and written: rows apart, and overlapping by one element)
        e = [loop i in 0..4 * n: f64(i)]
        axpy_ptr(data(e), data(e), 2.0, 1, 0, n)
        loop k in [0, 1]:
            xs = [loop i in 0..3 * n + 1: f32(i % 5)]
            shift_rows(xs, 1, n, k)
            shift_rows(xs, 2, n, k)
            print(n, k, hf(xs))
        ys = [loop i in 0..2 * n: i * 7]
        ints(ys, ys, 1, n)
        print(n, h(c), h(d), c == d, h(e), ys[2 * n - 1])
