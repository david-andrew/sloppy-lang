# requires: native
# requires: sloppy
# a game run headless (a screenshot run, frames of exactly 1/60 s): SLOPPY_INPUT's keys, mouse
# and typing arrive on their frames and nothing else does; time_scale slows update's dt
# env: SLOPPY_SCREENSHOT=$TMP/game_script.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=8
# env: SLOPPY_INPUT=2:space+,3:space-,4:mouse=100x50,5:text=hi,6:mouse_left+
t = 0.0
update = (dt: f64):
    f = frame_number()
    if f == 5: time_scale(0.5)
    t += dt
    if key_pressed(.space): print("{f}: space pressed")
    if key_released(.space): print("{f}: space released")
    if len(text_input()) > 0: print("{f}: typed {text_input()}")
    if mouse_pressed(.left): print("{f}: click at {mouse_pos()}")
    if f == 7: print("{f}: t = {t:.4}, dt = {dt:.4}")
draw = (): clear(BLACK)
