# requires: sloppy
# requires: native
# @cabi functions that allocate, run by threads C made (pthreads), several at once: the
# allocator gives them a state of their own, taken in turns (it crashed)
when TARGET == "windows":
    print([4088890, 4088890, 4088890, 4088890])
else:
    @lib("libc.so.6")
    extern pthread_create = (tid: *u64, attr: *u8, start: cfn(*int) -> *u8, arg: *int) -> i32
    @lib("libc.so.6")
    extern pthread_join = (tid: u64, ret: **u8) -> i32

    @cabi
    worker = (out: *int) -> *u8:
        total = 0
        loop i in [0..20000):
            s = "item {i} of {out[0]}"
            parts = s.split(" ")
            total += len(parts[1]) + len(parts[3]) * 0 + 200
        out[0] = total + out[0] * 0
        null

    outs = [loop t in [0..4): t]
    tids = fill(u64(0), 4)
    loop t in [0..4): pthread_create(data(tids) + t, null, worker, data(outs) + t)
    loop t in [0..4): pthread_join(tids[t], null)
    print(outs)
