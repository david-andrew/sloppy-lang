# requires: sloppy
# requires: native
# env: SLOPPY_SCREENSHOT=$TMP/layout_controls_touch.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_TOUCH=1
# env: SLOPPY_FRAMES=42
# env: SLOPPY_INPUT=3:touch1=100x40 4:touch1=248x100 5:touch1- 7:touch1=80x100 8:touch1- 10:touch1=240x160 11:touch1- 13:touch1=35x220 14:touch1- 16:text=Touch,18:pad_a+ 19:pad_a- 21:pad_a+ 22:pad_a- 24:down+ 25:down- 27:touch1=80x100 28:touch1=80x70 29:touch1- 32:touch1=40x220 33:touch1- 35:text=ignored,37:pad_a+ 38:pad_a-
import layout as ui
window("Touch controls", 320, 400)
v = 0.5
on = false
index = 0
name = ""
draw = ():
    global v, on, index, name
    clear()
    disabled = frame_number() >= 31
    ui.at(Rect(20, 20, 280, 360), ():
        ui.scroll(width = 280, height = 300, key = "list", gap = 20, ():
            v = ui.slider(v, 0.0, 1.0, width = 240, height = 40, key = "volume")
            on = ui.switch(on, "Hints", width = 240, height = 40, key = "hints")
            index = ui.choice(["Easy", "Normal"], index, width = 240, height = 40, key = "level")
            name = ui.text_field(name, "Name", width = 240, height = 40, enabled = not disabled, key = "name")
            ui.button("Apply", width = 240, height = 40, key = "apply")
            ui.space(height = 200)
        )
    )
    f = frame_number()
    if f == 4:
        assert(v == 1.0 and ui.bounds("volume")!.y == 20)
    if f == 8: assert(on)
    if f == 11: assert(index == 1)
    if f == 13: assert(not ui.get("name")!.editing)
    if f == 14: assert(ui.get("name")!.editing and ui_typing())
    if f == 16: assert(name == "Touch")
    if f == 18: assert(ui.get("name")!.submitted and not ui.get("name")!.editing)
    if f == 21: assert(ui.get("name")!.editing)
    if f == 24:
        assert(ui.get("apply")!.focused and not ui.get("name")!.editing)
        print("touch controls and keyboard activation ok")
    if f == 29:
        assert(on and ui.bounds("volume")!.y < 20)
        ui.scroll_to("list", 0)
    if f == 31: ui.scroll_to("list", 0)
    if f == 40:
        assert(name == "Touch" and not ui.get("name")!.editing)
        print("scroll cancels switch taps; disabled text ignores input")
