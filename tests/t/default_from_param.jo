# requires: sloppy
# a default naming an earlier parameter, given a variable of the caller's
struct P:
    x: int
    y: int
g = (a: int, b: int = a * 2) -> int: a + b
h = (p: P, w: int = p.x) -> int: w + p.y
main = ():
    x = 7
    q = P(3, 4)
    print(g(x), g(x, 1), h(q), h(q, 10))
    xs = [1 2 3]
    loop v in xs: print(g(v))
