# requires: sloppy (2D physics: import physics, lib/physics.jo)
import physics

near = (a: f64, b: f64, tol: f64) -> bool: abs(a - b) <= tol

w = physics.World()
floor = w.add_box(vec2(640, 700), vec2(1280, 40), kind = .fixed)

# a ball dropped bounces lower each time and comes to rest on the floor
ball = w.add_circle(vec2(100, 300), 20, bounce = 0.5)
touches = 0
loop _ in [0..240):
    w.step(1.0 / 60.0)
    loop c in w.contacts(ball):
        if c.new: touches += 1
print("ball rests on the floor:", near(f64(w.pos(ball).y), 660, 1.0), "touched", touches > 1, "still", length(w.velocity(ball)) < 5.0)

# a stack of boxes stays standing
stack: physics.Body[]
loop i in [0..8): stack.push(w.add_box(vec2(300, 680 - 40 * f64(i) - 20), vec2(40, 40)))
loop _ in [0..600): w.step(1.0 / 60.0)
top = w.pos(stack[7])
print("stack stands:", near(f64(top.x), 300, 2.0), near(f64(top.y), 380, 2.0), abs(w.angle(stack[7])) < 0.05)

# a pendulum on a pin swings through the bottom with the speed energy says
bob = w.add_circle(vec2(800, 200), 10)
arm = w.rod(physics.ground, bob, vec2(600, 200), vec2(800, 200))
speed = 0.0
loop _ in [0..300):
    w.step(1.0 / 240.0)
    speed = max(speed, f64(length(w.velocity(bob))))
d = length(w.pos(bob) - vec2(600, 200))
print("pendulum keeps its length:", near(f64(d), 200, 1.0), "fastest near sqrt(2 g l):", near(speed, sqrt(2.0 * 980.0 * 200.0), 30.0))

# a chain of links hangs from two pins
links: physics.Body[]
prev = physics.ground
loop i in [0..10):
    l = w.add_box(vec2(420 + 40 * f64(i), 100), vec2(40, 8), density = 0.5)
    w.pin(prev, l, vec2(400 + 40 * f64(i), 100))
    links.push(l)
    prev = l
w.pin(prev, physics.ground, vec2(800, 100))     # (taut: 10 links of 40 over 400)
loop _ in [0..600): w.step(1.0 / 60.0)
mid = w.pos(links[5])
end_ = w.to_world(links[9], vec2(20, 0))
print("taut chain holds:", near(f64(mid.y), 100, 8.0), near(f64(end_.x), 800, 1.0), near(f64(end_.y), 100, 1.0))

# a rope lets go slack, a spring settles at its length plus the weight's stretch
w2 = physics.World()
r1 = w2.add_circle(vec2(0, 100), 5)
w2.rod(physics.ground, r1, vec2(0, 0), vec2(0, 100), rope = true)
w2.set_pos(r1, vec2(0, 20))
loop _ in [0..10): w2.step(1.0 / 60.0)
slack_y = w2.pos(r1).y
loop _ in [0..120): w2.step(1.0 / 60.0)
print("rope: falls while slack", slack_y > 20.0 and slack_y < 99.0, "then holds at its length", near(f64(w2.pos(r1).y), 100, 1.5))
s1 = w2.add_circle(vec2(200, 100), 5, density = 2)
w2.rod(physics.ground, s1, vec2(200, 0), vec2(200, 100), spring = 2.0, damping = 1.0)
loop _ in [0..600): w2.step(1.0 / 60.0)
k = w2.mass(s1) * pow(2.0 * PI * 2.0, 2)
print("spring stretches by m g / k:", near(f64(w2.pos(s1).y), 100.0 + w2.mass(s1) * 980.0 / k, 1.0))

# a sensor reports what passes through it and stops nothing
w3 = physics.World(gravity = vec2(0, 0))
gate = w3.add_box(vec2(300, 100), vec2(20, 200), kind = .fixed, sensor = true)
dart = w3.add_circle(vec2(100, 100), 5)
w3.set_velocity(dart, vec2(400, 0))
met = false
loop _ in [0..60):
    w3.step(1.0 / 60.0)
    loop c in w3.contacts(gate):
        if c.b == dart and c.new: met = true
print("sensor: met", met, "passed through", w3.pos(dart).x > 400.0)

# a moving platform carries a box along
w4 = physics.World()
plat = w4.add_box(vec2(200, 400), vec2(200, 20), kind = .moving)
w4.set_velocity(plat, vec2(100, 0))
rider = w4.add_box(vec2(200, 370), vec2(30, 30), friction = 1.0)
loop _ in [0..120): w4.step(1.0 / 60.0)
print("platform carries the box:", near(f64(w4.pos(plat).x), 400, 0.5), near(f64(w4.pos(rider).x - w4.pos(plat).x), 0, 15.0))

# dragging a box by a corner toward a point
w5 = physics.World(gravity = vec2(0, 0))
crate = w5.add_box(vec2(100, 100), vec2(40, 40))
j = w5.drag(crate, vec2(120, 120))
w5.drag_to(j, vec2(400, 300))
loop _ in [0..180): w5.step(1.0 / 60.0)
print("drag brings the corner to the target:", length(w5.to_world(crate, vec2(20, 20)) - vec2(400, 300)) < 2.0)
w5.remove(j)

# rays and points
h = w.raycast(vec2(1000, 0), vec2(1000, 800))
if let hit = h: print("ray hits the floor at", int(hit.point.y), "normal", hit.normal, hit.body == floor)
print("bodies at a point:", w.bodies_at(w.pos(stack[3])) == [stack[3]], w.bodies_at(vec2(50, 50)).len())
print("ray misses:", w.raycast(vec2(0, 0), vec2(10, 0)) == none)

# removing a body lets what stood on it fall
w.remove(stack[0])
loop _ in [0..120): w.step(1.0 / 60.0)
print("removed: the rest fell", w.pos(stack[1]).y > 640.0, "alive", w.alive(stack[0]), w.alive(stack[1]))

# the same steps give the same world (for replays and rollback)
run = () -> vec2:
    v = physics.World()
    v.add_box(vec2(640, 700), vec2(1280, 40), kind = .fixed)
    bs: physics.Body[]
    loop i in [0..20): bs.push(v.add_polygon(vec2(500 + f64(i % 5) * 7, 100 - f64(i) * 30), [vec2(-15, -10), vec2(15, -12), vec2(18, 10), vec2(-10, 14), vec2(0, 18)]))
    loop _ in [0..300): v.step(1.0 / 60.0)
    v.pos(bs[19])
print("deterministic:", run() == run())

# bodies at rest fall asleep; a push, or what they rest on going, wakes them
w6 = physics.World()
w6.add_box(vec2(640, 700), vec2(1280, 40), kind = .fixed)
pile: physics.Body[]
loop i in [0..5): pile.push(w6.add_box(vec2(400, 660 - 40 * f64(i)), vec2(40, 40)))
loop _ in [0..120): w6.step(1.0 / 60.0)
print("asleep:", w6.sleeping(pile[0]), w6.sleeping(pile[4]))
w6.push(pile[4], vec2(0, -2000) * f32(w6.mass(pile[4])))
print("pushed: awake", not w6.sleeping(pile[4]))
loop _ in [0..120): w6.step(1.0 / 60.0)
w6.remove(pile[0])
loop _ in [0..60): w6.step(1.0 / 60.0)
print("the rest fell when the bottom went:", w6.pos(pile[1]).y > 650.0)

# a pin's limits stop a door at 45 degrees; a motor turns a wheel at its speed
w7 = physics.World(gravity = vec2(0, 0))
lid = w7.add_box(vec2(450, 300), vec2(100, 10))
hj = w7.pin(physics.ground, lid, vec2(400, 300), lower = 0, upper = PI / 4)
w7.push(lid, vec2(0, 3000) * f32(w7.mass(lid)), vec2(500, 300))
loop _ in [0..120): w7.step(1.0 / 60.0)
print("limit:", near(w7.joint_angle(hj), PI / 4, 0.02))
spinner = w7.add_box(vec2(800, 300), vec2(60, 20))
w7.pin(physics.ground, spinner, vec2(800, 300), motor_speed = 3, max_torque = 1e9)
loop _ in [0..60): w7.step(1.0 / 60.0)
print("motor:", near(w7.spin(spinner), 3, 0.01))

# a circle's sweep (circle_cast): where its center is when it first touches
w8 = physics.World()
w8.add_box(vec2(400, 600), vec2(800, 40), kind = .fixed)
w8.add_circle(vec2(600, 300), 50)
cat_ = (h: physics.Hit?, a: vec2, b: vec2) -> vec2:
    if let x = h: return a + (b - a) * x.fraction
    vec2(-99, -99)
q1 = cat_(w8.circle_cast(vec2(200, 0), vec2(200, 1000), 20), vec2(200, 0), vec2(200, 1000))
q2 = cat_(w8.circle_cast(vec2(300, 300), vec2(900, 300), 20), vec2(300, 300), vec2(900, 300))
print("circle casts:", near(f64(q1.y), 560, 0.01), near(f64(q2.x), 530, 0.01), w8.circle_cast(vec2(0, 100), vec2(800, 100), 10) == none)

# a removed body's handle is not the next body's, though it takes its place
w9 = physics.World()
old = w9.add_circle(vec2(0, 0), 5)
w9.remove(old)
nb = w9.add_box(vec2(500, 500), vec2(10, 10))
print("handles:", w9.alive(old), w9.alive(nb), old == nb, old.id == nb.id)
w9.remove(old)          # (removing twice does nothing)
gj = w9.drag(nb, vec2(500, 500))
w9.remove(nb)
print("its joints went with it:", w9.joint_alive(gj))
w9.drag_to(gj, vec2(0, 0))      # (a joint that went: nothing happens)
