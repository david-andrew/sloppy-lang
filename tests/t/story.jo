# requires: sloppy
# story: a Ren'Py-like script stepped through: lines, commands, menus with conditions, variables in text, if/elif/else, jump, call/return; errors with their lines; save and load after the script changed
script = r"""
character m "Mira" #f4a6c6

label intro:
    "This is skipped: the story starts at start."

label start:
    scene cafe with fade
    show mira happy
    "The bell rang twice."
    m "You came! [name] was sure you wouldn't."
    $ mira = 1
    menu:
        "Of course I came.":
            $ mira += 2
            m "Good."
        "I almost didn't." if mira < 5:
            $ mira -= 1
            jump doubt
        "Hidden" if mira > 100:
            "never"
    if mira >= 3:
        m "Then stay a while. ([mira] points)"
        call side
        "Back from the side scene."
    elif mira == 0:
        "Unreachable."
    else:
        jump doubt
    end

label side:
    "A side scene."
    return

label doubt:
    m "Oh."
"""
st = story(script)
print("error: [{st.error}]")
st.vars["name"] = 7
loop round in [0..2):
    s2 = story(script)
    s2.vars["name"] = 7
    loop guard in [0..40):
        step = s2.next()
        if step.kind == .end:
            print("-- end")
            break
        if step.kind == .line: print("{step.speaker}({step.color}): {step.text}")
        else if step.kind == .command: print("  [{join(step.words, " ")}]")
        else:
            print("  choice {step.choices} -> {round}")
            s2.choose(round)
    print(s2.vars)
loop bad in ["label start:\n    jump nowhere", "label start:\n    menu:\n        Stay:\n            \"x\"", "label start:\n    $ x 3", "label start:\n    m \"unclosed", "label start:\n    \"a\"\n        \"b\"", "label a:\n    \"x\"\nlabel a:\n    \"y\""]:
    print(story(bad).error)
v1 = "label start:\n    \"one\"\n    \"two\"\n    \"three\"\nlabel other:\n    \"o\""
st = story(v1)
st.next()
st.next()
saved = st.save()
print(to_text(saved))
# (the script changed in another label: the save still lands on "three")
v2 = "label intro:\n    \"new intro\"\n    \"more\"\nlabel start:\n    \"one\"\n    \"two\"\n    \"three\"\nlabel other:\n    \"o\""
st2 = story(v2)
st2.load(saved)
print(st2.next().text, st2.next().kind)
loop2 = story("label start:\n    jump start")
print(loop2.next().kind, loop2.error)
