# requires: native
# requires: sloppy
# no warnings
# env: SLOPPY_SCREENSHOT=$TMP/clear_arms.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=1
# a clear in each arm of a match on the screen: no warning (one arm runs)
enum Screen: title, select
screen: Screen = .title

draw = ():
    match screen:
        .title:
            clear(BLACK)
            text("title", vec2(20, 20), 20)
        .select:
            clear(BLUE)
            text("select", vec2(20, 20), 20)
window("x", 100, 100)
