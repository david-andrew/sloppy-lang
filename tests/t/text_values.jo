# requires: sloppy (to_text, from_text, save_value, load_value: lib/std/text.jo)
enum Mode: easy, hard
enum Shape: circle(r: f64), rect(w: f64, h: f64)
struct Item:
    name: str
    count = 1
struct Circle:
    r: f64
struct Box:
    w = 1.0
type Thing = Circle | Box | int | str
struct Settings:
    volume = 0.8
    name = "ann \"q\"\n\\ é"
    mode = Mode.hard
    keys: {str: int} = {"jump": 32}
    items: Item[] = [Item("sword"), Item("gem", 3)]
    pos = vec2(1.5, 2)
    ip = ivec2(-3, 4)
    best: int? = none
    best2: int? = 7
    shape = Shape.rect(1, 2)
    pair = (1, "a")
    grid: int[4] = [1, 2, 3, 4]
    flags: bool[] = [true, false]
    c: u8 = 7
    big: u64 = 18446744073709551615
    small: i8 = -128
    f: f32 = 0.1
    d = 0.1 + 0.2
    things: Thing[] = [Circle(2), Box(), 5, "five"]
    nested: int[][] = [[1], [], [2, 3]]
    m2: {int: Item} = {1: Item("x", 2)}
    cb: () -> int = (): 3

s = Settings()
s.volume = 0.25
t = to_text(s)
print(t)
r = from_text[Settings](t)
if r is TextError: print("error {r}")
else:
    print(to_text(r) == t, r.d == s.d, r.cb())

# missing and unknown fields, another order, spaces and lines
r2 = from_text[Settings]("Settings(mode=easy,\n  extra=[1, (2, 3)], volume = 0.5, unknown=\"x,)\")")
if r2 is TextError: print("error {r2}")
else: print(r2.volume, r2.mode, r2.items.len(), r2.name == s.name)

loop bad in ["Settings(volume=\"x\")", "Settings(mode=medium)", "Settings(c=300)", "Settings(volume=1", "[1, 2]", "Settings() x", "Settings(\n  name=\"open"]:
    e = from_text[Settings](bad)
    if e is TextError: print("{e.line}:{e.col}: {e.msg}")
    else: print("read {bad}")

type Pair = (int, Mode)
print(from_text[int[]]("[1, 2, 3,]"), from_text[str]("\"hi\""), from_text[Pair]("(3, easy)"), from_text[Shape]("circle(2.5)"))
print(to_text("a\tb"), to_text(3), to_text([Mode.easy]))

# kept between runs (SLOPPY_SAVE_DIR: the tests start with nothing saved)
first = load_value("settings", Settings())
print(first.volume)
first.volume = 0.6
first.items.push(Item("key"))
print(save_value("settings", first))
again = load_value("settings", Settings())
print(again.volume, again.items.len())
save_data("settings", "Settings(volume=\"loud\")")
print(load_value("settings", Settings()).volume)
