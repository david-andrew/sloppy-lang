# requires: native
# requires: sloppy
# design_size and window() called again change the 2D units while the game runs (the window
# keeps its size); css_pixel is a point in those units; safe_rect is all of visible_rect off a
# phone; SLOPPY_TOUCH=1 is a touch screen from the start
# env: SLOPPY_SCREENSHOT=$TMP/design_size.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=6
# env: SLOPPY_PIXEL_RATIO=2
# env: SLOPPY_TOUCH=1
# env: SLOPPY_INPUT=1:mouse=640x360
window("design", 1280, 720)
update = (dt: f64):
    if frame_number() == 3: design_size(360, 640)
    if frame_number() == 4: window("design", 640, 360)
    if frame_number() >= 2 and frame_number() <= 4:
        print("frame {frame_number()}: {screen_size()} visible {visible_rect()} point {css_pixel():.3} mouse {mouse_pos()} pixels {pixel_size()}")
    if frame_number() == 2: print("safe_rect is visible_rect: {safe_rect() == visible_rect()}, touch {touch_device()} {touch_input()}")
draw = (): clear()
