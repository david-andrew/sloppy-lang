# requires: sloppy
# requires: native
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_SCREENSHOT=$TMP/ui_text_limit.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_INPUT=5:text=éé
window("text limit", 320, 160)
v = repeat("a", 63)
draw = ():
    global v
    clear()
    ui_begin("field", vec2(160, 50))
    v = ui_text_field("Name", v)
    ui_end()
    if frame_number() == 7: print(char_count(v), v.ends_with("é"))
