# requires: sloppy
# Relative glTF buffers and images use URI escaping; embed_dir keys keep decoded subpaths.
source = () -> Json:
    r = parse_json(str_from_bytes(embed("data/tri.gltf")))
    if r is JsonError: panic(r.message)
    r
doc = source()
buffer_uri = doc.get("buffers").at(0).get("uri").as_str()!
image_uri = doc.get("images").at(0).get("uri").as_str()!
buffer = base64_decode(buffer_uri[find(buffer_uri, ",") + 1..])!
image = base64_decode(image_uri[find(image_uri, ",") + 1..])!

check = (buffer_name: str, image_name: str, files: {str: u8[]}):
    d = doc
    d.set_path(["buffers", 0, "uri"], buffer_name)
    d.set_path(["images", 0, "uri"], image_name)
    r = read_gltf(bytes(to_json(d)), files)
    if r is ModelError: panic(r.message)
    assert(r.meshes.len() == 1 and r.images.len() == 1)
    assert(r.meshes[0].vertices[1].pos == vec3(1, 0, 0))
    assert(r.images[0].get(0, 0) == vec4(1, 0, 0, 1))

check("buffers/fox%20body.bin", "textures/fox%20fur.png", {"buffers/fox body.bin": buffer, "textures/fox fur.png": image})
check("buffers/caf%c3%a9%23+.bin", "textures/caf%C3%A9%23+.png", {"buffers/café#+.bin": buffer, "textures/café#+.png": image})
# Keep exact URI keys, including an encoded one, ahead of decoded keys and basename fallbacks.
check("a%20b.bin", "a%20b.png", {"a%20b.bin": buffer, "a%20b.png": image, "a b.bin": [], "a b.png": []})
# Flattened caller-provided maps still work when only the basename is available.
check("buffers/a%23b.bin", "textures/a%23b.png", {"a#b.bin": buffer, "a#b.png": image})
print("glTF escaped buffer and image paths loaded")
