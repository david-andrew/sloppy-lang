# requires: sloppy
# Build, solve, cache and dispatch a 2041-box tree, with no window or text rendering.
# SLOPPY_LAYOUT_BENCH=1 prints timing; measure wall time only on the quiet benchmark laptop.
import layout as ui

tree = ():
    ui.at(Rect(0, 0, 1000, 1000), key = "bench", render = false, ():
        loop row in [0..40):
            ui.row(width = ui.grow(), height = 20, gap = 2, ():
                loop col in [0..50): ui.space(width = ui.grow(), height = 10)
            )
    )
loop warm in [0..10): tree()
rounds = if env("SLOPPY_LAYOUT_BENCH") != none: 1000 else: 3
ui.profile = env("SLOPPY_LAYOUT_BENCH") != none
solving = 0.0
live = alloc_count()
t = time()
loop i in [0..rounds):
    tree()
    solving += ui.solve_seconds
dt = (time() - t) / f64(rounds)
assert(alloc_count() <= live + 2, "layout retains allocations between frames")
if env("SLOPPY_LAYOUT_BENCH") != none:
    print("2041 boxes, build + solve + record: {dt * 1000:.3} ms; solve: {solving * 1000 / f64(rounds):.3} ms")
else: print("layout 2041 boxes ok")
