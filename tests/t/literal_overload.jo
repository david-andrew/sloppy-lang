# requires: sloppy
# integer literals pick int, then other integer types (when the value fits), then f64, then f32
choose = (x: u64) -> str: "u64"
choose = (x: f64) -> str: "f64"
pick = (x: i32) -> str: "i32"
pick = (x: f64) -> str: "f64"
pick = (x: f32) -> str: "f32"
wide = (x: f32) -> str: "f32"
wide = (x: f64) -> str: "f64"
print(choose(-1))
print(choose(5))
print(choose(0xFFFFFFFFFFFFFFFF))
print(pick(-1))
print(pick(3000000000))
print(wide(2))
a: u64 = 1 << 63
print(a)
b: u64 = 0xFFFFFFFFFFFFFFF0 | 7
print(b)
c: f64 = 0xFFFFFFFFFFFFFFFF
print(c)
h = 0xFF51AFD7ED558CCD
print(h)
