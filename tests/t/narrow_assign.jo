# requires: sloppy
# assigning to a field of a narrowed optional or union (a global, a field) changes it in place;
# assigning the narrowed path itself replaces the whole of it; x!.f = v assigns in place too
struct Enemy:
    hp = 3
struct Walker:
    x = 0
struct Flyer:
    y = 0
x: Enemy? = Enemy()
if x is Enemy:
    x.hp -= 1
    x.hp = 7
print(x)
struct Ship:
    target: Enemy? = none
    mover: Walker | Flyer = Walker()
s = Ship(target = Enemy())
f = (s: mut Ship):
    if s.target is Enemy:
        s.target.hp = 1
    if s.mover is Walker:
        s.mover.x = 5
f(s)
print(s.target, s.mover)
y: Enemy? = Enemy()
y!.hp = 9
print(y)
if y is Enemy:
    y = none
print(y)
g = (s: mut Ship):
    if s.target is Enemy:
        s.target = Enemy(hp = 40)
        s.target.hp += 2
g(s)
print(s.target)
