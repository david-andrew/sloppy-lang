# requires: native
# requires: sloppy
# a menu shown again (back from its Settings) has the item it was left on chosen, not the first
# env: SLOPPY_SCREENSHOT=$TMP/ui_focus_back.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=30
# env: SLOPPY_INPUT=3:down+,4:down-,5:down+,6:down-,8:enter+,9:enter-,14:escape+,15:escape-
screen = "title"
draw = ():
    global screen
    clear(BLACK)
    if screen == "title":
        ui_begin("title", vec2(640, 200))
        ui_button("New Game")
        ui_button("Continue")
        if ui_button("Settings"): screen = "settings"
        ui_end()
        if frame_number() == 20: print("back on the title: Settings chosen", __ui_focus == 2)
    else:
        ui_begin("settings", vec2(640, 200))
        ui_button("Volume")
        ui_end()
        if ui_back(): screen = "title"
