# requires: sloppy
a = {"x"}
b = {1, 2, 3,}
c = {loop w in ["hi" "yo" "hi"]: w}
d = {loop x in [1..6] if x % 2 == 0: x * x}
print(a, b, c, d)
print(2 in b, b == {3, 2, 1}, b.len())
f = (s: Set[int]) -> int: s.len()
print(f({4, 5}))
v = [{1, 2}, {3}]
print(v)
size_of_set = (s: Set[int]) -> int: s.len()
print(size_of_set({}))
struct G:
    seen: Set[str] = {}
g = G()
g.seen.add("a")
print(g)
