# requires: sloppy
# requires: native
# An HTTP server whose handlers run in tasks: one that sleeps holds up no other, and one that
# fetches from this same server is answered meanwhile
import http
import net

http.get("/slow", (r: http.Request) -> http.Response:
    sleep(0.5)
    http.text("slow done"))
http.get("/fast", (r: http.Request) -> http.Response: http.text("fast"))
# (a handler that asks this same server: it waits, and the server answers meanwhile)
http.get("/proxy", (r: http.Request) -> http.Response:
    got = net.fetch("http://127.0.0.1:19431/fast", wait = 5.0)
    http.text("proxied {got.text}"))

if not http.listen(19431, host = "127.0.0.1"): panic("cannot listen")
spawn((): http.serve(19431))

main = ():
    t0 = time()
    slow = spawn((): net.fetch("http://127.0.0.1:19431/slow", wait = 5.0).text)
    fast = spawn(() -> (str, f64):
        r = net.fetch("http://127.0.0.1:19431/fast", wait = 5.0)
        (r.text, time() - t0))
    f, at = fast.wait()
    print(f, at < 0.3)
    print(slow.wait(), time() - t0 >= 0.5)
    print(net.fetch("http://127.0.0.1:19431/proxy", wait = 5.0).text)
