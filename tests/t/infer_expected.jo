# Generic types from what the result must be: a lambda's open parameter types, a function value
# requires: sloppy
make[T] = (f: (T) -> T) -> T:
    x: T
    f(x)
zero[T] = () -> T:
    x: T
    x
struct E:
    msg: str
apply[T] = (f: () -> (T | E)) -> T | E: f()
main = ():
    x: int = make((v): v + 1)
    print(x)
    s: str = make((v): v + "!")
    print(s)
    f: () -> int = zero
    g: () -> f64 = zero
    print(f(), g())
    q: f64 | E = apply((): E("bad"))
    print(q)
    y: int? = make((v): v)
    print(y)
