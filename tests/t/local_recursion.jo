# requires: sloppy
# a function made inside another can call itself by the name it is given (no closure keeping
# itself alive: alloc_count() returns to where it was)
solve = (n: int) -> int:
    seen = fill(false, n)
    cnt = 0
    dfs = (u: int):
        if u >= n or seen[u]: return
        seen[u] = true
        cnt += 1
        dfs(u * 2 + 1)
        dfs(u * 2 + 2)
    dfs(0)
    cnt
fibs = (k: int) -> int:
    memo: {int: int} = {}
    fib = (n: int) -> int:
        if n < 2: return n
        if let v = memo.get(n): return v
        r = fib(n - 1) + fib(n - 2)
        memo[n] = r
        r
    fib(k)
main = ():
    print("start")
    base = alloc_count()
    print(solve(10), fibs(80))
    depth = (n: int):
        if n == 0: return
        depth(n - 1)
    depth(5000)
    loop i in 0..3:
        count = (k: int) -> int: if k == 0: 0 else: 1 + count(k - 1)
        print(count(i))
    leaked = alloc_count() - base
    print("leaked:", leaked)
main()
