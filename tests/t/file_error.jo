# requires: sloppy
# requires: native
# file_error: why the last file operation that failed did
d = join_path(temp_dir(), "sloppy_ferr")
make_dirs(join_path(d, "sub"))
write_file(join_path(d, "sub/f"), "x")
print(file_error() == "")
print(read_file(join_path(d, "nope")) == none, file_error())
print(read_file(d) == none, file_error())
print(write_file(join_path(d, "no/such/dir.txt"), "x"), file_error())
print(delete_dir(join_path(d, "sub")), file_error())
print(rename_file(join_path(d, "missing"), join_path(d, "b")), file_error())
print(delete_file(join_path(d, "missing")), file_error())
print(list_dir(join_path(d, "nope")).len(), file_error())
print(open_file(join_path(d, "sub")) == none, file_error())
delete_file(join_path(d, "sub/f"))
delete_dir(join_path(d, "sub"))
delete_dir(d)
