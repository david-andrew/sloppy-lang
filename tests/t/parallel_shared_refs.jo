# requires: sloppy (thread pool lives in lib/std)
# workers taking and dropping references to the same strings and arrays at once: their counts
# change atomically while threads run (debug builds add them inline only when none do)
names: str[]
table: int[][]

main = ():
    loop i in [0..64): names.push("name-{i}")
    loop i in [0..16): table.push([i, i * 2, i * 3])
    before = alloc_count()
    loop round in [0..20):
        lens = parallel_range(4000, (i):
            s = names[i % 64]
            row = table[i % 16]
            kept = [s, names[(i + 1) % 64]]
            len(kept[0]) + len(kept[1]) + row[2])
        if round == 0: print(lens[0], lens[3999], lens.len())
    print(names[63], table[15], alloc_count() - before < 10)      # (no leak: the pool keeps a few)
