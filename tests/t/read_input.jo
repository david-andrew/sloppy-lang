# read_line: a line of standard input without its end (\r\n too), none when it has ended;
# requires: sloppy
# read_stdin: the rest of it (this test's input is tests/t/read_input.in)
name = read_line() ?? "nobody"
print("hello, {name}")
total = 0
loop:
    l = read_line() ?? "end"
    if l == "end": break
    total += to_int(l) ?? 0
print("total", total)
rest = read_stdin()
print(lines(rest).len(), "more lines:", lines(rest))
print(read_line() == none, read_stdin() == "")
