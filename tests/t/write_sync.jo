# requires: native
# requires: sloppy
# write_file(sync = true): through a new file beside it, put on the disk, then renamed over the
# old one; append_file(sync = true) on the disk before it returns
d = "{temp_dir()}/sloppy-write-sync-{random_int(0, 1000000000)}"
make_dirs(d)
p = "{d}/data.json"
print(write_file(p, "\{\"n\": 1}", sync = true), read_file(p) ?? "?")
print(write_file(p, "\{\"n\": 2}", sync = true), read_file(p) ?? "?", file_exists(p + ".new"))
print(write_bytes("{d}/b.bin", [u8(1), 2, 3], sync = true), read_bytes("{d}/b.bin") ?? [])
log = "{d}/changes.log"
loop i in [0..3): append_file(log, "\{\"seq\": {i}}\n", sync = true)
append_file(log, "plain\n")
print(split(trim(read_file(log) ?? ""), "\n"))
print(write_file("{d}/no/such/dir/x.json", "x", sync = true), file_error())
print(append_file("{d}/no/such/dir/x.log", "x", sync = true), file_error())
loop f in [p, "{d}/b.bin", log]: delete_file(f)
delete_dir(d)
print(file_exists(d))
