# requires: sloppy
# env: SLOPPY_NO_AUDIO=1
# the audio clock with a device that says what it holds a period (512 frames) at a time, read in
# frames of 1/60 s give or take 2 ms, at moments through each: smooth against a straight line,
# never going back, never past the samples mixed; and a frame of 0.2 s, where the device runs dry
# and starts again later: the clock waits for it, then is as smooth (the mixer run by hand)
seed_random(1)
B = 3072                   # (the device's buffer: 6 periods of 512)
t = 1.0
base = 1.0                 # (when the device would have started, had it never run dry)
last = 0.0
back = false
past = false
errs: f64[]
after: f64[]
loop f in [0..1500):
    t += 1.0 / 60.0 + random(-0.002, 0.002)
    if f == 800: t += 0.2
    hp = int(floor((t - base) * 48000.0 / 512.0)) * 512       # (what it has played)
    if hp > __mixed:
        base += f64(hp - __mixed) / 48000.0
        hp = __mixed
    if B - (__mixed - hp) > 0: __mix(B - (__mixed - hp))
    __clock_note(__mixed - hp, t)
    loop k in [0..4):
        ts = t + f64(k) / 240.0 + random(0.0, 1.0 / 240.0)
        a = __clock_read(ts)
        if a < last: back = true
        if a > f64(__mixed) / 48000.0: past = true
        last = a
        if f > 120 and f < 800: errs.push(a - (ts - base))
        if f > 1000: after.push(a - (ts - base))
spread = (es: f64[]) -> (f64, f64, f64):
    mean = 0.0
    loop e in es: mean += e
    mean /= f64(es.len())
    var = 0.0
    worst = 0.0
    loop e in es:
        var += (e - mean) * (e - mean)
        worst = max(worst, abs(e - mean))
    (sqrt(var / f64(es.len())), worst, mean)
sa = spread(errs)
sb = spread(after)
print("off a straight line: under 0.3 ms {sa.0 < 0.0003} (worst under 2 ms {sa.1 < 0.002}), behind what is heard by about half a period {sa.2 < -0.002 and sa.2 > -0.008}")
print("after running dry: under 0.3 ms {sb.0 < 0.0003} (worst under 2 ms {sb.1 < 0.002}), behind as before {abs(sb.2 - sa.2) < 0.001}")
print("went back {back}, past the samples mixed {past}")
print("latency {audio_latency() * 1000.0:.0} ms")
