# File.read_line: lines longer than what one read gives (64 KB), \r\n ends, a last line without
# an end, an empty line
# requires: sloppy
# requires: native
path = "{temp_dir()}/sloppy_read_line_long.txt"
long = "x" * 200000
write_file(path, "short\r\n{long}\n\n{long}y\r\nlast")
f = open_file(path)!
loop let l = f.read_line(): print(l.len(), l[..min(l.len(), 5)))
f.close()
delete_file(path)
