# an Inflater stepped a little at a time gives inflate's bytes; a damaged stream gives none either way
# requires: sloppy
txt = ""
loop i in [0..6000): txt += "Person(id={i}, name=\"p{i % 37}\", gold={(i * 7919) % 5000}, alive=true)\n"
src = bytes(txt)
z = deflate(src)
s = inflater(z)
print(s.progress())
steps = 0
half = false
ok = true
last = 0.0
loop not s.step(0.0):
    steps += 1
    if s.progress() < last: ok = false
    last = s.progress()
    if s.progress() >= 0.5: half = true
print(steps > 2, half, ok, s.progress(), (s.result() ?? []) == src, (inflate(z) ?? []) == src)
# (result finishes one that is not done; one of nothing; a zlib stream after its header)
e = inflater(z)
e.step(0.0)
print((e.result() ?? []) == src)
empty = inflater(deflate([]))
print((empty.result() ?? [u8(1)]).len())
print((inflate([u8(0x78), u8(0x9c), u8(0x4b), u8(0x4c), u8(0x4a), u8(0x06), u8(0x00)], 2) ?? []) == bytes("abc"))
# (cut short, or with a byte changed: none, stepped or not)
cut = inflater(z[..z.len() - 3])
loop not cut.step(0.0): pass
print(cut.result() == none, inflate(z[..z.len() / 2]) == none)
bad = z
bad[0] = bad[0] | u8(6)
b2 = inflater(bad)
print(inflate(bad) == none, b2.result() == none)
