# requires: native
# requires: sloppy
# SLOPPY_INPUT fingers: touches() sees each, and the first finger down is the mouse, as on a phone
# env: SLOPPY_SCREENSHOT=$TMP/touch_script.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=12
# env: SLOPPY_INPUT=3:touch1=100x100,5:touch2=300x200,6:touch1=150x120,8:touch1-,9:touch2-
window("t", 640, 360)
update = (dt: f64):
    ts = touches()
    if ts.len() > 0 or mouse_pressed(.left) or mouse_released(.left): print("f{frame_number()} touches {ts} mouse {mouse_pos()} down {mouse_down(.left)} touch_input {touch_input()}")
draw = (): clear()
