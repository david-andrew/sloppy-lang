# requires: sloppy
# from_csv says why when no column names a field: another separator, UTF-16, other names
struct Sale:
    date = ""
    region = ""
    price = 0.0
u16 = str_from_bytes([u8(0xFF), 0xFE, 'd', 0, 'a', 0])
dir = temp_dir()
assert(write_file("{dir}/bom.json", "\xEF\xBB\xBF\{\"date\": \"x\"}"))
loop t in ["date;region;price\n2024-01-01;north;1.5\n" "a,b\n1,2\n" u16]:
    r = from_csv[Sale](t)
    if r is TextError: print(r.message)
    else: print(r)
print(from_csv[Sale]("date;region;price\n2024-01-01;north;1.5\n", ';'))
print(from_json[Sale](read_file("{dir}/bom.json")!))
assert(write_file("{dir}/crlf.txt", "\xEF\xBB\xBFone\r\ntwo\r\n"))
print(read_file("{dir}/crlf.txt")!.lines())
