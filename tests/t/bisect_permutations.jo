# requires: sloppy
# lower_bound, upper_bound, partition_point, next_permutation, permutations, combinations,
# reverse of a part, and join of any array (lib/std/algo.jo)
xs = [1 3 3 5 8]
print(lower_bound(xs, 3), upper_bound(xs, 3), lower_bound(xs, 0), upper_bound(xs, 9), bisect_left(xs, 4), bisect_right(xs, 5))
print(partition_point(xs, (x): x < 4), partition_point(xs, (x): true))
e: int[]
print(lower_bound(e, 1), upper_bound(e, 1))
ws = ["apple", "fig", "kiwi"]
print(lower_bound(ws, "banana"))
p = [1 2 3]
loop:
    print(p)
    if not next_permutation(p): break
print(p)
q = [1 1 2]
n = 1
loop next_permutation(q): n += 1
print(n, q, prev_permutation(q), q)
print(permutations([1 2 3]))
print(permutations([1 2 3], 2), permutations([1 2], 3), permutations(e))
print(combinations([1 2 3 4], 2), combinations([1 2 3], 0), combinations([1 2 3], 3), combinations([1 2], 3))
r = [0 1 2 3 4 5 6]
r.reverse(2, 5)
print(r)
r.reverse()
print(r)
print([1 2 3].join(" "), [1.5 2.0].join(", "), ["a", "b"].join("-"), join(", ", ["x", "y"]), [(1, 2)].join(";"))
print(join(["a", "b"]), [true false].join())
struct P:
    name: str
    age: int
ps = [P("a", 10), P("b", 20), P("c", 30), P("d", 40)]
print(partition_point(ps, (p): p.age < 25), ps[partition_point(ps, (p): p.age < 35)].name)
# every ordering of 8 once, and back to sorted
o = [0..8)
k = 1
loop next_permutation(o): k += 1
print(k, o, permutations([0..8)).len(), combinations([1..20], 10).len())
