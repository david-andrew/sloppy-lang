@inline
change_in = (v: mut vec4):
    v = vec4(15, 18, 21, 24)
@inline
saved_in = (s: mut Cell) -> vec4:
    old = s.v
    s.v.x *= 2
    old
@inline
argument_in = (s: mut Cell, old: vec4) -> vec4:
    s.v.x *= 2
    old
@noinline
change_out = (v: mut vec4):
    v = vec4(15, 18, 21, 24)
@noinline
saved_out = (s: mut Cell) -> vec4:
