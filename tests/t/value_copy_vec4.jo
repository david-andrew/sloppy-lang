# Reverse copies and two loop-carried memory-generation checks.
@noinline
reverse_case = (s: mut Cell, take: bool):
    local: vec4 = vec4(3, 6, 9, 12)
    before = s.v.x
    s.v = local
    after = s.v.x
    if take: local = vec4(15, 18, 21, 24)
    saved = s.v
    total = 0.0
    loop i in 0..3:
        old = s.v
        s.v.x += 1
        now = s.v
        total += f64(now.x) - f64(old.x)
    print("reverse", take, before, after, total, local.x, local.y, local.z, local.w, saved.x, saved.y, saved.z, saved.w, s.v.x, s.v.y, s.v.z, s.v.w)
    replacement: vec4 = vec4(15, 18, 21, 24)
    sum = 0.0
    loop i in 0..3:
        sum += f64(s.v.x)
        s.v = replacement
    print("bit stores", sum, replacement.x, replacement.y, replacement.z, replacement.w, s.v.x, s.v.y, s.v.z, s.v.w)

# Runtime parameters keep both control-flow paths in the non-inlined cases.
loop mode in 0..10:
    loop take in [false, true]:
        s = Cell(vec4(3, 6, 9, 12))
        param_case(s, mode, take)
        global_case(mode, take)
        local_case(mode, take)
        xs = [Cell(vec4(15, 18, 21, 24)), Cell(vec4(3, 6, 9, 12))]
        element_case(xs, 1, mode, take)
        o = Outer(Cell(vec4(3, 6, 9, 12)))
        nested_case(o, mode, take)
# Aggregate return snapshots and an argument aliased by a mut argument.
loop take in [false, true]:
    rev = Cell(vec4(15, 18, 21, 24))
    reverse_case(rev, take)
s_in = Cell(vec4(3, 6, 9, 12))
r_in = saved_in(s_in)
print("return in", r_in.x, r_in.y, r_in.z, r_in.w, s_in.v.x, s_in.v.y, s_in.v.z, s_in.v.w)
a_in = argument_in(s_in, s_in.v)
print("argument in", a_in.x, a_in.y, a_in.z, a_in.w, s_in.v.x, s_in.v.y, s_in.v.z, s_in.v.w)
s_out = Cell(vec4(3, 6, 9, 12))
r_out = saved_out(s_out)
print("return out", r_out.x, r_out.y, r_out.z, r_out.w, s_out.v.x, s_out.v.y, s_out.v.z, s_out.v.w)
a_out = argument_out(s_out, s_out.v)
print("argument out", a_out.x, a_out.y, a_out.z, a_out.w, s_out.v.x, s_out.v.y, s_out.v.z, s_out.v.w)
