    old

@noinline
param_case = (s: mut Cell, mode: int, take: bool):
    whole = s
    field = Cell(vec4(15, 18, 21, 24))
    elements = [s]
    element = elements[0]
    pair = (s, 97)
    tuple_element = pair.0
    relay = s.v
    first = relay
    field.v = first
    before = s.v.x
    match mode:
        0: s.v = vec4(15, 18, 21, 24)
        1: s.v += vec4(2)
        2: s.v.x *= 2
        3: change_in(s.v)
        4: change_out(s.v)
        5:
            if take: s.v = vec4(15, 18, 21, 24)
        6:
            if take: pass
            else: s.v = vec4(15, 18, 21, 24)
        7:
            match take:
                true: s.v = vec4(15, 18, 21, 24)
                false: pass
        8:
            loop j in 0..(if take: 3 else: 0): s.v.x += 1
        _:
            if take:
                s.v = vec4(15, 18, 21, 24)
                observed_relay = s.v
                observed = observed_relay
                check = f64(first.x) + f64(s.v.x) - f64(observed.x)
                print("param", mode, take, "before", before, "check", check)
                print("local", first.x, first.y, first.z, first.w)
                print("whole", whole.v.x, whole.v.y, whole.v.z, whole.v.w)
                print("field", field.v.x, field.v.y, field.v.z, field.v.w)
                print("element", element.v.x, element.v.y, element.v.z, element.v.w)
                print("tuple", tuple_element.v.x, tuple_element.v.y, tuple_element.v.z, tuple_element.v.w)
                print("observed", observed.x, observed.y, observed.z, observed.w)
                print("original", s.v.x, s.v.y, s.v.z, s.v.w)
                return
    observed_relay = s.v
    observed = observed_relay
    check = f64(first.x) + f64(s.v.x) - f64(observed.x)
    print("param", mode, take, "before", before, "check", check)
    print("local", first.x, first.y, first.z, first.w)
    print("whole", whole.v.x, whole.v.y, whole.v.z, whole.v.w)
    print("field", field.v.x, field.v.y, field.v.z, field.v.w)
    print("element", element.v.x, element.v.y, element.v.z, element.v.w)
    print("tuple", tuple_element.v.x, tuple_element.v.y, tuple_element.v.z, tuple_element.v.w)
    print("observed", observed.x, observed.y, observed.z, observed.w)
    print("original", s.v.x, s.v.y, s.v.z, s.v.w)
    second = s.v
    s.v.x += 1
    print("second", second.x, second.y, second.z, second.w, "final", s.v.x, s.v.y, s.v.z, s.v.w)

