# requires: sloppy
# requires: native
# requires: unix
# env: SLOPPY_SOFTWARE=1
# One fog() looks the same on the simple lighting and on PBR materials: in thick fog both
# become the sky's horizon color, and the PBR path fogs in the simple path's color space.
haze = vec3(0.62, 0.7, 0.78)
box = cube_mesh(2)
pixel = (img: Image, x: int, y: int) -> (int, int, int):
    k = (y * img.width + x) * 4
    (int(img.pixels[k]), int(img.pixels[k + 1]), int(img.pixels[k + 2]))
near = (a: (int, int, int), b: (int, int, int)) -> bool:
    abs(a.0 - b.0) <= 1 and abs(a.1 - b.1) <= 1 and abs(a.2 - b.2) <= 1
capture = (density: f64) -> Image:
    render_image(64, 32, ():
        camera3d(vec3(0, 0, 5), vec3(0, 0, 0), 60)
        sky(haze, haze, haze)
        sun(vec3(-1, 2, 1))
        shadows(false)
        fog(haze, density, 0)
        draw_mesh(box, transform(vec3(-1.5, 0, 0)), color = rgb(0.8, 0.3, 0.2))
        draw_mesh(box, transform(vec3(1.5, 0, 0)), color = rgb(0.8, 0.3, 0.2), material = Material(roughness = 0.5))
        rect(Rect(0, 0, 1, 1), rgba(0, 0, 0, 0)))      # (2D after the 3D: the 3D is drawn first)
thick = capture(5.0)
sky_px = pixel(thick, 32, 1)
simple_px = pixel(thick, 24, 16)
pbr_px = pixel(thick, 40, 16)
assert(near(simple_px, sky_px))
assert(near(pbr_px, sky_px))
# Unfogged, the two boxes differ; light fog moves both toward the same color.
clear_img = capture(0.0)
assert(not near(pixel(clear_img, 24, 16), sky_px) and not near(pixel(clear_img, 40, 16), sky_px))
# The PBR fog takes a tone-mapped color back before fogging it: exact enough to round-trip.
loop k in [0..100]:
    y = f32(k) / 100.0
    assert(abs(aces(__aces_inverse(vec3(y, y, y))).x - y) < 0.0005)
print("fog matches")
