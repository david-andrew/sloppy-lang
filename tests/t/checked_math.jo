# requires: sloppy
# checked, saturating and wrapping integer arithmetic, and checked conversions (lib/std/checked.jo)
big = MAX_INT
small = MIN_INT
print(checked_add(big, 1), checked_add(big - 1, 1), checked_add(small, -1), checked_add(small, big))
print(checked_sub(small, 1), checked_sub(small + 1, 1), checked_sub(0, small), checked_sub(-1, small))
print(checked_mul(big, 2), checked_mul(small, -1), checked_mul(small, 1), checked_mul(-1, big))
print(checked_mul(3037000499, 3037000499), checked_mul(3037000500, 3037000500), checked_mul(-3037000500, 3037000500))
print(checked_mul(1 << 32, 1 << 31), checked_mul(1 << 32, 1 << 30), checked_mul(-(1 << 32), 1 << 31), checked_mul(0, small))
print(saturating_add(big, 5), saturating_add(small, -5), saturating_sub(small, 1), saturating_sub(big, -1))
print(saturating_mul(big, 2), saturating_mul(big, -2), saturating_mul(small, -1), saturating_mul(-4, 5))
print(wrapping_add(big, 1) == small, wrapping_mul(big, 2), wrapping_sub(small, 1) == big)

u: u64 = 0xFFFFFFFFFFFFFFFF
print(checked_add(u, 1), checked_add(u - 1, 1), checked_sub(u64(3), 4), checked_sub(u64(4), 3))
print(checked_mul(u, 2), checked_mul(u64(1) << 32, u64(1) << 31), checked_mul(u64(0xFFFFFFFF), u64(0x100000001)))
print(saturating_add(u, 1), saturating_sub(u64(3), 4), saturating_mul(u, 3), wrapping_add(u, 2))

a: i8 = 100
b: i8 = 27
print(checked_add(a, b), checked_add(a, 28), checked_sub(i8(-100), 29), checked_mul(a, -1), checked_mul(i8(-128), -1))
print(saturating_add(a, a), saturating_sub(i8(-100), a), saturating_mul(a, -2), wrapping_add(a, a))
c: u8 = 200
print(checked_add(c, 55), checked_add(c, 56), checked_sub(c, 201), saturating_sub(c, 201), saturating_mul(c, 2), wrapping_mul(c, 2))
x: u32 = 0xFFFFFFFF
print(checked_mul(x, x), checked_mul(x, 1), saturating_mul(x, x), saturating_add(x, 1), checked_sub(u32(0), 1))
y: i32 = 0x7FFFFFFF
print(checked_add(y, 1), saturating_add(y, 1), checked_mul(y, y), checked_mul(i32(-46341), 46341), checked_mul(i32(-46340), 46340))
h: u16 = 65535
z: i16 = -32768
print(checked_add(h, 1), saturating_add(h, 1), checked_sub(z, 1), saturating_sub(z, 1), checked_mul(z, -1), saturating_mul(z, -1))
# (mixed types go as int; a literal takes the other's type)
print(checked_add(y, big), checked_add(c, 1) == u8(201))

# conversions
n = 300
print(checked_cast[u8](n), checked_cast[u8](255), checked_cast[u8](-1), checked_cast[i8](-128), checked_cast[i8](-129))
print(checked_cast[u64](-1), checked_cast[u64](big), checked_cast[int](u), checked_cast[int](u64(5)), checked_cast[u32](u))
print(checked_cast[i16](y), checked_cast[i32](i16(-5)), checked_cast[u16](x), checked_cast[u8](c), checked_cast[i8](c))
print(saturating_cast[u8](n), saturating_cast[u8](-5), saturating_cast[u8](7), saturating_cast[i8](-1000), saturating_cast[i8](1000))
print(saturating_cast[u64](-3), saturating_cast[int](u), saturating_cast[i32](small), saturating_cast[u32](u), saturating_cast[i16](u64(5)))
total = 0
loop k in [1..25]: total = checked_mul(total + 1, k) ?? -1
print(total)
if let p = checked_mul(1 << 40, 1 << 20): print(p)
