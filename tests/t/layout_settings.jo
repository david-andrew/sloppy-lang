# requires: sloppy
# requires: native
# A settings-screen fixture for the designer: SLOPPY_WINDOW=1280x720 or 390x844.
# env: SLOPPY_SCREENSHOT=$TMP/layout_settings.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=3
# env: SLOPPY_INPUT=1:right+ 2:right-
import layout as ui
window("Settings", 1280, 720)
screen_fit(.native)
volume = 0.65
music = 0.4
hints = true
fullscreen = false
level = 1
name = "Player One"
settings = ():
    global volume, music, hints, fullscreen, level, name
    ui.label("Sound & play", size = 24)
    volume = ui.slider(volume, 0.0, 1.0, 0.05, "Volume", height = 44, key = "volume")
    music = ui.slider(music, 0.0, 1.0, 0.05, "Music", height = 44, key = "music")
    hints = ui.switch(hints, "Show hints", height = 44, key = "hints")
    fullscreen = ui.switch(fullscreen, "Fullscreen", height = 44, key = "fullscreen")
    level = ui.choice(["Easy", "Normal", "Hard"], level, "Difficulty", height = 44, key = "level")
profile_settings = ():
    global name
    ui.label("Player", size = 24)
    ui.label("Display name", size = 16, color = hud_style.muted)
    name = ui.text_field(name, "Your name", max_chars = 24, height = 44, key = "name")
    ui.label("Your name appears in the lobby and on the scoreboard.", size = 16, color = hud_style.muted, wrap = true, width = ui.grow())
    ui.switch(false, "Voice chat", height = 44, enabled = false, key = "voice")
    ui.choice(["Automatic"], 0, "Region", height = 44, enabled = false, key = "region")
draw = ():
    clear(rgb(0.035, 0.045, 0.06))
    narrow = screen_width() < 700
    ui.screen(pad = if narrow: 20 else: 40, gap = 18, ():
        ui.label("Settings", size = 32)
        ui.label("Changes take effect when applied.", size = 16, color = hud_style.muted)
        ui.scroll(width = ui.grow(), height = ui.grow(), gap = 16, pad = 6, ():
            if narrow:
                ui.panel(width = ui.grow(), gap = 12, key = "play", (): settings())
                ui.panel(width = ui.grow(), gap = 12, key = "profile", (): profile_settings())
            else:
                ui.row(width = ui.grow(), gap = 24, ():
                    ui.panel(width = ui.grow(), gap = 12, key = "play", (): settings())
                    ui.panel(width = ui.grow(), gap = 12, key = "profile", (): profile_settings())
                )
        )
        ui.label("↑ ↓ Move   ← → Adjust   Tab / LB RB Next", size = if narrow: 13 else: 16, color = hud_style.muted)
        ui.row(width = ui.grow(), gap = 12, ():
            ui.button("Back", width = ui.grow(max = 180), key = "back")
            ui.button("Apply", width = ui.grow(max = 180), key = "apply")
        )
    )
    if frame_number() == 2: print("settings screen rendered")
