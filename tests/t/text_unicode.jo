# requires: sloppy
# text past ASCII: widths count characters, case changes know accented, Greek and Cyrillic
# letters, \w and \b take letters of any script
print("[{"Zürich":<8}] [{"東京":>4}] [{"é":^5}]")
print("[" + pad_start("ñ", 3) + "] [" + pad_end("ŁÓDŹ", 6, ".") + "]")
print(upper("Zürich café ÿ łódź"), lower("ÜNÏ ΑΒΓ ДОМ"), upper("straße"))
print(capitalize("élan vital"), capitalize("ßx"), capitalize(""))
print("Zürich ist schön".find_all(regex(r"\w+")).map((m): m.text))
print("naïve café".replace(regex(r"\bcafé\b"), "bar"))
print(["a\r", "tab\there", "esc\x1b[0m", "\0"])
