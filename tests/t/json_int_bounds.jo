# requires: sloppy
loop n in [1.5, -1.5, 1e100, -1e100, 9223372036854775808.0, -9223372036854775808.0, 9223372036854774784.0, -9223372036854777856.0]:
    print(Json.number(n).as_int())
loop s in ["NaN", "Infinity", "-Infinity"]: print(parse_json(s).unwrap().as_int())
print(Json.integer(9223372036854775807).as_int())
print(Json.integer(-9223372036854775808).as_int())
