# requires: sloppy
j = parse_json(r'{"a":{"b":1},"list":[1,2],"gone":true}').unwrap()
copy = j
j.set("new", "yes")
j.set_path(["a", "b"], 3)
j.push_path(["list"], 4)
j.set_path(["list", 0], false)
print(j)
print(copy)
print(j.remove("gone"), j.remove("gone"))
print(j.get("a").get("b").as_int()!, j.get("list").at(2).as_int()!)
j.set_path(["list", 1], {"tags": []})
j.push_path(["list", 1, "tags"], "ok")
print(j.remove_path(["a", "b"]), j.remove_path(["a", "missing"]))
print(j)
xs: Json = []
xs.push(7)
xs.set(0, "changed")
print(xs)
xs.set_path([], {"replaced": true})
print(xs)
