# requires: sloppy
# A logical shift right in GLSL is masked after it: Adreno 650 under ANGLE shifts a uint made from a
# negative int arithmetically (its sign bit comes in), so a hash of a negative cell came out wrong
struct SmV:
    pos: vec2
struct SmU:
    k: f32
struct SmO:
    pos: vec4
    h: f32
sm_hash = (x: int) -> f32:
    h = x * 2376512323
    h = (h xor (u32(h) >> 15)) * 2146121005
    f32(h & 16777215) / 16777216.0
sm_vs = (v: SmV, u: SmU) -> SmO: SmO(vec4(v.pos, 0, 1), sm_hash(int(floor(v.pos.x * -300.0))))
sm_fs = (i: SmO, u: SmU) -> vec4: vec4(i.h, 0, 0, 1)
src = shader(sm_vs, sm_fs)
loop l in split(src.vs, "\n"):
    if "0xFFFFFFFFu" in l or ">>" in l: print(trim(l))
# the CPU's value, which the GPU's must equal
print(sm_hash(-304))
