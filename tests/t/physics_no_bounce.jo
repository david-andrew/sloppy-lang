# requires: sloppy
# bounce = 0 does not rebound: the speed that pushed overlap out is taken back (the relax pass)
import physics
loop sp in [400, 800, 1200]:
    w = physics.World()
    w.gravity = vec2(0, 0)
    w.add_box(vec2(1000, 400), vec2(10, 600), kind = .fixed)
    b = w.add_circle(vec2(800, 400), 10)
    w.set_velocity(b, vec2(f32(sp), 0))
    loop f in [0..60): w.step(1.0 / 60.0)
    print(sp, w.velocity(b))
