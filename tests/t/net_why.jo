# requires: native
# requires: sloppy
# net.why: why a connection failed (a name not found; nothing listening)
import net
a = net.connect("nosuch.invalid", 4600)
b = net.connect("127.0.0.1", 1)
t = time()
left = 0
loop left < 2 and time() - t < 5.0:
    loop e in net.receive():
        if e.kind == .left:
            print(e.peer, net.why(e.peer))
            left += 1
    sleep(0.01)
