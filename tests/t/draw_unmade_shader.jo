# requires: native
# requires: sloppy
# A draw with a Shader never made (a global of that type not yet given make_shader's result)
# panics, saying so: every renderer would otherwise draw nothing, and what shows is whatever lies
# under it (Aegean Skies' island drawn white and flat: its ground's shader was made only on another
# path, so the ground was never drawn and the sea-level layers showed instead).
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
struct V:
    pos: vec2
struct I:
    at: vec2
struct U:
    k: f32
struct O:
    pos: vec4
vs = (v: V, inst: I, u: U) -> O: O(vec4(v.pos + inst.at, 0, 1))
fs = (i: O, u: U) -> vec4: vec4(1, 1, 1, 1)
made = make_shader(shader(vs, fs))
later: Shader
tri = mesh([V(vec2(-1, -1)), V(vec2(1, -1)), V(vec2(0, 1))])
draw = ():
    draw_instanced(made, tri, [I(vec2(0, 0))], U(1))
    print("a made shader draws")
    draw_instanced(later, tri, [I(vec2(0, 0))], U(1))
    print("not reached")
