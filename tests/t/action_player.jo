# requires: native
# requires: sloppy
# actions declared for a player: their keys are that player's, their buttons that player's
# gamepad's; a shared action's keys are player 0's. SLOPPY_INPUT's pad1_ items are gamepad 1's
# env: SLOPPY_SCREENSHOT=$TMP/action_player.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=8
# env: SLOPPY_INPUT=2:left+,3:left-,4:pad1_left+,5:pad1_left-,6:pad_left+,7:pad1_lstick=-1x0
action("p1 left", [.key(.a), .button(.left), .stick(0, -1)], player = 0)
action("p2 left", [.key(.left), .button(.left), .stick(0, -1)], player = 1)
action("left", [.key(.left), .button(.left)])
update = (dt: f64):
    f = frame_number()
    if f >= 2: print("{f}: p1 {action_down("p1 left")} p2 {action_down("p2 left")} p2 as player 0 {action_down("p2 left", 0)} shared {action_down("left", 0)} {action_down("left", 1)}; pressed p2 {action_pressed("p2 left")}")
draw = (): clear(BLACK)
