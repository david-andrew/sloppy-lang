# requires: sloppy
# No window: solve real trees, inspect their boxes, and run draw-time slots.
import layout as ui

near = (a: f64, b: f64): assert(abs(a - b) < 0.002, "{a} != {b}")
box = (key: str, x: f64, y: f64, w: f64, h: f64):
    r = ui.bounds(key)!
    near(f64(r.x), x)
    near(f64(r.y), y)
    near(f64(r.w), w)
    near(f64(r.h), h)

ui.at(Rect(10, 20, 300, 200), render = false, pad = ui.insets(1, 2, 3, 4), ():
    ui.column(gap = 5, key = "col", ():
        ui.row(pad = 10, gap = 7, key = "row", ():
            ui.space(width = 30, height = 20, key = "a")
            ui.space(width = 40, height = 10, key = "b")
        )
        ui.space(width = 10, height = 15)
    )
)
box("col", 11, 22, 97, 60)
box("row", 11, 22, 97, 40)
box("a", 21, 32, 30, 20)
box("b", 58, 32, 40, 10)

ui.at(Rect(0, 0, 300, 200), render = false, ():
    ui.row(width = ui.grow(), gap = 10, ():
        ui.space(width = ui.grow(), height = 20, key = "a")
        ui.space(width = ui.grow(weight = 2), height = 30, key = "b")
    )
)
box("a", 0, 0, 290.0 / 3.0, 20)
box("b", 290.0 / 3.0 + 10, 0, 580.0 / 3.0, 30)

ui.at(Rect(0, 0, 300, 200), render = false, ():
    ui.row(width = ui.grow(), ():
        ui.space(width = ui.grow(max = 50), height = 20, key = "a")
        ui.space(width = ui.grow(min = 100), height = 20, key = "b")
        ui.space(width = ui.grow(), height = 20, key = "c")
    )
)
box("a", 0, 0, 50, 20)
box("b", 50, 0, 125, 20)
box("c", 175, 0, 125, 20)

# Height pass, competing min/max bounds, and redistribution after a maximum clamps.
ui.at(Rect(0, 0, 100, 300), render = false, ():
    ui.column(width = ui.grow(), height = ui.grow(), pad = 10, gap = 10, ():
        ui.space(width = ui.percent(0.5), height = ui.grow(min = 200), key = "a")
        ui.space(width = ui.grow(), height = ui.grow(max = 50), key = "b")
    )
)
box("a", 10, 10, 40, 220)
box("b", 10, 240, 80, 50)

ui.at(Rect(0, 0, 400, 300), render = false, pad = 10, ():
    ui.row(width = ui.grow(), height = ui.grow(), gap = 5, ():
        ui.space(width = ui.percent(0.25), height = ui.percent(0.5), key = "a")
        ui.space(width = ui.fixed(30), height = 12, key = "b")
        ui.space(width = ui.grow(), height = ui.grow(), key = "c")
    )
)
box("a", 10, 10, 95, 140)
box("b", 110, 10, 30, 12)
box("c", 145, 10, 245, 280)

# Every main/cross alignment, including stretch restricted to fit/grow sizes.
loop alignment in [ui.MainAlign.start, .center, .end, .space_between]:
    ui.at(Rect(0, 0, 100, 80), render = false, ():
        ui.row(width = 100, height = 80, align = alignment, cross = .center, ():
            ui.space(width = 20, height = 10, key = "a")
            ui.space(width = 20, height = 20, key = "b")
        )
    )
    left = if alignment == .center: 30.0 else if alignment == .end: 60.0 else: 0.0
    second = if alignment == .space_between: 80.0 else: left + 20.0
    box("a", left, 35, 20, 10)
    box("b", second, 30, 20, 20)
loop cross in [ui.CrossAlign.start, .center, .end, .stretch]:
    ui.at(Rect(0, 0, 100, 80), render = false, ():
        ui.column(width = 100, height = 80, cross = cross, ():
            ui.space(width = ui.fit(min = 20), height = 10, key = "a")
        )
    )
    left = if cross == .center: 40.0 else if cross == .end: 80.0 else: 0.0
    width = if cross == .stretch: 100.0 else: 20.0
    box("a", left, 0, width, 10)

# Largest first, with floors: a 100/60/20 row shrinks to 60/60/20.
ui.at(Rect(0, 0, 140, 80), render = false, ():
    ui.row(width = ui.grow(), ():
        ui.button("abcdefghijklmnop", width = ui.fit(max = 100), height = 20, key = "a")
        ui.button("abcdefgh", width = ui.fit(max = 60), height = 20, key = "b")
        ui.space(width = 20, height = 10, key = "c")
    )
)
box("a", 0, 0, 60, 20)
box("b", 60, 0, 60, 20)
box("c", 120, 0, 20, 10)
ui.at(Rect(0, 0, 140, 80), render = false, ():
    ui.row(width = ui.grow(), ():
        ui.button("abcdefghijklmnop", width = ui.fit(min = 90, max = 100), height = 20, key = "a")
        ui.button("abcdefgh", width = ui.fit(max = 60), height = 20, key = "b")
        ui.space(width = 20, height = 10)
    )
)
box("a", 0, 0, 90, 20)
box("b", 90, 0, 30, 20)
ui.at(Rect(0, 0, 140, 80), render = false, ():
    ui.row(width = ui.grow(), ():
        ui.space(width = ui.fit(min = 100), height = 10, key = "a")
        ui.space(width = ui.fit(min = 60), height = 10, key = "b")
        ui.space(width = 20, height = 10, key = "c")
    )
)
# Unshrinkable minima overflow; fixed boxes do not collapse.
box("a", 0, 0, 100, 10)
box("b", 100, 0, 60, 10)
box("c", 160, 0, 20, 10)

message = "one two three four five six seven"
wide = text_width(message, 20)
word = text_width("seven", 20)
ui.at(Rect(0, 0, wide + 20, 500), render = false, ():
    ui.column(pad = 10, width = ui.grow(), key = "col", ():
        ui.label(message, size = 20, wrap = true, key = "text")
    )
)
one_h = ui.bounds("text")!.h
ui.at(Rect(0, 0, word + 20, 500), render = false, ():
    ui.column(pad = 10, width = ui.grow(), key = "col", ():
        ui.label(message, size = 20, wrap = true, key = "text")
    )
)
assert(ui.bounds("text")!.h > one_h)
near(f64(ui.bounds("text")!.w), word)
near(f64(ui.bounds("col")!.h), f64(ui.bounds("text")!.h) + 20)

# A fixed sibling takes room from a wrapping label down to its longest word.
ui.at(Rect(0, 0, 150, 500), render = false, ():
    ui.row(width = 150, ():
        ui.label("a a a a a a a a a a a a a a a a", wrap = true, key = "a")
        ui.space(width = 60, height = 10, key = "b")
    )
)
near(f64(ui.bounds("a")!.w), 90)
near(f64(ui.bounds("b")!.x), 90)

# A slot sees its final box on the same call and changes a captured local.
capture_slot = () -> f64:
    captured = 0.0
    ui.at(Rect(0, 0, 200, 80), render = false, ():
        ui.slot(width = ui.grow(), height = 32, (r: Rect): captured = f64(r.w))
    )
    captured
near(capture_slot(), 200)

# A 2000-element description exercises the reused buffers on several frames.
loop frame in [0..3):
    ui.at(Rect(0, 0, 1000, 1000), render = false, cross = .stretch, ():
        loop row in [0..40):
            ui.row(width = ui.grow(), height = 20, ():
                loop col in [0..50): ui.space(width = ui.grow(), height = 10)
            )
    )
print("layout solver ok")
