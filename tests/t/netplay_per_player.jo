# requires: sloppy
# a server that sends each player its own part of the world (per_player), and worlds as plain text
# (compress = false)
import netplay
struct Pad:
    dx = 0
struct World:
    pos: {int: int}
apply = (w: World, p: int, pad: Pad, seen: World) -> World:
    out = w
    out.pos[p] += pad.dx
    out
srv = netplay.server(World(), apply, (w: World): w)
# (each player sees only those within 10 of them)
srv.per_player((w: World, p: int) -> World:
    near = World()
    loop q, x in w.pos:
        if abs(x - w.pos[p]) <= 10: near.pos[q] = x
    near)
a = netplay.client(World(), apply)
b = netplay.client(World(), apply)
srv.join(1)
srv.join(2)
srv.world.pos[1] = 0
srv.world.pos[2] = 50
srv.world.pos[3] = 5
loop k in [0..4):
    srv.update()
    loop o in srv.outgoing():
        if o.0 == 1: a.receive(o.1)
        else: b.receive(o.1)
print(a.server.pos, b.server.pos)
srv.compress = false
srv.world.pos[2] = 8
srv.update()
srv.update()
plain = false
loop o in srv.outgoing():
    if o.1[0] == 4: plain = true
    if o.0 == 1: a.receive(o.1)
    else: b.receive(o.1)
print(plain, a.server.pos, b.server.pos)
