# requires: sloppy
# read_args and parse_args: a command line's options into a struct, mistakes said, --help (with
# the fields' comments)
enum Mode: fast, slow
struct Options:
    verbose = false         # say each file's name
    # where the counts go
    out = "report.txt"
    host = "localhost"      # the server to ask (-H: -h is help)
    jobs = 4
    scale = 1.5
    mode = Mode.fast
    dry_run = false
    tag: str? = none
    files: str[]            # the files to count

try = (ws: str[]):
    r = read_args[Options](ws)
    if r is str: print("error: {r}")
    else: print(r)

try(["-v", "a.txt", "--jobs", "8", "b.txt"])
try(["--out=x.txt", "--dry-run", "--mode", "slow", "--tag", "hi there", "--scale", "-2.5"])
try(["-j8", "-o", "o.txt", "--", "--not-an-option", "-5"])
try(["--jobs", "many"])
try(["--jobs"])
try(["--color"])
try(["-x"])
try(["--mode", "medium"])
try(["--verbose=yes"])
try(["--no-verbose", "--no-dry-run"])
try(["-vd"])
try(["-H", "example.com"])
print(args_help[Options]("count.jo", "count lines in files"))
opts = parse_args[Options]("count lines in files")
print(opts.files)
