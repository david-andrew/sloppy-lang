# requires: sloppy
# A rejected longer overload must not constrain an empty array used by the valid one.
probe[T] = (value: T, label: str, other: T) -> int: 0
probe = (words: str[], numbers: int[]) -> int: words.len() + numbers.len()
words = []
print(probe(words, [1]))
words.push("ok")
print(words)
