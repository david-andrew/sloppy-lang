# requires: sloppy
# Conditions on match arms, `if let` and `loop let` on a variant, and `x is .variant`: an
# expression simplifier over a syntax tree that holds itself
enum Expr:
    num(v: f64)
    var(name: str)
    neg(e: Expr)
    bin(op: str, l: Expr, r: Expr)

show = (e: Expr) -> str:
    match e:
        .num(v): "{v}"
        .var(name): name
        .neg(a): "-{show(a)}"
        .bin(op, l, r): "({show(l)} {op} {show(r)})"

num_of = (e: Expr) -> f64?:
    if let .num(v) = e: return v
    none

# one step at a time, from the leaves up
simplify = (e: Expr) -> Expr:
    match e:
        .bin(op, l, r):
            a = simplify(l)
            b = simplify(r)
            fold(op, a, b)
        .neg(a):
            x = simplify(a)
            if let .num(v) = x: return Expr.num(-v)
            else if let .neg(inner) = x: return inner
            Expr.neg(x)
        _: e

fold = (op: str, a: Expr, b: Expr) -> Expr:
    x = num_of(a)
    y = num_of(b)
    match op:
        "+" if x != none and y != none: Expr.num(x! + y!)
        "*" if x != none and y != none: Expr.num(x! * y!)
        "+" if x == 0.0: b
        "+", "-" if y == 0.0: a
        "*" if x == 1.0: b
        "*" if y == 1.0: a
        "*" if x == 0.0 or y == 0.0: Expr.num(0)
        "-" if a == b: Expr.num(0)
        _: Expr.bin(op, a, b)

base = alloc_count()
vx = Expr.var("x")
cases = [
    Expr.bin("+", Expr.num(1), Expr.num(2)),
    Expr.bin("*", Expr.bin("+", Expr.num(0), vx), Expr.num(1)),
    Expr.bin("-", Expr.bin("*", vx, Expr.num(3)), Expr.bin("*", vx, Expr.num(3))),
    Expr.neg(Expr.neg(Expr.bin("*", Expr.num(0), vx))),
    Expr.neg(Expr.bin("+", vx, Expr.num(0))),
    Expr.bin("/", vx, Expr.bin("*", Expr.num(2), Expr.num(4))),
]
loop c in cases: print(show(c), "=>", show(simplify(c)))

# x is .variant, without naming the fields
loop c in cases:
    s = simplify(c)
    kind = if s is .num: "a number" else if s is not .bin: "not an operation" else: "an operation"
    print(show(s), "is", kind)

# a condition on the names a variant arm binds, and arms tried in order after one fails
classify = (e: Expr) -> str:
    match e:
        .bin(op, l, r) if l == r: "{op} of two equal sides"
        .bin(op, l, _) if l is .num: "{op} with a number on the left"
        .bin(op, _, _): "an operation {op}"
        .num(v) if v < 0: "a negative number"
        .num(_): "a number"
        _: "something else"
print(classify(Expr.bin("*", vx, vx)))
print(classify(Expr.bin("-", Expr.num(1), vx)))
print(classify(Expr.bin("-", vx, Expr.num(1))))
print(classify(Expr.num(-2)))
print(classify(Expr.num(2)))
print(classify(vx))

# if let with a condition on what it names, and else
loop c in [Expr.bin("+", vx, vx), Expr.bin("*", vx, vx), Expr.num(5)]:
    if let .bin(op, l, r) = c and op == "+": print("a sum of", show(l), "and", show(r))
    else: print("not a sum:", show(c))

# as an expression
depth = (e: Expr) -> int:
    if let .bin(_, l, r) = e: 1 + max(depth(l), depth(r)) else: 0
print(depth(cases[1]), depth(cases[5]), depth(vx))

# loop let: round again while the value is that variant
enum List:
    empty
    cons(head: int, tail: List)
list = List.empty
loop i in [1..5]: list = List.cons(i * i, list)
total = 0
loop let .cons(head, tail) = list:
    total += head
    list = tail
print(total, list is .empty)

# in a comprehension
names = [loop c in [vx, Expr.num(1), Expr.var("y")]: if let .var(n) = c: n]
print(names)

# guards on other arms: numbers, bools, union members (narrowed in the condition and the arm)
size = (n: int) -> str:
    match n:
        0: "zero"
        _ if n < 0: "negative"
        1..10 if n % 2 == 0: "small and even"
        1..10: "small"
        _: "big"
loop n in [0, -3, 4, 5, 12]: print(n, size(n))

describe = (v: int | str | f64) -> str:
    match v:
        int if v < 0: "a negative int {v}"
        f64 if v == 0.0: "zero"
        int: "the int {v + 1}"
        str if v.len() > 3: "long text {v.upper()}"
        _: "{v}"
vs: (int | str | f64)[] = [-2, 0, 7, "hello", "hi", 0.0, 1.5]
loop v in vs: print(describe(v))

flag = (b: bool, strict: bool) -> str:
    match b:
        true if strict: "yes, strictly"
        true: "yes"
        false: "no"
print(flag(true, true), flag(true, false), flag(false, true))

enum Light: red, amber, green
lights = [Light.red, Light.green, Light.amber]
loop l in lights:
    late = l != .red
    match l:
        .red: print("stop")
        .amber if late: print("hurry")
        _: print("go")
    print(l is .green, l is not .red)

cases = []
names = []
vs = []
lights = []
vx = Expr.num(0)
print(alloc_count() - base)
