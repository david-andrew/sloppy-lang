# requires: sloppy
# Contraction changes these products around one. Compare exact f32 bits, not formatting.
@noinline
rounding = (a: vec4[], b: vec4[], c: vec4[], out: mut vec4[]):
    loop i in [0..out.len()): out[i] = a[i] * b[i] + c[i]
@noinline
negate = (a: vec4[], out: mut vec4[]):
    loop i in [0..out.len()): out[i] = vec4(-a[i].x, -a[i].y, -a[i].z, -a[i].w)
@noinline
bits = (vs: vec4[]):
    loop v in vs: print(f32_bits(v.x), f32_bits(v.y), f32_bits(v.z), f32_bits(v.w))

main = ():
    up = f32_from_bits(0x3f800001)
    down = f32_from_bits(0x3f7fffff)
    a = [vec4(up, -up, down, -down)]
    b = [vec4(down, down, up, up)]
    c = [vec4(-1, 1, -1, 1)]
    out = [vec4()]
    rounding(a, b, c, out)
    bits(out)
    m = mat4(vec4(up, -up, down, -down), vec4(-1, 1, -1, 1), vec4(), vec4())
    bits([m * vec4(down, 1, 0, 0)])
    # Conditional min/max and abs must select the original NaN bits, including sign,
    # and choose the second operand's zero on ties. Signaling NaNs are never arithmetic.
    nan = f32_from_bits(0xffc12345)
    snan = f32_from_bits(0x7f812345)
    nz = f32_from_bits(0x80000000)
    specials = [vec4(nan, snan, nz, 0)]
    negate(specials, out)
    bits(out)
    bits([min(specials[0], vec4(1, 2, 0, nz))])
    bits([max(vec4(1, 2, 0, nz), specials[0])])
    bits([abs(specials[0])])

main()
