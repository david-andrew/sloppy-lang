# requires: sloppy
# bools to floats (a mask as 0.0 and 1.0), T[,] as a type argument, rows M[i, ..] of a
# comprehension where a T[][] is expected, and the matrix product of two arrays of one shape
mask = [1.0, -2.0, 3.0] .> 0.0
print(f64(true), f64(false), f32(true), f64.(mask), sum(f64.(mask)), int(true))
grid = [1.0, -2.0; 3.0, 4.0] .> 0.0
print(f64.(grid))
r = from_json[f64[,]]("[[1, 2], [3, 4]]")
print(r, from_text[int[,,]]("[[1 2;], [3 4;]]"))
M = reshape([loop i in 0..9: f64(i)], 3, 3)
rs: f64[][] = [loop i in 0..3: M[i, ..]]
cs: f64[][] = [loop j in 0..3: M[.., j]]
print(rs, cs)
X = ones(3, 4)
print(X * transpose(X))
print(X * X)
