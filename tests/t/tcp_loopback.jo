# requires: sloppy
# requires: native
# TCP over loopback: listen, connect, accept, text and a bigger block both ways, the other side
# closing, and a port nothing listens on
import net
s = net.tcp_listen(18766)
c = net.tcp_connect("127.0.0.1", 18766)
a = net.tcp_accept(s, wait = 1.0)
print(s >= 0, c >= 0, a >= 0)
net.tcp_send(c, "hello over tcp")
got = net.tcp_receive(a, wait = 1.0)
print(str_from_bytes(got))
big = fill(u8(7), 200000)
print(net.tcp_send(a, big))
total = 0
loop total < big.len(): total += net.tcp_receive(c, wait = 1.0).len()
print(total)
net.tcp_close(a)
rest = net.tcp_receive(c, wait = 1.0)
print(rest.len(), net.tcp_closed(c))
print(net.tcp_connect("127.0.0.1", 1, timeout = 0.5))
