# requires: sloppy
# smooth paths: a spline through a square's corners, its length, where a point is nearest, and points along it
sq = [vec2(0, 0), vec2(10, 0), vec2(10, 10), vec2(0, 10)]
print(spline(sq, 0.0, closed = true), spline(sq, 0.25, closed = true), spline(sq, 0.125, closed = true))
pts = spline_points(sq, per_segment = 4, closed = true)
print(pts.len(), path_length(sq, closed = true), path_length(sq))
d, at = nearest_on_path(sq, vec2(5, -3), closed = true)
print(d, at)
d2, at2 = nearest_on_path(sq, vec2(-2, 5), closed = true)
print(d2, at2)
print(point_along(sq, 25.0, closed = true), point_along(sq, 45.0, closed = true), point_along(sq, 99.0))
p3 = [vec3(0, 0, 0), vec3(0, 0, 10), vec3(10, 0, 10)]
print(spline(p3, 0.5), nearest_on_path(p3, vec3(1, 5, 4)).0)
