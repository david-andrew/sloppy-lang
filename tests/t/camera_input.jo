# requires: sloppy
# requires: native
# Mouse drag, right stick and zoom: invert each look axis, or follow without input.
# env: SLOPPY_SCREENSHOT=$TMP/camera_input.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=6
# env: SLOPPY_INPUT=2:mouse=20x20 2:mouse_right+ 3:mouse=30x25 3:wheel=1 4:rstick=0.5x0.25 4:lstick=0x0.5
window("Camera input", 64, 64)
check = (dt: f64):
    base = follow_camera(pitch = 0.0)
    ix = base
    iy = base
    ix.invert_x = true
    iy.invert_y = true
    frozen = base
    update(base, vec3(0, 0, 0), dt)
    update(ix, vec3(0, 0, 0), dt)
    update(iy, vec3(0, 0, 0), dt)
    update(frozen, vec3(2, 0, 0), dt, input = false)
    assert(abs(ix.yaw + base.yaw) < 0.00001 and ix.pitch == base.pitch)
    assert(abs(iy.pitch + base.pitch) < 0.00001 and iy.yaw == base.yaw)
    assert(ix.distance == base.distance and iy.distance == base.distance)
    assert(frozen.yaw == 0.0 and frozen.pitch == 0.0 and frozen.distance == 6.0)
    assert(aim(frozen).x == 2.0)
    update(frozen, vec3(4, 0, 0), dt, heading = 1.0, input = false)
    assert(frozen.yaw > 0.0 and frozen.yaw < 1.0)
    assert(aim(frozen).x > 2.0 and aim(frozen).x < 4.0)
    pull_in(frozen, 0.5)
    update(frozen, vec3(4, 0, 0), dt, input = false)
    update(frozen, vec3(4, 0, 0), dt, input = false)
    assert(frozen.shown_reach > 0.5 and frozen.shown_reach < 1.0)
    o = orbit_camera(pitch = 0.0)
    ox = o
    oy = o
    ox.invert_x = true
    oy.invert_y = true
    held = o
    held.yaw = 1.0
    held.pitch = 0.5
    held.distance = 12.0
    update(o, dt)
    update(ox, dt)
    update(oy, dt)
    update(held, dt, input = false)
    assert(abs(ox.yaw + o.yaw) < 0.00001 and ox.pitch == o.pitch)
    assert(abs(oy.pitch + o.pitch) < 0.00001 and oy.yaw == o.yaw)
    assert(held.yaw == 1.0 and held.pitch == 0.5 and held.distance == 12.0)
    assert(held.shown_yaw > 0.0 and held.shown_yaw < 1.0)
    assert(held.shown_pitch > 0.0 and held.shown_pitch < 0.5)
    assert(held.shown_distance > 10.0 and held.shown_distance < 12.0)
    assert(abs(base.yaw) > 0.0 and abs(base.pitch) > 0.0)
    assert(abs(o.yaw) > 0.0 and abs(o.pitch) > 0.0)
    assert(base.yaw < 0.0 and base.pitch > 0.0)
    if frame_number() == 3: assert(o.yaw < 0.0 and o.pitch > 0.0)
    else: assert(o.yaw < 0.0 and o.pitch < 0.0)
    print("camera input {frame_number()} ok")
update = (dt: f64):
    if frame_number() == 3 or frame_number() == 4: check(dt)
draw = (): clear(BLACK)
