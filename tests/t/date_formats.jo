# requires: sloppy
# env: TZ=UTC0
# All fixed moments and explicit offsets; local paths use the test's TZ=UTC0.
d = parse_date("29/02/2024 11:05:07 PM +0530", "%d/%m/%Y %I:%M:%S %p %z")!
print(date_text(d), d.offset, date_text(date(unix_time(d), utc = true)))
print(date_text(d, "%a %A %b %B %j %u %w %% %F %T %R %z %Z"))
print(date_text(parse_date("Thu Feb 29 2024", "%a %b %d %Y", utc = true)!))
print(date_text(parse_date("2024-02-29 23:05 Z", "%F %R %z", utc = true)!, "%F %T %Z"))
print(date_text(parse_date("68-01-02", "%y-%m-%d", utc = true)!), date_text(parse_date("69-01-02", "%y-%m-%d", utc = true)!))
local_d = parse_date("2024-02-29", "%F")!
print(local_d.offset == utc_offset(int(unix_time(local_d))))
loop s in ["2024-02-30", "2023-02-29", "2024-13-01", "2024-01-01extra"]: print(parse_date(s, "%F", utc = true) == none)
print(parse_date("2024", "%Q", utc = true) == none, parse_date("2024", "%", utc = true) == none)
print(parse_date("2024-02-29T12:00:00.Z") == none, parse_date("2024-02-29T12:00+02:") == none)
print(parse_date("Fri Feb 29 2024", "%a %b %d %Y", utc = true) == none)
print(parse_date("00 AM", "%I %p", utc = true) == none, parse_date("13 PM", "%I %p", utc = true) == none)
print(parse_date("+2460", "%z", utc = true) == none)
a = parse_date("2024-02-29T23:00:00+02:00")!
b = date_add(a, 5400.0)
print(date_text(b), b.offset, date_diff(b, a), date_diff(a, b))
print(date_text(date_add(a, -86400.0)), unix_time(date_add(a, 5400.0, local = true)) == unix_time(b))
print(date_diff(a, parse_date("2024-02-29T21:00:00Z")!))
loop s in [0.0, 5400.0, 172803.0, -65.0, 0.9]: print(duration_text(s))
print(date_text(parse_date("2024-060 UTC 4", "%Y-%j %Z %u")!))
print(parse_date("2023-366", "%Y-%j", utc = true) == none)
print(date_text(parse_date("%F 2024-03-01", "%%F %F", utc = true)!, "%%F %F"))
