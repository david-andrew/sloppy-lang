# requires: sloppy
# requires: native
# open_file and read_line: a file read a piece at a time (Windows line ends, a last line
# without its end), read_bytes, and none for a missing file or a directory
p = join_path(temp_dir(), "sloppy_file_stream_test.txt")
write_file(p, "one\r\ntwo\n\nlast")
if let f = open_file(p):
    loop let line = f.read_line(): print("[{line}]")
    print(f.read_line() == none)
    f.close()
if let f = open_file(p):
    print(str_from_bytes(f.read_bytes(3)), f.read_line() ?? "?", f.read_bytes(4).len())
    f.close()
big = "x" * 100000
write_file(p, "{big}\nshort\n")
if let f = open_file(p):
    print(len(f.read_line() ?? ""), f.read_line() ?? "?", f.read_line() == none)
    f.close()
print(open_file(join_path(temp_dir(), "sloppy_no_such_file")) == none, open_file(temp_dir()) == none)
delete_file(p)
