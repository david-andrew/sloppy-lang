# requires: sloppy
# env: SLOPPY_THREADS=4
# More distinct bodies than the specialization budget: fallback stays correct.
main = ():
    assert(parallel_range(3, (i): i + 0) == [0, 1, 2])
    assert(parallel_range(3, (i): i + 1) == [1, 2, 3])
    assert(parallel_range(3, (i): i + 2) == [2, 3, 4])
    assert(parallel_range(3, (i): i + 3) == [3, 4, 5])
    assert(parallel_range(3, (i): i + 4) == [4, 5, 6])
    assert(parallel_range(3, (i): i + 5) == [5, 6, 7])
    assert(parallel_range(3, (i): i + 6) == [6, 7, 8])
    assert(parallel_range(3, (i): i + 7) == [7, 8, 9])
    assert(parallel_range(3, (i): i + 8) == [8, 9, 10])
    assert(parallel_range(3, (i): i + 9) == [9, 10, 11])
    assert(parallel_range(3, (i): i + 10) == [10, 11, 12])
    assert(parallel_range(3, (i): i + 11) == [11, 12, 13])
    assert(parallel_range(3, (i): i + 12) == [12, 13, 14])
    assert(parallel_range(3, (i): i + 13) == [13, 14, 15])
    assert(parallel_range(3, (i): i + 14) == [14, 15, 16])
    assert(parallel_range(3, (i): i + 15) == [15, 16, 17])
    assert(parallel_range(3, (i): i + 16) == [16, 17, 18])
    assert(parallel_range(3, (i): i + 17) == [17, 18, 19])
    assert(parallel_range(3, (i): i + 18) == [18, 19, 20])
    assert(parallel_range(3, (i): i + 19) == [19, 20, 21])
    print("parallel budget ok")
