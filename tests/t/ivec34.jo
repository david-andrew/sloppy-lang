# ivec3 and ivec4: i32 vectors as ivec2 is (arithmetic by component, swizzles, conversions from
# float vectors, map keys), and compute functions over a 3D grid
# requires: sloppy
a = ivec3(i32(1), i32(-2), i32(3))
b = ivec3(i32(10), i32(20), i32(30))
print(a, a + b, a - b, a * b, b / a, -a, a * i32(4), a == ivec3(i32(1), i32(-2), i32(3)))
c = ivec4(i32(1), i32(2), i32(3), i32(4))
print(c.wzyx, c.xyz, a.zx, ivec3(vec3(1.5, -2.7, 3e10)), vec3(a), c.w)
a.zx = ivec2(i32(7), i32(8))
a.y += i32(100)
print(a)
m: {ivec3: int} = {}
m[a] = 5
print(m[a], m.get(ivec3(i32(0), i32(0), i32(0))))

struct Vol:
    cells: GpuBuffer[i32]
    w: int
    h: int
    hits: GpuBuffer[u32]
fill3 = (id: ivec3, u: Vol):
    atomic_add(u.hits, 0, u32(1))
    u.cells[(int(id.z) * u.h + int(id.y)) * u.w + int(id.x)] = id.x + id.y * i32(100) + id.z * i32(10000)
w = 5
h = 6
d = 7
v = Vol(gpu_buffer[i32](w * h * d + 1), w, h, gpu_buffer[u32](1))
dispatch(compute(fill3), ivec3(i32(w), i32(h), i32(d)), v)
cs = cpu(v.cells)
ok = true
loop z in [0..d):
    loop y in [0..h):
        loop x in [0..w):
            if cs[(z * h + y) * w + x] != i32(x + y * 100 + z * 10000): ok = false
print(ok, cs[w * h * d], cpu(v.hits)[0], cs[(6 * h + 5) * w + 4])
