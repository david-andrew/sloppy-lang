# requires: native
# requires: sloppy
# hud_scroll_to and hud_scroll_reveal move a list by its id (a list worked with keys keeps the
# focused row in view), stop its gliding, and are held within its content at the next draw
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=8
window("shop", 640, 400)
items = [loop i in [0..30): "item {i}"]
draw = ():
    clear(rgb(0.1, 0.1, 0.12))
    f = frame_number()
    if f == 2: hud_scroll_to("shop", 200.0)
    if f == 3: hud_scroll_to("shop", 100000.0)          # (past the end: held at the last row)
    if f == 4: hud_scroll_to("shop", -50.0)             # (before the start: the top)
    if f == 5: hud_scroll_reveal("shop", 20.0 * 44.0, 21.0 * 44.0)     # (row 20: scrolled down to it)
    if f == 6: hud_scroll_reveal("shop", 18.0 * 44.0, 19.0 * 44.0)     # (row 18: in view already, no change)
    if f == 7: hud_scroll_reveal("shop", 2.0 * 44.0, 3.0 * 44.0)       # (row 2: scrolled up to it)
    r = Rect(40, 40, 300, 300)
    off = hud_scroll(r, f64(items.len() * 44), "shop")
    print("frame {f}: scrolled to {off:.1}")
