# requires: sloppy
# requires: native
# env: SLOPPY_SCREENSHOT=$TMP/layout_focus_scroll_live.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=50
# env: SLOPPY_INPUT=3:down+ 4:down- 5:pad_down+ 6:pad_down- 7:lstick=0x1 8:lstick=0x0 11:up+ 12:up- 13:up+ 14:up- 15:up+ 16:up- 17:shift+ 18:tab+ 19:tab- 20:shift- 21:tab+ 22:tab- 23:pad_rb+ 24:pad_rb- 25:pad_rb+ 26:pad_rb- 27:tab+ 28:tab- 29:pad_rb+ 30:pad_rb- 31:pad_lb+ 32:pad_lb- 33:pad_lb+ 34:pad_lb- 35:shift+ 36:tab+ 37:tab- 38:shift- 39:shift+ 40:tab+ 41:tab- 42:shift- 44:tab+ 45:tab- 46:down+ 47:down- 48:enter+ 49:enter-
import layout as ui
window("Scroll focus", 390, 844)
closed = false
clicks = 0
draw = ():
    global clicks
    clear()
    f = frame_number()
    ui.at(Rect(0, 0, 390, 844), key = "settings", ():
        ui.scroll(width = 390, height = 844, ():
            loop i in [0..4):
                if i > 0:
                    ui.label("A long group header")
                    ui.space(height = 1000)
                ui.button("Disabled", enabled = false)
                if ui.button("Setting {i}", width = 300, height = 44, key = "setting {i}"): clicks += 1
            if closed:
                ui.over((): ui.button("Closed", key = "closed"))
        )
    )
    want = match f:
        3, 13, 23, 36: 1
        5, 11, 25, 33: 2
        7, 18, 27, 31: 3
        15, 21, 29, 40: 0
        _: -1
    if want >= 0:
        key = "setting {want}"
        assert(ui.get(key, root = "settings")!.focused, "frame {f}: {key}")
        r = ui.bounds(key, root = "settings")!
        assert(r.y >= 0 and r.y + r.h <= 844, "frame {f}: {r}")
    # A later modal layout root retains keyboard ownership; hidden and disabled controls stay
    # absent, and a covered scroll list cannot regain focus via an offscreen candidate.
    if f >= 42:
        ui.at(Rect(0, 0, 390, 844), key = "modal", ():
            ui.panel(width = 390, height = 844, ():
                ui.button("Modal", key = "modal button")
            )
        )
    if f == 50:
        assert(ui.get("modal button", root = "modal")!.focused)
        assert(ui.get("closed", root = "settings") == none and clicks == 0)
        print("phone scroll: arrows, d-pad, stick, Tab, Shift+Tab, LB/RB and modal ownership")
