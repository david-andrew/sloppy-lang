# requires: native
# requires: sloppy
# env: SLOPPY_NO_DRAW=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=6
# env: SLOPPY_INPUT=1:lstick=0.5x-1 1:rt=0.75 2:pad_a+ 2:pad_start+ 2:pad_left+ 3:pad_up+ 3:pad_a- 3:pad_x+ 4:pad_left- 2:pad1_rstick=-1x0.5 2:pad1_lt=1 2:pad1_b+ 4:pad1_axis1=0.3 4:pad1_button1- 3:pad1_button12+ 1:pad1_standard=1 2:pad2_lstick=1x0 2:pad2_standard=0
# A scripted standard pad's raw controls as Linux's xpad numbers them (axes lx ly lt rx ry rt
# dpad-x dpad-y, triggers -1 at rest; buttons a b x y lb rb back start home ls rs), what real
# hardware gives joystick_axis; raw items set their axis or button over the mirror (pad 1, said
# standard), and a pad said not standard (pad 2) has no raw controls. The raw readers are first
# used in frame 3: what came before is there, and only frame 3's presses are pressed then.
show = (p: int):
    axes: str[]
    loop i in [0..joystick_axes(p)): axes.push("{joystick_axis(p, i):.2}")
    held: int[]
    pressed: int[]
    loop i in [0..joystick_buttons(p)):
        if joystick_button(p, i): held.push(i)
        if joystick_pressed(p, i): pressed.push(i)
    print("{frame_number()} pad {p}: standard {gamepad_standard(p)}, {joystick_axes(p)} axes [{join(axes, " ")}], {joystick_buttons(p)} buttons, held {held}, pressed {pressed}")

update = (dt: f64):
    f = frame_number()
    if f == 3 or f == 4:
        show(0)
        show(1)
    if f == 4:
        show(2)
        print("pad 2 standard axis0 {gamepad_axis(2, 0):.2}")
