# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_unused.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
# An ordinary 3D game must not ask the driver for unused instance/skin programs, even
# though __3d_init declares their Shader handles. Instance-buffer loading then opts in.
window("Only loaded layouts", 160, 90)
# An unregistered shader family with skinned inputs must also stay out of the driver.
custom_skin_fs = (i: LitOut, u: LitParams) -> vec4: i.color
custom_skin = make_shader(shader(lit_vs_skin, custom_skin_fs))
box = cube_mesh()
warm_up()
kept = InstanceBuffer[Instance3D]()
loaded = 0
check_unused = ():
    when TARGET != "wasm" and TARGET != "macos":
        if __vk:
            assert(not __warm_inst_needed)
            assert(__vgp[custom_skin.prog].warm_layout == 4)
            assert(__vgp[custom_skin.prog].vs == 0 and __vgp[custom_skin.prog].fs == 0 and __vgp[custom_skin.prog].pipelines.len() == 0)
            loop p in __vgp:
                if p.warm_kind == 10 or p.warm_kind == 11 or p.warm_kind == 6 or p.warm_kind == 4 or p.warm_kind == 5 or p.warm_kind >= 12:
                    assert(p.vs == 0 and p.fs == 0 and p.pipelines.len() == 0 and not p.warm_failed)
                if frame_number() < 4 and (p.warm_kind == 8 or p.warm_kind == 9):
                    assert(p.vs == 0 and p.fs == 0 and p.pipelines.len() == 0)
update = (dt: f64):
    global kept, loaded
    check_unused()
    if frame_number() == 4:
        kept = instance_buffer([Instance3D(mat4(), WHITE)])
        when TARGET != "wasm" and TARGET != "macos":
            if __vk:
                assert(__warm_3d_layouts == 3)
                loaded = __vg_pipeline_creations
    if frame_number() == 5:
        another = instance_buffer([Instance3D(mat4(), WHITE)])
        assert(another.count == 1)
        when TARGET != "wasm" and TARGET != "macos":
            if __vk: assert(__vg_pipeline_creations == loaded)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    draw_mesh(box)
on_quit = ():
    check_unused()
    print("unused layouts stay deferred")
