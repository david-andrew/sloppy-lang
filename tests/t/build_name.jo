# requires: sloppy
# build is a name except in `build:` alone on its line (the build block): a field, a variable, a parameter
struct Hall:
    build: f64
    name: str

h = Hall(build = 0.5, name = "hall")
h.build += 0.25
build = h.build * 2
print(h.build, build)
f = (build: int) -> int: build + 1
print(f(build = 3))
