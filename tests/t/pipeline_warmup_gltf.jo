# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_gltf.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_NO_AUDIO=1
# Delayed first draw of a PBR glTF asset: loading must prepare regular and skinned passes.
actor = load_model(embed("../render/pbr_skin.gltf")).unwrap()
loaded = 0
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        assert(__vg_3d_warm & 96 == 96)
        loaded = __vg_pipeline_creations
update = (dt: f64):
    when TARGET != "wasm" and TARGET != "macos":
        if __vk: assert(__vg_pipeline_creations == loaded)
draw = ():
    camera3d(vec3(0, 0.3, 7), vec3(0, 0, 0), 42)
    if frame_number() >= 4:
        draw_model(actor, pose = pose_at(actor, 0, 0.65, false))

on_quit = (): print("glTF PBR ready before drawing")
