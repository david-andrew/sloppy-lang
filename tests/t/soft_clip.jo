# requires: sloppy
# The software renderer's clipper: against the near plane, every corner mask, either winding,
# different homogeneous w, and a flat (integer) varying from the provoking vertex; and against
# the guard band (|x| and |y| at most __SW_GUARD w).
flat = [false, false, false, false, true, false]
loop mask in [0..8):
    loop reverse in [false, true]:
        clip: f32[]
        inside = 0
        loop i in [0..3):
            w = f32(i + 1)
            d = if mask & (1 << i) != 0: f32(1) else: f32(-1)
            if d >= 0: inside += 1
            clip.extend([f32(i == 1), f32(i == 2), d - w, w, f32(10 + i), f32(20 + i)])
        pv = fill(f32(0), 3 * 10)
        tris: i32[]
        ix = if reverse: (2, 1, 0) else: (0, 1, 2)
        __sw_clip_tri(clip, pv, tris, ix, f32(1), 6, 0, 0, 100, 100, data(flat))
        nt = if inside == 2: 2 else: if inside > 0: 1 else: 0
        assert(tris.len() == nt * 3)
        nv = if inside == 1 or inside == 2: 5 else: 3
        assert(clip.len() == nv * 6 and pv.len() == nv * 10)
        loop i in [3..nv):
            assert(abs(clip[i * 6 + 2] + clip[i * 6 + 3]) < 0.00001)
            assert(clip[i * 6 + 4] == f32(10 + ix.2))
            assert(pv[i * 10 + 8] == f32(10 + ix.2))
            assert(pv[i * 10 + 3] > 0)
        loop t in tris:
            assert(int(t) >= 0 and int(t) < nv)
            assert(clip[int(t) * 6 + 2] + clip[int(t) * 6 + 3] >= -0.00001)
# A corner exactly on the plane is kept, including when its outgoing edge crosses.
clip: f32[] = [0, 0, -1, 1, 1, 0, 0, 1, 0, 1, -2, 1]
pv = fill(f32(0), 24)
tris: i32[]
__sw_clip_tri(clip, pv, tris, (0, 1, 2), f32(1), 4, 0, 0, 100, 100, data(flat))
assert(tris.len() == 6)
print("near-plane clipping ok")
# A corner far past the guard band is cut back to it (the others kept); one wholly past it is
# left out.
g: f32[] = [0, 0, 0, 1, 100, 0, 0, 1, 0, 1, 0, 1]
gpv = fill(f32(0), 3 * 8)
gt: i32[]
__sw_clip_tri(g, gpv, gt, (0, 1, 2), f32(1), 4, 0, 0, 100, 100, null)
assert(gt.len() >= 3)
loop t in gt:
    assert(g[int(t) * 4] <= __SW_GUARD * g[int(t) * 4 + 3] + 0.0001)
    assert(gpv[int(t) * 8] <= 100.0 * (__SW_GUARD * 0.5 + 0.5) + 0.01)
far: f32[] = [20, 0, 0, 1, 30, 0, 0, 1, 20, 1, 0, 1]
fpv = fill(f32(0), 3 * 8)
ft: i32[]
__sw_clip_tri(far, fpv, ft, (0, 1, 2), f32(1), 4, 0, 0, 100, 100, null)
assert(ft.len() == 0)
print("guard band clipping ok")
