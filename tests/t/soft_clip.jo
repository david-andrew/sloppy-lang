# requires: sloppy
# The software renderer's near-plane clipper: every corner mask, either winding,
# different homogeneous w, and a flat (integer) varying from the provoking vertex.
flat = [false, false, false, false, true, false]
loop mask in [0..8):
    loop reverse in [false, true]:
        clip: f32[]
        ds: f32[]
        inside = 0
        loop i in [0..3):
            w = f32(i + 1)
            d = if mask & (1 << i) != 0: f32(1) else: f32(-1)
            if d >= 0: inside += 1
            ds.push(d)
            clip.extend([f32(i == 1), f32(i == 2), d - w, w, f32(10 + i), f32(20 + i)])
        pv = fill(f32(0), 3 * 10)
        tris: i32[]
        ix = if reverse: (2, 1, 0) else: (0, 1, 2)
        dist = if reverse: (ds[2], ds[1], ds[0]) else: (ds[0], ds[1], ds[2])
        __sw_clip_tri(clip, pv, tris, ix, dist, 6, 0, 0, 100, 100, data(flat))
        nt = if inside == 2: 2 else: if inside > 0: 1 else: 0
        assert(tris.len() == nt * 3)
        nv = if inside == 1 or inside == 2: 5 else: 3
        assert(clip.len() == nv * 6 and pv.len() == nv * 10)
        loop i in [3..nv):
            assert(abs(clip[i * 6 + 2] + clip[i * 6 + 3]) < 0.00001)
            assert(clip[i * 6 + 4] == f32(10 + ix.2))
            assert(pv[i * 10 + 8] == f32(10 + ix.2))
            assert(pv[i * 10 + 3] > 0)
        loop t in tris:
            assert(int(t) >= 0 and int(t) < nv)
            assert(clip[int(t) * 6 + 2] + clip[int(t) * 6 + 3] >= -0.00001)
# A corner exactly on the plane is kept, including when its outgoing edge crosses.
clip: f32[] = [0, 0, -1, 1, 1, 0, 0, 1, 0, 1, -2, 1]
pv = fill(f32(0), 24)
tris: i32[]
__sw_clip_tri(clip, pv, tris, (0, 1, 2), (f32(0), f32(1), f32(-1)), 4, 0, 0, 100, 100, data(flat))
assert(tris.len() == 6)
print("near-plane clipping ok")
