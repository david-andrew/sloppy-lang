# requires: sloppy
# Word boundaries are byte ranges, including multibyte text next to CJK units.
assert(__wrap_units("  αβ  中文hi 世界!  ") == [("αβ", true), ("中", true), ("文", false), ("hi", false), ("世", true), ("界", false), ("!", false)])
assert(__wrap_units("").len() == 0 and __wrap_units("   ").len() == 0)
assert(__wrap_units("one\ttwo\nthree") == [("one\ttwo\nthree", false)])
assert(__wrap_units("🙂hello中é") == [("🙂hello", false), ("中", false), ("é", false)])

# A line without tags returns the original bytes and one style per decoded character.
color = vec4(0.2, 0.4, 0.6, 0.8)
plain, styles = __rich_parse("Aé中🙂", color)
assert(plain == "Aé中🙂" and styles.len() == 4)
loop st in styles: assert(st.color == color and not st.bold and not st.italic)
empty, no_styles = __rich_parse("", color)
assert(empty == "" and no_styles.len() == 0)
# char_count is only a reserve hint: continuation bytes alone still decode individually.
broken = str_from_bytes([u8(0x80), u8(0x80)])
same, broken_styles = __rich_parse(broken, color)
assert(same == broken and broken_styles.len() == 2)

# Tagged lines keep the full parser, including escapes, unknown tags and style boundaries.
tagged, ts = __rich_parse("[b]α[/b]中[[x]", color)
assert(tagged == "α中[x]" and ts.len() == 5)
assert(ts[0].bold and not ts[1].bold and ts[4].color == color)
unknown, us = __rich_parse("[unknown]é", color)
assert(unknown == "[unknown]é" and us.len() == 10)
print("text temporary strings ok")
