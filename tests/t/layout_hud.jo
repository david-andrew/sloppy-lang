# requires: native
# requires: sloppy
# Live input through a transform, HUD integration, keyboard/gamepad, slots and later panels.
# env: SLOPPY_SCREENSHOT=$TMP/layout_hud.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=26
# env: SLOPPY_INPUT=2:mouse=20x20 3:mouse_left+ 4:mouse_left- 6:right+ 7:right- 8:enter+ 9:enter- 12:pad_left+ 13:pad_left- 14:pad_a+ 15:pad_a- 18:mouse_left+ 19:mouse_left- 22:mouse=60x90 23:mouse_left+ 24:mouse_left-
import layout as ui
window("layout input", 320, 240)
volume = 0.0
draw = ():
    global volume
    clear()
    if hud_button(Rect(0, 0, 80, 60), "behind"): print("incorrect click behind layout")
    push_transform()
    scale(2, 2)
    ui.at(Rect(0, 0, 160, 120), key = "main", ():
        ui.row(gap = 4, ():
            if ui.button("A", width = 40, height = 30, key = "a"): print("{frame_number()}: A")
            if ui.button("B", width = 40, height = 30, key = "b"): print("{frame_number()}: B")
        )
        ui.slot(width = 80, height = 30, (r: Rect):
            volume = hud_slider(r, volume, 0.0, 1.0)
        )
    )
    pop_transform()
    ui.at(Rect(200, 120, 80, 80), key = "border", ():
        ui.panel(width = 80, height = 80, color = vec4(), radius = 12, border = ui.Border(rgb(1, 0, 0), 4), (): pass)
    )
    if frame_number() == 2:
        print("HUD hovered {hud_hovered()}")
        img = screenshot()
        k = f64(img.width) / 320.0
        red = (x: int, y: int) -> bool:
            p = (int(f64(y) * k) * img.width + int(f64(x) * k)) * 4
            int(img.pixels[p]) - int(img.pixels[p + 1]) > 100
        assert(not red(201, 121) and red(240, 122) and not red(240, 140))
    if frame_number() >= 16: hud_panel(Rect(0, 0, 320, 60))
    if frame_number() == 25: print("slot changed {volume > 0.1}")
