# requires: native
# requires: sloppy
# Drawing a render target's own texture into it panics too, for 2D sprites as for draw
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
rt = render_target(64, 64)
other = render_target(64, 64)
draw = ():
    draw_to(other)
    draw_target(rt)
    draw_to(rt)
    print("drawn into another target")
    draw_target(rt)
    flush()
    print("not reached")
    draw_to_screen()
