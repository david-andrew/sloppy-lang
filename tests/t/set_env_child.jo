# requires: sloppy
# requires: unix
# set_env reaches the programs started after it, each value whole (the environment given to them
# pointed at strings freed by then)
set_env("SLOPPY_T1", "0")
set_env("SLOPPY_T2", "hello there")
code, out = run_shell("echo [$SLOPPY_T1] [$SLOPPY_T2]")
print(trim(out))
