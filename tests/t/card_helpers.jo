# requires: native
# requires: sloppy
# from a card game: loop over three names, a tuple's function called, Actions in sequence,
# rounded rectangles and ellipses, a tween read back from text keeping its ease
items = [("bow", 2, 30), ("sword", 1, 50)]
loop name, n, cost in items: print(name, n * cost)
print([loop a, b, c in items: "{a}:{b + c}"])
p = (3, (x: int) -> int: x * 2)
print(p.1(5))
log: str[]
turn: Actions
turn.then(0.3, (): log.push("a"))
turn.then(0.5, (): log.push("b"))
turn.then(0.0, (): log.push("c"))
loop i in [0..30):
    turn.update(1.0 / 60.0)
print(log, turn.busy())
loop i in [0..30):
    turn.update(1.0 / 60.0)
print(log, turn.busy())
img = render_image(100, 60, ():
    clear(WHITE)
    rect_rounded(10, 10, 80, 30, 10, BLACK)
    ellipse(vec2(50, 50), vec2(40, 6), BLUE))
print("corner open:", img.get(11, 11).x > 0.5, "middle filled:", img.get(50, 25).x < 0.5, "ellipse:", img.get(50, 50).z > 0.5)
tw = tween(0.0, 10.0, 1.0)
r = from_text[Tween[f64]](to_text(tw))
if r is Tween[f64]:
    r.update(0.5)
    print(to_text(tw), r.value())
