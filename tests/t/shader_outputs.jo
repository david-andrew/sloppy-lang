# requires: sloppy
# A vertex function writes its outputs where they go (gl_Position, its varyings), never into a
# struct that main then copies from (Adreno 650: values a terrain vertex shader computed came out
# wrong near the camera): a returned constructor is a write of each field; the variable it builds
# its output in, given fields one by one (Aegean Skies' terrain: `result = O(...)`, then
# `result.working = ...`) and returned, is the outputs themselves, read back from them too; so in
# a branch returning early. A helper's result returned, or given to that variable and then changed
# (Aegean's curved objects: `o = obj_vs(v, u)`, `o.pos = ...`), is written by a void one of that
# helper's own. A function passing its output variable on is translated as before.
struct OuV:
    pos: vec3
struct OuU:
    view_proj: mat4
    k: f32
struct OuO:
    pos: vec4
    world: vec3
    shade: f32 = 0.0
    land: f32 = 0.0
ou_frag = (i: OuO, u: OuU) -> vec4: vec4(i.world, i.shade + i.land)
# (a constructor returned)
ou_ctor = (v: OuV, u: OuU) -> OuO: OuO(u.view_proj * vec4(v.pos, 1), v.pos, u.k)
# (built in a variable, fields given after, read back, returned; and an early return)
ou_built = (v: OuV, u: OuU) -> OuO:
    if v.pos.y < -100.0: return OuO(vec4(0, 0, 0, 1), v.pos)
    result = OuO(u.view_proj * vec4(v.pos, 1), v.pos, u.k)
    result.land = result.shade * 2.0
    result.pos.z += 0.001
    result
# (what a helper made: as before)
ou_make = (p: vec3, u: OuU) -> OuO: OuO(u.view_proj * vec4(p, 1), p)
ou_helper = (v: OuV, u: OuU) -> OuO: ou_make(v.pos, u)
# (a helper's result given to the variable, changed, returned)
ou_curved = (v: OuV, u: OuU) -> OuO:
    o = ou_make(v.pos, u)
    o.pos = u.view_proj * vec4(o.world * 2.0, 1)
    o.shade = 1.0
    o
# (the output variable passed on: as before)
ou_tweak = (o: OuO) -> OuO: OuO(o.pos, o.world * 2.0, o.shade)
ou_passed = (v: OuV, u: OuU) -> OuO:
    r = OuO(u.view_proj * vec4(v.pos, 1), v.pos)
    ou_tweak(r)
loop src in [shader(ou_ctor, ou_frag), shader(ou_built, ou_frag), shader(ou_helper, ou_frag), shader(ou_curved, ou_frag), shader(ou_passed, ou_frag)]:
    lines = split(src.vs, "\n")
    k = 0
    loop k < lines.len() and not starts_with(lines[k], "struct S_OuO") and not (" f_ou_" in lines[k] and "(" in lines[k]): k += 1
    loop l in lines[k..]:
        if l != "" and not starts_with(l, "struct") and not starts_with(l, "    vec4 pos_") and not starts_with(l, "    vec3 world_") and not starts_with(l, "    float ") and l != "};": print(l)
    print("--")
