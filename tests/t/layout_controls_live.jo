# requires: sloppy
# requires: native
# env: SLOPPY_SCREENSHOT=$TMP/layout_controls_live.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=78
# env: SLOPPY_INPUT=3:right+ 4:right- 6:down+ 7:down- 8:left+ 9:left- 10:tab+ 11:tab- 12:enter+ 13:enter- 14:text=abc,16:left+ 17:left- 18:text=X,20:text=ZZ,22:enter+ 23:enter- 24:pad_rb+ 25:pad_rb- 26:pad_lb+ 27:pad_lb- 28:pad_a+ 29:pad_a- 30:text=Pad,32:pad_left+ 33:pad_left- 34:pad_a+ 35:pad_a- 36:pad_lb+ 37:pad_lb- 38:pad_right+ 39:pad_right- 40:pad_lb+ 41:pad_lb- 42:pad_right+ 43:pad_right- 44:pad_a+ 45:pad_a- 46:pad_lb+ 47:pad_lb- 48:lstick=1x0 50:lstick=0x0 52:mouse=140x40 53:mouse_left+ 54:mouse=248x40 56:mouse_left- 58:mouse=350x40 59:mouse_left+ 60:mouse_left- 62:mouse=235x100 63:mouse_left+ 64:mouse_left- 66:mouse=300x100 67:mouse_left+ 68:mouse_left- 70:ctrl+ 71:a+ 72:a- 73:ctrl- 74:text=Mouse,76:enter+ 77:enter-
import layout as ui
window("Native layout input", 640, 360)
v = 0.5
on = false
index = 0
name = ""
submits = 0
button_hits = 0
near = (a: f64, b: f64): assert(abs(a - b) < 0.00001, "frame {frame_number()}: {a} != {b}")
draw = ():
    global v, on, index, name, submits, button_hits
    clear()
    ui.at(Rect(20, 20, 600, 320), gap = 20, ():
        ui.row(gap = 20, ():
            v = ui.slider(v, 0.0, 1.0, 0.1, width = 240, height = 40, key = "volume")
            on = ui.switch(on, "Hints", width = 240, height = 40, key = "hints")
        )
        ui.row(gap = 20, ():
            index = ui.choice(["Easy", "Normal", "Hard"], index, width = 240, height = 40, key = "level")
            name = ui.text_field(name, "Name", max_chars = 4, width = 240, height = 40, key = "name")
            if ui.get("name")!.submitted:
                submits += 1
                assert(hud_submitted())
        )
        if ui.button("Apply", width = 240, height = 40, key = "apply"): button_hits += 1
    )
    f = frame_number()
    if f == 3:
        near(v, 0.6)
        assert(ui.get("volume")!.focused)
    if f == 8: assert(index == 2 and ui.get("level")!.focused)
    if f == 14: assert(name == "abc" and ui_typing())
    if f == 18: assert(name == "abXc" and ui.get("name")!.focused)
    if f == 20: assert(name == "abXc")
    if f == 22:
        assert(submits == 1 and not ui.get("name")!.editing)
        print("keyboard values, caret, limit and submit ok")
    if f == 24: assert(ui.get("apply")!.focused)
    if f == 30: assert(name == "Pad" and ui.get("name")!.editing)
    if f == 32: assert(name == "Pad" and ui.get("name")!.focused)
    if f == 34: assert(submits == 2 and not ui.get("name")!.editing)
    if f == 38: assert(index == 0)
    if f == 42: assert(not on and ui.get("hints")!.focused)
    if f == 44: assert(on)
    if f == 48:
        near(v, 0.7)
        print("gamepad d-pad, stick, shoulders, toggle and text submit ok")
    if f == 54: near(v, 1.0)
    if f == 60: assert(not on)
    if f == 64: assert(index == 1)
    if f == 74: assert(name == "Mous")
    if f == 76:
        assert(submits == 3 and button_hits == 0)
        print("pointer drag, toggle, choice and text edit return immediately")
