# split with a limit, count, pad_start/pad_end, capitalize, max_by/min_by
print("k=v=w".split("=", 1), "a,b,c".split(",", 0), "a,b".split(",", 5), "banana".count("an"), "banana".count("a"))
print("[{pad_start("7", 3, "0")}] [{pad_end("ab", 5)}] [{pad_start("long", 2)}] [{pad_end("x", 4, "-=")}]", capitalize("hello world"))
xs = [3, -7, 5, -1]
print(max_by(xs, (x): abs(x)), min_by(xs, (x): abs(x)), max_by(["aa", "b", "ccc"], (s): len(s)))
