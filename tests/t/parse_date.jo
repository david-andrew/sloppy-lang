# requires: sloppy
# parse_date: ISO 8601 dates and times, with a time zone or in UTC; none for what is not one
loop t in ["2026-10-14", "2026-10-14 08:15", "2026-10-14T08:15:03Z", "2026-10-14T08:15:03.250+02:00", "2026-02-29", "2024-02-29T23:59:59-0530", "2026-13-01", "26-10-14", "2026-10-14T25:00", "2026-10-14x"]:
    if let d = parse_date(t, utc = true): print("{t} -> {date_text(d)} {d.offset} {weekday_name(d)} {unix_time(d)}")
    else: print("{t} -> none")
