# the end of a hash chain is not a match at position -1 (the byte before the input)
# requires: sloppy
r: u8[] = []
loop i in [0..40): r.push(u8(65 + (i * 7) % 26))
ok = 0
loop x in [0..256):
    src: u8[] = []
    src += r
    # (the same 4 bytes as x then the input's first 3, longer at the end, so -1 would match best)
    src += [u8(x), r[0], r[1], r[2], u8(0)]
    loop i in [0..50): src.push(u8(200 - i))
    src.push(u8(x))
    src += r
    z = deflate(src)
    if (inflate(z) ?? []) == src: ok += 1
print(ok)
