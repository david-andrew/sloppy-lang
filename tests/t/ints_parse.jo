# ints: every whole number in a text; to_int's quick path (a sign and up to 18 digits) and the
# rest; split into words; mem_copy of short lengths (two loads and two stores) as of long ones,
# apart and overlapping where the copy is to lower addresses
# requires: sloppy
print(ints("x=3,y=-4"), ints("1-3 a: abcde"), ints("Game 12: 3 blue, 4 red;\n-7\n"))
print(ints(""), ints("abc"), ints("-"), ints("--5"), ints("a-0b"), ints("+5"))
print(ints("9223372036854775807 -9223372036854775808 000000000000000000000012"))
print(to_int("42"), to_int("-42"), to_int("+7"), to_int(" 42\n"), to_int("4 2"), to_int("+"))
print(to_int("123456789012345678"), to_int("-123456789012345678"), to_int("1234567890123456789"))
print(to_int("007"), to_int("-0"), to_int("12", 10), to_int("0x10", 10), to_int("1a"), to_int("1 "))
print(" a\tb\r\nc  d\n".split(), "x".split(), "".split(), "  ".split())
bad = 0
loop n in [0..40]:
    loop off in [-3..3]:
        a = [loop i in [0..128): u8(i)]
        want = [loop i in [0..128): u8(i)]
        dst = 30 + off
        if off == 0: dst = 70
        tmp = [loop i in [0..n): want[30 + i]]
        loop i in [0..n): want[dst + i] = tmp[i]
        mem_copy(data(a) + dst, data(a) + 30, n)
        if (off <= 0 or off >= n) and a != want: bad += 1
print("mem_copy wrong:", bad)
