# requires: sloppy
# sound_stream: samples pushed as the program runs, played at their rate (here half the mixer's:
# each pushed frame lasts two of the mix), silent when it runs dry
__audio_state = 2
s = sound_stream(rate = MIX_RATE / 2, channels = 1)
push_samples(s, [loop i in 0..1000: f32(0.5)])
print(queued_samples(s))
__mix(800)
print(queued_samples(s), "{__mix_buf[0]:.2} {__mix_buf[1]:.2}")
__mix(1200)
print(queued_samples(s), is_playing(s))
__mix(100)
print("{__mix_buf[0]:.2}", is_playing(s))
stop(s)
print(is_playing(s), queued_samples(s))
