# requires: sloppy
j = parse_json(r'{"items":[{"x":1.5},2]}').unwrap()
print(j.get("items").get(0).get("x").as_float())
print(j.get("items").get(-1) == none, j.get("items").get(2) == none)
print(j.get("missing").get(0).get("x") == none, j.get(0) == none)
print(j.get("items").get(1).as_float())
print(j.get("missing").as_list().len(), j.get("items").keys().len())
