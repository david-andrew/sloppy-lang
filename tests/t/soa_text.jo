# requires: sloppy
# a soa array prints and saves as the array of its elements, and reads back
struct P:
    x = 0.0
struct W:
    ps: soa P[]
    n = 3
w = W()
w.ps.push(P(1.5))
w.ps.push(P(2.0))
print(w.ps)
t = to_text(w)
print(t)
r = from_text[W](t)
if r is W: print(r.ps.len(), r.ps[1].x, r.n)
else: print(r)
