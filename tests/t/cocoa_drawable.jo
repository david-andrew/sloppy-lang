# requires: sloppy
# requires: native
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_GL_SOFTWARE=1
# A window larger than the screen, and the very first frame after resizing it. Readback
# must use the view's real backing pixels; the design area still maps to the whole view.
when TARGET == "macos":
    set_env("SLOPPY_SOFTWARE", "0")
    set_env("SLOPPY_GL_SOFTWARE", "1")
    set_env("SLOPPY_METAL", "0")
    set_env("SLOPPY_VULKAN", "0")
    unset_env("SLOPPY_SCREENSHOT")
    window("drawable regression", 4096, 4096)
    screen_fit(.stretch)
    __platform_poll()
    assert(not __soft and not __vk)
    __ns_struct(__ns_view, "bounds", 32)
    w = int(__ns_val[2] * __ns_scale)
    h = int(__ns_val[3] * __ns_scale)
    assert(__win_w == w and __win_h == h)
    assert(__design_w == 4096 and __design_h == 4096)
    # A capture's native units stay deterministic on Retina too, while the drawable
    # keeps all its backing pixels (Metal's layer uses these even during a capture).
    set_env("SLOPPY_SCREENSHOT", "unused.png")
    __ns_size()
    assert(pixel_ratio() == 1.0)
    assert(__ns_draw_w == w and __ns_draw_h == h)
    unset_env("SLOPPY_SCREENSHOT")
    __ns_size()
    __gfx_begin_frame()
    clear(BLACK)
    rect(0, 0, 4096, 4096, vec4(1, 0, 0, 1))
    __gfx_end_frame()
    img = screenshot()
    assert(img.width == w and img.height == h)
    assert(img.pixels[0] == 255 and img.pixels[(w * h - 1) * 4] == 255)
    __platform_present()
    __platform_resize(320, 240)
    __platform_poll()
    __gfx_begin_frame()
    clear(BLACK)
    rect(0, 0, 4096, 4096, vec4(1, 0, 0, 1))
    __gfx_end_frame()
    img = screenshot()
    assert(img.width == __win_w and img.height == __win_h)
    assert(img.width == 320 and img.height == 240)
    assert(img.pixels[0] == 255 and img.pixels[(320 * 240 - 1) * 4] == 255)
    __platform_present()
    __game_quit()
print("drawable sizing ok")
