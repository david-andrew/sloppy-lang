# requires: sloppy
# Page options which fail immediately, without a network or JSPI; native skips this web path.
import net
when TARGET == "wasm":
    f = net.fetch_start("https://example.invalid", save_to = "out.bin")
    r = net.fetch_result(f)!
    assert(r.status == 0 and contains(r.why, "save_to"))
    f = net.fetch_start("https://example.invalid", cookies = net.cookie_jar())
    r = net.fetch_result(f)!
    assert(r.status == 0 and contains(r.why, "CookieJar"))
    rs = net.fetch_all(["https://example.invalid"])
    assert(rs[0].status == 0 and contains(rs[0].why, "fetch_start"))
print("page option checks ok")
