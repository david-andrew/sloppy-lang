# requires: sloppy
# requires: native
# env: SLOPPY_SOFTWARE=1
# Different varying layouts and clipped vertex counts reuse the same mesh scratch.
probe: f32[] = [1, 2, 3]
saved = probe
__sw_f32_scratch(probe, 2)
probe.push(4)
assert(probe == [f32(1), f32(2), f32(4)] and saved == [f32(1), f32(2), f32(3)])
__sw_f32_scratch(probe, 0)
assert(probe.len() == 0)

struct V:
    pos: vec3
struct U:
    color: vec4
struct O:
    pos: vec4
struct Tagged:
    pos: vec4
    tag: i32
    color: vec4
struct Colored:
    pos: vec4
    color: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4: u.color
tag_vs = (v: V, u: U) -> Tagged: Tagged(vec4(v.pos, 1), 7, u.color)
tag_fs = (i: Tagged, u: U) -> vec4:
    if i.tag == 7: return i.color
    vec4(1, 0, 0, 1)
color_vs = (v: V, u: U) -> Colored: Colored(vec4(v.pos, 1), vec4(v.pos.x * 0.5 + 0.5, 0, 0, 1))
color_fs = (i: Colored, u: U) -> vec4: i.color
plain = make_shader(shader(vs, fs))
tagged = make_shader(shader(tag_vs, tag_fs))
colored = make_shader(shader(color_vs, color_fs))
cover = mesh([V(vec3(-1, -1, 0)), V(vec3(3, -1, 0)), V(vec3(-1, 3, 0))])
clipped = mesh([V(vec3(-1, -1, -2)), V(vec3(3, -1, 0)), V(vec3(-1, 3, 0))])
empty = mesh([V(vec3(-1, -1, -2)), V(vec3(3, -1, -2)), V(vec3(-1, 3, -2))])
check = (w: int, h: int, mode: int):
    img = render_image(w, h, ():
        clear(BLACK)
        draw(tagged, clipped, U(vec4(1, 0, 0, 1)))
        draw(plain, empty, U(vec4(1, 0, 0, 1)))
        if mode == 0:
            # Slot 4 was an integer tag in the last draw; now it must interpolate red.
            draw(colored, cover, U(vec4(0, 0, 0, 1)))
        else if mode == 1: draw(tagged, cover, U(vec4(0, 1, 0, 1)))
        else:
            clear(BLACK)
            draw(tagged, clipped, U(vec4(0, 1, 0, 1)))
            draw(plain, empty, U(vec4(1, 0, 0, 1))))
    loop y in [0..h):
        loop x in [0..w):
            p = (y * w + x) * 4
            if mode == 0:
                red = int((f64(x) + 0.5) / f64(w) * 255.0 + 0.5)
                assert(abs(int(img.pixels[p]) - red) <= 1 and img.pixels[p + 1] == 0)
            else if mode == 1:
                assert(img.pixels[p] == 0 and img.pixels[p + 1] == 255)
            else if x != y:
                # The near plane cuts along x == y; ignore its top-left tie rule here.
                assert(img.pixels[p] == 0 and img.pixels[p + 1] == (if x > y: u8(255) else: u8(0)))
            assert(img.pixels[p + 2] == 0 and img.pixels[p + 3] == 255)
check(16, 16, 0)
check(80, 80, 1)
check(16, 16, 2)
check(16, 16, 0)
print("mesh scratch reuse ok")
