# requires: sloppy
# to_bytes and from_bytes: a plain struct's bytes and back (a save state)
struct Cpu:
    a: u8
    pc: u16
    mem: u8[16]
    t: f64
c = Cpu(1, 0x1234, [], 2.5)
c.mem[3] = 9
b = to_bytes(c)
print(b.len())
d = from_bytes[Cpu](b)!
print(d.pc, d.mem[3], d.t, d == c)
print(from_bytes[Cpu]([1, 2, 3]) == none)
