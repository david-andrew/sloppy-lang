# requires: sloppy
# Invalid runtime bytes return errors before any graphics upload or audio startup.
a = load_image([])
b = load_png([])
c = load_jpeg([])
d = load_texture([])
e = load_font([])
f = load_wav([])
g = load_ogg([])
h = load_music([])
i = load_model([])
print(a is ImageError, b is ImageError, c is ImageError, d is ImageError)
print(e is FontError, f is AudioError, g is AudioError, h is AudioError, i is ModelError)
checked = (b: u8[]) -> Image | ImageError: load_image(b)?
print(checked([]) is ImageError)
png = encode_png(image(2, 3, RED))
pic = load_png(png).unwrap()
print(pic.width, pic.height, load_image(png).unwrap().pixels == pic.pixels)
wav = encode_wav(Sound([f32(0.25), -0.25]))
print(frames(load_wav(wav).unwrap()))
print(load_wav(wav[..wav.len() - 1)) is AudioError)
