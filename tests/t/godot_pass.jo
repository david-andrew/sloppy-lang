# requires: sloppy
# T? == T for any T with == (strings, vectors), none never equal; ivec2/ivec3 from ints;
# move_toward on numbers and vec3
f = () -> int?: 3
g = () -> str?: "a"
h = () -> ivec2?: ivec2(1, 1)
v: vec3? = vec3(1, 2, 3)
n: int? = none
print(f() == 3, g() == "a", h() == ivec2(1, 1), g() != "b", v == vec3(1, 2, 3), n == 0, n != 0)
loop y in [0..2):
    loop x in [0..2): print(ivec2(x, y), ivec3(x, y, 7))
print(move_toward(0.0, 10.0, 3.0), move_toward(9.0, 10.0, 3.0), move_toward(vec3(0, 0, 0), vec3(10, 0, 0), 4.0))
