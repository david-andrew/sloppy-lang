    pad = 83
g = Cell([F32s(3, 6), F32s(9, 12)])
@inline
change_in = (v: mut F32s[2]):
    v = [F32s(15, 18), F32s(21, 24)]
@inline
saved_in = (s: mut Cell) -> F32s[2]:
    old = s.v
    s.v[0].x *= 2
    old
@inline
argument_in = (s: mut Cell, old: F32s[2]) -> F32s[2]:
    s.v[0].x *= 2
    old
@noinline
change_out = (v: mut F32s[2]):
    v = [F32s(15, 18), F32s(21, 24)]
@noinline
saved_out = (s: mut Cell) -> F32s[2]:
    old = s.v
    s.v[0].x *= 2
    old
@noinline
argument_out = (s: mut Cell, old: F32s[2]) -> F32s[2]:
    s.v[0].x *= 2
    old

@noinline
param_case = (s: mut Cell, mode: int, take: bool):
    whole = s
    field = Cell([F32s(15, 18), F32s(21, 24)])
    elements = [s]
    element = elements[0]
    pair = (s, 97)
    tuple_element = pair.0
    relay = s.v
    first = relay
    field.v = first
    before = s.v[0].x
    match mode:
        0: s.v = [F32s(15, 18), F32s(21, 24)]
        1: s.v[0].x += 2
        2: s.v[0].x *= 2
        3: change_in(s.v)
        4: change_out(s.v)
        5:
            if take: s.v = [F32s(15, 18), F32s(21, 24)]
        6:
            if take: pass
            else: s.v = [F32s(15, 18), F32s(21, 24)]
        7:
            match take:
                true: s.v = [F32s(15, 18), F32s(21, 24)]
                false: pass
        8:
            loop j in 0..(if take: 3 else: 0): s.v[0].x += 1
        _:
            if take:
                s.v = [F32s(15, 18), F32s(21, 24)]
                observed_relay = s.v
                observed = observed_relay
                check = f64(first[0].x) + f64(s.v[0].x) - f64(observed[0].x)
                print("param", mode, take, "before", before, "check", check)
                print("local", first[0].x, first[0].y, first[1].x, first[1].y)
                print("whole", whole.v[0].x, whole.v[0].y, whole.v[1].x, whole.v[1].y)
                print("field", field.v[0].x, field.v[0].y, field.v[1].x, field.v[1].y)
                print("element", element.v[0].x, element.v[0].y, element.v[1].x, element.v[1].y)
                print("tuple", tuple_element.v[0].x, tuple_element.v[0].y, tuple_element.v[1].x, tuple_element.v[1].y)
                print("observed", observed[0].x, observed[0].y, observed[1].x, observed[1].y)
                print("original", s.v[0].x, s.v[0].y, s.v[1].x, s.v[1].y)
                return
    observed_relay = s.v
    observed = observed_relay
    check = f64(first[0].x) + f64(s.v[0].x) - f64(observed[0].x)
    print("param", mode, take, "before", before, "check", check)
    print("local", first[0].x, first[0].y, first[1].x, first[1].y)
    print("whole", whole.v[0].x, whole.v[0].y, whole.v[1].x, whole.v[1].y)
    print("field", field.v[0].x, field.v[0].y, field.v[1].x, field.v[1].y)
    print("element", element.v[0].x, element.v[0].y, element.v[1].x, element.v[1].y)
    print("tuple", tuple_element.v[0].x, tuple_element.v[0].y, tuple_element.v[1].x, tuple_element.v[1].y)
    print("observed", observed[0].x, observed[0].y, observed[1].x, observed[1].y)
    print("original", s.v[0].x, s.v[0].y, s.v[1].x, s.v[1].y)
    second = s.v
    s.v[0].x += 1
    print("second", second[0].x, second[0].y, second[1].x, second[1].y, "final", s.v[0].x, s.v[0].y, s.v[1].x, s.v[1].y)

