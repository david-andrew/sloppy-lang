# Reverse copies and two loop-carried memory-generation checks.
@noinline
reverse_case = (s: mut Cell, take: bool):
    local: F32s[2] = [F32s(3, 6), F32s(9, 12)]
    before = s.v[0].x
    s.v = local
    after = s.v[0].x
    if take: local = [F32s(15, 18), F32s(21, 24)]
    saved = s.v
    total = 0.0
    loop i in 0..3:
        old = s.v
        s.v[0].x += 1
        now = s.v
        total += f64(now[0].x) - f64(old[0].x)
    print("reverse", take, before, after, total, local[0].x, local[0].y, local[1].x, local[1].y, saved[0].x, saved[0].y, saved[1].x, saved[1].y, s.v[0].x, s.v[0].y, s.v[1].x, s.v[1].y)
    replacement: F32s[2] = [F32s(15, 18), F32s(21, 24)]
    sum = 0.0
    loop i in 0..3:
        sum += f64(s.v[0].x)
        s.v = replacement
    print("bit stores", sum, replacement[0].x, replacement[0].y, replacement[1].x, replacement[1].y, s.v[0].x, s.v[0].y, s.v[1].x, s.v[1].y)

# Runtime parameters keep both control-flow paths in the non-inlined cases.
loop mode in 0..10:
    loop take in [false, true]:
        s = Cell([F32s(3, 6), F32s(9, 12)])
        param_case(s, mode, take)
        global_case(mode, take)
        local_case(mode, take)
        xs = [Cell([F32s(15, 18), F32s(21, 24)]), Cell([F32s(3, 6), F32s(9, 12)])]
        element_case(xs, 1, mode, take)
        o = Outer(Cell([F32s(3, 6), F32s(9, 12)]))
        nested_case(o, mode, take)
# Aggregate return snapshots and an argument aliased by a mut argument.
loop take in [false, true]:
    rev = Cell([F32s(15, 18), F32s(21, 24)])
    reverse_case(rev, take)
s_in = Cell([F32s(3, 6), F32s(9, 12)])
r_in = saved_in(s_in)
print("return in", r_in[0].x, r_in[0].y, r_in[1].x, r_in[1].y, s_in.v[0].x, s_in.v[0].y, s_in.v[1].x, s_in.v[1].y)
a_in = argument_in(s_in, s_in.v)
print("argument in", a_in[0].x, a_in[0].y, a_in[1].x, a_in[1].y, s_in.v[0].x, s_in.v[0].y, s_in.v[1].x, s_in.v[1].y)
s_out = Cell([F32s(3, 6), F32s(9, 12)])
r_out = saved_out(s_out)
print("return out", r_out[0].x, r_out[0].y, r_out[1].x, r_out[1].y, s_out.v[0].x, s_out.v[0].y, s_out.v[1].x, s_out.v[1].y)
a_out = argument_out(s_out, s_out.v)
print("argument out", a_out[0].x, a_out[0].y, a_out[1].x, a_out[1].y, s_out.v[0].x, s_out.v[0].y, s_out.v[1].x, s_out.v[1].y)
