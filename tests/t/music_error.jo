# requires: sloppy
# A bad audio packet discovered after a successful open ends playback and keeps its error.
__audio_state = 2
m = load_music(embed("data/sweep.ogg")).unwrap()
id = play_music(m, looping = false)
__streams[0].dec.packets[4] = [u8(1)]
loop is_playing(id): __mix(1024)
if let e = music_error(id): print(e.message)
print(music_error(id) == none)
# A normally completed voice has no error.
id = play_music(m, looping = false)
loop is_playing(id): __mix(1024)
print(music_error(id) == none)
