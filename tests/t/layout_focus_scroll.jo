# requires: sloppy
# Clipped controls remain in keyboard/gamepad navigation, including nested and horizontal
# scrolls. Headers, disabled controls and closed floating content do not become focus targets.
import layout as ui

shown = (key: str, view: Rect):
    assert(ui.get(key)!.focused, "{key} focused")
    r = ui.bounds(key)!
    assert(r.x >= view.x and r.y >= view.y and r.x + r.w <= view.x + view.w and r.y + r.h <= view.y + view.h, "{key}: {r} in {view}")

phone = Rect(0, 0, 390, 844)
settings = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.scroll(width = ui.grow(), height = ui.grow(), key = "settings", ():
            loop i in [0..8):
                ui.panel(width = ui.grow(), pad = 12, gap = 10, ():
                    ui.label("Group {i}")
                    if i > 0: ui.space(height = 900)
                    ui.button("Unavailable", enabled = false, height = 40)
                    ui.button("Setting {i}", width = ui.grow(), height = 44, key = "setting {i}")
                )
            closed = true
            if not closed:
                ui.over((): ui.button("Hidden", key = "hidden"))
        )
    )
settings(ui.Input())
settings(ui.Input())
shown("setting 0", phone)
assert(ui.bounds("setting 1")!.y > phone.h)
# Down and Up cross headers bigger than the entire viewport.
loop i in [1..8):
    settings(ui.Input(nav = vec2(0, 1)))
    shown("setting {i}", phone)
settings(ui.Input(nav = vec2(0, 1)))
shown("setting 7", phone)
loop i in [0..7):
    settings(ui.Input(nav = vec2(0, -1)))
    shown("setting {6 - i}", phone)
# Tab and Shift+Tab visit every enabled control in tree order, and wrap both ways.
loop i in [1..17):
    settings(ui.Input(next = 1))
    shown("setting {i % 8}", phone)
loop i in [0..16):
    settings(ui.Input(next = -1))
    shown("setting {(15 - i) % 8}", phone)
assert(ui.get("hidden") == none)
print("phone settings: down/up, tab/backtab and wrap")

ui.reset()
nested = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.scroll(width = 390, height = 180, key = "outer", ():
            ui.button("Top", width = 300, height = 40, key = "top")
            ui.space(height = 300)
            ui.scroll(width = 350, height = 120, key = "inner", ():
                loop i in [0..3):
                    if i > 0: ui.space(height = 900)
                    ui.button("Inner {i}", width = 300, height = 40, key = "inner {i}")
            )
            ui.space(height = 300)
            ui.button("Bottom", width = 300, height = 40, key = "bottom")
        )
    )
nested(ui.Input())
nested(ui.Input())
keys = ["top", "inner 0", "inner 1", "inner 2", "bottom"]
loop i in [1..5):
    nested(ui.Input(next = 1))
    shown(keys[i], Rect(0, 0, 390, 180))
    if i < 4: shown(keys[i], ui.bounds("inner")!)
loop i in [0..4):
    nested(ui.Input(next = -1))
    shown(keys[3 - i], Rect(0, 0, 390, 180))
    if i < 3: shown(keys[3 - i], ui.bounds("inner")!)
# Direction keys enter an offscreen nested viewport and move within it.
loop i in [1..5):
    nested(ui.Input(nav = vec2(0, 1)))
    shown(keys[i], Rect(0, 0, 390, 180))
loop i in [0..4):
    nested(ui.Input(nav = vec2(0, -1)))
    shown(keys[3 - i], Rect(0, 0, 390, 180))
print("nested scrolls reveal through both viewports")

ui.reset()
sideways = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.scroll(width = 390, height = 100, axis = .horizontal, key = "row", ():
            loop i in [0..5):
                if i > 0: ui.space(width = 500)
                ui.button("{i}", width = 100, height = 40, key = "side {i}")
        )
    )
sideways(ui.Input())
sideways(ui.Input())
loop i in [1..5):
    sideways(ui.Input(nav = vec2(1, 0)))
    shown("side {i}", Rect(0, 0, 390, 100))
loop i in [0..4):
    sideways(ui.Input(nav = vec2(-1, 0)))
    shown("side {3 - i}", Rect(0, 0, 390, 100))
sideways(ui.Input(next = -1))
shown("side 4", Rect(0, 0, 390, 100))
sideways(ui.Input(next = 1))
shown("side 0", Rect(0, 0, 390, 100))
print("horizontal scrolls: arrows and tab wrap")

# Floating content draws last but Tab follows its place in the described tree.
ui.reset()
floating = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.button("Before", key = "before")
        ui.over(offset = vec2(200, 0), ():
            ui.button("Floating", key = "floating")
        )
        ui.button("After", key = "after")
    )
floating(ui.Input())
floating(ui.Input())
floating(ui.Input(next = 1))
assert(ui.get("floating")!.focused)
floating(ui.Input(next = 1))
assert(ui.get("after")!.focused)
print("tab follows tree order through floating subtrees")

# Alignment is a tie-breaker within the nearest row, rather than a reason to skip it.
ui.reset()
rows = (input: ui.Input):
    ui.at(phone, render = false, input = input, gap = 20, ():
        ui.row(():
            ui.space(width = 280)
            ui.button("Top", width = 100, height = 40, key = "top")
        )
        ui.row(gap = 10, ():
            ui.button("Left", width = 80, height = 40, key = "left")
            ui.button("Near", width = 80, height = 40, key = "near")
        )
        ui.row(():
            ui.space(width = 280)
            ui.button("Aligned", width = 100, height = 40, key = "aligned")
        )
    )
rows(ui.Input())
rows(ui.Input())
rows(ui.Input(nav = vec2(0, 1)))
assert(ui.get("near")!.focused)
rows(ui.Input(nav = vec2(0, 1)))
assert(ui.get("aligned")!.focused)
rows(ui.Input(nav = vec2(0, -1)))
assert(ui.get("near")!.focused)
print("arrows prefer the nearest row, then alignment")

# The inner reveal margin can exceed the outer viewport's. Predict the inner scroll's actual
# offset (and clamp to its content), rather than following the raw bottom of its viewport.
ui.reset()
tall_inner = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.scroll(width = 390, height = 100, key = "outer", ():
            ui.scroll(width = 350, height = 400, gap = 100, key = "inner", ():
                loop i in [0..4):
                    ui.button("{i}", width = 300, height = 40, key = "tall {i}")
                    ui.space(height = 300)
            )
        )
    )
tall_inner(ui.Input())
tall_inner(ui.Input())
loop i in [1..4):
    tall_inner(ui.Input(next = 1))
    shown("tall {i}", Rect(0, 0, 390, 100))
loop i in [0..3):
    tall_inner(ui.Input(next = -1))
    shown("tall {2 - i}", Rect(0, 0, 390, 100))
print("nested reveal respects margins and content limits")

# A scroll only reveals its scrolling axis. Clipped cross-axis content and zero viewports are
# still hidden, even though their descendants have positive solved sizes.
ui.reset()
hidden = (input: ui.Input):
    ui.at(phone, render = false, input = input, ():
        ui.scroll(width = 390, height = 100, ():
            ui.button("Available", width = 100, height = 40, key = "available")
            ui.over(width = 100, height = 40, offset = vec2(500, 0), clip = true, ():
                ui.button("Cross-axis hidden", width = 100, height = 40, key = "cross hidden")
            )
        )
        ui.scroll(width = 390, height = 0, ():
            ui.button("Zero viewport", width = 100, height = 40, key = "zero hidden")
        )
    )
hidden(ui.Input())
hidden(ui.Input())
hidden(ui.Input(next = 1))
assert(ui.get("available")!.focused)
hidden(ui.Input(nav = vec2(1, 0)))
assert(ui.get("available")!.focused)
print("other clipping and zero viewports remain hidden")
