# requires: sloppy
# env: SLOPPY_NO_AUDIO=1
# the mixer: a smooth knee (louder never comes out quieter), fades that change every sample, play's delay to the sample, the audio clock, midi_freq
master_volume(1.0)
loop x in [0.5, 0.74, 0.76, 0.99, 1.01, 1.5, 3.0]:
    stop_all()
    play(Sound(fill(f32(x), 200)))
    __mix(100)
    print("{x} -> {__mix_buf[0]:.4}")
# a fade, mixed in 800-frame chunks: changes a little every sample
stop_all()
id = play(Sound(fill(f32(0.5), 48000)))
fade_out(id, 0.05)
__mix(800)
print("first {__mix_buf[0]:.4} last {__mix_buf[1598]:.4}")
__mix(800)
print("next first {__mix_buf[0]:.4}")
# delay: starts 100 frames into the mix
stop_all()
t0 = audio_time()
play(Sound(fill(f32(0.5), 1000)), delay = 100.0 / 48000.0)
__mix(200)
print("{__mix_buf[2 * 99]} {__mix_buf[2 * 100]:.2} clock moved {round((audio_time() - t0) * 48000.0)}")
print(midi_freq(69.0), round(note_freq("C4") * 100.0) / 100.0)
