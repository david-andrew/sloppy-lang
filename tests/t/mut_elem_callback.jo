# requires: sloppy
# a `mut` element of a global array (or map) given to a call that may run a function value, which
# could resize the array: passed as a copy, written back after the call
struct Foe:
    hp: int
    name: str
foes: Foe[] = [Foe(10, "a"), Foe(20, "b")]
m: {str: int} = {"a": 1}
grow = ():
    loop i in [0..100): foes.push(Foe(i, "x{i}"))
grow_map = ():
    loop i in [0..100): m["k{i}"] = i
think = (f: mut Foe, cb: () -> ()):
    cb()
    f.hp -= 1
    f.name = "{f.name}!"
bump = (x: mut int, cb: () -> ()):
    cb()
    x += 5
hit = (f: mut Foe):
    g = grow
    g()
    f.hp -= 100
by_param = (xs: mut Foe[]): think(xs[1], grow)
main = ():
    think(foes[0], grow)
    print(foes[0].hp, foes[0].name, foes.len())
    act: (mut Foe) -> () = hit
    act(foes[1])
    print(foes[1].hp, foes.len())
    bump(m["a"], grow_map)
    print(m["a"], m.len())
    n = 0
    loop mut f in foes:
        think(f, grow)
        n += 1
        if n == 2: break
    print(foes[0].hp, foes[0].name, foes[1].hp, foes[1].name, foes.len())
    by_param(foes)
    print(foes[1].hp, foes[1].name)
    foes.truncate(2)
    think(foes[0], grow)
    foes.truncate(2)
    before = alloc_count()
    loop k in [0..10):
        think(foes[0], grow)
        foes.truncate(2)
    print(alloc_count() - before, foes[0].hp, foes[0].name)
