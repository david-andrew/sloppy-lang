# requires: native
# requires: sloppy
# touch_ids: each finger keeps its number while it is down, in the order of touches(), when one
# that landed before it lifts too
# env: SLOPPY_SCREENSHOT=$TMP/touch_ids.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=10
# env: SLOPPY_INPUT=2:touch4=100x100,3:touch7=300x200,4:touch4=120x110,5:touch4-,6:touch2=50x60,7:touch7=310x210,8:touch7-,9:touch2-
window("t", 640, 360)
update = (dt: f64):
    if touches().len() > 0: print("f{frame_number()} ids {touch_ids()} at {touches()}")
draw = (): clear()
