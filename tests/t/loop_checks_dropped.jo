# requires: sloppy
# requires: native
# Release builds test a loop's indexes once in front of it and run it without checks (counting
# down too, by i - 1, by i + w for w the loop does not change, by an outer loop's i - 1 or
# (i - 1) * w + j, with globals read once in front): each index that is out of bounds still
# stops the program where it would, and the results are the same as with the checks
panics = (f: () -> int) -> bool:
    global __catch_jmp
    jb = __alloc(256)
    keep = __catch_jmp
    if __setjmp(jb) == 0:
        __catch_jmp = jb
        f()
        __catch_jmp = keep
        __free(jb)
        return false
    __catch_jmp = keep
    __free(jb)
    true

# 0/1 knapsack, counting down: dp[c - w] for c from cap down to w (and past it by slack)
knap = (ws: int[], vs: int[], cap: int, slack: int) -> int:
    dp = fill(0, cap + 1)
    loop i in 0..ws.len():
        w = ws[i]
        v = vs[i]
        loop c in cap, cap - 1..w - 1 - slack:
            dp[c] = max(dp[c], dp[c - w] + v)
    dp[cap]

# edit distance: prev[j - 1], b[j - 1] and a[i - 1] (an outer loop's)
edit = (a: str, b: str, from: int) -> int:
    prev = [loop j in 0..b.len() + 1: j]
    cur = fill(0, b.len() + 1)
    loop i in [1..a.len()]:
        cur[0] = i
        loop j in [from..b.len()]:
            c = if a[i - 1] == b[j - 1]: 0 else: 1
            cur[j] = min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + c)
        prev, cur = cur, prev
    prev[b.len()]

# xs[j + off] for an off the loop does not change
shifted = (xs: int[], off: int, n: int) -> int:
    s = 0
    loop j in [0..n): s += xs[j + off] * (j + 1)
    s

# flat 2D: g[(i - 1) * w + j - 1], i an outer loop's
flat = (g: int[], w: int, h: int, extra: int) -> int:
    s = 0
    loop i in [1..h]:
        loop j in [1..w + extra]:
            s += g[(i - 1) * w + j - 1] * j
    s

ws = [3 4 5 9 4]
vs = [3 4 4 10 4]
print(knap(ws, vs, 11, 0), knap(ws, vs, 20, 0))
print(panics((): knap(ws, vs, 11, 1)), panics((): knap([12], [1], 11, 0)))
print(edit("kitten", "sitting", 1), edit("sunday", "saturday", 1), panics((): edit("ab", "abc", 0)))
xs = [loop i in [0..10): i * i]
print(shifted(xs, 2, 8), shifted(xs, 0, 10), panics((): shifted(xs, 3, 8)), panics((): shifted(xs, -1, 5)))
gr = [loop i in [0..12): i]
print(flat(gr, 4, 3, 0), flat(gr, 3, 4, 0), panics((): flat(gr, 4, 3, 1)), panics((): flat(gr, 4, 4, 0)))

# the same at the top level, where the variables are globals
gdp = fill(0, 12)
loop i in 0..ws.len():
    w = ws[i]
    v = vs[i]
    loop c in 11, 10..w - 1:
        gdp[c] = max(gdp[c], gdp[c - w] + v)
print(gdp)
ga = "intention"
gb = "execution"
gprev = [loop j in 0..gb.len() + 1: j]
gcur = fill(0, gb.len() + 1)
loop i in [1..ga.len()]:
    gcur[0] = i
    loop j in [1..gb.len()]:
        c = if ga[i - 1] == gb[j - 1]: 0 else: 1
        gcur[j] = min(gprev[j] + 1, gcur[j - 1] + 1, gprev[j - 1] + c)
    gprev, gcur = gcur, gprev
print(gprev[gb.len()])
# a loop that changes a global it reads: read again each time
g = 0
hist = fill(0, 5)
loop k in [0..5):
    hist[k] = g
    g += k
print(hist, g)

# an if's value in a register: from both branches, and with one that stops the program
fib = (n: int) -> int: if n < 2: n else: fib(n - 1) + fib(n - 2)
pick = (c: bool) -> int:
    x = if c: 5 else: panic("no")
    x * 2
half = (x: f64) -> f64: if x > 1.0: x / 2.0 else: x
print(fib(20), pick(true), panics((): pick(false)), half(3.0), half(0.5))
# conditional moves: max, min and if values in a loop
m = 0
lo = 100
cnt = 0
loop i in [0..50):
    v = (i * 37) % 23
    m = max(m, v)
    lo = min(lo, v + 3)
    cnt += if v > 11: 1 else: 0
print(m, lo, cnt)
