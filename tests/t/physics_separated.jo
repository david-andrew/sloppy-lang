# requires: sloppy
# separated(): the pairs that stopped touching (a body leaving a sensor)
import physics
w = physics.World()
w.gravity = vec2(0, 0)
zone = w.add_box(vec2(500, 300), vec2(100, 100), kind = .fixed, sensor = true)
ball = w.add_circle(vec2(380, 300), 10)
w.set_velocity(ball, vec2(300, 0))
loop f in [0..90):
    w.step(1.0 / 60.0)
    loop c in w.contacts():
        if c.new: print("frame {f}: entered")
    loop pr in w.separated(): print("frame {f}: left {pr.0 == ball or pr.1 == ball}")
