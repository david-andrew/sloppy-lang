# requires: sloppy
# A fragment function's position field (its input's first) is read as gl_FragCoord itself in the
# generated GLSL, never through a struct holding a copy of it (Adreno 650 under ANGLE got its w
# wrong that way: logarithmic depth from i.pos.w hid what was near). Also through a helper given
# the input whole. A shader that makes a value of that type or changes its position keeps the copy;
# one that never reads it is translated as before.
struct FcV:
    pos: vec3
struct FcU:
    k: f32
struct FcO:
    pos: vec4
    tint: vec4
fc_vs = (v: FcV, u: FcU) -> FcO: FcO(vec4(v.pos, 1), vec4(1, 1, 1, 1))
fc_depth = (o: FcO) -> f32: log2(1.0 + 1.0 / o.pos.w) * 0.05
fc_direct = (i: FcO, u: FcU) -> vec4:
    set_depth(fc_depth(i))
    vec4(i.pos.xy / 800.0, i.pos.z, 1) * i.tint
fc_moved = (i: FcO, u: FcU) -> vec4:
    j = i
    j.pos.x += u.k
    j.pos * i.tint
fc_none = (i: FcO, u: FcU) -> vec4: i.tint * u.k
# the lines of a stage's text that say where the position comes from
fc_lines = (fs: str) -> str[]:
    out: str[]
    loop l in split(fs, "\n"):
        if "gl_FragCoord" in l or "S_FcO" in l and "(" in l and " i = " in l: out.push(trim(l))
    out
loop src in [shader(fc_vs, fc_direct), shader(fc_vs, fc_moved), shader(fc_vs, fc_none)]:
    loop l in fc_lines(src.fs): print(l)
    print("--")
