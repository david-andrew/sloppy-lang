# requires: native
# requires: sloppy
# without hud_nav, the keys and a gamepad do nothing to hud_ boxes (frames 0 to 39); with it on, a
# box drawn after hud_nav(false) is left out (the game's own HUD under its menu), and a name tells
# screens apart: each keeps its own focus, the frame it changes takes no keys
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=90
# env: SLOPPY_INPUT=3:enter+ 4:enter- 6:pad_a+ 7:pad_a- 9:space+ 10:space- 12:down+ 13:down- 15:enter+ 16:enter- 18:right+ 19:right- 21:pad_right+ 22:pad_right- 24:pad_down+ 25:pad_down- 27:pad_a+ 28:pad_a- 43:down+ 44:down- 46:enter+ 47:enter- 49:down+ 50:down- 52:down+ 53:down- 55:enter+ 56:enter- 58:up+ 59:up- 61:pad_a+ 62:pad_a- 64:down+ 65:down- 67:down+ 68:down- 70:pad_right+ 71:pad_right- 73:down+ 74:down- 76:pad_a+ 77:pad_a-
window("hud nav off", 1280, 720)
vol = 0.5
music = true
screen = "title"
draw = ():
    global music, screen, vol
    clear(rgb(0.1, 0.12, 0.16))
    on = frame_number() >= 40
    hud_nav(on, screen)
    if screen == "title":
        if hud_button(Rect(480, 160, 320, 44), "Play"): print("{frame_number()}: Play")
        if hud_button(Rect(480, 214, 320, 44), "Settings"):
            print("{frame_number()}: Settings")
            screen = "settings"
        vol = hud_slider(Rect(480, 268, 320, 40), vol, 0, 1, 0.1, "Volume")
        music = hud_checkbox(Rect(480, 318, 320, 32), "Music", music)
    else:
        if hud_button(Rect(480, 160, 320, 44), "Sound"): print("{frame_number()}: Sound")
        if hud_button(Rect(480, 214, 320, 44), "Back"):
            print("{frame_number()}: Back")
            screen = "title"
    hud_nav(false)
    if hud_button(Rect(20, 660, 120, 40), "Map"): print("{frame_number()}: Map")
    if frame_number() == 39 or frame_number() == 89: print("{frame_number()}: volume {vol} music {music}")
