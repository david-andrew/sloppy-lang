# sorting keeps equal elements in order; descending; tuples compare element by element; >, <=
# and >= come from <; split(s) splits at spaces; an `if` after a one-line loop's colon
# requires: sloppy
struct P:
    name: str
    score: int
(<) = (a: P, b: P) -> bool: a.score < b.score
ps = [P("d", 2), P("a", 1), P("c", 2), P("b", 1), P("e", 3)]
ps.sort_by((p: P): p.score)
print(ps.map((p: P): p.name))
print(sorted_by(ps, (p: P): p.score, descending = true).map((p: P): p.name))
print(sorted(ps, descending = true).map((p: P): p.name), P("x", 2) > P("y", 1), P("x", 1) >= P("y", 1), P("x", 2) <= P("y", 1))
xs: int[]
loop i in [0..1000): xs.push((i * 7919) % 1009)
ys = sorted(xs)
ok = true
loop i in [1..ys.len()): if ys[i - 1] > ys[i]: ok = false
print(ok, ys.len(), sorted([3, 1, 2], descending = true), sorted(["b", "a"]))
pairs = [(2, "b"), (1, "z"), (2, "a")]
print(sorted(pairs), max(pairs), (1, 2) < (1, 3), (2, 0) > (1, 9), (1, 2, 3) < (1, 2, 4))
print(split("  one two  three "), split("a,b", ","))
xs = [1, 2, 3, 4]
print(first(xs, 2), first(xs, 9), last(xs, 3), last(xs, 0), xs.last(9), first(xs))
