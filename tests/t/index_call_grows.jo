# requires: sloppy (an index whose call grows the array it indexes: the index is evaluated first)
struct N:
    a = 0
    b = 0
    c = 0
nodes: N[] = [N(1, 2, 3)]
grow = () -> int:
    loop i in [0..200000): nodes.push(N(i, i, i))
    0
x = nodes[grow()]
print(x)
nodes[0] = nodes[grow()]
print(nodes[0], nodes.len())
s = "abc"
ext = () -> int:
    s = s + "def"
    1
print(s[ext()])
