# requires: sloppy
# along an axis: reductions (keepdims), argmax and argmin, softmax and logsumexp; joining
# (concat, vstack, hstack); picking parts by an array of indexes or a mask (take, x[idx, ..])
m = [1.0 5.0 2.0; 4.0 3.0 6.0]
print(argmax(m, 1), argmin(m, 0), argmax(m, 0, keepdims = true).shape, argmax(m[0, ..]))
print(sum(m, 1, keepdims = true), max(m, 1, keepdims = true).shape, mean(m, 0, keepdims = true), min(m, 1))
print(m .- max(m, 1, keepdims = true))
s = softmax(m, 1)
print(s, sum(s, 1), softmax(m, 0).shape)
print(softmax([1.0, 2.0, 3.0]), softmax([1000.0, 1000.0]))
print(logsumexp(m, 1), logsumexp([1000.0, 1000.0]), logsumexp([-INF, -INF]), logsumexp([1.0, 2.0]), logsumexp([] as f64[]))
print(logsumexp(m, 0, keepdims = true), logsumexp([0.0 (-INF); INF 1.0], 1))
c = reshape([loop i in 0..24: f64(i)], 2, 3, 4)
print(sum(c, 2), sum(c, 1), max(c, 2), min(c, 0), argmax(c, 1), argmin(c, 2, keepdims = true).shape)
print(sum([1 2 3; 4 5 6], 1), max([1 9 3; 4 5 6], 1))

a = [1.0 2.0; 3.0 4.0]
print(concat(a, [5.0 6.0;]), concat(a, a, 1), concat([a, a, a], 0).shape, concat(c, c, 2).shape)
print(vstack([a[0, ..], a[1, ..]]), hstack([a, a]), hstack([a[0, ..], a[1, ..]]))
print(vstack([[1.0, 2.0], [3.0, 4.0]]))

x = reshape([loop i in 0..12: f64(i)], 4, 3)
idx = [2, 0]
print(x[idx, ..], x[idx], take(x, idx), take(x, [1, 1], 1))
print(x[.., [2, 0]], x[1..3, [0, 0, 2]])
print(x[[true, false, false, true], ..], x[[false, true, true, false]])
print(x[x[.., 0] .> 4.0, ..])
k = reshape([loop i in 0..24: i], 2, 3, 4)
print(k[.., [2], 1..3], take(k, [3, 0], 2))
print(x[[5], ..])
