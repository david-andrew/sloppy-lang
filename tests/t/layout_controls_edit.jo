# requires: sloppy
# requires: native
# Keyed editor state survives row reorder; Up/Down/Tab leave typing, Unicode limits count chars.
# env: SLOPPY_SCREENSHOT=$TMP/layout_controls_edit.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_NO_AUDIO=1
# env: SLOPPY_FRAMES=48
# env: SLOPPY_INPUT=3:enter+ 4:enter- 5:text=Ada,7:left+ 8:left- 11:text=X,13:ctrl+ 14:z+ 15:z- 16:ctrl- 17:tab+ 18:tab- 19:enter+ 20:enter- 21:text=Bee,23:escape+ 24:escape- 25:text=ignored,27:down+ 28:down- 29:enter+ 30:enter- 31:text=é😊,33:end+ 34:end- 35:text=XYZ,37:pad_b+ 38:pad_b- 39:pad_a+ 40:pad_a- 41:text=Z,43:pad_a+ 44:pad_a- 45:text=ignored
import layout as ui
window("Keyed text editing", 400, 240)
names = ["old", ""]
order = [0, 1]
draw = ():
    global names, order
    clear()
    if frame_number() == 9: order = [1, 0]
    ui.at(Rect(20, 20, 360, 200), gap = 20, ():
        loop k in order:
            ui.row(key = "row {k}", ():
                names[k] = ui.text_field(names[k], max_chars = if k == 0 and frame_number() >= 29: 3 else: 8, width = 300, height = 40, enabled = frame_number() < 45, key = "field {k}")
            )
    )
    f = frame_number()
    if f == 5: assert(names[0] == "Ada")
    if f == 11: assert(names[0] == "AdXa" and ui.get("field 0")!.focused)
    if f == 14: assert(names[0] == "Ada")
    if f == 17: assert(ui.get("field 1")!.focused and not ui.get("field 0")!.editing)
    if f == 21: assert(names[1] == "Bee")
    if f == 25: assert(names[1] == "Bee" and not ui.get("field 1")!.editing)
    if f == 27: assert(ui.get("field 0")!.focused)
    if f == 35:
        assert(names[0] == "é😊X")
        print("keyed caret and undo survive row reorder; Unicode limit ok")
    if f == 37: assert(not ui.get("field 0")!.editing)
    if f == 41: assert(names[0] == "Z")
    if f == 43: assert(ui.get("field 0")!.submitted)
    if f == 46:
        assert(names == ["Z", "Bee"] and not ui.get("field 0")!.editing)
        print("Tab, arrows, Escape/B, A and disabling keep text focus consistent")
