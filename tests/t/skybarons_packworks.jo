# requires: sloppy
# Sky Barons: the propeller pack's engine, moving: with the flywheel turned any way, the connecting rod is as long as it
# is made, the crosshead stays on the line of the piston's rod and goes up and down it the length of two cranks, and the
# crank's pin is the crank's length from the flywheel's middle (turning in the plane across the person)
import '../../examples/skybarons/models.jo'

lo = 1000.0
hi = -1000.0
worst_rod = 0.0
worst_pin = 0.0
worst_line = 0.0
loop k in 0..72:
    a = TAU * f64(k) / 72.0
    sp = models.pack_stroke(a)
    rod = f64(length(sp[0] - sp[1]))
    worst_rod = max(worst_rod, abs(rod - models.PACK_ROD))
    pin = f64(length(vec2(sp[0].y - models.PACK_WHEEL.y, sp[0].z - models.PACK_WHEEL.z)))
    worst_pin = max(worst_pin, abs(pin - models.PACK_CRANK))
    worst_line = max(worst_line, abs(f64(sp[1].x) - f64(sp[2].x)), abs(f64(sp[1].y) - f64(sp[2].y)))
    lo = min(lo, f64(sp[1].z))
    hi = max(hi, f64(sp[1].z))
print("the connecting rod stays its length {worst_rod < 0.0001}, the pin stays on the crank's circle {worst_pin < 0.0001}, the crosshead stays on the rod's line {worst_line < 0.0001}")
print("the crosshead's stroke: {int((hi - lo) * 1000.0 + 0.5)} mm, two cranks {int(2.0 * models.PACK_CRANK * 1000.0 + 0.5)} mm")
