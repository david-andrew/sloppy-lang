# requires: native
# requires: sloppy
# files dropped onto the window (SLOPPY_INPUT's drop=), in the frame they come; a file dialog's
# answer (SLOPPY_FILE_DIALOG), once; a drop's text/uri-list as paths; set_cursor's shape
# env: SLOPPY_SCREENSHOT=$TMP/dropped_files.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=5
# env: SLOPPY_INPUT=2:drop=notes.txt 2:drop=/tmp/b.md 3:o+
# env: SLOPPY_FILE_DIALOG=/home/a/x.txt|/home/a/y z.txt
window("drops", 400, 300)
asked = -1
print(__uri_paths("file:///tmp/a%20b%C3%A9.txt\r\n# a comment\r\nfile://host/x/y.png\r\nhttp://example.com/no\r\n"))
draw = ():
    global asked
    clear()
    if dropped_files().len() > 0: print("frame {frame_number()}: dropped {dropped_files()}")
    if key_pressed(.o):
        asked = open_file_dialog([".txt"], multiple = true)
        set_cursor(.wait)
    if asked >= 0:
        if let ps = file_dialog_result(asked):
            print("frame {frame_number()}: chose {ps}")
            asked = -1
            set_cursor(.hidden)
            print("hidden: {__cursor_hidden}")
            set_cursor(.ibeam)
            print("shown again: {not __cursor_hidden}")
    if frame_number() == 4: print("cursor: {__cursor_now}")
