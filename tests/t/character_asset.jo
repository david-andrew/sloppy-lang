# requires: sloppy
# The offline character starter's asset really has a skin and three distinct clips.
hero = load_model(embed("../../lib/new/character.glb"))
assert(hero.skins.len() == 1 and hero.skins[0].joints.len() == 7)
assert(model_size(hero).y > 1.8 and model_size(hero).y < 2.0)
assert(hero.parts.len() > 0 and hero.parts[0].skin == 0)
loop name in ["Idle", "Walk", "Run"]:
    k = find_animation(hero, name)
    assert(k >= 0)
    duration = animation_length(hero, k)
    p0 = pose_at(hero, k, 0.0)
    p1 = pose_at(hero, k, duration / 4.0)
    assert(abs(p1.r[3].x) > 0.01)
    print("{name}: skinned animation ok")
a: Animator
a.play(hero, "Idle")
a.update(hero, 0.1)
a.play(hero, "Run", fade = 0.2)
a.update(hero, 0.1)
assert(a.prev >= 0)
p = a.pose(hero)
current = pose_at(hero, a.current, a.time)
assert(abs(p.r[3].x - current.r[3].x) > 0.01)
a.update(hero, 0.2)
assert(a.prev < 0)
print("crossfade ok")
