# requires: sloppy
# requires: native
# Nearest's fast interior and general edge/repeat/nonfinite paths select the same
# texel. Linear filtering retains the scalar operation order in all four lanes.
id = __st_new()
__st_alloc(id, 2, 2)
p = __st[id].p
loop i in [0..16): p[i] = f32(i * i - 31) / 17.0
__st[id].linear = false
bits: u32 = 0x7f800000
inf = ((&bits) as *f32)[0]
bits = 0x7fc00000
nan = ((&bits) as *f32)[0]
coords: f32[] = [-10, -1, -0.01, 0, 0.25, 0.49, 0.5, 0.75, 0.999, 1, 1.1, 20, inf, -inf, nan]
loop rep in [false, true]:
    __st[id].rep = rep
    loop u in coords:
        loop v in coords:
            got = __sw_sample(id, vec2(u, v))
            x = __wrap(__floor_i((u * 2.0 - 0.5) + 0.5), 2, rep)
            y = __wrap(__floor_i((v * 2.0 - 0.5) + 0.5), 2, rep)
            loop ch in [0..4): assert(got[ch] == p[(y * 2 + x) * 4 + ch])
__st[id].linear = true
__st[id].rep = false
loop u in [f32(0.25), f32(0.3), f32(0.5), f32(0.65), f32(0.75)]:
    loop v in [f32(0.25), f32(0.3), f32(0.5), f32(0.65), f32(0.75)]:
        x = u * 2.0 - 0.5
        y = v * 2.0 - 0.5
        xi = __floor_i(x)
        yi = __floor_i(y)
        fx = x - f32(xi)
        fy = y - f32(yi)
        wa = (1.0 - fx) * (1.0 - fy)
        wb = fx * (1.0 - fy)
        wc = (1.0 - fx) * fy
        wd = fx * fy
        a = (yi * 2 + xi) * 4
        b = (yi * 2 + min(xi + 1, 1)) * 4
        c = (min(yi + 1, 1) * 2 + xi) * 4
        d = (min(yi + 1, 1) * 2 + min(xi + 1, 1)) * 4
        got = __sw_sample(id, vec2(u, v))
        loop ch in [0..4): assert(got[ch] == p[a + ch] * wa + p[b + ch] * wb + p[c + ch] * wc + p[d + ch] * wd)
print("software sampling paths ok")
