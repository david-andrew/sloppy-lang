# requires: native
# requires: sloppy
# swipe(): a drag's way as it ends (not a short one, nor one begun on a hud_ button); long_press():
# once, for a finger held still, and the button it was on then takes no tap
# env: SLOPPY_SCREENSHOT=$TMP/swipe_press.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=120
# env: SLOPPY_INPUT=3:touch1=300x300 4:touch1=360x310 5:touch1=420x320 6:touch1- 10:touch1=300x300 11:touch1=290x200 12:touch1- 15:touch1=300x300 16:touch1=310x305 17:touch1- 20:touch1=60x60 21:touch1=200x60 22:touch1- 25:touch1=60x60 26:touch1- 30:touch1=400x400 70:touch1- 75:touch1=60x60 110:touch1-
window("swipe", 640, 480)
update = (dt: f64):
    if let d = swipe(): print("frame {frame_number()}: swipe {d}")
    if long_press(): print("frame {frame_number()}: long press")
draw = ():
    clear()
    if hud_button(Rect(20, 20, 100, 80), "Menu"): print("frame {frame_number()}: Menu")
