# requires: sloppy
# requires: native
# requires: unix
# env: SLOPPY_SOFTWARE=1
# plane_mesh(size, tile): a texture repeats every `tile` meters (with set_repeat); without tile it
# covers the plane once, as before.
halves = image(2, 1)
set(halves, 0, 0, WHITE)
set(halves, 1, 0, BLACK)
t = texture(halves, smooth = false)
set_repeat(t, true)
once = plane_mesh(8)
tiled = plane_mesh(8, tile = 2)
# straight down on it: the plane fills the picture
shot = (m: Mesh) -> Image:
    render_image(64, 64, ():
        camera3d(vec3(0, 6, 0.001), vec3(0, 0, 0), 60)
        sun(vec3(0, 1, 0), disc = 0)
        fog(vec3(0, 0, 0), 0)
        shadows(false)
        draw_mesh(m, texture = t, specular = 0, emissive = 1)
        rect(Rect(0, 0, 1, 1), rgba(0, 0, 0, 0)))
# how many times the middle row turns from light to dark or back
turns = (img: Image) -> int:
    n = 0
    y = img.height / 2
    loop x in [1..img.width):
        a = img.pixels[(y * img.width + x) * 4] > 127
        b = img.pixels[(y * img.width + x - 1) * 4] > 127
        if a != b: n += 1
    n
a = turns(shot(once))
b = turns(shot(tiled))
assert(a >= 1 and a <= 2, "once: {a}")
assert(b >= 6, "tiled: {b}")
print("plane tile ok")
