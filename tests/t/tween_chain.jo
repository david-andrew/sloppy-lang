# requires: sloppy
# tweens one after another (a delay in the second: a pause), and done for a set of them
c = chain([tween(0.0, 10.0, 1.0, linear), tween(10.0, 0.0, 2.0, linear, delay = 0.5)])
loop k in [0..9):
    print("{c.t:.1}: {c.value():.2} {c.done()}")
    c.update(0.5)
ts = [tween(0.0, 1.0, 1.0), tween(0.0, 1.0, 2.0)]
loop mut t in ts: t.update(1.5)
print(done(ts))
