# requires: sloppy
empty: Set[int]
a = set([3, 1, 3, 2])
b = set([2, 4])
print(a.union(empty) == a, empty.union(a) == a)
print(a.intersection(empty), empty.difference(a), a.difference(a))
print(empty.is_subset(a), empty.is_subset(empty), a.is_subset(empty))
u = a.union(b)
u.remove(3)
print(a, b, u, a.intersection(b), a.difference(b))
print(a == set([2, 1, 3]), a.has(3), 4 not in a)
