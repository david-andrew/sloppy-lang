# requires: sloppy
# requires: unix
# env: TZ=EST5EDT,M3.2.0,M11.1.0
# Local date arithmetic across a fixed daylight-saving transition, independent of the host.
a = parse_date("2024-03-10 01:30", "%F %R")!
fixed = date_add(a, 3600.0)
local = date_add(a, 3600.0, local = true)
print(date_text(a), a.offset)
print(date_text(fixed), fixed.offset)
print(date_text(local), local.offset, date_diff(local, a))
print(date_text(date(unix_time(local), utc = true)))
