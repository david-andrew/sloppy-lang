# requires: sloppy
# a function that always ends the program (its last line exit or panic) gives no value, so a
# path through it needs none: parse's last line
die = (msg: str):
    print("error: {msg}")
    exit(0)

parse = (s: str) -> int:
    if let n = to_int(s): return n
    die("not a number: {s}")

print(parse("12") + 1)
x = parse("zz")
print("not here {x}")
