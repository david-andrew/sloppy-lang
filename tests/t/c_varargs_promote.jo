# requires: sloppy
# requires: native
# C's variadic arguments get C's promotions: an f32 goes as a double, and small integers and
# bools as an int (with the count of vector registers in al on x86-64)
when TARGET == "windows":
    @lib("msvcrt.dll")
    @variadic(2)
    extern sprintf = (buf: *u8, fmt: *u8, a: f32, b: i8, c: u8, d: u16, e: bool, f: f64, g: f32) -> i32
else:
    @lib("libc.so.6")
    @variadic(2)
    extern sprintf = (buf: *u8, fmt: *u8, a: f32, b: i8, c: u8, d: u16, e: bool, f: f64, g: f32) -> i32
b = fill(u8(0), 100)
n = sprintf(data(b), data("%.2f %d %d %d %d %.3f %.1f\0"), f32(2.5), i8(-3), u8(200), u16(60000), true, 3.14159, f32(-1.5))
print(str_from_bytes(b[..n)))
