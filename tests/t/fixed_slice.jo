# requires: sloppy
# a slice of a fixed-size array is a T[] (a copy), as one of a T[] is; a T[N] passed for a
# `mut T[]` parameter (sort, reverse, shuffle, your own) is changed in place, keeping its length
struct Inv:
    slots: int[6]
    names: str[3]

three = () -> int[3]: [7, 8, 9]

double_all = (xs: mut int[]):
    loop mut x in xs: x *= 2

grow = (xs: mut int[]):
    xs.push(1)

g: int[3] = [3, 1, 2]
bump = (xs: mut int[]):
    xs[0] += 100
    g[1] = 50                       # (the copy going back after the call writes over this)

a: int[4] = [10, 20, 30, 40]
print(a[1..3], a[[1..3]], a[1..], a[..2], a[[1..end]], a[end])
lo = 1
hi = 3
print(a[lo..hi], a[[lo..hi]], a[hi..hi], a[0..0].len())
inv = Inv()
loop i in 0..6: inv.slots[i] = i * i
inv.names = ["a", "bb", "ccc"]
print(inv.slots[2..5], inv.slots[[2..5]], inv.slots[3..], inv.slots[1..4][1..])
s = inv.names[1..3]
s.push("dd")
print(s, inv.names, inv.names[..1])
print(three()[1..])
loop x in a[2..]: print(x)
f: f32[2] = [1.5, 2.5]
print(f[0..1], f[1..])

# what a T[] does
print(a.len(), len(a), a, "{a}", 30 in a, a.contains(31), a == [10, 20, 30, 40])
print(min(a), max(a), sum(a), a.index_of(30), a.first(), a.last(), a.map((x): x / 10))
print(a.filter((x): x > 15), a.any((x): x > 35), a.all((x): x > 5), a.count((x): x > 15))

# changed in place by functions taking mut T[]
b: int[5] = [5, 3, 9, 1, 4]
sort(mut b)
print(b)
b.reverse()
print(b)
double_all(mut b)
print(b)
inv.names = ["dd", "b", "ccc"]
inv.names.sort_by((w): len(w))
print(inv.names)
ps = [Inv(), Inv()]
ps[1].names = ["z", "x", "y"]
sort(mut ps[1].names)
print(ps[1].names)
loop mut p in ps: p.slots[0] = 5
k = 0
next = () -> int:
    k += 1
    k - 1
double_all(mut ps[next()].slots)
print(k, ps[0].slots, ps[1].slots)
bump(mut g)
print(g)
# (a function taking the T[N] itself, or any T, goes before one taking a T[])
which = (xs: mut int[]) -> str: "T[]"
which = (xs: mut int[3]) -> str: "T[3]"
which2[T] = (xs: mut T[]) -> str: "T[]"
which2[T] = (x: mut T) -> str: "T"
print(which(mut g), which2(mut g), which2(mut s))
grow(mut b)
