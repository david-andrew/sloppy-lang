# requires: sloppy
# requires: native
# parallel jobs of changing sizes, one after another: every index of each runs exactly once, and
# all have finished when the call returns (a worker held up after claiming past the end of one job
# once took a chunk of the next, which then ran twice and was counted done twice)
bad = 0
seed_random(1)
cnt = fill(0, 512)
cp = data(cnt)
loop round in [0..3000):
    n = random_int(1, 500)
    loop i in [0..n): cp[i] = 0
    xs = parallel_range(n, (i: int):
        x = 0
        loop k in [0..20): x += k * i
        __atomic_add(cp + i, 1)
        x)
    loop i in [0..n):
        if cp[i] != 1 or xs[i] != 190 * i:
            bad += 1
            break
print("bad {bad}")
