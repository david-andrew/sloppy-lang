# requires: sloppy
# a map or array literal where a Json goes is one: its values of any types, each made a Json
import http
user: Json = {"name": "ann", "age": 31}
print(to_json({"ok": true, "count": 3, "user": user, "tags": ["a", "b"], "mixed": [1, "two", none, 2.5], "nested": {"x": {"y": [true]}}}))
print(to_json([1, 2, 3]))
print(to_json({"a": 1, "b": 2}))
r = http.json({"ok": false, "error": "nope", "code": 7})
print(str_from_bytes(r.body))

reply = (id: int) -> Json: {"id": id, "done": false}
print(reply(4))
j: Json = []
print(to_json(j))
