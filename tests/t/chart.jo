# requires: native
# requires: sloppy
# charts drawn into pictures with no window: bars in the palette's colors, side by side, on a
# white background; a line chart and a histogram draw too; the ticks are round numbers
c = Chart(title = "Units")
c.bars(["a", "b", "c"], [10.0, 20.0, 30.0], "one")
c.bars(["a", "b", "c"], [5.0, 25.0, 15.0], "two", color = rgb(0, 0.6, 0))
img = chart_image(c, 300, 200)
px = (x: int, y: int) -> int[]:
    i = (y * img.width + x) * 4
    [int(img.pixels[i]), int(img.pixels[i + 1]), int(img.pixels[i + 2])]
print(img.width, img.height, px(2, 2))
# (the tallest bar, c's first: near the plot's right, its top close to the plot's top)
found = false
loop x in [150..300):
    p = px(x, 120)
    if abs(p[0] - 31) < 8 and abs(p[1] - 120) < 8 and abs(p[2] - 181) < 8: found = true
print(found)
l = Chart()
l.line([1.0, 4.0, 9.0], "squares")
h = Chart()
h.histogram([1.0, 2.0, 2.5, NAN, 3.0], 3)
print(chart_image(l, 200, 100).width, chart_image(h, 200, 100).height, h.series[0].ys)
print(__chart_step(97.0, 5), __chart_step(0.37, 4), __chart_num(2500.0, 500.0), __chart_num(0.25, 0.05), __chart_num(3e6, 1e6))
