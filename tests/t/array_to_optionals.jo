# requires: sloppy
# a T[] where a T?[] is expected: a copy, its elements as optionals
count = (xs: int?[]) -> int:
    n = 0
    loop x in xs:
        if x != none: n += 1
    n
ys: int[] = [1 2 3]
print(count(ys))
print(count([4 5]))
zs: int?[] = ys
zs[0] = none
print(ys)
print(zs)
first[T] = (xs: T?[]) -> T?: xs[0]
print(first(["a" "b"]))
struct P:
    x: int
ps = () -> P?[]: [P(1) P(2)]
print(ps().len())
