# requires: sloppy
# requires: native
# requires: unix
# env: SLOPPY_SOFTWARE=1
# meshes and instance buffers the program lets go of are deleted (their buffers, as a frame
# starts); those it keeps, and copies of them, still draw
hold_clock = ():
    global __fixed_step
    __fixed_step = true
hold_clock()
kept = cube_mesh(0.8)
copies: Mesh[]
copies.push(kept)
insts: Instance3D[]
nothing: Instance3D[]
loop i in [-2..3): insts.push(instance(translation(vec3(f32(i) * 1.1, 0, 0))))
kept_insts = instance_buffer(insts)
alive_buffers = () -> int:
    n = 0
    loop b in __s_buffers: if b.len() > 0: n += 1
    n
start = alive_buffers()
# (thousands made and dropped, as a frame starts after each few: the list stays near what is held)
most = 0
loop i in [0..3000):
    m = cube_mesh(0.1 + f64(i % 7) * 0.1)
    b = instance_buffer(insts)
    e = instance_buffer(nothing)
    if i % 10 == 0:
        __gl_reclaim()
        most = max(most, __gl_life.len())
__gl_reclaim()
print("held at most", most <= 1024, "buffers alive", alive_buffers() - start <= 2 * 1024)
picture = render_image(48, 48, ():
    clear(BLACK)
    camera3d(vec3(0, 1, 6), vec3(0, 0, 0), 60)
    sun(vec3(-1, 2, 1))
    draw_mesh(copies[0], translation(vec3(0, 1.2, 0)))
    draw_mesh_instanced(kept, kept_insts))
lit = 0
loop i in [0..48 * 48): if picture.pixels[i * 4] > 20 or picture.pixels[i * 4 + 1] > 20: lit += 1
print("kept ones drawn", lit > 100)
