# requires: sloppy
# A keyboard-only fixed update does not activate pads. The first reader in a later step
# starts polling and sees its button/stick presses in that very step, without a device.
run = ():
    when TARGET == "windows":
        global __w32_hid, __w32_hid_retry, __xi_retry
        fixed_update(1.0 / 60.0, (dt: f64): pass)
        assert(not __w32_pad_started)
        __xi_retry = fill(elapsed() + 60.0, 4)
        __w32_hid_retry = elapsed() + 60.0
        __w32_hid = [__HidPad(handle = 123, buttons = [__HidButtons(9, 0, 0, 1, 1, down = 1)],
            values = [__HidValue(1, 0, 0, 0x30, 8, 0, 255, value = 1.0, unit = 1.0)])]
        action("right", [.stick(0, 1)], player = 0)
        fixed_update(1.0 / 60.0, (dt: f64):
            assert(not __w32_pad_started)
            assert(gamepad_pressed(0, .a))
            assert(__w32_pad_started)
            assert(action_pressed("right"))
        )
        __pad_frame()
        fixed_update(1.0 / 60.0, (dt: f64):
            assert(not gamepad_pressed(0, .a))
            assert(not action_pressed("right"))
        )
        __w32_hid_remove(123)
        __pad_frame()
run()
print("Windows first-use fixed-step input ok")
