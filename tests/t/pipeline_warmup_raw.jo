# requires: sloppy
# requires: native
# env: SLOPPY_VULKAN=1
# env: SLOPPY_SCREENSHOT=$TMP/pipeline_warmup_raw.png
# env: SLOPPY_FRAMES=8
# env: SLOPPY_WINDOW=160x90
# env: SLOPPY_VK_PIPELINE_CACHE=0
# env: SLOPPY_NO_AUDIO=1
# Raw instance arrays may first appear in a later effect, without an instance_buffer load.
# The initial regular 3D pass must prepare both instanced lit and shadow pipelines for them.
window("Raw instance warm-up", 160, 90)
verts = gpu_buffer([Vertex3D(vec3(-1, -1, 0)), Vertex3D(vec3(1, -1, 0)), Vertex3D(vec3(0, 1, 0))])
box = gpu_mesh(verts)
when TARGET != "wasm" and TARGET != "macos":
    if __vk:
        assert(__warm_3d_layouts == 3)
        n = __vg_pipeline_creations
        gpu_mesh(verts)
        assert(__vg_pipeline_creations == n)
loaded = 0
update = (dt: f64):
    global loaded
    when TARGET != "wasm" and TARGET != "macos":
        if __vk and frame_number() == 1:
            assert(__warm_3d_layouts == 3)
            loaded = __vg_pipeline_creations
        if __vk and frame_number() > 1: assert(__vg_pipeline_creations == loaded)
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    draw_mesh(box)
    if frame_number() >= 4:
        raw = [Instance3D(transform(vec3(1, 0, 0)), WHITE)]
        draw_mesh_instanced(box, raw)
on_quit = ():
    when TARGET != "wasm" and TARGET != "macos":
        if __vk: assert(__vg_pipeline_creations == loaded)
    print("raw instance warm-up ok")
