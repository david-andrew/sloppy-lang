# requires: sloppy
# requires: native
# on_quit in a program with no window: it runs as the program ends; asked to stop (SIGTERM, here
# sent to itself), a loop on stopping() ends and the program goes on to its end
done = 0

on_quit = (): print("on_quit: {done} rounds")

loop not stopping():
    done += 1
    if done == 3:
        when TARGET == "windows":
            __stop_asked = true
        else:
            syscall(62, syscall(39), 15)              # kill(getpid(), SIGTERM)
    sleep(0.01)
print("stopped: {stopping()}")
