# requires: native
# requires: sloppy
# A shader writing more colors than the target drawn into has panics, saying so; as many or
# fewer is fine (the others left as they are).
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=2
struct V:
    pos: vec2
struct U:
    k: f32
struct O:
    pos: vec4
struct Two:
    a: vec4
    b: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1))
fs = (i: O, u: U) -> Two: Two(vec4(1, 0, 0, 1), vec4(0, 1, 0, 1))
sh = make_shader(shader(vs, fs))
tri = mesh([V(vec2(-1, -1)), V(vec2(3, -1)), V(vec2(-1, 3))])
two = render_target(32, 32, colors = 2)
three = render_target(32, 32, colors = 3)
one = render_target(32, 32)
draw = ():
    draw_to(two)
    draw(sh, tri, U(0))
    draw_to(three)
    draw(sh, tri, U(0))
    print("two colors into two and three")
    draw_to(one)
    draw(sh, tri, U(0))
    print("not reached")
    draw_to_screen()
