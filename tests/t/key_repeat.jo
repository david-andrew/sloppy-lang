# requires: native
# requires: sloppy
# key_repeat: true as a key is pressed, then after a quarter second 15 times a second while it is
# held (PICO-8's btnp), the same in fixed_update's steps; gamepad_repeat and action_repeat too
# env: SLOPPY_SCREENSHOT=$TMP/repeat.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=100
# env: SLOPPY_INPUT=5:z+,45:z-,50:pad_a+,72:pad_a-,74:x+,75:x-,80:x+,98:x-
action("fire", [.key(.x), .button(.b)])
keys: int[]
steps: int[]
pads: int[]
fires: int[]
typed = 0

update = (dt: f64):
    global typed
    if key_repeat(.z): keys.push(frame_number())
    if key_typed(.z): typed += 1
    if gamepad_repeat(.a): pads.push(frame_number())
    # (asked again in the same frame: the same answer)
    if action_repeat("fire") and action_repeat("fire"): fires.push(frame_number())
    fixed_update(dt, (h: f64):
        if key_repeat(.z): steps.push(frame_number()))
    if frame_number() == 99:
        print("key {keys}")
        print("steps {steps}")
        print("typed {typed}")
        print("pad {pads}")
        print("action {fires}")
