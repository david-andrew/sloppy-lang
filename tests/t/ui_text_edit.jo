# requires: native
# requires: sloppy
# ui_text_field edits at a caret as hud_text_field does: home, typing there, left, backspace
# before the caret, ctrl+A and typing over it; tab goes on to the next item, shift+tab back
# env: SLOPPY_SCREENSHOT=$TMP/ui_text_edit.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=30
# env: SLOPPY_INPUT=2:text=bob 3:home+ 4:home- 5:text=X 6:right+ 7:right- 8:backspace+ 9:backspace- 10:tab+ 11:tab- 12:text=paris 13:shift+ 14:tab+ 15:tab- 16:shift- 17:ctrl+ 18:a+ 19:a- 20:ctrl- 21:text=Z
name = ""
city = ""
last = ""
draw = ():
    global city, last, name
    clear(rgb(0.1, 0.1, 0.15))
    ui_begin("form", vec2(640, 200))
    name = ui_text_field("Name", name)
    city = ui_text_field("City", city)
    ui_end()
    s = "name '{name}' city '{city}'"
    if s != last: print("{frame_number()}: {s}")
    last = s
