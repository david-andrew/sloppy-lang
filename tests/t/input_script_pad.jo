# requires: native
# requires: sloppy
# SLOPPY_INPUT's gamepad: a button pressed and let go, a stick moved, a trigger pulled
# env: SLOPPY_SCREENSHOT=$TMP/pad.png
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FRAMES=12
# env: SLOPPY_INPUT=3:pad_a+,5:pad_a-,6:lstick=1x-0.5,6:lt=0.8
draw = ():
    if gamepad_pressed(.a): print("frame {frame_number()}: a pressed ({gamepad_name(0)})")
    if gamepad_released(.a): print("frame {frame_number()}: a let go")
    s = left_stick()
    if frame_number() == 8: print("stick {s.x:.1} {s.y:.1}, lt {gamepad_axis(4):.1}")
    if frame_number() == 12: quit()
