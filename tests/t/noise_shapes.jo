# requires: sloppy
# noise along a line, on a plane and in space stays in [0, 1] and is smooth
lo = 1.0
hi = 0.0
jump = 0.0
prev = noise(0.0)
loop i in [0..2000):
    t = f64(i) * 0.01
    a = noise(t)
    b = noise(t, t * 0.7)
    c = noise(t, t * 0.3, t * 0.5)
    lo = min(lo, min(a, min(b, c)))
    hi = max(hi, max(a, max(b, c)))
    jump = max(jump, abs(a - prev))
    prev = a
print(lo >= 0.0, hi <= 1.0, hi - lo > 0.8, jump < 0.05)
