# requires: native
# requires: sloppy
# a loaded font's missing characters come from the built-in font (width and pixels); wrapping
# breaks between CJK characters, keeping 。 off a line's start; text(chars = n) draws the first
# n; arrays' get(i); resized; free_texture
z_builtin = text_width("Z", 40)
tiny = load_font(embed("data/tiny.ttf"))
set_font(tiny)
print(text_width("Z", 40) == z_builtin, text_width("IZ", 40) > z_builtin)
set_font()
print(wrap_text("今日はとても良い天気ですね。散歩に行きましょう。", 120, 20))
img = render_image(80, 40, ():
    clear(WHITE)
    set_font(tiny)
    text("IZ", vec2(4, 0), 36, BLACK)
    set_font()
    t = texture(image(2, 2, vec4(1, 0, 0, 1)))
    free_texture(t))
dark = 0
loop x in [22..40):
    loop y in [0..40):
        if img.get(x, y).x < 0.5: dark += 1
print("Z drawn:", dark > 20)
shown = render_image(100, 30, ():
    clear(WHITE)
    text("MMMMMM", vec2(0, 0), 24, BLACK, chars = 2))
inked = (x0: int, x1: int) -> bool:
    any = false
    loop x in [x0..x1):
        loop y in [0..30):
            if shown.get(x, y).x < 0.5: any = true
    any
print("first two drawn:", inked(0, 30), "the rest not:", not inked(50, 100))
xs = [10, 20]
print(xs.get(1), xs.get(2), xs.get(-1) ?? 0)
small = image(4, 4, vec4(1, 1, 1, 1)).resized(2, 2)
print(small.width, small.height, small.get(1, 1))
