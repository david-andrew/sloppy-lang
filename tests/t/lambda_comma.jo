# requires: sloppy
# a lambda's indented body inside a call ends at a comma whose line goes on to close the call or to start another lambda; a tuple (a, b = b, a) or loop k, v in m inside the body stays
call2 = (f: () -> void, n: int):
    f()
    print(n)
call2(():
    print("a"), 5)
call3 = (f: () -> void, g: (int) -> int, n: int):
    f()
    print(g(n))
call3(():
    print("b"), (x):
        x * 2, 7)
h = (f: () -> void): f()
h(():
    a = 1
    b = 2
    a, b = b, a
    print(a, b))
print([loop x in [1, 2]: x], (1, 2))
m = {"a": 1}
h2 = h
h2(():
    loop k, v in m:
        print(k, v)
    print("done"))
