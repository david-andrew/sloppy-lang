# requires: native
# requires: sloppy
# file operations for scripts: make_dirs, append_file, copy_file, rename_file, walk_dir, glob,
# file_time, delete_dir (only when empty)
d = "{temp_dir()}/sloppy_file_ops_{time_ns()}"
print(make_dirs("{d}/y/z"), is_dir("{d}/y/z"))
print(write_file("{d}/y/z/f.txt", "hi"), append_file("{d}/y/z/f.txt", " there"), read_file("{d}/y/z/f.txt")!)
print(copy_file("{d}/y/z/f.txt", "{d}/g.txt"), rename_file("{d}/g.txt", "{d}/h.jo"), file_exists("{d}/g.txt"))
print(walk_dir(d))
n = len(d) + 1
print([loop p in glob("{d}/**/*.txt"): p[n..]], [loop p in glob("{d}/*.jo"): p[n..]], [loop p in glob("{d}/y/*/f.???"): p[n..]])
print(abs(file_time("{d}/h.jo")! - unix_time()) < 60.0, file_time("{d}/nope") == none)
print(delete_dir("{d}/y/z"), delete_file("{d}/y/z/f.txt"), delete_dir("{d}/y/z"), is_dir("{d}/y/z"))
delete_file("{d}/h.jo")
delete_dir("{d}/y")
print(delete_dir(d), is_dir(d))
