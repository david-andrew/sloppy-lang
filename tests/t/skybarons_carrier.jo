# requires: sloppy
# Sky Barons' flying carrier: a hook's craft a seat, let go (F) its seat gone and the craft flying
# off as it hung, its player in it; flown through its window under the stern (slow enough, a hook
# free) caught, the seat back, the craft as it was, hoisted to its hook (not let go again till it
# is up there) and mended on it; too fast, or wide of the window, not caught; a seat that is not there not taken; the computer
# letting its craft go with the other side near, its airmen flying them; gasbags burst, less
# lift, three and it is down; downed, the computer's people in its craft let go in its last
# seconds, the rest lost with it
use '../../examples/skybarons/world.jo'
use '../../examples/skybarons/sim.jo'

set_map(FARMLAND)
fresh = () -> Game:
    let g = new_game([0, 1, -1, -1, -1, -1], 0.65, Rules(mode = DOGFIGHT), [])
    loop i in 0..g.people.len():
        g.people[i].state = DEAD
        g.people[i].timer = 1000000
    g
sit = (g: mut Game, i: int, j: int, s: int):
    g.crafts[j].seats[s] = i
    g.people[i].state = SEATED
    g.people[i].craft = j
    g.people[i].seat = s
open_seats = (g: Game, j: int) -> int: g.crafts[j].seats.filter((k): k != SHUT).len()
on_hooks = (g: Game, j: int) -> int: g.crafts[j].hung.filter((k): k >= 0).len()
pads = (a: Pad = Pad(), b: Pad = Pad()) -> Pad[]: [a, b]

let g = fresh()
g.crafts.push(flying_craft(CARRIER, 0, vec3(0, 500, 0), vec3(1, 0, 0)))
j = g.crafts.len() - 1
print("carrier: {KINDS[CARRIER].seats.len()} seats, {open_seats(g, j)} there, {on_hooks(g, j)} craft on its hooks: {g.crafts[j].hung}")
sit(g, 2, j, 0)
sit(g, 0, j, HOOK0 + 6)
g.crafts[j].hhealth[6] = 70
# (player 0 lets the fighter on hook 6 go: in it, flying)
g = tick(g, pads(Pad(enter = true)))
k = g.people[0].craft
d = g.crafts[k]
print("let go: player 0 in craft {k} ({KIND_NAMES[d.kind]}), seat {g.people[0].seat}, health {d.health}, from {d.mother}; hook seat {g.crafts[j].seats[HOOK0 + 6]}, {open_seats(g, j)} seats there, {on_hooks(g, j)} on hooks")
print("  below its hook: {f64(point_of(g.crafts[j], hung_at(6, FIGHTER)).y - d.pos.y) > 0.0}, falling {d.vel.y < 0.0}")
# (no one takes a seat that is not there)
sit(g, 1, j, 1)
g = tick(g, pads(Pad(), Pad(seat = HOOK0 + 7)))
print("a seat not there: player 1 still in seat {g.people[1].seat}")
g.people[1].state = DEAD
g.crafts[j].seats[1] = -1
# (caught: through its window, slowly; too fast, or wide of it, not)
loop t in 0..LAUNCH_SAFE: g = tick(g, pads())
# (craft k put `back` m astern of the window, `off` aside, closing at `speed`; ticked till it is
# past the window's plane or caught; whether it said PASSED)
through = (g: mut Game, k: int, back: f64, off: f64, speed: f64) -> bool:
    c = g.crafts[j]
    g.crafts[k].pos = point_of(c, WIN_AT + vec3(f32(off), 0, f32(back)))
    g.crafts[k].rot = c.rot
    g.crafts[k].vel = c.vel + fwd_of(c) * f32(speed)
    passed = false
    loop t in 0..40:
        if g.crafts[k].free: break
        g = tick(g, pads())
        loop b in g.booms:
            if b.tick == g.tick and b.kind == PASSED and b.who == k: passed = true
    passed
said = through(g, k, 4.0, 0.0, 50.0)
print("too fast through it: {on_hooks(g, j)} on hooks, player 0 in craft {g.people[0].craft}, said {said}")
said = through(g, k, 3.0, 22.0, 18.0)
print("wide of it: {on_hooks(g, j)} on hooks, player 0 in craft {g.people[0].craft}, said {said}")
g.crafts[k].health = 55
said = through(g, k, 3.0, 3.0, 18.0)
h = g.people[0].seat - HOOK0
print("caught: craft {k} free {g.crafts[k].free}; player 0 in craft {g.people[0].craft}, hook {h} ({KIND_NAMES[g.crafts[j].hung[h]]}, health {g.crafts[j].hhealth[h]}); {open_seats(g, j)} seats there, {on_hooks(g, j)} on hooks")
g = tick(g, pads(Pad(enter = true)))
g = tick(g, pads())
print("F while it is hoisted: still on hook {h} {g.crafts[j].hung[h] >= 0}, hoisting {hoisting(g, g.crafts[j], h)}")
loop t in 0..HOIST: g = tick(g, pads())
print("up on its hook {HOIST / 60} s later: hoisting {hoisting(g, g.crafts[j], h)}")
loop t in 0..60 * 30: g = tick(g, pads())
print("mended on its hook in 30 s: health {g.crafts[j].hhealth[h]}")

# the computer's: one of the other side near, its craft let go one by one, its airmen flying them
let a = fresh()
a.crafts.push(flying_craft(CARRIER, 0, vec3(0, 500, 0), vec3(1, 0, 0)))
ci = a.crafts.len() - 1
sit(a, 2, ci, 0)
a.crafts.push(flying_craft(FIGHTER, 1, vec3(0, 520, -700), vec3(0, 0, 1)))
loosed = 0
loop t in 0..60 * 6:
    a = tick(a, pads())
    loop b in a.booms:
        if b.tick == a.tick and b.kind == LOOSED: loosed += 1
airmen = a.crafts.filter((x): x.airman and not x.free).len()
print("the other side near: {loosed} let go in 6 s, {airmen} flown by airmen, {on_hooks(a, ci)} on hooks, {open_seats(a, ci)} seats there")

# gasbags: one gone it lifts less, two and it settles, three and it is down
let b = fresh()
b.crafts.push(flying_craft(CARRIER, 0, vec3(0, 500, 0), vec3(1, 0, 0)))
bi = b.crafts.len() - 1
loop n in 0..3:
    c = b.crafts[bi]
    hurt_craft(b, bi, 1, 1, BAG_HEALTH / 2, point_of(c, vec3(0, f32(BAG_Y), f32(CARRIER_BAGS[n]))), fire = true)
    print("gasbag {n + 1} hit by fire: bags {b.crafts[bi].bags}, lift {bag_lift(b.crafts[bi])}, hull {b.crafts[bi].health}, down {b.crafts[bi].down > 0}")
c = b.crafts[bi]
hurt_craft(b, bi, 1, 1, 300, point_of(c, vec3(20, 0, 30)))
print("its frame hit: hull {b.crafts[bi].health}")

# downed: the computer's person in a hook's craft lets it go; the airmen's craft lost with it
let e = fresh()
e.crafts.push(flying_craft(CARRIER, 0, vec3(0, 500, 0), vec3(1, 0, 0)))
ei = e.crafts.len() - 1
sit(e, 2, ei, 0)
sit(e, 4, ei, HOOK0 + 12)
e.crafts[ei].health = 0
e.crafts[ei].down = 1
loop t in 0..CARRIER_LAST + 10: e = tick(e, pads())
print("downed: person 4 in craft {e.people[4].craft} ({KIND_NAMES[e.crafts[e.people[4].craft].kind]}, seat {e.people[4].seat}); {on_hooks(e, ei)} still on hooks")
loop t in 0..60 * 20: e = tick(e, pads())
print("down: wreck {e.crafts[ei].gone > 0}, {on_hooks(e, ei)} on hooks")
