# requires: sloppy
# an element passed as `mut` to a call that runs code changing its array: added at the end, it
# is put back; moved, gone or changed, it panics rather than writing over another element
struct E:
    name: str
    hp: int
es = [E("a", 10), E("b", 20)]
hit = (e: mut E, f: () -> void):
    e.hp -= 1
    f()
    e.hp -= 1
hit(es[0], (): es.push(E("c", 30)))
print(es)
hit(es[0], (): es.remove_at(2))
print(es)
hit(es[1], (): es[0].hp = 5)
print(es)
grid = [[E("x", 1)], [E("y", 2)]]
hit(grid[1][0], (): grid[0].push(E("z", 3)))
print(grid)
cb: () -> void = (): es.remove_at(0)
hit(es[0], cb)
