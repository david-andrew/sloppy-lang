# requires: native
# requires: sloppy
# hud_nav_box: a box the game draws itself, focused and chosen as a hud_button is (Enter, A, a
# click or tap), with hud_nav's ring drawn around it over the game's drawing, or with ring = false
# none, the game drawing its own look as hud_nav_focused says; without hud_nav a click still
# chooses it, and the mouse over it counts in hud_hovered
# env: SLOPPY_SOFTWARE=1
# env: SLOPPY_FIXED_STEP=1
# env: SLOPPY_FRAMES=40
# env: SLOPPY_INPUT=3:down+ 4:down- 6:enter+ 7:enter- 9:pad_right+ 10:pad_right- 14:pad_a+ 15:pad_a- 17:mouse=350x300 18:mouse_left+ 19:mouse_left- 32:mouse_left+ 33:mouse_left- 35:enter+ 36:enter-
window("hud nav box", 1280, 720)
cards = [Rect(200, 200, 300, 200), Rect(600, 200, 300, 200)]
was = "-"
draw = ():
    global was
    clear(rgb(0.1, 0.12, 0.16))
    hud_style.focus = rgb(1, 0, 0)
    f = frame_number()
    hud_nav(f < 30)
    if hud_button(Rect(200, 100, 200, 44), "Tab"): print("{f}: Tab")
    now = "-"
    loop i in 0.. and r in cards:
        # (the game's own look: green while hud_nav's focus is on it)
        lit = hud_nav_focused(r)
        rect(f64(r.x), f64(r.y), f64(r.w), f64(r.h), if lit: rgb(0, 0.8, 0) else: rgb(0.2, 0.2, 0.3))
        if hud_nav_box(r, ring = i == 0): print("{f}: card {i}")
        if hud_nav_focused(r) != lit: print("{f}: focused differs before and after")
        if lit: now = "card {i}"
    if now != was: print("{f}: focus {now}")
    was = now
    if f == 18: print("{f}: hovered {hud_hovered()}, active {hud_nav_active()}")
    # (the ring: red just outside card 0's left edge, none outside card 1's)
    if f == 8 or f == 12:
        img = screenshot()
        k = f64(img.width) / 1280.0
        red = (x: int, y: int) -> bool:
            q = (int(f64(y) * k) * img.width + int(f64(x) * k)) * 4
            int(img.pixels[q]) - int(img.pixels[q + 1]) > 100
        green = (x: int, y: int) -> bool:
            q = (int(f64(y) * k) * img.width + int(f64(x) * k)) * 4
            int(img.pixels[q + 1]) > 150
        ring0 = false
        loop x in [194..200):
            if red(x, 300): ring0 = true
        ring1 = false
        loop x in [594..600):
            if red(x, 300): ring1 = true
        print("{f}: ring around card 0 {ring0}, card 1 {ring1}; card 0 green {green(350, 300)}, card 1 green {green(750, 300)}")
