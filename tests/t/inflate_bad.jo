# requires: sloppy
# inflate on data that is not deflate (random bytes, a stream with bytes changed or cut short)
# gives none, never a panic: a packet from a peer can be anything
text = "the quick brown fox jumps over the lazy dog; " * 40
good = deflate(bytes(text))
print(str_from_bytes(inflate(good)!) == text)
seed_random(7)
bad = 0
loop round in [0..3000):
    b: u8[]
    if round % 2 == 0:
        loop i in [0..random_int(0, 64)): b.push(u8(random_int(0, 256)))
    else:
        b = good
        loop k in [0..random_int(1, 7)): b[random_int(0, b.len())] = u8(random_int(0, 256))
        if random() < 0.3: b = b[..random_int(0, b.len()))
    if inflate(b, random_int(0, 3)) == none: bad += 1
print(bad > 1000)
print(inflate(bytes("plain text, not compressed")) == none)
