# Float to integer conversions saturate at the range of each integer type (NaN to 0), on every target
# requires: sloppy
ci8 = (x: f64): i8(x)
cu8 = (x: f64): u8(x)
ci16 = (x: f32): i16(x)
cu16 = (x: f64): u16(x)
ci32 = (x: f64): i32(x)
cu32 = (x: f32): u32(x)
cu64 = (x: f64): u64(x)
ci64 = (x: f64): int(x)
main = ():
    nan = 0.0 / 0.0
    inf = 1.0 / 0.0
    print(ci8(128.0), ci8(-129.0), ci8(-3.9), ci8(nan), ci8(inf), ci8(-inf))
    print(cu8(256.0), cu8(-1.0), cu8(200.7), cu8(nan))
    print(ci16(40000.0), ci16(-40000.0), cu16(70000.0), cu16(-5.0))
    print(ci32(2147483648.0), ci32(-2147483649.0), ci32(5e30))
    print(cu32(5e9), cu32(-1.0), cu32(4294967040.0))
    print(cu64(9223372036854775808.0), cu64(-1.0), cu64(1e30), cu64(nan), cu64(12345.9), cu64(inf))
    print(ci64(1e30), ci64(-1e30), ci64(nan))
