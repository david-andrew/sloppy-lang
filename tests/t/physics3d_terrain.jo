# requires: sloppy
import physics3d
h = (x: f64, z: f64) -> f64: sin(x * 0.3) * 2.0 + cos(z * 0.2)
w = physics3d.World()
w.add_mesh(physics3d.terrain_triangles(40.0, 20, h))
ball = w.add_sphere(vec3(3, 10, 2), 0.5)
loop i in [0..300): w.step(1.0 / 60.0)
p = w.pos(ball)
print("rests on the ground: {abs(f64(p.y) - 0.5 - h(f64(p.x), f64(p.z))) < 0.3}")
