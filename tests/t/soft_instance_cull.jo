# requires: sloppy
# requires: native
# requires: unix
# env: SLOPPY_SOFTWARE=1
# Compare opt-in library culling with the original path, for both instance sources.
ball = cube_mesh(0.7)
unbounded = ball
unbounded.radius = -1
insts: Instance3D[]
loop i in [-12..13):
    m = transform(vec3(f32(i) * 0.8, f32(i % 3) * 0.4, f32(i % 5) * -0.7), f64(i) * 0.31)
    if i % 4 == 0: m[1].x = 1.3
    if i % 5 == 0: m[0] = m[0] * -1.0
    insts.push(instance(m, vec4(0.4 + f32(i + 12) * 0.02, 0.7, 0.9, 1)))
insts.push(instance(translation(vec3(0, 0, 8))))
kept = instance_buffer(insts)
capture = (bounded: bool, buffered: bool, wind: f64, shadow: bool) -> Image:
    render_image(48, 48, ():
        clear(BLACK)
        camera3d(vec3(0, 1, 5), vec3(0, 0, 0), 60)
        shadows(shadow, area = 10)
        fog(vec3(0, 0, 0), 0)
        sun(vec3(-1, 2, 1))
        m = if bounded: ball else: unbounded
        if buffered: draw_mesh_instanced(m, kept, wind = wind)
        else: draw_mesh_instanced(m, insts, wind = wind))
loop buffered in [false, true]:
    loop wind in [0.0, 0.3]:
        loop shadow in [false, true]:
            a = capture(true, buffered, wind, shadow)
            b = capture(false, buffered, wind, shadow)
            assert(a.pixels == b.pixels)

# A custom CPU vertex function must run for every vertex, even wholly offscreen.
struct V:
    pos: vec3
struct U:
    color: vec4
struct O:
    pos: vec4
vs = (v: V, inst: Instance3D, u: U) -> O: O(inst.model * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4: u.color
calls = 0
@cabi
count_vs = (out: *u8, v: *u8, inst: *u8, uni: *u8):
    global calls
    calls += 1
    (out as *vec4)[0] = vec4(100, 100, 0, 1)
custom = make_shader(shader(vs, fs))
entry: cfn(*u8, *u8, *u8, *u8) = count_vs
__sp_vs[custom.prog] = entry as *u8
triangle = mesh([V(vec3(-1, -1, 0)), V(vec3(1, -1, 0)), V(vec3(0, 1, 0))])
img = render_image(8, 8, (): draw_instanced(custom, triangle, insts, U(vec4(1, 0, 0, 1))))
assert(calls == 3 * insts.len())
print("software instance culling ok")
