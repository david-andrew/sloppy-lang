# requires: native (rollback netplay through a relay over WebSockets: the relay and both players in one program)
# requires: sloppy (lib/netplay.jo)
import netplay

struct Pad:
    dx = 0
struct Game:
    pos: int[] = [0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

a = netplay.session(Game(), step, players = 2, me = 0)
b = netplay.session(Game(), step, players = 2, me = 1)
netplay.relay(47320)
a.join_relay("127.0.0.1", 47320, "room 1")
b.join_relay("127.0.0.1", 47320, "room 1")
# (another room's player hears nothing of this one)
c = netplay.session(Game(), step, players = 2, me = 1)
c.join_relay("127.0.0.1", 47320, "room 2")
loop _ in [0..300):
    netplay.relay(47320)
    a.play(pad(0, a.tick + a.delay))
    b.play(pad(1, b.tick + b.delay))
    c.play(pad(1, c.tick + c.delay))
    sleep(1.0 / 240.0)
k = min(min(a.confirmed(), b.confirmed()), min(a.tick, b.tick)) - 1        # (simulated by both, with every input)
print("played", a.tick > 200, b.tick > 200, "confirmed", k > 150)
print("same game:", a.__states[k % 128] == b.__states[k % 128], "desync", a.desync, b.desync)
print("other room alone:", c.confirmed() < 20)
