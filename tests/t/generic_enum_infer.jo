# requires: sloppy
# a generic enum's type arguments from a variant's arguments, or from where the value goes
enum Tree[T]:
    leaf
    node(v: T, kids: Tree[T][])
size[T] = (t: Tree[T]) -> int:
    match t:
        .leaf: 0
        .node(v, kids): 1 + sum([loop k in kids: size(k)])
u = Tree.node("a", [])
w = Tree.node(1.5, [Tree.node(2.5, [])])
print(u, size(w))
t: Tree[int] = Tree.node(1, [])
print(t)
l: Tree[str] = Tree.leaf
print(l, size(l))
