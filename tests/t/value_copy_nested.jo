                true: s.v = Nested(F32s(15, 18), Ints(21, -24))
                false: pass
        8:
            loop j in 0..(if take: 3 else: 0): s.v.a.x += 1
        _:
            if take:
                s.v = Nested(F32s(15, 18), Ints(21, -24))
                observed_relay = s.v
                observed = observed_relay
                check = f64(first.a.x) + f64(s.v.a.x) - f64(observed.a.x)
                print("param", mode, take, "before", before, "check", check)
                print("local", first.a.x, first.a.y, first.b.x, first.b.y)
                print("whole", whole.v.a.x, whole.v.a.y, whole.v.b.x, whole.v.b.y)
                print("field", field.v.a.x, field.v.a.y, field.v.b.x, field.v.b.y)
                print("element", element.v.a.x, element.v.a.y, element.v.b.x, element.v.b.y)
                print("tuple", tuple_element.v.a.x, tuple_element.v.a.y, tuple_element.v.b.x, tuple_element.v.b.y)
                print("observed", observed.a.x, observed.a.y, observed.b.x, observed.b.y)
                print("original", s.v.a.x, s.v.a.y, s.v.b.x, s.v.b.y)
