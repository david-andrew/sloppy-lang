    old

@noinline
param_case = (s: mut Cell, mode: int, take: bool):
    whole = s
    field = Cell(Nested(F32s(15, 18), Ints(21, -24)))
    elements = [s]
    element = elements[0]
    pair = (s, 97)
    tuple_element = pair.0
    relay = s.v
    first = relay
    field.v = first
    before = s.v.a.x
    match mode:
        0: s.v = Nested(F32s(15, 18), Ints(21, -24))
        1: s.v.a.x += 2
        2: s.v.a.x *= 2
        3: change_in(s.v)
        4: change_out(s.v)
        5:
            if take: s.v = Nested(F32s(15, 18), Ints(21, -24))
        6:
            if take: pass
            else: s.v = Nested(F32s(15, 18), Ints(21, -24))
        7:
