# Reverse copies and two loop-carried memory-generation checks.
@noinline
reverse_case = (s: mut Cell, take: bool):
    local: Nested = Nested(F32s(3, 6), Ints(9, -12))
    before = s.v.a.x
    s.v = local
    after = s.v.a.x
    if take: local = Nested(F32s(15, 18), Ints(21, -24))
    saved = s.v
    total = 0.0
    loop i in 0..3:
        old = s.v
        s.v.a.x += 1
        now = s.v
        total += f64(now.a.x) - f64(old.a.x)
    print("reverse", take, before, after, total, local.a.x, local.a.y, local.b.x, local.b.y, saved.a.x, saved.a.y, saved.b.x, saved.b.y, s.v.a.x, s.v.a.y, s.v.b.x, s.v.b.y)
    replacement: Nested = Nested(F32s(15, 18), Ints(21, -24))
    sum = 0.0
    loop i in 0..3:
        sum += f64(s.v.a.x)
        s.v = replacement
    print("bit stores", sum, replacement.a.x, replacement.a.y, replacement.b.x, replacement.b.y, s.v.a.x, s.v.a.y, s.v.b.x, s.v.b.y)

# Runtime parameters keep both control-flow paths in the non-inlined cases.
loop mode in 0..10:
    loop take in [false, true]:
        s = Cell(Nested(F32s(3, 6), Ints(9, -12)))
        param_case(s, mode, take)
        global_case(mode, take)
        local_case(mode, take)
        xs = [Cell(Nested(F32s(15, 18), Ints(21, -24))), Cell(Nested(F32s(3, 6), Ints(9, -12)))]
        element_case(xs, 1, mode, take)
        o = Outer(Cell(Nested(F32s(3, 6), Ints(9, -12))))
        nested_case(o, mode, take)
# Aggregate return snapshots and an argument aliased by a mut argument.
loop take in [false, true]:
    rev = Cell(Nested(F32s(15, 18), Ints(21, -24)))
    reverse_case(rev, take)
s_in = Cell(Nested(F32s(3, 6), Ints(9, -12)))
r_in = saved_in(s_in)
print("return in", r_in.a.x, r_in.a.y, r_in.b.x, r_in.b.y, s_in.v.a.x, s_in.v.a.y, s_in.v.b.x, s_in.v.b.y)
a_in = argument_in(s_in, s_in.v)
print("argument in", a_in.a.x, a_in.a.y, a_in.b.x, a_in.b.y, s_in.v.a.x, s_in.v.a.y, s_in.v.b.x, s_in.v.b.y)
s_out = Cell(Nested(F32s(3, 6), Ints(9, -12)))
r_out = saved_out(s_out)
print("return out", r_out.a.x, r_out.a.y, r_out.b.x, r_out.b.y, s_out.v.a.x, s_out.v.a.y, s_out.v.b.x, s_out.v.b.y)
a_out = argument_out(s_out, s_out.v)
print("argument out", a_out.a.x, a_out.a.y, a_out.b.x, a_out.b.y, s_out.v.a.x, s_out.v.a.y, s_out.v.b.x, s_out.v.b.y)
