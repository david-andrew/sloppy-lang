# requires: sloppy
# net.fetch in a task waits for its answer while the others take their turns, in a web page too
# (where a program's tasks can wait); a task cancelled while it fetches gets status 0 at once.
# (A web page fetches a data: URL; natively, this program's own server answers)
import http
import net

const PORT = 19465

main = ():
    url = "data:text/plain,hello from a task"
    slow = "http://10.255.255.1/"
    if TARGET != "wasm":
        http.get("/hello", (r: http.Request) -> http.Response: http.text("hello from a task"))
        http.listen(PORT, host = "127.0.0.1")
        spawn((): http.serve(PORT), background = true)
        url = "http://127.0.0.1:{PORT}/hello"
        # (a server that takes the connection and never answers)
        net.tcp_listen(PORT + 1, host = "127.0.0.1")
        slow = "http://127.0.0.1:{PORT + 1}/"
    t = spawn((): net.fetch(url, wait = 5.0))
    r = t.wait()
    print(r.status, r.text)
    c = spawn((): net.fetch(slow, wait = 10.0))
    sleep(0.05)
    t0 = time()
    c.cancel()
    rc = c.wait()
    print(rc.status, rc.why, time() - t0 < 1.0)
