# error: in shader code: a variable holding a Texture or a GpuBuffer in shaders must be given a field of the uniforms (or of a parameter holding one) once, and not changed
struct Vertex:
    pos: vec2
struct Look:
    tex: Texture
    tint: vec4
struct U:
    look: Look
struct Out:
    pos: vec4
vs = (v: Vertex, u: U) -> Out: Out(vec4(v.pos, 0, 1))
fs = (i: Out, u: U) -> vec4:
    l = u.look
    l.tint *= 0.5
    sample(l.tex, vec2(0.5, 0.5)) * l.tint
prog = make_shader(shader(vs, fs))
quad = mesh([Vertex(vec2(-1, -1)), Vertex(vec2(1, -1)), Vertex(vec2(1, 1))])
draw = (): draw(prog, quad, U(Look(texture(image(1, 1, vec4(1, 1, 1, 1))), vec4(1, 1, 1, 1))))
