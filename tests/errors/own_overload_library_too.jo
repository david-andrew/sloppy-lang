# error: in call to index_of(p: Parser, c: str): argument 'p' expects Parser, found int[] (the library's index_of(xs: T[], x: T)
# (the program's own function of a library function's name: the error it gives says the library's too)
struct Parser:
    pos = 0
index_of = (p: Parser, c: str) -> int: 7
print(index_of(Parser(), "x"))
xs = [1, 2, 3]
print(index_of(xs, "a"))
