# error: the fragment function's output Five has 5 fields: it takes 1 to 4 vec4 colors (a render target has at most 4)
struct V:
    pos: vec2
struct U:
    k: f32
struct O:
    pos: vec4
struct Five:
    a: vec4
    b: vec4
    c: vec4
    d: vec4
    e: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1))
fs = (i: O, u: U) -> Five:
    w = vec4(1, 1, 1, 1)
    Five(w, w, w, w, w)
sh = make_shader(shader(vs, fs))
