# error: `loop mut` changes the elements of enemies in place, and spawn (called here) may add, remove or replace elements of enemies, which the loop cannot have: set a flag in the loop and call it after, push new ones to another array first, or loop over its indexes
struct Enemy:
    hp = 10.0
enemies: Enemy[] = [Enemy(), Enemy()]
spawn = (): enemies.push(Enemy())
loop mut e in enemies:
    spawn()
    e.hp = 99.0
