# error: this T? may be none
# (a break of a loop inside the narrowing does not leave it: after the loop n may be none)
struct T:
    v: int
f = (n: mut T?) -> int:
    if n is T:
        loop i in 0..3:
            if i == 1:
                n = none
                break
        return n.v
    0
x: T? = T(1)
print(f(x))
