# error: Pair is the fragment function's output (its colors), so it cannot be the vertex function's output too
struct V:
    pos: vec2
struct U:
    k: f32
struct Pair:
    pos: vec4
    color: vec4
vs = (v: V, u: U) -> Pair: Pair(vec4(v.pos, 0, 1), vec4(1, 0, 0, 1))
fs = (i: Pair, u: U) -> Pair: i
sh = make_shader(shader(vs, fs))
