# error: the arm for .rect has a condition, so a .rect that fails it is not matched: add an arm without one, or `_:`
enum Shape:
    circle(r: f64)
    rect(w: f64, h: f64)
area = (s: Shape) -> f64:
    match s:
        .circle(r): 3.14 * r * r
        .rect(w, h) if w == h: w * w
print(area(Shape.rect(1, 2)))
