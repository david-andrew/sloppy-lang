# error: in shader code: type Light? cannot be used in shaders
struct Vertex:
    pos: vec2
struct Light:
    color: vec4
    next: Light?
struct U:
    light: Light
struct Out:
    pos: vec4
vs = (v: Vertex, u: U) -> Out: Out(vec4(v.pos, 0, 1))
fs = (i: Out, u: U) -> vec4: u.light.color
prog = make_shader(shader(vs, fs))
quad = mesh([Vertex(vec2(-1, -1)), Vertex(vec2(1, -1)), Vertex(vec2(1, 1))])
draw = (): draw(prog, quad, U(Light(vec4(1, 0, 0, 1))))
