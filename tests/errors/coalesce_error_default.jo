# error: `??` gives a default of the value's own type, for when env.get(...) is none: an f64 here, and this is an EvalError. To give back one or the other: `if let v = env.get(...): v else: EvalError(...)`
error struct EvalError:
    msg: str
lookup = (env: {str: f64}, name: str) -> f64 | EvalError:
    env.get(name) ?? EvalError("unknown {name}")
print(lookup({"a": 1.0}, "a"))
