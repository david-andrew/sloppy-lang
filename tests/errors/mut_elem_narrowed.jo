# error: 'f' may change the global 'g' (or call something that does), so g.xs[0] cannot be passed to it as a `mut` argument
struct A: xs: int[]
g: A | int = A([1, 2, 3])
f = (x: mut int):
    g = 0
    junk = [66, 77, 88]
    junk[0] = 66
    x = 42
    print(junk)
main = ():
    if g is A: f(g.xs[0])
