# error: prog's shader functions take U as their uniforms, and this is Other
struct Vertex:
    pos: vec2
struct U:
    time: f32
    tint: vec4
struct Other:
    a: vec4
    b: f32
struct Out:
    pos: vec4
    uv: vec2
vs = (v: Vertex, u: U) -> Out: Out(vec4(v.pos, 0, 1), v.pos * 0.5 + 0.5)
fs = (i: Out, u: U) -> vec4: u.tint
prog = make_shader(shader(vs, fs))
quad = mesh([Vertex(vec2(-1, -1)), Vertex(vec2(1, -1)), Vertex(vec2(1, 1))])
draw = (): draw(prog, quad, Other(vec4(1, 0, 0, 1), 0.5))
