# error: `loop mut` changes the elements of xs in place, so its body cannot add, remove or replace elements of xs
f = (x: mut int, a: mut int[]):
    a = [9, 8, 7]
    junk = [66, 77, 88]
    junk[0] = 66
    x = 42
    print(junk)
main = ():
    xs = [1, 2, 3]
    loop mut x in xs:
        f(x, xs)
        break
    print(xs)
