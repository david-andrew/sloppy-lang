# error: this `?` can return a ParseError, but total gives f64 | EvalError: make its result `f64 | ParseError | EvalError`
error struct ParseError: msg: str
error struct EvalError: msg: str
parse = (s: str) -> int | ParseError: ParseError(s)
total = () -> f64 | EvalError: f64(parse("1")?)
print(total())
