# error: `if let nx = n.next` makes nx a copy of what n.next holds, and changing the copy does not change n.next (`mut` would not either): to change it, change `n.next!` itself
struct Node:
    value: int
    next: Node?
append = (n: mut Node, v: int):
    if let mut nx = n.next: append(nx, v)
    else: n.next = Node(v)
