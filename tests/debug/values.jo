# tools/dbgtest.py stops at the line marked "stop" and checks what gdb and lldb show (values.expect)
enum Dir: left, right, up
enum Shape:
    circle(r: f64)
    rect(w: f64, h: f64)

struct Ship:
    name: str
    pos: vec2
    hp: int
    tags: str[]

bump = (s: mut Ship, k: int):
    s.hp += k
    s.pos.x += 1.0

main = ():
    d = Dir.right
    sh = Shape.rect(2.0, 3.0)
    o: int? = 5
    o2: int? = none
    pair = (3, "x")
    ships = [Ship("a", vec2(1, 2), 10, ["fast", "red"]), Ship("b", vec2(3, 4), 20, [])]
    s = ships[0]
    bump(s, 5)
    words = ["one", "two"]
    m = {"k": 1, "x": 2}
    m.remove("x")                       # (still there, marked gone: not shown)
    f = 2.5
    print("{d} {o ?? 0} {o2 ?? 0} {pair.0} {s.hp} {words.len()} {m.len()} {f}")    # stop
    match sh:
        rect(w, h): print(w * h)
        circle(r): print(r)
