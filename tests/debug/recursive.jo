# a struct and an enum that hold themselves (their fields keep values in boxes): shown as their values
struct Node:
    value: int
    next: Node?

enum Expr:
    num(v: int)
    bin(op: str, l: Expr, r: Expr)

main = ():
    list = Node(1, Node(2))
    last = Node(3)
    e = Expr.bin("+", Expr.num(4), Expr.num(5))
    print("{list.value} {last.value} {e}")    # stop
