# warning: 'nx' is a copy (of n.next), so passing it as a `mut` argument changes the copy, which nothing reads after: it does not change n. Pass `n.next!` to change n.next itself
struct Node:
    value: int
    next: Node?
append = (n: mut Node, v: int):
    if let nx = n.next: append(nx, v)
    else: n.next = Node(v)
h = Node(1)
append(h, 2)
append(h, 3)
print(h)
