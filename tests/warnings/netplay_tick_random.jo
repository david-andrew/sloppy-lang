# warning: tick is netplay.session's tick, and here it takes random numbers (random()), different on each machine: the games will drift apart (a desync); make them from the game (`hash(g.tick * 7 + i)`), or from an Rng kept in it
import netplay
struct Pad:
    x = 0
struct Game:
    pos = 0.0
tick = (g: Game, pads: Pad[]) -> Game:
    let g = g
    g.pos += random() * f64(pads[0].x)
    g
s = netplay.session(Game(), tick, players = 2, me = 0)
print(s.tick)
