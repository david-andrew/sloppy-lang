# warning: tick is the session's tick, and random() differs from one machine to the other: the two games will not be the same (a desync): keep a seed in the game and draw from it (`hash(g.tick * 7 + i)`)
import netplay
struct Pad:
    x = 0
struct Game:
    pos = 0.0
tick = (g: Game, pads: Pad[]) -> Game:
    let g = g
    g.pos += random() * f64(pads[0].x)
    g
s = netplay.session(Game(), tick, players = 2, me = 0)
print(s.tick)
