# warning: tick is netplay.session's tick, and here it reads the input (key_down()), different on each machine: the games will drift apart (a desync); read it in update, and give it to the tick as the player's input
import netplay
struct Pad:
    x = 0
struct Game:
    pos = 0.0
# (read in a function the tick calls: found there too)
push_on = (g: mut Game):
    if key_down(.space): g.pos += 1.0
tick = (g: Game, pads: Pad[]) -> Game:
    let g = g
    push_on(g)
    g
s = netplay.session(Game(), tick, players = 2, me = 0)
print(s.tick)
