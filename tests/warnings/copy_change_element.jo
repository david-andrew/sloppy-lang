# warning: 'e' is a copy (of w.ps[i]), and this change to it is never read: it does not change w. To change w, change it through w (`w.ps[i].hp -= ...`)
struct P:
    hp = 3
struct World:
    ps: P[]
hurt = (w: mut World, i: int):
    e = w.ps[i]
    if e.hp > 0:
        e.hp -= 1
w = World([P()])
hurt(w, 0)
print(w)
