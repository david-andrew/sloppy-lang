# warning: this function is netplay.session's tick, and here it reads the clock (elapsed()), different on each machine: the games will drift apart (a desync); a tick is always 1/60 s: count ticks in the game
import netplay
struct Pad:
    x = 0
struct Game:
    t = 0.0
s = netplay.session(Game(), (g: Game, pads: Pad[]) -> Game: Game(elapsed()), players = 2, me = 0)
print(s.tick)
