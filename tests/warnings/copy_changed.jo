# warning: 'e' is a copy (of what enemies.find(...) gives back), and this change to it is never read: it does not change enemies. To change an element of enemies, change it there, by its place (`enemies[i].hp -= ...`) or in `loop mut e in enemies`
struct Enemy:
    hp = 3
enemies = [Enemy()]
hit = ():
    if let e = enemies.find((x): x.hp > 0):
        e.hp -= 5
hit()
print(enemies)
