# warning: tick is netplay.session's tick, and here it changes the global 'hits', which a rollback does not put back (ticks are played again from an earlier game): keep it in the game
import netplay
struct Pad:
    fire = false
struct Game:
    pos = 0.0
hits = 0
tick = (g: Game, pads: Pad[]) -> Game:
    if pads[0].fire: hits += 1
    g
s = netplay.session(Game(), tick, players = 2, me = 0)
print(s.tick)
