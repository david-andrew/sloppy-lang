# warning: 'n' is a copy (of cur, a copy of l.head), and this change to it is never read: it does not change l
# (the change ends the function: what `loop let` binds is a copy of a copy)
struct Node:
    value: int
    next: Node?
struct List:
    head: Node?
set_last = (l: mut List, v: int):
    cur = l.head
    loop let n = cur:
        if n.next == none:
            n.value = v
            return
        cur = n.next
l = List(Node(1, Node(2)))
set_last(l, 5)
print(l)
