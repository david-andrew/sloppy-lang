# warning: 'cur' is a copy (of l.head!), and this change to it is never read: it does not change l. To change l, change it through l (`l.head!.next = ...`), or with a function that takes it as a `mut` parameter and calls itself on the next one (`push_back(n: mut Node?, ...)`)
# (Java's and Python's way to add at the end of a linked list: cur is read in the loop, and the
# change after it, the last thing done with it, is lost)
struct Node:
    value: int
    next: Node?
struct LinkedList:
    head: Node?
push_back = (l: mut LinkedList, v: int):
    if l.head == none:
        l.head = Node(v)
        return
    cur = l.head!
    loop cur.next != none:
        cur = cur.next!
    cur.next = Node(v)
l = LinkedList()
push_back(l, 1)
push_back(l, 2)
print(l)
