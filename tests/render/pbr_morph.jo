# The same imported mesh at three weight sets in one frame; below, the same morph is
# animated before a skin rotates it. Color AND shadow passes must retain each pose.
# Geometry stays on screen. Procedural CC0 data from pbr_assets.py.
actor = load_model(embed("pbr_morph.gltf"))
skinned = load_model(embed("pbr_morph_skin.gltf"))
floor_mesh = plane_mesh(7)
update = (dt: f64):
    if frame_number() > 0: assert(__drawn3d == 7)
draw = ():
    camera3d(vec3(0, 3.5, 13), vec3(0, 0.2, 0), 44)
    sky(vec3(0.15, 0.32, 0.6), vec3(0.6, 0.7, 0.8))
    sun(vec3(-1, 2, 1), disc = 0)
    fog(vec3(0, 0, 0), 0)
    shadows(true, area = 10)
    draw_mesh(floor_mesh, translation(vec3(0, -2.1, 0)), material = Material(base_color = vec4(0.4, 0.42, 0.45, 1), metallic = 0, roughness = 0.9))
    loop i in [0..3):
        t = f64(i) * 0.5
        draw_model(actor, translation(vec3(f32(i - 1) * 2.1, 1, 0)) * scaling(vec3(0.7, 0.7, 0.7)), pose = pose_at(actor, 0, t, false))
        draw_model(skinned, translation(vec3(f32(i - 1) * 2.1, -1.2, 0)) * scaling(vec3(0.7, 0.7, 0.7)), pose = pose_at(skinned, 0, t, false))
