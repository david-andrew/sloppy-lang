# shader code computes as the CPU does: an assignment's target and indexes once, before the right
# side (which may change them); and= or= compute both sides; ivec2(v) computes v once. A band
# for each check: green when it holds
struct V:
    pos: vec3
struct U:
    mvp: mat4
struct O:
    pos: vec4
struct Box:
    a: u8[2]
bump = (i: mut int) -> int:
    old = i
    i += 1
    old
pair = (i: mut int) -> vec2:
    i += 1
    vec2(f32(i), f32(i + 10))
tick = (i: mut int) -> bool:
    i += 1
    true
idx = () -> int:
    j = 0
    ys: u8[2] = [u8(4), u8(5)]
    ys[bump(j)] %= u8(3)
    0
check = (k: int) -> bool:
    i = 0
    if k == 0:
        xs: u8[2] = [u8(10), u8(20)]
        xs[idx()] += u8(250)
        return xs[0] == u8(4)
    if k == 1:
        xs: u8[2] = [u8(10), u8(20)]
        xs[i] += u8(bump(i) + 1)
        return i == 1 and xs[0] == u8(11) and xs[1] == u8(20)
    if k == 2:
        vs: ivec2[4] = [ivec2(10, 20), ivec2(30, 40), ivec2(50, 60), ivec2(70, 80)]
        vs[bump(i)].x %= i32(7)
        return i == 1 and vs[0].x == i32(3)
    if k == 3:
        v = ivec2(pair(i))
        return i == 1 and v == ivec2(1, 11)
    if k == 4:
        a = false
        a and= tick(i)
        b = true
        b or= tick(i)
        return i == 2 and not a and b
    if k == 5:
        bs: Box[2] = [Box([u8(10), u8(20)]), Box([u8(30), u8(40)])]
        bs[bump(i)].a[bump(i)] %= u8(7)
        return i == 2 and bs[0].a[1] == u8(6)
    w = vec4(1, 2, 3, 4)
    w.yz += pair(i)
    i == 1 and w == vec4(1, 3, 14, 4)
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4:
    if check(int(i.pos.x / 1280.0 * 7.0)): return vec4(0, 1, 0, 1)
    vec4(1, 0, 0, 1)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    draw(sh, m, U(mat4()))
