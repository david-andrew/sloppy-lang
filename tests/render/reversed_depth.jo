# reversed depth: planes a million metres away and 1 km apart, with the usual depth one depth
# (yellow would lose to green), told apart: a red one on the left, drawn first; a green one 1 km
# behind, over the whole view; a yellow one in the lower right, drawn last. And 1 m away a blue
# quad, with a white one 1 mm behind it drawn after it, showing only where blue is not.
# Left red, upper right green, lower right yellow, blue in the middle with white to its right.
# Where the renderer has no reversed depth (OpenGL without glClipControl), what a game does then:
# logarithmic depth with set_depth, the same picture.
window("reversed depth", 800, 450)
struct V:
    pos: vec3
struct U:
    mvp: mat4
    color: vec4
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4: u.color
fs_log = (i: O, u: U) -> vec4:
    set_depth(log2(1.0 + 1.0 / i.pos.w) * 0.05)
    u.color
reversed = reversed_depth()
sh = make_shader(if reversed: shader(vs, fs) else: shader(vs, fs_log))
quad = (x0: f32, y0: f32, x1: f32, y1: f32, z: f32) -> Mesh:
    mesh([V(vec3(x0, y0, -z)), V(vec3(x1, y0, -z)), V(vec3(x1, y1, -z)), V(vec3(x0, y0, -z)), V(vec3(x1, y1, -z)), V(vec3(x0, y1, -z))])
left = quad(-1300000, -1000000, 0, 1000000, 1000000)
behind = quad(-1700000, -1300000, 1700000, 1300000, 1001000)
lower_right = quad(0, -1000000, 1300000, 0, 1000000)
blue = quad(-0.2, -0.2, 0.1, 0.2, 1.0)
white = quad(-0.1, -0.15, 0.2, 0.15, 1.001)
draw = ():
    clear(rgb(0.1, 0.1, 0.1))
    depth_test(.nearer)
    aspect = f64(screen_width()) / f64(screen_height())
    p = if reversed: perspective_reversed(1.0, aspect, 0.1) else: perspective(1.0, aspect, 0.1, 10000000.0)
    draw(sh, left, U(p, vec4(1, 0.2, 0.2, 1)))
    draw(sh, behind, U(p, vec4(0.2, 0.9, 0.3, 1)))
    draw(sh, lower_right, U(p, vec4(1, 0.9, 0.2, 1)))
    draw(sh, blue, U(p, vec4(0.2, 0.3, 1, 1)))
    draw(sh, white, U(p, vec4(1, 1, 1, 1)))
