# numbers in shader code as on the CPU: -(-1.5) (not GLSL's --), unsigned min, max and clamp,
# abs of a narrow integer wrapping, an integer vector negated. A band for each check: green when
# it holds
struct V:
    pos: vec3
struct U:
    mvp: mat4
    big: u32
struct O:
    pos: vec4
check = (k: int, u: U) -> bool:
    if k == 0: return -(-1.5) == 1.5 and -(-2) == 2
    if k == 1: return max(u.big, u32(5)) == u.big and min(u.big, u32(3000000000)) == u32(3000000000)
    if k == 2: return clamp(u.big, u32(100), u32(3900000000)) == u32(3900000000)
    if k == 3: return abs(i8(-128)) == i8(-128) and abs(i8(-5)) == i8(5)
    v = -ivec2(i32(-2147483648), i32(2038070033))
    v.x == i32(-2147483648) and v.y == i32(-2038070033)
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4:
    if check(int(i.pos.x / 1280.0 * 5.0), u): return vec4(0, 1, 0, 1)
    vec4(1, 0, 0, 1)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    draw(sh, m, U(mat4(), u32(4000000000)))
