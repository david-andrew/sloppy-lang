# glTF normal maps: generated tangents (left), authored tangents and UV1 (right).
# All geometry fits on screen. Original procedural data: pbr_assets.py, CC0.
read = read_gltf(embed("pbr_materials.gltf"))
if read is ModelError: panic(read.message)
data = read as ModelData
left = model(data)
right_data = data
right_data.meshes = [data.meshes[0]]
loop i in [0..right_data.meshes[0].vertices.len()):
    right_data.meshes[0].vertices[i].tangent = vec4(1, 0, 0, -1)
pm = right_data.meshes[0].material!
pm.normal_uv = 1
right_data.meshes[0].material = pm
right = model(right_data)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 0, 7), vec3(0, 0, 0), 42)
    sun(vec3(-1, 1, 2), disc = 0)
    sky(vec3(0.12, 0.28, 0.5), vec3(0.5, 0.65, 0.8))
    shadows(false)
    fog(vec3(0, 0, 0), 0)
    draw_model(left, translation(vec3(-1.2, 0, 0)) * scaling(vec3(0.9, 1.1, 1)))
    draw_model(right, translation(vec3(1.2, 0, 0)) * scaling(vec3(0.9, 1.1, 1)))
