# Four fragment outputs into a render target of four colors, alpha-blended (alpha 0.6) over a
# purple clear: each color a different mix of a triangle's corner colors, the blend applied to
# each. The four in a row.
window("four colors", 800, 450)
struct V:
    pos: vec2
    color: vec4
struct U:
    k: f32
struct O:
    pos: vec4
    color: vec4
struct Four:
    a: vec4
    b: vec4
    c: vec4
    d: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1), v.color)
fs = (i: O, u: U) -> Four:
    c = i.color
    Four(vec4(c.x, c.y, c.z, u.k), vec4(c.y, c.z, c.x, u.k), vec4(c.z, c.x, c.y, u.k), vec4(c.x, c.x, c.x, u.k))
sh = make_shader(shader(vs, fs))
tri = mesh([V(vec2(-0.9, -0.9), vec4(1, 0, 0, 1)), V(vec2(0.9, -0.9), vec4(0, 1, 0, 1)), V(vec2(0, 0.9), vec4(0, 0, 1, 1))])
rt = render_target(160, 160, colors = 4)
draw = ():
    draw_to(rt)
    clear(rgb(0.3, 0.1, 0.4))
    blend(.alpha)
    draw(sh, tri, U(0.6))
    draw_to_screen()
    clear(rgb(0.05, 0.05, 0.1))
    loop i in [0..4): draw_target(rt, vec2(16 + f32(i) * 196, 130), vec2(180, 180), color = i)
