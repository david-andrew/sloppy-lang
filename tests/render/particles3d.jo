# 3D particles: glowing sparks (added up) in a cone, and blended smoke; soft dots facing the camera
seed_random(3)
ps: Particles3D
ps.gravity = vec3(0, -3, 0)
smoke: Particles3D
update = (dt: f64):
    if frame_number() % 5 == 0:
        emit(ps, vec3(0, 0.5, 0), 20, 4.0, rgb(1, 0.6, 0.2), spread = 0.6)
        emit(smoke, vec3(2, 0.2, 0), 3, 0.6, rgba(0.5, 0.5, 0.5, 0.6), 3.0, 0.8, 0.3)
    ps.update(dt)
    smoke.update(dt)
draw = ():
    camera3d(vec3(0, 2, 6), vec3(0, 1, 0))
    sky(vec3(0.1, 0.1, 0.2), vec3(0.2, 0.2, 0.3))
    draw_mesh(plane_mesh(10), color = rgb(0.3, 0.3, 0.35))
    ps.draw()
    smoke.draw(glow = false)
