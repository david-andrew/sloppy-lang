# a texture changed or deleted after a draw that samples it: the draw still shows what it had
# (left: deleted, middle: made again from another image, right: drawn after that, the new one)
red = image(1, 1, vec4(1, 0, 0, 1))
green = image(2, 2, vec4(0, 1, 0, 1))
kept = texture(red, false)
draw = ():
    clear(vec4(0, 0, 0, 1))
    gone = texture(red, false)
    sprite(gone, vec2(0, 0), vec2(400, 720))
    flush()
    gl_delete_texture(gone.id)
    sprite(kept, vec2(440, 0), vec2(400, 720))
    flush()
    glBindTexture(GL_TEXTURE_2D, u32(kept.id))
    gl_tex_image(2, 2, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, data(green.pixels), green.pixels.len())
    sprite(kept, vec2(880, 0), vec2(400, 720))
    flush()
    glBindTexture(GL_TEXTURE_2D, u32(kept.id))
    gl_tex_image(1, 1, GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, data(red.pixels), red.pixels.len())
