# Two fragment outputs into a render target of two colors (render_target(..., colors = 2)): a
# triangle's colors into the first, their inverse into the second. Both shown with draw_target
# (left: color 0, middle: color 1) and sampled by a later shader (right: red and green from the
# first, blue from the second).
window("two colors", 800, 450)
struct V:
    pos: vec2
    color: vec4
struct U:
    k: f32
struct O:
    pos: vec4
    color: vec4
struct Two:
    base: vec4
    inverse: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1), v.color)
fs = (i: O, u: U) -> Two: Two(i.color, vec4(1.0 - i.color.x, 1.0 - i.color.y, 1.0 - i.color.z, 1))
sh = make_shader(shader(vs, fs))
tri = mesh([V(vec2(-0.8, -0.8), vec4(1, 0, 0, 1)), V(vec2(0.8, -0.8), vec4(0, 1, 0, 1)), V(vec2(0, 0.8), vec4(0, 0, 1, 1))])
struct Q:
    pos: vec2
struct SU:
    a: Texture
    b: Texture
struct SO:
    pos: vec4
    uv: vec2
svs = (v: Q, u: SU) -> SO: SO(vec4(v.pos.x * 0.29 + 0.68, v.pos.y * 0.53, 0, 1), v.pos * 0.5 + vec2(0.5, 0.5))
sfs = (i: SO, u: SU) -> vec4:
    a = sample(u.a, i.uv)
    b = sample(u.b, i.uv)
    vec4(a.x, a.y, b.z, 1)
both = make_shader(shader(svs, sfs))
quad = mesh([Q(vec2(-1, -1)), Q(vec2(1, -1)), Q(vec2(1, 1)), Q(vec2(-1, -1)), Q(vec2(1, 1)), Q(vec2(-1, 1))])
rt = render_target(200, 200, colors = 2)
draw = ():
    draw_to(rt)
    clear(rgb(0.2, 0.2, 0.2))
    draw(sh, tri, U(0))
    draw_to_screen()
    clear(rgb(0.05, 0.05, 0.1))
    draw_target(rt, vec2(20, 105), vec2(240, 240))
    draw_target(rt, vec2(280, 105), vec2(240, 240), color = 1)
    draw(both, quad, SU(rt.colors[0], rt.colors[1]))
