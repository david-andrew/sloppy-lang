# set_depth: logarithmic depth from the fragment's 1/w. Planes 300 km and 301 km away: a red one
# on the left, drawn first; a green one behind both, over the whole view; a yellow one in the
# lower right, drawn last; and a blue quad 2 m away in the middle. Each fragment's depth is
# log2(1 + distance) / 20, so the far planes stay apart (with the usual depth they are one depth,
# and yellow would lose to green): left red, upper right green, lower right yellow, blue middle.
struct V:
    pos: vec3
struct U:
    mvp: mat4
    color: vec4
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4:
    set_depth(log2(1.0 + 1.0 / i.pos.w) * 0.05)
    u.color
sh = make_shader(shader(vs, fs))
# a quad from (x0, y0) to (x1, y1), z away
quad = (x0: f32, y0: f32, x1: f32, y1: f32, z: f32) -> Mesh:
    mesh([V(vec3(x0, y0, -z)), V(vec3(x1, y0, -z)), V(vec3(x1, y1, -z)), V(vec3(x0, y0, -z)), V(vec3(x1, y1, -z)), V(vec3(x0, y1, -z))])
left = quad(-400000, -300000, 0, 300000, 300000)
behind = quad(-500000, -400000, 500000, 400000, 301000)
lower_right = quad(0, -300000, 400000, 0, 300000)
close = quad(-0.4, -0.4, 0.4, 0.4, 2)
draw = ():
    clear(rgb(0.1, 0.1, 0.1))
    glEnable(GL_DEPTH_TEST)
    glDepthFunc(GL_LESS)
    glDepthMask(1)
    glClear(GL_DEPTH_BUFFER_BIT)
    p = perspective(1.0, f64(screen_width()) / f64(screen_height()), 0.1, 10000000.0)
    draw(sh, close, U(p, vec4(0.2, 0.3, 1, 1)))
    draw(sh, left, U(p, vec4(1, 0.2, 0.2, 1)))
    draw(sh, behind, U(p, vec4(0.2, 0.9, 0.3, 1)))
    draw(sh, lower_right, U(p, vec4(1, 0.9, 0.2, 1)))
    glDisable(GL_DEPTH_TEST)
