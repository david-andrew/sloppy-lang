# PBR metallic (rows) x perceptual roughness (columns); finite grazing highlights and
# colored metal reflections from the sky. Procedural assets, dedicated to the public domain.
ball = sphere_mesh(0.43, 32, 20)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 2.3, 8.4), vec3(0, 0.1, 0), 42)
    sun(vec3(-0.6, 1.5, 1.2), vec3(1, 0.94, 0.85), disc = 0)
    sky(vec3(0.18, 0.4, 0.75), vec3(0.65, 0.76, 0.9), vec3(0.22, 0.16, 0.1))
    fog(vec3(0, 0, 0), 0)
    shadows(false)
    loop row in [0..3):
        loop col in [0..5):
            mat = Material(base_color = vec4(0.72, 0.31, 0.08, 1), metallic = f32(row) * 0.5, roughness = 0.08 + f32(col) * 0.23)
            draw_mesh(ball, transform(vec3(f32(col - 2) * 1.08, f32(1 - row) * 1.08, 0)), material = mat)
