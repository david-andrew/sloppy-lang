# meshes and instance buffers let go of are deleted as a frame starts (about 2,400 made here, most
# dropped at once): those kept still draw, and new ones get the deleted buffers' numbers (OpenGL
# gives them out again) without drawing what was there before.
#   left: a mesh made at the start, drawn from an instance buffer made at the start
#   middle: a mesh made this frame (the last frame's dropped)
#   right: an instance buffer made this frame (the last frame's dropped), of a mesh made at the start
# What is drawn is the same every frame; what is dropped is not (other sizes and counts), so a new
# one showing an old one's contents would show.
window("mesh reclaim", 800, 450)
kept = cube_mesh(0.5)
ball = sphere_mesh(0.35)
pile: Instance3D[]
loop i in [0..4): pile.push(instance(translation(vec3(-2.6 + f32(i % 2) * 0.7, -0.6 + f32(i / 2) * 0.8, 0)), vec4(0.3, 0.8, 0.4, 1)))
kept_pile = instance_buffer(pile)
latest = Mesh()
fresh = InstanceBuffer[Instance3D]()
nothing: Instance3D[]
draw = ():
    global latest, fresh
    # (made and dropped: as many empty as full)
    loop i in [0..20):
        thrown = cube_mesh(0.1 + f64(i) * 0.02)
        a = instance_buffer(pile)
        b = instance_buffer(nothing)
    latest = cube_mesh(0.9)
    row: Instance3D[]
    loop i in [0..2): row.push(instance(translation(vec3(1.8 + f32(i % 2) * 0.8, -0.8 + f32(i / 2) * 0.9, 0)), vec4(0.9, 0.5 + f32(i) * 0.1, 0.2, 1)))
    fresh = instance_buffer(row)
    clear(rgb(0.1, 0.12, 0.2))
    camera3d(vec3(0, 0.6, 5), vec3(0, 0, 0), 60)
    sun(vec3(-1, 2, 1.5))
    draw_mesh_instanced(kept, kept_pile)
    draw_mesh(latest, rotation_y(0.6) * rotation_x(0.4), rgb(0.5, 0.6, 1.0))
    draw_mesh_instanced(ball, fresh)
