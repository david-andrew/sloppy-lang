# post effects on a 3D scene leave the 2D drawn after it (a HUD) as drawn: the bright cube
# blooms, the white bar and text over the scene stay sharp
ball = cube_mesh(1)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 1, 5), vec3(0, 0, 0))
    sky(vec3(0.05, 0.05, 0.1), vec3(0.1, 0.1, 0.15))
    sun(vec3(1, 2, 1))
    post_effects(1.0, 0.5, 0.6, 0.4)
    draw_mesh(ball, transform(vec3(0, 0, 0)), vec4(4, 4, 3, 1))
    rect(440, 200, 400, 30, WHITE)
    text_centered("HUD", vec2(640, 560), 96)
