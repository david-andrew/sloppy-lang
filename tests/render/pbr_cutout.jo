# A glTF alpha mask from both sides, including its patterned shadow. BLEND is selected
# by the material even when its draw tint is opaque. Textures/factors exercised together.
src = str_from_bytes(embed("pbr_materials.gltf"))
r = read_gltf(bytes(replace(src, "\"mesh\":0", "\"mesh\":1")))
if r is ModelError: panic(r.message)
d = r as ModelData
leaves = model(d)
r2 = read_gltf(bytes(replace(src, "\"mesh\":0", "\"mesh\":2")))
if r2 is ModelError: panic(r2.message)
e = r2 as ModelData
mapped = model(e)
r3 = read_gltf(bytes(replace(src, "\"mesh\":0", "\"mesh\":3")))
if r3 is ModelError: panic(r3.message)
blended = model(r3 as ModelData)
floor_mesh = plane_mesh(6)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(4, 4, 9), vec3(0, 0.3, 0), 45)
    sky(vec3(0.15, 0.3, 0.55), vec3(0.65, 0.75, 0.85))
    sun(vec3(-0.6, 1.5, 0.8), disc = 0)
    fog(vec3(0, 0, 0), 0)
    shadows(true, area = 8)
    draw_mesh(floor_mesh, translation(vec3(0, -1.1, 0)), material = Material(base_color = vec4(0.45, 0.45, 0.45, 1), metallic = 0, roughness = 1))
    draw_model(leaves, translation(vec3(-1.5, 0.2, 0)))
    draw_model(leaves, translation(vec3(1, 0.2, -0.6)) * rotation_y(PI))
    draw_model(mapped, translation(vec3(0, 0.4, 1.5)) * scaling(vec3(0.45, 0.45, 0.45)))
    draw_model(blended, translation(vec3(0.35, 0.5, 1.8)) * scaling(vec3(0.45, 0.45, 0.45)))
