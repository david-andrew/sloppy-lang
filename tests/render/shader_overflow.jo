# integer arithmetic in shaders wraps on overflow as on the CPU (a GLSL compiler assuming signed
# results never overflow simplified abs(a * a) apart from itself; the smallest integer / -1 and its
# abs were left to the driver); green where it holds
struct V:
    pos: vec3
struct U:
    mvp: mat4
struct O:
    pos: vec4
mix = (s: u32, k: u32) -> u32:
    x = (s xor k) * u32(747796405)
    x xor (x >> u32(13))
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4:
    seed = u32(i32(i.pos.x) + i32(i.pos.y) * i32(1280)) * u32(2654435761)
    a = i32(mix(seed, u32(1)))
    k = i32(mix(seed, u32(2))) & i32(1)
    g: i32[2][2] = [[i32(0), i32(0)], [i32(0), i32(0)]]
    g[k][1 - k] += abs(a * a) % (i32(false) | i32(1))
    if g[0][0] + g[0][1] + g[1][0] + g[1][1] != i32(0): return vec4(1, 0, 0, 1)
    b = a * i32(65599) + i32(7)
    if b - a * i32(65599) != i32(7): return vec4(1, 0, 0, 1)
    # (the smallest integer / -1 is itself, % -1 is 0, also by component)
    lo = i32(-2147483647) - i32(1) + (a & i32(0))
    m1 = i32(-1) | (a & i32(0))
    if lo / m1 != lo or lo % m1 != i32(0): return vec4(1, 0, 0, 1)
    v = ivec2(lo, a) / ivec2(m1, i32(1))
    if v.x != lo or v.y != a or (ivec2(lo, lo) / m1).y != lo: return vec4(1, 0, 0, 1)
    if abs(lo) != lo or (abs(a) < i32(0) and a != lo): return vec4(1, 0, 0, 1)
    vec4(0, 1, 0, 1)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    draw(sh, m, U(mat4()))
