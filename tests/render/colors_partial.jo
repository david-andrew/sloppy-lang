# A render target of three colors: a shader of three outputs fills them red, green and blue;
# then a shader of one output (a white triangle) and 2D drawing (a yellow circle, alpha-blended
# text) write only the first, leaving the other two as they were. The three side by side.
window("partial colors", 800, 450)
struct V:
    pos: vec2
struct U:
    color: vec4
struct O:
    pos: vec4
struct Three:
    a: vec4
    b: vec4
    c: vec4
vs = (v: V, u: U) -> O: O(vec4(v.pos, 0, 1))
fill_fs = (i: O, u: U) -> Three: Three(vec4(0.8, 0.1, 0.1, 1), vec4(0.1, 0.7, 0.1, 1), vec4(0.1, 0.2, 0.8, 1))
one_fs = (i: O, u: U) -> vec4: u.color
fill = make_shader(shader(vs, fill_fs))
one = make_shader(shader(vs, one_fs))
quad = mesh([V(vec2(-1, -1)), V(vec2(1, -1)), V(vec2(1, 1)), V(vec2(-1, -1)), V(vec2(1, 1)), V(vec2(-1, 1))])
tri = mesh([V(vec2(-0.7, -0.7)), V(vec2(0.2, -0.7)), V(vec2(-0.25, 0.3))])
rt = render_target(200, 200, colors = 3)
draw = ():
    draw_to(rt)
    clear()
    draw(fill, quad, U(vec4(0, 0, 0, 0)))
    draw(one, tri, U(vec4(1, 1, 1, 1)))
    circle(vec2(140, 60), 40, rgb(1, 0.9, 0.2))
    rect(vec2(20, 150), vec2(160, 30), rgba(1, 1, 1, 0.5))
    draw_to_screen()
    clear(rgb(0.05, 0.05, 0.1))
    loop i in [0..3): draw_target(rt, vec2(20 + f32(i) * 260, 115), vec2(240, 240), color = i)
