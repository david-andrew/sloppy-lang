# Original CC0 fixture: the labels and built-in font keep their existing metrics.
# The second line is the identical loaded font with pair positioning disabled.
window("Pair kerning", 800, 400)
f = load_font(embed("../t/data/gpos-pairs.ttf")).unwrap()
plain = f
plain.kerning = []
draw = ():
    clear(rgb(0.06, 0.08, 0.12))
    set_font()
    text("GPOS pair kerning", vec2(24, 16), 24)
    text("same advances, no pair kerning", vec2(24, 140), 24)
    text("rich text keeps pairs across styles", vec2(24, 264), 24)
    set_font(f)
    text("AV To Ta", vec2(24, 50), 96)
    set_font(plain)
    text("AV To Ta", vec2(24, 174), 96)
    set_font(f)
    text_rich("A[color=yellow]V[/color] T[b]o[/b] T[i]a[/i]", vec2(24, 298), 96)
