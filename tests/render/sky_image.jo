# A procedural equirectangular panorama, shared by the backdrop and PBR ambient light.
# Asymmetric colored patches make its orientation and reflection visible. CC0 test data.
panorama = image(64, 32)
loop y in [0..32):
    loop x in [0..64):
        v = f32(y) / 31.0
        c = mix(vec3(0.18, 0.38, 0.85), vec3(0.8, 0.78, 0.68), min(v * 2.0, 1.0))
        if y >= 16: c = mix(vec3(0.48, 0.4, 0.28), vec3(0.15, 0.11, 0.08), (v - 0.5) * 2.0)
        angle = TAU * f64(x) / 64.0
        hill = int(floor(17.4 + 2.0 * sin(angle * 3.0) + cos(angle * 5.0)))
        if y >= hill and y < 22: c = vec3(0.22, 0.27, 0.2)
        if x >= 8 and x < 16 and y >= 7 and y < 14: c = vec3(1, 0.48, 0.12)
        if x >= 42 and x < 50 and y >= 6 and y < 13: c = vec3(0.8, 0.95, 1)
        panorama.set(x, y, vec4(c, 1))
environment = texture(panorama)
ball = sphere_mesh(0.65, 32, 20)
floor_mesh = plane_mesh(5)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(3, 2.5, 8.5), vec3(0, 0.3, 0), 43)
    sky_image(environment, 1.2, 0.4)
    sun(vec3(-1, 2, 1), vec3(0.2, 0.2, 0.2), disc = 0)
    fog(vec3(0, 0, 0), 0)
    shadows(false)
    draw_mesh(floor_mesh, translation(vec3(0, -0.3, 0)), material = Material(base_color = vec4(0.4, 0.4, 0.4, 1), metallic = 0, roughness = 0.85))
    draw_mesh(ball, translation(vec3(-1.5, 0.4, 0)), material = Material(base_color = vec4(0.9, 0.9, 0.9, 1), metallic = 1, roughness = 0.045))
    draw_mesh(ball, translation(vec3(0, 0.4, 0)), material = Material(base_color = vec4(0.85, 0.5, 0.2, 1), metallic = 1, roughness = 0.6))
    draw_mesh(ball, translation(vec3(1.5, 0.4, 0)), material = Material(base_color = vec4(0.4, 0.5, 0.65, 1), metallic = 0, roughness = 0.4))
