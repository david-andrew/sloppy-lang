# the 3D scene's depth (post_effects(..., scene_depth = true)) read by a pass of the game's own:
# drawn into a target of its own as fog (nearer: clearer), then shown over the right half of the
# screen. Also a draw_custom (transparent: after the sky) with its own draw state (no depth test: the
# yellow bar shows through the cube)
window("scene depth", 800, 450)
cube = cube_mesh(1)
struct SV:
    pos: vec2
struct SO:
    pos: vec4
    uv: vec2
struct SU:
    rect: vec4
    t: Texture
show_vs = (v: SV, u: SU) -> SO: SO(vec4(u.rect.xy + v.pos * u.rect.zw, 0, 1), v.pos)
show_fs = (i: SO, u: SU) -> vec4:
    d = sample(u.t, i.uv).x
    f = clamp((d - 0.9) * 10.0, 0.0, 1.0)
    vec4(f, f * 0.8, 1.0 - f, 1)
show = make_shader(shader(show_vs, show_fs))
unit = mesh([SV(vec2(0, 0)), SV(vec2(1, 0)), SV(vec2(1, 1)), SV(vec2(0, 0)), SV(vec2(1, 1)), SV(vec2(0, 1))])
struct BU:
    rect: vec4
bar_vs = (v: SV, u: BU) -> SO: SO(vec4(u.rect.xy + v.pos * u.rect.zw, 0.99, 1), v.pos)
bar_fs = (i: SO, u: BU) -> vec4: vec4(1, 0.9, 0.1, 1)
bar = make_shader(shader(bar_vs, bar_fs))
fog = render_target(400, 225)

draw = ():
    camera3d(vec3(0, 1.5, 4), vec3(0, 0, 0))
    sky(vec3(0.3, 0.4, 0.6), vec3(0.6, 0.7, 0.8))
    sun(vec3(1, 2, 1))
    post_effects(0, 1, 0, scene_depth = true)
    draw_mesh(cube, transform(vec3(-0.8, 0, 0)), vec4(0.8, 0.3, 0.2, 1))
    draw_mesh(cube, transform(vec3(1.2, 0, -2), 0.6), vec4(0.2, 0.7, 0.3, 1))
    draw_custom(():
        depth_test(.off)
        draw(bar, unit, BU(vec4(-0.9, -0.05, 1.8, 0.1))), transparent = true)
    draw_to(fog)
    clear()
    draw(show, unit, SU(vec4(-1, -1, 2, 2), scene_depth()))
    draw_to_screen()
    draw_target(fog, vec2(400, 0), vec2(400, 225))
