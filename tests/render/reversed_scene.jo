# the library's 3D with reversed depth (and a far view): ground, boxes casting shadows, a sphere,
# the sky behind them, fog, a box behind another drawn in front of everything, post effects (the scene's own
# target and its depth); the same picture as with the usual depth
window("reversed scene", 800, 450)
reversed_depth()
# (in 10 m squares: Apple's software OpenGL, which macOS CI draws with, loses most of a triangle
# reaching far off the screen)
ground = terrain_mesh(400.0, 40, (x: f64, z: f64) -> f64: 0.0, (x: f64, y: f64, z: f64) -> vec4: vec4(1, 1, 1, 1))
box = cube_mesh(1.0)
ball = sphere_mesh(0.6)
draw = ():
    clear(rgb(0.1, 0.1, 0.12))
    sky(vec3(0.25, 0.45, 0.8), vec3(0.75, 0.8, 0.85))
    sun(vec3(0.4, 0.8, 0.3))
    shadows(true)
    post_effects(0.3)
    fog(vec3(0.75, 0.8, 0.85), 0.004)
    camera3d(vec3(0, 3, 9), vec3(0, 0.5, 0), 60.0, 0.1, 100000.0)
    draw_mesh(ground, mat4(), rgb(0.45, 0.55, 0.35))
    loop i in [0..5):
        draw_mesh(box, translation(vec3(f32(i) * 2.0 - 4.0, 0.5, -f32(i) * 3.0)) * rotation_y(f64(i) * 0.4), rgb(0.8, 0.4 + 0.1 * f64(i), 0.3))
    draw_mesh(ball, translation(vec3(1.2, 1.2, 4.0)), rgb(0.3, 0.5, 0.9))
    draw_mesh(box, translation(vec3(-4.2, 0.8, -1.5)) * scaling(0.6), rgb(0.9, 0.9, 0.2), in_front = true)       # (behind the red box, drawn over it)
