# copy_depth: one target's depth copied into another, which a flat square is then drawn into,
# tested against the copy and tinted by sampling the first target's depth. Left: the second
# target's colors; right: its depth (the copy, with the square's where it was nearer)
window("copy depth", 800, 450)
struct V:
    pos: vec3
    color: vec4
struct O:
    pos: vec4
    color: vec4
struct U:
    m: mat4
vs = (v: V, u: U) -> O: O(u.m * vec4(v.pos, 1), v.color)
fs = (i: O, u: U) -> vec4: i.color
scene = make_shader(shader(vs, fs))
slant = mesh([V(vec3(-0.9, -0.8, -0.9), vec4(1, 0.3, 0.2, 1)), V(vec3(0.9, -0.8, 0.9), vec4(0.2, 1, 0.3, 1)), V(vec3(0, 0.9, 0), vec4(0.2, 0.3, 1, 1))])

struct SV:
    pos: vec2
struct SO:
    pos: vec4
    uv: vec2
struct SU:
    rect: vec4
    z: f32
    t: Texture
    mode: f32               # 0: the texture, 1: its .x as grey, 2: red, as bright as 1 - its .x
show_vs = (v: SV, u: SU) -> SO:
    p = u.rect.xy + v.pos * u.rect.zw
    # (the tinted square samples where it is in the target; the others, all of the texture)
    if u.mode > 1.5: return SO(vec4(p, u.z, 1), p * 0.5 + vec2(0.5, 0.5))
    SO(vec4(p, u.z, 1), v.pos)
show_fs = (i: SO, u: SU) -> vec4:
    c = sample(u.t, i.uv)
    if u.mode > 1.5: return vec4(1.0 - c.x, 0, 0, 1)
    if u.mode > 0.5: return vec4(c.x, c.x, c.x, 1)
    c
show = make_shader(shader(show_vs, show_fs))
unit = mesh([SV(vec2(0, 0)), SV(vec2(1, 0)), SV(vec2(1, 1)), SV(vec2(0, 0)), SV(vec2(1, 1)), SV(vec2(0, 1))])

a = render_target(400, 225, depth_texture = true)
b = render_target(400, 225, depth_texture = true)

draw = ():
    draw_to(a)
    clear(rgb(0.1, 0.1, 0.3))
    depth_test(.nearer)
    draw(scene, slant, U(mat4()))
    draw_to(b)
    clear(rgb(0.3, 0.3, 0.1))
    copy_depth(a, b)
    draw(show, unit, SU(vec4(-0.6, -0.6, 1.2, 1.2), 0.0, a.depth_texture, 2))
    depth_test(.off)
    draw_to_screen()
    clear(rgb(0.2, 0.2, 0.2))
    draw(show, unit, SU(vec4(-0.95, -0.5, 0.9, 1.0), 0.0, b.texture, 0))
    draw(show, unit, SU(vec4(0.05, -0.5, 0.9, 1.0), 0.0, b.depth_texture, 1))
