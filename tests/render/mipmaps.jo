# Mipmaps (made at a texture's first 3D draw, trilinear filtering). Boxes faced with a
# checkerboard of single red and blue texels, 256 across, drawn smaller than that: with
# mipmaps they are an even purple (each level averages the one before); without, they would
# be a moire of red and blue. A floor of soft checks runs to the horizon and fades to its
# average. The green box is pixel art (smooth = false): sharp texels, no mipmaps.
# (Moire depends on the resolution, which the software renderer halves: a texture without
# mipmaps, set_mipmaps(t, false), is checked in tests/t/mipmaps.jo instead.)
checks = (n: int, cell: int, a: vec4, b: vec4) -> Image:
    img = image(n, n)
    loop y in [0..n):
        loop x in [0..n):
            set(img, x, y, if ((x / cell) + (y / cell)) % 2 == 0: a else: b)
    img
fine = texture(checks(256, 1, rgb(0.9, 0.1, 0.1), rgb(0.1, 0.2, 0.9)))
floor_tex = texture(checks(192, 6, rgb(0.62, 0.6, 0.55), rgb(0.48, 0.5, 0.56)))
set_repeat(floor_tex, true)
sharp = texture(checks(16, 4, rgb(0.2, 0.8, 0.3), rgb(0.05, 0.2, 0.1)), smooth = false)
# a floor whose texture repeats every 1 / reps meters
quad = (x0: f32, z0: f32, x1: f32, z1: f32, reps: f32) -> Mesh:
    n = vec3(0, 1, 0)
    c = vec4(1, 1, 1, 1)
    vs = [Vertex3D(vec3(x0, 0, z0), n, vec2(0, 0), c), Vertex3D(vec3(x1, 0, z0), n, vec2(reps * (x1 - x0), 0), c),
          Vertex3D(vec3(x1, 0, z1), n, vec2(reps * (x1 - x0), reps * (z0 - z1)), c), Vertex3D(vec3(x0, 0, z1), n, vec2(0, reps * (z0 - z1)), c)]
    mesh(vs, [u32(0), u32(1), u32(2), u32(0), u32(2), u32(3)])
floor = quad(-4, 1, 4, -150, 0.25)          # (all on the screen: Apple's software OpenGL clips the rest differently)
box = cube_mesh(1.0)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 1.6, 6), vec3(0, 0.8, -10), 60)
    sun(vec3(-0.3, 1, 0.8), disc = 0)
    sky(vec3(0.3, 0.45, 0.7), vec3(0.6, 0.65, 0.7))
    fog(vec3(0, 0, 0), 0)
    shadows(false)
    draw_mesh(floor, texture = floor_tex, specular = 0)
    loop i in [0..4):
        s = 1.0 / f64(1 << i)
        draw_mesh(box, transform(vec3(0.3 + f32(i) * 1.1, 1.5, 0), 0.0, s), texture = fine, specular = 0, emissive = 0.3)
    draw_mesh(box, transform(vec3(-2.2, 0.8, 0.5), 0.6, 1.2), texture = sharp, specular = 0)
