# thick outlines: one band through the points, with no gaps at the bends (polyline, open and
# closed, sharp and gentle bends; a rounded rectangle's outline; a point given twice)
window("outlines", 800, 450)
draw = ():
    clear(rgb(0.1, 0.1, 0.15))
    zig: vec2[]
    loop i in [0..7): zig.push(vec2(f32(60 + i * 45), f32(if i % 2 == 0: 80 else: 160)))
    polyline(zig, 12, rgb(1, 0.8, 0.3))
    star: vec2[]
    loop i in [0..10):
        a = f64(i) * PI / 5.0 - PI / 2.0
        r = if i % 2 == 0: 90.0 else: 40.0
        star.push(vec2(f32(600.0 + cos(a) * r), f32(130.0 + sin(a) * r)))
    polyline(star, 8, rgb(0.4, 0.8, 1.0), closed = true)
    rect_rounded_outline(60, 260, 300, 140, 30, 14, rgb(0.9, 0.9, 0.9))
    polyline([vec2(450, 300), vec2(550, 300), vec2(550, 300), vec2(560, 400), vec2(740, 380)], 16, rgb(0.6, 1.0, 0.5))
