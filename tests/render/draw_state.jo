# draw state: blend modes (screen and none too), for draw and for 2D shapes; depth_test,
# depth_write, cull and color_write for draw. Each panel draws the nearer quad first, so
# that only the depth test can put it in front.
#   row 1: alpha, add, multiply, premultiplied, screen, none (top: draw, bottom: a 2D rect)
#   row 2: nearer, off, farther, equal, no depth write, no color write, nearer vs nearer_or_equal
#   row 3: cull back (CCW, CW), cull front (CCW, CW), cull none (CW), 2D under cull and depth test
window("draw state", 800, 450)
struct V:
    pos: vec2
struct U:
    rect: vec4
    z: f32
    color: vec4
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(vec4(u.rect.xy + v.pos * u.rect.zw, u.z, 1))
fs = (i: O, u: U) -> vec4: u.color
sh = make_shader(shader(vs, fs))
unit = mesh([V(vec2(0, 0)), V(vec2(1, 0)), V(vec2(1, 1)), V(vec2(0, 0)), V(vec2(1, 1)), V(vec2(0, 1))])

# a quad at window pixels (x, y) (top left), w x h, at clip depth z; mirrored: its corners go
# clockwise
quad = (x: f64, y: f64, w: f64, h: f64, z: f64, c: vec4, mirrored: bool = false):
    r = vec4(f32(x / 400.0 - 1.0), f32(1.0 - (y + h) / 225.0), f32(w / 400.0), f32(h / 225.0))
    if mirrored: r = vec4(r.x + r.z, r.y, -r.z, r.w)
    draw(sh, unit, U(r, f32(z), c))

RED = vec4(0.9, 0.15, 0.1, 1)
GREEN = vec4(0.1, 0.8, 0.2, 1)
BLUE = vec4(0.15, 0.3, 0.9, 1)
YELLOW = vec4(0.95, 0.85, 0.1, 1)

draw = ():
    clear(rgb(0.12, 0.12, 0.14))
    # row 1: blending over black and grey halves
    modes = [Blend.alpha, Blend.add, Blend.multiply, Blend.premultiplied, Blend.screen, Blend.none]
    loop i in 0.. and m in modes:
        x = 20.0 + f64(i) * 128.0
        blend(.alpha)
        rect(x, 15, 54, 120, rgb(0, 0, 0))
        rect(x + 54, 15, 54, 120, rgb(0.5, 0.5, 0.6))
        blend(m)
        quad(x + 10, 25, 88, 45, 0, vec4(0.9, 0.5, 0.2, 0.5))
        rect(x + 10, 80, 88, 45, vec4(0.2, 0.6, 0.9, 0.5))
    blend(.alpha)
    # row 2: the depth test
    y = 160.0
    depth_test(.nearer)
    quad(20, y, 60, 60, -0.5, GREEN)
    quad(50, y + 30, 60, 60, 0.5, RED)
    depth_test(.off)
    quad(130, y, 60, 60, -0.5, GREEN)
    quad(160, y + 30, 60, 60, 0.5, RED)
    depth_test(.always)
    quad(240, y, 60, 60, -0.5, GREEN)
    depth_test(.farther)
    quad(270, y + 30, 60, 60, 0.5, RED)
    depth_test(.always)
    quad(350, y, 80, 80, 0.0, BLUE)
    depth_test(.equal)
    quad(350, y, 50, 50, 0.0, YELLOW)
    quad(380, y + 30, 50, 50, 0.3, RED)
    depth_test(.nearer)
    depth_write(false)
    quad(460, y, 60, 60, -0.5, GREEN)
    depth_write(true)
    quad(490, y + 30, 60, 60, 0.5, RED)
    color_write(false)
    quad(570, y, 60, 60, -0.5, GREEN)
    color_write(true)
    quad(600, y + 30, 60, 60, 0.5, RED)
    depth_test(.always)
    quad(680, y, 40, 80, 0.2, GREEN)
    quad(730, y, 40, 80, 0.2, GREEN)
    depth_test(.nearer)
    quad(680, y, 40, 80, 0.2, RED)
    depth_test(.nearer_or_equal)
    quad(730, y, 40, 80, 0.2, RED)
    depth_test(.farther_or_equal)
    quad(690, y + 50, 70, 20, 0.2, YELLOW)
    depth_test(.off)
    # row 3: culling
    y = 300.0
    cull(.back)
    quad(20, y, 70, 70, 0, GREEN)
    quad(100, y, 70, 70, 0, RED, mirrored = true)
    cull(.front)
    quad(200, y, 70, 70, 0, RED)
    quad(280, y, 70, 70, 0, BLUE, mirrored = true)
    cull(.none)
    quad(380, y, 70, 70, 0, YELLOW, mirrored = true)
    # (2D shapes are flat: drawn whatever cull and depth_test say)
    cull(.back)
    depth_test(.farther)
    rect(480, y, 70, 70, rgb(0.8, 0.4, 0.9))
    circle(vec2(620, y + 35), 35, rgb(0.4, 0.9, 0.9))
