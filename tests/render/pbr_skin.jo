# The same glTF PBR normal-map material at rest and animated by a joint; tangents and
# normals follow the joint before the nonuniform model scale. Procedural CC0 fixture.
actor = load_model(embed("pbr_skin.gltf")).unwrap()
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 0.3, 7), vec3(0, 0, 0), 42)
    sun(vec3(-1, 1, 2), disc = 0)
    sky(vec3(0.12, 0.28, 0.5), vec3(0.5, 0.65, 0.8))
    shadows(false)
    fog(vec3(0, 0, 0), 0)
    draw_model(actor, translation(vec3(-1.2, 0, 0)) * scaling(vec3(0.9, 1.1, 1)))
    draw_model(actor, translation(vec3(1.2, 0, 0)) * scaling(vec3(0.9, 1.1, 1)), pose = pose_at(actor, 0, 0.65, false))
