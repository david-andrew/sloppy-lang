# pixel_art(): lines (a pixel wide: Bresenham's; thicker), circles, rings, arcs, ellipses, a
# polyline and rects at half pixels as whole pixels in exactly their colors, the same on every
# renderer; text in pixel_font() at 1x and 2x; palette swaps of drawing (a sprite, a shape) and of
# the screen. (Its reference was drawn by Vulkan.)
window("pixelshapes", 96, 54)
pixel_art()
PAL = [hex(0x000000), hex(0x1d2b53), hex(0x7e2553), hex(0x008751), hex(0xab5236), hex(0x5f574f), hex(0xc2c3c7), hex(0xfff1e8),
       hex(0xff004d), hex(0xffa300), hex(0xffec27), hex(0x00e436), hex(0x29adff), hex(0x83769c), hex(0xff77a8), hex(0xffccaa)]
bug = texture(pixel_image("
    .8....8.
    ..8888..
    .888888.
    88a88a88
    88888888
    .2.22.2.", PAL))

draw = ():
    clear(PAL[1])
    line(vec2(2, 2), vec2(40, 12), 1, PAL[8])
    line(vec2(2, 14), vec2(12, 4), 1, PAL[9])
    line(vec2(44, 3), vec2(58, 9), 3, PAL[12])
    circle(vec2(70, 9), 6, PAL[10])
    ring(vec2(86, 9), 6.5, 1, PAL[11])
    arc(vec2(14, 26), 7, 2, 0.0, PI, PAL[14])
    ellipse(vec2(34, 24), vec2(8, 4), PAL[13])
    polyline([vec2(46, 18), vec2(56, 30), vec2(64, 18)], 1, PAL[7])
    rect(68.5, 20.5, 7, 5, PAL[15])
    rect_outline(78, 18, 14, 10, 1, PAL[6])
    text("HELLO, PICO!", vec2(2, 34), 6, PAL[7])
    text("2X", vec2(52, 34), 12, PAL[9])
    sprite(bug, vec2(70, 34))
    palette_swap(PAL[8], PAL[11])
    sprite(bug, vec2(80, 34))
    rect(70, 44, 18, 2, PAL[8])
    palette_reset()
    rect(70, 48, 18, 2, PAL[8])
    # (white is shown as peach, all of the frame: what was white before this too)
    palette_swap(PAL[7], PAL[15], screen = true)
