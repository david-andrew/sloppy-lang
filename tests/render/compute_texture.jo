# a compute function reading a texture (texel), after another texture was deleted and its GL
# name reused: the band shows the texture's color as the compute function wrote it into a buffer
# not with OpenGL (compute functions run on the CPU there, where texel() gives white)
struct V:
    pos: vec3
struct U:
    mvp: mat4
    colors: GpuBuffer[vec4]
struct O:
    pos: vec4
struct P:
    t: Texture
    out: GpuBuffer[vec4]
grab = (id: int, p: P): p.out[id] = texel(p.t, ivec2(i32(id), 0))
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4: u.colors[int(i.pos.x / 1280.0 * 2.0)]
gone = texture(image(2, 1, vec4(1, 0, 0, 1)), false)
gl_delete_texture(gone.id)
pic = image(2, 1, vec4(0, 1, 0, 1))
pic.pixels[4] = 0
pic.pixels[5] = 0
pic.pixels[6] = 255
t = texture(pic, false)
colors: GpuBuffer[vec4] = gpu_buffer(2)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    dispatch(compute(grab), 2, P(t, colors))
    draw(sh, m, U(mat4(), colors))
