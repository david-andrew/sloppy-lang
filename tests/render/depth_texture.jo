# a render target's depth as a texture, sampled by a later pass: left, its depth (a slanted
# triangle crossing a flat square, the nearer drawn), right, its colors
window("depth texture", 800, 450)
struct V:
    pos: vec3
    color: vec4
struct O:
    pos: vec4
    color: vec4
struct U:
    m: mat4
vs = (v: V, u: U) -> O: O(u.m * vec4(v.pos, 1), v.color)
fs = (i: O, u: U) -> vec4: i.color
scene = make_shader(shader(vs, fs))
shapes = mesh([
    V(vec3(-0.9, -0.8, -0.9), vec4(1, 0.3, 0.2, 1)), V(vec3(0.9, -0.8, 0.9), vec4(0.2, 1, 0.3, 1)), V(vec3(0, 0.9, 0), vec4(0.2, 0.3, 1, 1)),
    V(vec3(-0.5, -0.5, 0.1), vec4(1, 0.9, 0.2, 1)), V(vec3(0.5, -0.5, 0.1), vec4(1, 0.9, 0.2, 1)), V(vec3(0.5, 0.5, 0.1), vec4(1, 0.9, 0.2, 1)),
    V(vec3(-0.5, -0.5, 0.1), vec4(1, 0.9, 0.2, 1)), V(vec3(0.5, 0.5, 0.1), vec4(1, 0.9, 0.2, 1)), V(vec3(-0.5, 0.5, 0.1), vec4(1, 0.9, 0.2, 1))])

# a texture shown in a rectangle of the screen (clip space); depth: its .x as grey
struct SV:
    pos: vec2
struct SO:
    pos: vec4
    uv: vec2
struct SU:
    rect: vec4
    t: Texture
    depth: f32
show_vs = (v: SV, u: SU) -> SO: SO(vec4(u.rect.xy + v.pos * u.rect.zw, 0, 1), v.pos)
show_fs = (i: SO, u: SU) -> vec4:
    c = sample(u.t, i.uv)
    if u.depth > 0.5: return vec4(c.x, c.x, c.x, 1)
    c
show = make_shader(shader(show_vs, show_fs))
unit = mesh([SV(vec2(0, 0)), SV(vec2(1, 0)), SV(vec2(1, 1)), SV(vec2(0, 0)), SV(vec2(1, 1)), SV(vec2(0, 1))])

rt = render_target(400, 225, depth_texture = true)

draw = ():
    draw_to(rt)
    clear(rgb(0.1, 0.1, 0.3))
    depth_test(.nearer)
    draw(scene, shapes, U(mat4()))
    depth_test(.off)
    draw_to_screen()
    clear(rgb(0.2, 0.2, 0.2))
    draw(show, unit, SU(vec4(-0.95, -0.5, 0.9, 1.0), rt.depth_texture, 1))
    draw(show, unit, SU(vec4(0.05, -0.5, 0.9, 1.0), rt.texture, 0))
