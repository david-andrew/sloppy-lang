# integer rules in shaders, as on the CPU: unsigned division, remainder, shifts and comparisons;
# narrow types wrap; float to integer truncates and saturates; bools convert to 0 and 1.
# A band of the screen for each check: green when it holds, red when not
struct V:
    pos: vec3
struct U:
    mvp: mat4
    a: u32
    b: u32
    f: vec4
struct O:
    pos: vec4
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
check = (k: int, u: U) -> bool:
    a = u.a
    b = u.b
    if k == 0: return a / b == u32(613566754)
    if k == 1: return a % b == u32(5)
    if k == 2: return a >> u32(4) == u32(268435455)
    if k == 3: return a > b
    if k == 4: return u8(a) == u8(243)
    if k == 5: return i8(a) == i8(-13)
    if k == 6:
        x = u8(200)
        x += u8(b * u32(14))
        return x == u8(42)
    if k == 7: return i32(u.f.x) == i32(2147483647)
    if k == 8: return u32(u.f.y) == u32(0)
    if k == 9: return u8(u.f.z) == u8(255)
    if k == 10: return i32(u.f.w) == i32(-7)
    if k == 11: return i32(b == u32(7)) == i32(1)
    if k == 12: return u32(u.f.x) == u32(4294967295)
    f32(a) > 4e9
fs = (i: O, u: U) -> vec4:
    if check(int(i.pos.x / 1280.0 * 14.0), u): return vec4(0, 1, 0, 1)
    vec4(1, 0, 0, 1)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    draw(sh, m, U(mat4(), u32(0xFFFFFFF3), u32(7), vec4(1e10, -5, 300.7, -7.9)))
