# 3D drawn after 2D in the same frame: the earlier 3D stays (no sky drawn over it) and its
# objects still cast shadows; labels placed with world_to_screen sit over the balls
ball = sphere_mesh(0.5)
floor_mesh = plane_mesh(6)           # (all of it on screen: Apple's software OpenGL, on CI, clips triangles that reach off it differently)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(3, 4, 8), vec3(0, 0, 0))
    sky(vec3(0.3, 0.5, 0.9), vec3(0.8, 0.85, 0.9))
    sun(vec3(1, 2, 1))
    draw_mesh(floor_mesh, transform(vec3(0, -0.5, 0)), vec4(0.6, 0.6, 0.6, 1))
    loop p in [vec3(0, 0, 0), vec3(2, 1, -1), vec3(-2, 0.5, 1)]:
        draw_mesh(ball, transform(p), RED)
        if let s = world_to_screen(p + vec3(0, 0.8, 0)): circle(s, 8, YELLOW)
    if world_to_screen(vec3(3, 4, 20)) == none: rect(vec2(10, 10), vec2(40, 40), GREEN)
