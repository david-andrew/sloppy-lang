# arrays of arrays in shader code (GLSL ES has none: they are kept in structs there). A band for
# each check: green when it holds
struct V:
    pos: vec3
struct U:
    mvp: mat4
struct O:
    pos: vec4
struct Grid:
    cells: i32[3][2]
row_sum = (r: i32[3]) -> i32: r[0] + r[1] + r[2]
transpose = (m: f32[2][2]) -> f32[2][2]: [[m[0][0], m[1][0]], [m[0][1], m[1][1]]]
bump = (g: mut i32[3][2], i: int):
    g[i][2] += i32(100)
check = (k: int) -> bool:
    a: i32[3][2] = [[1, 2, 3], [4, 5, 6]]
    if k == 0: return a[1][2] == i32(6) and a[0][1] == i32(2)
    if k == 1:
        a[1][0] = i32(40)
        a[0] = [i32(7), i32(8), i32(9)]
        return a[1][0] == i32(40) and a[0][2] == i32(9) and a[1][1] == i32(5)
    if k == 2:
        s = i32(0)
        loop r in a: s += row_sum(r)
        return s == i32(21)
    if k == 3:
        g = Grid(a)
        bump(g.cells, 1)
        return g.cells[1][2] == i32(106) and row_sum(g.cells[0]) == i32(6)
    if k == 4:
        t = transpose([[1.0, 2.0], [3.0, 4.0]])
        return t[0][1] == 3.0 and t[1][0] == 2.0
    z: f32[2][2]
    j = 1
    z[j][j] = 5.0
    w: u8[2][3] = fill([u8(1), u8(2)], 3)
    z[1][1] == 5.0 and z[0][1] == 0.0 and w[2][1] == u8(2)
vs = (v: V, u: U) -> O: O(u.mvp * vec4(v.pos, 1))
fs = (i: O, u: U) -> vec4:
    if check(int(i.pos.x / 1280.0 * 6.0)): return vec4(0, 1, 0, 1)
    vec4(1, 0, 0, 1)
sh = make_shader(shader(vs, fs))
m = mesh([V(vec3(-1, -1, 0.5)), V(vec3(3, -1, 0.5)), V(vec3(-1, 3, 0.5))])
draw = ():
    clear()
    draw(sh, m, U(mat4()))
