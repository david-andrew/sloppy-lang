# a band at infinity all round the eye (corners vec4(dir, 0) through the view and projection, as
# a sky's glow at the horizon is drawn), the camera pitched up at it: corners beside and behind
# the eye have w near 0 or below. The software renderer clips them to its guard band as a GPU
# does (they drew as wedges of saturated color). Each sector's color runs smoothly along it.
window("sky band", 800, 450)
struct V:
    dir: vec3
    tint: vec4
struct Out:
    pos: vec4
    tint: vec4
struct U:
    view_proj: mat4
vs = (v: V, u: U) -> Out:
    c = u.view_proj * vec4(v.dir, 0)
    Out(vec4(c.xy, c.w * 0.9999, c.w), v.tint)
fs = (i: Out, u: U) -> vec4: i.tint
sh = make_shader(shader(vs, fs))
verts: V[]
n = 48
loop k in [0..n):
    a0 = f64(k) / f64(n) * 2.0 * PI
    a1 = f64(k + 1) / f64(n) * 2.0 * PI
    t0 = vec4(f32(0.5 + 0.5 * cos(a0)), f32(0.5 + 0.5 * sin(a0 * 2.0)), f32(0.5 - 0.5 * cos(a0)), 1)
    t1 = vec4(f32(0.5 + 0.5 * cos(a1)), f32(0.5 + 0.5 * sin(a1 * 2.0)), f32(0.5 - 0.5 * cos(a1)), 1)
    lo0 = vec3(f32(cos(a0)), -0.05, f32(sin(a0)))
    lo1 = vec3(f32(cos(a1)), -0.05, f32(sin(a1)))
    hi0 = vec3(f32(cos(a0)), 0.35, f32(sin(a0)))
    hi1 = vec3(f32(cos(a1)), 0.35, f32(sin(a1)))
    dark = vec4(0.1, 0.1, 0.2, 1)
    verts.push(V(lo0, t0))
    verts.push(V(lo1, t1))
    verts.push(V(hi1, dark))
    verts.push(V(lo0, t0))
    verts.push(V(hi1, dark))
    verts.push(V(hi0, dark))
band = mesh(verts)
draw = ():
    clear(rgb(0.05, 0.05, 0.08))
    eye = vec3(0, 0, 0)
    view = look_at(eye, vec3(0.3, 0.45, -1), vec3(0, 1, 0))
    proj = perspective(1.1, 800.0 / 450.0, 0.1, 1000.0)
    depth_test(.off)
    cull(.none)
    draw(sh, band, U(proj * view))
