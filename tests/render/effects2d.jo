# effects on 2D drawing: shader(effect_vs, fragment function) with parameters of the program's own; base_color is what drawing would have made; text and shapes alike; no_effect goes back
window("effects", 800, 450)
struct Glow:
    strength: f32
    tint: vec3
glow_fs = (p: Pixel2D, u: Effect2D[Glow]) -> vec4:
    c = base_color(p, u)
    vec4(c.xyz * u.params.tint * u.params.strength, c.w)
gray_fs = (p: Pixel2D, u: Effect2D[f32]) -> vec4:
    c = base_color(p, u)
    g = dot(c.xyz, vec3(0.3, 0.59, 0.11))
    vec4(mix(c.xyz, vec3(g, g, g), u.params), c.w)
glow = make_shader(shader(effect_vs, glow_fs))
gray = make_shader(shader(effect_vs, gray_fs))
draw = ():
    clear(rgb(0.1, 0.1, 0.15))
    circle(vec2(200, 200), 80, rgb(0.9, 0.3, 0.2))
    use_effect(glow, Glow(1.5, vec3(0.3, 1.0, 0.6)))
    circle(vec2(450, 200), 80, rgb(0.9, 0.3, 0.2))
    text("glowing text", vec2(350, 320), 40.0, WHITE)
    use_effect(gray, f32(1.0))
    circle(vec2(700, 200), 80, rgb(0.9, 0.3, 0.2))
    text("gray text", vec2(620, 320), 40.0, rgb(1, 0.8, 0.2))
    no_effect()
    text("normal", vec2(100, 320), 40.0, rgb(1, 0.8, 0.2))
