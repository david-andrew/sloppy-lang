# clip rectangles: 2D drawing shows only inside, translate does not move the clip, text is cut,
# a render target has its own, clear() clears everything, 3D is not clipped
window("clip", 800, 450)
rt = render_target(200, 100)
cube = cube_mesh(1.5)
draw = ():
    clear(rgb(0.1, 0.1, 0.15))
    clip(vec2(600, 300), vec2(100, 100))
    camera3d(vec3(0, 2, 6), vec3(0, 0, 0))
    draw_mesh(cube, rotation_y(0.6), rgb(0.9, 0.4, 0.2))
    clip(vec2(50, 50), vec2(200, 120))
    loop i in [0..20): circle(vec2(50 + i * 20, 110), 30, rgb(0.3 + 0.03 * i, 0.5, 0.8))
    text("clipped text that runs far past the box", vec2(40, 140), 24.0, WHITE)
    no_clip()
    rect(vec2(48, 48), vec2(204, 2), RED)
    push_transform()
    translate(300, 0)
    clip(vec2(350, 200), vec2(150, 150))
    rect(vec2(0, 180), vec2(400, 400), YELLOW)
    pop_transform()
    circle(vec2(500, 350), 40, BLUE)
    no_clip()
    draw_to(rt)
    clear(rgb(0.2, 0, 0))
    clip(vec2(10, 10), vec2(50, 50))
    rect(vec2(0, 0), vec2(200, 100), GREEN)
    draw_to_screen()
    draw_target(rt, vec2(550, 50))
    clip(vec2(0, 400), vec2(100, 50))
