# `sloppy test` with failing tests: each is reported, the rest still run, and the exit status is 1
# (where tests run in processes of their own: Linux, macOS)
add = (a: int, b: int) -> int: a + b
test "adds":
    assert(add(1, 2) == 3)
test "fails":
    assert(add(1, 2) == 4, "1 + 2 is {add(1, 2)}")
test "panics":
    xs: int[]
    print(xs[3])
test "still runs":
    print("in the last test")
    assert(add(2, 2) == 4)
