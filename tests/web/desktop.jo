# a web page for tools/webtest.py, as on a computer: text typed through an input method or the
# emoji panel, files dropped and chosen in the browser's picker (o opens it), the pointer's shape
# (a hand right of the middle), and frames drawn only as input comes (redraw_on_input)
redraw_on_input()
asked = -1
draw = ():
    global asked
    clear()
    print("frame:{frame_number()}")
    t = text_input()
    if len(t) > 0: print("typed:{t}")
    loop p in dropped_files(): print("dropped:{p}:{len(read_file(p) ?? "")}")
    if key_pressed(.o): asked = open_file_dialog([".txt", "md"], multiple = true)
    if asked >= 0:
        if let ps = file_dialog_result(asked):
            asked = -1
            got: str[]
            loop p in ps: got.push("{p}:{len(read_file(p) ?? "")}")
            print("opened:{join(got, ",")}")
    set_cursor(if mouse_pos().x > 640.0: Cursor.hand else: Cursor.arrow)
