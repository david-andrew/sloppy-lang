# No tasks: polling each frame lets the browser run without JSPI.
import net

r = net.fetch("/hello")
assert(r.status == 0 and contains(r.why, "fetch_start"))
rs = net.fetch_all(["/hello"])
assert(rs[0].status == 0 and contains(rs[0].why, "outside a task"))
f = net.fetch_start("/hello", save_to = "out.txt")
r = net.fetch_result(f)!
assert(r.status == 0 and contains(r.why, "save_to"))
f = net.fetch_start("/hello", cookies = net.cookie_jar())
r = net.fetch_result(f)!
assert(r.status == 0 and contains(r.why, "CookieJar"))
f = net.fetch_start("/hang", wait = 0.1)
hello = net.fetch_start("/hello")
cancel = net.fetch_start("/hang")
net.fetch_cancel(cancel)
net.fetch_cancel(cancel)
received = false
timed_out = false

update = (dt: f64):
    global received, timed_out
    if not received:
        if let r = net.fetch_result(hello):
            assert(r.status == 200 and r.text == "hello")
            received = true
    if not timed_out:
        if let r = net.fetch_result(f):
            assert(r.status == 0 and contains(r.why, "timed out"))
            timed_out = true
    if received and timed_out:
        print("PASS page polling")
        exit(0)

draw = (): clear()
