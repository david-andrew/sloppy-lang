# a text field in a web page, for tools/webtest.py: what it holds is printed as it changes; and a
# list of buttons, which say when they are pressed and how far the list is scrolled
v = ""
last = ""
last_off = 0.0
draw = ():
    global last, last_off, v
    clear()
    v = hud_text_field(Rect(20, 20, 400, 40), v, "f")
    if v != last:
        print("value:{v}")
        last = v
    r = Rect(20, 200, 400, 400)
    off = hud_scroll(r, 20 * 50, "list")
    if off != last_off: print("scrolled:{int(off)}")
    last_off = off
    clip(r)
    loop i in [0..20):
        if hud_button(Rect(r.x, r.y + i * 50 - off, r.w - 20, 44), "row {i}"): print("pressed:{i}")
    no_clip()
