# Shaders are linked at their first draw or by warm_up_shaders, oldest first; one made with
# warm = false only when drawn, by warm_up(sh) or once warm_up_later queues it; one made again from
# the same source is the program made before (tools/webperfcheck.mjs counts the page's links and
# reads its lines).
struct LzVertex:
    pos: vec3
struct LzUniforms:
    color: vec4
    scale: f32
struct LzOut:
    pos: vec4
lz_vs = (v: LzVertex, u: LzUniforms) -> LzOut: LzOut(vec4(v.pos * u.scale, 1))
lz_first_fs = (i: LzOut, u: LzUniforms) -> vec4: u.color
lz_second_fs = (i: LzOut, u: LzUniforms) -> vec4: vec4(u.color.y, u.color.x, u.color.z, 1)
lz_third_fs = (i: LzOut, u: LzUniforms) -> vec4: vec4(u.color.z, u.color.y, u.color.x, 1)
lz_fourth_fs = (i: LzOut, u: LzUniforms) -> vec4: vec4(u.color.x, u.color.x, u.color.z, 1)
lz_fifth_fs = (i: LzOut, u: LzUniforms) -> vec4: vec4(u.color.z, u.color.x, u.color.x, 1)
window("lazy shaders", 64, 64)
first = make_shader(shader(lz_vs, lz_first_fs))
second = make_shader(shader(lz_vs, lz_second_fs))
fourth = make_shader(shader(lz_vs, lz_fourth_fs), warm = false)
third = make_shader(shader(lz_vs, lz_third_fs))
fifth = make_shader(shader(lz_vs, lz_fifth_fs), warm = false)
tri = mesh([LzVertex(vec3(-1, -1, 0)), LzVertex(vec3(3, -1, 0)), LzVertex(vec3(-1, 3, 0))])
copy = third                  # (a copy of a shader made before it is linked draws as well)
print("lazy made {shaders_pending()}")
step = 0
pixel = (sh: Shader, color: vec4) -> str:
    clear(BLACK)
    draw(sh, tri, LzUniforms(color, 1.0))
    px: u8[] = fill(u8(0), 4)
    gl_read_pixels(32, 32, 1, 1, data(px))
    "{px[0]},{px[1]},{px[2]}"
draw = ():
    global step
    step += 1
    if step == 1: print("lazy drawn first {pixel(first, vec4(1, 0, 0, 1))} pending {shaders_pending()}")
    else if step == 2: print("lazy warm one {warm_up_shaders(max_count = 1)}")
    else if step == 3: print("lazy warm all {warm_up_shaders()}")
    else if step == 4: print("lazy drawn second {pixel(second, vec4(1, 0, 0, 1))} third {pixel(copy, vec4(1, 0, 0, 1))} pending {shaders_pending()}")
    else if step == 5:
        # (made again, as a game's view rebuilt makes its shaders again: the same programs)
        again = make_shader(shader(lz_vs, lz_first_fs))
        later = make_shader(shader(lz_vs, lz_fourth_fs))
        print("lazy again {int(again.prog == first.prog)} {int(later.prog == fourth.prog)} drawn {pixel(again, vec4(0, 1, 0, 1))} pending {shaders_pending()}")
    else if step == 6: print("lazy warm later {warm_up_shaders()}")
    else if step == 7:
        warm_up(fifth)
        print("lazy drawn fourth {pixel(fourth, vec4(1, 0, 0, 1))} fifth {pixel(fifth, vec4(1, 0, 0, 1))} pending {shaders_pending()}")
