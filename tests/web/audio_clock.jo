# a web page for tools/webtest.py: the audio clock in a browser (smooth, never going back) once a
# click starts the sound, and the times of key presses
window("audio clock", 320, 200)
quiet = tone(440.0, 0.05, volume = 0.0)
played = false
update = (dt: f64):
    global played
    if mouse_pressed(.left) and not played:
        played = true
        play(quiet)
    if audio_started(): print("clock:{time()}:{audio_time()}:{audio_latency()}")
    if key_pressed(.d): print("press:{key_presses(.d)}:{elapsed() - key_press_time(.d)}")
draw = (): clear(BLACK)
