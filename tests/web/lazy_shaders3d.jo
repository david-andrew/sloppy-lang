# The library's 3D shaders are queued for warm_up_shaders only while their feature is on: shadows
# are off here and no instanced 3D draw is reachable, so neither the shadow nor the instanced
# programs are linked. A game's view made again (as a ship view rebuilt for a new game: its
# shaders made again from the same source, drawn with other meshes and instance buffers) links
# nothing more. (tools/webperfcheck.mjs counts the page's links and reads its lines)
struct VwInst:
    model: mat4
    color: vec4
struct VwParams:
    vp: mat4
struct VwOut:
    pos: vec4
    color: vec4
vw_vs = (v: Vertex3D, i: VwInst, u: VwParams) -> VwOut: VwOut(u.vp * i.model * vec4(v.pos, 1), v.color * i.color)
vw_hull_fs = (o: VwOut, u: VwParams) -> vec4: o.color
vw_smoke_fs = (o: VwOut, u: VwParams) -> vec4: vec4(o.color.xyz, 0.5)

struct View:
    hull: Shader
    smoke: Shader
    hull_mesh: Mesh
    smoke_mesh: Mesh
    ships: InstanceBuffer[VwInst]
    puffs: InstanceBuffer[VwInst]

make_view = () -> View:
    View(make_shader(shader(vw_vs, vw_hull_fs)), make_shader(shader(vw_vs, vw_smoke_fs)), cube_mesh(0.5), sphere_mesh(0.3, 8, 4),
         instance_buffer([VwInst(translation(vec3(-1, 0, 0)), rgb(0.8, 0.8, 0.9)), VwInst(translation(vec3(1, 0, 0)), rgb(0.9, 0.8, 0.8))]),
         instance_buffer([VwInst(translation(vec3(0, 1, 0)), rgba(0.4, 0.4, 0.4, 1))]))

draw_view = (v: View):
    vp = perspective(1.0, 1.0, 0.1, 50.0) * look_at(vec3(0, 1, 5), vec3(0, 0, 0), vec3(0, 1, 0))
    draw_instanced(v.hull, v.hull_mesh, v.ships, VwParams(vp))
    draw_instanced(v.smoke, v.smoke_mesh, v.puffs, VwParams(vp))

window("lazy shaders 3d", 64, 64)
shadows(false)
ships = make_view()
box = cube_mesh(1.0)
print("lazy3d start pending {shaders_pending()}")          # (the view's two, the lit and the sky shaders)
step = 0
draw = ():
    global step, ships
    step += 1
    camera3d(vec3(0, 1, 4), vec3(0, 0, 0), 60.0)
    draw_mesh(box, mat4(), rgb(0.8, 0.3, 0.2))
    if step >= 2: draw_view(ships)
    if step == 3: print("lazy3d pending {shaders_pending()}")
    else if step == 4: print("lazy3d warm all {warm_up_shaders()}")
    else if step == 5:
        ships = make_view()
        print("lazy3d made again pending {shaders_pending()}")
    else if step == 7: print("lazy3d done pending {shaders_pending()}")
