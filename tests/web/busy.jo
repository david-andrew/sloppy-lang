# a web page for tools/webperfcheck.mjs: a game's frame through the page's runtime (shapes, text,
# sound playing, the canvas's size, whether a finger is the pointer, a shader of its own drawn
# with uniforms from an indexed mesh), to count what the runtime allocates in JavaScript each
# frame and what numbers the module hands it
window("busy", 320, 200)

struct QuadVertex:
    pos: vec2
struct QuadParams:
    center: vec2
    tint: vec3
    fade: f32
    size: f64
struct QuadOut:
    pos: vec4
quad_vs = (v: QuadVertex, u: QuadParams) -> QuadOut: QuadOut(vec4(u.center + v.pos * f32(u.size), 0, 1))
quad_fs = (i: QuadOut, u: QuadParams) -> vec4: vec4(u.tint * u.fade, 1)
quad_shader = make_shader(shader(quad_vs, quad_fs))
quad = mesh([QuadVertex(vec2(-1, -1)), QuadVertex(vec2(1, -1)), QuadVertex(vec2(1, 1)), QuadVertex(vec2(-1, 1))], [u32(0), 1, 2, 0, 2, 3])
hum = tone(220.0, 0.5, volume = 0.0)
hum_id = -1
t = 0.0
update = (dt: f64):
    global t, hum_id
    t += dt
    if hum_id < 0: hum_id = play(hum, looping = true)
    if touch_device(): t += 0.0
draw = ():
    clear(rgb(0.05, 0.05, 0.1))
    loop i in 0..40: circle(vec2(160.0 + 120.0 * cos(t + f64(i) * 0.3), 100.0 + 80.0 * sin(t * 1.3 + f64(i) * 0.2)), 6.0, rgba(0.3, 0.6, 1.0, 0.8))
    loop i in 0..8:
        draw(quad_shader, quad, QuadParams(vec2(-0.8 + 0.2 * f32(i), 0.6), vec3(0.2, 0.9, 0.4), 0.5 + 0.5 * f32(sin(t)), 0.05))
    rect(vec2(10.0, 10.0), vec2(40.0 + 20.0 * sin(t), 20.0), rgb(1.0, 0.5, 0.2))
    text("frame {int(t * 60.0)}", vec2(10.0, 170.0), 16, WHITE)
    if screen_size().x < 0.0: print("never")
