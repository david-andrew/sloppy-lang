# a web page for tools/webperfcheck.mjs: a game's frame through the page's runtime (shapes, text,
# sound playing, the canvas's size, whether a finger is the pointer), to count what the runtime
# allocates in JavaScript each frame
window("busy", 320, 200)
hum = tone(220.0, 0.5, volume = 0.0)
hum_id = -1
t = 0.0
update = (dt: f64):
    global t, hum_id
    t += dt
    if hum_id < 0: hum_id = play(hum, looping = true)
    if touch_device(): t += 0.0
draw = ():
    clear(rgb(0.05, 0.05, 0.1))
    loop i in 0..40: circle(vec2(160.0 + 120.0 * cos(t + f64(i) * 0.3), 100.0 + 80.0 * sin(t * 1.3 + f64(i) * 0.2)), 6.0, rgba(0.3, 0.6, 1.0, 0.8))
    rect(vec2(10.0, 10.0), vec2(40.0 + 20.0 * sin(t), 20.0), rgb(1.0, 0.5, 0.2))
    text("frame {int(t * 60.0)}", vec2(10.0, 170.0), 16, WHITE)
    if screen_size().x < 0.0: print("never")
