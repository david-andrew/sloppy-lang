# two web pages connected through lib/invite.jo's screens, clicked through as players would (for
# tools/webtest.py, which passes the link and the reply between them by the clipboard); each says
# hello once connected and prints what it gets. It reads net.receive() every frame, as games do.
# With a matchmaking server (?server=: tools/web_room.mjs), it prints what its room and its
# joining say as that changes, and has Play with anybody; with WebRTC turned off in the browser,
# it prints what the screen says
build:
    name = "invite_ui"

import net
import invite

friend = -1
invite.from_link()
said = ""
route = ""

update = (dt: f64):
    global route, said
    loop e in net.receive():
        if e.kind == .message: print("got: {e.text}")
    # (how the friend is reached, once the browser says)
    if friend >= 0 and len(route) == 0:
        route = net.route(friend)
        if len(route) > 0: print("route: {route}")
    now = "{invite.room_status()}|{invite.__inv_join_state}"
    if invite.active() and len(net.webrtc_missing()) > 0: now = "the screen says: {net.webrtc_missing()}"
    if now != said:
        said = now
        print("room: {said}")

draw = ():
    global friend
    clear()
    if friend >= 0: return
    if invite.active():
        if let c = invite.screen("the test"):
            if c.peer < 0: print("hosts the public room {invite.room_public()}")
            else:
                friend = c.peer
                print("connected: inviter {c.inviter}")
                net.send(friend, "hello from the {if c.inviter: "inviter" else: "friend"}")
        return
    ui_begin("menu", vec2(640, 300))
    if ui_button("Invite a friend"): invite.start()
    if ui_button("Join a friend"): invite.join()
    if ui_button("Play with anybody"): invite.anybody()
    ui_end()
    # (hosting the public room: the one who comes)
    loop c in invite.arrivals():
        friend = c.peer
        print("connected: inviter {c.inviter}")
        net.send(friend, "hello from the inviter")
