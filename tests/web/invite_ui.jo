# two web pages connected through lib/invite.jo's screens, clicked through as players would (for
# tools/webtest.py, which passes the link and the reply between them by the clipboard); each says
# hello once connected and prints what it gets. It reads net.receive() every frame, as games do
import net
import invite

friend = -1
invite.from_link()

update = (dt: f64):
    loop e in net.receive():
        if e.kind == .message: print("got: {e.text}")

draw = ():
    clear()
    if friend >= 0: return
    if invite.active():
        if let c = invite.screen("the test"):
            friend = c.peer
            print("connected: inviter {c.inviter}")
            net.send(friend, "hello from the {if c.inviter: "inviter" else: "friend"}")
        return
    ui_begin("menu", vec2(640, 300))
    if ui_button("Invite a friend"): invite.start()
    if ui_button("Join a friend"): invite.join()
    ui_end()
