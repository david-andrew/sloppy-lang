# a player of tools/netpong_relay.py: told host or guest, then a message each way through it
import net
port = to_int(env("NET_PORT") ?? "47200") ?? 47200
p = net.connect("ws://localhost:{port}")
role = ""
t0 = time()
done = false
loop not done and time() - t0 < 20.0:
    loop e in net.receive():
        if e.kind == .left: done = true
        else if e.kind == .message:
            if e.text == "host" or e.text == "guest":
                role = e.text
                print("{role}: connected")
            else if e.text == "j":
                print("host: the other came")
                net.send(p, "ping")
            else if e.text == "ping":
                print("guest: got ping")
                net.send(p, "pong")
            else if e.text == "pong":
                print("host: got pong")
                net.close(p)
                done = true
            else if e.text == "l":
                print("{role}: the other left")
                done = true
    sleep(0.02)
