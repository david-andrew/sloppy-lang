import test_ports
# tools/web_rejoin.mjs: a relay for tests/net/rejoin_page.jo's pages (netplay.relay), until stopped
import net
import netplay

netplay.relay(to_int(env("NET_PORT") ?? "0") ?? 0).unwrap()
test_ports.publish(net.port())
start = time()
loop time() - start < 120.0:
    netplay.relay(0).unwrap()
    sleep(0.002)
