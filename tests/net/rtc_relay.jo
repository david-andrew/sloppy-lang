# tools/nettest.py: a relay for tests/net/rtc_page.jo that passes on what the pages say to connect
# to each other (WebRTC) but none of their game's packets, and prints what each page reports
import net

port = to_int(env("NET_PORT") ?? "23400") ?? 23400
if not net.listen(port): panic("cannot listen on port {port}")
rooms: {int: str}
results: str[]
start = time()
loop results.len() < 2 and time() - start < 60.0:
    loop e in net.receive_server():
        if e.kind == .left: rooms.remove(e.peer)
        else if e.kind != .message: continue
        else if starts_with(e.text, "result "): results.push(e.text[7..])
        else if starts_with(e.text, "join "): rooms[e.peer] = e.text[5..]
        else if starts_with(e.text, "rtc "):
            if let r = rooms.get(e.peer):
                loop k, v in rooms:
                    if v == r and k != e.peer: net.send(k, e.data)
    sleep(0.002)
loop r in sorted(results): print(r)
