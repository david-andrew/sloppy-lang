import test_ports
# tools/nettest.py: rollback netplay between this native program (the relay, and player 1 through
# it) and a web page (player 2, tests/net/np_page.jo)
import netplay
import net

struct Pad:
    dx = 0
    version_rejected = false
struct Game:
    pos: int[] = [0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

port = to_int(env("NET_PORT") ?? "0") ?? 0
netplay.relay(port).unwrap()
port = net.port()
test_ports.publish(port)
s = netplay.session(Game(), step, players = 2, me = 0)
s.version = "nettest rollback 1"
s.join_relay("127.0.0.1", port, "test")
bad = netplay.session(Game(), step, players = 2, me = 0)
bad.version = "new"
bad.join_relay("127.0.0.1", port, "version test")
start = time()
loop s.confirmed() < 400 and time() - start < 40.0:
    netplay.relay(port).unwrap()
    bad.play(Pad())
    s.play(pad(0, s.tick + s.delay))
    sleep(1.0 / 60.0)
assert(bad.tick == 0 and contains(bad.problem, "different build"))
assert(s.__last[1].version_rejected)
print("host: played {s.confirmed() >= 400}")
print("host: compared {s.__their_hashes.len() > 0}, desync {s.desync}")
