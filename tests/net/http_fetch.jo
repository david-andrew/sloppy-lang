# tools/nettest.py's HTTP client: net.fetch's ways against the test's server (tools/nettest.py,
# at 127.0.0.1:NET_PORT): methods, headers and a body, chunks, redirects, saved to a file
import net

main = ():
    at = "http://127.0.0.1:{env("NET_PORT") ?? "0"}"
    r = net.fetch("{at}/echo", method = "POST", body = "{{\"a\": 1}", headers = {"X-Test": "yes"})
    print("post: {r.status} {r.text}")
    r = net.fetch("{at}/echo", method = "put", body = "plain words")
    print("put: {r.status} {r.text}")
    r = net.fetch("{at}/chunked")
    print("chunked: {r.status} {r.text}")
    r = net.fetch("{at}/see-other", method = "POST", body = "x")
    print("303: {r.status} {r.text}")
    r = net.fetch("{at}/moved", method = "POST", body = "y")
    print("302 after a POST: {r.status} {r.text}")
    r = net.fetch("{at}/again", method = "POST", body = "z")
    print("307: {r.status} {r.text}")
    path = "{env("NET_DIR") ?? "."}/big.bin"
    calls = 0
    last = 0
    r = net.fetch("{at}/big", save_to = path, progress = (got: int, all: int):
        calls += 1
        last = got)
    saved = read_file(path) ?? ""
    print("saved: {r.status} {r.size} {r.data.len()} {len(saved)} {calls >= 1} {last} {sha256(saved)[..16)}")
    r = net.fetch("{at}/missing", save_to = "{env("NET_DIR") ?? "."}/missing.bin")
    print("404: {r.status} {file_exists("{env("NET_DIR") ?? "."}/missing.bin")} {r.text}")
    r = net.fetch("{at}/echo", method = "HEAD")
    print("head: {r.status} {r.size}")
    r = net.fetch("{at}/cookies")
    print("cookies: {r.headers["set-cookie"]} | {join(net.header_values(r, "Set-Cookie"), " | ")}")
    # without waiting: a game's frames go on while the answer comes
    f = net.fetch_start("{at}/slow")
    print("started: {if net.fetch_result(f) == none: "none yet" else: "an answer"} {f > 0}")
    frames = 0
    got = net.HttpReply(0, [])
    loop:
        if let a = net.fetch_result(f):
            got = a
            break
        frames += 1
        sleep(1.0 / 60.0)
    # (60 a second for the answer's second, on a quiet machine; a fetch that held the loop up would
    # give 0 or 1: a busy one, as CI's, may give few)
    print("frames while it came: {frames >= 3}{if frames >= 3: "" else: " ({frames})"}")
    print("fetch_result: {got.status} {got.text}")
    a = net.fetch_start("{at}/chunked")
    b = net.fetch_start("{at}/slow")
    ra = net.HttpReply(0, [])
    rb = net.HttpReply(0, [])
    loop ra.status == 0 or rb.status == 0:
        if ra.status == 0:
            if let x = net.fetch_result(a): ra = x
        if rb.status == 0:
            if let x = net.fetch_result(b): rb = x
        net.wait(1.0)
    print("two at once: {ra.status} {ra.text}, {rb.status} {rb.text}")
