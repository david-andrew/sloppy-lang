# tools/nettest.py: the client of tests/net/cs_server.jo, in a web page
import netplay

struct Pad:
    dx = 0
struct World:
    pos: {int: int}

apply = (w: World, player: int, p: Pad, seen: World) -> World:
    let w = w
    if w.pos.contains(player): w.pos[player] += p.dx
    w

c = netplay.client(World(), apply)
c.version = "nettest client-server 1"
# (the page is given ?net_port=: env reads its parameters in any letters)
c.connect(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "47300") ?? 47300, hello = "page")
c.lag_ms(30, 10)
bad = netplay.client(World(), apply)
bad.version = "old cached build"
bad.connect(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "47300") ?? 47300)
saved = ""
who = -1
rejoin_at = -1.0
returned = false
reported = false
update = (dt: f64):
    global c, saved, who, rejoin_at, returned, reported
    bad.play(Pad())
    if rejoin_at < 0.0 or returned: c.play(Pad(1))
    if saved == "" and c.connected() and c.server.pos.get(c.me) ?? 0 >= 40:
        saved = c.rejoin_token
        who = c.me
        c.disconnect()
        rejoin_at = elapsed() + 1.0
    if rejoin_at >= 0.0 and not returned and elapsed() >= rejoin_at:
        c = netplay.client(World(), apply)
        c.version = "nettest client-server 1"
        c.rejoin_token = saved
        c.connect(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "47300") ?? 47300, hello = "page")
        returned = true
    if returned and c.connected() and not reported:
        assert(c.me == who and c.server.pos.get(who) ?? 0 >= 40)
        assert(contains(bad.problem, "different build"))
        c.say("web rejoined and version checked")
        reported = true
draw = (): clear()
