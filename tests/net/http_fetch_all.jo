# tools/nettest.py's net.fetch_all client, against the test's server (at 127.0.0.1:NET_PORT): at
# most at_once at a time, in order, a busy server asked again, a Retry-After waited for, a refused
# connection tried again and given up; and what a redirect loop and headers too large say
import net

main = ():
    at = "http://127.0.0.1:{env("NET_PORT") ?? "0"}"
    urls = [loop i in [0..12): "{at}/n/{i}"]
    urls.push("{at}/flaky")
    urls.push("{at}/ra")
    urls.push("{at}/missing")
    urls.push("http://127.0.0.1:1/refused")
    seen: int[]
    rs = net.fetch_all(urls, at_once = 3, retries = 2, wait = 10.0, done = (i: int, r: net.HttpReply): seen.push(i))
    print("all: {rs.len()} {join([loop r in rs[..12): r.text], " ")}")
    print("flaky: {rs[12].status} {rs[12].text}")
    print("retry-after: {rs[13].status} {rs[13].text}")
    print("404: {rs[14].status} {rs[14].text}")
    print("refused: {rs[15].status} {len(rs[15].why) > 0}")
    seen.sort()
    print("done: {seen == [loop i in [0..16): i]}")
    print("at once: {net.fetch("{at}/most").text}")
    r = net.fetch("{at}/loop")
    print("loop: {r.status} {r.why}")
    r = net.fetch("{at}/huge")
    print("huge: {r.status} {r.why}")
