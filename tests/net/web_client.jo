# tools/nettest.py's client in a web page: as client.jo, as a game (messages arrive between
# frames); the server's output says how it went
import net

port = to_int(env("NET_PORT") ?? "47300") ?? 47300
p = net.connect(env("NET_HOST") ?? "localhost", port)
echoes = 0

update = (dt: f64):
    loop e in net.receive():
        if e.kind == .joined:
            loop k in [1..4): net.send(p, "msg {k}")
        else if e.kind == .message and e.data.len() > 1000:
            if e.data.len() == 300000 and e.data[299999] == 7: net.send(p, "big ok")
            net.close(p)
        else if e.kind == .message:
            echoes += 1
            if echoes == 3: net.send(p, "big please")

draw = (): clear()
