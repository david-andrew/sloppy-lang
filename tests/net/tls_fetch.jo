# tools/nettest.py's TLS client: each address given fetched (https://), and what came, or why not
import net

main = ():
    loop url in args()[1..):
        t0 = time()
        r = net.fetch(url, wait = 15.0)
        if r.status == 0: print("{url}: no: {r.why}")
        else: print("{url}: {r.status} {r.data.len() > 0} ({(time() - t0) * 1000.0:.0f} ms)")
