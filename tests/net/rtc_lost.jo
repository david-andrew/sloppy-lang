# tools/nettest.py: two native programs connected by invite codes; the test kills one (no goodbye),
# and the other must find it gone within about 15 s, and say why
import net
dir = env("DIR") ?? "."
role = env("ROLE") ?? "invite"
p = -1
if role == "invite":
    p = net.invite()
    loop len(net.invite_code(p)) == 0: sleep(0.02)
    write_file("{dir}/code.txt", net.invite_code(p))
    loop not file_exists("{dir}/reply.txt"): sleep(0.05)
    sleep(0.1)
    net.accept_reply(p, read_file("{dir}/reply.txt") ?? "")
else:
    loop not file_exists("{dir}/code.txt"): sleep(0.05)
    sleep(0.1)
    p = net.join_invite(read_file("{dir}/code.txt") ?? "")
    loop len(net.invite_code(p)) == 0: sleep(0.02)
    write_file("{dir}/reply.txt", net.invite_code(p))
t0 = time()
joined_at = 0.0
loop time() - t0 < 60.0:
    loop e in net.receive():
        if e.kind == .joined:
            joined_at = time()
            print("{role}: joined")
            write_file("{dir}/{role}.joined", "1")
        else if e.kind == .left:
            print("{role}: left after {time() - joined_at:.0} s: {net.why(e.peer)}")
            exit(0)
    sleep(0.01)
print("{role}: still connected after 60 s")
