# tools/nettest.py: two games connected through lib/invite.jo's screens, the codes passed through
# files in DIR as players would pass them (ROLE invite or join); each says hello and prints what
# it got
import net
import invite

dir = env("DIR") ?? "."
role = env("ROLE") ?? "invite"
if role == "invite": invite.start()
else:
    loop not file_exists("{dir}/code.txt"): sleep(0.05)
    invite.join(read_file("{dir}/code.txt") ?? "")
friend = -1
wrote = false
replied = false
done = false
draw = ():
    global done, friend, replied, wrote
    clear()
    if friend < 0:
        if not wrote and len(invite.code()) > 0:
            f = if role == "invite": "code" else: "reply"
            write_file("{dir}/{f}.tmp", invite.code())
            rename_file("{dir}/{f}.tmp", "{dir}/{f}.txt")
            wrote = true
        if role == "invite" and not replied and file_exists("{dir}/reply.txt"):
            replied = invite.reply(read_file("{dir}/reply.txt") ?? "")
        if let c = invite.screen("the test", "https://example.com/game/"):
            friend = c.peer
            print("{role}: connected, inviter {c.inviter}, screens up {invite.active()}")
            net.send(friend, "hello from {role}")
        return
    loop e in net.receive():
        if e.kind == .message and not done:
            print("{role} got: {e.text}")
            done = true
