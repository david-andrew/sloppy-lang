# tools/nettest.py's web page that fetches (net.fetch_start: the browser's fetch) from the HTTP
# server at NET_PORT (tests/net/http_server.jo), then tells it what came: the server's output says
# how it went
import net

at = "http://127.0.0.1:{to_int(env("NET_PORT") ?? "19410") ?? 19410}"
f = net.fetch_start("{at}/cors")

update = (dt: f64):
    if f < 0: return
    if let r = net.fetch_result(f):
        net.fetch_start("{at}/report", method = "POST", body = "page fetched {r.status} {r.text}")
        f = -1

draw = (): clear()
