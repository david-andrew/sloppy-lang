# tools/nettest.py: a client-server game's server (lib/netplay.jo); its client is a web page,
# tests/net/cs_page.jo, that walks right for 120 ticks
import netplay

struct Pad:
    dx = 0
struct World:
    pos: {int: int}

apply = (w: World, player: int, p: Pad, seen: World) -> World:
    let w = w
    if w.pos.has(player): w.pos[player] += p.dx
    w
step = (w: World) -> World: w

srv = netplay.server(World(), apply, step)
srv.listen(to_int(env("NET_PORT") ?? "47300") ?? 47300)
srv.lag(20, 5)
start = time()
done = false
said = false
loop not done and time() - start < 40.0:
    srv.update()
    loop p in srv.joined: srv.world.pos[p] = 0
    loop p, x in srv.world.pos:
        if not said and len(srv.hello(p)) > 0:
            print("server: hello {srv.hello(p)}")
            said = true
    loop p, x in srv.world.pos:
        if x >= 120: done = true
    sleep(1.0 / 60.0)
print("server: walked {done}")
