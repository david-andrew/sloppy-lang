import test_ports
# tools/nettest.py: a client-server game's server (lib/netplay.jo); its client is a web page,
# tests/net/cs_page.jo, that walks right for 120 ticks
import netplay
import net

struct Pad:
    dx = 0
struct World:
    pos: {int: int}

apply = (w: World, player: int, p: Pad, seen: World) -> World:
    let w = w
    if w.pos.has(player): w.pos[player] += p.dx
    w
step = (w: World) -> World: w

srv = netplay.server(World(), apply, step)
srv.version = "nettest client-server 1"
srv.rejoin_grace = 10.0
srv.listen(to_int(env("NET_PORT") ?? "0") ?? 0).unwrap()
test_ports.publish(net.port())
srv.lag_ms(20, 5)
start = time()
done = false
said = false
who = -1
lost = false
back = false
mismatch = false
reported = false
loop not done and time() - start < 40.0:
    srv.update()
    loop p in srv.joined:
        assert(who == -1)
        who = p
        srv.world.pos[p] = 0
    lost = lost or srv.dropped == [who]
    back = back or srv.rejoined == [who]
    loop _, why in srv.errors: mismatch = mismatch or contains(why, "different build")
    loop p, text in srv.messages:
        if p == who and text == "web rejoined and version checked": reported = true
    loop p, x in srv.world.pos:
        if not said and len(srv.hello(p)) > 0:
            print("server: hello {srv.hello(p)}")
            said = true
    loop p, x in srv.world.pos:
        if x >= 120 and lost and back and mismatch and reported: done = true
    sleep(1.0 / 60.0)
print("server: walked {done}")
