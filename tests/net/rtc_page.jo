# tools/nettest.py: one of two web pages playing each other through tests/net/rtc_relay.jo, which
# passes on only what they say to connect: their game's packets can only go straight (WebRTC)
import net
import netplay

struct Pad:
    dx = 0
struct Game:
    pos: int[] = [0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

me = to_int(env("PLAYER") ?? "0") ?? 0
host = env("NET_HOST") ?? "localhost"
port = to_int(env("NET_PORT") ?? "23400") ?? 23400
s = netplay.session(Game(), step, players = 2, me = me)
s.join_relay(host, port, "test", stun = "")          # (no STUN server: both pages are on this machine)
bad = netplay.session(Game(), step, players = 2, me = me)
bad.version = if me == 0: "new" else: "old"
bad.join_relay(host, port, "version test", stun = "")
report = net.connect(host, port)
told = false

update = (dt: f64):
    global told
    bad.play(Pad())
    s.play(pad(me, s.tick + s.delay))
    loop _ in net.receive([report]): pass
    if not told and s.confirmed() >= 300 and bad.tick == 0 and bad.direct(1 - me) and contains(bad.problem, "different build"):
        net.send(report, "result player {me}: played true, direct {s.direct(1 - me)}, desync {s.desync}")
        told = true
draw = (): clear()
