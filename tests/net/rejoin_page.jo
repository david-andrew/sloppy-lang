# tools/web_rejoin.mjs: one of two web pages playing through tests/net/rejoin_relay.jo (straight to
# each other with WebRTC once they can). Player 1's page is reloaded partway: it comes back into
# the game with the token it saved in the browser's storage. Each page says its game's hash at a
# tick after that, once the two are straight to each other again.
import net
import netplay

build:
    name = "netplay rejoin test"

struct Pad:
    dx = 0
struct Game:
    pos: int[] = [0, 0]
    turns = 0

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2):
        g.pos[p] += pads[p].dx
        if pads[p].dx > 0: g.turns += p + 1
    g
pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

me = to_int(env("PLAYER") ?? "0") ?? 0
at = to_int(env("AT") ?? "900") ?? 900
token = load_data("rejoin") ?? ""
s = netplay.session(Game(), step, players = 2, me = me)
s.join_relay(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "23400") ?? 23400, "rejoin", stun = "")
s.allow_rejoin(token)
print("page {me}: {if len(token) > 0: "coming back" else: "new"}")
saved = token
told = 0
done = false

update = (dt: f64):
    global saved, told, done
    s.play(pad(me, s.tick + s.delay))
    if s.rejoin_token != saved:
        saved = s.rejoin_token
        save_data("rejoin", saved)
        print("page {me}: token saved")
    if s.rejoined.len() > 0: print("page {me}: player {s.rejoined[0]} came back")
    if told < 300 and s.tick >= 300 and not s.rejoining:
        told = 300
        print("page {me}: played 300")
    if not done and s.confirmed() > at and s.tick > at and s.tick < at + 100 and s.direct(1 - me):
        done = true
        print("page {me}: hash {hash(s.__states[at % 128])}, desync {s.desync}, problem '{s.problem}'")
draw = (): clear()
