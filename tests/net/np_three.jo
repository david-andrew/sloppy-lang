# tools/nettest.py: rollback netplay for three over invite codes, no server: the host (ROLE host)
# invites two (codes and replies through files in DIR: code1.txt, reply1.txt...), tells each its
# number, and plays over both; each of the others (ROLE friend, N=1 or 2) plays over the host
# alone, who passes on what goes between them. Player 2 leaves partway: the host plays for it
# (stand_in), and the other two play on
import net
import netplay

struct Pad:
    dx = 0
struct Game:
    pos: int[] = [0, 0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..3): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

dir = env("DIR") ?? "."
role = env("ROLE") ?? "host"
n = to_int(env("N") ?? "1") ?? 1
me = 0
peers = [-1, -1, -1]
if role == "host":
    loop k in [1..3):
        peers[k] = net.invite(reliable = false)
        loop len(net.invite_code(peers[k])) == 0: sleep(0.02)
        write_file("{dir}/code{k}.tmp", net.invite_code(peers[k]))
        rename_file("{dir}/code{k}.tmp", "{dir}/code{k}.txt")
    loop k in [1..3):
        loop not file_exists("{dir}/reply{k}.txt"): sleep(0.05)
        net.accept_reply(peers[k], read_file("{dir}/reply{k}.txt") ?? "")
    # (each told its number once it is there)
    told = 0
    loop told < 2:
        loop e in net.receive():
            if e.kind == .joined:
                net.send(e.peer, "you are {peers.index_of(e.peer)}")
                told += 1
        sleep(0.01)
else:
    loop not file_exists("{dir}/code{n}.txt"): sleep(0.05)
    host = net.join_invite(read_file("{dir}/code{n}.txt") ?? "")
    loop len(net.invite_code(host)) == 0: sleep(0.02)
    write_file("{dir}/reply{n}.tmp", net.invite_code(host))
    rename_file("{dir}/reply{n}.tmp", "{dir}/reply{n}.txt")
    peers[0] = host
    loop me == 0:
        loop e in net.receive():
            if e.kind == .message and starts_with(e.text, "you are "): me = to_int(e.text[8..]) ?? 0
        sleep(0.01)
s = netplay.session(Game(), step, players = 3, me = me)
s.over(peers)
start = time()
done_at = -1.0
goal = if me == 2: 200 else: 600
loop time() - start < 60.0 and (done_at < 0.0 or time() - done_at < 2.0):
    loop e in net.receive():
        if e.kind == .left and me == 0: s.stand_in(peers.index_of(e.peer), Pad(5))
    s.play(pad(me, s.tick + s.delay))
    if done_at < 0.0 and s.confirmed() >= goal:
        done_at = time()
        # (player 2 goes)
        if me == 2: break
    sleep(1.0 / 60.0)
if me == 2: net.close(peers[0])
else:
    # (from some tick on, player 2 moved 5 a tick: played for by the host)
    stood = s.state.pos[2] > 1000 and s.stands_in(2) == (me == 0)
    print("player {me}: played {s.confirmed() >= goal}, desync {s.desync}, stood in {stood}")
if me == 2:
    sleep(0.5)
    print("player {me}: played {s.confirmed() >= goal}, desync {s.desync}")
