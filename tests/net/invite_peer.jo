# a native program that invites or joins (ROLE), passing codes through files in DIR; then says
# ping and answers pong
import net
dir = env("DIR") ?? "."
role = env("ROLE") ?? "invite"
p = -1
if role == "invite":
    p = net.invite()
    loop len(net.invite_code(p)) == 0: sleep(0.02)
    write_file("{dir}/code.tmp", net.invite_code(p))
    rename_file("{dir}/code.tmp", "{dir}/code.txt")
    loop not file_exists("{dir}/reply.txt"): sleep(0.05)
    reply = read_file("{dir}/reply.txt") ?? ""
    ok = net.accept_reply(p, reply)
    print("accepted:{ok}")
else:
    loop not file_exists("{dir}/code.txt"): sleep(0.05)
    p = net.join_invite(read_file("{dir}/code.txt") ?? "")
    loop len(net.invite_code(p)) == 0: sleep(0.02)
    write_file("{dir}/reply.tmp", net.invite_code(p))
    rename_file("{dir}/reply.tmp", "{dir}/reply.txt")
t0 = time()
pongs = 0
loop pongs == 0 and time() - t0 < 20.0:
    loop e in net.receive():
        if e.kind == .joined:
            print("native:joined")
            net.send(p, "ping from native")
        else if e.kind == .message:
            print("native got:{e.text}")
            if starts_with(e.text, "ping"): net.send(p, "pong from native")
            else: pongs += 1
        else if e.kind == .left:
            print("native:left {net.why(e.peer)}")
            pongs = -1
    sleep(0.005)
sleep(1.0)
