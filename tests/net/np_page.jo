# tools/nettest.py: player 2 of tests/net/np_host.jo, in a web page
import netplay
import net

struct Pad:
    dx = 0
    version_rejected = false
struct Game:
    pos: int[] = [0, 0]

step = (g: Game, pads: Pad[]) -> Game:
    let g = g
    loop p in [0..2): g.pos[p] += pads[p].dx
    g

pad = (p: int, t: int) -> Pad: Pad(int(hash(t * 3 + p) % 3) - 1)

s = netplay.session(Game(), step, players = 2, me = 1)
s.version = "nettest rollback 1"
s.join_relay(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "47300") ?? 47300, "test")

bad = netplay.session(Game(), step, players = 2, me = 1)
bad.version = "old"
bad.join_relay(env("NET_HOST") ?? "localhost", to_int(env("NET_PORT") ?? "47300") ?? 47300, "version test")
update = (dt: f64):
    bad.play(Pad())
    p = pad(1, s.tick + s.delay)
    p.version_rejected = bad.tick == 0 and contains(bad.problem, "different build")
    s.play(p)
draw = (): clear()
