# a web page that invites (?ROLE=invite; the reply comes later, in ?REPLY=) or joins (?CODE=),
# then says ping and answers pong; what happens is printed, for tools/rtc_webtest.mjs to read
import net
role = env("ROLE") ?? "join"
p = if role == "invite": net.invite() else: net.join_invite(env("CODE") ?? "")
shown = false
accepted = false
update = (dt: f64):
    if not shown and len(net.invite_code(p)) > 0:
        print("code:{net.invite_code(p)}")
        shown = true
    if role == "invite" and not accepted:
        if let r = env("REPLY"):
            accepted = true
            print("accepted:{net.accept_reply(p, r)}")
    loop e in net.receive():
        if e.kind == .joined:
            print("page:joined")
            net.send(p, "ping from the page")
        else if e.kind == .message:
            print("page got:{e.text}")
            if starts_with(e.text, "ping"): net.send(p, "pong from the page")
        else if e.kind == .left: print("page:left {net.why(e.peer)}")
draw = (): clear()
