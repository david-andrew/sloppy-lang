# tools/nettest.py's server: echoes each message, then sends a big one and says who left
import net

main = ():
    port = to_int(env("NET_PORT") ?? "47300") ?? 47300
    if not net.listen(port):
        print("cannot listen on {port}")
        return
    print("listening")
    t0 = time()
    loop time() - t0 < 20.0:
        loop e in net.receive():
            if e.kind == .joined: print("server: joined")
            else if e.kind == .left:
                print("server: left")
                return
            else if e.text == "big please": net.send(e.peer, fill(u8(7), 300000))
            else:
                print("server: got {e.text}")
                net.send(e.peer, "echo {e.text}")
        sleep(0.005)
