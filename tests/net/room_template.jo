# tools/nettest.py: the room starter's lobby/start, rollback, saved token and reload over
# loopback WebSockets. Local sockets feed the same connected() entry point used by room
# links. nettest appends this harness with update renamed; no-draw runs the real game loop.
dir = env("DIR") ?? "."
back = env("REJOIN") == "1"
role = env("ROLE") ?? "host"
room = "test-room"
if role == "host":
    hosting = true
    assert(net.listen(0))
    write_file("{dir}/port", "{net.port()}")
else:
    end = time() + 10.0
    loop not file_exists("{dir}/port"):
        assert(time() < end)
        sleep(0.01)
    host = net.connect("127.0.0.1", to_int(read_file("{dir}/port").unwrap())!)
    if back: connected(invite.Invited(host, false))

said = false
came: int[]
update = (dt: f64):
    global said
    if hosting:
        loop e in net.receive_server():
            if e.kind == .joined:
                if playing: s.admit(e.peer)
                else: guests.push(e.peer)
        if not playing and guests.len() == 3: start_game()
    room_update(dt)
    came.extend(s.rejoined)
    if playing and s.me == 1 and not back and s.tick >= 120 and len(s.rejoin_token) > 0:
        write_file("{dir}/restart", "")
    if playing and s.tick > 600 and s.confirmed() > 600 and not said:
        print("player {s.me}: {hash(s.__states[600 % 128])} desync {s.desync} problem '{s.problem}'")
        if hosting: print("came back: {came}")
        said = true
    if said and frame_number() > 760: quit()
    assert(s.admit_expired.len() == 0)
