# tools/nettest.py: net.close's code and reason, to a web page (tests/net/close_page.jo) and from
# it. The page's first connection sends a lot, and is closed with much of that still unread (the
# close must reach it all the same); its second says what it was told, and closes with its own
import net

port = to_int(env("NET_PORT") ?? "47300") ?? 47300
if not net.listen(port): panic("cannot listen")
print("listening")
first = -1
closed = -1
start = time()
done = false
loop not done and time() - start < 30.0:
    loop e in net.receive():
        if e.peer == closed: continue
        if e.kind == .joined and first < 0: first = e.peer
        else if e.kind == .message and e.peer == first:
            sleep(0.3)
            net.close(first, 4001, "the room is full")
            closed = first
        else if e.kind == .message: print("server: {e.text}")
        else if e.kind == .left:
            print("server: the page left with {e.code} '{e.text}'")
            done = true
    net.wait(1.0)
