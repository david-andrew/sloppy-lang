# tools/nettest.py: the web page of tests/net/close_server.jo: closed by the server with a code and a
# reason, it says what it was told on a second connection, and closes that with its own
import net

port = to_int(env("NET_PORT") ?? "47300") ?? 47300
host = env("NET_HOST") ?? "localhost"
p = net.connect(host, port)
second = -1
told = ""

update = (dt: f64):
    global second, told
    loop e in net.receive():
        if e.kind == .joined and e.peer == p:
            loop k in 0..300: net.send(p, "input {k} " + "x" * 100)
        else if e.kind == .left and e.peer == p:
            told = "page was told {e.code} '{e.text}', why '{net.why(p)}'"
            second = net.connect(host, port)
        else if e.kind == .joined and e.peer == second:
            net.send(second, told)
            net.close(second, 4002, "bye from the page")

draw = (): clear()
