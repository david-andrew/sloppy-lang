# tools/nettest.py's client: three messages, their echoes in order, a big message, then it leaves
import net

main = ():
    port = to_int(env("NET_PORT") ?? "47300") ?? 47300
    p = net.connect(env("NET_HOST") ?? "localhost", port)
    t0 = time()
    echoes = 0
    loop time() - t0 < 20.0:
        loop e in net.receive():
            if e.kind == .joined:
                print("client: joined {net.peers().len()}")
                loop k in [1..4): net.send(p, "msg {k}")
            else if e.kind == .left:
                print("client: left")
                return
            else if e.data.len() > 1000:
                print("client: big {e.data.len()} {e.data[0]} {e.data[e.data.len() - 1]}")
                net.close(p)
            else:
                print("client: {e.text}")
                echoes += 1
                if echoes == 3: net.send(p, "big please")
        sleep(0.005)
