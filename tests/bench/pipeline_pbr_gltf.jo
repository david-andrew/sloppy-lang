# Delayed first draw of a PBR glTF asset: loading must prepare regular and skinned passes.
actor = load_model(embed("../render/pbr_skin.gltf"))
update = (dt: f64): pass
draw = ():
    camera3d(vec3(0, 0.3, 7), vec3(0, 0, 0), 42)
    if frame_number() >= 60:
        draw_model(actor, pose = pose_at(actor, 0, 0.65, false))
