# Prepare a panorama while loading, then reveal the scene well after loading has ended.
panorama = texture(image(32, 16, vec4(0.3, 0.5, 0.7, 1)))
ball = sphere_mesh(0.5)
sky_image(panorama)
update = (dt: f64): pass
draw = ():
    camera3d(vec3(2, 2, 5), vec3(0, 0, 0))
    if frame_number() >= 60: draw_mesh(ball)
