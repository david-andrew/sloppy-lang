# Test-only HID short-item descriptor reader. It models HidP's capability/value boundary on
# Linux, without reimplementing the Windows HID driver in the library. Only absolute input
# variables are needed by these fixtures. Offsets include Windows' leading report-ID byte
# (zero even for unnumbered reports). The library performs sign extension and normalization.
struct Field:
    page: int
    report: int
    link: int
    usage: int
    bit: int
    bits: int

struct Globals:
    page = 0
    low = 0
    high = 0
    size = 0
    count = 0
    report = 0

signed_item = (v: int, bytes: int) -> int:
    if bytes > 0 and v & (1 << (bytes * 8 - 1)) != 0: return v - (1 << (bytes * 8))
    v

cap = (page: int, report: int, link: int, usage: int, bits: int, low: int, high: int) -> u8[]:
    b = fill(u8(0), 72)
    p = data(b)
    (p as *u16)[0] = u16(page)
    p[2] = u8(report)
    ((p + 6) as *u16)[0] = u16(link)
    p[15] = 1
    ((p + 18) as *u16)[0] = u16(bits)
    ((p + 20) as *u16)[0] = 1
    ((p + 40) as *u32)[0] = u32(low)
    ((p + 44) as *u32)[0] = u32(high)
    ((p + 56) as *u16)[0] = u16(usage)
    b

parse = (desc: u8[], vendor: int = 0, product: int = 0) -> (__HidPad, Field[]):
    h = __HidPad(vendor = vendor, product = product)
    fields: Field[]
    g = Globals()
    stack: Globals[]
    usages: int[]
    first = -1
    last = -1
    links: int[]
    next_link = 1
    offsets = fill(8, 256)
    at = 0
    loop at < desc.len():
        prefix = int(desc[at])
        at += 1
        n = prefix & 3
        if n == 3: n = 4
        assert(prefix != 0xFE and at + n <= desc.len())
        v = 0
        loop j in [0..n): v |= int(desc[at + j]) << (j * 8)
        at += n
        kind = (prefix >> 2) & 3
        tag = prefix >> 4
        if kind == 1:
            if tag == 0: g.page = v
            else if tag == 1: g.low = signed_item(v, n)
            else if tag == 2: g.high = if g.low < 0: signed_item(v, n) else: v
            else if tag == 7: g.size = v
            else if tag == 8: g.report = v
            else if tag == 9: g.count = v
            else if tag == 10: stack.push(g)
            else if tag == 11:
                g = stack[stack.len() - 1]
                stack.remove_at(stack.len() - 1)
        else if kind == 2:
            full = if n == 4: v else: (g.page << 16) | v
            if tag == 0: usages.push(full)
            else if tag == 1: first = full
            else if tag == 2: last = full
        else if kind == 0:
            if tag == 10:
                if links.len() == 0: links.push(0)
                else:
                    links.push(next_link)
                    next_link += 1
            else if tag == 12:
                links.remove_at(links.len() - 1)
            else if tag == 8:
                assert(g.report < 256 and g.size <= 32 and g.count <= 65535)
                link = if links.len() > 0: links[links.len() - 1] else: 0
                if v & 1 == 0 and v & 2 != 0 and v & 4 == 0:
                    loop j in [0..g.count):
                        u = -1
                        if j < usages.len(): u = usages[j]
                        else if first >= 0 and first + j <= last: u = first + j
                        page = u >> 16
                        usage = u & 65535
                        if (page == 9 and usage > 0 and usage <= 32) or (page == 1 and usage >= 0x30 and usage <= 0x39):
                            fields.push(Field(page, g.report, link, usage, offsets[g.report] + j * g.size, g.size))
                            __hid_caps(h, cap(page, g.report, link, usage, g.size, g.low, g.high), page == 1)
                offsets[g.report] += g.size * g.count
                h.report_bytes = max(h.report_bytes, (offsets[g.report] + 7) / 8)
            usages = []
            first = -1
            last = -1
    (h, fields)

bits = (r: u8[], f: Field) -> int?:
    if f.bit + f.bits > r.len() * 8: return none
    n = 0
    loop i in [0..f.bits):
        at = f.bit + i
        if int(r[at / 8]) & (1 << (at % 8)) != 0: n |= 1 << i
    n

buttons = (c: __HidButtons, r: u8[], fields: Field[]) -> u16[]?:
    out: u16[]
    loop f in fields:
        if f.page == c.page and f.report == c.report and f.link == c.link:
            v = bits(r, f)
            if v == none: return none
            if v! != 0: out.push(u16(f.usage))
    out

value = (c: __HidValue, r: u8[], fields: Field[]) -> int?:
    loop f in fields:
        if f.page == c.page and f.report == c.report and f.link == c.link and f.usage == c.usage: return bits(r, f)
    none

feed = (h: mut __HidPad, r: u8[], fields: Field[]) -> bool:
    __hid_report(h, r, (c: __HidButtons, b: u8[]) -> u16[]?: buttons(c, b, fields), (c: __HidValue, b: u8[]) -> int?: value(c, b, fields))
