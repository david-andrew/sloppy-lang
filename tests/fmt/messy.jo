# messy input for sloppy fmt (tests/fmt: each .jo formatted must be its .out)
struct P :
  x : f64   # across
  y:f64




add=(a:int,b:int)->int :
  if a<0 and not(b>0) : return -a
  c=a*-b+(a-1)*2
  xs=[1,2,3][..2)
  loop i in [0..len(xs)) : c+=xs[i]
  loop i in 0..and x in xs : c-= i
  m=[1 (-2) 3]
  w=5
  w xor= 3
  p:*u8=null
  q = p as **u8
  f=(x:int):x*2
  s="{a+b} and {xs.map((x): x*2)}"
  t="""
      kept   as is
  """
  return c+w+f(1)+len(s)+len(t)  # the result

test "it adds":
	assert(add(1,2)==add(1,2))
	v = 1.5e-3*2  
	d = 9.81(m/s^2)
	assert(v>0.0 and d > 0.0)
