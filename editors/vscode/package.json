{
  "name": "sloppy",
  "displayName": "Sloppy",
  "description": "The Sloppy language: highlighting, errors as you type, hover, go to definition, references, rename, completion, signature help, inlay type hints, outline; run files in a terminal or the browser",
  "keywords": [
    "sloppy",
    "game development",
    "language server",
    "gamedev"
  ],
  "version": "0.5.0",
  "publisher": "RedFoxLabs",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sloppy",
    "workspaceContains:**/*.jo",
    "onDebugResolve:sloppy",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sloppy",
        "aliases": [
          "Sloppy",
          "sloppy"
        ],
        "extensions": [
          ".jo"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file.png",
          "dark": "./images/file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sloppy",
        "scopeName": "source.sloppy",
        "path": "./syntaxes/sloppy.tmLanguage.json",
        "unbalancedBracketScopes": [
          "punctuation.definition.range.begin.sloppy",
          "punctuation.definition.range.end.sloppy",
          "keyword.operator.arrow.sloppy",
          "keyword.operator.comparison.sloppy"
        ]
      }
    ],
    "commands": [
      {
        "command": "sloppy.run",
        "title": "Sloppy: Run File",
        "icon": "$(play)"
      },
      {
        "command": "sloppy.runWeb",
        "title": "Sloppy: Run File in the Browser",
        "icon": "$(globe)"
      },
      {
        "command": "sloppy.test",
        "title": "Sloppy: Run the File's Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "sloppy.debug",
        "title": "Sloppy: Debug File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "sloppy.newProject",
        "title": "Sloppy: New Project"
      },
      {
        "command": "sloppy.restartServer",
        "title": "Sloppy: Restart the Language Server"
      },
      {
        "command": "sloppy.install",
        "title": "Sloppy: Install or Update the Sloppy Compiler"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sloppy.run",
          "when": "resourceLangId == sloppy",
          "group": "navigation@1"
        },
        {
          "command": "sloppy.runWeb",
          "when": "resourceLangId == sloppy",
          "group": "navigation@2"
        },
        {
          "command": "sloppy.test",
          "when": "resourceLangId == sloppy",
          "group": "navigation@3"
        },
        {
          "command": "sloppy.debug",
          "when": "resourceLangId == sloppy",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "sloppy.run",
          "when": "editorLangId == sloppy"
        },
        {
          "command": "sloppy.runWeb",
          "when": "editorLangId == sloppy"
        },
        {
          "command": "sloppy.test",
          "when": "editorLangId == sloppy"
        },
        {
          "command": "sloppy.debug",
          "when": "editorLangId == sloppy"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sloppy.run",
        "key": "ctrl+f5",
        "when": "editorLangId == sloppy"
      }
    ],
    "configuration": {
      "title": "Sloppy",
      "properties": {
        "sloppy.path": {
          "type": "string",
          "default": "",
          "description": "The sloppy compiler. Empty: bin/sloppy in a workspace folder that has one (the Sloppy repository), else sloppy on the PATH."
        }
      }
    },
    "configurationDefaults": {
      "[sloppy]": {
        "editor.formatOnSave": true
      }
    },
    "breakpoints": [
      {
        "language": "sloppy"
      }
    ],
    "debuggers": [
      {
        "type": "sloppy",
        "label": "Sloppy",
        "languages": [
          "sloppy"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .jo file to build (with variables: sloppy build -g) and debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Its command-line arguments.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The directory it runs in (default: the file's).",
                "default": "${fileDirname}"
              },
              "stopOnPanic": {
                "type": "boolean",
                "description": "Stop in the debugger when the program panics.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sloppy",
            "request": "launch",
            "name": "Debug the current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Sloppy: Debug a file",
            "description": "Build a .jo file with variables and debug it",
            "body": {
              "type": "sloppy",
              "request": "launch",
              "name": "Debug ${1:game}.jo",
              "program": "^\"\\${workspaceFolder}/${1:game}.jo\""
            }
          }
        ]
      }
    ]
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-andrew/sloppy-lang"
  },
  "license": "MIT",
  "homepage": "https://sloppy-lang.org",
  "bugs": {
    "url": "https://github.com/david-andrew/sloppy-lang/issues"
  }
}
